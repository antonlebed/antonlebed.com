/* f(p) = p^2 - p - 1 smoothness widget */
fn depth_quad_calc() = (
  let p = parse_int_from("#dquad-input") in
  let result = dom_query("#dquad-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter p >= 2.</p>")
  else (
    let fp = p * p - p - 1 in
    /* check if 11-smooth (factors only from {2,3,5,7,11}) */
    mut rem = fp;
    mut s2 = 0; while rem % 2 == 0 do (mut rem = rem / 2; mut s2 = s2 + 1);
    mut s3 = 0; while rem % 3 == 0 do (mut rem = rem / 3; mut s3 = s3 + 1);
    mut s5 = 0; while rem % 5 == 0 do (mut rem = rem / 5; mut s5 = s5 + 1);
    mut s7 = 0; while rem % 7 == 0 do (mut rem = rem / 7; mut s7 = s7 + 1);
    mut s11 = 0; while rem % 11 == 0 do (mut rem = rem / 11; mut s11 = s11 + 1);
    let smooth = rem == 1 in
    let smooth_str = if smooth then "<span style='color:#ffd700'>YES -- 11-smooth!</span>"
      else "<span style='color:#b0b0c0'>NO (remainder " + "${rem}" + ")</span>" in
    /* build factorization string */
    mut fstr = "";
    if s2 > 0 then (mut fstr = fstr + "2^" + "${s2}" + " ") else 0;
    if s3 > 0 then (mut fstr = fstr + "3^" + "${s3}" + " ") else 0;
    if s5 > 0 then (mut fstr = fstr + "5^" + "${s5}" + " ") else 0;
    if s7 > 0 then (mut fstr = fstr + "7^" + "${s7}" + " ") else 0;
    if s11 > 0 then (mut fstr = fstr + "11^" + "${s11}" + " ") else 0;
    if rem > 1 then (mut fstr = fstr + "${rem}") else 0;
    /* name special cases */
    let name = if p == 2 then " = <span style='color:#ffd700'>1</span>"
      else if p == 3 then " = <span style='color:#ffd700'>5 (prime)</span>"
      else if p == 37 then " = <span style='color:#ffd700'>11^3 = 1331 (THE RETURN!)</span>"
      else "" in
    dom_inner(result,
      "<p style='color:#d8d8e0;margin:4px 0'>f(" + "${p}" + ") = " + "${p}" + "^2 - " + "${p}" + " - 1 = <span style='color:#ffd700;font-size:18px'>" + "${fp}" + "</span>" + name + "</p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>Factorization: " + fstr + "</p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>11-smooth? " + smooth_str + "</p>")
  )
)

fn page_depth_return() = (
  dom_head_meta("description", "f(p) = p^2-p-1. Among 1229 primes below 10000, only p=2, p=3, and p=37 produce 11-smooth outputs. 37 is the unique prime outside {2,3,5,7,11}: f(37) = 11^3 = 1331. The 12th prime, order 420 in Z/12612600, primitive element.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Depth Return\",\"description\":\"f(p)=p^2-p-1 is 11-smooth for exactly three primes: 2, 3, and 37. f(37)=1331=11^3. 37 has order 420 in Z/12612600.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/depth_return\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"f(p) = p^2 - p - 1\"},{\"@type\":\"DefinedTerm\",\"name\":\"smooth numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"multiplicative order\"}]}");
  /* === HERO === */
  let hero = make_hero("Why 37 Comes Home") in
  let big = dom_create("div") in
  dom_text(big, "f(37) = 1331 = 11^3");
  ct_mono(big);
  dom_style(big, "fontSize", "32px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "2px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The polynomial f(p) = p^2 - p - 1 maps primes to integers. Call f(p) '11-smooth' if all its prime factors come from {2, 3, 5, 7, 11}. Among 1,229 primes below 10,000, exactly three produce smooth values: f(2) = 1, f(3) = 5, and f(37) = 1331 = 11^3. Two are from the ring's own prime set. The third -- 37 -- is the only outsider whose output lands back inside.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE RESULT === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "What Happens at Each Prime");
  render_p(sec1, "Apply f(p) = p^2 - p - 1 to the ring's primes and then to nearby primes. A value is '11-smooth' if all its factors come from {2, 3, 5, 7, 11}:");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "p");
  render_th(rhdr, "f(p) = p^2 - p - 1");
  render_th(rhdr, "Smooth?");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "2", "1", "YES");
  render_table_row(rtbl, "3", "5", "YES");
  render_table_row(rtbl, "5", "19", "NO");
  render_table_row(rtbl, "7", "41", "NO");
  render_table_row(rtbl, "11", "109", "NO");
  render_table_row(rtbl, "13", "155 = 5 * 31", "NO");
  render_table_row(rtbl, "37", "1331 = 11^3", "YES");
  dom_append(sec1, rtbl);
  render_p(sec1, "The pattern breaks immediately after 2 and 3. Primes 5, 7, 11, and 13 all produce values with factors outside {2,3,5,7,11}. Then at p = 37 -- the 12th prime, well past the ring's own primes -- the output is 11^3, purely smooth. No other prime below 10,000 does this.");
  render_theorem(sec1, "Smooth Return (PROVED)", "Among 1,229 primes below 10,000, only p in {2, 3, 37} give 11-smooth f(p). 37 is the unique prime outside {2,3,5,7,11} with this property. f(37) = 37^2 - 37 - 1 = 1331 = 11^3. Checked exhaustively.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: WHY 37? === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Why 37?");
  render_p(sec2, "37 is the 12th prime. 12 = 2^2 * 3 is the Carmichael function lambda(Z/210) -- the period of the smallest ring built from {2, 3, 5, 7}. Its Cunningham half (37-1)/2 = 18 = 1+2+3+5+7, the sum of the five chain elements up to 7.");
  render_p(sec2, "37 also decomposes as (2*3)^2 + 1 = 36 + 1, or equivalently 2^5 + 5 = 32 + 5. Both expressions use only primes from {2, 3, 5}.");
  render_p(sec2, "In Z/12,612,600, the number 37 has multiplicative order 420 -- the full Carmichael period. This makes it a primitive element: every unit in the ring is a power of 37. It is coprime to every prime dividing the ring, so it appears in all six CRT channels simultaneously.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: WHERE 1331 LANDS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Where 1331 Lands");
  render_p(sec3, "The output f(37) = 1331 = 11^3 has CRT decomposition (3, 8, 6, 8, 0, 5) in Z/12,612,600. The mod-11 channel is zero: 11^3 is divisible by 11, so it annihilates its own channel. All other channels are nonzero. The polynomial maps a primitive element to a number that lives entirely in one prime's domain.");
  dom_append(dom_body(), sec3);

  /* === INTERACTIVE: DEPTH QUADRATIC EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: f(p) = p^2 - p - 1");
  render_p(sec_i, "Enter any prime p to compute f(p) = p^2 - p - 1 and check if it is 11-smooth.");
  make_interactive_widget(sec_i, "Enter prime p:", "dquad-input", "e.g. 37", "Compute", "depth_quad_calc", "dquad-result");
  render_p(sec_i, "Try: p=2 (gives 1), p=3 (gives 5), p=37 (gives 11^3 = 1331 -- the only outsider!), p=5 (19, not smooth), p=7 (41, not smooth).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast Table");
  render_contrast_row(sec5, "37", "Notable in recreational math (hexagonal number, repunit factor). The largest prime below 40.", "Unique among primes below 10,000: the only prime p outside {2,3,5,7,11} where f(p) = p^2-p-1 is 11-smooth. f(37) = 11^3. Primitive element in Z/12,612,600 with order 420.");
  render_contrast_row(sec5, "f(p) = p^2 - p - 1", "A generic quadratic. Smooth outputs are expected to become rare as p grows, by standard smooth-number heuristics.", "The smoothness rate among the ring's primes (2 out of 5 give smooth outputs) is already notable. But the specific return is the real fact: f(37) = 11^3, a perfect cube of one of the ring's primes. Exhaustive search confirms no other prime below 10,000 achieves this.");
  dom_append(dom_body(), sec5)
)
