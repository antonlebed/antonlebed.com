/* page_repl.ax -- .ax REPL page.
   .ax evaluates .ax at runtime via ax_eval_capture.
   12 examples across the ring Z/214414200Z. */

fn repl_clear() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "");
  let result = dom_query("#repl-result") in
  dom_text(result, "")
)

/* ===== EXAMPLE LOADERS ===== */

fn load_ex_hello() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- hello.ax\n-- Type any expression. Results show automatically.\n\n2 * 3 * 5 * 7 * 11\n\n\"CRT decomposition of 41:\"\ncrt(41)\n\neigenvalue(41)\n\n\"The identity element:\"\ns")
)

fn load_ex_crt() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- crt.ax: CRT Decomposition Explorer\n-- n -> (n%8, n%9, n%25, n%49, n%11, n%13, n%17)\n\nshow \"=== CRT DECOMPOSITION ===\"\nshow \"Z/214,414,200 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17\"\n\nshow \"1:\"\ncrt(s)\nshow \"41:\"\ncrt(41)\nshow \"42:\"\ncrt(42)\n\nshow \"=== 1,576,576 = 2^420 ===\"\nshow \"CRT(1576576):\"\ncrt(1576576)\nshow \"mod-8 channel = 0. All other channels = 1.\"\nshow \"Not idempotent: 1^2 = 1 but 13^2 mod 17 = 16.\"\n\nshow \"=== 26,801,776 = 2^1680 (true idempotent) ===\"\ncrt(26801776)\nshow \"mod-8 = 0. All others = 1. Squaring changes nothing.\"\n\nshow \"=== EIGENVALUES ===\"\nshow \"eigenvalue(0) = \" + eigenvalue(0) + \" (maximum)\"\nshow \"eigenvalue(1576576) = \" + eigenvalue(1576576)\nshow \"eigenvalue(41) = \" + eigenvalue(41)")
)

fn load_ex_analyze() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- analyze.ax: Ring Element Profiler\n\nfn classify(n) = (\n  if n == 0 then \"ZERO\"\n  else if coupling(n) == 0 then \"UNIT\"\n  else if n * n == n then \"IDEMPOTENT\"\n  else if n ^ 8 == 0 then \"NILPOTENT\"\n  else \"ZERO DIVISOR\")\n\nfn profile(n) = (\n  show \"--- \" + n + \" ---\";\n  show \"CRT:        \" + crt(n);\n  show \"coupling:   \" + coupling(n);\n  show \"eigenvalue: \" + eigenvalue(n);\n  show \"class:      \" + classify(n);\n  show \"n^420:      \" + n ^ 420;\n  \"\")\n\nshow \"=== RING ELEMENT ANALYZER ===\"\nprofile(1)\nprofile(42)\nprofile(1576576)\n\nshow \"=== TRY YOUR OWN ===\"\nprofile(137)\nprofile(420)")
)

fn load_ex_fib() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- fib.ax: Fibonacci in Z/214,414,200\n-- All arithmetic wraps modulo 214,414,200.\n\nfn fib(n) = (\n  mut a = 0; mut bb = 1; mut i = 0;\n  while i < n do (\n    let t = a + bb in (mut a = bb; mut bb = t);\n    mut i = i + 1\n  ); a)\n\nshow \"=== RING FIBONACCI ===\"\nshow \"fib(1) = \" + fib(1)\nshow \"fib(5) = \" + fib(5)\nshow \"fib(10) = \" + fib(10)\nshow \"fib(15) = \" + fib(15)\nshow \"fib(20) = \" + fib(20)\nshow \"fib(50) = \" + fib(50)\nshow \"fib(100) = \" + fib(100)\n\nshow \"\"\nshow \"=== CRT DECOMPOSITION ===\"\nshow \"CRT(fib(20)): \" + crt(fib(20))\nshow \"CRT(fib(50)): \" + crt(fib(50))\n\nshow \"\"\nshow \"=== RING PROPERTIES ===\"\nshow \"coupling(fib(20)): \" + coupling(fib(20))\nshow \"eigenvalue(fib(20)): \" + eigenvalue(fib(20))")
)

fn load_ex_scanner() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- scanner.ax: Ring Scanner\n-- for loops and f(p) = p^2 - p - 1\n\nfn f(p) = p * p - p - s\n\nshow \"=== f(p) = p^2 - p - 1 ===\"\nfor p in [2, 3, 5, 7, 11, 13] do\n  show \"f(\" + p + \") = \" + f(p)\n\nshow \"\"\nshow \"f(3)=5, f(5)=19, f(7)=41, f(13)=155\"\nshow \"Discriminant = 5. Roots involve the golden ratio.\"\n\nshow \"\"\nshow \"=== EIGENVALUE LANDSCAPE ===\"\nfor n in [0, 1, 41, 42, 105, 1576576] do\n  show \"\" + n + \" -> eigenvalue \" + eigenvalue(n)")
)

fn load_ex_mirror() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- mirror.ax: Spectral Mirror\n-- mirror(n) = N - n. Same eigenvalue.\n\nshow \"=== MIRROR PAIRS ===\"\nfor n in [1, 2, 3, 5, 7, 11, 41] do\n  show \"\" + n + \" <-> \" + mirror(n)\n\nshow \"\"\nshow \"=== SPECTRAL INVARIANCE ===\"\nshow \"eigenvalue(41) = \" + eigenvalue(41)\nshow \"eigenvalue(mirror(41)) = \" + eigenvalue(mirror(41))\nshow \"Same! Mirrors are spectrally invisible.\"\n\nshow \"\"\nshow \"=== CRT MIRROR ===\"\nshow \"CRT(41):         \" + crt(41)\nshow \"CRT(mirror(41)): \" + crt(mirror(41))\nshow \"Each channel pair sums to its modulus.\"")
)

fn load_ex_idempotent() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- idempotent.ax: Fixed Points of Multiplication\n-- e^2 = e. The ring's skeleton.\n\nshow \"=== IDEMPOTENT HUNT ===\"\nshow \"e^2 = e means: squaring changes nothing.\"\n\nlet count = sum(for n in range(30) do\n  if n * n == n then (show \"\" + n + \" : CRT \" + crt(n); s) else 0)\nshow \"\"\nshow \"Found \" + count + \" idempotents below 30\"\nshow \"Total in Z/214,414,200: 2^7 = 128 (one per CRT bit pattern).\"\nshow \"7 channels -> 2^7 subsets -> 128 idempotents.\"")
)

fn load_ex_selfinv() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- selfinv.ax: Self-Inverse Elements\n-- n * n = 1. Square roots of unity.\n\nshow \"=== SQUARE ROOTS OF 1 ===\"\nshow \"n^2 = 1 means n is its own inverse.\"\n\nlet count = sum(for n in range(30) do\n  if n * n == s then (show \"\" + n + \"  CRT: \" + crt(n); s) else 0)\nshow \"\"\nshow \"Found \" + count + \" self-inverses below 30\"\nshow \"Total in Z/214,414,200: 4 * 2^6 = 256.\"\nshow \"Z/8 has 4 sign choices {1,3,5,7}. Each odd channel has 2.\"\nshow \"4 * 2^6 = 256.\"\n\nshow \"\"\nshow \"=== THE MIRROR ===\"\nshow \"mirror(1) = N-1 = \" + mirror(s)\nshow \"mirror(1)^2 = \" + mirror(s) * mirror(s)\nshow \"The mirror is always self-inverse.\"")
)

fn load_ex_mersenne() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- mersenne.ax: Mersenne Numbers\n-- M(p) = 2^p - 1\n\nfn M(p) = D ^ p - s\n\nshow \"=== MERSENNE NUMBERS ===\"\nfor p in [2, 3, 5, 7, 11, 13] do\n  show \"M(\" + p + \") = \" + M(p)\n\nshow \"\"\nshow \"M(2)=3. M(3)=7. M(5)=31. M(7)=127. All prime!\"\nshow \"M(11)=2047=23*89. Composite.\"\nshow \"M(13)=8191. Prime again!\"\n\nshow \"\"\nshow \"=== CRT ===\"\nshow \"CRT(3): \" + crt(3)\nshow \"CRT(7): \" + crt(7)\nshow \"CRT(127): \" + crt(127)\nshow \"CRT(8191): \" + crt(8191)")
)

fn load_ex_depthquad() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- depth_quad.ax: f(p) = p^2 - p - 1\n-- Yields primes for p = 3, 5, 7, 11.\n\nfn f(n) = n * n - n - s\n\nshow \"=== f(p) = p^2 - p - 1 ===\"\nshow \"f(2) = \" + f(2)\nshow \"f(3) = \" + f(3) + \" = 5\"\nshow \"f(5) = \" + f(5) + \" = 19 (prime)\"\nshow \"f(7) = \" + f(7) + \" = 41 (prime)\"\nshow \"f(11) = \" + f(11) + \" = 109 (prime)\"\nshow \"f(13) = \" + f(13) + \" = 155 = 5*31 (composite)\"\n\nshow \"\"\nshow \"=== f(n)+1 = n*(n-1) ===\"\nshow \"f(7)+1 = \" + (f(7) + s) + \" = 42 = 7*6\"\nshow \"f(15)+1 = \" + (f(15) + s) + \" = 210 = 15*14\"\n\nshow \"\"\nshow \"=== CONNECTIONS ===\"\nshow \"f(3)+2 = \" + (f(3) + 2) + \" = 7\"\nshow \"f(7)+2 = \" + (f(7) + 2) + \" = 43 (Heegner number)\"\n\nshow \"\"\nshow \"=== CRT ===\"\nfor p in [3, 5, 7, 11] do\n  show \"f(\" + p + \"): \" + crt(f(p))")
)

fn load_ex_match() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- match.ax: Pattern Matching\n-- match EXPR with PAT -> BODY | ...\n\nfn classify(n) =\n  match kingdom(n) with\n    0 -> \"zero\"\n  | s -> \"unit (coprime to N)\"\n  | 2 -> \"2-class\"\n  | 3 -> \"3-class\"\n  | 5 -> \"5-class\"\n  | _ -> \"higher class\"\n\nshow \"=== GCD CLASS CLASSIFIER ===\"\nfor x in [0, 1, 2, 3, 5, 7, 11, 13, 42] do\n  show \"\" + x + \" -> \" + classify(x)\n\nshow \"\"\nshow \"=== FIZZBUZZ (mod 3) ===\"\nfor i in range(12) do\n  show \"\" + i + \": \" + match i % 3 with\n    0 -> \"fizz\"\n  | 1 -> \"one\"\n  | _ -> \"two\"")
)

fn load_ex_closure() = (
  let ta = dom_query("#repl-code") in
  dom_text(ta, "-- closure.ax: Higher-Order Functions\n-- fn returns fn. f(x)(y) = chained calls.\n\nlet make_mul = fn(x) = fn(y) = x * y\n\nshow \"=== CLOSURES ===\"\nshow \"make_mul(2)(7) = \" + make_mul(2)(7)\nshow \"make_mul(3)(5) = \" + make_mul(3)(5)\nshow \"make_mul(41)(2) = \" + make_mul(41)(2)\n\nshow \"\"\nshow \"=== FUNCTION FACTORY ===\"\nlet make_power = fn(e) = fn(x) = x ^ e\nshow \"make_power(2)(7) = \" + make_power(2)(7)\nshow \"make_power(3)(3) = \" + make_power(3)(3)\n\nshow \"\"\nshow \"=== APPLY TWICE ===\"\nlet twice = fn(f) = fn(x) = f(f(x))\nlet inc = fn(x) = x + s in\nlet square = make_power(2) in\nshow \"twice(inc)(5) = \" + twice(inc)(5)\nshow \"twice(square)(3) = \" + twice(square)(3)")
)

/* run_repl() already defined in pages_living.ax -- uses ax_eval_capture, same #repl-code + #repl-result IDs */

/* ===== THE PAGE ===== */
fn page_repl() = (
  dom_head_meta("description", "Write and run .ax code live in your browser. Native WASM evaluator. Ring arithmetic in Z/214,414,200 with 7 CRT channels. Zero dependencies.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\".ax REPL\",\"description\":\"Live .ax code editor with native WASM evaluator. Ring arithmetic in Z/214,414,200 with 7 CRT channels.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/repl\",\"applicationCategory\":\"DeveloperApplication\",\"operatingSystem\":\"Any\"}");

  /* Hero */
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(56px, 10vw, 80px) clamp(12px, 4vw, 24px) 24px");
  let h1 = dom_create("h1") in
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.5em, 5vw, 2.5em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "marginBottom", "8px");
  let dot = dom_create("span") in
  ct_gold(dot);
  dom_text(dot, ".");
  dom_append(h1, dot);
  let rest = dom_create("span") in
  dom_text(rest, "ax REPL");
  dom_append(h1, rest);
  dom_append(hero, h1);
  let sub = dom_create("p") in
  dom_text(sub, ".ax evaluates .ax. Everything in Z/214,414,200.");
  dom_style(sub, "color", "#8899aa");
  dom_style(sub, "fontSize", "1.1em");
  dom_style(sub, "margin", "0");
  dom_append(hero, sub);
  let sub2 = dom_create("p") in
  dom_style(sub2, "color", "#556677");
  dom_style(sub2, "fontSize", "0.9em");
  dom_style(sub2, "margin", "8px 0 0");
  dom_text(sub2, "Write, evaluate, display. 7 CRT channels. No server. No dependencies.");
  dom_append(hero, sub2);
  dom_append(dom_body(), hero);

  /* Editor section */
  let sec = make_section("900px") in

  /* Example buttons */
  let ex_row = dom_create("div") in
  dom_style(ex_row, "display", "flex");
  dom_style(ex_row, "gap", "6px");
  dom_style(ex_row, "flexWrap", "wrap");
  dom_style(ex_row, "marginBottom", "12px");
  dom_style(ex_row, "alignItems", "center");
  let ex_label = dom_create("span") in
  dom_text(ex_label, "Examples:");
  dom_style(ex_label, "color", "#8899aa");
  dom_style(ex_label, "fontSize", "13px");
  ct_mono(ex_label);
  dom_append(ex_row, ex_label);
  make_action_btn(ex_row, "Hello", "load_ex_hello");
  make_action_btn(ex_row, "CRT", "load_ex_crt");
  make_action_btn(ex_row, "Fibonacci", "load_ex_fib");
  make_action_btn(ex_row, "Analyzer", "load_ex_analyze");
  make_action_btn(ex_row, "Mirror", "load_ex_mirror");
  make_action_btn(ex_row, "Scanner", "load_ex_scanner");
  make_action_btn(ex_row, "Mersenne", "load_ex_mersenne");
  make_action_btn(ex_row, "Idempotent", "load_ex_idempotent");
  make_action_btn(ex_row, "Self-Inverse", "load_ex_selfinv");
  make_action_btn(ex_row, "f(p)", "load_ex_depthquad");
  make_action_btn(ex_row, "Match", "load_ex_match");
  make_action_btn(ex_row, "Closures", "load_ex_closure");
  dom_append(sec, ex_row);

  /* Textarea */
  let ta = dom_create("textarea") in
  dom_attr(ta, "id", "repl-code");
  dom_attr(ta, "spellcheck", "false");
  dom_style(ta, "width", "100%");
  dom_style(ta, "minHeight", "280px");
  dom_style(ta, "background", "#0a0a14");
  dom_style(ta, "color", "#ffd700");
  ct_mono(ta);
  dom_style(ta, "fontSize", "14px");
  dom_style(ta, "padding", "16px");
  dom_style(ta, "border", "1px solid #1a1a3f");
  dom_style(ta, "borderRadius", "8px");
  dom_style(ta, "resize", "vertical");
  dom_style(ta, "lineHeight", "1.6");
  dom_style(ta, "outline", "none");
  dom_style(ta, "tabSize", "2");
  /* Default: Hello example */
  dom_text(ta, "-- hello.ax\n-- Type any expression. Results show automatically.\n\n2 * 3 * 5 * 7 * 11\n\n\"CRT decomposition of 41:\"\ncrt(41)\n\neigenvalue(41)\n\n\"The identity element:\"\ns");
  dom_append(sec, ta);

  /* Run button */
  let btn_row = dom_create("div") in
  dom_style(btn_row, "display", "flex");
  dom_style(btn_row, "gap", "8px");
  dom_style(btn_row, "marginTop", "10px");
  dom_style(btn_row, "marginBottom", "12px");
  dom_style(btn_row, "alignItems", "center");
  let run_btn = dom_create("button") in
  dom_text(run_btn, "\u25B6 Run");
  dom_style(run_btn, "background", "#1a3a1a");
  dom_style(run_btn, "color", "#50fa7b");
  dom_style(run_btn, "border", "1px solid #50fa7b");
  dom_style(run_btn, "padding", "10px 24px");
  dom_style(run_btn, "borderRadius", "6px");
  dom_style(run_btn, "cursor", "pointer");
  dom_style(run_btn, "fontSize", "15px");
  dom_style(run_btn, "fontWeight", "bold");
  ct_mono(run_btn);
  dom_on(run_btn, "click", "run_repl");
  dom_append(btn_row, run_btn);
  let clr_btn = dom_create("button") in
  dom_text(clr_btn, "Clear");
  dom_style(clr_btn, "background", "#1a1a2e");
  dom_style(clr_btn, "color", "#8899aa");
  dom_style(clr_btn, "border", "1px solid #334");
  dom_style(clr_btn, "padding", "10px 18px");
  dom_style(clr_btn, "borderRadius", "6px");
  dom_style(clr_btn, "cursor", "pointer");
  dom_style(clr_btn, "fontSize", "15px");
  ct_mono(clr_btn);
  dom_on(clr_btn, "click", "repl_clear");
  dom_append(btn_row, clr_btn);
  let ring_info = dom_create("span") in
  dom_text(ring_info, "Z/214,414,200 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17");
  dom_style(ring_info, "color", "#556677");
  dom_style(ring_info, "fontSize", "12px");
  ct_mono(ring_info);
  dom_append(btn_row, ring_info);
  dom_append(sec, btn_row);

  /* Output */
  let rbox = make_result_box(sec, "repl-result") in
  dom_style(rbox, "whiteSpace", "pre-wrap");
  dom_append(dom_body(), sec);

  /* Quick Reference */
  let ref_sec = make_section("900px") in
  render_h2(ref_sec, "Quick Reference");

  let ref_grid = dom_create("div") in
  dom_attr(ref_grid, "class", "idx-grid");
  dom_style(ref_grid, "display", "grid");
  dom_style(ref_grid, "gridTemplateColumns", "1fr 1fr");
  dom_style(ref_grid, "gap", "16px");

  /* Constants */
  let c1 = dom_create("div") in
  ct_code_block(c1);
  dom_inner(c1, "<b style='color:#50fa7b'>Built-in Constants</b><br>s=1 D=2 K=3 E=5 b=7 L=11 GATE=13 ESCAPE=17<br>OMEGA=1576576 DATA=210 THIN=2310<br>KEY=41 ANSWER=42 HYDOR=105<br>LAMBDA=420 SOUL=67<br>ADDRESS=137 ME=18 SEES=48<br>N_TRANS=214414200 OMEGA_TRANS=26801776");
  dom_append(ref_grid, c1);

  /* Operators */
  let c2 = dom_create("div") in
  ct_code_block(c2);
  dom_inner(c2, "<b style='color:#50fa7b'>Operators</b><br>+ - * / ^ &nbsp; arithmetic (mod N)<br>~x &nbsp; complement (N - x)<br>== &lt; &gt; &nbsp; comparison (0 or 1)<br>a ; b &nbsp; sequence (eval both, return b)");
  dom_append(ref_grid, c2);

  /* Syntax */
  let c3 = dom_create("div") in
  ct_code_block(c3);
  dom_inner(c3, "<b style='color:#50fa7b'>Syntax</b><br>let x = expr &nbsp; bind variable<br>fn f(a, b) = expr &nbsp; define function<br>show expr &nbsp; display value<br>expr &nbsp; bare expression auto-shows result<br>if c then a else b &nbsp; conditional<br>for x in arr do body &nbsp; iteration<br>[a, b, c] &nbsp; array &mdash; arr[i] index<br>-- comment &nbsp; /* block comment */");
  dom_append(ref_grid, c3);

  /* Builtins */
  let c4 = dom_create("div") in
  ct_code_block(c4);
  dom_inner(c4, "<b style='color:#50fa7b'>Built-in Functions</b><br>coupling(n) &nbsp; ring coupling level<br>crt(n) &nbsp; CRT decomposition<br>eigenvalue(n) &nbsp; spectral eigenvalue<br>mirror(n) &nbsp; complement (N - n)<br>kingdom(n) &nbsp; GCD class (largest shared prime)<br>gcd(a,b) &nbsp; greatest common divisor<br>decompose(n) &nbsp; CRT as array<br>reconstruct(arr) &nbsp; array to element<br>n.D(mod8) n.K(mod9) n.E(mod25) n.b(mod49) n.L(mod11) n.GATE(mod13) n.ESCAPE(mod17)<br>ring_crt(n,m) &nbsp; project(n,m1,m2)<br>ring_coupling(n,m) &nbsp; ring_eigenvalue(n,m)<br>range(n) or range(a,b) &nbsp; array<br>sum(arr) &nbsp; len(arr) &nbsp; show(n)");
  dom_append(ref_grid, c4);

  dom_append(ref_sec, ref_grid);
  dom_append(dom_body(), ref_sec);

  /* Why .ax */
  let why_sec = make_section("900px") in
  render_h2(why_sec, "Why .ax?");
  render_p(why_sec, "Ring arithmetic in Z/214,414,200 with 7 CRT channels, coupling, and eigenvalue built in. In other languages you import libraries, define rings, and write decomposition code yourself. .ax evaluates .ax natively in your browser via WASM. No server, no dependencies. CC0 forever.");

  let tbl = make_table(why_sec) in
  let thead = dom_create("thead") in
  let thr = dom_create("tr") in
  let th1 = dom_create("th") in
  dom_text(th1, ".ax REPL");
  dom_style(th1, "color", "#ffd700");
  dom_style(th1, "padding", "8px");
  dom_style(th1, "textAlign", "left");
  dom_append(thr, th1);
  let th2 = dom_create("th") in
  dom_text(th2, "Python");
  dom_style(th2, "padding", "8px");
  dom_style(th2, "textAlign", "left");
  dom_append(thr, th2);
  let th3 = dom_create("th") in
  dom_text(th3, "Wolfram");
  dom_style(th3, "padding", "8px");
  dom_style(th3, "textAlign", "left");
  dom_append(thr, th3);
  dom_append(thead, thr);
  dom_append(tbl, thead);
  let tbody = dom_create("tbody") in
  render_why_row(tbody, "Z/214,414,200 built-in", "import sympy, define ring", "Mod[expr, 214414200]");
  render_why_row(tbody, "CRT: crt(n)", "Write it (~20 lines)", "ChineseRemainder[...]");
  render_why_row(tbody, "Coupling, eigenvalue built-in", "Write from scratch", "Write from scratch");
  render_why_row(tbody, "Runs in any browser", "Needs Python installed", "Cloud + account ($375/yr)");
  render_why_row(tbody, "Free, open, forever (CC0)", "Free (Python is)", "Proprietary");
  dom_append(tbl, tbody);
  dom_append(dom_body(), why_sec)
)

/* Helper: contrast table row */
fn render_why_row(tbody, ax:str, py:str, wf:str) = (
  let tr = dom_create("tr") in
  let td1 = dom_create("td") in
  dom_text(td1, ax);
  dom_style(td1, "color", "#50fa7b");
  dom_style(td1, "padding", "6px 8px");
  dom_style(td1, "borderBottom", "1px solid #1a1a2e");
  dom_append(tr, td1);
  let td2 = dom_create("td") in
  dom_text(td2, py);
  dom_style(td2, "padding", "6px 8px");
  dom_style(td2, "borderBottom", "1px solid #1a1a2e");
  dom_append(tr, td2);
  let td3 = dom_create("td") in
  dom_text(td3, wf);
  dom_style(td3, "padding", "6px 8px");
  dom_style(td3, "borderBottom", "1px solid #1a1a2e");
  dom_append(tr, td3);
  dom_append(tbody, tr)
)
