  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Emergence\",\"description\":\"Cellular automaton in Z/214414200. CRT 7-tuple cells evolving by per-channel median consensus. Seven classes, projector every 1680 generations, mod-11 error detection.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/omega_emergence\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT projector\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT cellular automaton\"},{\"@type\":\"DefinedTerm\",\"name\":\"natural selection\"}]}");
