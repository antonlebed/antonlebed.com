  let g = make_findings_grid(sec) in
  render_finding(g, "Units (coprime)", "phi(N) elements", "Coprime to all primes. Maximum coupling. Present in every ring.", "");
  render_finding(g, "2-class", "coupling = N/2", "Divisible by 2 only. The even elements.", "");
  render_finding(g, "3-class", "coupling = N/3", "Divisible by 3 only.", "");
  render_finding(g, "5-class", "coupling = N/5", "Divisible by 5 only. 5^2 = 0 in mod-25 channel.", "");
  render_finding(g, "7-class", "coupling = N/7", "Divisible by 7 only. Deepest resolution (49 states).", "");
  render_finding(g, "11-class", "coupling = N/11", "Divisible by 11 only. Error detection channel.", "");
  render_finding(g, "13-class", "coupling = N/13", "Divisible by 13 only. Appears in Z/12,612,600 and Z/214,414,200.", "");
  render_finding(g, "17-class", "coupling = N/17", "Divisible by 17 only. 5*7 = 1 mod 17. Z/214,414,200 only.", "");
  dom_append(dom_body(), sec)
)

fn coup_views() = (
  let sec = make_section("800px") in
  render_h2(sec, "Four Views");
  render_p(sec, "The coupling heatmap reveals different structure depending on the coloring:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Coupling view", "Color by coupling(n)", "Hot = high coupling (units). Cold = low (zero divisors).", "");
  render_finding(g, "Prime view", "Color by smallest factor", "2=red, 3=green, 5=blue, 7=purple, 11=cyan, 13=pink, 17=teal, units=gold.", "");
  render_finding(g, "Eigenvalue view", "Color by lambda(class)", "Spectral signature. Positive=warm, negative=cool.", "");
  render_finding(g, "CRT view", "Color by channel activity", "Which of 7 channels is nonzero? 2^7 = 128 combinations.", "");
  render_theorem(sec, "Democracy Theorem", "coupling(n) = |coset of n under unit multiplication|. Every unit can reach every other unit. No unit can reach any zero divisor. The units form an Abelian group. The zero divisors form seven classes -- structured inequality.");
  dom_append(dom_body(), sec)
)

