/* pages_observe.ax -- OBSERVE: explorer + interactive pages.
   Z/30Z. You can SEE the structure. 9 pages.
   eigenvalue_swim split to page_swim.ax.
   ecc_live split to page_ecc_live.ax. */
/* ================================================================
   EXPLORER / INTERACTIVE PAGES -- 10 pages (108/108)
   dom_on + dom_value LIVE (S966-S970). Interactive widgets on:
   crt_anatomy, coupling, ecc_live, eigenvalue_swim. Shared helpers in core.ax.
   S999: +emergence MAJ vote, +omega_emergence kingdom, +omega_journey D^k.
   ================================================================ */

/* dom_on callback: K=3 majority vote (emergence page, S999) */
fn emergence_maj_calc() = (
  let a = parse_int_from("#emrg-input-a") in
  let result = dom_query("#emrg-result") in
  let b = parse_int_from("#emrg-input-b") in
  let c = parse_int_from("#emrg-input-c") in
  /* AND = sigma, XOR = D, MAJ = K */
  let v_and = a * b * c in
  let v_xor = ((a + b + c) - 2 * (a * b) - 2 * (a * c) - 2 * (b * c) + 4 * (a * b * c)) in
  /* MAJ(a,b,c) = ab + ac + bc - 2abc for bits */
  let ab = a * b in
  let ac = a * c in
  let bc = b * c in
  let v_maj = ab + ac + bc - 2 * (a * b * c) in
  /* For bits: clamp to 0/1 */
  let ca = if a > 0 then 1 else 0 in
  let cb = if b > 0 then 1 else 0 in
  let cc = if c > 0 then 1 else 0 in
  let s = ca + cb + cc in
  let maj = if s >= 2 then 1 else 0 in
  let band = if ca == 1 then (if cb == 1 then (if cc == 1 then 1 else 0) else 0) else 0 in
  let bxor = (ca + cb + cc) % 2 in
  dom_inner(result, "<p style='color:#f0c040;margin:8px 0'>Inputs: " + "${ca}" + ", " + "${cb}" + ", " + "${cc}" + "</p><p style='color:#88ddaa;margin:4px 0'>AND: " + "${band}" + " -- persistence. What survives AND survives.</p><p style='color:#88ddaa;margin:4px 0'>XOR: " + "${bxor}" + " -- distinction. Parity.</p><p style='color:#88ddaa;margin:4px 0'>MAJ: " + "${maj}" + " -- majority. " + (if s == 3 then "Unanimous." else if s == 2 then "2-vs-1: majority decides." else if s == 1 then "1-vs-2: minority overruled." else "All zero.") + "</p><p style='color:#a0a0b0;margin:4px 0'>Pattern 7 = all three on (AND=1, XOR=1, MAJ=1). Try 1,1,1.</p>")
)

/* dom_on callback: omega_emergence class classifier (7 channels, TRANS ring) */
fn omega_em_kingdom_calc() = (
  let n = parse_int_from("#omem-input") in
  let result = dom_query("#omem-result") in
  let n2 = n % N_TRANS in
  let nd = n2 % 8 in
  let nk = n2 % 9 in
  let ne = n2 % 25 in
  let nb = n2 % 49 in
  let nl = n2 % 11 in
  let ng = n2 % 13 in
  let n17 = n2 % 17 in
  let dead = (if nd % 2 == 0 then 1 else 0) + (if nk % 3 == 0 then 1 else 0) + (if ne % 5 == 0 then 1 else 0) + (if nb % 7 == 0 then 1 else 0) + (if nl == 0 then 1 else 0) + (if ng == 0 then 1 else 0) + (if n17 == 0 then 1 else 0) in
  let kingdom = if dead == 0 then "unit (gold)"
    else if dead == 7 then "void (0)"
    else if dead > 1 then "compound (" + "${dead}" + " dead)"
    else if nd % 2 == 0 then "2-class (red)"
    else if nk % 3 == 0 then "3-class (green)"
    else if ne % 5 == 0 then "5-class (blue)"
    else if nb % 7 == 0 then "7-class (purple)"
    else if nl == 0 then "11-class (cyan)"
    else if ng == 0 then "13-class (rose)"
    else "17-class (teal)" in
  dom_inner(result, "<p style='color:#88ddaa;margin:8px 0'>n = " + "${n2}" + " mod 214,414,200</p><p style='color:#88ddaa;margin:4px 0'>CRT = (" + "${nd}" + ", " + "${nk}" + ", " + "${ne}" + ", " + "${nb}" + ", " + "${nl}" + ", " + "${ng}" + ", " + "${n17}" + ")</p><p style='color:" + (if dead == 0 then "#ffd700" else "#ff6666") + ";margin:4px 0'>Class: " + kingdom + "</p><p style='color:#a0a0b0;margin:4px 0'>" + (if dead == 0 then "Unit: all 7 channels alive. Thrives." else "Zero divisor: " + "${dead}" + " dead channel(s). Drains.") + "</p>")
)

/* dom_on callback: omega_journey D^k step (7 channels, TRANS ring) */
fn omega_journey_dk_calc() = (
  let k = parse_int_from("#owc-input") in
  let result = dom_query("#owc-result") in
  if k < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter k >= 0.</p>")
  else (
    /* compute 2^k mod each channel (7 channels, TRANS ring) */
    mut pd = 1;
    mut pk = 1;
    mut pe = 1;
    mut pb = 1;
    mut pl = 1;
    mut pg = 1;
    mut p17 = 1;
    mut i = 0;
    while i < k do (
      mut pd = (pd * 2) % 8;
      mut pk = (pk * 2) % 9;
      mut pe = (pe * 2) % 25;
      mut pb = (pb * 2) % 49;
      mut pl = (pl * 2) % 11;
      mut pg = (pg * 2) % 13;
      mut p17 = (p17 * 2) % 17;
      mut i = i + 1
    );
    let note = if k == 0 then "2^0 = 1. Starting point."
      else if k == 3 then "2^3 = 8. mod-8 channel zeroed (8 mod 8 = 0). First death."
      else if k == 6 then "2^6 = 64. mod-9 returns (64 mod 9 = 1)."
      else if k == 8 then "2^8 = 256. mod-17 returns (256 mod 17 = 1). ord(2,17) = 8."
      else if k == 10 then "2^10 = 1024. mod-11 returns (1024 mod 11 = 1)."
      else if k == 12 then "2^12 = 4096. mod-13 returns (4096 mod 13 = 1). phi(13) = 12."
      else if k == 20 then "2^20. mod-25 returns (mod 25 = 1). phi(25) = 20."
      else if k == 21 then "2^21. mod-49 returns (mod 49 = 1). ord(2,49) = 21."
      else if k == 42 then "2^42. All prime-power channels visited. Half-cycle of 6-channel lambda."
      else if k == 210 then "2^210. Half of lambda = 420."
      else if k == 420 then "2^420: CRT = (0,1,1,1,1,1,16). Six channels resolved, mod-17 at 16."
      else if k == 840 then "2^840. Half of lambda(TRANS) = 1680."
      else if k == 1680 then "2^1680: CRT = (0,1,1,1,1,1,1). All 7 channels resolved. Full TRANS period."
      else "" in
    dom_inner(result, "<p style='color:#88ddaa;margin:8px 0'>2^" + "${k}" + " mod channels:</p><p style='color:#88ddaa;margin:4px 0'>CRT = (" + "${pd}" + ", " + "${pk}" + ", " + "${pe}" + ", " + "${pb}" + ", " + "${pl}" + ", " + "${pg}" + ", " + "${p17}" + ")</p><p style='color:" + (if pd == 0 then "#ff6666" else "#88ddaa") + ";margin:4px 0'>mod 8: " + "${pd}" + (if pd == 0 then " -- ZERO" else "") + "</p><p style='color:" + (if pk == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 9: " + "${pk}" + (if pk == 1 then " -- RETURNED" else "") + "</p><p style='color:" + (if pe == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 25: " + "${pe}" + (if pe == 1 then " -- RETURNED" else "") + "</p><p style='color:" + (if pb == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 49: " + "${pb}" + (if pb == 1 then " -- RETURNED" else "") + "</p><p style='color:" + (if pl == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 11: " + "${pl}" + (if pl == 1 then " -- RETURNED" else "") + "</p><p style='color:" + (if pg == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 13: " + "${pg}" + (if pg == 1 then " -- RETURNED" else "") + "</p><p style='color:" + (if p17 == 1 then "#ffd700" else "#aaa") + ";margin:4px 0'>mod 17: " + "${p17}" + (if p17 == 1 then " -- RETURNED" else "") + "</p>" + (if len(note) > 0 then "<p style='color:#f0c040;margin:8px 0'>" + note + "</p>" else ""))
  )
)

fn coup_hero() = (
  dom_head_meta("description", "Coupling classes across all seven rings. Z/2,310: 32 classes. Z/12,612,600: 64 classes. Z/214,414,200: 128 classes. Each new prime doubles the anatomy.");
  let hero = make_hero("The Coupling Hierarchy") in
  let eq = dom_create("div") in
  dom_text(eq, "coupling(n) = N / gcd(n, N)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "18px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "20px");
  dom_append(hero, eq);
  render_p(hero, "Every ring in the hierarchy has coupling classes: elements grouped by which primes divide them. Each prime is present or absent in gcd(n,N), giving 2^k classes for k primes. Z/2,310 (5 primes): 32 classes. Z/12,612,600 (6 primes): 64 classes. Z/214,414,200 (7 primes): 128 classes. The class count doubles with each new prime.");
  dom_append(dom_body(), hero)
)

fn coup_classes() = (
  let sec = make_section("800px") in
  render_h2(sec, "Class Counts Across Rings");
  render_theorem(sec, "The Classification Theorem", "Z/NZ has exactly 2^k distinct coupling classes where k = number of distinct prime factors of N. Each prime is either present or absent in gcd(n,N). k binary choices = 2^k classes. This holds for every ring in the hierarchy.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "N");
  render_th(hdr, "Primes");
  render_th(hdr, "Classes");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "2*3*5*7", "4", "16 = 2^4");
  render_table_row_4(tbl, "Z/2,310", "2*3*5*7*11", "5", "32 = 2^5");
  render_table_row_4(tbl, "Z/970,200", "2^3 * 3^2 * 5^2 * 7^2 * 11", "5 (prime-power)", "32 = 2^5");
  render_table_row_4(tbl, "Z/12,612,600", "Z/970,200 * 13", "6", "64 = 2^6");
  render_table_row_4(tbl, "Z/214,414,200", "Z/12,612,600 * 17", "7", "128 = 2^7");
  render_p(sec, "Z/970,200 has the same 5 primes as Z/2,310 but with raised exponents (higher powers). Same 32 class patterns, more elements per class. Z/12,612,600 adds 13: classes double to 64. Z/214,414,200 adds 17: classes double again to 128. Each new prime doubles the anatomy.");
  render_h3(sec, "Pure Classes in Z/2,310 (32 classes)");
  let tbl2 = make_table(sec) in
  let hdr2 = dom_create("tr") in
  render_th(hdr2, "Class");
  render_th(hdr2, "Count");
  render_th(hdr2, "Coupling");
  render_th(hdr2, "Divisor");
  dom_append(tbl2, hdr2);
  render_table_row_4(tbl2, "Units (gcd=1)", "480", "2310 (max)", "coprime to all");
  render_table_row_4(tbl2, "2-pure (gcd=2)", "480", "1155", "divisible by 2 only");
  render_table_row_4(tbl2, "3-pure (gcd=3)", "240", "770", "divisible by 3 only");
  render_table_row_4(tbl2, "5-pure (gcd=5)", "120", "462", "divisible by 5 only");
  render_table_row_4(tbl2, "7-pure (gcd=7)", "80", "330", "divisible by 7 only");
  render_table_row_4(tbl2, "11-pure (gcd=11)", "48", "210", "divisible by 11 only");
  render_table_row_4(tbl2, "Void (0)", "1", "0", "all primes divide");
  render_p(sec, "In Z/214,414,200 (128 classes), two more pure classes appear: 13-pure and 17-pure. 1 unit + 7 pure + 119 compounds + 1 void = 128 = 2^7.");
  dom_append(dom_body(), sec)
)

