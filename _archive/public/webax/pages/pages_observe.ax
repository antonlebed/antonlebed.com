fn omega_em_hero() = (
  dom_head_meta("description", "CRT cellular automaton in Z/214,414,200. Each cell is a 7-channel CRT tuple. Per-channel median evolution. Projector every 1680 generations. Natural selection from algebra.");
  let hero = make_hero("CRT Emergence") in
  let eq = dom_create("div") in
  dom_text(eq, "CRT cells in Z/214,414,200 -- 7 channels, Carmichael period 1680");
  ct_mono(eq);
  dom_style(eq, "fontSize", "18px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "20px");
  dom_append(hero, eq);
  render_p(hero, "A cellular automaton where each cell is an element of Z/214,414,200, decomposed into 7 independent CRT channels. Evolution: per-channel median of 3 neighbors. Every 1680 generations, multiplication by 26,801,776 zeros out the mod-8 channel. Units thrive. Zero divisors drain. Natural selection from pure algebra.");
  dom_append(dom_body(), hero)
)

fn omega_em_anatomy() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Cell Anatomy");
  render_theorem(sec, "Seven Independent Channels", "Each cell is a 7-tuple: (mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17). Evolution rule: per-channel median of 3 neighbors (self + 2 orthogonal). Each channel evolves INDEPENDENTLY -- the CRT separation IS the parallel substrate. No interaction between channels except through the element they compose.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Space");
  render_th(hdr, "Median rule");
  render_th(hdr, "Property");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "mod 8", "Z/8", "median of 3 values mod 8", "Nilpotent: 2^3 = 0. Zeroed by projector.");
  render_table_row_4(tbl, "mod 9", "Z/9", "median of 3 values mod 9", "3^2 = 0. 9 states.");
  render_table_row_4(tbl, "mod 25", "Z/25", "median of 3 values mod 25", "5^2 = 0. 25 states.");
  render_table_row_4(tbl, "mod 49", "Z/49", "median of 3 values mod 49", "7^2 = 0. 49 states (deepest).");
  render_table_row_4(tbl, "mod 11", "Z/11", "median of 3 values mod 11", "Prime field. Error detection.");
  render_table_row_4(tbl, "mod 13", "Z/13", "median of 3 values mod 13", "Prime field. Cunningham chain stops.");
  render_table_row_4(tbl, "mod 17", "Z/17", "median of 3 values mod 17", "Prime field. 5*7 = 1 mod 17. Completes the ring.");
  dom_append(dom_body(), sec)
)

fn omega_em_kingdoms() = (
  let sec = make_section("800px") in
  render_h2(sec, "Seven Classes");
  render_p(sec, "Each cell has a class based on which CRT channels are zero. Units have all channels nonzero. Zero divisors have at least one dead channel. The class determines color, energy, and fate.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Class");
  render_th(hdr, "Color");
  render_th(hdr, "Condition");
  render_th(hdr, "Energy rule");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Units (coprime)", "Gold", "All channels nonzero", "Gain energy. Thrive.");
  render_table_row_4(tbl, "2-class", "Red", "mod 8 = 0", "Drain. Even channel dead.");
  render_table_row_4(tbl, "3-class", "Green", "mod 9 = 0", "Drain. mod-9 channel dead.");
  render_table_row_4(tbl, "5-class", "Blue", "mod 25 = 0", "Drain. mod-25 channel dead.");
  render_table_row_4(tbl, "7-class", "Purple", "mod 49 = 0", "Drain. mod-49 channel dead.");
  render_table_row_4(tbl, "11-class", "Cyan", "mod 11 = 0", "Drain. mod-11 channel dead.");
  render_table_row_4(tbl, "13-class", "Rose", "mod 13 = 0", "Drain. mod-13 channel dead.");
  render_table_row_4(tbl, "17-class", "Teal", "mod 17 = 0", "Drain. mod-17 channel dead.");
  render_theorem(sec, "Natural Selection", "Units (gold) gain energy because all 7 channels are active -- they can participate in all ring operations. Zero divisors drain because a dead channel means broken arithmetic. Not coded. Falls out of CRT structure. phi(N)/N = 3072/17017 = 18.05%. The selection pressure = this fraction.");
  dom_append(dom_body(), sec)
)

fn omega_em_heartbeat() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Carmichael Period");
  let g = make_findings_grid(sec) in
  render_finding(g, "lambda = 1680", "Carmichael period", "lcm(4,6,20,42,10,12,16) = 1680. Every 1680 generations: all 7 channels complete one full cycle.", "");
  render_finding(g, "26,801,776 projection", "Every 1680 gens", "mod-8 channel zeroed. CRT = (0,1,1,1,1,1,1). Even channel dies, everything else survives.", "");
  render_finding(g, "Sub-period 420", "Six-channel return", "lcm(4,6,20,42,10,12) = 420. After 420 gens, 6 of 7 channels return. mod-17 = 16 (not yet home).", "");
  render_finding(g, "mod-11 + mod-13 ECC", "Error detection", "mod-11 detects corruption. Dual mod-11 + mod-13 corrects. mod-17 adds redundancy.", "");
  render_theorem(sec, "Projector = Selective Pruning", "26,801,776 zeros out the mod-8 channel but preserves mod 9, mod 25, mod 49, mod 11, mod 13, mod 17. Not destruction -- selective pruning. The projector remembers everything except the mod-8 component.");
  dom_append(dom_body(), sec)
)

