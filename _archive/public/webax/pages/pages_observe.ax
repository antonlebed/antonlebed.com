)

fn page_crt_anatomy() = (
  crt_hero();
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Anatomy\",\"description\":\"Chinese Remainder Theorem: every element of Z/214414200 has a unique 7-channel CRT decomposition (mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17). Coupling, class, spectral trace, mirror duality, and reconstruction.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/crt_anatomy\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring isomorphism\"}]}");
  crt_channels();
  crt_constants();
