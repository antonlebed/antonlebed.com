fn crt_mirror() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mirror Duality");
  render_theorem(sec, "Trace Sum Formula", "For any element n coprime to N: Tr(n) + Tr(N-n) = sum of moduli = 8+9+25+49+11+13+17 = 132. Trace = sum of CRT residues. The mirror always completes what the element lacks.");
  let g = make_findings_grid(sec) in
  render_finding(g, "n = 1", "Tr = 7", "All 7 channels at minimum nonzero (each residue = 1).", "");
  render_finding(g, "n = 214,414,199", "Tr = 125", "All 7 channels at maximum (7+8+24+48+10+12+16).", "");
  render_finding(g, "n = 1,576,576", "Tr = 21", "mod-8 channel = 0. Other 6 channels alive.", "");
  render_finding(g, "n = 212,837,624", "Tr = 102", "Mirror of 1,576,576. Also mod-8 = 0, other channels at max-1.", "");
  render_theorem(sec, "Spectral Mirror Theorem", "lambda(n) = lambda(N-n). Exhaustive check: 485,101 pairs, every one matches. The mirror is spectrally invisible -- you cannot distinguish an element from its mirror by eigenvalue alone.");
  dom_append(dom_body(), sec)
)

fn crt_kingdoms() = (
  let sec = make_section("800px") in
