  render_table_row_4(tbl, "Z/970,200", "970200", "32 = 2^5", "16/77");
  render_table_row_4(tbl, "Z/12,612,600", "12612600", "64 = 2^6", "192/1001");
  render_table_row_4(tbl, "Z/214,414,200", "214414200", "128 = 2^7", "3072/17017");
  render_theorem(sec, "The Septum", "phi(N)/N = fraction of units. Z/2,310: 16/77 = 20.78%. Z/12,612,600: 192/1001 = 19.18%. Z/214,414,200: 3072/17017 = 18.05%. Each new prime tightens the fraction. The boundary becomes more selective as the ring grows.");
  render_p(sec, "Class count doubles with each new prime (binary choice). Element count scales by Carmichael lambda = 420 from Z/2,310 to Z/970,200 (raising exponents preserves class structure). 13 and 17 each double the anatomy without raising exponents.");
  dom_append(dom_body(), sec)
)

fn coup_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Contrast Table");
  let ctbl = make_table(sec) in
  let chdr = dom_create("tr") in
  render_th(chdr, "Aspect");
