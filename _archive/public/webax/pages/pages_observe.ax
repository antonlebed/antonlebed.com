  render_contrast_row(ctbl, "128 classes", "Divisor lattice of 214,414,200", "2^7 = seven binary channel choices. Each ring doubles.");
  render_contrast_row(ctbl, "8 pure classes", "Divisor subgroups", "Unit class plus one pure class per prime. Structured hierarchy.");
  render_contrast_row(ctbl, "Coupling strength", "Coprimality measure", "coupling(n) = N/gcd(n,N). Measures how connected an element is.");
  render_contrast_row(ctbl, "Ring hierarchy", "Different moduli", "Z/2,310 -> Z/970,200 -> Z/12,612,600 -> Z/214,414,200. Each adds structure.");
  render_contrast_row(ctbl, "Heatmap", "Visualization technique", "Four independent colorings of the same ring");
  render_contrast_row(ctbl, "phi(N)/N", "Euler product formula", "Fraction of units tightens: 20.78% (Z/2,310) -> 18.05% (Z/214,414,200)");
  dom_append(dom_body(), sec)
)

/* dom_on callback: coupling analyzer (upgraded S1305 for 7 rings) */
fn coupling_analyze() = (
  let n = parse_int_from("#coupling-input") in
  let result_el = dom_query("#coupling-result") in
  let d = n % 8 in
  let k = n % 9 in
  let e = n % 25 in
  let b_ch = n % 49 in
  let l = n % 11 in
  let g = n % 13 in
  let esc = n % 17 in
  /* Which primes divide n */
  let div_d = if d % 2 == 0 then 1 else 0 in
  let div_k = if k % 3 == 0 then 1 else 0 in
  let div_e = if e % 5 == 0 then 1 else 0 in
  let div_b = if b_ch % 7 == 0 then 1 else 0 in
  let div_l = if l == 0 then 1 else 0 in
  let div_g = if g == 0 then 1 else 0 in
  let div_esc = if esc == 0 then 1 else 0 in
  let dead = div_d + div_k + div_e + div_b + div_l + div_g + div_esc in
  /* Kingdom = smallest dividing prime */
  let kingdom = if dead == 0 then "unit (coprime to all)"
    else if dead == 7 then "void"
    else if div_d == 1 then (if dead == 1 then "2-class" else "compound")
    else if div_k == 1 then (if dead == 1 then "3-class" else "compound")
    else if div_e == 1 then (if dead == 1 then "5-class" else "compound")
    else if div_b == 1 then (if dead == 1 then "7-class" else "compound")
    else if div_l == 1 then (if dead == 1 then "11-class" else "compound")
    else if div_g == 1 then (if dead == 1 then "13-class" else "compound")
    else "17-class" in
  /* Coupling from phi contributions */
  let cp_d = if d % 2 > 0 then 4 else if d % 4 > 0 then 2 else 1 in
  let cp_k = if k % 3 > 0 then 6 else if k > 0 then 2 else 1 in
  let cp_e = if e % 5 > 0 then 20 else if e > 0 then 4 else 1 in
  let cp_b = if b_ch % 7 > 0 then 42 else if b_ch > 0 then 6 else 1 in
  let cp_l = if l > 0 then 10 else 1 in
  let cp_g = if g > 0 then 12 else 1 in
  let cp_esc = if esc > 0 then 16 else 1 in
  let coupling = cp_d * cp_k * cp_e * cp_b * cp_l * cp_g * cp_esc in
  /* Channel status */
  let ch_d = if div_d == 1 then "zero" else "nonzero" in
  let ch_k = if div_k == 1 then "zero" else "nonzero" in
  let ch_e = if div_e == 1 then "zero" else "nonzero" in
  let ch_b = if div_b == 1 then "zero" else "nonzero" in
  let ch_l = if div_l == 1 then "zero" else "nonzero" in
  let ch_g = if div_g == 1 then "zero" else "nonzero" in
  let ch_esc = if div_esc == 1 then "zero" else "nonzero" in
  dom_inner(result_el, "<p style='color:#ffd700;margin:4px 0'><b>Class: " + kingdom + "</b></p><p style='color:#88ddaa;margin:4px 0'>Coupling: <b>" + "${coupling}" + "</b> (of 38,707,200 max)</p><p style='color:#c0c0d0;margin:4px 0'>mod 8=" + ch_d + " | mod 9=" + ch_k + " | mod 25=" + ch_e + " | mod 49=" + ch_b + " | mod 11=" + ch_l + " | mod 13=" + ch_g + " | mod 17=" + ch_esc + "</p><p style='color:#b0b0c0;margin:4px 0'>Dead channels: " + "${dead}" + "/7 | CRT = (" + "${d}" + ", " + "${k}" + ", " + "${e}" + ", " + "${b_ch}" + ", " + "${l}" + ", " + "${g}" + ", " + "${esc}" + ")</p>")
)

/* Interactive coupling section */
fn coup_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Coupling Analyzer");
  render_p(sec, "Enter any number. See its class, coupling, and all 7 channel statuses in Z/214,414,200. Units have maximum coupling (38,707,200 = phi(214,414,200)). Void has zero.");
  make_interactive_widget(sec, "Analyze any element:", "coupling-input", "e.g. 42", "Analyze", "coupling_analyze", "coupling-result");
  render_p(sec, "Try: 1 (unit), 2 (2-class), 13 (13-class), 17 (17-class), 6 (compound), 0 (void).");
  dom_append(dom_body(), sec)
)

fn page_coupling() = (
  coup_hero();
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Coupling Hierarchy\",\"description\":\"Coupling classes across seven rings. Z/2310: 32 classes. Z/12612600: 64 classes. Z/214414200: 128 classes. Each new prime doubles the anatomy.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/coupling\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"coupling hierarchy\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring hierarchy\"},{\"@type\":\"DefinedTerm\",\"name\":\"coupling classes\"}]}");
  coup_classes();
  coup_interactive();
  coup_kingdoms();
  coup_views();
  coup_scaling();
  coup_contrast()
)

fn crt_hero() = (
  dom_head_meta("description", "CRT anatomy. Every number in Z/214,414,200 has a unique 7-channel decomposition. Coupling, class, trace, mirror duality, and CRT reconstruction. 2300 years old.");
  let hero = make_hero("CRT Anatomy") in
  let eq = dom_create("div") in
  dom_text(eq, "n = (n mod 8, n mod 9, n mod 25, n mod 49, n mod 11, n mod 13, n mod 17)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "18px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "20px");
  dom_append(hero, eq);
  render_p(hero, "Every element of Z/214,414,200 decomposes into seven independent channels. The decomposition IS the identity. CRT is 2300 years old (Sun Tzu, ~300 BC). This page shows what it reveals when the modulus is 214,414,200 = 2^3 * 3^2 * 5^2 * 7^2 * 11 * 13 * 17.");
  dom_append(dom_body(), hero)
)

fn crt_channels() = (
  let sec = make_section("800px") in
  render_h2(sec, "Seven Channels");
  render_theorem(sec, "The Chinese Remainder Theorem", "Z/214,414,200 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17. Forced by prime power factorization. Each channel is independent: knowing n mod 8 tells you NOTHING about n mod 9. Seven orthogonal views of one number. Reconstruction is unique and total.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Space");
  render_th(hdr, "Values");
  render_th(hdr, "Property");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "mod 8", "Z/8 (mod 2^3)", "8", "Nilpotent: 2^3 = 0. Only even-prime channel.");
  render_table_row_4(tbl, "mod 9", "Z/9 (mod 3^2)", "9", "3^2 = 0. Smallest odd prime-power.");
  render_table_row_4(tbl, "mod 25", "Z/25 (mod 5^2)", "25", "5^2 = 0. Discriminant of x^2-x-1.");
  render_table_row_4(tbl, "mod 49", "Z/49 (mod 7^2)", "49", "7^2 = 0. Deepest resolution (49 states).");
  render_table_row_4(tbl, "mod 11", "Z/11 (mod 11)", "11", "Prime field. 1+2+3+5 = 11. Error detection.");
  render_table_row_4(tbl, "mod 13", "Z/13 (mod 13)", "13", "Prime field. Cunningham chain stops here.");
  render_table_row_4(tbl, "mod 17", "Z/17 (mod 17)", "17", "Prime field. 5*7 = 1 mod 17. Completes the ring.");
  render_p(sec, "Total: 8 * 9 * 25 * 49 * 11 * 13 * 17 = 214,414,200. Seven primes, each at its maximum power. The product IS the ring.");
  dom_append(dom_body(), sec)
)

