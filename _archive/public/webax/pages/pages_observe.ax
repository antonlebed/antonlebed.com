  render_contrast_row(ctbl, "Pattern 7", "Arbitrary stable pattern", "111 in binary. Wins MAJ against any 2 opponents.");
  render_contrast_row(ctbl, "Pattern transfer", "Not modeled", "Dying cells pass patterns to neighbors. Death creates structure.");
  render_contrast_row(ctbl, "Three operations", "Design choice", "AND + XOR + MAJ = functionally complete. Minimum set.");
  dom_append(dom_body(), sec)
)

fn emrg_interactive() = (
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: 3-Voter Majority");
