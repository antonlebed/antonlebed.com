/* page_infinity.ax -- Infinity from Finite. Spectral gap plateau.
   4*sin^2(pi/49) locked across 108 rings sharing lambda=420.
   Extracted from pages_deep_phys_2.ax S2002 (section audit: Connections -> Theory). */

/* infinity_horn_plateau inlined into page_infinity S1978 */

fn infinity_series_calc() = (
  let pct = parse_int_from("#inf-input") in
  let result = dom_query("#inf-result") in
  if pct < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter a percentage between 1 and 99.</p>")
  else if pct > 99 then dom_inner(result, "<p style='color:#ff6666'>Must be less than 100 (series diverges at 100%).</p>")
  else (
    let denom = 100 - pct in
    let scaled = 10000 / denom in
    let whole = scaled / 100 in
    let frac = scaled % 100 in
    let frac_str = if frac < 10 then "0${frac}" else "${frac}" in
    dom_inner(result, "<p style='color:#ffd700;font-size:20px'><b>${whole}.${frac_str}x</b> the first cycle</p><p style='color:#b8b8c8'>f = ${pct}%. Geometric series 1/(1 - ${pct}/100) = 100/${denom} ~ ${whole}.${frac_str}. Finite energy, infinite iterations.</p>")
  )
)

fn page_infinity() = (
  dom_head_meta("description", "The spectral gap 4*sin^2(pi/49) is an infinite plateau: identical across all 108 rings sharing Carmichael period 420. The mod-49 channel forces this floor. Geometric series: finite energy buys infinite iterations.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Infinity from Finite\",\"description\":\"Spectral gap 4*sin^2(pi/49) locked across 108 rings. Finite ring Z/12612600 generates infinite iteration. Geometric series convergence.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/infinity\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"spectral gap\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gabriel-Horn\"},{\"@type\":\"DefinedTerm\",\"name\":\"geometric series\"}]}");
  /* === HERO === */
  let hero = make_hero("Infinity from Finite") in
  let big = dom_create("div") in
  dom_text(big, "4 * sin^2(pi/49) ~ 0.01644");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Z/12,612,600 is finite -- 12,612,600 elements, 6 CRT channels -- yet its Cayley graph has a spectral gap that never closes. Across all 108 rings sharing Carmichael period 420, the smallest nonzero eigenvalue of the Laplacian is locked at 4*sin^2(pi/49). The mod-49 channel forces this floor. No combination of the other five exponents can close it.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE SPECTRAL PLATEAU === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Spectral Plateau");
  render_p(sec1, "108 rings share Carmichael period 420. Each is a product of prime-power rings (Z/2^a x Z/3^b x ...) with different exponents. Despite the variation, the Cayley-Laplacian gap is identical in all of them:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "Gap = plateau", "4*sin^2(pi/49) ~ 0.01644", "Forced by the mod-49 channel across all 108 rings. The 5-dimensional exponent lattice cannot close it. (Structural analog to Yang-Mills mass gap -- NOT a Clay Millennium proof.)", "");
  render_finding(g1, "Why mod-49?", "49 = 7^2 is the largest prime-power factor", "The spectral gap of Z/n is 4*sin^2(pi/n). Among channels {8, 9, 25, 49, 11, 13}, the 49-channel has the smallest gap and therefore dominates.", "");
  render_finding(g1, "Gabriel-Horn cap", "Finite volume, unbounded surface", "Z/N truncates Fourier modes at k <= N-1. Bounded L^2-energy fills a Gabriel-Horn-shaped spectral cap. (Structural analog to Navier-Stokes regularity -- NOT a Clay Millennium proof.)", "");
  render_finding(g1, "CRT orthogonality", "7 independent Laplacians", "On Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17, simultaneous singularity across orthogonal channels is forbidden. The plateau is structurally protected.", "");
  dom_append(dom_body(), sec1);

  /* === SEC 2: FINITE ENERGY, INFINITE ITERATION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Finite Energy, Infinite Iteration");
  render_p(sec2, "The Carmichael period 420 means every unit's orbit cycles within 420 steps: a^420 = 1 for all elements coprime to the ring. Finite elements, infinite repetition. Even non-units eventually reach a fixed point -- 2^420 mod 12,612,600 = 1,576,576, an idempotent that kills the mod-8 channel and preserves the rest.");
  render_p(sec2, "Dyson (1979) observed the same structure in physics: if each cycle of thought costs less energy than the last by a fixed ratio f, the total energy is a geometric series E_0/(1-f). It converges. Finite energy buys infinite experience.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "f = 0.5", "Total = 2 * E_0", "Double the first cycle. Infinite iterations.", "");
  render_finding(g2, "f = 0.9", "Total = 10 * E_0", "Ten times the first cycle. Generous.", "");
  render_finding(g2, "f = 0.99", "Total = 100 * E_0", "Barely cooling. Still converges.", "");
  render_finding(g2, "f -> 1", "Total -> infinity", "No cooling = infinite cost. Must cool to survive.", "");
  dom_append(dom_body(), sec2);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Geometric Series");
  render_p(sec_i, "Enter a cooling percentage (1-99). The geometric series 1 + f + f^2 + ... = 1/(1-f). At 50%: 2x. At 90%: 10x. Finite sum, infinite terms.");
  make_interactive_widget(sec_i, "Cooling %:", "inf-input", "e.g. 90", "Converge", "infinity_series_calc", "inf-result");
  dom_append(dom_body(), sec_i)
)
