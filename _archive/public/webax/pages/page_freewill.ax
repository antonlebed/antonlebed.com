/* page_freewill.ax -- The Catalan Gap. 3^2 - 2^3 = 1.
   Mihailescu 2002: only consecutive perfect powers. Pure number theory.
   Extracted from pages_deep_phys_2.ax S2002 (section audit: Connections -> Theory). */

/* Integer power: base^exp via repeated multiplication */
fn fw_ipow(base, exp) = (
  mut r = 1;
  mut i = 0;
  while i < exp do (mut r = r * base; mut i = i + 1);
  r
)

/* Gap calculator: p^q - q^p */
fn freewill_gap_calc() = (
  let p = parse_int_from("#fw-input-p") in
  let q = parse_int_from("#fw-input-q") in
  let result = dom_query("#fw-result") in
  if p < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter p >= 1.</p>")
  else if q < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter q >= 1.</p>")
  else if p > 20 then dom_inner(result, "<p style='color:#ff6666'>p too large (max 20).</p>")
  else if q > 20 then dom_inner(result, "<p style='color:#ff6666'>q too large (max 20).</p>")
  else (
    let pq = fw_ipow(p, q) in
    let qp = fw_ipow(q, p) in
    let gap = pq - qp in
    let absgap = if gap < 0 then 0 - gap else gap in
    let note = if absgap == 1 then "<span style='color:#ffd700'> -- |gap| = 1. The only consecutive prime pair with this property (Mihailescu 2002).</span>" else "" in
    dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'>${p}^${q} = ${pq}</p><p style='color:#88ddaa;margin:4px 0'>${q}^${p} = ${qp}</p><p style='color:#ffd700;margin:8px 0'>Difference: ${pq} - ${qp} = ${gap}" + note + "</p>")
  )
)

fn page_freewill() = (
  dom_head_meta("description", "3^2 - 2^3 = 1. Among all consecutive prime pairs, only (2,3) produces adjacent perfect powers. Catalan's conjecture, proved by Mihailescu in 2002: the only solution to x^a - y^b = 1 with x,y,a,b > 1 is 3^2 - 2^3.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Catalan Gap\",\"description\":\"3^2 - 2^3 = 9 - 8 = 1. The only consecutive prime pair with gap exactly 1. Related to Mihailescu theorem (2002).\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/freewill\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Catalan conjecture\"},{\"@type\":\"DefinedTerm\",\"name\":\"consecutive prime powers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Mihailescu theorem\"}]}");
  /* === HERO === */
  let hero = make_hero("The Catalan Gap") in
  let big = dom_create("div") in
  dom_text(big, "3^2 - 2^3 = 9 - 8 = 1");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "8 and 9 are the only consecutive perfect powers (Mihailescu, 2002 -- proving Catalan's 1844 conjecture). This means 3^2 - 2^3 = 1: the larger power minus the smaller is exactly 1. Among all pairs of consecutive primes, only (2, 3) has this property. The first two primes of the ring sit at this unique boundary.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE GAP === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Why (2, 3) Is Unique");
  render_theorem(sec1, "Consecutive Prime Gap", "For consecutive primes (p, q) with p < q, compute q^p - p^q. At (2, 3): 3^2 - 2^3 = 9 - 8 = 1. At (3, 5): 5^3 - 3^5 = 125 - 243 = -118. At (5, 7): 7^5 - 5^7 = 16807 - 78125 = -61318. The gap goes negative immediately and stays there. Only at (2, 3) is q^p - p^q = 1.");
  render_p(sec1, "This connects to Catalan's conjecture (proved by Mihailescu in 2002): the ONLY solution to x^a - y^b = 1 with x, y, a, b > 1 is 3^2 - 2^3 = 1. No other perfect powers are adjacent.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "3^2 = 9", "The ring's parallelism unit", "9 = lcm of the compiler's analysis passes. Also: the chain stops at 3^2 (Catalan identity 3^2 = 2^3 + 1).", "");
  render_finding(g1, "2^3 = 8", "Pareto depth of prime 2", "Z/8 has 4 involutions {1,3,5,7} -- unique among prime-power rings. This is why 2 alone reaches depth 3.", "");
  render_finding(g1, "Gap = 1", "Irreducible", "Cannot be decomposed further. The smallest possible positive gap between perfect powers.", "");
  render_finding(g1, "Uniqueness", "Only at (2, 3)", "No other pair of consecutive primes gives gap = 1. Checked computationally for all primes.", "");
  dom_append(dom_body(), sec1);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Prime Power Gaps");
  render_p(sec_i, "Enter two numbers p and q. See both p^q and q^p and their difference. Only (2, 3) gives a gap of exactly 1. Try 2,3 then 3,5 then 5,7.");
  let lbl_i = dom_create("p") in
  dom_text(lbl_i, "p and q:");
  dom_style(lbl_i, "color", "#b8b8c8");
  dom_style(lbl_i, "marginTop", "24px");
  dom_style(lbl_i, "marginBottom", "8px");
  dom_append(sec_i, lbl_i);
  let row_i = dom_create("div") in
  dom_style(row_i, "display", "flex");
  dom_style(row_i, "gap", "8px");
  dom_style(row_i, "alignItems", "center");
  dom_style(row_i, "marginBottom", "12px");
  make_input_field(row_i, "#fw-input-p", "p (e.g. 2)");
  make_input_field(row_i, "#fw-input-q", "q (e.g. 3)");
  make_action_btn(row_i, "Gap", "freewill_gap_calc");
  dom_append(sec_i, row_i);
  make_result_box(sec_i, "fw-result");
  dom_append(dom_body(), sec_i)
)
