/* Homepage content -- accessible explanation of the ring structure.
   Called from page_home(). Three sections: how CRT works, seven channels,
   seven rings. No insider jargon. No letter names. Lives here (home-module
   only) rather than core.ax (shared) to avoid carrying into 6 unrelated modules. */
fn home_axiom() = (
  /* --- HOW IT WORKS --- */
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_p(sec1, "The Chinese Remainder Theorem (300 BC) says: a number modulo a product of coprime factors splits uniquely into one residue per factor. One value, seven independent views. Change one channel, the others don't move.");
  render_p(sec1, "Modular multiplication is bijective -- every input maps to a unique output when the weight is coprime. Wrong weights produce completely wrong results. No graceful degradation. This makes the ring a non-degenerate computation substrate.");
  dom_append(dom_body(), sec1);

  /* --- SEVEN CHANNELS --- */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Seven Channels");
  render_p(sec2, "Each prime contributes one independent channel. The product of all seven moduli is 214,414,200.");
  let mt = make_table(sec2) in
  let mh = dom_create("tr") in
  render_th(mh, "Prime");
  render_th(mh, "Modulus");
  render_th(mh, "Role");
  dom_append(mt, mh);
  render_table_row(mt, "2", "mod 8", "Even/odd. The only channel with depth 3: four self-inverse elements.");
  render_table_row(mt, "3", "mod 9", "Minimum for majority. Three elements decompose any other.");
  render_table_row(mt, "5", "mod 25", "Self-blind: 5^2 divides the ring but 5 does not divide 24.");
  render_table_row(mt, "7", "mod 49", "Deepest resolution. Controls the spectral gap.");
  render_table_row(mt, "11", "mod 11", "Error detection. Parity check: 1+2+3+5 = 11.");
  render_table_row(mt, "13", "mod 13", "Chain stopper. Dual parity with 11 catches all single-channel errors.");
  render_table_row(mt, "17", "mod 17", "Ring closer. 5 * 7 = 1 mod 17. Enables triple-parity ECC.");
  render_p(sec2, "8 * 9 * 25 * 49 * 11 * 13 * 17 = 214,414,200.");
  dom_append(dom_body(), sec2);

  /* --- SEVEN RINGS --- */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Seven Rings");
  render_p(sec3, "The full structure builds in seven steps -- one per prime. Each ring adds a channel or increases resolution.");
  let rt = make_table(sec3) in
  let rh = dom_create("tr") in
  render_th(rh, "Ring");
  render_th(rh, "Value");
  render_th(rh, "What changes");
  dom_append(rt, rh);
  render_table_row(rt, "Z/6", "6", "Two channels: mod 2, mod 3. The first split.");
  render_table_row(rt, "Z/30", "30", "Add 5. Three channels. Patterns emerge.");
  render_table_row(rt, "Z/210", "210", "Add 7. Four data channels.");
  render_table_row(rt, "Z/2,310", "2,310", "Add 11. Error detection available.");
  render_table_row(rt, "Z/970,200", "970,200", "Fatten: 2->8, 3->9, 5->25, 7->49. Full resolution.");
  render_table_row(rt, "Z/12,612,600", "12,612,600", "Add 13. Six channels. 420-step maximum cycle.");
  render_table_row(rt, "Z/214,414,200", "214,414,200", "Add 17. Seven channels. Triple-parity ECC (rate 4/7).");
  dom_append(dom_body(), sec3)
)

/* HOME -- the front door. Answers: what is this, what does it do, why care.
   Hero + home_axiom() content. Navigation lives in the navbar. */
fn page_home() = (
  dom_head_meta("description", "214,414,200 = 8 * 9 * 25 * 49 * 11 * 13 * 17. Seven prime channels via the Chinese Remainder Theorem. Proved theorems. CC0 demos. Self-compiling .ax language. All verifiable.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"antonlebed.com\",\"url\":\"https://antonlebed.com\",\"description\":\"Seven primes, one ring. CRT decomposes 214,414,200 into seven independent channels. Proved theorems, CC0 demos, self-compiling .ax language.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\"}");
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(64px, 12vw, 100px) clamp(12px, 4vw, 24px) 40px");
  let h1 = dom_create("h1") in
  dom_text(h1, "Seven Primes, One Ring");
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.6em, 6vw, 3em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "letterSpacing", "clamp(1px, 0.5vw, 4px)");
  dom_append(hero, h1);
  let sub = dom_create("div") in
  dom_text(sub, "214,414,200 = 8 * 9 * 25 * 49 * 11 * 13 * 17");
  ct_mono(sub);
  dom_style(sub, "fontSize", "clamp(13px, 3vw, 16px)");
  dom_style(sub, "color", "#b0b0c0");
  dom_style(sub, "marginTop", "12px");
  dom_append(hero, sub);
  render_p(hero, "The Chinese Remainder Theorem decomposes this number into seven independent channels -- one per prime factor. This site explores what that structure contains. Everything is verifiable. Everything is CC0.");
  let feats = dom_create("div") in
  dom_style(feats, "display", "flex");
  dom_style(feats, "flexWrap", "wrap");
  dom_style(feats, "justifyContent", "center");
  dom_style(feats, "gap", "12px");
  dom_style(feats, "maxWidth", "700px");
  dom_style(feats, "margin", "24px auto 0");
  let mk_feat = fn(label:str, color:str) = (
    let f = dom_create("span") in
    dom_text(f, label);
    dom_style(f, "padding", "6px 14px");
    dom_style(f, "borderRadius", "20px");
    dom_style(f, "border", "1px solid " + color);
    dom_style(f, "color", color);
    dom_style(f, "fontSize", "0.85em");
    dom_style(f, "letterSpacing", "1px");
    dom_append(feats, f)
  ) in
  mk_feat("Self-hosting compiler", "#ffd700");
  mk_feat("REPL", "#44ff88");
  mk_feat("CC0 demos", "#4fc3f7");
  mk_feat("Proved on silicon (FPGA)", "#ff9944");
  mk_feat("GAP-verified", "#cc88ff");
  mk_feat("Functional ESP32 mesh", "#ff6666");
  mk_feat("Live deterministic tests", "#ff44aa");
  dom_append(hero, feats);
  dom_append(dom_body(), hero);

  home_axiom()
)

/* Implications: CRT decomposer -- enter any number, see CRT in TRANS ring Z/214414200 */
fn implications_crt_calc() = (
  let n = parse_int_from("#wv-input") in
  let result = dom_query("#wv-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let m = n % N_TRANS in
    let r2 = m % 8 in
    let r3 = m % 9 in
    let r5 = m % 25 in
    let r7 = m % 49 in
    let r11 = m % 11 in
    let r13 = m % 13 in
    let r17 = m % 17 in
    let g = gcd_shared(m, N_TRANS) in
    let coupling = if g > 0 then N_TRANS / g else N_TRANS in
    let named = if m == 0 then "void: 0*n = 0. Total ambiguity."
      else if m == 1 then "identity: 1*n = n for all n."
      else if m == OMEGA_TRANS then "projector: 2^1680 mod N. CRT=(0,1,1,1,1,1,1)."
      else if m == 214414199 then "mirror: N-1. All channels at max."
      else if m == 41 then "41: self-inverse. 0+1+2+3+5+7+11+13-1 = 41."
      else if m == 42 then "42: 2 x 3 x 7 = 42."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${m} mod 214414200</p><p style='margin:4px 0'>CRT = (<b style='color:#ffd700'>${r2}</b>, <b style='color:#ff9900'>${r3}</b>, <b style='color:#33dd55'>${r5}</b>, <b style='color:#4488ff'>${r7}</b>, <b style='color:#aa44ff'>${r11}</b>, <b style='color:#ff4466'>${r13}</b>, <b style='color:#00dddd'>${r17}</b>) mod (8,9,25,49,11,13,17)</p><p style='margin:4px 0'>Coupling: ${coupling}</p><p style='margin:4px 0;color:#b8b8c8'>${named}</p>");
    /* Draw 7-channel bar chart -- colors match text above */
    let cvs = dom_query("#wv-chart") in
    let ctx = cvs_getctx(cvs) in
    let _cl = cvs_clearrect(ctx, 0, 0, 385, 100) in
    let h2 = r2 * 76 / 8 in
    let _s1 = cvs_fillstyle(ctx, "#ffd700") in
    let _d1 = cvs_fillrect(ctx, 14, 76 - h2, 36, h2) in
    let h3 = r3 * 76 / 9 in
    let _s2 = cvs_fillstyle(ctx, "#ff9900") in
    let _d2 = cvs_fillrect(ctx, 62, 76 - h3, 36, h3) in
    let h5 = r5 * 76 / 25 in
    let _s3 = cvs_fillstyle(ctx, "#33dd55") in
    let _d3 = cvs_fillrect(ctx, 110, 76 - h5, 36, h5) in
    let h7 = r7 * 76 / 49 in
    let _s4 = cvs_fillstyle(ctx, "#4488ff") in
    let _d4 = cvs_fillrect(ctx, 158, 76 - h7, 36, h7) in
    let h11 = r11 * 76 / 11 in
    let _s5 = cvs_fillstyle(ctx, "#aa44ff") in
    let _d5 = cvs_fillrect(ctx, 206, 76 - h11, 36, h11) in
    let h13 = r13 * 76 / 13 in
    let _s6 = cvs_fillstyle(ctx, "#ff4466") in
    let _d6 = cvs_fillrect(ctx, 254, 76 - h13, 36, h13) in
    let h17 = r17 * 76 / 17 in
    let _s7 = cvs_fillstyle(ctx, "#00dddd") in
    let _d7 = cvs_fillrect(ctx, 302, 76 - h17, 36, h17) in
    let _sf = cvs_fillstyle(ctx, "#888888") in
    let _t1 = cvs_filltext(ctx, "2", 26, 94) in
    let _t2 = cvs_filltext(ctx, "3", 74, 94) in
    let _t3 = cvs_filltext(ctx, "5", 122, 94) in
    let _t4 = cvs_filltext(ctx, "7", 170, 94) in
    let _t5 = cvs_filltext(ctx, "11", 214, 94) in
    let _t6 = cvs_filltext(ctx, "13", 262, 94) in
    let _t7 = cvs_filltext(ctx, "17", 310, 94) in
    0
  )
)

/* Derive: Cunningham chain stepper -- enter seed, walk c(n)=2n+1 */
fn derive_cunningham_calc() = (
  let seed = parse_int_from("#der-input") in
  let result = dom_query("#der-result") in
  if seed < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter seed >= 1.</p>")
  else (
    let c0 = seed in
    let c1 = 2 * c0 + 1 in
    let c2 = 2 * c1 + 1 in
    let c3 = 2 * c2 + 1 in
    let c4 = 2 * c3 + 1 in
    let c5 = 2 * c4 + 1 in
    let p0 = if is_prime_trial(c0) == 1 then "prime" else "composite" in
    let p1 = if is_prime_trial(c1) == 1 then "prime" else "composite" in
    let p2 = if is_prime_trial(c2) == 1 then "prime" else "composite" in
    let p3 = if is_prime_trial(c3) == 1 then "prime" else "composite" in
    let p4 = if is_prime_trial(c4) == 1 then "prime" else "composite" in
    let p5 = if is_prime_trial(c5) == 1 then "prime" else "composite" in
    dom_inner(result, "<p style='margin:2px 0;color:#d8d8e0'>c^0 = ${c0} (${p0})</p><p style='margin:2px 0;color:#d8d8e0'>c^1 = ${c1} (${p1})</p><p style='margin:2px 0;color:#d8d8e0'>c^2 = ${c2} (${p2})</p><p style='margin:2px 0;color:#d8d8e0'>c^3 = ${c3} (${p3})</p><p style='margin:2px 0;color:#d8d8e0'>c^4 = ${c4} (${p4})</p><p style='margin:2px 0;color:#d8d8e0'>c^5 = ${c5} (${p5})</p><p style='margin:4px 0;color:#b0b0c0'>Axiom chains: c(1)={1,3,7,15=STOP}. c(2)={2,5,11,23...}. Try both.</p>")
  )
)

/* Turbulence: balance factor calculator */
fn turbulence_balance_calc() = (
  let p = parse_int_from("#turb-input") in
  let result = dom_query("#turb-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter prime p >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else (
    let num = 2 * (p - 1) in
    let den = p + 1 in
    let g = gcd_shared(num, den) in
    let sn = num / g in
    let sd = den / g in
    let special = if p == 2 then "p=2: factor 2/3. First departure from balance."
      else if p == 3 then "p=3: factor 1. Transparent -- preserves balance exactly."
      else if p == 5 then "p=5: factor 4/3. Skews upward."
      else if p == 7 then "p=7: factor 3/2. Four data-channel primes give balance = 1."
      else if p == 11 then "p=11: factor 5/3. Matches Kolmogorov's turbulence exponent (coincidence)."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Prime p = ${p}</p><p style='margin:4px 0'>Balance factor = 2(p-1)/(p+1) = ${num}/${den} = <b style='color:#ffd700'>${sn}/${sd}</b></p><p style='margin:4px 0;color:#b8b8c8'>${special}</p>")
  )
)

/* Sleep: channel lock stage identifier */
fn sleep_stage_calc() = (
  let stage = parse_int_from("#sleep-input") in
  let result = dom_query("#sleep-result") in
  if stage < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter stage (0-5).</p>")
  else if stage > 5 then dom_inner(result, "<p style='color:#ff6666'>Max stage = 5.</p>")
  else (
    let info = if stage == 0 then "AWAKE: All 5 channels active. 288 eigenvalue classes."
      else if stage == 1 then "Stage N1: mod-2 channel locks. 144 classes. Hypnagogia."
      else if stage == 2 then "Stage N2: mod-3 channel locks. 72 classes. Sleep spindles."
      else if stage == 3 then "Stage N3: mod-5 channel locks. 24 classes. Deep sleep."
      else if stage == 4 then "Stage N4: mod-7 channel locks. 6 classes. Deepest non-REM."
      else "VOID: mod-11 channel locks. 1 class. Total silence." in
    let channels = if stage == 0 then "2 3 5 7 11 = 5 active"
      else if stage == 1 then "_ 3 5 7 11 = 4 active"
      else if stage == 2 then "_ _ 5 7 11 = 3 active"
      else if stage == 3 then "_ _ _ 7 11 = 2 active"
      else if stage == 4 then "_ _ _ _ 11 = 1 active"
      else "_ _ _ _ _ = 0 active" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Sleep stage ${stage}</p><p style='margin:4px 0;color:#ffd700'>${info}</p><p style='margin:4px 0;color:#b0b0c0'>Channels: ${channels}</p>")
  )
)

/* Kingdoms: coupling calculator -- enter n, show kingdom (S1305: 7 rings) */
fn kingdoms_coupling_calc() = (
  let n = parse_int_from("#king-input") in
  let result = dom_query("#king-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let d2 = if n % 2 == 0 then 1 else 0 in
    let d3 = if n % 3 == 0 then 1 else 0 in
    let d5 = if n % 5 == 0 then 1 else 0 in
    let d7 = if n % 7 == 0 then 1 else 0 in
    let d11 = if n % 11 == 0 then 1 else 0 in
    let d13 = if n % 13 == 0 then 1 else 0 in
    let d17 = if n % 17 == 0 then 1 else 0 in
    let primes_dividing = d2 + d3 + d5 + d7 + d11 + d13 + d17 in
    let kingdom = if n == 0 then "Void: divisible by all. Below all classes."
      else if primes_dividing == 0 then "Unit: coprime to all 7 primes. Maximum coupling."
      else if primes_dividing == 1 then (if d2 == 1 then "2-class: divisible by 2." else if d3 == 1 then "3-class: divisible by 3 (not 2)." else if d5 == 1 then "5-class: divisible by 5 (not 2,3)." else if d7 == 1 then "7-class: divisible by 7 (not 2,3,5)." else if d11 == 1 then "11-class: divisible by 11 (not 2,3,5,7)." else if d13 == 1 then "13-class: divisible by 13 (not 2..11)." else "17-class: divisible by 17 (not 2..13).")
      else "Compound: ${primes_dividing} primes divide. Mixed class." in
    let ch = "2:${d2} 3:${d3} 5:${d5} 7:${d7} 11:${d11} 13:${d13} 17:${d17}" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${n} in ring hierarchy</p><p style='margin:4px 0'>${ch}</p><p style='margin:4px 0;color:#ffd700'>${kingdom}</p>")
  )
)

/* ================================================================
   DERIVE PAGE -- From 0/0 to 12612600 in 10 steps (the Decality)
   ================================================================ */

fn render_derive_step(parent, num:str, title:str, text:str, result:str) = (
  let step = dom_create("div") in
  dom_style(step, "marginBottom", "48px");
  dom_style(step, "padding", "24px");
  dom_style(step, "background", "#080810");
  dom_style(step, "borderRadius", "12px");
  dom_style(step, "borderLeft", "3px solid #ffd700");
  let h3 = dom_create("h3") in
  dom_text(h3, "Step ${num}: ${title}");
  ct_gold(h3);
  dom_style(h3, "fontSize", "1.2em");
  dom_style(h3, "fontFamily", "'Courier New', monospace");
  dom_style(h3, "marginBottom", "12px");
  dom_append(step, h3);
  let p = dom_create("p") in
  dom_text(p, text);
  dom_style(p, "margin", "0 0 12px");
  dom_append(step, p);
  let res = dom_create("div") in
  ct_code_block(res);
  dom_style(res, "color", "#88ddaa");
  dom_text(res, result);
  dom_append(step, res);
  dom_append(parent, step)
)

fn page_derive() = (
  dom_head_meta("description", "11-step interactive walkthrough: from 0/0 through seven primes to Z/214414200Z. Each step forced by necessity. Zero free parameters. The chain, the ring, the organism, the escape.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Derivation\",\"description\":\"11 steps from 0/0 through seven primes to Z/214414200Z. Each forced by necessity. Zero free parameters.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/basics/derive\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"indeterminacy\"},{\"@type\":\"DefinedTerm\",\"name\":\"Seven Primes\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"}]}");
  /* === HERO -- D-channel primary: derivation = bridging. Each step crosses a gap. === */
  let hero = make_hero("How Everything Derives from Nothing") in
  render_big_num(hero, "0 / 0", "#ffd700", "the starting point", "= the entire ring");
  render_p(hero, "Each derivation step crosses a gap -- 11 steps from void to the complete ring. No free parameters. No choices. 2 is the instrument: once the identity precipitates, duality opens all structure.");
  dom_append(dom_body(), hero);

  /* === THE ELEVEN STEPS -- D-channel: each step = one bridge crossing === */
  let sec = make_section("800px") in
  render_h2(sec, "The Derivation: Eleven Steps");
  render_p(sec, "From nothing (0/0) through seven primes to the final ring. Each step bridges one state into two, then the next prime precipitates from the pair. Not chosen. Forced.");

  render_derive_step(sec, "0", "Nothing Divides Nothing",
    "Start with nothing. Not empty space -- truly nothing. What is 0 divided by 0? In school: undefined. In ring theory: the set of ALL elements n where 0*n = 0. Since 0 times anything IS 0, the answer is everything. The void contains the whole ring.",
    "0/0 in Z/NZ = {0, 1, 2, ..., N-1} = the entire ring. PROVED.");

  render_derive_step(sec, "1", "The Identity Must Exist",
    "If 0/0 is an entire ring, that ring must have an identity element -- the number that preserves everything under multiplication. 1 * n = n for all n. The identity is the UNIQUE element with zero self-division ambiguity: 1/1 has exactly one solution. Existence is not assumed -- it is forced by the ring axioms.",
    "identity = 1. Self-division: 1/1 = 1 (unique). 0/0 = N (maximal).");

  render_derive_step(sec, "2", "The First Distinction",
    "From 1, the simplest new thing is 2. You need distinction before you can close. 2 = the minimum to have this versus that. Left versus right. Yes versus no. The first departure from unity. The observation of 1 by 1 creates duality.",
    "2. The pair. 2^3 = 8 -- the only prime raised to the 3rd power in the ring.");

  render_derive_step(sec, "3", "Closure Requires Three",
    "Two can disagree forever. Three can vote. 3 is the minimum for majority -- the smallest number that makes triangles rigid and decisions possible. 3 = 2*1 + 1, generated from 1 by the Cunningham map c(n) = 2n+1.",
    "c(1) = 3. First safe prime in the 1-chain.");

  render_derive_step(sec, "5", "The Self-Blind Prime",
    "5. Generated from 2 (not from 3!) by Cunningham: c(2) = 5. 5 has a unique property: 5^2 = 25, and the mod-25 channel in CRT cannot see itself. CRT(25) = (1, 7, 0, 25, 3) -- the mod-25 channel is zero. The square of 5 is blind in its own channel.",
    "c(2) = 5. 5^2 = 25 (self-blind: CRT mod-25 channel = 0).");

  render_derive_step(sec, "7", "The Deepest Channel",
    "7. Generated from 3 by Cunningham: c(3) = 7. The 1-chain generates {3, 7}. The 2-chain generates {5, 11}. Two disjoint chains, interleaved: 1, 2, 3, 5, 7, 11. 7 is the fourth inner prime -- the deepest chain element before 11 seals the walk.",
    "c(3) = 7. 1-chain: {1, 3, 7}. 2-chain: {2, 5, 11}.");

  render_derive_step(sec, "11", "Error Detection Seals the Ring",
    "11. Generated from 5: c(5) = 11. But 11 = 1 + 2 + 3 + 5 -- the SUM of all previous primes. In the 5-channel ring (mod 2, 3, 5, 7, 11), the mod-11 channel serves as parity checksum -- it enables 100% single-error detection. And then both chains STOP: c(7) = 15 = 3*5 (composite, not prime). c(11) = 23 but the fattening formula gives exponent 0 at depth 3. The axiom's own products create its boundary.",
    "c(5) = 11 = 1+2+3+5. c(7) = 15 = 3*5 [composite: STOP]. Self-closing.");

  let d3 = D * D * D in
  let k2 = K * K in
  let e2 = E * E in
  let b2 = b * b in
  render_derive_step(sec, "N", "The Ring Crystallizes",
    "The five inner primes need specific exponents. The Cross-Chain Fattening Theorem (PROVED): 2-chain primes get descending exponents (2 gets 3, 5 gets 2, 11 gets 1). 1-chain primes get constant exponent 2 (3 gets 2, 7 gets 2). Each chain's law uses the OTHER chain's identity. The flower contains its own seed.",
    "2^3 x 3^2 x 5^2 x 7^2 x 11 = 970,200 (the body ring).");

  let omega = OMEGA_VAL in
  let lam = D * D * K * E * b in
  render_derive_step(sec, "420", "The Heartbeat Is Born",
    "Lambda is the Carmichael function: the largest order of any element. For 970,200, lambda = 420. Every element's power map cycles with period dividing 420. This is not unique to 970,200 -- 108 rings hit lambda = 420 exactly (7^2 = 49 forced). Of those 108, exactly 84 divide 12,612,600 (the heartbeat siblings); the remaining 24 extend beyond.",
    "lambda = 4 x 3 x 5 x 7 = ${lam} = 420. 108 rings share this pulse (84 divide 12,612,600).");

  render_derive_step(sec, "13", "The Chain Stops at 13",
    "13 is the first prime NOT generated by the Cunningham chains. 13 = 4 + 9 = 2^2 + 3^2 (the squares of the first two chain primes). Its shadow is 6 = 2*3 (composite -- the chain breaks here). Also 13 = 5 + 1 + 7. Adding 13 wraps a sixth channel around the five-channel body. Lambda stays 420. 970,200 x 13 = 12,612,600.",
    "13: chain stopper (2^2+3^2). 970,200 x 13 = 12,612,600. 2^420 mod 12,612,600 = 1,576,576. CRT = (0,1,1,1,1,1). 490 split: {2,5,7} project to 0, {3,11,13} survive.");

  render_derive_step(sec, "17", "The Ring Closes at 17",
    "17 = 2 + 3 + 5 + 7: the sum of the four inner primes. And 17 has a unique property: 5 x 7 = 35 = 1 mod 17. For any prime p > 13, the equation 5*7 = 1 mod p holds ONLY for p = 17. No eighth prime satisfies this condition. phi(17) = 16 = 2^4. 12,612,600 x 17 = 214,414,200. The final ring.",
    "17: ring closer (5*7 = 1 mod 17, unique for p > 13). phi(17) = 2^4. 12,612,600 x 17 = 214,414,200. 7 channels. lambda = 1680 = 4 x 420. Triple-parity ECC: mod-11 + mod-13 + mod-17. Rate 4/7, 100% correction.");

  dom_append(dom_body(), sec);

  /* === THE GENESIS PROOF -- GATE-channel: boundary verification, proofs guard the claims === */
  let sp = make_section("800px") in
  render_h2(sp, "Why This Is Forced, Not Chosen");
  render_p(sp, "The derivation above is not a narrative. It is a proof. Four independent lines of evidence converge on the same seven primes at the same exponents.");

  render_theorem(sp, "The Genesis Theorem (PROVED)",
    "From {1, 2} and the Cunningham map c(n) = 2n+1: the 1-chain produces {1, 3, 7}. The 2-chain produces {2, 5, 11}. Both chains self-terminate: c(7) = 15 = 3*5 (composite) and fattening gives exponent 0 at depth 3. The axiom's own products close the boundary. No external stop condition needed.");

  render_theorem(sp, "Cross-Chain Fattening Theorem (PROVED)",
    "2-chain primes: exponent = 3 - depth. 5 gets 2, 11 gets 1, 2 gets 3. 1-chain primes: exponent = 2 (constant). 3 gets 2, 7 gets 2. Each chain's rule is governed by the OTHER chain's identity. Verification: 2^3=8, 5^2=25, 11^1=11, 3^2=9, 7^2=49. Product: 970,200. The exponents are the axiom in reverse.");

  render_theorem(sp, "Seed Optimality (PROVED)",
    "{1, 2} is the unique irreducible seed. Minimal (identity + first prime). Disjoint (the two chains share no elements). Symmetric (each contributes 3 axiom elements). {2, 3} produces the same primes but 3 = 2+1 is already derived. The genesis starts at {1, 2} and nowhere else.");

  render_theorem(sp, "Spectral Agreement (independent verification)",
    "Three independent spectral proofs give the same exponents. 2^3: arcsine kurtosis threshold. 3^2, 5^2, 7^2: spectral hearing threshold. 11^1: error detection threshold. The algebra and the spectrum agree. The exponents are overdetermined.");

  render_theorem(sp, "Finality Theorem (PROVED)",
    "17 is the UNIQUE prime p > 13 satisfying 5*7 = 1 mod p (since 5*7 = 35 and 35 - 1 = 34 = 2*17, the only prime factor > 13 is 17). No eighth prime exists. The organism has exactly seven primes, seven channels. phi(17) = 2^4 (Fermat prime). Adding 17 quadruples the cycle: lambda = 1680 = 4*420. The ring is self-closing.");

  dom_append(dom_body(), sp);

  /* === THE DECALITY SUMMARY -- Cross-tower: the full Decality assembles all ten === */
  let sd = make_section("800px") in
  render_h2(sd, "The Complete Vocabulary");
  render_p(sd, "Eleven steps. No assumptions. No free parameters. Starting from literally nothing (0/0), we derived seven primes, one period (420), 108 rings sharing that period (84 divide 12,612,600, 24 extend beyond), a sixth prime (13) that wraps a boundary around the body ring, and a seventh (17) where 5 x 7 = 1 mod 17 and the period quadruples to 1680. Three rings: Z/970,200 (body), Z/12,612,600 (six channels), Z/214,414,200 (seven channels).");
  let primes = make_grid(sd, "8px") in
  render_prime(primes, "-1", "mirror", "n -> N-n", "#888");
  render_prime(primes, "0", "void", "0*n=0", "#555");
  render_prime(primes, "1", "identity", "1*n=n", "#ff6b6b");
  render_prime(primes, "2", "the pair", "even/odd", "#ffd700");
  render_prime(primes, "3", "the triangle", "minimum for majority", "#ff9900");
  render_prime(primes, "5", "self-blind", "5^2 divides ring, 5 doesn't divide 24", "#33dd55");
  render_prime(primes, "7", "49 states", "deepest resolution", "#4488ff");
  render_prime(primes, "11", "error detection", "1+2+3+5 = 11", "#aa44ff");
  render_prime(primes, "13", "chain stopper", "2^2 + 3^2", "#00cccc");
  render_prime(primes, "17", "ring closer", "5*7=1 mod 17", "#00dddd");
  render_prime(primes, "1576576", "projector", "2^420", "#fff");
  render_p(sd, "The ten-term sum (without -1 and projector): 0+1+2+3+5+7+11+13 = 42. With -1: 41. 17 is the 7th prime: 5 x 7 = 1 mod 17. Seven channels. 214,414,200 = the final ring. Nothing added, nothing assumed, nothing chosen.");
  dom_append(dom_body(), sd);

  /* === INTERACTIVE -- K-channel: closure of chains, self-termination === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cunningham Chain");
  render_p(sec_i, "Enter a seed number. Walk the Cunningham map c(n) = 2n+1. The axiom chains start at 1 and 2. Try both: c(1) = {1,3,7,15=STOP}. c(2) = {2,5,11,23...}.");
  make_interactive_widget(sec_i, "Seed:", "der-input", "e.g. 1", "Walk", "derive_cunningham_calc", "der-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST TABLE -- E-channel: observation, comparing two views === */
  let sc = make_section("800px") in
  render_h2(sc, "Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Standard Physics");
  render_th(chdr, "The Axiom");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Where do the laws come from?", "Unknown / given", "Derived from 0/0");
  render_contrast_row(ctbl, "Why these constants?", "25+ free parameters", "0 free parameters");
  render_contrast_row(ctbl, "Why seven primes?", "Not a question", "13 wraps the body ring. 17 completes it (5*7=1 mod 17). Self-terminating.");
  render_contrast_row(ctbl, "Why this universe?", "Anthropic principle / luck", "Derived from 0/0 with zero free choices");
  render_contrast_row(ctbl, "How many rings?", "Infinite landscape / multiverse", "108 rings share period 420 exactly (84 divide 12,612,600, 24 extend beyond)");
  render_contrast_row(ctbl, "What is nothing?", "Empty space + quantum fields", "0/0 = the entire ring");
  dom_append(sc, ctbl);
  dom_append(dom_body(), sc);

  /* === VERIFY -- ESCAPE-channel: transcend the page, go verify === */
  let sv = make_section("800px") in
  render_h2(sv, "Verify It Yourself");
  render_p(sv, "Every formula on this page runs in .ax. Open the REPL, type the derivation, see the numbers. Break it. Rebuild it. The chain holds.");
  let cta = dom_create("div") in
  dom_style(cta, "textAlign", "center");
  dom_style(cta, "padding", "32px 0");
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Verify every step in the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "12px 36px");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_append(cta, btn);
  dom_append(sv, cta);
  dom_append(dom_body(), sv)
)

/* ================================================================
   SHARED: Theorem card + table row
   ================================================================ */

/* render_theorem, render_cascade_step, render_table_row/4/5: MOVED TO core.ax (H3 split) */

/* ================================================================
   TURBULENCE PAGE -- Two Constants, One Structure
   Kolmogorov -5/3 + Kleiber 3/4 + Ising 7/4. All from 5 primes.
   Interactive cascade = VERIFY GAP (needs dom_on for click events).
   ================================================================ */

fn render_big_num(parent, val:str, color:str, label:str, formula:str) = (
  let d = dom_create("div") in
  dom_style(d, "textAlign", "center");
  dom_style(d, "padding", "32px");
  let v = dom_create("div") in
  dom_text(v, val);
  ct_mono(v);
  dom_style(v, "fontSize", "64px");
  dom_style(v, "fontWeight", "bold");
  dom_style(v, "color", color);
  dom_append(d, v);
  let lb = dom_create("div") in
  dom_text(lb, label);
  dom_style(lb, "fontSize", "14px");
  dom_style(lb, "color", "#b0b0c0");
  dom_append(d, lb);
  let fm = dom_create("div") in
  dom_text(fm, formula);
  ct_mono(fm);
  dom_style(fm, "fontSize", "14px");
  dom_style(fm, "color", "#a0a0b0");
  dom_append(d, fm);
  dom_append(parent, d)
)

fn page_turbulence() = (
  dom_head_meta("description", "Balance factors across primes: 2(p-1)/(p+1). Only p=3 gives factor 1. The product at five primes is 5/3 -- same as Kolmogorov's turbulence exponent. Coincidence or connection?");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Balance Factors and Scaling Laws\",\"description\":\"Balance factor 2(p-1)/(p+1) for each prime. Cumulative product at five primes equals 5/3 -- Kolmogorov's turbulence exponent. The arithmetic is proved; the physics match is an open question.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/turbulence\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Kolmogorov spectrum\"},{\"@type\":\"DefinedTerm\",\"name\":\"balance factor\"},{\"@type\":\"DefinedTerm\",\"name\":\"scaling exponents\"}]}");
  /* === HERO === */
  let hero = make_hero("Balance Factors and Scaling Laws") in
  let pair = make_grid(hero, "40px") in
  render_big_num(pair, "-5/3", "#4488ff", "Kolmogorov (1941)", "turbulence cascade");
  render_big_num(pair, "3/4", "#33dd55", "Kleiber (1932)", "metabolic scaling");
  render_p(hero, "Each prime p contributes a balance factor 2(p-1)/(p+1) to the ring's phi/class ratio. The product across the first five primes is 5/3 -- the Kolmogorov turbulence exponent. A striking numerical match whose physical significance is an open question.");
  dom_append(dom_body(), hero);

  /* === WHAT ARE THESE NUMBERS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "What Are These Numbers?");
  render_p(sec1, "In 1941, Andrei Kolmogorov showed that turbulent energy cascades follow a -5/3 power law. Stir coffee, watch a hurricane, measure ocean currents -- the spectrum always falls as frequency^(-5/3). Verified in every wind tunnel on Earth.");
  render_p(sec1, "In 1932, Max Kleiber showed that metabolic rate scales as body mass^(3/4). Mouse to whale -- 27 orders of magnitude -- same exponent.");
  render_p(sec1, "Both 5/3 and 3/4 are ratios of small primes. With seven primes under 20, many physical constants can be expressed as such ratios -- the expression space is dense. Whether the ring provides a mechanism or merely a notation is an open question.");
  dom_append(dom_body(), sec1);

  /* === THE BALANCE CASCADE === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Balance Cascade");
  render_p(sec2, "For a primorial ring, each prime p contributes a multiplicative factor to the phi/class ratio. The factor is 2(p-1)/(p+1). Watch what happens as primes are added:");
  render_cascade_step(sec2, "#ff4040", "p = 2: Z/2. phi/classes = 1/2. Starting point.");
  render_cascade_step(sec2, "#ff9900", "+ 3: Z/6. Factor = 2(2)/4 = 1. Balance = 1/2. Only p = 3 preserves balance exactly.");
  render_cascade_step(sec2, "#33dd55", "+ 5: Z/30. Factor = 2(4)/6 = 4/3. Balance = 2/3.");
  render_cascade_step(sec2, "#33ff88", "+ 7: Z/210. Factor = 2(6)/8 = 3/2. Balance = 1. Four primes: perfect balance.");
  render_cascade_step(sec2, "#ffd700", "+ 11: Z/2,310. Factor = 2(10)/12 = 5/3. Balance = 5/3.");
  render_p(sec2, "Z/210 (four primes) is the only primorial ring with balance exactly 1. Adding the fifth prime breaks it to 5/3. The arithmetic is proved. The coincidence with Kolmogorov's exponent is observed, not explained.");
  dom_append(dom_body(), sec2);

  /* === THE ARITHMETIC === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Arithmetic");
  render_theorem(sec3, "Balance Factor (PROVED)",
    "For odd primes, each prime p contributes factor 2(p-1)/(p+1) to the phi/class ratio. Starting from phi(2)/classes(2) = 1/2, multiply by each factor. At 4 primes (Z/210): balance = 1. At 5 primes (Z/2,310): balance = 5/3.");
  render_theorem(sec3, "Unique Transparency of 3 (PROVED)",
    "2(p-1)/(p+1) = 1 has exactly one prime solution: p = 3. Among all primes, 3 alone preserves the balance ratio exactly. Every other prime shifts the balance up or down. This is independent of any physics interpretation.");
  render_p(sec3, "The algebra above is ring arithmetic -- properties of primorial rings. It does not require or imply a connection to fluid dynamics or biology.");
  dom_append(dom_body(), sec3);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Balance Factor");
  render_p(sec_i, "Enter any prime p to see its balance factor 2(p-1)/(p+1). Only p = 3 gives factor 1 (transparent). p = 11 gives 5/3. Try 2, 3, 5, 7, 11.");
  make_interactive_widget(sec_i, "Prime p:", "turb-input", "e.g. 11", "Compute", "turbulence_balance_calc", "turb-result");
  dom_append(dom_body(), sec_i);

  /* === PARADIGM CONTRAST === */
  let scc = make_section("800px") in
  render_h2(scc, "Paradigm Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Conventional");
  render_th(chdr, "Ring View");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Kolmogorov -5/3", "Dimensional analysis (1941). Universal across turbulent flows.", "Balance factor at 5 primes = 5/3. Same number. Mechanism unproved.");
  render_contrast_row(ctbl, "Kleiber 3/4", "Fractal network models (debated). Mouse to whale.", "Balance at 4 primes minus p=5 contribution = 3/4. Match observed, mechanism unproved.");
  render_contrast_row(ctbl, "Are they related?", "No known connection.", "Both are small-prime ratios. Whether this is meaningful is open.");
  dom_append(scc, ctbl);
  dom_append(dom_body(), scc);

  /* === WHY THIS MATTERS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Why This Matters");
  render_p(sec5, "The balance factor arithmetic is proved: 2(p-1)/(p+1) for each prime, cumulative product giving the phi/class ratio. Z/210 has balance exactly 1 -- the only primorial ring where this holds.");
  render_p(sec5, "The match with Kolmogorov's -5/3 at the fifth prime is numerically exact and striking. But small primes are dense among rational fractions. 5/3 and 3/4 can be written many ways with numbers under 20. The honest position: the arithmetic is real, the physics connection is an open question, and coincidence is plausible.");
  dom_append(dom_body(), sec5)
)

fn page_sleep() = (
  /* S1944 REWRITE: reframed CRT channel locking as hypothesis/model, not proved theorem.
     Removed clinical predictions (ALS/Alzheimer). Kept eigenvalue math (real algebra). */
  dom_head_meta("description", "A CRT model of sleep. If sleep stages correspond to progressive channel locking in coupling order, the eigenvalue class counts follow: 288, 144, 72, 24, 6, 1. Hypothesis, not theorem.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Sleep: A CRT Model\",\"description\":\"Hypothetical mapping of sleep stages to CRT channel locking. Eigenvalue class count sequence 288-144-72-24-6-1.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/sleep\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT channels\"},{\"@type\":\"DefinedTerm\",\"name\":\"eigenvalue classes\"},{\"@type\":\"DefinedTerm\",\"name\":\"sleep model\"}]}");
  /* === HERO === */
  let hero = make_hero("Sleep: A CRT Model") in
  render_p(hero, "A hypothesis: if sleep stages correspond to progressive CRT channel locking, the eigenvalue class counts form the sequence 288, 144, 72, 24, 6, 1.");
  render_p(hero, "This is a MODEL, not a proved correspondence. The mathematics below is real algebra. The mapping to neuroscience is interpretive.");
  dom_append(dom_body(), hero);

  /* === THE MODEL === */
  let si = make_section("800px") in
  render_h2(si, "The Model");
  render_p(si, "Z/2,310 has five CRT channels (mod 2, mod 3, mod 5, mod 7, mod 11). If each sleep stage corresponds to locking one channel -- setting its residue to zero -- the number of eigenvalue classes drops at each step. The locking order follows coupling cost: cheapest channel first.");
  render_p(si, "This mapping is a hypothesis. The class-count arithmetic is proved. The biological correspondence is not.");
  dom_append(dom_body(), si);

  /* === THE CLASS COUNT SEQUENCE === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Class Count Sequence");
  let g = make_findings_grid(sec1) in
  render_finding(g, "All open", "288 classes", "All channels active. Mean eigenvalue = 0. Full spectrum.", "");
  render_finding(g, "Lock mod 2", "144 classes", "288/2. The mod-2 channel has 2 eigenvalue classes.", "");
  render_finding(g, "Lock mod 3", "72 classes", "144/2. The mod-3 channel has 2 eigenvalue classes.", "");
  render_finding(g, "Lock mod 5", "24 classes", "72/3. The mod-5 channel has 3 eigenvalue classes.", "");
  render_finding(g, "Lock mod 7", "6 classes", "24/4. The mod-7 channel has 4 eigenvalue classes.", "");
  render_finding_wide(g, "Lock mod 11", "1 class", "6/6. The mod-11 channel has 6 eigenvalue classes. All locked.", "");
  dom_append(dom_body(), sec1);

  /* === THE EIGENVALUE MATHEMATICS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Eigenvalue Mathematics");
  render_theorem(sec2, "CRT Class Counting (PROVED -- ring algebra)",
    "In Z/2,310: 288 eigenvalue classes = 2 * 2 * 3 * 4 * 6 (one factor per channel). Locking channels: mod 2: 288/2=144. mod 3: 144/2=72. mod 5: 72/3=24. mod 7: 24/4=6. mod 11: 6/6=1. Mean eigenvalue at each stage: {0, 1, 3, 5, 7, 9}. Each locked channel contributes its maximum (cos(0)=1).");
  render_theorem(sec2, "Positivity Threshold (PROVED -- ring algebra)",
    "All eigenvalues become positive exactly when the mod-5 channel locks. With mod-2 and mod-3 locked but mod-5 open: minimum eigenvalue = -2.339 < 0. With mod-5 also locked: minimum = 5 - 2cos(pi/7) - 2cos(pi/11) = 1.279 > 0. The threshold is exact.");
  render_theorem(sec2, "Information Content (PROVED -- ring algebra)",
    "Per-channel information: mod 2 = 1 bit, mod 3 = 1 bit, mod 5 = log2(3) = 1.585 bits, mod 7 = log2(4) = 2 bits, mod 11 = log2(6) = 2.585 bits. Total = log2(288) = 8.17 bits. Locking sheds the cheapest channel first.");
  dom_append(dom_body(), sec2);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Channel Locking");
  render_p(sec_i, "Enter a locking stage (0-5). See which channels are locked at each stage and the eigenvalue class count. Stage 0 = all 5 channels open (288 classes). Stage 5 = all locked (1 class).");
  make_interactive_widget(sec_i, "Stage (0-5):", "sleep-input", "e.g. 3", "Lock", "sleep_stage_calc", "sleep-result");
  dom_append(dom_body(), sec_i)
)

/* ================================================================
   COUPLING CLASSES PAGE -- Six classes from prime divisibility
   Canvas viz (wheel, bridge rates) = VERIFY GAP.
   ================================================================ */

fn render_kingdom(parent, count:str, name:str, prime:str, coupling:str, color:str) = (
  let card = dom_create("div") in
  dom_style(card, "textAlign", "center");
  dom_style(card, "padding", "16px 14px");
  dom_style(card, "minWidth", "120px");
  dom_style(card, "border", "2px solid ${color}");
  dom_style(card, "borderRadius", "12px");
  dom_style(card, "background", "#0f0f18");
  let n = dom_create("div") in
  dom_text(n, count);
  ct_mono(n);
  dom_style(n, "fontSize", "28px");
  dom_style(n, "fontWeight", "bold");
  dom_style(n, "color", color);
  dom_append(card, n);
  let nm = dom_create("div") in
  dom_text(nm, name);
  dom_style(nm, "fontSize", "14px");
  dom_style(nm, "color", "#ccc");
  dom_style(nm, "margin", "4px 0");
  dom_append(card, nm);
  let sub = dom_create("div") in
  dom_text(sub, "${prime} | c=${coupling}");
  ct_mono(sub);
  dom_style(sub, "fontSize", "11px");
  dom_style(sub, "color", "#a0a0b0");
  dom_append(card, sub);
  dom_append(parent, card)
)

fn page_kingdoms() = (
  dom_head_meta("description", "Eight coupling classes from seven primes. Each prime that divides a number removes one channel. 128 = 2^7 total patterns in Z/214,414,200.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Coupling Classes\",\"description\":\"Eight pure coupling classes from seven primes. coupling(n) = N/gcd(n,N). 128 divisibility patterns in Z/214414200.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/kingdoms\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"coupling hierarchy\"},{\"@type\":\"DefinedTerm\",\"name\":\"coupling classes\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring hierarchy\"}]}");
  /* === HERO === */
  let hero = make_hero("Coupling Classes") in
  render_p(hero, "Seven primes create eight pure classes. Each prime that divides a number removes one channel from its coupling. More prime divisors = weaker coupling = fewer members.");
  let g = make_grid(hero, "8px") in
  render_kingdom(g, "480", "Unit", "coprime", "2310", "#ddddaa");
  render_kingdom(g, "480", "2-class", "p=2", "1155", "#ff6666");
  render_kingdom(g, "240", "3-class", "p=3", "770", "#66ddaa");
  render_kingdom(g, "120", "5-class", "p=5", "462", "#88aaff");
  render_kingdom(g, "80", "7-class", "p=7", "330", "#cc88ff");
  render_kingdom(g, "48", "11-class", "p=11", "210", "#ffcc44");
  render_kingdom(g, "+13", "13-class", "p=13", "in 6ch+", "#ff88aa");
  render_kingdom(g, "+17", "17-class", "p=17", "in 7ch", "#00dddd");
  let note = render_p(hero, "Counts for Z/2,310 (5 primes). 13 appears in Z/12,612,600. 17 appears in Z/214,414,200. Total: 128 = 2^7 classes.") in
  ct_mono(note);
  dom_style(note, "fontSize", "14px");
  dom_style(note, "color", "#a8a8b8");
  dom_append(dom_body(), hero);

  /* === THE COUPLING RULE === */
  let s1 = make_section("800px") in
  render_h2(s1, "The Coupling Rule");
  render_p(s1, "An element's class is determined by which primes divide it. Its coupling measures how strongly it interacts with the rest of the ring:");
  render_theorem(s1, "Coupling Formula",
    "coupling(n) = N / gcd(n, N). Each prime factor in gcd(n, N) removes that channel. 1 (coprime to all) has maximum coupling N. Zero (divisible by all) has minimum coupling = 1. Works for every ring: Z/2,310, Z/970,200, Z/12,612,600, Z/214,414,200.");
  render_p(s1, "Pure classes: elements divisible by exactly one prime. Unit class = coprime to all = maximum coupling. Each subsequent class loses one channel: coupling(p) = N/p. So: 2 gives N/2, 3 gives N/3, 5 gives N/5, 7 gives N/7, 11 gives N/11, 13 gives N/13, 17 gives N/17. Hardware verified: all 7 primes flashed to ESP32, coupling(p) = N/p exact for each. ESCAPE coupling = N/17 = 12,612,600 = the TRUE ring modulus -- stripping the 7th channel reveals the 6-channel core.");
  dom_append(dom_body(), s1);

  /* === KINGDOM TABLE === */
  let s2 = make_section("800px") in
  render_h2(s2, "The Eight Pure Classes");
  let tbl = dom_create("table") in
  dom_style(tbl, "width", "100%");
  dom_style(tbl, "maxWidth", "700px");
  dom_style(tbl, "margin", "24px auto");
  dom_style(tbl, "borderCollapse", "collapse");
  dom_style(tbl, "tableLayout", "fixed");
  dom_style(tbl, "wordWrap", "break-word");
  let thead = dom_create("tr") in
  render_th(thead, "Class");
  render_th(thead, "Prime");
  render_th(thead, "Ring");
  render_th(thead, "Property");
  dom_append(tbl, thead);
  render_table_row_4(tbl, "Unit", "coprime", "all", "Coprime to all 7 primes. Maximum coupling.");
  render_table_row_4(tbl, "2-class", "2", "all", "Even elements. The only parity-preserving prime.");
  render_table_row_4(tbl, "3-class", "3", "all", "Divisible by 3. Minimum for majority.");
  render_table_row_4(tbl, "5-class", "5", "all", "Divisible by 5. 5^2 divides the ring but 5 does not divide 24.");
  render_table_row_4(tbl, "7-class", "7", "all", "Divisible by 7. Deepest resolution: 49 states.");
  render_table_row_4(tbl, "11-class", "11", "all", "Divisible by 11. Error detection via parity.");
  render_table_row_4(tbl, "13-class", "13", "6ch+", "Divisible by 13. Dual parity with 11.");
  render_table_row_4(tbl, "17-class", "17", "7ch", "Divisible by 17. 5*7 = 1 mod 17.");
  dom_append(s2, tbl);
  render_p(s2, "Pure class couplings in Z/2,310: unit=2310, 2-class=1155, 3-class=770, 5-class=462, 7-class=330, 11-class=210. Each is N/p. Coupling measures distance from the unit class.");
  dom_append(dom_body(), s2);

  /* === THE MEMBRANE === */
  let s3 = make_section("800px") in
  render_h2(s3, "Why 2 Is Special");
  render_theorem(s3, "Parity Preservation (PROVED)",
    "Every prime except 2 is odd. Adding an odd number to any element flips its parity -- guaranteed class change. 2 is the ONLY prime that preserves parity. It can keep you in the same class. 2 separates classes without blocking.");
  dom_append(dom_body(), s3);

  /* === COMPOUND KINGDOMS === */
  let s4 = make_section("800px") in
  render_h2(s4, "Compound Classes");
  render_p(s4, "An element can be divisible by multiple primes simultaneously. With 7 primes in Z/214,414,200, there are 2^7 = 128 possible divisibility patterns. 1 is void (all primes), 7 are pure classes, 1 is unit (no primes). That leaves 119 compound classes.");
  let cg = make_findings_grid(s4) in
  render_finding(cg, "Pure classes", "7", "Elements divisible by exactly 1 prime. One per prime.", "");
  render_finding(cg, "Compound classes", "119", "Elements divisible by 2-6 primes simultaneously.", "");
  render_finding(cg, "Total patterns", "128 = 2^7", "Every subset of {2, 3, 5, 7, 11, 13, 17}. The powerset IS the class space.", "");
  render_finding(cg, "Void", "1 element", "n = 0. Divisible by all 7 primes. Below all classes.", "");
  render_p(s4, "Examples: 6 = 2*3 (compound of 2-class and 3-class). 35 = 5*7 (compound; and 5*7 = 1 mod 17).");
  dom_append(dom_body(), s4);

  /* === TRUE FORM SCALING === */
  let s5 = make_section("800px") in
  render_h2(s5, "Scaling Across Rings");
  render_p(s5, "The ring hierarchy: Z/2,310 (5 primes) -> Z/970,200 (5 prime-power) -> Z/12,612,600 (+13) -> Z/214,414,200 (+17). Each step raises exponents or adds a new prime:");
  let sg = make_findings_grid(s5) in
  render_finding(sg, "Z/2,310 -> Z/970,200", "420x per class", "Raising exponents: 2->2^3, 3->3^2, 5->5^2, 7->7^2. Same 32 classes, more elements.", "");
  render_finding(sg, "Z/970,200 -> Z/12,612,600", "classes 32->64", "13 adds 6th prime. phi = 2,419,200.", "");
  render_finding(sg, "Z/12,612,600 -> Z/214,414,200", "classes 64->128", "17 adds 7th prime. phi = 38,707,200.", "");
  render_finding(sg, "Class Primality", "PROVED", "All pure class counts are products of the ring's primes.", "");
  render_p(s5, "Raising exponents (Z/2,310 -> Z/970,200) multiplies each class by 420 without changing the class count. Adding a prime doubles the class count. The 8-class hierarchy is invariant: unit class is always largest, 17-class is always rarest.");
  dom_append(dom_body(), s5);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Coupling Classifier");
  render_p(sec_i, "Enter any number. See its class from all 7 primes. Pure classes have exactly 1 prime dividing. Try 1 (unit), 2 (2-class), 13 (13-class), 17 (17-class), 6 (compound), 0 (void).");
  make_interactive_widget(sec_i, "Number:", "king-input", "e.g. 7", "Classify", "kingdoms_coupling_calc", "king-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let s6 = make_section("800px") in
  render_h2(s6, "Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Standard");
  render_th(chdr, "Ring View");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "What are coupling classes?", "Divisor subgroups", "gcd(n, N) determines active channels. 8 pure + 119 compound + void = 128 = 2^7.");
  render_contrast_row(ctbl, "Why 8 pure classes?", "7 prime factors + unit", "7 primes = 7 single-prime classes + 1 unit class. Z/214,414,200 has all 8.");
  render_contrast_row(ctbl, "Why is unit class largest?", "Most coprime elements", "Coprime to all 7 primes = max coupling = most connected.");
  render_contrast_row(ctbl, "Why is 17-class rarest?", "Fewest 17-divisible", "17 is the largest prime. Divisibility by 17 is the rarest single-prime constraint.");
  render_contrast_row(ctbl, "What does 2 do?", "Parity", "2 = the only even prime. Preserves parity. Separates classes without blocking.");
  render_contrast_row(ctbl, "Can you compute it?", "Just gcd", "coupling(n) = N / gcd(n, N). For Z/214,414,200: N = 214,414,200.");
  dom_append(s6, ctbl);
  dom_append(dom_body(), s6);

  /* === VERIFY === */
  let s7 = make_section("800px") in
  render_h2(s7, "Verify It Yourself");
  render_p(s7, "Compute coupling(1), coupling(2), coupling(13), coupling(17). Count elements in each class. Every number on this page is arithmetic.");
  let cta = dom_create("div") in
  dom_style(cta, "textAlign", "center");
  dom_style(cta, "padding", "32px 0");
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Verify in the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "12px 36px");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_append(cta, btn);
  dom_append(s7, cta);
  dom_append(dom_body(), s7)
)


/* ALPHA PAGE CUT S1944: G=97 not axiom prime, persistence ratio = overfitting,
   Cosmic Pie = pattern-matching. No honest content after stripping. */

fn ecc_syndrome_calc() = (
  let n = parse_int_from("#ecc-chk-input") in
  let result = dom_query("#ecc-chk-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let nd = n % 8 in
    let nk = n % 9 in
    let ne = n % 25 in
    let nb = n % 49 in
    let nl = n % 11 in
    let ng = n % 13 in
    /* Reconstruct from first 4 data channels only (D,K,E,b) via ring_recon_data (core.ax SSOT) */
    /* Then check: n_data mod 11 should equal nl, n_data mod 13 should equal ng */
    let n_data = ring_recon_data(nd, nk, ne, nb) in
    let check_l = n_data % 11 in
    let check_g = n_data % 13 in
    let ok_l = if check_l == nl then 1 else 0 in
    let ok_g = if check_g == ng then 1 else 0 in
    let ok = if ok_l > 0 then if ok_g > 0 then 1 else 0 else 0 in
    let status = if ok > 0 then "<span style='color:#88ddaa'>INTACT</span> -- mod-11 + mod-13 syndromes match" else if ok_l == 0 then "<span style='color:#ff6666'>CORRUPTED</span> -- mod-11 check failed" else "<span style='color:#ff6666'>CORRUPTED</span> -- mod-13 check failed" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>n = ${n}</p><p style='margin:4px 0'>CRT: (<span style='color:#ff4040'>${nd}</span>, <span style='color:#ff9900'>${nk}</span>, <span style='color:#33dd55'>${ne}</span>, <span style='color:#4488ff'>${nb}</span>, <span style='color:#aa44ff'>${nl}</span>, <span style='color:#ff88cc'>${ng}</span>)</p><p style='margin:4px 0'>Data channels (mod 8, 9, 25, 49) reconstruct to: ${n_data}</p><p style='margin:4px 0'>mod-11 check: ${n_data} mod 11 = ${check_l} vs stored ${nl} | mod-13 check: ${n_data} mod 13 = ${check_g} vs stored ${ng} &mdash; ${status}</p>")
  )
)

fn page_ecc() = (
  dom_head_meta("description", "Mod-11 error detection: 100% for prime channels, ~92% for prime-power. Dual-check mod 11 + mod 13: 100%. CRT detection theorem, three-ring progression, byte recovery. Zero free parameters.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Error Correction\",\"description\":\"Mod-11 detection: 100% for prime channels, ~92% for prime-power. Dual-check mod 11 + mod 13: 100%. Triple-parity: 100% correction.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/ecc\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"error correction\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT parity\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT detection\"}]}");
  let hero = make_hero("Error Correction for Free") in
  let big = dom_create("div") in
  dom_text(big, "11 = 1 + 2 + 3 + 5");
  ct_mono(big);
  dom_style(big, "fontSize", "48px");
  dom_style(big, "color", "#aa44ff");
  dom_style(big, "marginBottom", "16px");
  dom_append(hero, big);
  render_p(hero, "The fifth prime doesn't compute. It checks. Every element in the ring carries its own error-detecting code -- for free. No extra bits. No overhead. 11 = 1 + 2 + 3 + 5. Add mod-13 for dual parity: 100% detection and correction.");
  dom_append(dom_body(), hero);

  /* === HOW IT WORKS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_p(sec1, "Every number in Z/214,414,200 decomposes into 7 channels via CRT: (mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17). The first four channels carry data. The last three (mod 11, mod 13, mod 17) provide triple-parity ECC -- rate 4/7, 100% correction. Error correction is structural, automatic, free.");
  render_p(sec1, "Encode: take any element n. CRT gives 7 residues. The first four (mod 8, 9, 25, 49) are data -- they determine n within Z/88,200. The last three (mod 11, 13, 17) are parity. Start with the simplest check: n mod 11.");
  render_p(sec1, "Detect: reconstruct n from the first 4 channels. Compute n mod 11. If it matches channel 5: intact. If not: corruption detected. 100% for prime channels (mod < 11). Prime-power channels (mod 25, 49): ~92% -- errors at multiples of 11 are invisible to mod-11 alone. Dual-check with mod-13 closes the gap.");
  render_p(sec1, "Correct: if you know which channel was hit, try all values in that channel (at most 49 trials for mod-49). For prime channels: exactly one value passes the mod-11 check. For prime-power channels: multiple candidates may pass. Dual-check with mod-11 + mod-13 narrows to exactly one (lcm(11,13) = 143 > 49).");
  let g = make_findings_grid(sec1) in
  render_finding(g, "Detection", "100% prime, ~92% prime-power", "Prime channels (mod < 11): perfect. Prime-power: delta=11k invisible. Dual mod 11+13: 100%.", "CRT Detection Theorem");
  render_finding(g, "Overhead", "0 bits", "No extra storage needed. Protection is the number system.", "Structural");
  render_finding(g, "Correction", "100% with dual", "Mod-11 + mod-13 dual-check: unique fix for ALL channels.", "Brute-force search");
  render_finding(g, "Cost", "9.1%", "Adding 11 costs 1/11 of unit density. Full protection for 9.1%.", "phi analysis");
  dom_append(dom_body(), sec1);

  /* === THE DETECTION THEOREM === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Detection Theorem");
  render_theorem(sec2, "CRT Detection Theorem", "Let R = Z/q1 x ... x Z/qk x Z/p where gcd(qi, p) = 1 for all i. If exactly one channel ci is corrupted by delta != 0 (mod qi), detection via mod-p succeeds iff delta is not divisible by p. For qi < p (prime channels): 100% -- no such delta exists. For qi > p (prime-power channels): ~92% -- deltas at multiples of p are invisible.");
  render_p(sec2, "Proof sketch: CRT lifting idempotent ei satisfies ei mod p != 0 (from gcd condition). Corruption delta in channel i shifts the mod-p residue by delta * (ei mod p). Since ei mod p != 0, the shift vanishes iff delta = 0 mod p. With p = 11: prime channels have max delta < 11, so no blind spot. Prime-power channels (mod 25, 49) have some deltas divisible by 11. Dual-check with mod 13 eliminates these: lcm(11,13) = 143 > 49.");
  render_theorem(sec2, "11 = 1 + 2 + 3 + 5", "The parity prime equals the sum of the identity plus the first three primes. Forced by the Cunningham chain c(n) = 2n+1: c(5) = 11. Not arbitrary -- the chain builds the check digit from the data digits.");
  dom_append(dom_body(), sec2);

  /* === THREE RING PROGRESSION === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Three Rings, Three Levels of Protection");
  render_p(sec3, "Three rings, three ECC stories. Raising prime exponents increases data capacity but changes detection rates:");
  let tbl = make_table(sec3) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Channels");
  render_th(hdr, "Detection");
  render_th(hdr, "Notes");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "2, 3, 5, 7 (no 11)", "0%", "Unprotected. Fast but fragile.");
  render_table_row_4(tbl, "Z/2,310", "2, 3, 5, 7, 11", "100% + 100% corr", "All channels < 11. Perfect ECC.");
  render_table_row_4(tbl, "Z/970,200", "8, 9, 25, 49, 11", "100% prime, ~92% pp", "Prime-power channels leak 1/12.");
  render_p(sec3, "Z/2,310 has perfect protection: every data channel (mod 2, 3, 5, 7) is smaller than 11, so the mod-11 check catches everything. Raising exponents to (mod 8, 9, 25, 49) means mod 25 and mod 49 are larger than 11. Some corruptions in those channels produce the same mod-11 residue.");
  render_theorem(sec3, "Exponent-ECC Tension", "Raising 5 -> 5^2 = 25 and 7 -> 7^2 = 49 increases data capacity but weakens mod-11-only detection. Mod-25 channel: 22/24 = 11/12 detection. Mod-49 channel: 44/48 = 11/12 detection. Mod-8 and mod-9 channels: still 100% (both < 11).");
  dom_append(dom_body(), sec3);

  /* === DUAL CHECK: L + GATE === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Dual Check: mod 11 + mod 13");
  render_p(sec4, "The solution to prime-power channel leakage: add 13 as a second check channel. A corruption is invisible only if delta mod lcm(11, 13) = delta mod 143 = 0. The maximum delta in any channel is 48 (from mod 49). Since 48 < 143: no corruption can be invisible to both checks.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "mod-11 only", "~92% prime-power", "Mod-25 and mod-49 leak 1/12 of corruptions (delta divisible by 11).", "");
  render_finding(g4, "mod-11 + mod-13", "100% detection", "lcm(11,13) = 143 > max delta = 48. Complete.", "Dual-Check Theorem");
  render_finding(g4, "Correction", "100% known-loc", "With both syndromes: unique fix for ALL channels.", "");
  render_finding(g4, "Cost", "7.2 bits", "log2(143) overhead. Full protection of 17+ bits of data.", "");
  render_p(sec4, "The 490 split goes further: {2, 5, 7} = data (8 * 25 * 49 = 9800 values), {3, 11, 13} = parity (9 * 11 * 13 = 1287 values). 9800 * 1287 = 12,612,600. Three parity channels for three data channels: a (6,3,3) code that corrects any single-channel error. See the live demo on the ECC Live page.");
  dom_append(dom_body(), sec4);

  /* === THE AXLE + BIOLOGY === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Why 11 Stays at Exponent 1");
  render_p(sec6, "When the ring raises exponents from Z/2,310 to Z/12,612,600, every data prime's exponent increases: 2 -> 2^3, 3 -> 3^2, 5 -> 5^2, 7 -> 7^2. But 11 stays at exponent 1. It is the only channel unchanged by raising exponents -- the fixed reference against which data channels grow.");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "11's exponent", "always 1", "11 is the only prime whose exponent doesn't increase. Parity stays at first power.", "");
  render_finding(g6, "Byte recovery", "100% unique", "For [0,255] in Z/970,200: CRT spacing >> byte range.", "");
  render_finding(g6, "AI weights", "free ECC", "Quantize to Z/970,200. Corruption detectable without overhead.", "");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE: ECC SYNDROME CHECKER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: ECC Syndrome Check");
  render_p(sec_i, "Enter any element n (0 to 970,199). See its CRT decomposition and mod-11 syndrome. The mod-11 channel acts as a free checksum -- if it mismatches after corruption, the error is detected.");
  make_interactive_widget(sec_i, "Enter n:", "ecc-chk-input", "e.g. 137", "Check", "ecc_syndrome_calc", "ecc-chk-result");
  render_p(sec_i, "Try: 137, 42, 210. Corrupt one channel mentally and see if mod-11 catches it.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST TABLE === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Paradigm Contrast");
  let ctbl = make_table(sec7) in
  let chdr = dom_create("tr") in
  render_th(chdr, "Aspect");
  render_th(chdr, "Standard (INT8)");
  render_th(chdr, "Ring (CRT + mod 11)");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Error detection", "0% -- bit flips are silent", "100% with dual parity mod 11 + mod 13 (proved)");
  render_contrast_row(ctbl, "Error correction", "0% -- no mechanism exists", "100% known-location with dual parity");
  render_contrast_row(ctbl, "Levels", "256 (8 bits, arbitrary)", "210 or 970200 (structured)");
  render_contrast_row(ctbl, "Cost", "0 overhead, 0 protection", "0.3 bits SQNR -- free protection");
  render_contrast_row(ctbl, "On corruption", "Wrong value, no warning", "Detected -> located -> corrected");
  render_contrast_row(ctbl, "Paradigm", "Pray nothing goes wrong", "Ring self-heals");
  render_p(sec7, "Reed-Solomon, LDPC, Turbo codes all ADD redundancy to protect data. The CRT ring has redundancy built in. 11 is not bolted on -- it is the fifth prime in the number system. Protection is a structural property of the ring's CRT decomposition.");
  dom_append(dom_body(), sec7);

  /* === HARDWARE VERIFICATION === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Proved on Hardware");
  render_p(sec8, "Three ESP32 boards running .ax WASM firmware on the TRANS ring Z/214,414,200. Seven channels. Triple-parity ECC (rate 4/7). Packets broadcast via ESP-NOW radio every 3 seconds. Error injection via serial command corrupts one CRT channel per packet. The receiver corrects it.");
  let g8 = make_findings_grid(sec8) in
  render_finding(g8, "Full sweep", "123/123", "7 channels x 3 error sizes (delta +1, +2, max-1) = 21 configurations. 123 corrupted packets corrected, 0 failures. Every data channel (mod 8, 9, 25, 49) and every parity channel (mod 11, 13, 17) tested at multiple corruption magnitudes.", "");
  render_finding(g8, "Sensor round-trip", "6/6 exact", "Real BME280 temperature, humidity, and pressure from two boards. Each reading decomposed into 7 CRT residues. Reconstructed value matches original exactly. ECC passes on all 6. The ring is not abstract -- it carries physical measurements.", "");
  render_finding(g8, "Mirror on data", "4/4 perfect", "For every sensor reading n: CRT(n) + CRT(N-n) = 0 in all 7 channels. The mirror theorem holds on physical data. Even a temperature reading obeys the ring's additive symmetry.", "");
  render_finding(g8, "Uniqueness", "Proved", "Any 6 of 7 channels uniquely determine the element. lcm of any 6 moduli exceeds the data ring (88,200). Single-channel correction always has exactly one solution.", "");
  dom_append(dom_body(), sec8)
)

