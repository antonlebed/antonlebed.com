/* arcsine cumulant widget */
fn ac_compute() = (
  let n = parse_int_from("#ac-input") in
  let result = dom_query("#ac-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1 (index of even cumulant k_{2n}).</p>")
  else if n > 4 then dom_inner(result, "<p style='color:#ff6666'>Only n=1..4 are 11-smooth. Beyond n=4 (order 8): intruders enter.</p>")
  else (
    let val = if n == 1 then 2 else if n == 2 then 6 else if n == 3 then 80 else 2310 in
    let sign = if n % 2 == 1 then "+" else "-" in
    let fac = if n == 1 then "2" else if n == 2 then "2*3" else if n == 3 then "16*5" else "2*3*5*7*11 = primorial(11)" in
    let smooth = "<span style='color:#88ddaa'>11-SMOOTH</span>" in
    dom_inner(result, "<p style='color:#ffd700;margin:4px 0;font-size:18px'>k_{" + "${n}" + "*2} = " + sign + "${val}" + "</p><p style='color:#d8d8e0;margin:4px 0'>= " + sign + fac + ". " + smooth + "</p>")
  )
)

fn page_arcsine_cumulant() = (
  dom_head_meta("description", "Arcsine distribution cumulants: k2=2, k4=-6, k6=80, k8=-2310. All five primes {2,3,5,7,11} appear by order 8. Bessel function connection. Excess kurtosis = -3/(2k).");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Arcsine Cumulants\",\"description\":\"Arcsine cumulants k2=2, k4=-6, k6=80, k8=-2310. All five primes appear by order 8. Bessel connection.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/arcsine_cumulant\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"arcsine distribution\"},{\"@type\":\"DefinedTerm\",\"name\":\"cumulants\"},{\"@type\":\"DefinedTerm\",\"name\":\"spectral theory\"}]}");
  /* === HERO === */
  let hero = make_hero("Arcsine Cumulants") in
  let big = dom_create("div") in
  dom_text(big, "k2 = 2, k4 = -6, k6 = 80, k8 = -2310");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "A pendulum spends most of its time near the turning points, least at the center. This is the arcsine distribution -- the universal shape of any oscillatory system. Its cumulants (irreducible statistical fingerprints) factor into the primes {2, 3, 5, 7, 11}. All five primes appear by the 8th cumulant, which equals -2310 = the primorial of 11. Beyond order 8, the pattern breaks.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE FIRST EIGHT CUMULANTS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The First Eight Cumulants");
  render_p(sec1, "The arcsine distribution on [-2, 2] is symmetric, so all odd cumulants are zero. The even cumulants:");
  let ctbl = make_table(sec1) in
  let chdr = dom_create("tr") in
  render_th(chdr, "n");
  render_th(chdr, "k_{2n}");
  render_th(chdr, "Factorization");
  render_th(chdr, "11-smooth?");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "1", "+2", "2", "Yes");
  render_table_row_4(ctbl, "2", "-6", "-2 * 3", "Yes");
  render_table_row_4(ctbl, "3", "+80", "2^4 * 5", "Yes");
  render_table_row_4(ctbl, "4", "-2310", "-2 * 3 * 5 * 7 * 11", "Yes (= primorial(11))");
  render_table_row_4(ctbl, "5", "...", "contains 19", "No");
  render_table_row_4(ctbl, "6", "...", "contains 43", "No");
  render_table_row_4(ctbl, "7", "...", "contains 13", "No");
  render_p(sec1, "Signs alternate: (-1)^(n+1). All are divisible by 2. The 4th cumulant k_8 = -2310 = -primorial(11), the product of all five primes. At n = 5, the prime 19 enters and the smooth run ends permanently.");
  render_p(sec1, "The primes enter one at a time: 2 at n=1, then 3 at n=2, then 5 at n=3, then 7 and 11 together at n=4. Four steps to complete the set. The smooth zone ends at order 2*4 = 8.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: BESSEL CONNECTION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Bessel Connection");
  render_p(sec2, "The characteristic function of the arcsine distribution on [-2, 2] is J_0(2t), the zeroth Bessel function. For a ring Z/N with k independent CRT channels, the spectral density is the convolution of k arcsine distributions:");
  render_theorem(sec2, "Bessel-Cumulant Theorem (PROVED)", "The characteristic function of the spectral density is J_0(2t)^k. For Z/12,612,600 with 6 channels: CF(t) = J_0(2t)^6. The moment-generating function for Z/mZ involves modified Bessel functions I_n(2t).");
  dom_append(dom_body(), sec2);

  /* === SEC 3: EXCESS KURTOSIS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Excess Kurtosis: -3/(2k)");
  render_p(sec3, "The excess kurtosis of the spectral density with k independent channels is exactly -3/(2k):");
  let ktbl = make_table(sec3) in
  let khdr = dom_create("tr") in
  render_th(khdr, "Ring");
  render_th(khdr, "k (channels)");
  render_th(khdr, "Excess kurtosis");
  dom_append(ktbl, khdr);
  render_table_row(ktbl, "Z/210", "4", "-3/8");
  render_table_row(ktbl, "Z/2,310", "5", "-3/10");
  render_table_row(ktbl, "Z/970,200", "5", "-3/10");
  render_table_row(ktbl, "Z/12,612,600", "6", "-1/4");
  render_table_row(ktbl, "(any ring, k=2)", "2", "-3/4");
  render_p(sec3, "The formula -3/(2k) is purely a consequence of the arcsine distribution: kurtosis = k_4 / k_2^2 = -6/4 = -3/2 for one channel, which scales as -3/(2k) for k independent channels. At k = 2, this gives -3/4.");
  dom_append(dom_body(), sec3);

  /* === CONTRAST === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast");
  render_contrast_row(sec6, "Arcsine distribution", "Describes pendulum oscillation time. Classical probability", "Its cumulants factor into {2,3,5,7,11} for the first four even orders. The 4th cumulant -2310 = primorial(11).");
  render_contrast_row(sec6, "Smooth run to order 8", "The first few cumulants happen to have small prime factors", "Exactly 4 smooth cumulants (orders 2,4,6,8). The smooth zone ends at order 8 = rank(E8).");
  render_contrast_row(sec6, "Kurtosis -3/(2k)", "A formula for convolutions of arcsine distributions", "= -3/(2k) for k CRT channels. At k = 2 gives -3/4. At k = 6 (Z/12,612,600) gives -1/4.");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cumulant Calculator");
  render_p(sec_i, "Enter n (1-4) to see the even cumulant k_{2n} of the arcsine distribution. Beyond n = 4 (order 8), non-smooth primes enter.");
  make_interactive_widget(sec_i, "Cumulant index n:", "ac-input", "e.g. 2", "Compute", "ac_compute", "ac-result");
  render_p(sec_i, "Try: 1 (k_2 = 2), 2 (k_4 = -6), 3 (k_6 = 80), 4 (k_8 = -2310 = primorial(11)).");
  dom_append(dom_body(), sec_i)
)
