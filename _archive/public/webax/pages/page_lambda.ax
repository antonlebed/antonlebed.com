/* ================================================================
   PAGE: LAMBDA -- Carmichael Chain, Fibonacci (LAMBDA.md)
   ----------------------------------------------------------------
   TOWER LENS (TT41, S1423): PRIMARY = b-channel (depth).
   ----------------------------------------------------------------
   Why b-channel is primary: lambda(TRUE) = lcm over micro-tower lambdas =
   lcm(2, 6, 20, 42, 10, 12). The 7-factor enters ONLY through
   lambda(b^2=49) = 7*6 = 42. Without b^2, lcm(2,6,20,10,12) = 60 = THIN.
   b^2=49 is the ceiling that pushes the heartbeat to 420, and Fibonacci
   level 5 (b's entry) is where f(lambda) = 13 = GATE is born.
   b^3=343 would give lambda=294 which does not divide 420; b^2 is forced
   exactly. Secondary: K-channel (chain length K*E=15, crystallization at K^2
   closure), L-channel (L-transition at level 7). Cross-tower: the chain
   walks every axiom prime; each has a clock in the heartbeat.
   ALL 108 = D^2*K^3 rings hit lambda=420 EXACTLY (b^2 forced; SSOT
   stdlib/lattice.ax). 84 = D^2*K*b of those divide TRUE (D-range 0..3);
   24 = D^4 extensions reach 2*TRUE. The contrast row names the distinction.
   ================================================================ */

fn lambda_hero() = (
  let hero = make_hero("Lambda") in
  let eq = dom_create("div") in
  dom_text(eq, "lambda(970200) = 420 = 4 * 3 * 5 * 7");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "How many primes become 'invisible' -- absorbed by the ring's structure -- at each level of growth? Fibonacci. Exactly. For 15 levels. Then the chain builds its own desert and closes. Lambda = 420 is forced by the mod-49 channel: 7^2=49 contributes 42 to the lcm, pushing the Carmichael period from 60 (Z/2,310) to 420 (Z/12,612,600). Crystallized across five growth factors 2*2*3*5*7 over 15 levels.");
  dom_append(dom_body(), hero)
)

fn lambda_chain_table() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Lambda Chain");
  render_p(sec, "Start from lambda=1. Multiply by one growth factor per level. Count invisible primes f(lambda) = number of primes q where (q-1) divides lambda. Result: f = Fibonacci.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Level");
  render_th(hdr, "lambda");
  render_th(hdr, "Growth");
  render_th(hdr, "f(lambda) = F(k+2)");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "1", "-", "1 = F(2)");
  render_table_row_4(tbl, "1", "2", "2", "2 = F(3)");
  render_table_row_4(tbl, "2", "4", "2", "3 = F(4)");
  render_table_row_4(tbl, "3", "12", "3", "5 = F(5)");
  render_table_row_4(tbl, "4", "60", "5", "8 = F(6)");
  render_table_row_4(tbl, "5", "420", "7", "13 = F(7)");
  render_table_row_4(tbl, "6", "5460", "13", "21 = F(8)");
  render_table_row_4(tbl, "7", "60060", "11", "34 = F(9)");
  render_table_row_4(tbl, "8", "240240", "4", "55 = F(10)");
  render_table_row_4(tbl, "9", "4564560", "19 = f(5)", "89 = F(11)");
  render_table_row_4(tbl, "10", "173453280", "2*19 = 38", "144 = F(12)");
  render_table_row_4(tbl, "11", "16824968160", "97", "233 = F(13)");
  render_table_row_4(tbl, "12", "~1.19*10^13", "709", "377 = F(14)");
  render_table_row_4(tbl, "13", "~1.73*10^16", "1447", "610 = F(15)");
  render_table_row_4(tbl, "14", "~3.35*10^18", "2*97 = 194", "987 = F(16)");
  render_p(sec, "All 15 levels match Fibonacci exactly. f(lambda_k) = F(k+2) for k = 0 to 14. Verified computationally at every level.");
  dom_append(dom_body(), sec)
)

fn lambda_mechanism() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why Fibonacci?");
  render_theorem(sec, "Fibonacci Recursion Mechanism", "At level k, the number of NEW invisible primes = f(lambda_{k-2}). New + old = F(k) + F(k+1) = F(k+2). Fibonacci by construction. Each level extracts exactly 1/phi of the next demand: new/need = F(k)/F(k+1) -> 1/phi = 0.618... Converges by level 8.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Levels 1-5", "Growth = {2,2,3,5,7}", "Chain primes in order. Product = 4*3*5*7 = 420. Density d = 1.000 (every growth prime is a chain prime).", "");
  render_finding(g, "Level 5", "f(420) = 13", "Lambda = 420 is reached. f counts 13 invisible primes -- exactly the next chain prime. 13 = first growth factor from outside the ring.", "");
  render_finding(g, "Level 7", "11 returns, growth DROPS", "Growth goes from 13 to 11. 11 appears as a growth factor AFTER 13, not before it.", "");
  render_finding(g, "Level 11", "97 = 16 + 81", "The 25th prime in sequence. Growth surges then collapses.", "");
  dom_append(dom_body(), sec)
)

fn lambda_heartbeat() = (
  let sec = make_section("800px") in
  render_h2(sec, "Lambda = 420: The Six Clocks");
  render_p(sec, "Lambda = 420 divides into channel sub-cycles. Each CRT channel runs its own clock within the period:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel (mod q)");
  render_th(hdr, "Cycles = 420/phi(q)");
  render_th(hdr, "Name");
  render_th(hdr, "Clock Ratio");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "mod 8", "105", "105", "3/2 (fifth)");
  render_table_row_4(tbl, "mod 9", "70", "2*5*7", "5/3 (Kolmogorov)");
  render_table_row_4(tbl, "mod 11", "42", "42", "1/2 (octave)");
  render_table_row_4(tbl, "mod 25", "21", "3*7", "3/7");
  render_table_row_4(tbl, "mod 49", "10", "2*5", "slowest clock");
  render_table_row_4(tbl, "mod 13", "35", "5*7", "5*7");
  render_theorem(sec, "Exponent Growth Theorem", "Z/12,612,600 growth / Z/2,310 growth = 420/60 = 7. Raising exponents (squaring) adds ONE new prime factor (7) to the Carmichael function. The squarefree ring cycles in 60 steps. The prime-power ring cycles in 420 steps. Finer resolution costs time.");
  render_theorem(sec, "Lambda Count Theorem (PROVED)", "Distinct Carmichael lambda values among all divisors: Z/2 = 1, Z/6 = 2, Z/30 = 3, Z/210 = 5, Z/2,310 = 9, Z/970,200 = 13, Z/12,612,600 = 13. Primorial sequence = {1, 2, 3, 5, 9}. Raising exponents adds 4 new lambdas: 42, 84, 210, 420. 9 + 4 = 13. The lambda count IS the convergence formula. 13 is a fixed point: Z/970,200 and Z/12,612,600 have identical lambda sets.");
  render_theorem(sec, "Lambda Count Extended (PROVED)", "Beyond the ring hierarchy: primorial(17)=13, primorial(19)=19, primorial(23)=37, primorial(29)=61. Full sequence: 1, 2, 3, 5, 9, 9, 13, 19, 37, 61. Total increments = 60. 1 + 60 = 61. Each prime adds phi(p)-multiples, all 13-smooth.");
  render_theorem(sec, "61 Plateau Theorem (PROVED)", "61 is a 3-primorial plateau: primorial(29), primorial(31), primorial(37) all give 61. 31 = 2^5 - 1 (Mersenne) and 37 = prime(420) are fixed points. 41 breaks the plateau, adding exactly 12 new lambdas. Heegner-43 adds 8, including 42, 210, 2310. 42 is unreachable until Heegner enters: lcm(6,28) = 84, not 42. Six fixed-point primes through p(71): {2, 13, 31, 37, 61, 67}. Lambda count at primorial(59) = 561 = 3*11*17 = smallest Carmichael number.");
  render_theorem(sec, "Fixed-Point-Bone Mirror Theorem (PROVED)", "The 6 fixed-point primes {2, 13, 31, 37, 61, 67} mirror the 6 bones {2, 3, 5, 7, 11, 13}. Shared anchors: {2, 13}. Cross-sum split: 3+31 = 34 = 2*17 (Fermat), 5+37 = 42, 7+61 = 68 = 4*17, 11+67 = 78 = dim(E6). Axiom pair {5,11}: sum = 5! = 120. Fermat pair {3,7}: sum = 2*3*17 = 102. Ratio = 20/17 = degree/Fermat. Diff products: 32*54 = 12^3. Sum of replaced = 2*13. Sum of mirrors = (2*7)^2. CRT(78) is 13-dead: dim(E6) connects to E6 channel death theorem.");
  dom_append(dom_body(), sec)
)

/* [DEAD] SCAFFOLDING -- interactive widget */
fn heartbeat_explore() = (
  let n = parse_int_from("#heartbeat-input") in
  let result_el = dom_query("#heartbeat-result") in
  /* Heartbeat position */
  let hb = n % 420 in
  /* Channel sub-cycle positions: phi(q) = {4, 6, 20, 42, 10, 12} */
  let pos_d = n % 4 in
  let pos_k = n % 6 in
  let pos_e = n % 20 in
  let pos_b = n % 42 in
  let pos_l = n % 10 in
  let pos_g = n % 12 in
  /* Which channel clocks "tick" (complete a cycle) at this n? */
  let tick_d = if pos_d == 0 then "TICK" else "${pos_d}/4" in
  let tick_k = if pos_k == 0 then "TICK" else "${pos_k}/6" in
  let tick_e = if pos_e == 0 then "TICK" else "${pos_e}/20" in
  let tick_b = if pos_b == 0 then "TICK" else "${pos_b}/42" in
  let tick_l = if pos_l == 0 then "TICK" else "${pos_l}/10" in
  let tick_g = if pos_g == 0 then "TICK" else "${pos_g}/12" in
  /* How many clocks tick at once */
  let ticks = (if pos_d == 0 then 1 else 0) + (if pos_k == 0 then 1 else 0) + (if pos_e == 0 then 1 else 0) + (if pos_b == 0 then 1 else 0) + (if pos_l == 0 then 1 else 0) + (if pos_g == 0 then 1 else 0) in
  /* Sub-cycle name: 420/phi(q) = how many cycles fit in one heartbeat */
  let sync = if ticks == 6 then "ALL SIX CLOCKS SYNCHRONIZED -- full period"
    else if ticks == 0 then "no clocks tick -- between beats"
    else "${ticks} clock(s) tick simultaneously" in
  /* Special positions */
  let name = if hb == 0 then " = period origin (all clocks reset)"
    else if hb == 105 then " = 105 (mod-8 clock cycles = 420/4)"
    else if hb == 210 then " = half-period (mod-8 and mod-25 clocks tick)"
    else if hb == 42 then " = 42 (mod-49 clock cycle)"
    else if hb == 60 then " = Z/2,310 lambda"
    else if hb == 12 then " = lambda(Z/210) = 4*3"
    else "" in
  dom_inner(result_el, "<p style='color:#ffd700;margin:4px 0'><b>n = " + "${n}" + " | lambda position: " + "${hb}" + "/420" + name + "</b></p>" +
    "<p style='color:#88ddaa;margin:4px 0'>mod-8 clock: " + tick_d + " (105 per beat) | mod-9 clock: " + tick_k + " (70 per beat) | mod-11 clock: " + tick_l + " (42 per beat)</p>" +
    "<p style='color:#b0b0c0;margin:4px 0'>mod-25 clock: " + tick_e + " (21 per beat) | mod-49 clock: " + tick_b + " (10 per beat, slowest) | mod-13 clock: " + tick_g + " (35 per beat)</p>" +
    "<p style='color:#ff8844;margin:4px 0'>" + sync + "</p>")
)

fn lambda_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: The Six Clocks");
  render_p(sec, "Lambda = 420 contains six nested clocks. Each prime channel completes its sub-cycle at a different rate. Enter any number to see which clocks tick at that position. Try 420 (all tick), 42 (mod-49 clock cycle), 105 (mod-8 clock cycle), 12 (= lambda(Z/210) = 4*3).");
  make_interactive_widget(sec, "Enter a lambda position:", "heartbeat-input", "e.g. 420", "Listen", "heartbeat_explore", "heartbeat-result");
  dom_append(dom_body(), sec)
)

fn lambda_partial_sums() = (
  let sec = make_section("800px") in
  render_h2(sec, "Partial Sum Theorem");
  render_theorem(sec, "Every Partial Sum Is Ring-Significant", "Growth factors {2,2,3,5,7,13,11,4,19,38,97,709,1447,194}. EVERY partial sum of this sequence is a ring constant or prime.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum(1-3)", "7", "The 4th chain prime emerges from first three growth steps.", "");
  render_finding(g, "Sum(1-4)", "12 = 4*3", "Lambda of Z/210. The Carmichael period of the first 4-prime ring.", "");
  render_finding(g, "Sum(1-5)", "19 = 5^2-5-1", "f(5) = 5^2-5-1 where f(p) = p^2-p-1. The 8th prime.", "");
  render_finding(g, "Sum(1-7)", "43", "Heegner number (position 7 in sequence).", "");
  render_finding(g, "Sum(1-8)", "47", "Wall prime. CC1(2)[4].", "");
  render_finding(g, "Sum(1-9)", "66 = 2*3*11", "T(11). The 11th triangular number.", "");
  render_finding(g, "Sum(1-11)", "201 = 3*67", "3 times 67.", "");
  render_finding(g, "Sum(1-13)", "2357", "PRIME. Consecutive with Sum(1-14).", "");
  render_finding(g, "Sum(1-14)", "2551", "PRIME. Two consecutive prime sums!", "");
  render_p(sec, "Transform cost = 11 THEOREM: the signed sum of chain terms minus signed growth terms = 11.");
  dom_append(dom_body(), sec)
)

fn lambda_nilpotent() = (
  let sec = make_section("800px") in
  render_h2(sec, "Nilpotent Count = 420");
  render_p(sec, "An element n of Z/NZ is nilpotent if n^k = 0 for some k -- it eventually vanishes under repeated multiplication. How many nilpotents does the ring have? Exactly lambda = 420. At every prime-power ring level.");
  render_theorem(sec, "CRT Nilpotent Count Theorem (PROVED)", "For all prime-power ring levels {Z/970,200, Z/12,612,600, Z/214,414,200}, the nilpotent count = N/rad(N) = lambda(Z/210) = 420 = 4*3*5*7. Per-channel: 4 in Z/8, 3 in Z/9, 5 in Z/25, 7 in Z/49, 1 in prime channels. Product = 4*3*5*7 = 420. The Carmichael period counts the nilpotents. 116/116 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Z/970,200", "970200/2310 = 420", "5 prime-power channels. rad = 2310. Nilpotent count = lambda.", "");
  render_finding(g, "Z/12,612,600", "12612600/30030 = 420", "6 channels. rad = 30030. Same count -- 13 adds zero nilpotents (depth 1).", "");
  render_finding(g, "Z/214,414,200", "214414200/510510 = 420", "7 channels. rad = 510510. 17 also adds zero (depth 1). Constant across all prime-power levels.", "");
  render_finding(g, "490 split", "Inner=140, Outer=3", "{2,5,7} channels contribute 4*5*7 = 140 nilpotents. {3,11,13} channels contribute 1*1*1 = 3 (all prime, no nilpotents). 140*3 = 420.", "");
  render_finding(g, "Nil sum", "4+3+5+7 = 19 = f(5)", "Per-channel nilpotent counts sum to 19 = 5^2-5-1 = f(5) where f(p)=p^2-p-1. Same 19 from three independent counts.", "");
  render_finding(g, "mod-8 channel factor", "lambda/210 = 2", "The mod-8 channel's unique depth 3 doubles the nilpotent count from 210 to 420.", "");
  dom_append(dom_body(), sec)
)

fn lambda_desert() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Desert Pair");
  render_p(sec, "The chain terminates at level 3*5 = 15 because it builds its own grave:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Desert pair", "{1596, 1597}", "Two consecutive integers, both unreachable. No prime q exists with q-1 = 1596 or q-1 = 1597.", "");
  render_finding(g, "1596", "4*3*7*19", "Inner primes + Cunningham of 3^2=9. 19 = 5^2-5-1 = f(5).", "");
  render_finding(g, "1597", "F(17)", "The 7th Fibonacci prime. The 251st prime. Fibonacci index = 17. 251 mod 210 = 41 (prime rank class).", "");
  render_finding(g, "Desert width", "2", "Width = 2. Guards: 1595 = 5*11*29 (below), 1598 = 2*17*47 (above). Both chain-smooth.", "");
  render_p(sec, "Density decay across levels: chain phase has d = 1.000 (all growths are chain primes). Mixed phase: rapid decline. Terminal phase: d(k) = 1.307*e^(-0.172k). Rate 0.172 is approximately log(phi)/log(11) = 0.201. Each level: 84% survives. The chain terminates when prime density can no longer sustain exact Fibonacci growth.");
  dom_append(dom_body(), sec)
)

fn lambda_pisano() = (
  let sec = make_section("800px") in
  render_h2(sec, "Pisano-E8 Theorem");
  render_theorem(sec, "Fibonacci Periods at Chain Primes Give E8", "pi(p) = Fibonacci period mod p. pi(2)=3, pi(3)=8, pi(5)=20, pi(7)=16, pi(11)=10. All chain-smooth. lcm(3,8,20,16,10) = 240 = |roots(E8)|. Seventh independent path to 240.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum", "3+8+20+16+10 = 57 = 3*19", "= Phi_3(7). Cyclotomic loop: sum of Pisano periods = cyclotomic evaluation.", "");
  render_finding(g, "pi(210)", "= 240 = |E8|", "The Fibonacci period in the Z/210 ring IS E8. Direct.", "");
  render_finding(g, "Legendre sorting", "(5|p) classifies primes", "QNR (5 invisible): {2,3,7}. QR (5 visible): {11}. Ramified: {5}. 25 self-blindness: (5|5) = 0.", "");
  render_finding(g, "Golden ratio", "phi primitive root mod 11", "sqrt(5) = 4 mod 11. phi = 8 mod 11. ord(8) = 10 = 11-1. phi generates F_11^*.", "");
  dom_append(dom_body(), sec)
)

fn lambda_pisano_ring() = (
  let sec = make_section("800px") in
  render_h2(sec, "Pisano Ring-Level Structure");
  render_p(sec, "Extending to all 7 chain primes and ring-level Pisano periods reveals the 105 growth theorem. The extension primes {13, 17} have Pisano periods 4*7 = 28 and 4*9 = 36 -- chain-smooth, with ranks of apparition alpha(13) = 7 and alpha(17) = 9.");
  render_theorem(sec, "Fibonacci-Pisano Structure Theorem (PROVED)", "Pisano periods pi(p) for all 7 chain primes are chain-smooth: {3, 8, 20, 16, 10, 28, 36}. Sum = 11^2 = 121. Ranks of apparition alpha(p) = {3, 4, 5, 8, 10, 7, 9}: alpha(13)=7 (boundary enters at depth), alpha(17)=9 (escape enters at chain stop). pi/alpha ratio product = 2^8 = 256 = |Inv(Z/214,414,200)|. Ring-level (CRT = lcm): pi(Z/210) = P(7) = 240 (shadow polynomial at depth). pi(Z/214,414,200) = 60*420 = 240*105 = 25200. Total growth pi(Z/214,414,200)/pi(Z/210) = 105. pi/alpha = 2 uniformly across the ring ladder. 80/80 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime p");
  render_th(hdr, "pi(p)");
  render_th(hdr, "alpha(p)");
  render_th(hdr, "pi/alpha");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "3", "3", "1");
  render_table_row_4(tbl, "3", "8", "4", "2");
  render_table_row_4(tbl, "5", "20", "5", "4");
  render_table_row_4(tbl, "7", "16", "8", "2");
  render_table_row_4(tbl, "11", "10", "10", "1");
  render_table_row_4(tbl, "13", "28", "7", "4");
  render_table_row_4(tbl, "17", "36", "9", "4");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 11^2", "3+8+20+16+10+28+36 = 121", "Total of all 7 Pisano periods = 11^2. Data-channel sum = 57 = 3*19 (above), extension adds 64 = 2^6.", "");
  render_finding(g, "105 growth", "pi(Z/214,414,200)/pi(Z/210) = 105", "The ring-level Pisano grows by exactly 105 = 3*5*7 from Z/210 (240) to Z/214,414,200 (25200). Fibonacci periodicity inherits the ring hierarchy.", "");
  render_finding(g, "2-uniform", "pi/alpha = 2 at ring level", "pi(Z/210)/alpha(Z/210) = 240/120 = 2. pi(Z/214,414,200)/alpha(Z/214,414,200) = 25200/12600 = 2. 2 governs the Pisano/apparition ratio uniformly.", "");
  render_finding(g, "Staircase", "Z/210->Z/970,200 x(5*7), Z/12,612,600->Z/214,414,200 x3", "Ring-level Pisano grows by 5*7 = 35 from Z/210 to Z/970,200, then by 3 from Z/12,612,600 to Z/214,414,200. 11 and 13 add nothing (same non-contributing primes as lambda convergence staircase).", "");
  render_finding(g, "alpha(Z/214,414,200)", "= 12600 = 420 * 30", "The rank of apparition of the Z/214,414,200 ring equals lambda * 30. Fibonacci first enters the full ring at 420 stretched by the squarefree primorial.", "");
  dom_append(dom_body(), sec)
)

fn lambda_cyclotomic() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cyclotomic Generation");
  render_p(sec, "The chain primes emerge from cyclotomic polynomials evaluated at 2:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "n");
  render_th(hdr, "Phi_n(2)");
  render_th(hdr, "Identity");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "1", "1", "Identity.");
  render_table_row_4(tbl, "2", "3", "3", "Phi_2(2) = 2+1 = 3.");
  render_table_row_4(tbl, "3", "7", "7", "Phi_3(2) = 4+2+1 = 7.");
  render_table_row_4(tbl, "4", "5", "5", "Phi_4(2) = 4+1 = 5.");
  render_table_row_4(tbl, "8", "17", "17", "ord(2,17) = 8.");
  render_table_row_4(tbl, "10", "11", "11", "ord(2,11) = 10.");
  render_table_row_4(tbl, "12", "13", "13", "Enters at lambda(Z/210) = 12.");
  render_p(sec, "Smooth Phi_n(2) indices: {1,2,3,4,6,10}. Count = 2*3 = 6. The chain-smooth Mersenne exponents {1,2,3,4,6} = proper divisors of 12 = lambda(Z/210). f(x) = Phi_6(x) - 2: the polynomial p^2-p-1 IS the 6th cyclotomic polynomial shifted by 2.");
  render_theorem(sec, "Cyclotomic Order Theorem (PROVED)", "Every non-2 chain prime p = Phi_{ord(2,p)}(2). The cyclotomic index IS the multiplicative order of 2 mod p. Orders: 3->2, 5->4, 7->3, 11->10, 13->12=lambda(Z/210), 17->8. All chain-smooth. 2^12-1 = 4095 = 9*5*7*13. 9 duplication: Phi_2(2)=Phi_6(2)=3 (both d=2 and d=6 divide 12). Extension primes have ord NOT dividing 12: 11's 10 and 17's 8 explain Ring-level ordering. The first 7 primes are the maximal cyclotomic-prime initial segment at 2; the 8th prime 19 = f(5) breaks it. 149/149 verified.");
  let g2 = make_findings_grid(sec) in
  render_finding(g2, "Factorization", "2^12 - 1 = 4095", "= 9*5*7*13. Divisors of 12 = {1,2,3,4,6,12} give Phi values {1,3,7,5,3,13}. 3 appears twice (9 source).", "");
  render_finding(g2, "Ring-level ordering", "ord | lambda(N)", "p enters 2^lambda(N)-1 when ord(2,p) divides lambda(N). Z/210: {3,5,7,13}. Z/2,310: +11 (10|60). Z/214,414,200: +17 (8|1680, but 8 does NOT divide 420).", "");
  render_finding(g2, "Maximal segment", "Length = 7", "First 7 primes all satisfy Phi_{ord(2,p)}(2) = p exactly. 8th prime p=19: Phi_18(2) = 57 = 3*19 (contaminated). Segment length = 7.", "");
  render_finding(g2, "Ord sum", "3*13 = 39", "2+4+3+10+12+8 = 39. The sum of all cyclotomic orders is 3*13.", "");
  dom_append(dom_body(), sec)
)

fn lambda_ke_decomposition() = (
  let sec = make_section("800px") in
  render_h2(sec, "3*5 Decomposition: Why 15 Levels");
  render_theorem(sec, "3*5 = 5 + 9 + 1", "Chain length = 3*5 = 15 decomposes as: 1 (start) + 5 (chain phase) + 9 (mixed phase). Equivalently (3-1)(5-1) = 8. The 8 uniform elements connect the chain phase to the mixed phase.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Chain Phase (1-5)", "Growth = {2,2,3,5,7}", "Uses ONLY chain primes. Product = 4*3*5*7 = 420 = lambda. f grows from 1 to 13 = F(7). Lambda crystallizes from 5 chain growth factors.", "");
  render_finding(g, "Mixed Phase (6-14)", "Growth = {13,11,4,19,...}", "9 levels. External primes enter. 11 returns. 2-fattenings appear. f grows from 13 to 987 = F(16).", "");
  render_finding(g, "Chain Self-Reference", "lambda_5 = lambda(Z/12,612,600)", "At level 5: the chain reproduces the Z/12,612,600 ring's Carmichael period. f(420) = 13.", "");
  render_finding(g, "Level 3 = Z/210", "lambda_3 = 12 = lambda(Z/210)", "At level 3: the chain reproduces the Z/210 ring's lambda. The chain builds through the ring hierarchy: Z/210 (level 3) -> Z/12,612,600 (level 5) -> beyond.", "");
  render_theorem(sec, "2-Fattening Pattern", "All composite growth factors are 2-fattenings of earlier primes: g_8 = 4 = 2*g_1 at level 8. g_10 = 2*19 = 2*g_9 at level 10. g_14 = 2*97 = 2*g_11 at level 14. 2 carries the chain AND creates the termination gap.");
  dom_append(dom_body(), sec)
)

fn lambda_crystallization() = (
  let sec = make_section("800px") in
  render_h2(sec, "Prime-Only Crystallization");
  render_theorem(sec, "The 11-Transition", "At level 7 (11 entering): valid growth factors drop from 65 to 10. Before 11: composites dominate (90%+). After 11: primes dominate (80%+). 11 crystallizes the chain. Levels 10-13: 100% prime growth (verified in [2,5000]). Level 14: crystallization breaks via 2*97 = 194. Level 15: no valid growth exists.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Level");
  render_th(hdr, "Valid g");
  render_th(hdr, "Prime %");
  render_th(hdr, "Phase");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "965", "11.9%", "Open -- many composites");
  render_table_row_4(tbl, "6", "65", "declining", "Pre-transition");
  render_table_row_4(tbl, "7", "10", "80%", "11-TRANSITION");
  render_table_row_4(tbl, "8-9", "13-19", "92-95%", "Crystallizing");
  render_table_row_4(tbl, "10-13", "11-15", "100%", "PURE CRYSTAL");
  render_table_row_4(tbl, "14", "2", "50%", "Break: 2*97 composite");
  render_table_row_4(tbl, "15", "0", "-", "CHAIN TERMINATES");
  render_p(sec, "Crystallization holds for levels 10 to 10+3 = 13. Level 14 = 7+7: composite returns via 2*97. 7 controls the drop period. 11 initiates crystallization (level 7), 7 terminates it (level 14 = 2*7).");
  dom_append(dom_body(), sec)
)

fn lambda_free_sum() = (
  let sec = make_section("800px") in
  render_h2(sec, "Free Sum Decomposition");
  render_p(sec, "How many rings share a given lambda? The lattice freedom at each level can be decomposed into three additive tower contributions -- one from each class of boundary prime.");
  render_theorem(sec, "Free Sum Triangular Decomposition (PROVED)", "free_sum(e_E) = T(e_E) + g * 2^(e_E) + s, where T(n) = n(n+1)/2 is the triangular number, g = 1 if GATE present, s = 1 if ESCAPE present. Three contributions: observer base T(e_E) from the E-channel, boundary liberation 2^(e_E) from GATE, transcendence sigma from ESCAPE. At Pareto (e_E = 2): T(2) + 4 + 1 = 3 + 4 + 1 = 8 = 2^3.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Three ring levels", "TRANS: T+2^e+1, TRUE: T+2^e, DEEP: T alone", "TRANS has both GATE and ESCAPE (g=1, s=1). TRUE has GATE but not ESCAPE (g=1, s=0). DEEP has neither (g=0, s=0). Each boundary prime adds its own term.", "");
  render_finding(g, "Axiom values emerge", "TRANS: {2, 4, 8}. TRUE: {1, 3, 7}. DEEP: {0, 1, 3}", "At e_E = 0, 1, 2: TRANS gives D, D^2, D^3. TRUE gives sigma, K, b. DEEP gives void, sigma, K. The free sums at each level ARE axiom constants.", "");
  render_finding(g, "Cross-lambda ratio", "E/K = 5/3 at all E levels", "The ratio of lattice sizes at lambda = 240 vs lambda = 1680 is uniformly E/K. The observer and closure primes govern the lattice density ratio.", "");
  render_finding(g, "Column product = 432", "K * D^3 * D*K^2 = 432 = d(TRUE)", "The column sums {3, 8, 18} multiply to 432 -- the divisor count of TRUE. The free sum matrix knows the cross lattice.", "");
  dom_append(dom_body(), sec)
)

fn lambda_theorem_pointers() = (
  let sec = make_section("800px") in
  render_h2(sec, "Theorem Pointers");
  render_p(sec, "Proved theorems on the Proof Assistant page that directly concern lambda = 420:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "#");
  render_th(hdr, "Theorem");
  render_th(hdr, "Key result");
  dom_append(tbl, hdr);
  render_table_row(tbl, "140", "CRT Nilpotent Count", "Nilpotent count = 420 at all prime-power levels. Per-channel {4,3,5,7}. Inner channels {2,5,7} contribute 140.");
  render_table_row(tbl, "153", "Free Sum Triangular", "free_sum = T(e_E) + g*2^(e_E) + s. Three tower contributions. Column product = 432 = d(TRUE).");
  render_table_row(tbl, "156", "Cyclotomic Order", "p = Phi_{ord(2,p)}(2). 2^12-1 = 9*5*7*13. Maximal segment = 7.");
  render_table_row(tbl, "193", "Fibonacci-Pisano Structure", "All 7 pi(p) chain-smooth. Sum = 11^2. Ring-level growth = 105. pi/alpha = 2 uniform.");
  dom_append(dom_body(), sec)
)

fn lambda_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Carmichael's lambda", "Technicality of modular arithmetic", "420 = 4*3*5*7. All 108 rings sharing this lambda do so exactly (7^2 forced). Of those 108: 84 divide Z/12,612,600 (mod-8 range 0..3); 24 extensions reach 2*Z/12,612,600 (mod-8 = 4). mod-49 channel ceiling forces it: 7^2=49 contributes 42 to the lcm, pushing 60 (Z/2,310) to 420 (Z/12,612,600). Crystallized across 5 growth factors.");
  render_contrast_row(tbl, "Fibonacci sequence", "Rabbit counting, golden ratio curiosity", "Counts invisible primes at 15 levels. Growth recursion: new = f(lambda_{k-2}). Golden ratio bound: new/need -> 1/phi.");
  render_contrast_row(tbl, "Why 420?", "Just an LCM", "Product of chain growth factors 2*2*3*5*7. Born at level 5 where f(420) = 13. The chain sees itself.");
  render_contrast_row(tbl, "Fibonacci periods", "Modular periodicity", "Pisano at chain primes gives E8: lcm = 240 = |roots(E8)|. Seventh independent path.");
  render_contrast_row(tbl, "Desert termination", "Prime gaps get large", "Desert pair {1596,1597} at level 3*5=15. 1597 = F(17). The chain closes when Fibonacci reaches the 17th index.");
  render_contrast_row(tbl, "Cyclotomic polynomials", "Abstract algebra tool", "Phi_n(2) = {1,3,7,5,17,11,13}. Cyclotomic ORDER of 2 mod p explains ring-level ordering: p enters when ord | lambda(N). First 7 = maximal segment.");
  render_contrast_row(tbl, "Nilpotent elements", "Degenerate edge case", "Count = 420 = lambda at all prime-power levels. Per-channel {4,3,5,7}. The Carmichael period counts the nilpotents. mod-8 channel doubles it: lambda/210 = 2.");
  render_p(sec, "The chain grew for 3*5 = 15 levels. At level 5, lambda = 420 is reached. The desert pair blocks the 15th step. 2 carries the chain and creates its end.");
  dom_append(dom_body(), sec)
)

