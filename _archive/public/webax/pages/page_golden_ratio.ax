/* Golden ratio visibility callback */
fn golden_check() = (
  let p = parse_int_from("#gr-input") in
  let result = dom_query("#gr-result") in
  let pr = is_prime_trial(p) in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter a prime >= 2.</p>")
  else if pr == 0 then dom_inner(result, "<p style='color:#ff6666'>" + "${p}" + " is not prime.</p>")
  else if p == 2 then dom_inner(result, "<p style='color:#ff6666;margin:4px 0'>(5/2) = <b>-1</b>. phi does NOT exist in Z/2Z. Too small -- only {0,1}.</p>")
  else if p == 5 then dom_inner(result, "<p style='color:#ffd700;margin:4px 0'>(5/5) = <b>0</b>. RAMIFIED. phi = 3 = beta in Z/5Z. The two roots of x^2-x-1 collapse (5 divides discriminant).</p>")
  else (
    let r = p % 5 in
    let leg = if r == 1 then 1
      else if r == 4 then 1
      else 0 in
    if leg > 0 then (
      let status = if p == 11 then " phi is a <b>PRIMITIVE ROOT</b> (ord = 10 = p-1). Generates all units."
        else if p == 19 then " beta is primitive (ord 18 = p-1). phi has ord 9."
        else if p == 29 then " Neither conjugate is primitive."
        else if p == 41 then " BOTH phi and beta are primitive roots (ord 40 = p-1)."
        else if p == 109 then " BOTH primitive (ord 108 = p-1). 109 = 11^2-11-1."
        else if p == 211 then " ord(phi) = 42. 211 = 210+1 (one above Z/210)."
        else " phi EXISTS in Z/" + "${p}" + "Z." in
      dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'>(5/" + "${p}" + ") = <b>+1</b>." + status + "</p><p style='color:#ffd700;margin:4px 0'>p mod 5 = " + "${r}" + " (quadratic residue). sqrt(5) exists mod " + "${p}" + ".</p>")
    ) else (
      let note = if p == 3 then " Z/3 too small: only {0,1,2}."
        else if p == 7 then " 5 is not a square mod 7."
        else if p == 13 then " 5 is not a square mod 13. phi cannot exist here."
        else " phi is blocked at this prime." in
      dom_inner(result, "<p style='color:#ff8844;margin:4px 0'>(5/" + "${p}" + ") = <b>-1</b>." + note + "</p><p style='color:#b8b8c8;margin:4px 0'>p mod 5 = " + "${r}" + " (non-residue). No sqrt(5) mod " + "${p}" + ".</p>")
    )
  )
)

fn page_golden_ratio() = (
  dom_head_meta("description", "Golden ratio phi = (1+sqrt5)/2 is a primitive root mod 11. Ramified at 5 (discriminant divides). Blocked at 13 (quadratic non-residue). phi = p mod (p^2-p-1) universally. Five proved theorems.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Golden Ratio\",\"description\":\"Golden ratio phi=(1+sqrt5)/2 is primitive root mod 11, ramified at 5, blocked at 13. phi=p mod f(p) universally.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/golden_ratio\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"golden ratio\"},{\"@type\":\"DefinedTerm\",\"name\":\"phi\"},{\"@type\":\"DefinedTerm\",\"name\":\"Fibonacci\"}]}");
  /* === HERO === */
  let hero = make_hero("The Golden Ratio in the Ring") in
  let big = dom_create("div") in
  dom_text(big, "phi mod f(p) = p");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The golden ratio phi = (1+sqrt(5))/2 satisfies x^2 - x - 1 = 0 with discriminant 5. In Z/pZ it exists only when 5 is a quadratic residue mod p. Walking the chain's primes: phi first exists at p = 11 as a primitive root. At p = 5 it is ramified (both roots collapse). At p = 13 it is blocked entirely. The Legendre symbol (5/p) traces the chain.");
  dom_append(dom_body(), hero);

  /* === SEC 1: VISIBILITY LADDER === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Golden Visibility Ladder");
  let vtbl = dom_create("table") in
  dom_style(vtbl, "width", "100%");
  dom_style(vtbl, "maxWidth", "700px");
  dom_style(vtbl, "margin", "24px auto");
  dom_style(vtbl, "borderCollapse", "collapse");
  let vhdr = dom_create("tr") in
  render_th(vhdr, "Prime");
  render_th(vhdr, "Note");
  render_th(vhdr, "(5/p)");
  render_th(vhdr, "Status");
  dom_append(vtbl, vhdr);
  render_table_row_4(vtbl, "2", "even prime", "-1", "phi NOT in Z/2Z");
  render_table_row_4(vtbl, "3", "3", "-1", "phi NOT in Z/3Z");
  render_table_row_4(vtbl, "5", "discriminant", "0", "RAMIFIED: phi = beta = 3");
  render_table_row_4(vtbl, "7", "7", "-1", "phi NOT in Z/7Z");
  render_table_row_4(vtbl, "11", "1+2+3+5", "+1", "PRIMITIVE ROOT (ord = 10)");
  render_table_row_4(vtbl, "13", "2^2+3^2", "-1", "BLOCKED. Cannot exist.");
  dom_append(sec1, vtbl);
  render_theorem(sec1, "Golden Visibility Theorem (PROVED)", "phi first exists as a distinguishable element at p = 11. At p = 5, phi is ramified: both roots of x^2-x-1 collapse because 5 divides the discriminant. At p = 11, phi is a primitive root (generates all units of Z/11). At p = 13, phi is blocked: (5/13) = -1, no square root of 5 exists. The Legendre symbol (5/p) determines everything.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CHARACTER DUALITY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Quadratic Character Duality");
  render_theorem(sec2, "Character Duality Theorem (PROVED)", "phi*beta = -1 (mod p). Therefore: p = 1 (mod 4) -> phi and beta have SAME quadratic character. p = 3 (mod 4) -> OPPOSITE character. Proof: (phi*beta)^((p-1)/2) = (-1)^((p-1)/2). QED.");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "p");
  render_th(chdr, "p mod 4");
  render_th(chdr, "phi");
  render_th(chdr, "Primitive?");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "11", "3", "8 (ord 10)", "PHI only");
  render_table_row_4(ctbl, "19 = 5^2-5-1", "3", "5 (ord 9)", "BETA only");
  render_table_row_4(ctbl, "29", "1", "6 (ord 14)", "Neither");
  render_table_row_4(ctbl, "41 = 7^2-7-1", "1", "7 (ord 40)", "BOTH");
  render_table_row_4(ctbl, "59", "3", "34 (ord 58)", "PHI only");
  render_table_row_4(ctbl, "109 = 11^2-11-1", "1", "11 (ord 108)", "BOTH");
  dom_append(sec2, ctbl);
  render_p(sec2, "When p = 3 mod 4, exactly one of {phi, beta} can be a primitive root. When p = 1 mod 4, both or neither.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: DEPTH QUADRATIC FLIP === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The f(p) Flip");
  render_theorem(sec3, "Mod-4 Flip (PROVED)", "f(p) = p^2 - p - 1 flips the mod-4 class. p = 1 mod 4 implies f(p) = 3 mod 4. p = 3 mod 4 implies f(p) = 1 mod 4. Proof: p=1: f = 1-1-1 = -1 = 3 mod 4. p=3: f = 9-3-1 = 5 = 1 mod 4.");
  render_p(sec3, "Corollary: f(p) flips which golden conjugate generates. At p = 11 (11 mod 4 = 3): phi alone is primitive. At f(11) = 109 (109 mod 4 = 1): BOTH phi and beta are primitive roots.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: GOLDEN CHAIN === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Golden Chain");
  render_theorem(sec4, "phi = p mod f(p) (PROVED)", "For any prime p: (2p-1)^2 = 5 (mod f(p)). Therefore phi = p (mod f(p)). The golden ratio equals each prime inside its own f(p) image. Proof: (2p-1)^2 = 4p^2 - 4p + 1 = 4f(p) + 5. QED.");
  let gtbl = dom_create("table") in
  dom_style(gtbl, "width", "100%");
  dom_style(gtbl, "maxWidth", "700px");
  dom_style(gtbl, "margin", "24px auto");
  dom_style(gtbl, "borderCollapse", "collapse");
  let ghdr = dom_create("tr") in
  render_th(ghdr, "p");
  render_th(ghdr, "f(p)");
  render_th(ghdr, "phi mod f(p)");
  render_th(ghdr, "Primitive?");
  dom_append(gtbl, ghdr);
  render_table_row_4(gtbl, "3", "5", "3", "YES (ramified)");
  render_table_row_4(gtbl, "5", "19", "5", "NO (5 divides discriminant)");
  render_table_row_4(gtbl, "7", "41", "7", "YES (ord 40 = p-1)");
  render_table_row_4(gtbl, "11", "109", "11", "YES (ord 108 = p-1)");
  render_table_row_4(gtbl, "67", "4421", "67", "YES (ord 4420 = p-1)");
  dom_append(sec4, gtbl);
  render_p(sec4, "phi mod f(3) = 3. phi mod f(5) = 5. phi mod f(7) = 7. phi mod f(11) = 11. And p = 5 is the ONLY chain prime where phi fails to generate -- because 5 divides the discriminant, the two roots are indistinguishable.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: MERSENNE-GOLDEN GATE + DATA+1 === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Special Primes");
  render_theorem(sec5, "Mersenne Connection (PROVED)", "Among Mersenne primes 2^n - 1 for n in {2,3,5,7}: 5 is a quadratic residue for exactly one: 2^5 - 1 = 31. There phi = 19 = f(5), and beta = 13 is a primitive root of Z/31.");
  render_theorem(sec5, "p = 211 (PROVED)", "At p = 211 = 210 + 1 (one above Z/210): ord(phi) = 42 = 2*3*7. Subgroup index: 210/42 = 5. The golden ratio's order at the first prime above the four-channel ring is the product of three of its primes.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: AXIOM ORDER + NON-GENERATING === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Non-Generating Orders");
  render_theorem(sec6, "Conjugate Order Theorem (PROVED)", "At p = 11: ord(beta) = 5. At p = 19: ord(phi) = 9. When one conjugate is primitive and the other is not, the non-generating order is itself a chain prime or chain value.");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "Pisano periods", "pi(p) = 2(p+1) maximal", "For primes where 5 is a non-residue (3, 7, 13, 17, 23, 43, 67, 97). Exception: p = 47, pi = 32 (1/3 of max).", "");
  render_finding(g6, "p = 13", "pi(13) = 28 = 4*7", "Divides 2(13+1) = 28 exactly. At 13, phi must leave the base field.", "");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE: GOLDEN RATIO VISIBILITY === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: phi Visibility Check");
  render_p(sec_i, "Enter any odd prime p. Does the golden ratio exist in Z/pZ? The Legendre symbol (5/p) tells all: +1 means phi exists, -1 means blocked, 0 means ramified (p=5).");
  make_interactive_widget(sec_i, "Check golden ratio at prime p:", "gr-input", "e.g. 11", "Check", "golden_check", "gr-result");
  render_p(sec_i, "Try: 2, 3, 5, 7, 11, 13, 19, 29, 41, 109, 211. Which primes let phi in?");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Contrast Table");
  render_contrast_row(sec7, "Golden ratio", "Appears in phyllotaxis, art, Fibonacci. Whether phi is a primitive root is a curiosity.", "phi is a primitive root mod 11. Ramified at 5 (discriminant divides). Blocked at 13. The Legendre symbol (5/p) traces the chain's primes.");
  render_contrast_row(sec7, "Fibonacci mod p", "Pisano periods, a classical sequence in number theory.", "All Pisano periods at chain primes are 11-smooth. lcm = 240 = |roots(E8)|.");
  render_contrast_row(sec7, "f(p) = p^2-p-1", "An unremarkable polynomial.", "phi = p (mod f(p)) universally. The golden ratio becomes each chain prime through its own f(p) image. 5 is the only failure: discriminant divides.");
  dom_append(dom_body(), sec7)
)
