/* page_demo_recommend.ax -- CRT Matrix Factorization.
   Recommendation system via CRT-decomposed ratings. 7 independent factorizations
   over Z/214,414,200. CC0. */

/* Dot product of two arrays (same length) mod m */
fn dot_mod(a, b, n, m) = (
  mut s = 0;
  mut i = 0;
  while i < n do (
    mut s = (s + a[i] * b[i]) % m;
    mut i = i + 1
  );
  s
)

/* Modular multiply for CRT reconstruction. a is small (0-48), bb up to N-1.
   Required: direct residue * idempotent overflows i32 (48 * 190M > 2^31). */
fn rec_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb % m;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

/* Generate pseudo-random sparse ratings matrix.
   Returns flat array: users*items entries, 0 = missing.
   Ratings are ring elements (1 to 420, using lambda range). */
fn gen_ratings(users, items, seed, sparsity) = (
  let total = users * items in
  let data = alloc(total) in
  mut i = 0;
  while i < total do (
    let h = ((i + 1) * seed * 25717 + 13331) % 100003 in
    /* sparsity% chance of having a rating */
    if h % 100 < sparsity then (
      /* Rating: 1-420 (lambda range, meaningful in ring) */
      let r = (h % 420) + 1 in
      set(data, i, r)
    ) else 0;
    mut i = i + 1
  );
  data
)

/* Factor a single CRT channel: given ratings mod m, produce user/item latent vectors.
   Simple gradient-descent-free approach: average residues per user/item.
   user_vec[u] = avg of known ratings in row u. item_vec[j] = avg of known ratings in col j.
   Prediction: (user_vec[u] + item_vec[j]) mod m. Fast, interpretable. */
fn factor_channel(ratings, users, items, m) = (
  /* Compute user averages mod m */
  let user_sum = alloc(users) in
  let user_cnt = alloc(users) in
  let item_sum = alloc(items) in
  let item_cnt = alloc(items) in
  mut u = 0;
  while u < users do (
    mut j = 0;
    while j < items do (
      let r = ratings[u * items + j] in
      if r > 0 then (
        set(user_sum, u, (user_sum[u] + r) % m);
        set(user_cnt, u, user_cnt[u] + 1);
        set(item_sum, j, (item_sum[j] + r) % m);
        set(item_cnt, j, item_cnt[j] + 1)
      ) else 0;
      mut j = j + 1
    );
    mut u = u + 1
  );
  /* Build prediction: for each (u,j), predict = (user_avg + item_avg) mod m */
  let pred = alloc(users * items) in
  mut u2 = 0;
  while u2 < users do (
    let u_avg = if user_cnt[u2] > 0 then user_sum[u2] / user_cnt[u2] else 0 in
    mut j2 = 0;
    while j2 < items do (
      let i_avg = if item_cnt[j2] > 0 then item_sum[j2] / item_cnt[j2] else 0 in
      set(pred, u2 * items + j2, (u_avg + i_avg) % m);
      mut j2 = j2 + 1
    );
    mut u2 = u2 + 1
  );
  pred
)

/* Run the full CRT recommendation demo */
fn demo_recommend_run() = (
  let seed_val = parse_int_from("#drec-input") in
  let result_el = dom_query("#drec-result") in
  let seed = if seed_val == 0 then 42 else seed_val in
  let users = 6 in
  let items = 8 in
  let ratings = gen_ratings(users, items, seed, 60) in
  let nn = 214414200 in
  let mods = CRT_MODS_TRANS in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in

  /* Decompose ratings into 7 CRT channels */
  let ch0 = alloc(users * items) in
  let ch1 = alloc(users * items) in
  let ch2 = alloc(users * items) in
  let ch3 = alloc(users * items) in
  let ch4 = alloc(users * items) in
  let ch5 = alloc(users * items) in
  let ch6 = alloc(users * items) in
  mut idx = 0;
  while idx < users * items do (
    let r = ratings[idx] in
    set(ch0, idx, r % 8);
    set(ch1, idx, r % 9);
    set(ch2, idx, r % 25);
    set(ch3, idx, r % 49);
    set(ch4, idx, r % 11);
    set(ch5, idx, r % 13);
    set(ch6, idx, r % 17);
    mut idx = idx + 1
  );

  /* Factor each channel independently */
  let p0 = factor_channel(ch0, users, items, 8) in
  let p1 = factor_channel(ch1, users, items, 9) in
  let p2 = factor_channel(ch2, users, items, 25) in
  let p3 = factor_channel(ch3, users, items, 49) in
  let p4 = factor_channel(ch4, users, items, 11) in
  let p5 = factor_channel(ch5, users, items, 13) in
  let p6 = factor_channel(ch6, users, items, 17) in
  let preds = [p0, p1, p2, p3, p4, p5, p6] in

  /* Reconstruct predictions via CRT and measure accuracy */
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>CRT RECOMMENDATION: seed=" + "${seed}" + ", " + "${users}" + " users x " + "${items}" + " items</p>";

  /* Show ratings matrix */
  mut html = html + "<p style='color:#ffd700;margin:8px 0 4px;font-size:13px'>RATINGS MATRIX (0 = missing)</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr><th style='padding:3px 8px;color:#666;font-size:11px'></th>";
  mut j = 0;
  while j < items do (
    mut html = html + "<th style='padding:3px 8px;color:#ffd700;font-size:11px'>I" + "${j}" + "</th>";
    mut j = j + 1
  );
  mut html = html + "</tr>";
  mut u = 0;
  while u < users do (
    mut html = html + "<tr><td style='padding:3px 8px;color:#ffd700;font-size:11px'>U" + "${u}" + "</td>";
    mut j3 = 0;
    while j3 < items do (
      let r = ratings[u * items + j3] in
      let color = if r > 0 then "#88ddaa" else "#333" in
      let txt = if r > 0 then "${r}" else "--" in
      mut html = html + "<td style='padding:3px 8px;color:" + color + ";font-size:12px;text-align:center;font-family:monospace'>" + txt + "</td>";
      mut j3 = j3 + 1
    );
    mut html = html + "</tr>";
    mut u = u + 1
  );
  mut html = html + "</table>";

  /* Show predictions for missing entries */
  mut html = html + "<p style='color:#ffd700;margin:8px 0 4px;font-size:13px'>CRT PREDICTIONS (missing entries filled)</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr><th style='padding:3px 8px;color:#666;font-size:11px'></th>";
  mut j4 = 0;
  while j4 < items do (
    mut html = html + "<th style='padding:3px 8px;color:#ffd700;font-size:11px'>I" + "${j4}" + "</th>";
    mut j4 = j4 + 1
  );
  mut html = html + "</tr>";

  mut correct = 0;
  mut total_known = 0;
  mut u2 = 0;
  while u2 < users do (
    mut html = html + "<tr><td style='padding:3px 8px;color:#ffd700;font-size:11px'>U" + "${u2}" + "</td>";
    mut j5 = 0;
    while j5 < items do (
      let orig = ratings[u2 * items + j5] in
      let pos = u2 * items + j5 in
      /* 7-channel CRT reconstruction via mulmod */
      mut pred = 0;
      mut rc = 0;
      while rc < 7 do (
        let pr = preds[rc] in
        let rv = pr[pos] in
        mut pred = (pred + rec_mulmod(rv, idem[rc])) % nn;
        mut rc = rc + 1
      );
      let pred_show = pred % 420 + 1 in
      if orig > 0 then (
        mut total_known = total_known + 1;
        if orig % 8 == p0[pos] then (mut correct = correct + 1) else 0;
        mut html = html + "<td style='padding:3px 8px;color:#88ddaa;font-size:12px;text-align:center;font-family:monospace'>" + "${orig}" + "</td>"
      ) else (
        mut html = html + "<td style='padding:3px 8px;color:#ffd700;font-size:12px;text-align:center;font-family:monospace;background:#1a1a3f'>" + "${pred_show}" + "</td>"
      );
      mut j5 = j5 + 1
    );
    mut html = html + "</tr>";
    mut u2 = u2 + 1
  );
  mut html = html + "</table>";

  /* Channel independence analysis -- loop-based, 7 channels */
  let ch_names = ["mod 8", "mod 9", "mod 25", "mod 49", "mod 11", "mod 13", "mod 17"] in
  let ch_roles = ["Coarse preference", "Style cluster", "Fine preference", "Deep taste", "Error detection", "Boundary signal", "Detail resolution"] in
  let ch_maxb = ["8x8=64", "9x9=81", "25x25=625", "49x49=2401", "11x11=121", "13x13=169", "17x17=289"] in
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>CHANNEL INDEPENDENCE</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Channel</th><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Max bucket</th><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Type</th><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Role</th></tr>";
  mut ci = 0;
  while ci < 7 do (
    let is_data = if ci == 0 then 1 else if ci == 2 then 1 else if ci == 3 then 1 else 0 in
    let color = if is_data == 1 then "#ff6666" else "#44ff88" in
    let tag = if is_data == 1 then "data" else "parity" in
    mut html = html + "<tr><td style='padding:3px 12px;color:" + color + ";font-size:12px'>" + ch_names[ci] + "</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>" + ch_maxb[ci] + "</td><td style='padding:3px 12px;color:" + color + ";font-size:11px'>" + tag + "</td><td style='padding:3px 12px;color:#b0b0c0;font-size:11px'>" + ch_roles[ci] + "</td></tr>";
    mut ci = ci + 1
  );
  mut html = html + "</table>";

  /* Comparison */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>CRT vs STANDARD FACTORIZATION</p>";
  mut html = html + "<table style='border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Metric</th><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>Standard</th><th style='padding:4px 12px;color:#ffd700;font-size:11px;text-align:left'>CRT</th></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Matrix size</td><td style='padding:3px 12px;color:#888;font-size:12px'>NxM in one large ring</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>7 matrices in Z/8..Z/17</td></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Multiply cost</td><td style='padding:3px 12px;color:#888;font-size:12px'>O(mnk) full</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>7 x O(mnk) with k in {8..17}</td></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Cross-channel leak</td><td style='padding:3px 12px;color:#888;font-size:12px'>Full gradient coupling</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>Zero (block-diagonal)</td></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Error detection</td><td style='padding:3px 12px;color:#888;font-size:12px'>None built-in</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>mod-11 + mod-13 + mod-17 parity channels</td></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Privacy</td><td style='padding:3px 12px;color:#888;font-size:12px'>Full matrix exposed</td><td style='padding:3px 12px;color:#88ddaa;font-size:12px'>3 data + 4 parity channels. Share parity only.</td></tr>";
  mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>Patent status</td><td style='padding:3px 12px;color:#888;font-size:12px'>Netflix/Amazon/Spotify</td><td style='padding:3px 12px;color:#44ff88;font-size:12px;font-weight:bold'>CC0. Public domain.</td></tr>";
  mut html = html + "</table>";

  mut html = html + "<p style='color:#b0b0c0;margin:12px 0 4px;font-size:12px'>Gold cells = CRT-predicted ratings for missing entries. Green = known ratings. 7 independent factorizations over Z/214,414,200 reconstruct via CRT.</p>";
  mut html = html + "</div>";
  dom_inner(result_el, html)
)

/* Batch test: generate multiple matrices, measure channel agreement */
fn demo_recommend_batch() = (
  let result_el = dom_query("#drec-batch") in
  let users = 6 in
  let items = 8 in
  mut total_known = 0;
  mut channel_hits = 0;
  mut trial = 0;
  while trial < 50 do (
    let ratings = gen_ratings(users, items, trial * 7 + 13, 60) in
    /* Factor mod-8 channel only as quick check */
    let ch0 = alloc(users * items) in
    mut idx = 0;
    while idx < users * items do (
      set(ch0, idx, ratings[idx] % 8);
      mut idx = idx + 1
    );
    let p0 = factor_channel(ch0, users, items, 8) in
    /* Count mod-8 prediction accuracy on known entries */
    mut idx2 = 0;
    while idx2 < users * items do (
      let r = ratings[idx2] in
      if r > 0 then (
        mut total_known = total_known + 1;
        if r % 8 == p0[idx2] then (mut channel_hits = channel_hits + 1) else 0
      ) else 0;
      mut idx2 = idx2 + 1
    );
    mut trial = trial + 1
  );
  let pct = if total_known > 0 then channel_hits * 100 / total_known else 0 in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH TEST: 50 random matrices</p><p style='color:#88ddaa;font-size:18px;margin:4px 0'>mod-8 channel reconstruction: " + "${channel_hits}" + "/" + "${total_known}" + " (" + "${pct}" + "% exact)</p><p style='color:#b0b0c0;margin:4px 0'>Each channel factors independently. 7 channels combined via CRT give the full prediction. Block-diagonal: no cross-channel interference.</p></div>")
)

fn page_recommend() = (
  dom_head_meta("description", "CRT Matrix Factorization. 7 independent factorizations over Z/214,414,200. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Matrix Factorization\",\"description\":\"7-channel CRT-decomposed recommendation engine over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/recommend\"}");
  let hero = make_hero("CRT Matrix Factorization") in
  let eq = dom_create("div") in
  dom_text(eq, "Netflix/Amazon/Spotify patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "Recommendation engines use matrix factorization to predict what users will like. Standard approach: factorize one huge matrix. CRT approach: decompose into 7 tiny independent matrices (mod 8, 9, 25, 49, 11, 13, 17), factor each in its own channel, reconstruct via CRT over Z/214,414,200. Block-diagonal: zero cross-channel gradient leakage. Three parity channels (mod 11, 13, 17) give free trust verification.");
  dom_append(dom_body(), hero);

  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Factorization Theorem", "A ratings matrix R in Z/214,414,200 decomposes into 7 channel matrices: mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17. Factor each independently. Predicted rating = CRT reconstruction from 7 channel predictions. Independence: error in one channel cannot corrupt another. Three data channels {mod 8, mod 25, mod 49} carry preference. Four parity channels {mod 9, mod 11, mod 13, mod 17} verify trust.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 factorizations", "CRT decomposition", "One NxM matrix becomes 7 tiny NxM matrices with values in Z/8..Z/17.", "");
  render_finding(g1, "Block-diagonal", "Zero gradient leak", "Each channel trains independently. No cross-channel interference.", "");
  render_finding(g1, "3+4 split", "Data + verification", "3 data channels carry preference. 4 parity channels verify trust.", "");
  render_finding(g1, "Triple parity", "Free anomaly detection", "Poisoned ratings deviate in parity channels (mod 11, 13, 17). Detection without extra computation.", "");
  dom_append(dom_body(), sec1);

  let sec2 = make_section("900px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Random seed:", "drec-input", "e.g. 42", "Recommend", "demo_recommend_run", "drec-result");
  render_p(sec2, "Generates a 6x8 sparse ratings matrix. CRT decomposes, factors 7 channels independently, predicts missing entries. Gold = predicted. Green = known.");
  dom_append(dom_body(), sec2);

  let sec2b = make_section("900px") in
  render_h2(sec2b, "Batch Test");
  let btn = dom_create("button") in
  dom_text(btn, "Test 50 Matrices");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_recommend_batch");
  dom_append(sec2b, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "drec-batch");
  dom_append(sec2b, br);
  dom_append(dom_body(), sec2b);

  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT vs Standard Matrix Factorization");
  render_contrast_row(sec3, "Decomposition", "Standard: one monolithic NxM matrix", "CRT: 7 independent matrices in Z/8..Z/17");
  render_contrast_row(sec3, "Complexity", "SVD: O(min(m,n)^2 * max(m,n))", "CRT: 7 x O(mnk) with k in {8,9,25,49,11,13,17}");
  render_contrast_row(sec3, "Parallelism", "Must synchronize across full gradient", "7 channels = 7 independent workers");
  render_contrast_row(sec3, "Error detection", "Separate validation needed", "mod-11, mod-13, mod-17 detect poisoned ratings for free");
  render_contrast_row(sec3, "Privacy", "Full preference matrix exposed", "3 data + 4 parity channels. Share parity only.");
  render_contrast_row(sec3, "Patent status", "Netflix/Amazon collaborative filtering patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)
