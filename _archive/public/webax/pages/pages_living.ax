/* ================================================================
   PAGE: CHAIN -- The Axiom Chain (AXIOM.md)
   ================================================================ */

/* chain helpers */
fn chain_hero() = (
  let hero = make_hero("The Chain") in
  let eq = dom_create("div") in
  dom_text(eq, "1 -> 2 -> 3 -> 5 -> 7 -> 11 -> 13 -> 17");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Seven primes define the ring. Starting from 1 and 2, the map c(n) = 2n+1 applied to each chain member generates the next: c(1) = 3, c(2) = 5, c(3) = 7, c(5) = 11. It stops because c(7) = 15 = 3*5 is composite. 13 = 2^2 + 3^2 bounds the chain. 17 closes the ring: 5*7 = 1 mod 17. Together: Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17 = 214,414,200.");
  dom_append(dom_body(), hero)
)

fn chain_primes() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Seven Primes");
  let g = make_grid(sec, "16px") in
  render_prime(g, "1", "1", "identity: 1*n = n for all n", "#ffd700");
  render_prime(g, "2", "2", "the only even prime, generates the chain via 2n+1", "#ff8844");
  render_prime(g, "3", "3", "minimum for majority, 2+1 = 3", "#44ff88");
  render_prime(g, "5", "5", "self-blind: 25 divides the ring but 5 does not divide 24", "#4488ff");
  render_prime(g, "7", "7", "deepest channel: 49 states in mod-49", "#ff4488");
  render_prime(g, "11", "11", "error detection: 1+2+3+5 = 11", "#aa88ff");
  render_prime(g, "13", "13", "chain stopper: 2^2 + 3^2 = 13", "#88ffaa");
  render_prime(g, "17", "17", "ring closer: 5*7 = 1 mod 17", "#00dddd");
  dom_append(dom_body(), sec)
)

fn chain_uniqueness() = (
  let sec = make_section("800px") in
  render_h2(sec, "Chain Uniqueness");
  render_p(sec, "The chain is not one possibility among many. It is the ONLY all-prime chain under the generation rules. The proof is a single sentence: if the seed is any odd prime p > 2, then p+1 is even and at least 4 -- composite. 2 is the only even prime. Everything else follows.");
  render_theorem(sec, "Chain Uniqueness Theorem (PROVED)", "The generation rules: 3=2+1, 5=2+3, 7=2+5, 11=1+2+3+5, 13=2^2+3^2, 17=2+3+5+7 admit exactly ONE all-prime solution starting from seed 2. The chain 1 -> 2 -> 3 -> 5 -> 7 -> 11 -> 13 -> 17 is rigid: zero free parameters. These are the first 7 consecutive primes. 15/15 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Seed");
  render_th(hdr, "seed + 1");
  render_th(hdr, "Status");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2", "3 (prime)", "VALID -- all 7 values prime");
  render_table_row(tbl, "3", "4 (composite)", "FAILS at step 1");
  render_table_row(tbl, "5", "6 (composite)", "FAILS at step 1");
  render_table_row(tbl, "7", "8 (composite)", "FAILS at step 1");
  render_table_row(tbl, "> 2, odd", "even >= 4", "ALWAYS composite");
  let g = make_findings_grid(sec) in
  render_finding(g, "Parity lock", "2 is the only even prime", "Every other prime is odd. Odd + 1 = even >= 4 = composite. The chain can only begin at 2.", "");
  render_finding(g, "Zero parameters", "2 determines all 7", "3, 5, 7, 11, 13, 17. No choice at any step. The chain is forced.", "");
  render_finding(g, "Consecutive primes", "2, 3, 5, 7, 11, 13, 17", "The first 7 primes. No prime is skipped between any two chain elements.", "");
  dom_append(dom_body(), sec)
)

fn chain_d_chain() = (
  let sec = make_section("800px") in
  render_h2(sec, "Class Numbers Along the Chain");
  render_p(sec, "Start with 2. Apply c(n)=2n+1 repeatedly: 2, 5, 11, 23, 47, 95, 191, 383. Now compute the class number h(-d) for each value -- the number of distinct ways a quadratic form can represent integers. What comes out is the ring's own primes.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Step");
  render_th(hdr, "Chain value");
  render_th(hdr, "h(-d)");
  render_th(hdr, "Name");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "c^2(2)", "11", "1", "= 1 (identity)");
  render_table_row_4(tbl, "c^3(2)", "23", "3", "chain prime");
  render_table_row_4(tbl, "c^4(2)", "47", "5", "chain prime");
  render_table_row_4(tbl, "c^5(2)", "95 = 5*19", "8", "= 2^3");
  render_table_row_4(tbl, "c^6(2)", "191", "13", "chain stopper");
  render_table_row_4(tbl, "c^7(2)", "383", "17", "= 2+3+5+7");
  render_p(sec, "Six consecutive class numbers return 1, 3, 5, 8, 13, 17. This was not designed. It was found. The class number has no obvious reason to produce a pattern along a Cunningham chain -- yet it produces the ring's primes exactly.");
  dom_append(dom_body(), sec)
)

fn chain_ratios() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Ratios Between Consecutive Class Numbers");
  render_p(sec, "Consecutive class number ratios along the chain from 2 produce famous constants:");
  let g = make_findings_grid(sec) in
  render_finding(g, "h(-47)/h(-23)", "5/3 = Kolmogorov", "Matches the turbulence energy cascade exponent. Coincidence or structure?", "");
  render_finding(g, "h(-95)/h(-47)", "8/5 = golden approximant", "Fibonacci ratio F(6)/F(5). The golden ratio's best small-integer approximation.", "");
  render_finding(g, "h(-191)/h(-95)", "13/8 = Fibonacci", "Fibonacci ratio F(7)/F(6).", "");
  render_finding(g, "h(-383)/h(-191)", "17/13", "The ratio of the last two chain primes.", "");
  render_p(sec, "5/3 matches Kolmogorov's turbulence exponent, but the match may be coincidental -- small-prime ratios are dense near common physics constants. The pattern is real (class numbers DO produce these ratios). The physical interpretation is unproved.");
  dom_append(dom_body(), sec)
)

fn chain_two_chains() = (
  let sec = make_section("800px") in
  render_h2(sec, "Two Chains, Two Sequences");
  render_p(sec, "The ring has two Cunningham chains. One starts at 2 and produces chain primes as class numbers. The other starts at 1 and produces Fibonacci numbers:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Chain from 1");
  render_th(hdr, "d");
  render_th(hdr, "h(-d)");
  render_th(hdr, "Fibonacci");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "c(1)", "3", "1", "F(1) = 1");
  render_table_row_4(tbl, "c(c(1))", "7", "1", "F(2) = 1");
  render_table_row_4(tbl, "c^3(1)", "15", "2", "F(3) = 2");
  render_table_row_4(tbl, "c^4(1)", "31", "3", "F(4) = 3");
  render_table_row_4(tbl, "c^5(1)", "63", "5", "F(5) = 5");
  render_table_row_4(tbl, "c^6(1)", "127", "5", "BREAK: F(6)=8 but h=5");
  render_p(sec, "Chain from 1: Fibonacci numbers (additive growth). Chain from 2: ring primes as class numbers (multiplicative growth c(n)=2n+1). Two chains, two growth laws, one ring. The break at 127 = 2^7 - 1 is a Mersenne prime. Mersenne primes have unusually small class numbers -- h(-127) = 5, not the expected 8.");
  dom_append(dom_body(), sec)
)

fn chain_cunningham() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cross-Chain Duality");
  render_theorem(sec, "Cross-Chain Duality Theorem", "The chain = union of TWO Cunningham chains CC1 (c(n) = 2n+1). CC1(1): 1 -> 3 -> 7 -> 15 = 3*5 (STOP). Length 3. CC1(2): 2 -> 5 -> 11 -> 23 -> 47 -> 95 = 5*19 (STOP). Length 5. Each chain's first descendant = other chain's length. 5 appears in BOTH stopping factors. Self-closing.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Chain");
  render_th(hdr, "Seed");
  render_th(hdr, "Primes");
  render_th(hdr, "Stop");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "CC1(1)", "1", "{1, 3, 7}", "3*5 = 15 (composite). Length = 3.");
  render_table_row_4(tbl, "CC1(2)", "2", "{2, 5, 11, 23, 47}", "5*19 = 95 (composite). Length = 5.");
  render_p(sec, "Interleaved by size: 1, 2, 3, 5, 7, 11. The chains alternate perfectly. Shadow function s(p) = (p-1)/2 inverts Cunningham: 3->1, 5->2, 7->3, 11->5. Shadow chain = {1, 2, 3, 5} = the chain without 7. s(13) = 6 = 2*3 (composite). The chain = longest initial prime segment where all shadows are prime or 1.");
  dom_append(dom_body(), sec)
)

fn chain_convergence() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 13 Convergence");
  render_theorem(sec, "13 Convergence Theorem", "THREE identities produce 13, and they are algebraically the SAME: (A) 2^2 + 3^2 = 4 + 9 = 13. (B) (5^2 + 1)/2 = 26/2 = 13. (C) shadow(13) = 6 = 2*3 (composite, chain breaks). PROOF: all follow from (3-2)^2 = 1. UNIQUENESS: (2,3,5) is the ONLY prime triple with (A)=(B).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Norm theorem", "2^2+3^2+5^2+7^2+11^2 = 208 = 16*13", "13 in the norm. Sum of squares + 2 = 210.", "");
  render_finding(g, "Partial sums", "ALL 28 contiguous sums meaningful", "1+2=3. 2+3=5. 2+3+5+7=17. 1+2+3+5=11. 0/28 meaningless.", "");
  render_finding(g, "2+11 = 13", "ONLY non-smooth pairwise sum", "1 out of 15 pairwise sums. The smallest and largest inner primes sum to 13.", "");
  render_finding(g, "CRT(23)", "(1,2,3,2,1) = palindrome", "First excluded Cunningham prime. Mirror around 3.", "");
  dom_append(dom_body(), sec)
)

fn chain_mirror_law() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Mirror Laws");
  render_theorem(sec, "Cunningham Mirror Law", "c(p) = 2p + 1, so 2p = -1 mod c(p). Each new chain prime is the mirror of 2 times its predecessor: 2^2 = -1 mod 5. 2*3 = -1 mod 7. 2*5 = -1 mod 11.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Identity");
  render_th(hdr, "Value");
  render_th(hdr, "Factoring");
  render_th(hdr, "Generation");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "3 - 1", "2", "first prime", "2*1 + 1 = 3");
  render_table_row_4(tbl, "5 - 1", "4 = 2^2", "square of 2", "2*2 + 1 = 5");
  render_table_row_4(tbl, "7 - 1", "6 = 2*3", "product of first two", "2*3 + 1 = 7");
  render_table_row_4(tbl, "11 - 1", "10 = 2*5", "product of 2 and 5", "2*5 + 1 = 11");
  render_theorem(sec, "2-Generation Theorem", "Of 15 pairwise products p*q+1 among {2,3,5,7,11}, ONLY 2*{2,3,5}+1 = {5,7,11} are prime. 2 is the sole generator. No other chain prime creates primes this way.");
  dom_append(dom_body(), sec)
)

fn chain_shadow() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Shadow Polynomial");
  render_p(sec, "P(x) = (x-1)(x-2)(x-3)(x-5) = x^4 - 11x^3 + 41x^2 - 61x + 30. The shadow polynomial encodes the chain. Its coefficients are chain values:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Coefficients", "{11, 41, 61, 30}", "11 = sum of roots. 41 = sum of pairwise products. 61 = sum of triple products. 30 = 2*3*5.", "");
  render_finding(g, "P(11) = 4320", "= 2^5 * 3^3 * 5", "11 feeds back all chain primes. P(11)/P(0) = 144 = 12^2.", "");
  render_finding(g, "P(13) = 10560", "= 2^6 * 3 * 5 * 11", "All 5 inner primes present in the factorization.", "");
  render_finding(g, "P(16) = 30030", "= primorial(13)", "Shadow poly at 2^4 gives the 7-primorial: 2*3*5*7*11*13.", "");
  render_finding(g, "C(x) inversion", "C(1)=288, C(2)=2310", "C(x) = 2x^4 * P(-1/x). Class count at x=1, ring size at x=2.", "");
  dom_append(dom_body(), sec)
)

