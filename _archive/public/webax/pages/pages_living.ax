)

fn chain_gap_palindrome() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gap Exponent Palindrome");
  render_p(sec, "The consecutive gaps between chain primes {2,3,5,7,11} are {1,2,2,4}. Every gap is a power of 2. The exponents are (0,1,1,2) -- the first four Fibonacci numbers. The gap ratios (2, 1, 2) form a palindrome with identity at the center.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Gap");
  render_th(hdr, "Value");
  render_th(hdr, "Power of 2");
  render_th(hdr, "Fib");
  render_th(hdr, "Cumulative");
  dom_append(tbl, hdr);
  render_table_row_5(tbl, "3 - 2", "1", "2^0", "F(0)", "1");
  render_table_row_5(tbl, "5 - 3", "2", "2^1", "F(1)", "3");
  render_table_row_5(tbl, "7 - 5", "2", "2^1", "F(2)", "5");
  render_table_row_5(tbl, "11 - 7", "4", "2^2", "F(3)", "9 = 3^2");
  render_theorem(sec, "Gap Exponent Palindrome (PROVED)", "Consecutive gaps between chain primes are powers of 2 with Fibonacci exponents. Sum of gaps = 9 = 3^2. Product = 16 = 2^4. Cumulative gaps from 2 yield {0, 1, 3, 5, 9}. 13 breaks the Fibonacci pattern: gap 2, not 2^3 = 8.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Ratio palindrome", "(2, 1, 2)", "Center = identity. Wings = 2. Mirror symmetry in ratio space.", "");
  render_finding(g, "Fibonacci at chain primes", "F(5)=5, F(7)=13", "5 is its own Fibonacci value. 7 generates the chain stopper.", "");
  render_finding(g, "F(11) = 89", "Fibonacci prime", "89 is the 11th Fibonacci number.", "");
  dom_append(dom_body(), sec)
)

fn chain_partitions() = (
  let sec = make_section("800px") in
  render_h2(sec, "Partition Catalog");
  render_p(sec, "Split {2, 3, 5, 7, 11} into two groups and form prod(pair) + prod(triple). Of 10 possible 2|3 partitions, 7 give primes. The 3 non-primes factor as: 13^2, 2^7 - 1, and 17 * 23.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair");
  render_th(hdr, "Triple");
  render_th(hdr, "Cross-sum");
  render_th(hdr, "Named");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "{2, 11}", "{3, 5, 7}", "127", "2^7 - 1 (Mersenne prime)");
  render_table_row_4(tbl, "{3, 5}", "{2, 7, 11}", "169", "13^2");
  render_table_row_4(tbl, "{5, 11}", "{2, 3, 7}", "97", "prime");
  render_table_row_4(tbl, "{2, 3}", "{5, 7, 11}", "391", "17 * 23");
  render_table_row_4(tbl, "others", "(6 of 10)", "prime", "241, 179, 131, 103, 101, 107");
  render_theorem(sec, "Cross-Sum Partition Theorem (PROVED)", "7/10 cross-sums of 2|3 partitions are prime. The non-primes are 169 = 13^2, 127 = 2^7 - 1, and 391 = 17*23. The chain primes partition into prime-generators.");
  render_theorem(sec, "Self-Mirror Partition Theorem (PROVED)", "{3, 11} is the unique 2|3 sum-balanced partition: 3 + 11 = 2 + 5 + 7 = 14 = 2*7. The two endpoints of the inner chain mirror its three interior primes.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 28", "2+3+5+7+11 = 28", "Second perfect number. = 4*7. All sum-splits give products of chain primes.", "");
  render_finding(g, "1|4 endpoints", "2: 13*89, 11: 13*17", "In 1|4 partitions, both endpoints give 13 * (prime). Inner primes give primes.", "");
  dom_append(dom_body(), sec)
)

fn chain_cube() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 8-Vertex Cube");
  render_p(sec, "Three independent 3+3 splits embed the six primes {2, 3, 5, 7, 11, 13} into a cube. Each axis is a binary property:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Axis");
  render_th(hdr, "0 (off)");
  render_th(hdr, "1 (on)");
  dom_append(tbl, hdr);
  render_table_row(tbl, "490 split", "{2, 5, 7} = inner", "{3, 11, 13} = boundary");
  render_table_row(tbl, "1,576,576 survival", "{2, 11, 13} = zeroed", "{3, 5, 7} = survive");
  render_table_row(tbl, "3 divides p-1", "{2, 5, 11} = no", "{3, 7, 13} = yes");
  render_p(sec, "Addresses: 2=(000), 5=(010), 7=(011), 3=(111), 13=(101), 11=(100). All six vertices unique. Two corners empty: (001) and (110). Both forced by the structure of the primes.");
  render_theorem(sec, "Hexagonal Gray Code (PROVED)", "2 -> 5 -> 7 -> 3 -> 13 -> 11 -> 2 visits every vertex flipping exactly one bit per step. The coupling-order chain is a straight line; through the cube, it becomes a Hamilton cycle.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Antipodal pairs", "2<->3, 5<->13, 7<->11", "Products: 6, 65, 77. Total = 30,030 = 2*3*5*7*11*13.", "");
  render_finding(g, "Surviving face", "{3, 5, 7} = 105", "The three primes that survive multiplication by 1,576,576.", "");
