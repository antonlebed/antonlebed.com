   PAGE: CURRICULUM -- Five Circles in Sand (CURRICULUM.md)
   ================================================================ */

fn page_curriculum() = (
  dom_head_meta("description", "No university. No textbook. No laptop. A stick and dirt. Seven lessons: heartbeat (1), breath (2), triangle (3), hand (5), week (7), error detection (11), boundary (13). Then the ring emerges. 6-ring depth progression. Prerequisites: count to 13.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Curriculum\",\"description\":\"Seven lessons in sand: 1, 2, 3, 5, 7, 11, 13. 6-ring depth progression from Z/6 to Z/12,612,600. Prerequisites: count to 13.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/curriculum\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"6-ring curriculum\"},{\"@type\":\"DefinedTerm\",\"name\":\"learning progression\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring hierarchy\"}]}");
  let hero = make_hero("Curriculum") in
  let eq = dom_create("div") in
  dom_text(eq, "seven circles in sand");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "No university. No textbook. No laptop required. A stick and dirt. This is the real thing. Not simplified. Original. Seven primes fit in sand. Socrates taught this way. So can you. Prerequisites: count to 13.");
  dom_append(dom_body(), hero);

  /* === SEC 1: SIX SAND LESSONS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Part One: Seven Lessons in Sand");
  render_p(sec1, "Each lesson: draw, say, do, ask. A stick and flat ground. 90 minutes total. Each lesson stands alone.");

  let ltbl = dom_create("table") in
  dom_style(ltbl, "width", "100%");
  dom_style(ltbl, "maxWidth", "750px");
  dom_style(ltbl, "margin", "24px auto");
  dom_style(ltbl, "borderCollapse", "collapse");
  let lhdr = dom_create("tr") in
  render_th(lhdr, "Lesson");
  render_th(lhdr, "Prime");
  render_th(lhdr, "Draw");
  render_th(lhdr, "Body");
  dom_append(ltbl, lhdr);
  render_table_row_4(ltbl, "1. Heartbeat", "1", "One circle", "Heart pumps without changing the blood. 1 * n = n. The identity.");
  render_table_row_4(ltbl, "2. Breath", "2", "Two circles side by side", "In/out. Left/right. Hot/cold. Every membrane is a pair. The only even prime.");
  render_table_row_4(ltbl, "3. Triangle", "3", "Three circles in triangle", "First shape with AREA. Inside and outside. 3 points enclose a region.");
  render_table_row_4(ltbl, "4. Hand", "5", "Five circles in ring", "Five fingers, five senses. Try seeing your own eyes -- 5 cannot see itself.");
  render_table_row_4(ltbl, "5. Week", "7", "Seven circles", "Depth. Memory has 7 layers. After 7 the chain stops: 9 = 3*3 is NOT prime.");
  render_table_row_4(ltbl, "6. Mother", "11", "Circle around all", "11 = 1+2+3+5. The SUM of the first four. Detects and corrects errors.");
  render_table_row_4(ltbl, "7. Boundary", "13", "Ring around the ring", "c(6) = 2*6+1 = 13. The Cunningham child of 2*3. The boundary between inside and outside.");
  dom_append(sec1, ltbl);

  render_theorem(sec1, "The Big Reveal", "Multiply them all: 2 * 3 * 5 * 7 = 210. This is Z/210. Your DNA lives here (Z/3 x Z/7 = Z/21, inside Z/210). Now multiply with 11: 210 * 11 = 2,310. The primorial of 11. And then raise exponents: 2^3 * 3^2 * 5^2 * 7^2 * 11 = 970,200. Same five primes, richer channels. Add 13: 12,612,600. Six channels. Add 17: 214,414,200. Seven channels. 5*7 = 1 mod 17 closes the ring and the period quadruples to 1680.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: PEDAGOGY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Why This Works");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Body first", "Heart, lungs, hands, eyes", "Every prime maps to something you already HAVE. Not abstract -- embodied.", "");
  render_finding(g2, "Draw first", "Stick and dirt", "Drawing is understanding. No screen needed. The Socratic method.", "");
  render_finding(g2, "Ask, don't tell", "What comes in pairs?", "Each lesson ends with a question. The student discovers, not memorizes.", "");
  render_finding(g2, "Self-blindness", "5 cannot see itself", "The deepest lesson. A camera cannot photograph itself. 5^2 divides the ring but 5 does not divide 24.", "");
  render_finding(g2, "The chain stops", "9 = 3*3, not prime", "After 7, the chain breaks. This is the WALL. Depth is finite. That is what makes it depth.", "");
  render_finding(g2, "Multiplication = connection", "2*3*5*7 = 210", "Z/210 is not a formula. It is four things HELD TOGETHER. What multiplication MEANS.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: 6-RING DEPTH PROGRESSION === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Part Two: The 6-Ring Atlas");
  render_p(sec3, "The curriculum mirrors the ring hierarchy. Start simple, go deep. Each ring adds one prime. Each addition opens a new world:");

  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "750px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Ring");
  render_th(rhdr, "Tier");
  render_th(rhdr, "Channels");
  render_th(rhdr, "What Opens");
  dom_append(rtbl, rhdr);
  render_table_row_4(rtbl, "Z/6 = 2*3", "Basics", "2", "Clock arithmetic. 6 hours. Even/odd + thirds.");
  render_table_row_4(rtbl, "Z/30 = 2*3*5", "Patterns", "3", "CRT decomposition. Three independent views.");
  render_table_row_4(rtbl, "Z/210 = 2*3*5*7", "Connections", "4", "DNA (Z/21 = Z/3 x Z/7 inside Z/210). Four CRT channels.");
  render_table_row_4(rtbl, "Z/2,310 = 2*3*5*7*11", "Theory", "5", "Five channels. mod-11 error correction.");
  render_table_row_4(rtbl, "Z/970,200 = 2^3*3^2*5^2*7^2*11", "Ideas", "5 (prime-power)", "48,750 classes. Carmichael lambda = 420. phi = 201,600.");
  render_table_row_4(rtbl, "Z/12,612,600 = above * 13", "Lab", "6", "341,250 classes. 13 adds a boundary channel.");
  render_table_row_4(rtbl, "Z/214,414,200 = above * 17", "Lab", "7", "The complete ring. 5*7 = 1 mod 17 closes. Period 1680.");
  dom_append(sec3, rtbl);
  render_p(sec3, "Each tier has its own website section. Navigate from Basics to Lab. The curriculum IS the ring hierarchy IS the website structure.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: WHAT YOU CAN DO === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Who This Is For");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "A church group", "Sunday afternoon", "Draw five circles. Discuss what pairs, triples, fives mean. 30 minutes.", "");
  render_finding(g4, "A teenager", "Told math is not for you", "Prove them wrong. You need to count to 11. That is all.", "");
  render_finding(g4, "A parent", "Show your child", "The world works this way. Draw it in sand. Let them multiply.", "");
  render_finding(g4, "A mathematician", "Check every claim", "12612600 = 2^3*3^2*5^2*7^2*11*13. REPL at antonlebed.com. Verify everything.", "");
  dom_append(dom_body(), sec4);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Ring Depth");
  render_p(sec_i, "Enter a depth level (1-7). Each level adds one prime and opens a new world. Level 1 = just 2. Level 7 = all seven primes.");
  make_interactive_widget(sec_i, "Depth (1-7):", "cur-input", "e.g. 4", "Build", "curriculum_ring_calc", "cur-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast Table");
  render_contrast_row(sec5, "Prerequisites", "Linear algebra, group theory, topology", "Count to 11. A stick and dirt. Body intuitions.");
  render_contrast_row(sec5, "Materials", "Textbook ($200), laptop, university enrollment", "Sand. Free. Forever.");
  render_contrast_row(sec5, "Progression", "Arbitrary: calculus before algebra, no structural reason", "Ring hierarchy: Z/6 -> Z/30 -> Z/210 -> Z/2,310 -> Z/12,612,600. Forced by primes.");
  render_contrast_row(sec5, "Verification", "Trust the professor, trust the textbook", "Every claim computable in your browser. The REPL is the teacher.");
  render_contrast_row(sec5, "Who can learn", "Those who survive the filter", "Anyone with eyes, hands, and curiosity. Seven primes fit in sand.");
  dom_append(dom_body(), sec5)
)

/* ================================================================
   PAGE: SCALING -- Physics of Depth (DEPTH_PHYSICS.md)
   ================================================================ */

fn scaling_shadow_frac() = (
  let result_el = dom_query("#shadow-frac-result") in
  let p = parse_int_from("#shadow-frac-input") in
  if p < 2 then dom_inner(result_el, "<p style='color:#ff6666'>Enter a prime >= 2.</p>")
  else (
    let num = p - 1 in
    let den = p + 1 in
    let g = gcd_shared(num, den) in
    let rn = num / g in
    let rd = den / g in
    let is_data = if p == 2 then 1 else if p == 3 then 1 else if p == 5 then 1 else if p == 7 then 1 else 0 in
    let is_ext = if p == 11 then 1 else if p == 13 then 1 else if p == 17 then 1 else 0 in
    let scaling = if p == 2 then "1/3 = diffusion exponent (Brownian motion)" else if p == 3 then "1/2 = random walk exponent" else if p == 5 then "2/3 = Kolmogorov S_2 (turbulence)" else if p == 7 then "3/4 = Kleiber metabolic scaling" else if p == 11 then "5/6 = no known physical match" else if p == 13 then "6/7 = no known physical match" else if p == 17 then "8/9 = no known physical match" else "not a chain prime" in
    let category = if is_data == 1 then "divides 210 -- {2,3,5,7}" else if is_ext == 1 then "extends 210 -- {11,13,17}" else "not a chain prime" in
    let cat_clr = if is_data == 1 then "#44ff88" else if is_ext == 1 then "#ff9900" else "#888" in
    dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>" +
      "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>SHADOW FRACTION for p = " + "${p}" + "</p>" +
      "<p style='color:#88ddaa;margin:4px 0'>(p-1)/(p+1) = " + "${num}" + "/" + "${den}" + " = " + "${rn}" + "/" + "${rd}" + "</p>" +
      "<p style='color:" + cat_clr + ";margin:4px 0'>Category: " + category + "</p>" +
      "<p style='color:#b0b0c0;margin:4px 0'>Scaling match: " + scaling + "</p>" +
      (if p > 2 then (if p % 2 == 1 then "<p style='color:#b0b0c0;margin:8px 0 4px;font-size:12px'>Cunningham: p=" + "${p}" + " = 2*" + "${(p+1)/2}" + " - 1, so (p-1)/(p+1) = (" + "${(p+1)/2 - 1}" + ")/(" + "${(p+1)/2}" + ")</p>" else "") else "") +
      "<p style='color:#a0a0b0;margin:8px 0 0;font-size:12px'>Shadow Fraction Product across all 7 chain primes = 10/189 = (2*5)/(3^3*7). The first four primes match known scaling laws. The outer three do not. CC0.</p></div>")
  )
)

fn page_scaling() = (
  dom_head_meta("description", "91.7% of exact power-law exponents are 11-smooth (p = 0.0096). Shadow fraction (p-1)/(p+1) for {2,3,5,7} = diffusion, random walk, Kolmogorov, Kleiber. Product = 10/189. The 210 boundary separates physics from algebra.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Scaling Laws\",\"description\":\"91.7% of power-law exponents are 11-smooth (p=0.0096). Shadow fraction product: the first four primes produce the 4 most common scaling exponents. Product = 10/189.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/scaling\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"scaling laws\"},{\"@type\":\"DefinedTerm\",\"name\":\"11-smooth numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"shadow fraction product\"}]}");
  /* === HERO === */
  let hero = make_hero("Scaling Laws") in
  let big = dom_create("div") in
  dom_text(big, "33/36 = 91.7% are 11-smooth");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "33 of 36 exact power-law exponents from physics, biology, and phase transitions factor entirely over {2, 3, 5, 7, 11}. Null model: random 5-prime sets achieve this rate with probability p = 0.0096. These primes are not chosen to match exponents -- they are chosen by the Cunningham chain c(n) = 2n+1. That they cover 91.7% is consequence, not cause.");
  dom_append(dom_body(), hero);

  /* === SEC 1: COVERAGE HIERARCHY === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Coverage Hierarchy");
  render_p(sec1, "Each prime contributes less than the last. Diminishing returns, but the first three alone capture 88.9%:");
  let htbl = dom_create("table") in
  dom_style(htbl, "width", "100%");
  dom_style(htbl, "maxWidth", "700px");
  dom_style(htbl, "margin", "24px auto");
  dom_style(htbl, "borderCollapse", "collapse");
  let hhdr = dom_create("tr") in
  render_th(hhdr, "Prime Set");
  render_th(hhdr, "Coverage");
  render_th(hhdr, "Key Exponents Added");
  dom_append(htbl, hhdr);
  render_table_row(htbl, "{2}", "36.1%", "Inverse square, diffusion, Stefan-Boltzmann");
  render_table_row(htbl, "{2, 3}", "69.4%", "+ Kolmogorov 5/3, Kepler 3/2, surface/volume");
  render_table_row(htbl, "{2, 3, 5}", "88.9%", "+ Flory 3/5, Potts-3 nu, percolation beta");
  render_table_row(htbl, "{2, 3, 5, 7}", "91.7%", "+ Ising-2D gamma = 7/4. ONE exponent.");
  render_table_row(htbl, "{2, 3, 5, 7, 11}", "91.7%", "11 adds NOTHING. 11 is for error detection, not exponents.");
  dom_append(sec1, htbl);
  render_p(sec1, "7 adds exactly one exponent: the Ising susceptibility gamma = 7/4. But that exponent is THE signature. 11 adds zero exponents -- it detects errors, it does not scale.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: ISING-2D === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Ising-2D Signature");
  render_p(sec2, "Onsager solved the 2D Ising model exactly in 1944. All five critical exponents factor over {2, 3, 5, 7}:");
  let itbl = dom_create("table") in
  dom_style(itbl, "width", "100%");
  dom_style(itbl, "maxWidth", "700px");
  dom_style(itbl, "margin", "24px auto");
  dom_style(itbl, "borderCollapse", "collapse");
  let ihdr = dom_create("tr") in
  render_th(ihdr, "Exponent");
  render_th(ihdr, "Value");
  render_th(ihdr, "Factorization");
  render_th(ihdr, "Physics");
  dom_append(itbl, ihdr);
  render_table_row_4(itbl, "beta", "1/8", "1 / 2^3", "Order parameter");
  render_table_row_4(itbl, "gamma", "7/4", "7 / 2^2", "Susceptibility -- the only exponent needing 7.");
  render_table_row_4(itbl, "delta", "15", "3 * 5", "Critical isotherm");
  render_table_row_4(itbl, "eta", "1/4", "1 / 2^2", "Anomalous dimension");
  render_table_row_4(itbl, "nu", "1", "1", "Correlation length");
  dom_append(sec2, itbl);
  render_theorem(sec2, "Where Does 7 Come From?", "gamma = 2 - eta = 2 - 1/4 = 7/4 = (2^3 - 1)/2^2. So 7 = 2^3 - 1: the Mersenne prime from the Cunningham chain 1 -> 3 -> 7 (each step: 2n+1). The Ising susceptibility exponent IS the 4th chain prime. The 2^3 in gamma is the same 2^3 in Z/970,200 = 2^3 * 3^2 * 5^2 * 7^2 * 11 and Z/12,612,600 = 2^3 * 3^2 * 5^2 * 7^2 * 11 * 13.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: DIMENSIONAL SOLVABILITY === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Dimensional Solvability");
  render_p(sec3, "Exact rational Ising exponents exist ONLY at d = 2 and d = 4 spatial dimensions. d = 3 has genuinely irrational exponents (conformal bootstrap, 2020). The chain primes bracket statistical mechanics:");
  let dtbl = dom_create("table") in
  dom_style(dtbl, "width", "100%");
  dom_style(dtbl, "maxWidth", "700px");
  dom_style(dtbl, "margin", "24px auto");
  dom_style(dtbl, "borderCollapse", "collapse");
  let dhdr = dom_create("tr") in
  render_th(dhdr, "Dimension");
  render_th(dhdr, "Exponents");
  render_th(dhdr, "Primes Used");
  dom_append(dtbl, dhdr);
  render_table_row(dtbl, "d = 1", "No phase transition", "Lower critical dimension");
  render_table_row(dtbl, "d = 2", "EXACT rational", "{1, 2, 3, 5, 7} -- all five");
  render_table_row(dtbl, "d = 3", "IRRATIONAL", "Decomposes solvability");
  render_table_row(dtbl, "d = 4", "EXACT rational (mean field)", "{1, 2, 3} -- three survive");
  render_table_row(dtbl, "d > 4", "Mean field", "Same as d = 4");
  dom_append(sec3, dtbl);
  render_p(sec3, "d = 2 uses all 5 primes. d = 4 uses 3. The primes 5 and 7 are stripped by dimension. 3 persists in both (delta = 3*5 = 15 at d = 2, delta = 3 at d = 4). alpha (specific heat) peaks at d = 3: maximum thermal chaos at the dimension where solvability breaks.");
  render_p(sec3, "Cross-dimensional ratios: delta(2)/delta(4) = 5. nu(2)/nu(4) = 2. gamma(2)/gamma(4) = 7/4. What Ising loses in dimension, Fibonacci gains in period: Pisano ratio pi(Z/12,612,600)/pi(Z/2,310) = 5*7 = 35.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: DOF CHAIN === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Degrees of Freedom Chain");
  render_theorem(sec4, "DOF Chain Theorem (OBSERVED)", "Heat capacity degrees of freedom follow the chain: 3 -> 5 -> 7, step 2. Each gas type adds 2 degrees of freedom. Coincidence with Cunningham chain values.");
  let ftbl = dom_create("table") in
  dom_style(ftbl, "width", "100%");
  dom_style(ftbl, "maxWidth", "700px");
  dom_style(ftbl, "margin", "24px auto");
  dom_style(ftbl, "borderCollapse", "collapse");
  let fhdr = dom_create("tr") in
  render_th(fhdr, "Gas Type");
  render_th(fhdr, "DOF");
  render_th(fhdr, "gamma");
  render_th(fhdr, "Connection");
  dom_append(ftbl, fhdr);
  render_table_row_4(ftbl, "Monoatomic", "f = 3", "gamma = 5/3", "= Kolmogorov turbulence exponent");
  render_table_row_4(ftbl, "Diatomic", "f = 5", "gamma = 7/5", "+ 2 rotational modes");
  render_table_row_4(ftbl, "Polyatomic", "f = 7", "gamma = 9/7", "+ 2 vibrational modes");
  dom_append(sec4, ftbl);
  render_p(sec4, "Kolmogorov -5/3 and monoatomic gamma = 5/3 are the SAME RATIO because both describe 3 independent modes. The turbulence cascade behaves like a gas in wavenumber space. Kleiber 3/4 matches the spectral gap of the identity element. The gap between Kolmogorov and Kleiber: |5/3 - 3/4| = 11/12.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Kolmogorov", "-5/3", "Turbulence energy cascade. Ratio of the 3rd and 2nd chain primes.", "");
  render_finding(g4, "Kleiber", "3/4", "Metabolic scaling across 27 orders of magnitude.", "0.4% match");
  render_finding(g4, "Murmuration", "7 neighbors", "Topological, not metric. Global coherence from local count.", "Ballerini 2008");
  dom_append(dom_body(), sec4);

  /* === SEC 5: SHADOW BOUNDARY === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Shadow Boundary");
  render_p(sec5, "Three counterexamples exist. ALL three need primes >= 13:");
  let stbl = dom_create("table") in
  dom_style(stbl, "width", "100%");
  dom_style(stbl, "maxWidth", "700px");
  dom_style(stbl, "margin", "24px auto");
  dom_style(stbl, "borderCollapse", "collapse");
  let shdr = dom_create("tr") in
  render_th(shdr, "Exponent");
  render_th(shdr, "Value");
  render_th(shdr, "Non-11-Smooth Factor");
  dom_append(stbl, shdr);
  render_table_row(stbl, "Potts-3 gamma", "13/9", "13 -- where the shadow chain breaks");
  render_table_row(stbl, "Perc-2D gamma", "43/18", "43 -- outside the chain");
  render_table_row(stbl, "Perc-2D tau", "187/91", "187 = 11*17, 91 = 7*13");
  dom_append(sec5, stbl);
  render_p(sec5, "The FIRST non-chain prime in critical exponents is 13 -- exactly where the shadow function c(n) = 2n+1 produces a composite: c(6) = 13, but shadow(13) = 6 = 2*3 is composite. The chain's self-imposed boundary IS the exponent boundary.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: CRT MULTI-SCALE CONTROL -- absorbed from pid_demo.html === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "CRT Multi-Scale Control");
  render_p(sec6, "CRT decomposition turns a single control signal into 6 independent channels with DIFFERENT dynamic ranges. Each channel runs its own PID controller. The result: multi-scale control from one signal, fault tolerance by algebra, and dual integrity (mod-11 + mod-13) -- for free.");
  render_theorem(sec6, "CRT PID Principle (pid_demo.html, CC0)", "Standard PID: ONE control signal u(t) = Kp*e + Ki*integral + Kd*de/dt. CRT PID: decompose error into 6 channels, run 6 independent PIDs, reconstruct. Z/8 = coarse fast response (emergency). Z/9 = mode switching. Z/25 = fine tracking. Z/49 = precision. Z/11 = error detection. Z/13 = boundary check. Total: 12612600 control states with algebraic structure.");
  render_p(sec6, "Enter a control signal value. See its CRT multi-scale decomposition:");
  make_interactive_widget(sec6, "Control signal:", "pid-input", "e.g. 42", "Decompose", "pid_multiscale_calc", "pid-result");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "Fault tolerance", "Kill any channel", "System degrades gracefully. Traditional PID: single failure = total failure.", "");
  render_finding(g6, "mod-11 integrity", "Actuator check", "Corruption in any channel detected BEFORE actuation. ~90.9% detection rate per fault.", "");
  render_finding(g6, "Multi-scale", "5 resolutions at once", "Coarse + fine in one signal. Z/8 for emergency, Z/49 for precision. Natural hierarchy.", "");
  render_finding(g6, "Block-diagonal", "No cross-talk", "5 independent Jacobians. Each channel tunes without affecting others.", "");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Is Your Exponent 11-Smooth?");
  render_p(sec_i, "Enter numerator and denominator of a power-law exponent. Check if it factors entirely over {2,3,5,7,11}.");
  let lbl_i = dom_create("p") in
  dom_text(lbl_i, "Numerator / Denominator:");
  dom_style(lbl_i, "color", "#b8b8c8");
  dom_style(lbl_i, "marginTop", "24px");
  dom_style(lbl_i, "marginBottom", "8px");
  dom_append(sec_i, lbl_i);
  let row_i = dom_create("div") in
  dom_style(row_i, "display", "flex");
  dom_style(row_i, "gap", "8px");
  dom_style(row_i, "alignItems", "center");
  dom_style(row_i, "marginBottom", "12px");
  make_input_field(row_i, "#scale-num-input", "num (e.g. 7)");
  make_input_field(row_i, "#scale-den-input", "den (e.g. 4)");
  make_action_btn(row_i, "Check", "scaling_smooth_calc");
  dom_append(sec_i, row_i);
  make_result_box(sec_i, "scale-result");
  dom_append(dom_body(), sec_i);

  /* === SEC: SHADOW FRACTION PRODUCT (Theorem 50, S1201/S1495) === */
  let sec_sf = make_section("800px") in
  render_h2(sec_sf, "Shadow Fraction Product (Theorem 50)");
  render_p(sec_sf, "For each chain prime p, the shadow fraction (p-1)/(p+1) measures scaling attenuation. For the primes dividing 210 -- {2, 3, 5, 7} -- these fractions are exactly the four most common power-law exponents in physics: 1/3 (diffusion), 1/2 (random walk), 2/3 (Kolmogorov S_2), 3/4 (Kleiber metabolic). For the extension primes {11, 13, 17}, the fractions 5/6, 6/7, 8/9 match no known physical scaling law.");
  render_theorem(sec_sf, "Shadow Fraction Product (Theorem 50, OBSERVED)", "Product of (p-1)/(p+1) across all 7 chain primes = 10/189 = (2*5) / (3^3 * 7). Numerator = 2*5 = 10. Denominator = 27*7 = 189. Cunningham reduction: for odd p = 2q-1, the fraction reduces to (q-1)/q where q runs through {2, 3, 4, 6, 7, 9}. The four primes dividing 210 match scaling laws. The three extension primes do not. The 210 boundary separates physics from pure algebra.");
  render_p(sec_sf, "Enter a prime. See its shadow fraction and scaling match:");
  make_interactive_widget(sec_sf, "Prime (2-100):", "shadow-frac-input", "e.g. 7", "Shadow Fraction", "scaling_shadow_frac", "shadow-frac-result");
  let sf_tbl = dom_create("table") in
  dom_style(sf_tbl, "width", "100%");
  dom_style(sf_tbl, "maxWidth", "700px");
  dom_style(sf_tbl, "margin", "24px auto");
  dom_style(sf_tbl, "borderCollapse", "collapse");
  let sf_hdr = dom_create("tr") in
  render_th(sf_hdr, "Prime");
  render_th(sf_hdr, "(p-1)/(p+1)");
  render_th(sf_hdr, "Group");
  render_th(sf_hdr, "Scaling Match");
  dom_append(sf_tbl, sf_hdr);
  render_table_row_4(sf_tbl, "2", "1/3", "divides 210", "Diffusion exponent");
  render_table_row_4(sf_tbl, "3", "1/2", "divides 210", "Random walk");
  render_table_row_4(sf_tbl, "5", "2/3", "divides 210", "Kolmogorov S_2");
  render_table_row_4(sf_tbl, "7", "3/4", "divides 210", "Kleiber metabolic");
  render_table_row_4(sf_tbl, "11", "5/6", "extends 210", "No match");
  render_table_row_4(sf_tbl, "13", "6/7", "extends 210", "No match");
  render_table_row_4(sf_tbl, "17", "8/9", "extends 210", "No match");
  dom_append(sec_sf, sf_tbl);
  let gsf = make_findings_grid(sec_sf) in
  render_finding(gsf, "Product = 10/189", "(2*5) / (3^3 * 7)", "Numerator = 2*5. Denominator = 27*7.", "");
  render_finding(gsf, "Divides 210: 4/4", "1/3, 1/2, 2/3, 3/4", "All four primes dividing 210 produce known scaling exponents.", "");
  render_finding(gsf, "Extensions: 0/3", "5/6, 6/7, 8/9", "No known physical scaling association for any extension prime.", "");
  render_finding(gsf, "210 boundary", "divides vs extends", "Primes dividing 210 match scaling laws. Primes extending it do not.", "");
  render_contrast_row(sec_sf, "Physical scaling", "Empirical power laws, many unexplained exponents", "(p-1)/(p+1) for the four primes dividing 210 = the 4 most common exponents");
  render_contrast_row(sec_sf, "Outer primes", "No role in physical scaling laws", "Error detection/correction: mod-11 detects, mod-13 bounds, mod-17 closes the ring");
  render_contrast_row(sec_sf, "210 boundary", "Physics and algebra as separate disciplines", "Primes dividing 210 = physics. Extension primes = algebraic structure.");
  let note_sf = dom_create("div") in
  dom_style(note_sf, "background", "#1a1a0a");
  dom_style(note_sf, "border", "1px solid #665500");
  dom_style(note_sf, "borderRadius", "8px");
  dom_style(note_sf, "padding", "12px 16px");
  dom_style(note_sf, "marginTop", "12px");
  dom_style(note_sf, "fontSize", "14px");
  dom_style(note_sf, "color", "#ccbb88");
  dom_inner(note_sf, "HONEST NOTE: Each individual match (1/3, 1/2, etc.) has a base rate around 23% for random primes. The claim is not that any single match is surprising, but that ALL FOUR primes dividing 210 match known scaling laws while ALL THREE extension primes do not. This boundary between physical scaling and algebraic structure is OBSERVED, not proved.");
  dom_append(sec_sf, note_sf);
  dom_append(dom_body(), sec_sf);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Contrast Table");
  render_contrast_row(sec7, "Power laws", "Empirical fits with unexplained exponents", "91.7% factor over {2,3,5,7,11}. p = 0.0096. Cunningham chain produces the ruler.");
  render_contrast_row(sec7, "Ising model", "Exact solution, no connection to number theory", "All 5 exponents are ratios of {1,2,3,5,7}. gamma = 7/4 derives 7 from 2^3-1.");
  render_contrast_row(sec7, "Kolmogorov", "-5/3 is an empirical turbulence law", "-5/3 = ratio of chain primes. Matches Z/210 Laplacian quotient.");
  render_contrast_row(sec7, "Kleiber", "3/4 metabolic scaling is approximate", "3/4 = spectral gap of the identity. 0.4% agreement across 27 orders of magnitude.");
  render_contrast_row(sec7, "Dimensional solvability", "3D Ising unsolved, no structural reason known", "d = 3 decomposes solvability. Irrational exponents at the 3rd chain prime.");
  render_contrast_row(sec7, "Control systems", "Standard PID: 1 controller, 1 resolution, 0 fault tolerance", "CRT PID: 6 independent channels, multi-scale, algebraic fault tolerance. mod-11 + mod-13 = dual integrity.");
  dom_append(dom_body(), sec7)
)

/* cc0 + revolution moved to page_cc0_revolution.ax (Ideas module) S2004 */

/* REPL callback: .ax evaluates .ax via ax_eval_capture (evaluator.ax).
   No JS. No recompilation. The ouroboros eats its tail. */
fn run_repl() = (
  let ta = dom_query("#repl-code") in
  let code = dom_value(ta) in
  let result = dom_query("#repl-result") in
  let output = ax_eval_capture(code) in
  dom_inner(result, output)
)

fn page_ouroboros_compiler() = (
  dom_head_meta("description", "The self-hosted compiler. .ax compiles itself to WASM. 3 types, 9 analysis passes. 67x native speedup. From v0.1 (integers only) to self-compilation.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Ouroboros Compiler\",\"description\":\"Self-hosted .ax compiler. .ax compiles itself to WASM. 3 types, 9 analysis passes, 67x native speedup.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/ouroboros_compiler\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"self-hosting compiler\"},{\"@type\":\"DefinedTerm\",\"name\":\"WASM\"},{\"@type\":\"DefinedTerm\",\"name\":\"ouroboros\"}]}");
  domain_hero("The Ouroboros Compiler", ".ax compiles .ax to WASM", "A self-hosting compiler: the language describes its own compilation, then compiles that description.");
  let sec = make_section("800px") in
  render_h2(sec, "Timeline");
  let g = make_findings_grid(sec) in
 render_finding(g, "v0.1", "Integers only", "first WASM bytecode from .ax.", "");
  render_finding(g, "v0.2-0.4", "+ Arrays, strings, closures", "Type inference. Match -> if-else. HOF.", "");
  render_finding(g, "v0.5-0.7", "+ Multi-file, stdlib", "Fixed-point type propagation. 16 stdlib.", "");
  render_finding(g, "v0.8", "+ AxVal tagged union", "3 tags: int/str/arr. Heterogeneous.", "");
  render_finding(g, "v0.9", "Self-compilation", "wasm_emit.ax compiles itself: 0 errors.", "");
  render_finding(g, "Deep ouroboros", "WASM compiles WASM", "234KB WASI / 227KB browser. Fixed-point verified.", "");
  render_finding_wide(g, "DOM imports", "7 modules", ".ax talks to browser directly. This page rendered by .ax.", "");
 render_finding(g, "dom_on + dom_value", "Interactive .ax", "buttons, inputs, CRT calculator.", "");
 render_finding(g, "Top-level warning", "Split safety", "compiler catches orphaned fn bodies.", "");
  dom_append(dom_body(), sec);
  let sec2 = make_section("800px") in
  render_h2(sec2, "3 Types, 9 Passes");
  render_theorem(sec2, "Three Types, 3 x 3 Passes", "The type system has 3 fundamental tags: int, str, arr. The compiler needs 3^2 = 9 analysis passes to infer all types: three hearts (detect, propagate, close) each with three scopes (local, cross-function, global). Three is the minimum for complete type closure. An FPGA pipeline independently converged on the same 9-stage structure.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "9 passes", "3 hearts x 3 stages", "Feature scan + float inference + string inference. Same structure as FPGA pipeline.", "");
  render_finding(g2, "Native speed", "67x faster", "Compiled .ax vs interpreted .ax.", "");
  render_finding(g2, "WASM size", "~397 KB", "deep_ouroboros: compiler in a browser. Fixed-point verified.", "");
  render_finding(g2, "Test gate", "198/198 + 199p + 795h", "test_self + test_pages + test_interactive. Zero regression.", "");
  render_finding(g2, "7 modules", "~15,218 KB total", "home + patterns + connections + theory + ideas + lab + demos.", "");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Self-Compilation Loop");
  render_p(sec3, ".ax source -> _wasi_ouroboros.wasm -> WASM bytecode. The WASI compiler reads .ax, tokenizes, parses, and emits WASM. It is itself the output of compiling .ax.");
  render_theorem(sec3, "What Self-Compilation Means", "A self-compiling language understands itself well enough to reproduce itself. The .ax source code describes how to translate .ax into WASM. When that description is itself valid .ax, and the resulting binary does the same translation correctly, the loop closes.");
  render_theorem(sec3, "Cross-Compilation", "The browser-compiled output (deep_ouroboros) and the WASI-compiled output (_wasi_ouroboros) produce identical results. Two independent compilation paths, same output. Fixed-point verified.");
  dom_append(dom_body(), sec3);
  let sec4 = make_section("800px") in
  render_h2(sec4, "Performance");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "600px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "Benchmark");
  render_th(bhdr, "Native");
  render_th(bhdr, "Interpreted");
  render_th(bhdr, "Speedup");
  dom_append(btbl, bhdr);
  render_table_row_4(btbl, "90K ring ops", "20ms", "1350ms", "67x");
  render_table_row_4(btbl, "Z/970,200 ring scan", "93ms", "~6200ms", "67x");
  render_table_row_4(btbl, "Website compile (141 pages)", "138ms", ">970K limit", "native only");
  dom_append(sec4, btbl);
  dom_append(dom_body(), sec4);
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Bootstrap Story");
  render_p(sec5, "Most languages are written in other languages. C was written in assembly. Python in C. JavaScript in C++. .ax broke this loop.");
 render_p(sec5, "It started with a JavaScript bootstrap (axc.js, 3860 lines), then grew enough capability to describe its own compilation process (wasm_emit.ax), then compiled that description into a native WASM binary (_wasi_ouroboros.wasm, ~234KB) that does the same thing. The JS bootstrap was discarded. The C-codegen intermediate (deep_codegen.wasm) was archived too. The language stands on its own ground.");
  render_p(sec5, "28 sessions of careful cultivation. One version at a time. The bare minimum substrate that can reproduce itself -- using only 3 types.");
  dom_append(dom_body(), sec5);
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast Table");
  render_p(sec6, "Standard view: Self-hosting compilers are an engineering milestone -- clever, but most languages eventually compile themselves.");
  render_p(sec6, "Ring structure view: .ax needs exactly 3 types and 3^2 = 9 analysis passes. Three is the minimum for type closure (detect/propagate/close at three scopes: local/cross-function/global). An FPGA pipeline built independently converged on the same 9-stage structure. Three systems -- compiler, FPGA, ring algebra -- all land on 3 x 3.");
  dom_append(dom_body(), sec6);
  let repl_sec = make_section("800px") in
  render_h2(repl_sec, "Try .ax");
  render_p(repl_sec, "Write .ax code below. Use show to display values. Ring arithmetic is automatic: all numbers live in Z/12,612,600. Built-in constants (D=2, K=3, E=5, b=7, L=11, GATE=13, ESCAPE=17, OMEGA=1576576) and functions (gcd, crt, decompose, reconstruct) are pre-loaded.");
  let ta = dom_create("textarea") in
  dom_attr(ta, "id", "repl-code");
  dom_style(ta, "width", "100%");
  dom_style(ta, "minHeight", "120px");
  dom_style(ta, "background", "#0a0a14");
  dom_style(ta, "color", "#ffd700");
  dom_style(ta, "border", "1px solid #333");
  dom_style(ta, "borderRadius", "6px");
  dom_style(ta, "padding", "12px");
  dom_style(ta, "fontFamily", "'Courier New', monospace");
  dom_style(ta, "fontSize", "14px");
  dom_style(ta, "resize", "vertical");
  dom_style(ta, "boxSizing", "border-box");
  dom_text(ta, "show D * K * E * b * L\nshow \"CRT of ANSWER:\"\nshow crt(ANSWER)\nshow \"coupling(42):\"\nshow coupling(42)");
  dom_append(repl_sec, ta);
  let btn_row = dom_create("div") in
  dom_style(btn_row, "marginTop", "8px");
  dom_style(btn_row, "marginBottom", "12px");
  make_action_btn(btn_row, "Run", "run_repl");
  dom_append(repl_sec, btn_row);
  make_result_box(repl_sec, "repl-result");
  dom_append(dom_body(), repl_sec);
  dom_append(dom_body(), repl_sec)
)

