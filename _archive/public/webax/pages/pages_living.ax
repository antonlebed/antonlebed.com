  render_finding(g7l, "Layer 3.4x", "attention+FFN", "Attention QK monolithic + V,FFN block-diagonal. 174240/51174 per layer.", "");
  render_finding(g7l, "CRT-GPT-1", "~25M params", "12-layer, d=448, 7 channels. vs 117M standard GPT-1. 4.7x compression.", "");
