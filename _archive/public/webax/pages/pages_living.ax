  render_table_row_4(ctbl, "Z/49", "49 classes", "Precise (49 states)", "Deepest channel, controls spectral gap");
  render_table_row_4(ctbl, "Z/11", "11 classes", "Parity", "Error detection. Always on. 1+2+3+5 = 11");
  render_table_row_4(ctbl, "Z/13", "13 classes", "Boundary", "Dual parity with mod-11. 2^2+3^2 = 13");
  render_table_row_4(ctbl, "Z/17", "17 classes", "Transcendence", "5*7 = 1 mod 17. Period quadruples to 1680");
  dom_append(sec1, ctbl);
  render_p(sec1, "Full ring output: 8+9+25+49+11+13+17 = 132 classes. Experiments at Z/970,200 (5 channels, 102 classes): 9512x compression. The backprop Jacobian is block-diagonal: 25654x fewer entries at N=2310.");
  dom_append(dom_body(), sec1);

