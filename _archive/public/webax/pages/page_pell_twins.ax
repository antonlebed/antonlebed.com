/* Integer square root via Newton */
fn isqrt(n) = (
  if n < 2 then n
  else (
    mut z = n / 2 + 1;
    mut z2 = (z + n / z) / 2;
    while z2 < z do (
      mut z = z2;
      mut z2 = (z + n / z) / 2
    );
    z
  )
)

/* Pell solution finder callback */
fn pell_find() = (
  let d = parse_int_from("#pl-input") in
  let result = dom_query("#pl-result") in
  /* Check d is not a perfect square */
  let sd = isqrt(d) in
  if d < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter d >= 2 (non-square).</p>")
  else if sd * sd == d then dom_inner(result, "<p style='color:#ff6666'>" + "${d}" + " is a perfect square (sqrt = " + "${sd}" + "). Pell has no solution.</p>")
  else (
    /* Brute force: try y from 1 to 50 */
    mut found_x = 0;
    mut found_y = 0;
    mut y = 1;
    while y < 51 do (
      let v = d * y * y + 1 in
      let sv = isqrt(v) in
      if sv * sv == v then (
        if found_x == 0 then (
          mut found_x = sv;
          mut found_y = y
        ) else 0
      ) else 0;
      mut y = y + 1
    );
    if found_x == 0 then dom_inner(result, "<p style='color:#b8b8c8'>No solution found for y <= 50. Fundamental solution may require larger search.</p>")
    else (
      let check = found_x * found_x - d * found_y * found_y in
      let xn = if found_x == 2 then " (prime)"
        else if found_x == 3 then " (prime)"
        else if found_x == 8 then " (= 2^3)"
        else if found_x == 9 then " (= 3^2)"
        else if found_x == 10 then " (= 2*5)"
        else "" in
      let yn = if found_y == 1 then ""
        else if found_y == 2 then " (prime)"
        else if found_y == 3 then " (prime)"
        else if found_y == 4 then " (= 2^2)"
        else "" in
      dom_inner(result,
        "<p style='color:#88ddaa;margin:4px 0'><b>x = " + "${found_x}" + "</b>" + xn + ", <b>y = " + "${found_y}" + "</b>" + yn + "</p>" +
        "<p style='color:#ffd700;margin:4px 0'>" + "${found_x}" + "^2 - " + "${d}" + "*" + "${found_y}" + "^2 = " + "${check}" + "</p>")
    )
  )
)

fn page_pell_twins() = (
  dom_head_meta("description", "7 and 11 are Pell twins: both solve x^2 - py^2 = 1 with y = 3. All five chain primes {2,3,5,7,11} solve Pell with 11-smooth coordinates. Sum(x) = 32. Sum(y) = 13.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Pell Twins\",\"description\":\"7 and 11 are Pell twins, both solving x^2-py^2=1 with y=3. All five chain primes have 11-smooth Pell coordinates.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/pell_twins\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Pell equation\"},{\"@type\":\"DefinedTerm\",\"name\":\"twin primes\"},{\"@type\":\"DefinedTerm\",\"name\":\"continued fractions\"}]}");
  /* === HERO === */
  let hero = make_hero("The Pell Twins") in
  let big = dom_create("div") in
  dom_text(big, "7 = 9 - 2     11 = 9 + 2");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Two chain primes frame 3^2 = 9 from below and above. Both solve the Pell equation x^2 - p*y^2 = 1 with the same fundamental y = 3. Separated by 4 = 2*2, centered on the chain's stop value 9. And all five chain primes {2, 3, 5, 7, 11} have 11-smooth Pell coordinates.");
  dom_append(dom_body(), hero);

  /* === SEC 1: TWIN CARDS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Twin Solutions");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "p = 7", "8^2 - 7*3^2 = 64 - 63 = 1", "x = 8 = 2^3. y = 3. Both coordinates are chain primes or prime powers.", "");
  render_finding(g1, "p = 11", "10^2 - 11*3^2 = 100 - 99 = 1", "x = 10 = 2*5. y = 3. Again, both coordinates factor into chain primes.", "");
  render_p(sec1, "The x-values: 8 = 2^3 and 10 = 2*5. Their sum: 8 + 10 = 18 = 2*3^2 = 7 + 11 (the twin sum). Their product: 80 = 2^4*5.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: ALL FIVE PRIMES === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "All Five Chain Primes");
  render_p(sec2, "All five chain primes {2, 3, 5, 7, 11} have Pell solutions with 11-smooth coordinates:");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "Prime p");
  render_th(phdr, "x");
  render_th(phdr, "y");
  render_th(phdr, "Check");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "2", "3", "2", "9 - 2*4 = 1");
  render_table_row_4(ptbl, "3", "2", "1", "4 - 3*1 = 1");
  render_table_row_4(ptbl, "5", "9 = 3^2", "4 = 2^2", "81 - 5*16 = 1");
  render_table_row_4(ptbl, "7", "8 = 2^3", "3", "64 - 7*9 = 1");
  render_table_row_4(ptbl, "11", "10 = 2*5", "3", "100 - 11*9 = 1");
  dom_append(sec2, ptbl);
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Sum(x)", "3+2+9+8+10 = 32 = 2^5", "The number of idempotents in Z/970,200 (five prime factors -> 2^5).", "");
  render_finding(g2, "Sum(y)", "2+1+4+3+3 = 13", "= 2^2 + 3^2. Where the Cunningham chain stops.", "");
  render_finding(g2, "Sum(x-y)", "1+1+5+5+7 = 19 = 5^2-5-1", "= f(5), the polynomial evaluated at 5.", "");
  render_finding(g2, "Prod(x)/Prod(y)", "4320/72 = 60", "= 2^2*3*5. All coordinates are 11-smooth.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: QUADRATIC CHARACTER SPLIT === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Quadratic Character Split");
  render_p(sec3, "The Pell twins create a natural split. The Legendre symbol (p/7) separates the chain primes:");
  let qtbl = dom_create("table") in
  dom_style(qtbl, "width", "100%");
  dom_style(qtbl, "maxWidth", "700px");
  dom_style(qtbl, "margin", "24px auto");
  dom_style(qtbl, "borderCollapse", "collapse");
  let qhdr = dom_create("tr") in
  render_th(qhdr, "Prime");
  render_th(qhdr, "(p/7)");
  render_th(qhdr, "Class");
  render_th(qhdr, "Reason");
  dom_append(qtbl, qhdr);
  render_table_row_4(qtbl, "2", "+1", "Quadratic residue", "7 = 9 - 2 (Pell twin)");
  render_table_row_4(qtbl, "3", "-1", "Non-residue", "Not a Pell twin of 7");
  render_table_row_4(qtbl, "5", "-1", "Non-residue", "Not a Pell twin of 7");
  render_table_row_4(qtbl, "11", "+1", "Quadratic residue", "11 - 4 = 7 (Pell twin)");
  dom_append(sec3, qtbl);
  render_p(sec3, "The Pell twins {2, 11} are quadratic residues mod 7. The non-twins {3, 5} are non-residues. The Pell equation sorts the chain's primes into two families.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: CYCLOTOMIC CONNECTION === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Cyclotomic Connection");
  render_p(sec4, "Both twins arise as cyclotomic polynomials evaluated at 2:");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Polynomial");
  render_th(chdr, "Value");
  render_th(chdr, "Name");
  dom_append(ctbl, chdr);
  render_table_row(ctbl, "Phi_3(2) = 4+2+1", "7", "Eisenstein cyclotomic");
  render_table_row(ctbl, "Phi_4(2) = 4+1", "5", "Gaussian cyclotomic");
  render_table_row(ctbl, "Phi_10(2) = (2^5+1)/3", "11", "10th cyclotomic at 2");
  render_table_row(ctbl, "Phi_12(2) = 16-4+1", "13", "12th cyclotomic at 2");
  dom_append(sec4, ctbl);
  render_theorem(sec4, "Cyclotomic-Pell Bridge", "Phi_3(2) = 2^2+2+1 = 7. Rearranging: 2^6 = 7*3^2 + 1 = 64. The Pell equation 8^2 - 7*3^2 = 1 encodes the same algebraic identity as the cyclotomic evaluation. Twin cyclotomic indices: 3 and 10. Their sum = 13 = 2^2+3^2. Their product = 30 = 2*3*5.");
  dom_append(dom_body(), sec4);

  /* === INTERACTIVE: PELL SOLUTION FINDER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Pell Solution Finder");
  render_p(sec_i, "Enter a non-square number d. Find the fundamental solution to x^2 - d*y^2 = 1. For chain primes {2, 3, 5, 7, 11}, all solutions have 11-smooth coordinates. Sum(x) = 32. Sum(y) = 13.");
  make_interactive_widget(sec_i, "Find Pell solution for d:", "pl-input", "e.g. 7", "Find", "pell_find", "pl-result");
  render_p(sec_i, "Try: 2 (x=3,y=2), 3 (x=2,y=1), 5 (x=9,y=4), 7 (x=8,y=3), 11 (x=10,y=3). Also: 13, 23, 41.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast Table");
  render_contrast_row(sec5, "Pell equations", "Classical Diophantine equations. Solutions for different d values are unrelated.", "7 and 11 are twin Pell solutions sharing y = 3. All five chain primes solve Pell with 11-smooth (x,y). The sums are 32, 13, and 19.");
  render_contrast_row(sec5, "7 and 11", "Just two primes that happen to be 4 apart.", "Symmetric around 3^2 = 9 (the chain's stop). Same Pell y-coordinate. Same cyclotomic generation through 2.");
  render_contrast_row(sec5, "Quadratic residues mod 7", "Standard number theory classification.", "The Pell twins sort the chain into two families: {2, 11} (residues, framing 9 from below and above) vs {3, 5} (non-residues).");
  dom_append(dom_body(), sec5)
)
