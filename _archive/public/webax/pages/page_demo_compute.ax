/* page_demo_compute.ax -- Compute demo pages: pid, gpu_compute, scheduling, sort, cluster. Split from page_demos.ax. */

/* ring_mul and ring_mul_trans are in core.ax (included first). */

/* ================================================================
   CRT PID -- dedicated demo page /demos/pid. CC0 kill B15.
   7-channel multi-scale control loop over Z/214,414,200.
   ================================================================ */

fn demo_pid_run() = (
  let setpoint = parse_int_from("#dpid-input") in
  let result_el = dom_query("#dpid-result") in
  let mods = CRT_MODS_TRANS in
  let sp = setpoint % N_TRANS in
  let sp_ch = alloc(7) in
  mut ci = 0;
  while ci < 7 do (set(sp_ch, ci, sp % mods[ci]); mut ci = ci + 1);
  let pos = alloc(7) in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT PID CONTROL: setpoint = " + "${sp}" + " = (" + "${sp_ch[0]}" + "," + "${sp_ch[1]}" + "," + "${sp_ch[2]}" + "," + "${sp_ch[3]}" + "," + "${sp_ch[4]}" + "," + "${sp_ch[5]}" + "," + "${sp_ch[6]}" + ")</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Step</th>";
  mut ci = 0;
  while ci < 7 do (
    let is_data = if ci == 0 then 1 else if ci == 2 then 1 else if ci == 3 then 1 else 0 in
    let hcol = if is_data == 1 then "#ff6666" else "#44ff88" in
    mut html = html + "<th style='text-align:left;padding:4px;color:" + hcol + ";font-size:11px'>mod " + "${mods[ci]}" + "</th>";
    mut ci = ci + 1
  );
  mut html = html + "<th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Err</th></tr>";
  mut step = 0;
  while step < 12 do (
    mut total_err = 0;
    mut ci = 0;
    while ci < 7 do (
      let err_ch = (sp_ch[ci] + mods[ci] - pos[ci]) % mods[ci] in
      mut total_err = total_err + err_ch;
      set(pos, ci, (pos[ci] + (err_ch + 1) / 2) % mods[ci]);
      mut ci = ci + 1
    );
    let color = if total_err == 0 then "#44ff88" else "#b0b0c0" in
    mut html = html + "<tr><td style='padding:3px;color:#ffd700;font-size:12px'>" + "${step}" + "</td>";
    mut ci = 0;
    while ci < 7 do (
      mut html = html + "<td style='padding:3px;color:" + color + ";font-size:12px'>" + "${pos[ci]}" + "</td>";
      mut ci = ci + 1
    );
    mut html = html + "<td style='padding:3px;color:" + color + ";font-size:12px'>" + "${total_err}" + "</td></tr>";
    mut step = step + 1
  );
  dom_inner(result_el, html + "</table></div>")
)

fn page_pid() = (
  dom_head_meta("description", "CRT PID Controller. 7 independent control channels over Z/214,414,200. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT PID Controller\",\"description\":\"7-channel multi-scale PID control over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/pid\"}");
  let hero = make_hero("CRT PID Control") in
  let eq = dom_create("div") in
  dom_text(eq, "B15: Siemens/ABB. CC0.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "PID control decomposes into 7 independent channels. Each channel controls at its own scale: mod 8 = coarse, mod 49 = fine. Errors in one channel cannot destabilize others. CRT reconstruction gives the global control signal.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Multi-Scale Control", "A setpoint in Z/214,414,200 has 7 CRT residues. Each channel runs independent proportional control. mod 8 converges in 3 steps. mod 49 converges in 6 steps. The controller naturally separates fast/coarse from slow/fine -- no manual tuning.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 scales", "CRT decomposition", "mod 8 = coarse, mod 9 = medium, mod 25 = fine, mod 49 = precise, mod 11 = slow, mod 13 = auxiliary, mod 17 = detail.", "");
  render_finding(g1, "Independence", "Algebraic firewall", "Error in one channel cannot propagate to others.", "");
  render_finding(g1, "Auto-tuning", "Modulus = bandwidth", "Channel bandwidth = 1/modulus. No PID tuning needed.", "");
  render_finding(g1, "Convergence", "Per-channel guaranteed", "Each channel converges in O(log(modulus)) steps.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Setpoint (0-214414199):", "dpid-input", "e.g. 42", "Run Controller", "demo_pid_run", "dpid-result");
  render_p(sec2, "Watch 7 channels converge independently. mod 8 arrives first, mod 49 last.");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT PID vs Traditional");
  render_contrast_row(sec3, "Tuning", "PID: Kp, Ki, Kd manual tuning", "CRT: channel modulus IS the bandwidth");
  render_contrast_row(sec3, "Coupling", "Coupled: error in one axis affects all", "Independent: 7 algebraic firewalls");
  render_contrast_row(sec3, "Multi-scale", "Cascaded loops (complex)", "CRT channels = natural scale separation");
  render_contrast_row(sec3, "Convergence", "Heuristic (Ziegler-Nichols)", "Provable: O(log m) per channel");
  render_contrast_row(sec3, "Patent status", "Siemens/ABB process patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   CRT GPU COMPUTE -- dedicated demo page /demos/gpu_compute.
   7-channel parallel compute over Z/214,414,200. FPGA + WebGPU.
   ================================================================ */

fn demo_gpu_run() = (
  let data = parse_int_from("#dgpu-input") in
  let result_el = dom_query("#dgpu-result") in
  let mods = CRT_MODS_TRANS in
  let d = data % N_TRANS in
  let residues = alloc(7) in
  let squared = alloc(7) in
  mut ci = 0;
  while ci < 7 do (
    let r = d % mods[ci] in
    set(residues, ci, r);
    set(squared, ci, (r * r) % mods[ci]);
    mut ci = ci + 1
  );
  let recon = ring_recon_trans(squared[0], squared[1], squared[2], squared[3], squared[4], squared[5], squared[6]) in
  let direct = ring_mul_trans(d, d) in
  let ok = if recon == direct then 1 else 0 in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:12px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>7-CHANNEL PARALLEL COMPUTE: f(x) = x^2 mod 214,414,200</p><p style='color:#88ddaa;margin:4px 0'>Input: x = " + "${d}" + "</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>r</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>r^2</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Type</th></tr>";
  mut ci = 0;
  while ci < 7 do (
    let is_data = if ci == 0 then 1 else if ci == 2 then 1 else if ci == 3 then 1 else 0 in
    let color = if is_data == 1 then "#ff6666" else "#44ff88" in
    let tag = if is_data == 1 then "data" else "parity" in
    mut html = html + "<tr><td style='padding:3px;color:" + color + ";font-size:12px'>mod " + "${mods[ci]}" + "</td><td style='padding:3px;color:#88ddaa;font-size:12px'>" + "${residues[ci]}" + "</td><td style='padding:3px;color:#ffd700;font-size:12px'>" + "${squared[ci]}" + "</td><td style='padding:3px;color:" + color + ";font-size:11px'>" + tag + "</td></tr>";
    mut ci = ci + 1
  );
  mut html = html + "</table><p style='color:#ffd700;margin:12px 0 4px'>CRT RECONSTRUCTION</p><p style='color:#88ddaa;margin:4px 0'>Parallel (7 channels + CRT): " + "${recon}" + "</p><p style='color:#b0b0c0;margin:4px 0'>Verified (direct): " + "${direct}" + "</p><p style='color:" + (if ok == 1 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>" + (if ok == 1 then "MATCH -- 7 independent computations, 1 correct answer" else "MISMATCH -- bug") + "</p></div>";
  dom_inner(result_el, html)
)

fn demo_gpu_batch() = (
  let result_el = dom_query("#dgpu-batch") in
  let ok_count = [0] in
  let i = [0] in
  while i[0] < 1000 do (
    let d = (i[0] * 12637 + 41) % N_TRANS in
    let rd = d % 8 in let rk = d % 9 in let re = d % 25 in let rb = d % 49 in let rl = d % 11 in let rg = d % 13 in let r17 = d % 17 in
    let sd = (rd * rd) % 8 in let sk = (rk * rk) % 9 in let se = (re * re) % 25 in
    let sb = (rb * rb) % 49 in let sl = (rl * rl) % 11 in let sg = (rg * rg) % 13 in let s17 = (r17 * r17) % 17 in
    let recon = ring_recon_trans(sd, sk, se, sb, sl, sg, s17) in
    let direct = ring_mul_trans(d, d) in
    if recon == direct then set(ok_count, 0, ok_count[0] + 1) else 0;
    set(i, 0, i[0] + 1)
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH: 1000 values x f(x)=x^2 mod 214414200</p><p style='color:" + (if ok_count[0] == 1000 then "#44ff88" else "#ff4444") + ";font-size:18px;margin:4px 0'>" + "${ok_count[0]}" + "/1000 MATCH</p><p style='color:#b0b0c0;margin:4px 0'>Each value decomposed into 7 channels, squared independently, reconstructed via CRT. All 7 channels compute in parallel -- no cross-channel dependency.</p></div>")
)

fn gpu_bench_n() = (
  let v = parse_int_from("#gpu-count") in
  if v < 1000 then 1000 else if v > 250000000 then 250000000 else v
)
fn demo_gpu_bench_add() = gpu_bench(0, gpu_bench_n(), dom_query("#gpu-res-add"))
fn demo_gpu_bench_mul() = gpu_bench(1, gpu_bench_n(), dom_query("#gpu-res-mul"))
fn demo_gpu_bench_eig() = gpu_bench(2, gpu_bench_n(), dom_query("#gpu-res-eig"))
fn demo_gpu_bench_dec() = gpu_bench(3, gpu_bench_n(), dom_query("#gpu-res-dec"))
fn demo_gpu_bench_rtt() = gpu_bench(4, gpu_bench_n(), dom_query("#gpu-res-rtt"))
fn demo_gpu_bench_fwd() = gpu_bench(5, gpu_bench_n(), dom_query("#gpu-res-fwd"))
fn demo_gpu_bench_bwd() = gpu_bench(6, gpu_bench_n(), dom_query("#gpu-res-bwd"))
fn demo_gpu_bench_idem() = gpu_bench(7, gpu_bench_n(), dom_query("#gpu-res-idem"))
fn demo_gpu_bench_nil() = gpu_bench(8, gpu_bench_n(), dom_query("#gpu-res-nil"))
fn demo_gpu_bench_unit() = gpu_bench(9, gpu_bench_n(), dom_query("#gpu-res-unit"))
fn demo_gpu_bench_invol() = gpu_bench(10, gpu_bench_n(), dom_query("#gpu-res-invol"))
fn demo_gpu_bench_sq0() = gpu_bench(11, gpu_bench_n(), dom_query("#gpu-res-sq0"))
fn demo_gpu_bench_cube1() = gpu_bench(12, gpu_bench_n(), dom_query("#gpu-res-cube1"))
fn demo_gpu_bench_5th1() = gpu_bench(13, gpu_bench_n(), dom_query("#gpu-res-5th1"))
fn demo_gpu_bench_7th1() = gpu_bench(14, gpu_bench_n(), dom_query("#gpu-res-7th1"))

/* S2120: gpu_map demo -- user data through GPU kernel, results back to WASM. */
let _gm_buf = alloc(16)
let _gm_n = [0]

fn demo_gpu_map_run() = (
  let result_el = dom_query("#gm-result") in
  let n = 8 in
  let a = alloc(n) in
  let b = alloc(n) in
  mut i = 0;
  while i < n do (
    set(a, i, (i * 12637 + 41) % N_TRANS);
    set(b, i, (i * 7919 + 137) % N_TRANS);
    mut i = i + 1
  );
  set(_gm_n, 0, n);
  let ok = gpu_map(a, b, n, 1, _gm_buf) in
  if ok == 0 then
    dom_inner(result_el, "<p style='color:#ff6666'>No WebGPU -- gpu_map returns 0. CPU fallback needed.</p>")
  else
    dom_inner(result_el, "<p style='color:#ffd700'>GPU dispatch started...</p>")
)

fn on_gpu_map_done() = (
  let result_el = dom_query("#gm-result") in
  let n = _gm_n[0] in
  mut ok = 0;
  mut i = 0;
  while i < n do (
    let a_i = (i * 12637 + 41) % N_TRANS in
    let b_i = (i * 7919 + 137) % N_TRANS in
    if _gm_buf[i] == ring_mul_trans(a_i, b_i) then mut ok = ok + 1 else 0;
    mut i = i + 1
  );
  dom_inner(result_el, "<p style='color:" + (if ok == n then "#44ff88" else "#ff4444") + ";font-size:16px'>gpu_map: " + "${ok}" + "/" + "${n}" + " verified (CRT multiply via GPU, data returned to WASM)</p>")
)

/* Gradient Field: count NZP pairs per channel (exhaustive) */
fn gpu_nzp_pairs(m) = (
  mut count = 0;
  mut a = 1;
  while a < m do (
    mut bb = 1;
    while bb < m do (
      if (a * bb) % m == 0 then mut count = count + 1 else 0;
      mut bb = bb + 1
    );
    mut a = a + 1
  );
  count
)

fn demo_gpu_nzp() = (
  let result_el = dom_query("#gpu-nzp-result") in
  let mods = CRT_MODS_TRANS in
  let classes = ["pp", "pp", "pp", "pp", "prime", "prime", "prime"] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>GRADIENT FIELD CENSUS: NZP pairs per channel</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Type</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>NZP</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Field?</th></tr>";
  mut total_prime = 0;
  mut total_pp = 0;
  mut i = 0;
  while i < 7 do (
    let m = mods[i] in
    let nzp = gpu_nzp_pairs(m) in
    let is_field = if nzp == 0 then 1 else 0 in
    let color = if is_field == 1 then "#44ff88" else "#ff6666" in
    if i >= 4 then mut total_prime = total_prime + nzp
    else mut total_pp = total_pp + nzp;
    mut html = html + "<tr><td style='padding:3px;color:" + color + ";font-size:12px'>mod " + "${m}" + "</td><td style='padding:3px;color:#888;font-size:12px'>" + classes[i] + "</td><td style='padding:3px;color:" + color + ";font-size:12px'>" + "${nzp}" + "</td><td style='padding:3px;color:" + color + ";font-size:12px'>" + (if is_field == 1 then "YES" else "no") + "</td></tr>";
    mut i = i + 1
  );
  mut html = html + "</table><p style='color:#ffd700;margin:12px 0 4px'>TOTALS</p><p style='color:#44ff88;margin:4px 0'>Prime channels (mod 11, 13, 17): NZP = " + "${total_prime}" + " -- fields, zero gradient death</p><p style='color:#ff6666;margin:4px 0'>Prime-power channels (mod 8, 9, 25, 49): NZP = " + "${total_pp}" + " -- non-fields, gradient death via zero divisors</p><p style='color:#b0b0c0;margin:4px 0;font-size:12px'>Formula: Z/p (prime) NZP=0. Z/p^2 (odd) NZP=(p-1)^2. Z/2^3 NZP=5. Density decreases with modulus: mod 8=10.2%, mod 9=6.3%, mod 25=2.8%, mod 49=1.6%.</p></div>";
  dom_inner(result_el, html)
)

fn page_gpu_compute() = (
  dom_head_meta("description", "CRT GPU Compute. 15 operations over Z/214,414,200. FPGA-informed WebGPU. GPU ring census + power map + Gradient Field Theorem (prime=field, NZP=0). CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT GPU Compute\",\"description\":\"15-op parallel compute over Z/214,414,200. FPGA-measured, GPU-deployed. Ring census + power map + Gradient Field Theorem. CC0.\",\"about\":[\"CRT parallelism\",\"GPU compute\",\"Gradient Field Theorem\"],\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/gpu_compute\"}");
  let hero = make_hero("CRT GPU Compute") in
  let eq = dom_create("div") in
  dom_text(eq, "");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT approach to GPU parallelism. Any function f that distributes over modular arithmetic can be computed in 7 independent workgroups -- one per prime power -- then reconstructed via two-level CRT. Zero cross-channel dependency. FPGA-measured, GPU-deployed.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Parallelism Principle", "For f(x) = x^2 mod N where N = 8*9*25*49*11*13*17 = 214,414,200: decompose x into 7 residues. Compute f(r_i) = r_i^2 mod m_i independently in each channel. CRT reconstruction gives f(x) mod N exactly. Z/N = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17. The 3+4 split: 3 data channels {mod 8, mod 25, mod 49} carry bulk compute, 4 parity channels {mod 9, mod 11, mod 13, mod 17} verify.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 workgroups", "CRT decomposition", "Each CRT channel computes independently. No shared memory, no barriers, no race conditions.", "");
  render_finding(g1, "9-stage pipeline", "FPGA measured", "3 x 3 stages. FPGA: 6555 LUT4 (31%), 267 MHz on Tang Nano 20K.", "");
  render_finding(g1, "Block-diagonal", "Zero cross-talk", "Gradients in channel i never touch channel j. Backprop decomposes the same way.", "");
  render_finding(g1, "3+4 split", "Compute + verify", "3 data channels do the work. 4 parity channels verify for free.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Input value (0-214414199):", "dgpu-input", "e.g. 137", "Compute", "demo_gpu_run", "dgpu-result");
  render_p(sec2, "Decomposes x into 7 channels, squares each independently, reconstructs via CRT. Compares with direct x^2 mod N.");
  dom_append(dom_body(), sec2);
  let sec2b = make_section("800px") in
  render_h2(sec2b, "Batch Test");
  let btn = dom_create("button") in
  dom_text(btn, "Run 1000 Values");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_gpu_batch");
  dom_append(sec2b, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dgpu-batch");
  dom_append(sec2b, br);
  dom_append(dom_body(), sec2b);
  let secg = make_section("800px") in
  render_h2(secg, "Real GPU Benchmark (WebGPU)");
  /* S1233: gpu_init async -- always render, gpu_bench checks at click time */
  render_p(secg, "Run real CRT compute shaders on your GPU. 7 channels of Z/214,414,200 in WGSL. 15 operations: arithmetic, ML passes, ring census, and power map roots of unity. Ring Census: x^2=x (128=2^7), x^2=1 (256=2^8), x^2=0 (210=2*3*5*7), rad(N)|x (420=Carmichael lambda), gcd(x,N)=1 (Euler phi). Power Map: x^3=1 (27=3^3), x^5=1 (25=5^2), x^7=1 (7). The p-th prime power appears as the p-th-power roots-of-unity count. Full verification needs N=214,414,200 (~860MB GPU buffer).");
  let cnt_label = dom_create("span") in
  dom_text(cnt_label, "Elements (1K-250M): ");
  dom_style(cnt_label, "color", "#b0b0c0");
  dom_style(cnt_label, "marginRight", "8px");
  dom_style(cnt_label, "fontSize", "14px");
  let cnt_input = dom_create("input") in
  dom_attr(cnt_input, "type", "number");
  dom_attr(cnt_input, "id", "gpu-count");
  dom_attr(cnt_input, "value", "1000000");
  dom_style(cnt_input, "width", "120px");
  dom_style(cnt_input, "padding", "6px 10px");
  dom_style(cnt_input, "borderRadius", "4px");
  dom_style(cnt_input, "border", "1px solid #555");
  dom_style(cnt_input, "background", "#1a1a2e");
  dom_style(cnt_input, "color", "#ffd700");
  dom_style(cnt_input, "fontSize", "14px");
  dom_style(cnt_input, "marginBottom", "12px");
  dom_append(secg, cnt_label);
  dom_append(secg, cnt_input);
  let cnt_br = dom_create("div") in
  dom_style(cnt_br, "marginBottom", "8px");
  dom_append(secg, cnt_br);
  let mk_gpu_btn = fn(label, op_code, res_id) = (
    let btn = dom_create("button") in
    dom_text(btn, label);
    dom_style(btn, "background", "#ffd700");
    dom_style(btn, "color", "#0f0f2a");
    dom_style(btn, "border", "none");
    dom_style(btn, "padding", "10px 20px");
    dom_style(btn, "borderRadius", "6px");
    dom_style(btn, "cursor", "pointer");
    dom_style(btn, "fontWeight", "bold");
    dom_style(btn, "fontSize", "13px");
    dom_style(btn, "marginRight", "8px");
    dom_style(btn, "marginBottom", "8px");
    btn
  ) in
  let btn_add = mk_gpu_btn("Ring Add", 0, "gpu-res-add") in
  let btn_mul = mk_gpu_btn("CRT Multiply", 1, "gpu-res-mul") in
  let btn_eig = mk_gpu_btn("Eigenvalue", 2, "gpu-res-eig") in
  let btn_dec = mk_gpu_btn("Decompose", 3, "gpu-res-dec") in
  let btn_rtt = mk_gpu_btn("Round-trip", 4, "gpu-res-rtt") in
  let btn_fwd = mk_gpu_btn("CRT Forward", 5, "gpu-res-fwd") in
  let btn_bwd = mk_gpu_btn("CRT Backward", 6, "gpu-res-bwd") in
