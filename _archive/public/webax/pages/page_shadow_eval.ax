/* Shadow polynomial evaluator callback */
fn sp_name(v) = (
  if v == 30 then " = 2*3*5 (Coxeter number of E8)"
  else if v == 60 then " = 4*3*5 (lambda of Z/2,310)"
  else if v == 240 then " = 16*3*5 = |roots(E8)|"
  else if v == 630 then " = 2*9*5*7"
  else if v == 1344 then " = 8*168 = 8*|PSL(2,7)|"
  else if v == 2520 then " = lcm(1..9)"
  else if v == 4320 then " = 32*27*5"
  else if v == 6930 then " = 3*2310 = 3*primorial(11)"
  else if v == 10560 then " = 64*3*5*11 (all 5 primes)"
  else if v == 30030 then " = primorial(13)"
  else if v == 40320 then " = 8!"
  else ""
)

fn shadow_calc() = (
  let x = parse_int_from("#sp-input") in
  let result = dom_query("#sp-result") in
  /* P(x) = (x-1)(x-2)(x-3)(x-5) in ring */
  let a = x - 1 in
  let bv = x - 2 in
  let c = x - 3 in
  let d = x - 5 in
  let pv = a * bv * c * d in
  let name = sp_name(pv) in
  /* Check if x is a root */
  let root_note = if x == 1 then " (ROOT: x = 1)"
    else if x == 2 then " (ROOT: x = 2)"
    else if x == 3 then " (ROOT: x = 3)"
    else if x == 5 then " (ROOT: x = 5)"
    else "" in
  let smooth = is_prime_trial(pv) in
  let ptag = if smooth > 0 then " <b style='color:#ffd700'>(PRIME)</b>" else "" in
  dom_inner(result,
    "<p style='color:#88ddaa;margin:4px 0'><b>P(" + "${x}" + ") = " + "${pv}" + "</b>" + name + root_note + ptag + "</p>" +
    "<p style='color:#b8b8c8;margin:4px 0'>= (" + "${x}" + "-1)(" + "${x}" + "-2)(" + "${x}" + "-3)(" + "${x}" + "-5) = " + "${a}" + " * " + "${bv}" + " * " + "${c}" + " * " + "${d}" + "</p>")
)

fn page_shadow_eval() = (
  dom_head_meta("description", "The shadow polynomial P(x) = (x-1)(x-2)(x-3)(x-5) evaluated at integers. P(7) = 240 = |roots(E8)|. P(9) = 1344 = 8*|PSL(2,7)|. P(17) = 8! = 240*168. CRT root anatomy: 5 roots mod 8 and 9. Ratio staircase: cofactors sum to 42.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Shadow Polynomial\",\"description\":\"P(x) = (x-1)(x-2)(x-3)(x-5) evaluated at integers. P(7) = 240 = E8 roots. P(9) = 8*PSL(2,7). CRT root anatomy and ratio staircase.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/shadow_eval\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"shadow polynomial\"},{\"@type\":\"DefinedTerm\",\"name\":\"polynomial evaluation\"},{\"@type\":\"DefinedTerm\",\"name\":\"E8 root system\"}]}");
  /* === HERO === */
  let hero = make_hero("The Shadow Polynomial") in
  let big = dom_create("div") in
  dom_text(big, "P(x) = (x-1)(x-2)(x-3)(x-5)");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "This polynomial has roots at {1, 2, 3, 5}. Its coefficients are 11, 41, 61, and 30. Evaluate P at integers from 6 to 13: every result factors entirely into primes from {2, 3, 5, 7, 11}. The factorizations connect to E8, the Fano plane, and factorials.");
  dom_append(dom_body(), hero);

  /* === SEC 1: EVALUATION TABLE === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Evaluations at Integer Points");
  render_theorem(sec1, "Shadow Evaluation (PROVED)", "P(x) = x^4 - 11x^3 + 41x^2 - 61x + 30. Every evaluation at integers 6 through 13 is 11-smooth (factors only into {2,3,5,7,11}).");
  let etbl = make_table(sec1) in
  let ehdr = dom_create("tr") in
  render_th(ehdr, "x");
  render_th(ehdr, "P(x)");
  render_th(ehdr, "Factorization");
  render_th(ehdr, "Connection");
  dom_append(etbl, ehdr);
  render_table_row_4(etbl, "0", "30", "2 * 3 * 5", "Coxeter number of E8");
  render_table_row_4(etbl, "6", "60", "4 * 3 * 5", "lambda of Z/2,310");
  render_table_row_4(etbl, "7", "240", "16 * 3 * 5", "|roots(E8)|");
  render_table_row_4(etbl, "8", "630", "2 * 9 * 5 * 7", "");
  render_table_row_4(etbl, "9", "1344", "64 * 3 * 7", "8 * |PSL(2,7)|");
  render_table_row_4(etbl, "10", "2520", "8 * 9 * 5 * 7", "lcm(1..9)");
  render_table_row_4(etbl, "11", "4320", "32 * 27 * 5", "");
  render_table_row_4(etbl, "12", "6930", "2 * 9 * 5 * 7 * 11", "3 * primorial(11)");
  render_table_row_4(etbl, "13", "10560", "64 * 3 * 5 * 11", "All 5 primes present");
  render_p(sec1, "Note: 5 is absent from P(9) = 1344. This is the only evaluation in the range where one of the five primes drops out. At x = 9, the factor (9-5) = 4 contributes only powers of 2.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: P(7) = 240 AND E8 === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "P(7) = 240 = E8 Root Count");
  render_p(sec2, "The E8 root system has 240 roots. E8 has rank 8 and Coxeter number 30. Roots = rank * Coxeter = 8 * 30 = 240.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "P(7) = 240", "= 6 * 5 * 4 * 2", "The four factors are (7-1)(7-2)(7-3)(7-5). Product = |roots(E8)|.", "");
  render_finding(g2, "P(7)/P(0) = 8", "= rank(E8)", "P(0) = 30 = Coxeter number. P(7) = 30 * 8. The ratio is the rank.", "");
  render_finding(g2, "P(17) = 40,320", "= 8!", "P at 17 is the factorial of 8. Also: 40,320 = 240 * 168 = |roots(E8)| * |PSL(2,7)|.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: MIRROR IDENTITY === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Mirror Identity");
  render_theorem(sec3, "Mirror Identity (PROVED)", "P(-1) = P(11)/P(0) = 4320/30 = 144. Proof: P(-1) = (-2)(-3)(-4)(-6) = 144. P(11) = 10*9*8*6 = 4320. P(0) = 1*2*3*5 = 30. Ratio = 144. The polynomial at -1 equals the ratio of its value at 11 to its value at 0.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: CRT ROOT ANATOMY === */
  let sec_crt = make_section("800px") in
  render_h2(sec_crt, "CRT Root Anatomy");
  render_theorem(sec_crt, "CRT Root Theorem (PROVED)", "P(x) has 5 roots mod 8 and mod 9 (extra root: -1), but exactly 4 roots modulo 25, 49, 11, 13, and 17. Root count sum across all 7 channels = 30 = P(0). Non-root sum = 102. Discriminant = 2304 = 48^2.");
  render_p(sec_crt, "Why 5 roots mod 8 and 9? Because P(-1) = 144 is divisible by 8 and 9 but not by 25 or 49. So -1 is an extra root only in the mod-8 and mod-9 channels.");
  let rtbl = make_table(sec_crt) in
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Channel");
  render_th(rhdr, "Modulus");
  render_th(rhdr, "Roots");
  render_th(rhdr, "Non-roots");
  dom_append(rtbl, rhdr);
  render_table_row_4(rtbl, "mod 8", "8", "5 (incl. -1)", "3");
  render_table_row_4(rtbl, "mod 9", "9", "5 (incl. -1)", "4");
  render_table_row_4(rtbl, "mod 25", "25", "4", "21");
  render_table_row_4(rtbl, "mod 49", "49", "4", "45");
  render_table_row_4(rtbl, "mod 11", "11", "4", "7");
  render_table_row_4(rtbl, "mod 13", "13", "4", "9");
  render_table_row_4(rtbl, "mod 17", "17", "4", "13");
  let g_crt = make_findings_grid(sec_crt) in
  render_finding(g_crt, "Root sum", "5+5+4+4+4+4+4 = 30", "= P(0). The root count across all channels equals the polynomial evaluated at zero.", "");
  render_finding(g_crt, "Non-root sum", "3+4+21+45+7+9+13 = 102", "= 2*3*17. The complement is governed by 17, the ring-closing prime.", "");
  render_finding(g_crt, "Discriminant", "disc(P) = 2304 = 48^2", "= 2^8 * 3^2. Only 2 and 3 (the first two chain primes) appear.", "");
  dom_append(dom_body(), sec_crt);

  /* === SEC 5: RATIO STAIRCASE === */
  let sec_stair = make_section("800px") in
  render_h2(sec_stair, "The Ratio Staircase");
  render_theorem(sec_stair, "Ratio Staircase (PROVED)", "P(p)/P(0) = 2^k * cofactor for each non-root prime p. Cofactors {1, 9, 11, 21} sum to 42. Powers of 2 sum to 8+16+32+64 = 120 = 5!.");
  let stbl = make_table(sec_stair) in
  let shdr = dom_create("tr") in
  render_th(shdr, "p");
  render_th(shdr, "P(p)/30");
  render_th(shdr, "Power of 2");
  render_th(shdr, "Cofactor");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "7", "8", "2^3 = 8", "1");
  render_table_row_4(stbl, "11", "144", "2^4 = 16", "9");
  render_table_row_4(stbl, "13", "352", "2^5 = 32", "11");
  render_table_row_4(stbl, "17", "1344", "2^6 = 64", "21");
  let g_stair = make_findings_grid(sec_stair) in
  render_finding(g_stair, "Cofactor sum", "1 + 9 + 11 + 21 = 42", "= 2*3*7. The cofactors at the four non-root primes sum to 42.", "");
  render_finding(g_stair, "Power-of-2 sum", "8+16+32+64 = 120", "= 5!. The 2-powers in the staircase sum to the factorial of 5.", "");
  render_finding(g_stair, "P(17)/P(7)", "40320/240 = 168", "= |PSL(2,7)| = |Aut(Fano)|. The ratio of P at 17 to P at 7 is the Fano plane symmetry group.", "");
  dom_append(dom_body(), sec_stair);

  /* === INTERACTIVE: SHADOW POLYNOMIAL EVALUATOR === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: P(x) Evaluator");
  render_p(sec_i, "Enter any integer x. Compute P(x) = (x-1)(x-2)(x-3)(x-5). For x from 6 to 13, every result factors into {2, 3, 5, 7, 11} only.");
  make_interactive_widget(sec_i, "Evaluate P(x) at:", "sp-input", "e.g. 7", "Evaluate", "shadow_calc", "sp-result");
  render_p(sec_i, "Try: 7 (240 = E8 roots), 9 (1344 = 8*168), 10 (2520 = lcm(1..9)), 13 (10560), 16 (30030 = primorial(13)), 17 (40320 = 8!).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Contrast");
  render_contrast_row(sec7, "Polynomial", "Roots at {1,2,3,5}. Four small primes, nothing special about the polynomial itself", "Coefficients are 11, 41, 61, 30. Every evaluation at integers 6 through 13 is 11-smooth. Factorizations hit E8 and PSL(2,7).");
  render_contrast_row(sec7, "P(7) = 240", "A product of four consecutive-ish differences", "= |roots(E8)| = 8 * 30 = rank * Coxeter. P(7)/P(0) = 8 = rank.");
  render_contrast_row(sec7, "P(9) = 1344", "= 2^6 * 3 * 7. A factorization", "= 8 * 168 = 8 * |PSL(2,7)|. The only evaluation where 5 drops out.");
  render_contrast_row(sec7, "P(17) = 8!", "A factorial that happens to match", "= 240 * 168 = |roots(E8)| * |PSL(2,7)|. Two algebraic structures whose product is 8!.");
  render_contrast_row(sec7, "Ratios P(p)/30", "Grow with p, no pattern expected", "Power-of-2 staircase: cofactors {1, 9, 11, 21} sum to 42. 2-powers sum to 120 = 5!.");
  dom_append(dom_body(), sec7)
)
