/* Heegner checker: split into small functions */
fn hg_is(d) = (
  if d == 1 then 1 else if d == 2 then 1 else if d == 3 then 1
  else if d == 7 then 1 else if d == 11 then 1 else if d == 19 then 1
  else if d == 43 then 1 else if d == 67 then 1 else if d == 163 then 1 else 0
)

fn hg_name(d) = (
  if d == 1 then "1. The identity."
  else if d == 2 then "2. Seeds CC1(2)."
  else if d == 3 then "3. Seeds CC1(1)."
  else if d == 7 then "7. c(3)=7."
  else if d == 11 then "11."
  else if d == 19 then "c(9)=19. f(5) = 5^2-5-1 = 19."
  else if d == 43 then "c(21)=43. 3*7=21."
  else if d == 67 then "67 = c(33). c(3*11)."
  else if d == 163 then "c(81)=163. Largest Heegner."
  else ""
)

fn hg_check() = (
  let d = parse_int_from("#hg-input") in
  let result = dom_query("#hg-result") in
  if d < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter d >= 1.</p>")
  else (
    let h = hg_is(d) in
    let verd = if h > 0 then "<span style='color:#ffd700'>HEEGNER.</span> h(-" + "${d}" + ")=1."
      else if d == 5 then "<span style='color:#b8b8c8'>Not Heegner.</span> h(-5)=2. The field sees double."
      else "<span style='color:#b8b8c8'>Not a Heegner number.</span>" in
    let note = if h > 0 then "<p style='color:#88ddaa;margin:4px 0'>" + hg_name(d) + "</p>" else "" in
    dom_inner(result, "<p style='margin:4px 0'>" + verd + "</p>" + note)
  )
)

fn page_heegner() = (
  dom_head_meta("description", "Nine Heegner numbers where unique factorization holds. First five are {1,2,3,7,11}. 3 generates the remaining four through the Cunningham map. Eisenstein norms close the pattern. h(-5)=2: the field sees double.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Heegner Numbers\",\"description\":\"Nine Heegner numbers where unique factorization holds. First five are {1,2,3,7,11}. 3 generates the remaining four through the Cunningham map.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/heegner\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Heegner numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"class number\"},{\"@type\":\"DefinedTerm\",\"name\":\"j-function\"}]}");
  /* === HERO === */
  let hero = make_hero("The Nine Heegner Numbers") in
  let big = dom_create("div") in
  dom_text(big, "{1, 2, 3, 7, 11, 19, 43, 67, 163}");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "An imaginary quadratic field Q(sqrt(-d)) has class number 1 when its integers factor uniquely -- just like ordinary integers. There are exactly nine such values of d. Conjectured by Gauss, proved by Stark and Heegner in 1967. The first five are {1, 2, 3, 7, 11} -- the primes of Z/2,310 except 5. The remaining four are generated by 3 through the Cunningham map c(n) = 2n+1.");
  dom_append(dom_body(), hero);

  /* === SEC 1: E'S EXCLUSION === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Why 5 is Excluded");
  render_p(sec1, "Every prime of Z/2,310 except 5 is a Heegner number. Why? Because h(-5) = 2. The field Q(sqrt(-5)) has two ideal classes -- factorization is ambiguous. 5 is also the only prime of the ring that splits in Z[i]: 5 = (2+i)(2-i). Two ideal classes, two Gaussian factors -- the pattern is consistent.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CUNNINGHAM GENERATION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Cunningham Generation");
  render_theorem(sec2, "Heegner-Cunningham Theorem (PROVED)", "All 9 Heegner numbers are either in {1, 2, 3, 7, 11} or are Cunningham images of products involving 3. c(9)=19, c(21)=43, c(33)=67, c(81)=163. The prime 3 generates every Heegner number beyond the base set.");
  let stbl = dom_create("table") in
  dom_style(stbl, "width", "100%");
  dom_style(stbl, "maxWidth", "700px");
  dom_style(stbl, "margin", "24px auto");
  dom_style(stbl, "borderCollapse", "collapse");
  let shdr = dom_create("tr") in
  render_th(shdr, "p");
  render_th(shdr, "3*p");
  render_th(shdr, "c(3*p)");
  render_th(shdr, "Heegner?");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "1", "3", "7", "YES");
  render_table_row_4(stbl, "2", "6", "13", "NO (h(-52)=2)");
  render_table_row_4(stbl, "3", "9", "19", "YES");
  render_table_row_4(stbl, "5", "15", "31", "NO (h(-31)=3)");
  render_table_row_4(stbl, "7", "21", "43", "YES");
  render_table_row_4(stbl, "11", "33", "67", "YES");
  dom_append(sec2, stbl);
  render_p(sec2, "The failures have small prime class numbers: h(-52)=2, h(-31)=3. Exactly 2 and 5 are the elements whose Cunningham lift fails -- the same two primes excluded by different Heegner mechanisms.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: K-POWER WALK === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Powers of 3");
  render_p(sec3, "Powers of 3 through the Cunningham map: c(3^n) = 2*3^n + 1.");
  let ktbl = dom_create("table") in
  dom_style(ktbl, "width", "100%");
  dom_style(ktbl, "maxWidth", "700px");
  dom_style(ktbl, "margin", "24px auto");
  dom_style(ktbl, "borderCollapse", "collapse");
  let khdr = dom_create("tr") in
  render_th(khdr, "n");
  render_th(khdr, "c(3^n)");
  render_th(khdr, "Heegner?");
  dom_append(ktbl, khdr);
  render_table_row(ktbl, "1", "c(3) = 7", "YES");
  render_table_row(ktbl, "2", "c(9) = 19", "YES");
  render_table_row(ktbl, "3", "c(27) = 55", "NO (5*11)");
  render_table_row(ktbl, "4", "c(81) = 163", "YES (!)");
  render_table_row(ktbl, "5", "c(243) = 487", "NO (prime, not Heegner)");
  dom_append(sec3, ktbl);
  render_p(sec3, "Heegner at n in {1, 2, 4}. The class numbers stay 11-smooth (factors only from {2,3,5,7,11}) for n=0..8 (9 consecutive). First non-smooth failure at n=9. At n=7: c(3^7) = 4375 = 5^4 * 7.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: AXIOM-SQUARE PATTERN === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The p^2 - 6 Pattern");
  render_p(sec4, "Subtract 6 (= 2*3) from each odd prime squared:");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "3^2 - 6", "9 - 6 = 3", "Heegner.", "");
  render_finding(g4, "5^2 - 6", "25 - 6 = 19", "Heegner.", "");
  render_finding(g4, "7^2 - 6", "49 - 6 = 43", "Heegner.", "");
  render_finding(g4, "11^2 - 6", "121 - 6 = 115 = 5*23", "Not Heegner. 6 too small.", "");
  render_p(sec4, "Three consecutive odd primes squared minus 6 yield three consecutive Heegner primes: 19, 43, 67.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: EISENSTEIN NORMS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Eisenstein Norms");
  render_p(sec5, "All 5 splitting Heegner d's are Eisenstein norms N(a,b) = a^2 + ab + b^2 with small-prime coordinates:");
  let etbl = dom_create("table") in
  dom_style(etbl, "width", "100%");
  dom_style(etbl, "maxWidth", "700px");
  dom_style(etbl, "margin", "24px auto");
  dom_style(etbl, "borderCollapse", "collapse");
  let ehdr = dom_create("tr") in
  render_th(ehdr, "Heegner d");
  render_th(ehdr, "Eisenstein norm");
  render_th(ehdr, "Pair");
  dom_append(etbl, ehdr);
  render_table_row(etbl, "7", "1 + (-2) + 4", "(1, 2)");
  render_table_row(etbl, "19", "4 + (-6) + 9", "(2, 3)");
  render_table_row(etbl, "43", "1 + (-6) + 36", "(1, 6)");
  render_table_row(etbl, "67", "4 + (-14) + 49", "(2, 7)");
  render_table_row(etbl, "163", "9 + (-33) + 121", "(3, 11)");
  dom_append(sec5, etbl);
  render_p(sec5, "The Eisenstein lattice Z[omega] (where omega = e^{2*pi*i/3}) reflects the prime chain. Inert: {2, 11} (both 2 mod 3). Ramified: 3. Unit: 1.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: E3 REPRESENTATION === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "The E3 Representation Theorem");
  render_theorem(sec6, "E3 Representation (PROVED)", "All 7 representable Heegner numbers satisfy E3(a,b) = a^2 - ab + b^2 = h. Discriminants disc = 4h - 3a^2 have sqrt(disc) in {2, 3, 5, 8, 13, 16, 25}. b-values walk the chain: 1, 2, 3, 5, 7, 9, 14. Non-representable: {2, 11} -- both are 2 mod 3.");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "h");
  render_th(rhdr, "(a, b)");
  render_th(rhdr, "sqrt(disc)");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "1", "(0, 1)", "2");
  render_table_row(rtbl, "3", "(1, 2)", "3");
  render_table_row(rtbl, "7", "(1, 3)", "5");
  render_table_row(rtbl, "19", "(2, 5)", "8 (= 2^3)");
  render_table_row(rtbl, "43", "(1, 7)", "13");
  render_table_row(rtbl, "67", "(2, 9)", "16 (= 2^4)");
  render_table_row(rtbl, "163", "(3, 14)", "25 (= 5^2)");
  dom_append(sec6, rtbl);
  render_p(sec6, "163 Triangle: E3(3, 14) = E3(11, 14) = 163. Both share b-value 14 (= 2*7). 14 - 3 = 11. 3 + 11 = 14. Also: E3(3, 11) = 97. 163 - 97 = 66 = 2*3*11.");
  dom_append(dom_body(), sec6);

  /* === SEC 7: DISCRIMINANT EXCLUSION === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Discriminant Exclusion");
  render_theorem(sec7, "Discriminant Exclusion (PROVED)", "7 and 11 never appear as sqrt(disc) in minimal E3 representations. Two mechanisms: 13-blocking (7 at a=1 needs h=13, not Heegner) and power shadowing (7 at a=3 gives h=19, but disc=64=2^6 shadows it). Sum of 7 sqrt(disc) values: 72 = 8*9 (= 2^3 * 3^2).");
  let g7 = make_findings_grid(sec7) in
  render_finding(g7, "3 + powers of 4", "Heegner numbers from 3", "3+4=7, 3+16=19, 3+64=67. Spacing = 4, 16, 64 (= 2^2, 2^4, 2^6). Powers of 4 generate three Heegner numbers.", "");
  render_finding(g7, "CRT(163)", "(3, 1, 13, 16, 9) in Z/210", "The largest Heegner number has 13 in its mod-5 channel.", "");
  dom_append(dom_body(), sec7);

  /* === INTERACTIVE: HEEGNER CHECKER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Heegner Checker");
  render_p(sec_i, "Enter d. Is Q(sqrt(-d)) a unique factorization domain? The nine Heegner numbers are {1,2,3,7,11,19,43,67,163} -- the primes of Z/2,310 (except 5) plus four extensions generated by 3 via c(n) = 2n+1.");
  make_interactive_widget(sec_i, "Check discriminant d:", "hg-input", "e.g. 163", "Check", "hg_check", "hg-result");
  render_p(sec_i, "Try: 1, 2, 3, 7, 11 (all Heegner), 5 (excluded! h(-5)=2), 19 (c(9)=19), 163 (c(81)=163), 23 (h(-23)=3).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "Heegner numbers", "Nine special values for class number 1, a curiosity in algebraic number theory", "First five = {1,2,3,7,11}. Remaining four = generated by 3 through the Cunningham map c(n)=2n+1. 5 excluded because h(-5)=2: the field has two ideal classes.");
  render_contrast_row(sec8, "Class number 1", "Hard theorem by Stark-Heegner, no structural explanation", "3 generates all nine through c(3*p). The selection theorem shows exactly which lifts work and which fail.");
  render_contrast_row(sec8, "163", "Famous number from e^{pi*sqrt(163)}, no structural connection to small primes", "163 = c(81) = c(3^4). Eisenstein norm of (3, 11). E3(3, 14) = E3(11, 14) = 163. CRT(163) carries 13 in the mod-5 channel.");
  dom_append(dom_body(), sec8)
)
