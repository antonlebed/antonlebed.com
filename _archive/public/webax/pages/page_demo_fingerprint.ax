/* page_demo_fingerprint.ax -- CRT Audio Fingerprinting.
   7-channel TRANS (Z/214,414,200). Coupling distance = similarity. CC0. */

/* ================================================================
   CRT AUDIO FINGERPRINTING -- /demos/fingerprint.
   Audio features -> ring element -> 7 CRT channels = 7 independent
   fingerprint components. mod-11 = noise tolerance. Coupling distance
   = similarity metric. No spectrogram constellation matching needed.
   ================================================================ */

fn af_mod(ch) = (
  if ch == 0 then 8 else if ch == 1 then 9 else if ch == 2 then 25
  else if ch == 3 then 49 else if ch == 4 then 11 else if ch == 5 then 13
  else 17
)

fn af_label(ch) = (
  if ch == 0 then "mod 8" else if ch == 1 then "mod 9" else if ch == 2 then "mod 25"
  else if ch == 3 then "mod 49" else if ch == 4 then "mod 11" else if ch == 5 then "mod 13"
  else "mod 17"
)

/* Russian peasant mulmod -- avoids i32 overflow with TRANS idempotents. */
fn fp_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb % m;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

fn fp_red(x) = (let m = 214414200 in if x >= m then x - m else x)

/* 7-channel CRT reconstruction from residue array. */
fn fp_recon(res) = (
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let r0 = fp_mulmod(res[0], idem[0]) in
  let r1 = fp_red(r0 + fp_mulmod(res[1], idem[1])) in
  let r2 = fp_red(r1 + fp_mulmod(res[2], idem[2])) in
  let r3 = fp_red(r2 + fp_mulmod(res[3], idem[3])) in
  let r4 = fp_red(r3 + fp_mulmod(res[4], idem[4])) in
  let r5 = fp_red(r4 + fp_mulmod(res[5], idem[5])) in
  fp_red(r5 + fp_mulmod(res[6], idem[6]))
)

fn fp_color(ch) = (
  if ch == 0 then "#ff6666" else if ch == 1 then "#44ff88"
  else if ch == 2 then "#ff6666" else if ch == 3 then "#ff6666"
  else if ch == 4 then "#44ff88" else if ch == 5 then "#44ff88"
  else "#44ff88"
)

/* Play track as 7-oscillator CRT synthesis */
let g_fp_oscs = [0, 0, 0, 0, 0, 0, 0]

fn af_band_hz(ch) = (
  if ch == 0 then 80 else if ch == 1 then 200 else if ch == 2 then 1200
  else if ch == 3 then 2400 else if ch == 4 then 6000 else if ch == 5 then 10000
  else 15000
)

fn demo_fp_play() = (
  let tid = parse_int_from("#dfp-input") in
  let track = gen_audio_track(tid % 8, 20) in
  let fp = compute_fingerprint(track, 20) in
  let i = [0] in
  while i[0] < 7 do (
    let m = af_mod(i[0]) in
    let r = fp[i[0]] in
    let freq = af_band_hz(i[0]) + r * af_band_hz(i[0]) / m / 3 in
    let gain = if r > 0 then r * 6 / m + 1 else 0 in
    if g_fp_oscs[i[0]] == 0 then
      set(g_fp_oscs, i[0], aud_osc(0))
    else 0;
    aud_freq(g_fp_oscs[i[0]], freq);
    aud_gain(g_fp_oscs[i[0]], gain);
    set(i, 0, i[0] + 1)
  );
  0
)

fn demo_fp_stop() = (
  let i = [0] in
  while i[0] < 7 do (
    if g_fp_oscs[i[0]] > 0 then (
      aud_gain(g_fp_oscs[i[0]], 0);
      set(g_fp_oscs, i[0], 0)
    ) else 0;
    set(i, 0, i[0] + 1)
  );
  0
)

/* Simulate audio features: frequency bands + energy + zero crossings.
   Each "frame" produces a feature vector encoded as a ring element.
   7 channels: mod 8=bass, mod 9=mid, mod 25=treble,
   mod 49=spectral centroid, mod 11=zcr, mod 13=tempo, mod 17=timbre */
fn gen_audio_track(track_id, n_frames) = (
  let frames = alloc(n_frames) in
  mut i = 0;
  while i < n_frames do (
    /* Each track has characteristic spectral signature */
    let bass = (track_id * 3 + i * 17 + 100) % 8 in
    let mid = (track_id * 7 + i * 13 + 50) % 9 in
    let treble = (track_id * 11 + i * 23 + 30) % 25 in
    let centroid = (track_id * 5 + i * 31 + track_id * track_id) % 49 in
    let zcr = (track_id * 2 + i * 7 + 20) % 11 in
    let tempo = (track_id * 3 + i * 3 + track_id) % 13 in
    let timbre = (track_id * 13 + i * 11 + track_id * 2 + 5) % 17 in
    /* Encode as ring element via mulmod (TRANS idempotents overflow i32) */
    let val = fp_recon([bass, mid, treble, centroid, zcr, tempo, timbre]) in
    set(frames, i, val);
    mut i = i + 1
  );
  frames
)

/* Add noise to a track (simulates recording corruption) */
fn add_noise(frames, n_frames, noise_level) = (
  let noisy = alloc(n_frames) in
  mut i = 0;
  while i < n_frames do (
    let v = frames[i] in
    /* Noise: small perturbation to some channels */
    let noise = ((i * 4973 + noise_level * 7919) % (noise_level + 1)) in
    let noisy_val = (v + noise) % 214414200 in
    set(noisy, i, noisy_val);
    mut i = i + 1
  );
  noisy
)

/* Compute CRT fingerprint: per-channel average over all frames */
fn compute_fingerprint(frames, n_frames) = (
  let fp = alloc(7) in
  mut ch = 0;
  while ch < 7 do (
    let m = af_mod(ch) in
    mut sum = 0;
    mut i = 0;
    while i < n_frames do (
      mut sum = sum + (frames[i] % m);
      mut i = i + 1
    );
    set(fp, ch, sum / n_frames);
    mut ch = ch + 1
  );
  fp
)

/* Coupling distance between two fingerprints */
fn fingerprint_distance(fp1, fp2) = (
  mut dist = 0;
  mut ch = 0;
  while ch < 7 do (
    let diff = if fp1[ch] > fp2[ch] then fp1[ch] - fp2[ch] else fp2[ch] - fp1[ch] in
    mut dist = dist + diff;
    mut ch = ch + 1
  );
  dist
)

/* Run fingerprint matching demo */
fn demo_fingerprint_run() = (
  let result_el = dom_query("#dfp-result") in
  let seed_val = parse_int_from("#dfp-input") in
  let query_id = if seed_val == 0 then 3 else seed_val % 8 in
  let n_frames = 20 in
  let n_tracks = 8 in

  /* Build database of 8 tracks */
  let db_fps = alloc(n_tracks) in
  let track_names = ["Jazz Piano", "Rock Guitar", "Classical Violin", "Electronic Beat", "Acoustic Folk", "Hip Hop Bass", "Metal Drums", "Ambient Pad"] in
  mut t = 0;
  while t < n_tracks do (
    let track = gen_audio_track(t * 137 + 42, n_frames) in
    let fp = compute_fingerprint(track, n_frames) in
    set(db_fps, t, fp);
    mut t = t + 1
  );

  /* Generate query (same track with noise) */
  let original = gen_audio_track(query_id * 137 + 42, n_frames) in
  let noisy = add_noise(original, n_frames, 3) in
  let query_fp = compute_fingerprint(noisy, n_frames) in

  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>CRT AUDIO FINGERPRINT MATCHING: query='" + track_names[query_id] + "' (with noise)</p>";

  /* Query fingerprint -- loop-based header + values */
  mut html = html + "<p style='color:#ffd700;margin:8px 0 4px;font-size:13px'>QUERY FINGERPRINT (noisy recording)</p>";
  mut hdr = "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'>";
  mut ch = 0;
  while ch < 7 do (
    mut hdr = hdr + "<th style='padding:4px 8px;color:" + fp_color(ch) + ";font-size:10px'>" + af_label(ch) + "</th>";
    mut ch = ch + 1
  );
  mut html = html + hdr + "</tr><tr>";
  mut ch = 0;
  while ch < 7 do (
    mut html = html + "<td style='padding:4px 8px;color:" + fp_color(ch) + ";font-size:14px;font-weight:bold;text-align:center'>" + "${query_fp[ch]}" + "</td>";
    mut ch = ch + 1
  );
  mut html = html + "</tr></table>";

  /* Distance matrix -- loop-based header */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>DATABASE SEARCH (coupling distance)</p>";
  mut dhdr = "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:4px 12px;color:#666;font-size:10px'>Track</th>";
  mut dh = 0;
  while dh < 7 do (
    mut dhdr = dhdr + "<th style='padding:4px 6px;color:" + fp_color(dh) + ";font-size:9px'>" + af_label(dh) + "</th>";
    mut dh = dh + 1
  );
  mut html = html + dhdr + "<th style='padding:4px 12px;color:#ffd700;font-size:10px'>Dist</th><th style='padding:4px 12px;color:#888;font-size:10px'>Match?</th></tr>";

  mut best_dist = 999;
  mut best_idx = 0;
  mut t2 = 0;
  while t2 < n_tracks do (
    let fp = db_fps[t2] in
    let d = fingerprint_distance(query_fp, fp) in
    if d < best_dist then (
      mut best_dist = d;
      mut best_idx = t2
    ) else 0;
    mut t2 = t2 + 1
  );

  mut t3 = 0;
  while t3 < n_tracks do (
    let fp = db_fps[t3] in
    let d = fingerprint_distance(query_fp, fp) in
    let is_match = if t3 == best_idx then 1 else 0 in
    let is_correct = if t3 == query_id then 1 else 0 in
    let row_bg = if is_match == 1 then "background:#001a00;" else if is_correct == 1 then "background:#1a1a00;" else "" in
    let match_str = if is_match == 1 then "BEST" else if d < 5 then "close" else "-" in
    let match_color = if is_match == 1 then (if is_correct == 1 then "#44ff88" else "#ff4444") else "#444" in
    mut html = html + "<tr style='" + row_bg + "'><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>" + track_names[t3] + "</td>";
    mut ch2 = 0;
    while ch2 < 7 do (
      mut html = html + "<td style='padding:3px 6px;color:" + fp_color(ch2) + ";font-size:11px;text-align:center'>" + "${fp[ch2]}" + "</td>";
      mut ch2 = ch2 + 1
    );
    let dist_color = if d == 0 then "#44ff88" else if d < 3 then "#88ff44" else if d < 8 then "#ffd700" else "#ff4444" in
    mut html = html + "<td style='padding:3px 12px;color:" + dist_color + ";font-size:14px;font-weight:bold;text-align:center'>" + "${d}" + "</td>";
    mut html = html + "<td style='padding:3px 12px;color:" + match_color + ";font-size:12px;font-weight:bold'>" + match_str + "</td></tr>";
    mut t3 = t3 + 1
  );
  mut html = html + "</table>";

  let correct_str = if best_idx == query_id then "CORRECT MATCH" else "MISMATCH" in
  let correct_color = if best_idx == query_id then "#44ff88" else "#ff4444" in
  mut html = html + "<p style='color:" + correct_color + ";font-size:18px;font-weight:bold;margin:8px 0'>" + correct_str + ": '" + track_names[best_idx] + "' (distance=" + "${best_dist}" + ")</p>";

  /* mod-11 noise tolerance */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>MOD-11 NOISE TOLERANCE</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>The mod-11 channel has the smallest modulus among the 7 channels. Small perturbations to the audio signal produce correspondingly small changes in the mod-11 residue. It absorbs noise that would throw off larger channels. Same error-detection property that protects data also protects fingerprints.</p>";

  /* 3+4 split */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>3+4 DATA/PARITY SPLIT</p>";
  mut html = html + "<p style='color:#ff6666;margin:4px 0'>3 data channels {mod 8, mod 25, mod 49}: carry AUDIO content (bass energy, treble detail, spectral centroid)</p>";
  mut html = html + "<p style='color:#44ff88;margin:4px 0'>4 parity channels {mod 9, mod 11, mod 13, mod 17}: carry IDENTITY (mid structure, robustness, tempo, timbre)</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Audio content changes with noise and compression. Audio identity persists. The 3+4 split separates what changes from what stays. Fingerprinting = matching on the parity channels that resist degradation.</p>";

  mut html = html + "</div>";
  dom_inner(result_el, html)
)

/* Batch: match 8 noisy queries against database */
fn demo_fingerprint_batch() = (
  let result_el = dom_query("#dfp-batch") in
  let n_frames = 20 in
  let n_tracks = 8 in

  /* Build database */
  let db_fps = alloc(n_tracks) in
  mut t = 0;
  while t < n_tracks do (
    let track = gen_audio_track(t * 137 + 42, n_frames) in
    set(db_fps, t, compute_fingerprint(track, n_frames));
    mut t = t + 1
  );

  /* Test each track with increasing noise */
  mut correct = 0;
  mut total = 0;
  mut noise_lev = 0;
  while noise_lev < 5 do (
    mut query_id = 0;
    while query_id < n_tracks do (
      let original = gen_audio_track(query_id * 137 + 42, n_frames) in
      let noisy = add_noise(original, n_frames, noise_lev * 2 + 1) in
      let qfp = compute_fingerprint(noisy, n_frames) in
      /* Find best match */
      mut best_d = 999;
      mut best_t = 0;
      mut t2 = 0;
      while t2 < n_tracks do (
        let d = fingerprint_distance(qfp, db_fps[t2]) in
        if d < best_d then (
          mut best_d = d;
          mut best_t = t2
        ) else 0;
        mut t2 = t2 + 1
      );
      if best_t == query_id then (mut correct = correct + 1) else 0;
      mut total = total + 1;
      mut query_id = query_id + 1
    );
    mut noise_lev = noise_lev + 1
  );
  let accuracy = correct * 100 / total in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH TEST: 8 tracks x 5 noise levels = " + "${total}" + " queries</p><p style='color:" + (if accuracy > 50 then "#44ff88" else "#ff9944") + ";font-size:24px;font-weight:bold;margin:4px 0'>Accuracy: " + "${accuracy}" + "% (" + "${correct}" + "/" + "${total}" + " correct)</p><p style='color:#b0b0c0;margin:4px 0'>Each track tested with noise levels 1,3,5,7,9. Simple per-channel averaging loses discriminating information as tracks share similar average residues. Low accuracy is EXPECTED for this prototype: real fingerprinting uses histograms, temporal patterns, and weighted channel distances. The CRT decomposition provides the structure; the matching algorithm determines accuracy.</p></div>")
)

fn page_fingerprint() = (
  dom_head_meta("description", "CRT Audio Fingerprinting over Z/214,414,200. 7 CRT channels = 7 independent spectral features. Coupling distance = similarity. mod-11 noise tolerance. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Audio Fingerprinting\",\"description\":\"CRT-decomposed audio fingerprinting over Z/214,414,200. 7 spectral channels. Coupling distance matching. mod-11 noise tolerance. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/fingerprint\"}");
  let hero = make_hero("CRT Audio Fingerprinting") in
  let eq = dom_create("div") in
  dom_text(eq, "CRT approach to audio fingerprinting over Z/214,414,200. CC0.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "Audio fingerprinting services like Shazam use proprietary spectrogram constellation matching: peak detection in time-frequency space, hash-based lookup, patented matching algorithms. CRT approach: encode audio features (bass/mid/treble energy, spectral centroid, zero crossing rate, tempo, timbre) as elements of Z/214,414,200. 7 CRT channels = 7 independent fingerprint dimensions. Coupling distance = similarity metric. The mod-11 channel provides noise tolerance for free. No spectrogram needed. No constellation matching.");
  dom_append(dom_body(), hero);

  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Audio Fingerprint Theorem", "Audio features encoded in Z/214,414,200 decompose into 7 independent CRT channels. mod 8 = bass energy. mod 9 = mid-range structure. mod 25 = treble detail. mod 49 = spectral centroid. mod 11 = zero crossing rate. mod 13 = tempo indicator. mod 17 = timbre quality. Per-channel averages over a time window produce a compact 7-element fingerprint. Coupling distance between fingerprints = similarity. mod-11 provides inherent noise tolerance: its small modulus means small perturbations stay within the same residue class. 3+4 split: 3 data channels (mod 8, 25, 49) carry audio content that changes with noise. 4 parity channels (mod 9, 11, 13, 17) carry audio identity that persists. Matching on parity channels survives compression, noise, and partial recording.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 dimensions", "CRT channels", "Each channel captures one spectral feature independently. No cross-feature interference.", "");
  render_finding(g1, "mod-11 robust", "Noise tolerance", "Small noise stays within residue class. Same error detection that protects data protects fingerprints.", "");
  render_finding(g1, "Coupling match", "O(1) compare", "Fingerprint distance = sum of 7 channel differences. No spectrogram. No FFT.", "");
  render_finding(g1, "3+4 split", "Content vs identity", "Data channels = what changes. Parity channels = what persists. Match on the persistent part.", "");
  dom_append(dom_body(), sec1);

  let sec2 = make_section("900px") in
  render_h2(sec2, "Fingerprint Matching");
  make_interactive_widget(sec2, "Query track (0-7):", "dfp-input", "e.g. 3", "Match Fingerprint", "demo_fingerprint_run", "dfp-result");
  let afp = dom_create("div") in
  dom_style(afp, "display", "flex");
  dom_style(afp, "gap", "8px");
  dom_style(afp, "marginTop", "8px");
  let pfp = dom_create("button") in
  dom_text(pfp, "Play Track");
  dom_style(pfp, "background", "#44ff88");
  dom_style(pfp, "color", "#0f0f2a");
  dom_style(pfp, "border", "none");
  dom_style(pfp, "padding", "8px 20px");
  dom_style(pfp, "borderRadius", "6px");
  dom_style(pfp, "cursor", "pointer");
  dom_style(pfp, "fontWeight", "bold");
  dom_on(pfp, "click", "demo_fp_play");
  dom_append(afp, pfp);
  let sfp = dom_create("button") in
  dom_text(sfp, "Stop");
  dom_style(sfp, "background", "#ff4444");
  dom_style(sfp, "color", "#fff");
  dom_style(sfp, "border", "none");
  dom_style(sfp, "padding", "8px 20px");
  dom_style(sfp, "borderRadius", "6px");
  dom_style(sfp, "cursor", "pointer");
  dom_style(sfp, "fontWeight", "bold");
  dom_on(sfp, "click", "demo_fp_stop");
  dom_append(afp, sfp);
  dom_append(sec2, afp);
  render_p(sec2, "Play Track synthesizes 7 oscillators from the CRT fingerprint. Each channel drives one frequency band. 8-track database. Query = selected track with noise. Coupling distance matching.");
  dom_append(dom_body(), sec2);

  let sec3 = make_section("900px") in
  render_h2(sec3, "Noise Tolerance Test");
  let btn = dom_create("button") in
  dom_text(btn, "Test All Tracks (5 Noise Levels)");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_fingerprint_batch");
  dom_append(sec3, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dfp-batch");
  dom_append(sec3, br);
  render_p(sec3, "8 tracks tested with 5 increasing noise levels each. 40 total fingerprint matches. Accuracy measures how many noisy queries correctly identify the original track.");
  dom_append(dom_body(), sec3);

  let sec4 = make_section("800px") in
  render_h2(sec4, "CRT vs Traditional Audio Fingerprinting");
  render_contrast_row(sec4, "Features", "Shazam: spectrogram peaks (time-frequency constellation)", "CRT: 7 channel residues. Per-channel averages. Compact.");
  render_contrast_row(sec4, "Matching", "Hash-based constellation matching (patented)", "Coupling distance: sum of 7 differences. O(1). No hash.");
  render_contrast_row(sec4, "Noise", "Robust by design (peak detection), but patented method", "mod-11 absorbs noise. Same error-detection property. Free from algebra.");
  render_contrast_row(sec4, "Storage", "Constellation hash + time offset per fingerprint", "7 integers. 28 bytes per fingerprint.");
  render_contrast_row(sec4, "Compute", "FFT + peak detection + hash computation", "Modular arithmetic. No FFT. Integer only.");
  render_contrast_row(sec4, "Patent status", "Shazam (US7627477), Gracenote (US7174293), SoundHound", "CC0. Public domain. Forever.");
  render_p(sec4, "HONEST NOTE: This demo uses synthetic audio (7 oscillators per track) and simple CRT matching. Real audio fingerprinting handles complex signals (vocals, instruments, room noise, compression artifacts). Shazam works on real-world audio with billions of tracks. This demo demonstrates the CRT approach on 8 synthetic tracks. Whether CRT fingerprints can scale to real audio databases is untested.");
  dom_append(dom_body(), sec4)
)
