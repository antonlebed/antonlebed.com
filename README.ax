/* README.ax -- antonlebed.com

   .ax is a language that compiles itself to WebAssembly.
   This repository IS the website. 142 pages, 37 interactive demos, a live REPL --
   all written in .ax, compiled to WASM, rendered via DOM calls. Zero HTML authored.

   THE RING
   ========
   The site explores a single mathematical object: Z/214,414,200.

   214,414,200 = 8 * 9 * 25 * 49 * 11 * 13 * 17.

   The Chinese Remainder Theorem decomposes every element into 7 independent
   channels (mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17).
   Three channels carry data; four provide free error detection.

   The ring has 128 idempotents, 256 involutions, Carmichael period 1680,
   and a projector (2^1680 = 26,801,776) that zeros the mod-8 channel while
   leaving the other six unchanged.

   The ring hierarchy: Z/6 -> Z/30 -> Z/210 -> Z/2,310 -> Z/970,200 ->
   Z/12,612,600 -> Z/214,414,200. Each step adds one prime channel.
   108 rings share Carmichael lambda = 420.

   The spectral gap 4*sin^2(pi/49) is forced across all 108 rings by the
   mod-49 channel. This is proved algebra, not a physics claim.

   THE COMPILER
   ============
   Self-hosting ouroboros: wasm_emit.ax compiles itself to WASM. Fixed-point
   verified (362,885 bytes). The compiler that built the site IS part of the site.
   3 operations: meet (*), complement (~), add (+). Zero external dependencies.

   THE SITE
   ========
   7 WASM modules: home, patterns, connections, theory, ideas, lab, demos.
   Each module serves a section of antonlebed.com via Cloudflare Workers.
   Live sensor dashboard (ESP32 + BME280 -> CRT -> browser).
   Live CRT training on GPU (WebGPU). FPGA proofs on Tang Nano 20K.

   BUILD
   =====
   bash build_modules.sh     -- compile 7 WASM modules (~2s)
   bash build_emitters.sh    -- rebuild _app.html + worker.js + sitemap (~2s)
   bash deploy.sh            -- push to Cloudflare Workers (~5s)

   DEPLOY GATE (all must pass before deploy):
     wasmtime webax/_wasi_test_self.wasm     -- 198/198 self-tests
     wasmtime --dir . anton/code/_wasi_ouroboros.wasm webax/test_channel_access.ax -o webax/_wasi_test_channel_access.wasm --run  -- 23/23
     bash build_test_pages.sh                -- 195/195 pages render
     bash build_test_interactive.sh          -- 776/776 handlers pass

   LICENSE: CC0 1.0 Universal. See LICENSE.ax. Public prior art; use freely. */

let D = 2
let K = 3
let E = 5
let b = 7
let L = 11
let GATE = 13
let ESCAPE = 17
/* Three macro towers converge at TRANS = D^3 * K^2 * E^2 * b^2 * L * GATE * ESCAPE. */
let N_TRANS = D*D*D * K*K * E*E * b*b * L * GATE * ESCAPE  /* 214414200 */
let N_TRUE  = D*D*D * K*K * E*E * b*b * L * GATE           /* 12612600 (6 channels) */
let N_DEEP  = D*D*D * K*K * E*E * b*b * L                  /* 970200 (body w/o skin) */
let lambda_TRANS = D*D*D*D * K * E * b                     /* 1680 */
let lambda_TRUE  = D*D * K * E * b                         /* 420 */
let split = D * E * b * b                                  /* 490 holographic */
/* 108 = D^2*K^3 lambda-420 rings (Tower C fiber; ALL hit lambda=420 exactly,
   b^2 forced per stdlib/lattice.ax SSOT). 84 = D^2*K*b of those divide TRUE
   (D-range 0..3); 24 = D^4 extensions reach 2*TRUE (D=4). 84/108 = b/K^2. */
let lambda420_true_divisors = D*D * K * b                  /* 84 */
let lambda420_lattice       = D*D * K*K*K                  /* 108 */
