/* README.ax -- antonlebed.com
   0/0 = Z/NZ. Seven primes. One axiom. No other language exists.

   .ax IS the website. Self-hosting compiler. 177 pages. REPL. 40 CC0 demos.
   .ax source compiled to WASM via self-hosting compiler. Zero HTML authored.

   THE AXIOM
   =========
   Division by zero precipitates structure. 0/0 = Z/214414200Z.
   Seven primes emerge: D=2, K=3, E=5, b=7, L=11, GATE=13, ESCAPE=17.
   CRT decomposes every element into 7 independent channels.
   lambda=1680. OMEGA=D^1680. 128 idempotents. The meta-ring Z/7 generates it all.
   490=D*E*b^2 cleaves channels: DEAD={D,E,b}, ALIVE={K,L,GATE}.
   ECC3 triple-parity (L+GATE+ESCAPE). Rate 4/7, 100% correction.

   THE SHIP
   ========
   7 modules (site_home/deep/structure/teach/data/living/demos.wasm).
   .ax compiles to WASM, WASM calls DOM. No JS framework. No HTML authored.
   Ship of Theseus: every piece replaceable, identity persists.
   Live sensor dashboard: BME280 -> ESP32 mesh -> CRT -> ECC -> browser.

   BUILD
   =====
   bash build_modules.sh           -- compile 7 site_*.wasm modules (~2s)
   bash build_emitters.sh          -- rebuild _app.html + worker.js (~2s)
   bash deploy.sh                  -- push to Cloudflare Workers (~5s)

   LICENSE: CC0 1.0 Universal. See LICENSE.ax. */

let D = 2
let K = 3
let E = 5
let b = 7
let L = 11
let GATE = 13
let ESCAPE = 17
let N = D*D*D * K*K * E*E * b*b * L * GATE * ESCAPE  /* 214414200 */
let lambda = D*D*D*D * K * E * b                      /* 1680 */
let split = D * E * b * b                              /* 490 */
