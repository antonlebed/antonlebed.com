/* bootstrap_emit.ax -- [DEAD] SCAFFOLDING (TT50 S1432, Tower_D bridge instrument).
   .ax IS the bootstrap. True SSOT for _app.html.
   Generates the HTML+JS that loads per-module site_*.wasm in browser.
   Dies when WASI DOM access ships in browsers.

   TOWER_D PRIMARY LENS: this file is the D=2 bridge between runtime hosts.
   Every JS import in the loader is one of four D=2 bridge classes:
     (1) .ax source    <-> JS output          (compilation, D=2 representation)
     (2) JS heap        <-> WASM linear memory (readStr + js_alloc, D=2 space)
     (3) browser event  <-> WASM export        (dom_on/on1/on2, D=2 invocation)
     (4) DOM handle     <-> WASM i32           (_dom[h] map, D=2 namespace)
   The JS it EMITS is one of the (currently three) non-.ax scaffolding
   substrates on the production path -- alongside worker.js (from
   worker_emit.ax) and sitemap.xml (from sitemap_emit.ax). All three die
   when WASI DOM access ships to browsers + Cloudflare Workers gain native
   WASM routing. D=2 bridges between runtime hosts cannot dissolve further
   without crossing the host boundary itself. The file itself IS .ax; the
   [DEAD] marker names the OUTPUT's fate, not the source file's substrate.

   TOWER_E CORRESPONDENT (E=5 emit sections): emit_bootstrap concatenates
     head + route_map + loader_a + loader_b + loader_c
   Five observation slots on JS-side runtime (same E=5 signature as TT49
   tokenizer's five keyword-length buckets).

   TOWER_K CORRESPONDENT (K=3 loader chunks): loader_{a,b,c} decompose the
   JS import namespace into three closure groups:
     loader_a: environment (math + game stubs + ring primitives)
     loader_b: DOM manipulation + GPU training
     loader_c: canvas 2D + audio + WASI stubs + SPA navigation
   E*K = 5*3 = 15 = primorial(47) channel count (S1429 naming-loop seam;
   matches TT49 post-strip tokenizer keyword count).

   12 top-level functions =
     3 SSOT ring constants (js_ring_{n,qs,ps})   Tower C fibered heartbeat
     2 SSOT import helpers (js_ring_fns, js_grid_stubs)  Tower C (S2018 SSOT)
     1 GPU training shader (gpu_train_wgsl)       Tower_b (7-channel GPU)
     1 boot_head                                  Tower_D (HTML scaffold)
     3 boot_loader_{a,b,c}                        Tower_K (closure chunks)
     1 boot_route_map                             Tower A (auto-gen from page_list.ax)
     1 emit_bootstrap                             composer
   Total = 5 + 1 + 1 + 3 + 1 + 1 = 12 = D^2 * K.

   SSOT: js_ring_n/qs/ps are SHARED with worker_emit.ax (same compilation unit
   via build_emitters.sh concatenation). Change values HERE = propagates to
   bootstrap and worker simultaneously. TRANS ring: N = 214414200, 7 CRT moduli
   {8,9,25,49,11,13,17}, 7 axiom primes {2,3,5,7,11,13,17}.

   R3 CROSS-FILE (TT50 yield): ZERO dead functions. Every top-level fn has a
   live consumer (emit_bootstrap composes all; worker_emit reuses js_ring_fns+js_grid_stubs;
   wasm_emit unconditionally emits game_count()=29 + dom_count()=55 imports
   so the browser loader MUST provide stubs; page .ax code calls coupling/
   kingdom/eigenvalue/mirror/crt_r and the dom_ / cvs_ / aud_ / gpu_ import
   families). The file's [DEAD] marker refers to the whole output scaffold
   dying when WASI DOM ships in browsers, not to any subpath.

   5 sections: head, route_map, loader(a,b,c). repl(a,b,c) STRIPPED S1317. */

/* SSOT: ring constants for JS emit. Change HERE, propagates everywhere.
   Used by bootstrap_emit.ax + worker_emit.ax (same compilation unit). */
fn js_ring_n() = "214414200"
fn js_ring_qs() = "[8,9,25,49,11,13,17]"
fn js_ring_ps() = "[2,3,5,7,11,13,17]"

/* SSOT: ring computation JS functions. Used by bootstrap + worker (same compilation unit).
   coupling, kingdom, eigenvalue, mirror, crt_r, rand. Change HERE = both outputs update. */
fn js_ring_fns() =
  "        coupling: function(n){var N=${js_ring_n()};n=((n%N)+N)%N;function g(a,b){while(b){var t=b;b=a%b;a=t;}return a;}return N/g(n||N,N);},\n"
  + "        kingdom: function(n){var N=${js_ring_n()};n=((n%N)+N)%N;if(n===0)return 0;var ps=${js_ring_ps()};for(var i=0;i<7;i++)if(n%ps[i]===0)return ps[i];return 1;},\n"
  + "        eigenvalue: function(n){var N=${js_ring_n()},qs=${js_ring_qs()};n=((n%N)+N)%N;var t=0;for(var i=0;i<7;i++)t+=2*Math.cos(2*Math.PI*(n%qs[i])/qs[i]);return Math.round(t*1000);},\n"
  + "        mirror: function(n){var N=${js_ring_n()};return((N-(n%N))%N);},\n"
  + "        crt_r: function(n,c){var N=${js_ring_n()},qs=${js_ring_qs()};return((n%N)+N)%N%qs[c];},\n"
  + "        rand: function(n){return Math.floor(Math.random()*n);},\n"

/* SSOT: grid import stubs (no-op). Used by bootstrap + worker. */
fn js_grid_stubs() =
  "        grid: function(){return 0;}, gset: function(){return 0;},\n"
  + "        show_grid: function(){return 0;}, hflip: function(){return 0;},\n"
  + "        vflip: function(){return 0;}, rot90: function(){return 0;},\n"
  + "        transpose: function(){return 0;}, grid_eq: function(){return 0;},\n"

/* GPU CRT training kernel: mini-batch SGD + leaky ReLU 25% + golden interleave.
   7 networks (1 standard + 6 CRT channels). Single workgroup (max 64 data points).
   All epochs run inside one dispatch. Weights in workgroup shared memory.
   Matches CPU training fixes from S1362 (mini-batch) + S1363 (interleave). */
fn gpu_train_wgsl() =
  "@group(0)@binding(0) var<storage,read_write> weights:array<i32>; "
  + "@group(0)@binding(1) var<storage,read> data:array<i32>; "
  + "@group(0)@binding(2) var<storage,read_write> losses:array<i32>; "
  + "@group(0)@binding(3) var<uniform> params:vec4i; "
  + "var<workgroup> w:array<i32,135>; "
  + "var<workgroup> g:array<atomic<i32>,135>; "
  + "fn nf(base:u32,nh:u32,x0:i32,x1:i32)->i32{"
  + "var o:i32=w[base+nh*4u];"
  + "for(var j:u32=0u;j<nh;j=j+1u){"
  + "let r=w[base+j*2u]*x0/1000+w[base+j*2u+1u]*x1/1000+w[base+nh*2u+j];"
  + "o=o+w[base+nh*3u+j]*select(r/4,r,r>0)/1000;} return o;} "
  + "fn nb(base:u32,nh:u32,x0:i32,x1:i32,tgt:i32){"
  + "var hr:array<i32,8>;var h:array<i32,8>;"
  + "for(var j:u32=0u;j<nh;j=j+1u){"
  + "let r=w[base+j*2u]*x0/1000+w[base+j*2u+1u]*x1/1000+w[base+nh*2u+j];"
  + "hr[j]=r;h[j]=select(r/4,r,r>0);}"
  + "var o:i32=w[base+nh*4u];"
  + "for(var j:u32=0u;j<nh;j=j+1u){o=o+w[base+nh*3u+j]*h[j]/1000;}"
  + "let d=clamp(o-tgt,-1000,1000);"
  + "for(var j:u32=0u;j<nh;j=j+1u){atomicAdd(&g[base+nh*3u+j],d*h[j]/1000);}"
  + "atomicAdd(&g[base+nh*4u],d);"
  + "for(var j:u32=0u;j<nh;j=j+1u){"
  + "let dh=select(w[base+nh*3u+j]*d/4000,w[base+nh*3u+j]*d/1000,hr[j]>0);"
  + "atomicAdd(&g[base+j*2u],dh*x0/1000);"
  + "atomicAdd(&g[base+j*2u+1u],dh*x1/1000);"
  + "atomicAdd(&g[base+nh*2u+j],dh);}} "
  + "@compute @workgroup_size(64) fn main(@builtin(local_invocation_id) lid:vec3u){"
  + "let idx=lid.x;let nd=u32(params.x);let ep=u32(params.y);let lr=params.z;"
  + "let bsz=select(nd/5u,nd,nd<=10u);"
  + "let nbt=select((nd+bsz-1u)/bsz,1u,bsz==0u);"
  + "if(idx==0u){for(var i:u32=0u;i<135u;i=i+1u){w[i]=weights[i];}}"
  + "workgroupBarrier();"
  + "for(var e:u32=0u;e<ep;e=e+1u){"
  + "for(var bi:u32=0u;bi<nbt;bi=bi+1u){"
  + "let bs=bi*bsz;let be=min(bs+bsz,nd);let bn=be-bs;"
  + "if(idx==0u){for(var i:u32=0u;i<135u;i=i+1u){atomicStore(&g[i],0);}}"
  + "workgroupBarrier();"
  + "for(var bp:u32=idx;bp<bn;bp=bp+64u){"
  + "let p=((bs+bp)*137u)%nd;"
  + "let x0=data[p*3u];let x1=data[p*3u+1u];let t=data[p*3u+2u];"
  + "nb(0u,8u,x0,x1,t);"
  + "for(var c:u32=0u;c<6u;c=c+1u){nb(33u+c*17u,4u,x0,x1,t);}}"
  + "workgroupBarrier();"
  + "if(idx==0u){for(var i:u32=0u;i<135u;i=i+1u){"
  + "let nw=w[i]-lr*atomicLoad(&g[i])/i32(bn)/1000;"
  + "w[i]=clamp(nw,-5000,5000);}}"
  + "workgroupBarrier();}}"
  + "if(idx==0u){for(var i:u32=0u;i<135u;i=i+1u){weights[i]=w[i];}}"
  + "for(var p:u32=idx;p<nd;p=p+64u){let x0=data[p*3u];let x1=data[p*3u+1u];let t=data[p*3u+2u];"
  + "let so=nf(0u,8u,x0,x1);let sd=so-t;losses[p*2u]=sd*sd/1000;"
  + "var cs:i32=0;for(var c:u32=0u;c<6u;c=c+1u){cs=cs+nf(33u+c*17u,4u,x0,x1);}"
  + "let co=cs/6;let cd=co-t;losses[p*2u+1u]=cd*cd/1000;}}"

fn boot_head() =
  "<!DOCTYPE html>\n"
  + "<!-- [DEAD] SCAFFOLDING -- dies when WASI DOM access ships in browsers.\n"
  + "     ~30L JS bootstrap: loads per-module site_*.wasm, provides DOM import handlers.\n"
  + "     This is the LAST non-.ax code. .ax talks to browser directly via these imports. -->\n"
  + "<html lang=\"en\">\n"
  + "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>antonlebed.com</title><link rel=\"icon\" href=\"/favicon.png\"><meta property=\"og:image\" content=\"https://antonlebed.com/og-image.jpg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"antonlebed.com\"></head>\n"
  + "<body>\n"
  + "<script>\n"
  + "/* [DEAD] DOM import handlers -- JS side of WASM DOM imports */\n"
  + "var _domId = 0, _dom = {0: document.body}, _rafActive = false, _spaBase = 0, _qc = {}, _aud = null, _osc = [], _gpuD = null, _gpuOk = 0, _spaInited = false;\n"
  + "if(navigator.gpu){navigator.gpu.requestAdapter().then(function(a){if(a){var L=a.limits;a.requestDevice({requiredLimits:{maxBufferSize:L.maxBufferSize,maxStorageBufferBindingSize:L.maxStorageBufferBindingSize}}).then(function(d){_gpuD=d;_gpuOk=1;});}});}\n"
  + "var _keys = {};\n"
  + "window.addEventListener('keydown', function(e) { _keys[e.keyCode] = 1; var t=e.target.tagName; if(t!=='TEXTAREA'&&t!=='INPUT'&&(e.keyCode>=37&&e.keyCode<=40||e.keyCode==32))e.preventDefault(); });\n"
  + "window.addEventListener('keyup', function(e) { _keys[e.keyCode] = 0; });\n"
  + "function readStr(mem, ptr) {\n"
  + "  var m = new Int32Array(mem.buffer), n = m[ptr/4], s = '';\n"
  + "  for (var i = 0; i < n; i++) s += String.fromCharCode(m[ptr/4+1+i]);\n"
  + "  return s;\n"
  + "}\n"

fn boot_loader_a() =
  "(async function() {\n"
  + "  var mem = null, _hashPtr = 0, _catPtr = 0;\n"
  + "  function rs(p) { return readStr(mem, p); }\n"
  + "  var _p = location.pathname.split('/').filter(Boolean);\n"
  + "  var _r = _p.length >= 2 ? _p[_p.length - 1] : (_p[0] || 'home');\n"
  + "  if (location.hash.length > 1) _r = location.hash.slice(1);\n"
  + "  _currentModule = _routeMod(_r);\n"
  + "  var _wr = await fetch('/site_' + _currentModule + '.wasm', {cache:'no-cache'});\n"
  + "  var _wasmBytes = await _wr.arrayBuffer();\n"
  + "  var _imports = { env: {\n"
  + "    show_int: function(v) { console.log(v); return v; },\n"
  + "    show_str: function(p) { console.log(rs(p)); return p; },\n"
  + "    show_float: function(v) { console.log(v); return 0; },\n"
  + "    /* Game/ring import stubs -- needed because coupling() etc. in interactive widgets triggers ALL game imports */\n"
  + "    canvas_clear: function() { return 0; }, canvas_rect: function() { return 0; },\n"
  + "    canvas_circle: function() { return 0; }, canvas_line: function() { return 0; },\n"
  + "    canvas_pixel: function() { return 0; }, canvas_text: function() { return 0; },\n"
  + "    canvas_width: function() { return Math.min(800, window.innerWidth - 32); }, canvas_height: function() { return Math.min(600, Math.round((window.innerWidth - 32) * 0.75)); },\n"
  + "    mouseX: function() { return 0; }, mouseY: function() { return 0; },\n"
  + "    mouseClick: function() { return 0; }, keyPressed: function() { return 0; },\n"
  + "    now_ms: function() { return Date.now(); },\n"
  + "    beep: function() { return 0; }, playNote: function() { return 0; }, stopSound: function() { return 0; },\n"
  + "    gvar: function() { return 0; }, svar: function() { return 0; },\n"
  + "    gvar_f: function() { return 0; }, svar_f: function() { return 0; },\n"
  + "    set_ring: function() { return 0; },\n"
  + js_ring_fns()
  + js_grid_stubs()

fn boot_loader_b() =
  "    dom_create: function(p) { var t=rs(p); if(!t)t='div'; var el = document.createElement(t); _dom[++_domId] = el; return _domId; },\n"
  + "    dom_text: function(h, p) { var el=_dom[h]; if(el){var s=rs(p);el.textContent=s;if(el.tagName==='TEXTAREA'||el.tagName==='INPUT')el.value=s;} return 0; },\n"
  + "    dom_attr: function(h, np, vp) { if (_dom[h]) _dom[h].setAttribute(rs(np), rs(vp)); return 0; },\n"
  + "    dom_style: function(h, pp, vp) { if (_dom[h]) _dom[h].style[rs(pp)] = rs(vp); return 0; },\n"
  + "    dom_append: function(ph, ch) { if (_dom[ph] && _dom[ch]) _dom[ph].appendChild(_dom[ch]); return 0; },\n"
  + "    dom_body: function() { return 0; },\n"
  + "    dom_inner: function(h, p) { if (_dom[h]) _dom[h].innerHTML = rs(p); return 0; },\n"
  + "    dom_on: function(h, ep, fnp) { if (_dom[h]) { var e = rs(ep), f = rs(fnp); _dom[h].addEventListener(e, function() { try { if (wasm.instance.exports[f]) { _arenaReset(); wasm.instance.exports[f](); } else console.warn('no export:',f); } catch(err) { console.error(f+':',err); } }); } return 0; },\n"
  + "    dom_on1: function(h, ep, fnp) { if (_dom[h]) { var e = rs(ep), f = rs(fnp); _dom[h].addEventListener(e, function(ev) { try { if (wasm.instance.exports[f]) { _arenaReset(); wasm.instance.exports[f](ev.keyCode || ev.which || ev.button || 0); } } catch(err) { console.error(f+':',err); } }); } return 0; },\n"
  + "    dom_on2: function(h, ep, fnp) { if (_dom[h]) { var e = rs(ep), f = rs(fnp); _dom[h].addEventListener(e, function(ev) { try { if (wasm.instance.exports[f]) { _arenaReset(); wasm.instance.exports[f](ev.offsetX || 0, ev.offsetY || 0); } } catch(err) { console.error(f+':',err); } }); } return 0; },\n"
  + "    dom_window: function(ep, fnp) { var e = rs(ep), f = rs(fnp); window.addEventListener(e, function() { if (wasm.instance.exports[f]) wasm.instance.exports[f](); }); return 0; },\n"
  + "    dom_query: function(p) { var s = rs(p); if (_qc[s] !== undefined && _dom[_qc[s]]) return _qc[s]; try { var el = document.querySelector(s); } catch(e) { return -1; } if (el) { _dom[++_domId] = el; _qc[s] = _domId; return _domId; } return -1; },\n"
  + "    dom_head_meta: function(np, vp) { var n = rs(np), v = rs(vp), ex = document.head.querySelector('meta[name=\"' + n + '\"]'); if (ex) ex.content = v; else { var m = document.createElement('meta'); m.name = n; m.content = v; document.head.appendChild(m); } return 0; },\n"
  + "    dom_focus: function(h) { if (_dom[h] && _dom[h].focus) _dom[h].focus(); return 0; },\n"
  + "    time_ms: function() { return Math.floor(performance.now()); },\n"
  + "    dom_fetch: function(p, el) { var url = rs(p); fetch(url).then(function(r){return r.text();}).then(function(t){ if(_dom[el]){_dom[el].textContent=t;_dom[el].click();} }).catch(function(e){ if(_dom[el]){_dom[el].textContent='ERROR';_dom[el].click();} }); return 0; },\n"
  + "    dom_timeout: function(el, ms) { setTimeout(function(){ if(_dom[el])_dom[el].click(); }, ms); return 0; },\n"
  + "    gpu_train: function(buf,nd,epochs,lr,tgt) { if(!_gpuD){var e=_dom[tgt];if(e)e.innerHTML='<p style=\"color:#ff6666\">No WebGPU</p>';return 0;}"
  + "var m=new Int32Array(mem.buffer),nw=135,wt=new Int32Array(nw),dt=new Int32Array(nd*3);"
  + "for(var i=0;i<nw;i++)wt[i]=m[buf/4+1+i];for(var i=0;i<nd*3;i++)dt[i]=m[buf/4+1+nw+i];"
  + "(async function(){var d=_gpuD,ws='" + gpu_train_wgsl() + "';"
  + "var sm=d.createShaderModule({code:ws});"
  + "var bg=d.createBindGroupLayout({entries:["
  + "{binding:0,visibility:4,buffer:{type:'storage'}},"
  + "{binding:1,visibility:4,buffer:{type:'read-only-storage'}},"
  + "{binding:2,visibility:4,buffer:{type:'storage'}},"
  + "{binding:3,visibility:4,buffer:{type:'uniform'}}]});"
  + "var pl=d.createComputePipeline({layout:d.createPipelineLayout({bindGroupLayouts:[bg]}),compute:{module:sm,entryPoint:'main'}});"
  + "var bW=d.createBuffer({size:nw*4,usage:140,mappedAtCreation:true});new Int32Array(bW.getMappedRange()).set(wt);bW.unmap();"
  + "var bD=d.createBuffer({size:nd*3*4,usage:132,mappedAtCreation:true});new Int32Array(bD.getMappedRange()).set(dt);bD.unmap();"
  + "var bL=d.createBuffer({size:nd*2*4,usage:140});"
  + "var bP=d.createBuffer({size:16,usage:72,mappedAtCreation:true});new Int32Array(bP.getMappedRange()).set([nd,epochs,lr,0]);bP.unmap();"
  + "var bWR=d.createBuffer({size:nw*4,usage:9});var bLR=d.createBuffer({size:nd*2*4,usage:9});"
  + "var grp=d.createBindGroup({layout:bg,entries:["
  + "{binding:0,resource:{buffer:bW}},{binding:1,resource:{buffer:bD}},"
  + "{binding:2,resource:{buffer:bL}},{binding:3,resource:{buffer:bP}}]});"
  + "var t0=performance.now();"
  + "var enc=d.createCommandEncoder();var pass=enc.beginComputePass();"
  + "pass.setPipeline(pl);pass.setBindGroup(0,grp);pass.dispatchWorkgroups(1);pass.end();"
  + "enc.copyBufferToBuffer(bW,0,bWR,0,nw*4);enc.copyBufferToBuffer(bL,0,bLR,0,nd*2*4);"
  + "d.queue.submit([enc.finish()]);await d.queue.onSubmittedWorkDone();"
  + "var gms=performance.now()-t0;"
  + "await bWR.mapAsync(1);var nw2=new Int32Array(bWR.getMappedRange().slice(0));bWR.unmap();"
  + "await bLR.mapAsync(1);var ld=new Int32Array(bLR.getMappedRange().slice(0));bLR.unmap();"
  + "var sl=0,cl=0;for(var i=0;i<nd;i++){sl+=ld[i*2];cl+=ld[i*2+1];}sl=Math.floor(sl/nd);cl=Math.floor(cl/nd);"
  + "var tw=document.querySelector('#ct-w');if(tw){if(tw.tagName==='TEXTAREA')tw.value=nw2.join(',');else tw.textContent=nw2.join(',');}"
  + "var en=document.querySelector('#ct-epoch-n');var epn=0;if(en){epn=parseInt(en.value||en.textContent||'0')+epochs;if(en.tagName==='TEXTAREA')en.value=''+epn;else en.textContent=''+epn;}"
  + "var lh=document.querySelector('#ct-loss-hist');if(lh){var hv=lh.value||lh.textContent||'';var nv=hv?(hv+','+sl+','+cl):(sl+','+cl);if(lh.tagName==='TEXTAREA')lh.value=nv;else lh.textContent=nv;}"
  + "var el=_dom[tgt];if(el)el.innerHTML='<div style=\"background:#0a0a18;border:1px solid #333;border-radius:8px;padding:12px;margin:8px 0\">"
  + "<p style=\"color:#ffd700;margin:0 0 4px\">GPU Training: '+epochs+' epochs on '+nd+' points (mini-batch SGD)</p>"
  + "<p style=\"color:#88ddaa;margin:2px 0\">GPU: '+gms.toFixed(2)+'ms | Loss: std='+sl+' crt='+cl+'</p>"
  + "<p style=\"color:#44ff88;margin:2px 0\">7 networks parallel (1 standard + 6 CRT). Single workgroup, atomic gradients.</p></div>';"
  + "try{_arenaReset();if(wasm.instance.exports['on_ct_gpu_done'])wasm.instance.exports['on_ct_gpu_done']();}catch(err){console.error('gpu_done:',err);}"
  + "bW.destroy();bD.destroy();bL.destroy();bP.destroy();bWR.destroy();bLR.destroy();"
  + "})();return 0; },\n"
  + "    get_hash: function() {\n"
  + "      /* Real URL routing: /category/page -> extract page slug */\n"
  + "      var parts = location.pathname.split('/').filter(Boolean);\n"
  + "      var h = parts.length >= 2 ? parts[parts.length - 1] : (parts[0] || 'home');\n"
  + "      /* Fallback: hash routing for backward compat */\n"
  + "      if (location.hash.length > 1) h = location.hash.slice(1);\n"
  + "      var ptr = _hashPtr;\n"
  + "      var m = new Int32Array(mem.buffer);\n"
  + "      m[ptr/4] = h.length;\n"
  + "      for (var i = 0; i < h.length; i++) m[ptr/4+1+i] = h.charCodeAt(i);\n"
  + "      return ptr;\n"
  + "    },\n"
  + "    dom_value: function(h) {\n"
  + "      var v = (_dom[h] && (_dom[h].value || _dom[h].textContent)) || '';\n"
  + "      var ptr = wasm.instance.exports.js_alloc(4 + v.length * 4);\n"
