/* sitemap_emit.ax -- [DEAD] SCAFFOLDING
   Auto-generates sitemap.xml from page_list.ax (shared SSOT with core.ax).
   Also collects _file() paths for entry_emit.ax (module build composition).
   Dies when .ax replaces all non-.ax build tooling. */

fn sm_url(path:str) =
  "  <url><loc>https://antonlebed.com" + path + "</loc><changefreq>weekly</changefreq></url>\n"

/* _rp: emitter version stores section+slug+module into arrays.
   _section: sets current module (called from page_list.ax before each group).
   _file: stores source file path for the current module (entry_emit consumes).
   boot_route_map (bootstrap_emit.ax) uses _sm_mod to generate the JS route map. */
let _sm_sec = alloc(200)
let _sm_slug = alloc(200)
let _sm_mod = alloc(200)
let _sm_n = [0]
let _sm_cur_mod = alloc(1)

/* Entry file data: up to 40 files per module, 8 modules (S2068 lab split). */
let _ef_files = alloc(320)
let _ef_counts = alloc(8)
let _ef_mods = alloc(8)
let _ef_nmod = [0]
let _ef_cur = [0]

fn _ef_mod_idx(mod:str) = (
  mut i = 0;
  mut found = 0 - 1;
  while i < _ef_nmod[0] do (
    if streq(_ef_mods[i], mod) == 1 then mut found = i else 0;
    mut i = i + 1
  );
  found
)

fn _section(mod:str) = (
  set(_sm_cur_mod, 0, mod);
  let idx = _ef_mod_idx(mod) in
  if idx >= 0 then set(_ef_cur, 0, idx)
  else (
    let n = _ef_nmod[0] in
    set(_ef_mods, n, mod);
    set(_ef_counts, n, 0);
    set(_ef_cur, 0, n);
    set(_ef_nmod, 0, n + 1)
  )
)

fn _file(path:str) = (
  let m = _ef_cur[0] in
  let c = _ef_counts[m] in
  set(_ef_files, m * 40 + c, path);
  set(_ef_counts, m, c + 1)
)

fn _group(_g:str) = 0

/* Section slug collection for auto-generated section URLs in sitemap. */
let _sm_secs = alloc(10)
let _sm_sec_mods = alloc(10)
let _sm_nsec = [0]

fn _sec_meta(slug:str, _n:str, _r:str, _d:str) = (
  let i = _sm_nsec[0] in
  set(_sm_secs, i, slug);
  set(_sm_sec_mods, i, _sm_cur_mod[0]);
  set(_sm_nsec, 0, i + 1)
)

fn _rp(sec:str, slug:str, _t:str, _d:str) = (
  let i = _sm_n[0] in
  set(_sm_sec, i, sec);
  set(_sm_slug, i, slug);
  set(_sm_mod, i, _sm_cur_mod[0]);
  set(_sm_n, 0, i + 1)
)

fn _sm_s(v:str):str = v

fn _sm_load_pages() = (
include "webax/page_list.ax"
0
)

fn emit_sitemap_pages():str = (
  mut out = "";
  mut i = 0;
  while i < _sm_n[0] do (
    mut out = out + sm_url("/" + _sm_s(_sm_sec[i]) + "/" + _sm_s(_sm_slug[i]));
    mut i = i + 1
  );
  out
)

fn emit_sitemap_sections():str = (
  mut out = "";
  mut i = 0;
  while i < _sm_nsec[0] do (
    mut out = out + sm_url("/" + _sm_s(_sm_secs[i]));
    mut i = i + 1
  );
  out
)

fn emit_sitemap() =
  "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
  + "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
  + sm_url("/")
  + emit_sitemap_sections()
  + sm_url("/repl")
  + emit_sitemap_pages()
  + "</urlset>\n"
