  render_p(sec, "Five inner primes build the body (Z/970,200). The sixth, 13, wraps a boundary (Z/12,612,600). The seventh, 17, completes the ring (Z/214,414,200). The full vocabulary is ten terms:");
  let dec = render_p(sec, "-1 (mirror) . 0 (birth) . 1 (existence) . 2 . 3 . 5 . 7 . 11 . 13 (boundary) . 1,576,576 (projector)") in
