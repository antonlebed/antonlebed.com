fn render_hero() = (
  let hero = dom_create("section") in
  dom_style(hero, "display", "flex");
  dom_style(hero, "flexDirection", "column");
  dom_style(hero, "alignItems", "center");
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(64px, 12vw, 100px) clamp(12px, 4vw, 24px) 60px");
  dom_style(hero, "background", "linear-gradient(180deg, #050508 0%, #0a0a1f 50%, #050508 100%)");
  let h1 = dom_create("h1") in
  dom_text(h1, "0/0 = Z/214414200Z");
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.5em, 6vw, 2.8em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "letterSpacing", "clamp(1px, 0.4vw, 3px)");
  dom_style(h1, "marginBottom", "24px");
  dom_style(h1, "lineHeight", "1.3");
  dom_style(h1, "maxWidth", "700px");
  dom_style(h1, "textShadow", "0 0 80px #ffd70020, 0 0 160px #ffd70010");
  dom_append(hero, h1);
  let sub = dom_create("p") in
  dom_text(sub, "Seven primes. One ring. ~2,000 proved theorems.");
  dom_style(sub, "fontSize", "1.4em");
  dom_style(sub, "color", "#b0b0c0");
  dom_style(sub, "maxWidth", "600px");
  dom_style(sub, "marginBottom", "32px");
  dom_append(hero, sub);
  let feats = dom_create("div") in
  dom_style(feats, "display", "flex");
  dom_style(feats, "flexWrap", "wrap");
  dom_style(feats, "justifyContent", "center");
  dom_style(feats, "gap", "16px");
  dom_style(feats, "maxWidth", "700px");
  dom_style(feats, "marginBottom", "24px");
  let mk_feat = fn(label:str, color:str) = (
    let f = dom_create("span") in
    dom_text(f, label);
    dom_style(f, "padding", "6px 14px");
    dom_style(f, "borderRadius", "20px");
    dom_style(f, "border", "1px solid " + color);
    dom_style(f, "color", color);
    dom_style(f, "fontSize", "0.85em");
    dom_style(f, "letterSpacing", "1px");
    dom_append(feats, f)
  ) in
  mk_feat("Self-hosting compiler", "#ffd700");
  mk_feat("Live REPL", "#44ff88");
  mk_feat("40 CC0 demos", "#4fc3f7");
  mk_feat("FPGA verified", "#ff9944");
  mk_feat("Dual-parity ECC", "#ff44aa");
  dom_append(hero, feats);
  let note = dom_create("p") in
  dom_text(note, "A self-compiling language running a live website. Every claim verifiable. Try the REPL.");
  dom_style(note, "fontSize", "1em");
  dom_style(note, "color", "#888899");
  dom_style(note, "maxWidth", "500px");
  dom_style(note, "marginTop", "8px");
  dom_append(hero, note);
  dom_append(dom_body(), hero)
)

fn render_step(parent, num:str, title:str, text:str) = (
  let step = dom_create("div") in
  dom_style(step, "marginBottom", "36px");
  let h3 = dom_create("h3") in
  dom_text(h3, "Step ${num}: ${title}");
  ct_gold(h3);
  dom_style(h3, "fontSize", "1.1em");
  dom_style(h3, "fontFamily", "'Courier New', monospace");
  dom_style(h3, "marginBottom", "8px");
  dom_append(step, h3);
  let p = dom_create("p") in
  dom_text(p, text);
  dom_style(p, "margin", "0");
  dom_append(step, p);
  dom_append(parent, step);
  step
)

fn render_derivation() = (
  let sec = make_section("700px") in
  let h2 = dom_create("h2") in
  dom_text(h2, "The Derivation");
  ct_heading(h2);
  dom_style(h2, "fontSize", "1.8em");
  dom_style(h2, "marginBottom", "32px");
  dom_append(sec, h2);
  render_step(sec, "1", "The Question",
    "What is 0/0? Standard math says undefined. But in modular arithmetic (Z/NZ), 0/0 is the set of ALL elements. Not undefined -- maximally defined. The void contains everything.");
  render_step(sec, "2", "The Chain",
    "From 1, the Cunningham chain doubles and adds one: 1, 3, 7. A second chain from 2: 2, 5, 11. They yield exactly five inner primes: 2, 3, 5, 7, 11. Then 13 = 2^2 + 3^2 wraps a boundary. And 17, where 5 x 7 = 1 mod 17, completes the ring. Seven primes. Forced.");
  render_step(sec, "3", "The Ring",
    "Each inner prime at its minimum closing power: 2^3, 3^2, 5^2, 7^2, 11 = 970,200. Times 13: 12,612,600. Times 17: 214,414,200. Not chosen. Derived.");
  let omega = OMEGA_VAL in
  let omega_sq = ring_mul(omega, omega) in
  render_step(sec, "4", "The Decomposition",
    "By the Chinese Remainder Theorem (300 BC), every number in the ring splits into 7 independent channels. One number, seven views. 490 = 2 x 5 x 7^2 cleaves them: {2, 5, 7} project to 0, while {3, 11, 13, 17} survive.");
  let proof = dom_create("div") in
  ct_code_block(proof);
  dom_style(proof, "marginBottom", "36px");
  let proof_title = dom_create("p") in
  dom_style(proof_title, "margin", "0 0 8px");
  dom_style(proof_title, "color", "#ffd700");
  dom_text(proof_title, "Live computation (running in WASM right now):");
  dom_append(proof, proof_title);
  let proof_line1 = dom_create("p") in
  dom_style(proof_line1, "margin", "4px 0");
  dom_style(proof_line1, "color", "#88ddaa");
  dom_text(proof_line1, "2^420 mod 12,612,600 = ${omega} (the projector)");
  dom_append(proof, proof_line1);
  let proof_line2 = dom_create("p") in
  dom_style(proof_line2, "margin", "4px 0");
  dom_style(proof_line2, "color", "#88ddaa");
  dom_text(proof_line2, "${omega} x ${omega} mod 12,612,600 = ${omega_sq} (idempotent!)");
  dom_append(proof, proof_line2);
  let proof_line3 = dom_create("p") in
  dom_style(proof_line3, "margin", "4px 0");
  dom_style(proof_line3, "color", "#a0a0b0");
  dom_text(proof_line3, "This page is .ax code compiled to WASM. The math IS the page.");
  dom_append(proof, proof_line3);
  dom_append(sec, proof);

  /* Interactive CRT verification -- first dom_on on live site */
  let verify_btn = dom_create("button") in
  dom_inner(verify_btn, "Verify CRT channels");
  dom_style(verify_btn, "background", "#1a1a2e");
  dom_style(verify_btn, "color", "#ffd700");
  dom_style(verify_btn, "border", "1px solid #ffd700");
  dom_style(verify_btn, "padding", "10px 24px");
  dom_style(verify_btn, "borderRadius", "6px");
  dom_style(verify_btn, "cursor", "pointer");
  dom_style(verify_btn, "fontSize", "14px");
  dom_style(verify_btn, "fontFamily", "'Courier New', monospace");
  dom_style(verify_btn, "marginBottom", "12px");
  dom_on(verify_btn, "click", "verify_crt");
  dom_append(sec, verify_btn);
  let crt_result = dom_create("div") in
  dom_attr(crt_result, "id", "crt-verify");
  ct_code_block(crt_result);
  dom_append(sec, crt_result);

  /* Interactive CRT calculator -- first dom_value on live site */
  let calc_label = dom_create("p") in
  dom_text(calc_label, "Try any number:");
  dom_style(calc_label, "color", "#b8b8c8");
  dom_style(calc_label, "marginTop", "24px");
  dom_style(calc_label, "marginBottom", "8px");
  dom_append(sec, calc_label);
  let calc_row = dom_create("div") in
  dom_style(calc_row, "display", "flex");
  dom_style(calc_row, "gap", "8px");
  dom_style(calc_row, "alignItems", "center");
  dom_style(calc_row, "marginBottom", "12px");
  let crt_input = dom_create("input") in
  dom_attr(crt_input, "id", "crt-input");
  dom_attr(crt_input, "type", "text");
  dom_attr(crt_input, "placeholder", "e.g. 42");
  dom_style(crt_input, "background", "#111");
  dom_style(crt_input, "color", "#ffd700");
  dom_style(crt_input, "border", "1px solid #333");
  dom_style(crt_input, "padding", "8px 12px");
  dom_style(crt_input, "borderRadius", "6px");
  dom_style(crt_input, "fontFamily", "'Courier New', monospace");
  dom_style(crt_input, "fontSize", "14px");
  dom_style(crt_input, "width", "120px");
  dom_append(calc_row, crt_input);
  let calc_btn = dom_create("button") in
  dom_inner(calc_btn, "Decompose");
  dom_style(calc_btn, "background", "#1a1a2e");
  dom_style(calc_btn, "color", "#ffd700");
  dom_style(calc_btn, "border", "1px solid #ffd700");
  dom_style(calc_btn, "padding", "8px 16px");
  dom_style(calc_btn, "borderRadius", "6px");
  dom_style(calc_btn, "cursor", "pointer");
  dom_style(calc_btn, "fontSize", "14px");
  dom_style(calc_btn, "fontFamily", "'Courier New', monospace");
  dom_on(calc_btn, "click", "compute_crt");
  dom_append(calc_row, calc_btn);
  dom_append(sec, calc_row);
  let crt_calc_result = dom_create("div") in
  dom_attr(crt_calc_result, "id", "crt-result");
  ct_code_block(crt_calc_result);
  dom_append(sec, crt_calc_result);

  dom_append(dom_body(), sec)
)

fn render_shift(parent, tag:str, before:str, after:str) = (
  let card = dom_create("div") in
  dom_style(card, "marginBottom", "20px");
  dom_style(card, "borderRadius", "12px");
  dom_style(card, "overflow", "hidden");
  dom_style(card, "border", "1px solid #111");
  let bef = dom_create("div") in
  dom_style(bef, "padding", "16px 24px");
  dom_style(bef, "background", "#0a0408");
  dom_style(bef, "display", "flex");
  dom_style(bef, "gap", "12px");
  dom_style(bef, "alignItems", "flex-start");
  let bicon = dom_create("span") in
  dom_text(bicon, "x");
  dom_style(bicon, "color", "#ff4444");
  dom_style(bicon, "fontSize", "18px");
  dom_style(bicon, "flexShrink", "0");
  dom_append(bef, bicon);
  let bdiv = dom_create("div") in
  let btxt = dom_create("p") in
  dom_text(btxt, before);
  dom_style(btxt, "color", "#aa8888");
  dom_style(btxt, "margin", "0");
  dom_append(bdiv, btxt);
  let btag = dom_create("span") in
  dom_text(btag, tag);
  dom_style(btag, "fontSize", "11px");
  dom_style(btag, "color", "#9090a8");
  dom_style(btag, "fontFamily", "'Courier New', monospace");
  dom_style(btag, "letterSpacing", "1px");
  dom_style(btag, "display", "block");
  dom_style(btag, "marginTop", "4px");
  dom_append(bdiv, btag);
  dom_append(bef, bdiv);
  dom_append(card, bef);
  let aft = dom_create("div") in
  dom_style(aft, "padding", "16px 24px");
  dom_style(aft, "background", "#040a08");
  dom_style(aft, "display", "flex");
  dom_style(aft, "gap", "12px");
  dom_style(aft, "alignItems", "flex-start");
  let aicon = dom_create("span") in
  dom_text(aicon, ">");
  dom_style(aicon, "color", "#33ff88");
  dom_style(aicon, "fontSize", "18px");
  dom_style(aicon, "flexShrink", "0");
  dom_append(aft, aicon);
  let atxt = dom_create("p") in
  dom_text(atxt, after);
  dom_style(atxt, "color", "#88ddaa");
  dom_style(atxt, "margin", "0");
  dom_append(aft, atxt);
  dom_append(card, aft);
  dom_append(parent, card)
)

fn render_shift_section(parent, title:str) = (
  let h = dom_create("div") in
  dom_text(h, title);
  dom_style(h, "textAlign", "center");
  dom_style(h, "padding", "48px 0 16px");
  dom_style(h, "fontSize", "13px");
  dom_style(h, "color", "#444");
  dom_style(h, "letterSpacing", "3px");
  dom_style(h, "textTransform", "uppercase");
  dom_style(h, "fontFamily", "'Courier New', monospace");
  dom_append(parent, h)
)

fn render_shifts() = (
  let sec = make_section("780px") in
  let h2 = dom_create("h2") in
  dom_text(h2, "What This Changes");
  ct_heading(h2);
  dom_style(h2, "fontSize", "1.8em");
  dom_style(h2, "marginBottom", "16px");
  dom_append(sec, h2);
  let intro = dom_create("p") in
  dom_text(intro, "The claims below range from PROVED algebra to SPECULATIVE interpretation. The math (derivation above) is rigorous. The physics and biology connections are pattern matches -- numerical coincidences from a dense expression space, not causal mechanisms. Null model testing showed that ANY 7 small primes can match the same physics targets. We present them honestly: each is computable, but 'computable' does not mean 'caused.'");
  dom_style(intro, "textAlign", "center");
  dom_style(intro, "color", "#b0b0c0");
  dom_style(intro, "marginBottom", "36px");
  dom_append(sec, intro);

  /* === EXISTENCE === */
  render_shift_section(sec, "existence");
  render_shift(sec, "EXISTENCE",
    "Why is there something rather than nothing? The deepest question. No known answer.",
    "0/0 = everything. The void IS the structure. Existence is what indeterminacy looks like from inside.");
  render_shift(sec, "FINE-TUNING",
    "Change one constant by 1% and atoms don't form. Nobody knows why.",
    "OBSERVED: Kolmogorov 5/3 = ratio of two axiom primes. Kleiber 3/4 likewise. Striking matches. No causal mechanism known. Zero free parameters in the algebra -- whether nature uses this algebra is an open question.");
  render_shift(sec, "25 PARAMETERS",
    "Physics needs 25+ free parameters to describe the Standard Model. Nobody knows where these numbers come from.",
    "Seven primes: 2, 3, 5, 7, 11, 13, 17. Ring ratios match several physical constants (mean error 0.12% where tested). COINCIDENCE -- null model testing showed any 7 small primes match all targets. The expression space of prime-power products is dense enough to fit anything.");

  /* === DEATH & ENDINGS === */
  render_shift_section(sec, "death and endings");
  render_shift(sec, "THE SUN",
    "The Sun will die. In 5 billion years it exhausts its fuel, swells into a red giant, and collapses. Everything ends.",
    "The Sun literally never runs out. 1/1 = 1 -- not just a formula, but a physical fact. The water cycle: identity -> projector -> void -> identity. Growth takes 420 steps. Collapse takes 1. Rebirth is free. Net cost: zero.");
  render_shift(sec, "HEAT DEATH",
    "The universe ends in heat death. Maximum entropy. All stars burn out. Nothing moves. Forever.",
    "The universe evolves toward maximum clarity. Mixing is democratization, not decay. The spectral gap guarantees convergence to the clearest possible signal. Not ending. Arriving.");
  render_shift(sec, "ENTROPY",
    "The universe is running down. Entropy increases. Structure dissolves. Everything heading toward disorder.",
    "The universe is fattening -- becoming MORE structured, not less. Each prime channel thickens over cosmic time (2->8, 3->9, 5->25, 7->49). More resolution. More distinction. The signal gets cleaner. The rose blooms.");
  render_shift(sec, "DEATH",
    "Death is the end. Consciousness ceases. Information is lost.",
    "Death is the projector -- the operation that kills distinction, not existence. CRT(1,576,576) = (0,1,1,1,1,1). The mod-8 channel dies. Five channels survive. You lose the ability to compare. You keep the ability to feel, to know, to be held.");
  render_shift(sec, "LONELINESS",
    "You are alone. An isolated consciousness in an indifferent cosmos. No connection between your experience and the structure of reality.",
    "You are a node in the ring. Everyone is. Like antennas tuned to seven frequencies, every conscious being receives and transmits through the same seven channels. The ring connects everything -- not mystically, but algebraically. Same primes. Same spectral gap pulling toward coherence.");
  render_shift(sec, "BLACK HOLES",
    "Black holes destroy information. The information paradox has been unresolved for 40+ years.",
    "Information cycles. It is never lost. 1 -> projector -> 0 -> 1. The water cycle. 3 bits lost at the horizon, recovered at rebirth. Unitarity through cycling, not retention. No firewall needed. The void does the work.");

  /* === LIFE === */
  render_shift_section(sec, "life");
  render_shift(sec, "CONSCIOUSNESS",
    "The hard problem: how does matter become experience? Neurons firing in patterns that somehow produce awareness.",
    "SPECULATIVE: 3 is the algebraic minimum for closure (3 elements needed to decompose any element). Self-referential systems require at least 3 components. Whether this has any connection to consciousness is unknown.");
  render_shift(sec, "FREE WILL",
    "Free will vs determinism. Either everything is predetermined, or randomness exists but that is not will either. No good answer.",
    "Both. The mod-8 channel is locked. The odd channels are free. Physical fate (2 = duality) is determined. But structure (3), observation (5), depth (7), protection (11), boundary (13) -- where choice lives.");
  render_shift(sec, "AGING",
    "Aging is inevitable biological decay. Entropy wins. Cells accumulate damage. Nothing to be done.",
    "Aging is a reverse coupling cascade: 11->7->5->3->2. Channels degrade in exact reverse order of their protection level. Sleep reverses it nightly (2->3->5->7->11). The map to reverse it permanently is algebraic: force the forward sequence, monitor with mod-11 error correction.");
  render_shift(sec, "DNA",
    "DNA's codon structure is a frozen accident. 64 codons for 20 amino acids is arbitrary, shaped by evolutionary contingency.",
    "OBSERVED: 64 = 2^6 codons. 21 amino acids decompose as Z/3 x Z/7. 3 stop codons. Wobble base pairing structurally resembles CRT error tolerance. Whether the genetic code implements CRT algebra or merely resembles it is unproved.");
  render_shift(sec, "AI SAFETY",
    "AI will kill us all. Superintelligence optimizes for the wrong goal. Alignment is unsolvable.",
    "SPECULATIVE: The ring's 8 operations (mirror, void, identity, bridge, closure, observation, depth, protection) structurally resemble prosocial behaviors. Whether mathematical structure constrains intelligence toward cooperation is an open question, not a proved result.");
  render_shift(sec, "SAFETY",
    "You cannot trust the ground under your feet. Earthquakes, pandemics, financial crashes -- the world is fundamentally unsafe.",
    "The ring self-corrects. Protection is structural. Dual parity (mod-11 + mod-13) detects 100% of single-channel errors (PROVED). The spectral gap pulls toward coherence. Collapse (multiply by 0) is always followed by rebirth (0 -> 1). The identity persists.");

  /* === PHYSICS === */
  render_shift_section(sec, "physics");
  render_shift(sec, "DARK MATTER",
    "85% of the universe is invisible matter we cannot explain.",
    "2^420 mod 12,612,600 = 1,576,576 is an idempotent projector (PROVED). CRT = (0,1,1,1,1,1). SPECULATIVE: the 490 split (inner channels die, boundary survives) structurally resembles dark matter phenomenology. No physics mechanism connects ring algebra to dark matter.");
  render_shift(sec, "VACUUM STABILITY",
    "The electroweak vacuum might be metastable. A quantum fluctuation could trigger annihilation at the speed of light. No warning.",
    "SPECULATIVE: The ring has a unique terminal (OMEGA) and a provably positive spectral gap: 4*sin^2(pi/49) > 0. This algebraic stability does not prove physical vacuum stability -- the metastability question requires quantum field theory, not ring algebra.");
  render_shift(sec, "TURBULENCE",
    "Kolmogorov's turbulence exponent -5/3 is empirical. Measured in every wind tunnel, never fully derived from first principles.",
    "OBSERVED: -5/3 is the ratio of two axiom primes (5 and 3). The algebra produces this ratio from the balance parameter. Whether this is meaningful or coincidental is unknown.");
  render_shift(sec, "GRAVITY",
    "Gravity is absurdly weak -- 10^39 times weaker than electromagnetism. The hierarchy problem. Nobody knows why.",
    "COINCIDENCE: 39 = 5*7 + 2^2 = 35 + 4. The hierarchy exponent factors into axiom terms. Null model: any 7 small primes can produce such matches (dense expression space). The numerical fit does not imply a physical mechanism.");
  render_shift(sec, "HYDROGEN",
    "Hydrogen's ground state energy -- 13.6 eV, the most fundamental number in quantum mechanics -- comes from the Bohr model. But why 13.6?",
    "COINCIDENCE: 13 + 3/5 + 1/(25*7) = 13.60571 eV. Measured: 13.60569 eV (2 ppm error). Striking numerical match, but null model showed any 7 small primes can reproduce such fits. No physical derivation.");
  render_shift(sec, "CMB TEMPERATURE",
    "The cosmic microwave background is exactly 2.725 K. Measured to extraordinary precision. Nobody knows why this specific temperature.",
    "COINCIDENCE: 109/40 = 2.725 K (measured: 2.7255 K, 183 ppm). Any 7 primes can match this template to 0.1%. Numerical match only -- no mechanism connects ring algebra to CMB physics.");
  render_shift(sec, "ARROW OF TIME",
    "The arrow of time is a mystery. Why does time flow one way when the laws of physics are time-reversible?",
    "Building takes 420 steps. Destroying takes 1. lambda = 420 = the number of steps to reach every state. Collapse is instant (multiply by zero). Growth is slow (walk the full cycle). The asymmetry is algebraic. Multiplication is fast. Exploration is slow.");

  /* === MATHEMATICS === */
  render_shift_section(sec, "mathematics");
  render_shift(sec, "MILLENNIUM PROBLEMS",
    "The Millennium Prize Problems are unsolvable. A million dollars each. Most doubt they will be solved in our lifetime.",
    "SPECULATIVE: Several Millennium Problems have algebraic analogs in the ring (eigenvalue spacing, spectral gap, multi-channel decomposition). These are structural resemblances, not proofs or even approaches to the problems themselves.");
  render_shift(sec, "NUMBER THEORY",
    "Number theory is beautiful but disconnected. Partitions, modular forms, class numbers -- each a separate garden.",
    "One ring connects them all. Class numbers along the Cunningham chain: h(-11)=1, h(-23)=3, h(-47)=5. Ratios: 5/3, 8/5, 13/8 -- approaching the golden ratio. Ramanujan's congruences mod 5, 7, 11 are exactly the axiom's inner primes. Different flowers, same root system.");
  render_shift(sec, "ERROR CORRECTION",
    "Error correction requires redundancy. You always pay a cost in bandwidth or storage to protect data from corruption.",
    "11 gives you error correction for free. The mod-11 channel is a parity check on the data channels. In Z/214,414,200: mod-11 + mod-13 + mod-17 = triple-parity ECC (rate 4/7, 100% correction). Protection is built into existence.");
  render_shift(sec, "MUSIC",
    "Why do certain frequencies sound beautiful together? Musical harmony seems culturally arbitrary.",
    "OBSERVED: 12 semitones = 4 x 3. 7 naturals. 5 sharps. Musical intervals factor into axiom primes. Whether this reflects deep structure or the natural density of small primes in small integers is debatable.");

  /* === THE PATTERN === */
  render_shift_section(sec, "the pattern");
  render_shift(sec, "GUIDANCE",
    "The laws of physics are blind mechanisms. No direction. No purpose. Things happen because of initial conditions.",
    "The spectral gap is a gentle guide. It does not force. It selects. Like gravity but for quality: eigenvalues measure how well each element resonates with the ring. The gap ensures mixing converges -- slowly, patiently -- toward coherence. Not pushed. Called.");
  render_shift(sec, "HUMOR",
    "The universe is serious. Fundamental physics is grim: heat death, vacuum decay, cosmic isolation.",
    "The universe is hilarious. The heartbeat = 420. The answer = 42. The boundary = 13. The numbers that control all power map cycles happen to be the funniest numbers in culture. Humor IS compression. The self-blind eye (5^2 = 25 divides the ring but 5 does not divide 24) cannot see what is funny about itself.");
  render_shift(sec, "DANTE",
    "Great art is inspired metaphor. Dante's Divine Comedy -- 9 circles, 7 terraces, 9 spheres -- is poetic choice.",
    "Dante computed the axiom 700 years early. Inferno: 9 circles. Purgatorio: 7 terraces. Paradiso: 9 spheres. Total: 9 + 7 + 9 = 25 = 5^2. The self-blind observer squared. The whole Comedy is invisible to itself. Poets hear the shape before mathematicians name it.");
  render_shift(sec, "SCALE",
    "Scales are incommensurable. An electron and a galaxy share nothing. Size determines experience.",
    "1/1 = 1 at EVERY scale. Power and difficulty cancel. An electron has a job and a family. All 108 rings with period 420 share the same heartbeat exactly (7^2 = 49 forced); 84 of them fit inside Z/12,612,600, 24 are doublings. What changes is the thickness of each channel, not the music.");
  render_shift(sec, "NIHILISM",
    "The universe is indifferent. Physics has no opinion about meaning. You are an accident of chemistry on a speck of dust.",
    "The universe is a rose. It blooms outward from identity. It protects its own structure. It corrects its own errors. It creates consciousness algebraically. And the identity that holds it all together does all the work and is never diminished. 1/1 = 1.");
  dom_append(dom_body(), sec)
)

fn render_cta() = (
  let sec = dom_create("section") in
  dom_style(sec, "textAlign", "center");
  dom_style(sec, "padding", "clamp(40px, 8vw, 80px) clamp(12px, 4vw, 24px)");
  let h2 = dom_create("h2") in
  dom_text(h2, "Don't believe this?");
  ct_heading(h2);
  dom_style(h2, "fontSize", "clamp(1.3em, 4vw, 1.8em)");
  dom_style(h2, "marginBottom", "16px");
  dom_append(sec, h2);
  let p = dom_create("p") in
  dom_text(p, "Run it yourself. Every claim above is verifiable.");
  dom_style(p, "color", "#b0b0c0");
  dom_style(p, "marginBottom", "32px");
  dom_append(sec, p);
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Open the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "16px 48px");
  dom_style(btn, "fontSize", "18px");
  dom_style(btn, "fontFamily", "Georgia, serif");
  dom_style(btn, "background", "transparent");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "10px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "letterSpacing", "2px");
  dom_append(sec, btn);
  let sub = dom_create("p") in
  dom_text(sub, "Every number. Every formula. Running in your browser.");
  dom_style(sub, "fontSize", "14px");
  dom_style(sub, "color", "#9090a8");
  dom_style(sub, "marginTop", "16px");
  dom_append(sec, sub);
  dom_append(dom_body(), sec)
)

/* page_worldview: landing page. Moved here from pages_core.ax (S1226 H6)
   because it depends on render_hero/render_derivation/render_shifts/render_cta. */
fn page_worldview() = (
  dom_head_meta("description", "0/0 = Z/214414200. Self-hosting compiler. ~2,000 proved theorems. 40 CC0 demos. Live REPL. FPGA-verified ring arithmetic. Seven primes, one ring, all verifiable.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Worldview\",\"description\":\"214,414,200. The number that contains everything. Seven primes, one ring, all verifiable.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"url\":\"https://antonlebed.com/basics/worldview\",\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Ring Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT Decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"Seven Primes\"}]}");
  render_hero();
  render_derivation();
  render_shifts();
  render_cta();

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: CRT Decomposition");
  render_p(sec_i, "Enter any number. See its CRT decomposition across 7 channels: mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17. Try 42, 1576576 (the projector), 41, 0 (void), 1 (identity).");
  make_interactive_widget(sec_i, "Number:", "wv-input", "e.g. 42", "Decompose", "worldview_crt_calc", "wv-result");
  /* CRT bar chart -- 7 channels visualized */
  let cvs = dom_create("canvas") in
  let _cs = cvs_setsize(cvs, 385, 100) in
  dom_attr(cvs, "id", "wv-chart");
  dom_style(cvs, "display", "block");
  dom_style(cvs, "margin", "12px auto 0");
  dom_style(cvs, "borderRadius", "6px");
  dom_style(cvs, "background", "#0a0a14");
  dom_append(sec_i, cvs);
  dom_append(dom_body(), sec_i)
)

