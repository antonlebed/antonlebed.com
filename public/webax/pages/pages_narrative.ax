fn story_contrast() = (
  let sec = make_section("800px") in
  let panel = dom_create("div") in
  dom_style(panel, "background", "#0d0d18");
  dom_style(panel, "border", "1px solid #444");
  dom_style(panel, "borderRadius", "10px");
  dom_style(panel, "padding", "20px");
  dom_style(panel, "width", "100%");
  dom_style(panel, "overflowX", "auto");
  let h3 = dom_create("h3") in
  dom_text(h3, "What Makes This Different");
  ct_gold(h3);
  dom_style(h3, "marginBottom", "12px");
  dom_style(h3, "fontSize", "16px");
  dom_append(panel, h3);
  let tbl = dom_create("table") in
  dom_style(tbl, "width", "100%");
  dom_style(tbl, "borderCollapse", "collapse");
  let thead = dom_create("tr") in
  render_th(thead, "Claim");
  render_th(thead, "Standard Approach");
  render_th(thead, "This Work");
  dom_append(tbl, thead);
  render_contrast_row(tbl, "Fundamental constants",
    "26 free parameters, measured but unexplained",
    "Matched by 10 terms. Kolmogorov, Kleiber, Rydberg, alpha -- all computable from ring ratios. Null model caveat: the expression space of small-prime ratios is dense enough to match most targets.");
  render_contrast_row(tbl, "Error correction",
    "External codes added to data (Reed-Solomon, LDPC)",
    "Built into the number system. Dual parity (11 + 13) gives 100% detection. Structural, free.");
  render_contrast_row(tbl, "AI generalization",
    "Needs billions of parameters and massive datasets",
    "928 params, 97.6% on unseen combinations. Structure IS generalization.");
  render_contrast_row(tbl, "Verification",
    "Trust the paper, trust the institution",
    "Every claim runs live in your browser. Type a number. Watch it decompose.");
  render_contrast_row(tbl, "Prerequisites",
    "PhD required to evaluate most claims",
    "Zero. If you can count to 11, you can verify everything here.");
  dom_append(panel, tbl);
  let note = dom_create("p") in
  dom_text(note, "~2,000 proved theorems. 151 interactive pages. All from Z/12,612,600.");
  dom_style(note, "fontSize", "12px");
  dom_style(note, "color", "#9090a8");
  dom_style(note, "marginTop", "12px");
  dom_append(panel, note);
  dom_append(sec, panel);
  dom_append(dom_body(), sec)
)

fn page_story() = (
  dom_head_meta("description", "Ten terms structure everything that repeats. 108 rings share the same heartbeat period 420. Turbulence, metabolism, error correction, particle masses. Computed live. No prerequisites.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Cascade Ontology: 0/0 = Z/214414200Z\",\"description\":\"Seven primes derived from 0/0 structure turbulence, metabolism, error correction, and particle masses. ~1920 proved theorems from one ring.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/basics/story\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"Ring Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"Number Theory\"}]}");
  story_hero();
  story_what_is_this();
  story_ten_terms();
  story_findings();
  story_number_theory();
  story_sleep();
  /* story_blackholes + story_vacuum CUT S1944 */
  story_body();
  story_explore();

  story_contrast()
)

/* ================================================================
   DEATH PAGE -- What ends when you die? Body/Mind/Sigma triptych.
   Canvas animations remain text-only (P3 cosmetic, S1242).
   Text content: complete. The narrative IS the proof.
   ================================================================ */

fn page_death() = (
  /* S1944 REWRITE: separated algebra from philosophy. OMEGA CRT = proved math.
     Interpretations explicitly labeled as philosophical reflection, not derivation. */
  dom_head_meta("description", "Multiplying by 1,576,576 zeros out the mod-8 channel. CRT decomposition of dissolution. Interactive projection explorer.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Death and OMEGA\",\"description\":\"Multiplying by 1,576,576 zeros out the mod-8 channel. CRT decomposition of dissolution.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/basics/death\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT projector\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"idempotent\"}]}");
  let sec = make_section("900px") in
  let h1 = dom_create("h1") in
  dom_text(h1, "Death and 1,576,576");
  ct_heading(h1);
  ct_mono(h1);
  dom_style(h1, "textAlign", "center");
  dom_style(h1, "fontSize", "1.6em");
  dom_style(h1, "letterSpacing", "2px");
  dom_style(h1, "padding", "24px 0 5px");
  dom_append(sec, h1);
  let sub = dom_create("p") in
  dom_text(sub, "CRT(1,576,576) = (0, 1, 1, 1, 1, 1)");
  ct_mono(sub);
  dom_style(sub, "textAlign", "center");
  dom_style(sub, "color", "#a0a0b0");
  dom_style(sub, "fontSize", "0.9em");
  dom_style(sub, "marginBottom", "20px");
  dom_append(sec, sub);
  /* The mathematics */
  let h2_math = dom_create("h2") in
  dom_text(h2_math, "The Mathematics");
  dom_style(h2_math, "color", "#a0a0cc");
  dom_style(h2_math, "fontSize", "1.1em");
  dom_style(h2_math, "marginBottom", "12px");
  dom_style(h2_math, "borderBottom", "1px solid #222");
  dom_style(h2_math, "paddingBottom", "6px");
  dom_append(sec, h2_math);
  render_theorem(sec, "The Projector (PROVED)",
    "2^420 mod 12,612,600 = 1,576,576. This number is an idempotent: 1,576,576^2 = 1,576,576. Its CRT decomposition is (0, 1, 1, 1, 1, 1). The mod-8 channel is annihilated. The remaining five channels (mod 9, mod 25, mod 49, mod 11, mod 13) are preserved exactly. Multiplying any element n by 1,576,576 projects away its mod-8 component.");
  render_p(sec, "The identity 1 decomposes as 1 = e + P, where e is the mod-8 idempotent and P = 1,576,576 is the projector. Every element is the sum of its mod-8 projection and its five-channel projection. P preserves five of six channels; e preserves only the mod-8 channel.");
  /* Three CRT channels: what happens to each */
  let panels = make_grid(sec, "15px") in
  render_panel(panels, "mod-8 channel: annihilated", "#cc4444",
    "The projector sets the mod-8 channel to 0. Any information encoded in n mod 8 is lost. This is the only channel destroyed.");
  render_panel(panels, "mod-9, mod-25, mod-49: preserved", "#44aacc",
    "The three inner channels survive projection intact. n mod 9, n mod 25, n mod 49 are unchanged.");
  render_panel(panels, "mod-11, mod-13: preserved", "#f0c040",
    "The two boundary channels also survive. n mod 11 and n mod 13 pass through unchanged.");
  /* Algebra: sigma = e_D + OMEGA */
  render_theorem(sec, "490 Split (PROVED)",
    "490 = 2 x 5 x 7^2. In Z/12,612,600: 490^420 has CRT = (0, 1, 1, 1, 1, 1) = the projector. The channels for {2, 5, 7} project to 0, while {3, 11, 13} project to 1. 490 splits the ring into inner and boundary. Z/12,612,600 has 64 idempotents; the projector's image has 32.");
  /* Philosophical reflection -- explicitly labeled */
  render_themed_section(sec, "Philosophical Reflection", "#0a0a14", "#223344", "#6688cc",
    "The algebra above is proved. What follows is interpretation, not derivation. The CRT projector annihilates one channel while preserving five others. If you read the mod-8 channel as physical substrate and the remaining channels as pattern and structure, then the projector describes a dissolution where pattern outlasts substrate. Whether this says anything about actual death is a philosophical question, not a mathematical one. The ring gives the structure. The meaning is yours.",
    "#aaa");
  dom_append(dom_body(), sec);
  /* Interactive: what persists through OMEGA? */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: CRT Projection");
  render_p(sec_i, "Enter any element n. The projector zeros the mod-8 channel. See which channels survive. Try 1 (identity: all 5 non-mod-8 channels persist), 0 (void: nothing survives), 42 (mod-8 channel dies, mod-9 and mod-49 survive).");
  make_interactive_widget(sec_i, "Element n:", "death-input", "e.g. 42", "Project", "death_persist_calc", "death-result");
  dom_append(dom_body(), sec_i)
)

