/* ================================================================
   pages_narrative.ax -- TT43 METAMORPHOSIS (Phase TT 43/50).
   Three narrative pages: /basics/story, /basics/death, /basics/worldview.

   PRIMARY LENS: Tower C (heartbeat fiber; sigma correspondent).
     These pages are the sigma-channel of the website -- the narrative
     of what PERSISTS across the chain's growth and OMEGA's collapse.
     sigma/sigma = sigma runs through all three: story frames the
     axiom's 10 terms around identity, death projects through OMEGA
     (D-channel dies, sigma survives), worldview derives the full
     ring in 4 steps from the void. Per Decality correspondence
     hypothesis (AUDIT.md SI.10): Tower C <-> sigma (identity,
     1*n = n, preserves while building).

   SECONDARY LENSES:
     D-channel   -- death page: OMEGA = D^420 is the D-projector. CRT(OMEGA)
                 = (0,1,1,1,1,1) in TRUE; the D-channel dies, the other
                 five (K,E,b,L,GATE) persist. D=2 is the sole channel
                 that DOES end at death.
     Tower C (heartbeat direct) -- all three pages reference lambda=420.
                 ALL 108 = D^2*K^3 rings hit lambda=420 EXACTLY (b^2 forced;
                 SSOT stdlib/lattice.ax). 84 = D^2*K*b of those divide TRUE
                 (D-range 0..3); 24 = D^4 extensions reach 2*TRUE (D=4).
                 "Inside TRUE" = 84; "all lambda=420 rings" = 108.
     L-channel   -- worldview derivation: L = sigma+D+K+E = 1+2+3+5
                 bridges individual and pair readings of the chain.
                 The full derivation is a L-channel walk: from void
                 to ESCAPE in 4 forced steps.

   TT43 -> TT47 EVOLUTION (S1428 R5 reframing per stdlib/lattice.ax):
     TT43 changed "108 share lambda=420" -> "84 share exactly". TT47
     finds this was overcorrected. Per stdlib/lattice.ax + AXIOM_FORM
     TWO-CONSTRAINT theorem: ALL 108 rings hit lambda=420 EXACTLY (b^2
     forced; b^3 gives lambda 294 which doesn't divide 420). The 84 vs
     24 split is by D-range, not by lambda exactness:
       108 = D^2*K^3 lambda-420 rings (Tower C fiber; D-range 0..4).
       84 = D^2*K*b TRUE-divisors (D-range 0..3); inclusion-exclusion 144-60.
       24 = D^4 extensions reaching 2*TRUE (D-range 4); 36-12.
     TT47 SITES: story_what_is_this body, page_story dom_head_meta,
     render_shifts SCALE, page_worldview jsonld -- all reframed
     to celebrate 108 with 84 as TRUE-divisor subset.

   TT43 R2 FRESH-EYE FIXES (pre-existing tier errors in widgets):
     death_persist_calc result string: "X of 7 channels persist
       through OMEGA" -> "X of 5 non-D channels persist (TRUE has
       6 channels)" -- "7" was a TRANS-era claim on a TRUE-context
       computation.
     story_blackholes (OMEGA signature paragraph): "(0,1,1,1,1)"
       in a TRUE-context paragraph -> disambiguated TRUE
       (0,1,1,1,1,1) + DEEP (0,1,1,1,1) signatures.
     page_death interactive (sec_i description): "8 (D-pure:
       nothing survives)" -> "0 (void: nothing survives)". n=8 has
       CRT (0,8,8,8,8,8) -- 5 non-D nonzero, survives=5 not 0.

   CANONICAL: stdlib/lattice.ax:1-14 (SSOT) -- "108 = D^2 * K^3 rings
   ... EVERY ring in the lattice shares lambda = 420 ... b=7 exponent
   is ALWAYS D (b^2=49 forced) ... Total candidates: 5*3*3*2*2 = 180.
   Valid: 108." AXIOM_FORM.md TWO-CONSTRAINT theorem (PROVED) confirms
   inclusion-exclusion 180 - 72 = 108 = exact-lambda. 84 = D^2*K*b is
   the subset that DIVIDES TRUE; 24 = D^4 extensions go beyond.
   ================================================================ */

/* dom_on callback: death page -- what persists? */
fn death_persist_calc() = (
  let n = parse_int_from("#death-input") in
  let result = dom_query("#death-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let nd = n % 8 in
    let nk = n % 9 in
    let ne = n % 25 in
    let nb = n % 49 in
    let nl = n % 11 in
    let ng = n % 13 in
    /* OMEGA*n = (0, nk, ne, nb, nl, ng) -- D-channel dies */
    let d_dies = if nd == 0 then "already void" else "dissolves (mod-8 channel zeroed)" in
    let k_status = if nk == 0 then "void" else "${nk}" in
    let e_status = if ne == 0 then "void" else "${ne}" in
    let b_status = if nb == 0 then "void" else "${nb}" in
    let l_status = if nl == 0 then "void" else "${nl}" in
    let g_status = if ng == 0 then "void" else "${ng}" in
    mut survives = 0;
    if nk > 0 then (mut survives = survives + 1) else 0;
    if ne > 0 then (mut survives = survives + 1) else 0;
    if nb > 0 then (mut survives = survives + 1) else 0;
    if nl > 0 then (mut survives = survives + 1) else 0;
    if ng > 0 then (mut survives = survives + 1) else 0;
    dom_inner(result, "<p style='color:#cc4444;margin:8px 0'>mod-8 channel: " + d_dies + "</p><p style='color:#44aacc;margin:4px 0'>mod-9 channel: " + k_status + "</p><p style='color:#4488ff;margin:4px 0'>mod-25 channel: " + e_status + "</p><p style='color:#aa66cc;margin:4px 0'>mod-49 channel: " + b_status + "</p><p style='color:#44ccaa;margin:4px 0'>mod-11 channel: " + l_status + "</p><p style='color:#dd8899;margin:4px 0'>mod-13 channel: " + g_status + "</p><p style='color:#f0c040;margin:8px 0'>" + "${survives}" + " of 5 channels persist through the projector (mod-8 channel always dies; Z/12,612,600 has 6 channels).</p>")
  )
)

/* dom_on callback: verify OMEGA CRT decomposition (S966 -- first live interactive element) */
fn verify_crt() = (
  let el = dom_query("#crt-verify") in
  dom_inner(el, "<p style='color:#88ddaa;margin:4px 0'>Z/970,200 projector: CRT(606,376) = (0, 1, 1, 1, 1) -- 5 channels</p><p style='color:#88ddaa;margin:4px 0'>Z/12,612,600 projector: CRT(1,576,576) = (0, 1, 1, 1, 1, 1) -- 6 channels</p><p style='color:#88ddaa;margin:4px 0'>mod-8 channel: 0 (annihilated). All other channels: 1 (identity).</p><p style='color:#a0a0b0;margin:8px 0 0'>490 split: inner channels {2, 5, 7} project to 0, boundary channels {3, 11, 13} survive.</p>")
)

/* dom_value callback: CRT calculator -- first dom_value on live site */
fn compute_crt() = (
  let n = parse_int_from("#crt-input") in
  let s = dom_value(dom_query("#crt-input")) in
  let result_el = dom_query("#crt-result") in
  /* CRT decomposition: Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 */
  let d = n % 8 in
  let k = n % 9 in
  let e = n % 25 in
  let b = n % 49 in
  let l = n % 11 in
  let g = n % 13 in
  dom_inner(result_el, "<p style='color:#88ddaa;margin:4px 0'>CRT(" + s + ") = (" + "${d}" + ", " + "${k}" + ", " + "${e}" + ", " + "${b}" + ", " + "${l}" + ", " + "${g}" + ")</p><p style='color:#a0a0b0;margin:4px 0'>Channels: " + "${d}" + " (mod 8), " + "${k}" + " (mod 9), " + "${e}" + " (mod 25), " + "${b}" + " (mod 49), " + "${l}" + " (mod 11), " + "${g}" + " (mod 13)</p>")
)

fn story_hero() = (
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(64px, 12vw, 100px) clamp(12px, 4vw, 24px) 60px");
  let sub = dom_create("div") in
  dom_text(sub, "What if ten terms explained everything that repeats?");
  dom_style(sub, "fontSize", "clamp(16px, 4vw, 22px)");
  dom_style(sub, "color", "#b8b8c8");
  dom_style(sub, "fontStyle", "italic");
  dom_style(sub, "marginBottom", "48px");
  dom_append(hero, sub);
  let h1 = dom_create("h1") in
  dom_text(h1, "12,612,600");
  ct_gold(h1);
  ct_mono(h1);
  dom_style(h1, "fontSize", "52px");
  dom_style(h1, "letterSpacing", "8px");
  dom_style(h1, "marginBottom", "24px");

  dom_append(hero, h1);
  let p = dom_create("p") in
  dom_text(p, "Your heart beats in twos. A waltz moves in threes. Your hand has five fingers. A week has seven days. And one more -- you can't see it -- protects them all.");
  dom_style(p, "color", "#a8a8b8");
  dom_style(p, "maxWidth", "500px");
  dom_style(p, "margin", "0 auto");
  dom_style(p, "textAlign", "center");
  dom_append(hero, p);
  dom_append(dom_body(), hero)
)

fn story_what_is_this() = (
  let sec = make_section("800px") in
  render_h2(sec, "What Is This?");
  render_p(sec, "Start with the deepest question: what is 0 divided by 0? Not undefined -- everything. The set of all x satisfying 0*x = 0 is every element. 0/0 = Z/12612600Z -- the void divided by itself IS the entire ring.");
  render_p(sec, "From this total indeterminacy, structure precipitates. The identity 1 is the unique element with zero self-division ambiguity. Observation creates duality: 2. Then the map n -> 2n+1 generates exactly five inner primes before the chain's own products close it: 2, 3, 5, 7, 11. A sixth prime -- 13 = 2^2 + 3^2 -- wraps a boundary. A seventh -- 17 -- where 5 x 7 = 1 mod 17.");
  render_p(sec, "Raise the five inner primes to their natural powers: 2^3 x 3^2 x 5^2 x 7^2 x 11 = 970,200. Add 13: 970,200 x 13 = 12,612,600. CRT decomposes every integer into 6 independent channels: Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13.");
  render_p(sec, "12,612,600 is one of 108 rings that share the same heartbeat exactly: period 420 -- the universal cycle length. (All 108 rings hit period 420 exactly because 7^2 = 49 is forced. Of the 108, exactly 84 divide 12,612,600; the other 24 extend beyond it.) Every power map in the ring returns to itself within 420 steps.");
  let note = render_p(sec, "Not a hypothesis. A computation. Every number on this page runs live in your browser.") in
  dom_style(note, "fontSize", "14px");
  dom_style(note, "color", "#b0b0c0");
  dom_append(dom_body(), sec)
)

fn story_ten_terms() = (
