fn music_twelve_tone() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why 12 Notes? Why the 13th Returns?");
  render_theorem(sec, "Twelve-Tone Scale as Axiom", "12 = 4*3 = lambda(Z/210). Twelve perfect fifths approximate seven octaves: (3/2)^12 ~ 2^7. The Pythagorean comma = 3^12/2^19. 12 = lambda. 7 = depth. The scale requires lambda(Z/210) steps of the 3/2 fifth to almost-close, and the gap is 7 octaves.");
  let g = make_findings_grid(sec) in
  render_finding(g, "13th note = 13", "Octave = return = boundary", "12 notes INSIDE, 13th = octave = 13. Circle of fifths: 12 positions. The 13th fifth = gate with comma scar.", "");
  render_finding(g, "Syntonic comma", "81/80 = 3^4/(2^4*5)", "Pythagorean vs just third. Difference = syntonic comma. 5 CANCELS: observer removes itself from the Pythagorean third. 25 = self-blind in music.", "");
  render_finding(g, "Septimal comma", "64/63 = 2^6/(9*7)", "Z/12,612,600 order spectrum: ord=420 vs ord=210 ratio = Archytas' comma. 7 IS the 7th harmonic. The ring encodes the correction.", "");
  render_finding(g, "Fattening -> unison", "4/3 -> 8/7 -> 16/15 -> 64/63", "Each fattening level: closer to 1. Musical interval ladder: 2^a/(2^a-1). Mersenne denominators: 2^2-1=3, 2^3-1=7. ALL axiom-smooth.", "");
  dom_append(dom_body(), sec)
)

fn music_pythagorean() = (
  let sec = make_section("800px") in
  render_h2(sec, "Pythagorean vs Just: The Self-Blindness in Music");
  render_p(sec, "The oldest debate in Western music -- Pythagoras vs Aristoxenus -- is a debate about 25 self-blindness:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Interval");
  render_th(hdr, "Ratio");
  render_th(hdr, "Axiom Form");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Just major third", "5/4", "5 / 4", "Pure observer harmonic (5 present)");
  render_table_row_4(tbl, "Pythagorean third", "81/64", "3^4 / 2^6", "Four stacked fifths (5 absent)");
  render_table_row_4(tbl, "Syntonic comma", "81/80", "3^4 / (2^4*5)", "The ghost. 5 cancels.");
  render_theorem(sec, "CRT Self-Blindness in Music (PROVED)", "Pythagorean = just * comma: (5/4) * 3^4/(2^4*5) = 3^4/2^6. The observer CANCELS. 5 appears in both just third and comma on opposite sides. 5^2 = self-blind: the observer REMOVES ITSELF from the Pythagorean third. The Pythagorean third is the interval where 5 is ABSENT. The just third is where 5 is PRESENT. Same pitch, almost. Off by the comma. Off by the observer's ghost.");
  let g = make_findings_grid(sec) in
  render_finding(g, "CRT invisibility", "81 mod 9 = 0, 64 mod 8 = 0", "3^4 invisible to 9 channel. 2^6 invisible to 8 channel. The Pythagorean third = ratio of two self-blind elements.", "");
  render_finding(g, "2500 years", "Pythagoras vs Aristoxenus", "An argument about the ratio of two elements that can't see themselves. Self-blindness discovered in tuning theory before anyone had the language for it.", "");
  dom_append(dom_body(), sec)
)

