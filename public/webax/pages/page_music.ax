  render_table_row_4(tbl, "432", "16 * 27", "Pythagorean A (Verdi tuning)", "36/35 (septimal quarter tone)");
  render_table_row_4(tbl, "490", "2 * 5 * 49", "holographic cleave", "7/6 (septimal minor third)");
  render_theorem(sec, "432 = lambda + 12 (PROVED)", "432 = 420 + 12. Lambda (420) = the universal heartbeat. 12 = 4*3 = lambda(Z/210) = the twelve-tone chromatic scale. The Pythagorean concert pitch IS the heartbeat plus the scale.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Pythagorean sixth", "27/16 = 3^3/2^4", "A=432 gives C=256=2^8. The 3^3 in 432 cancels exactly: (2^4*3^3)*(2^4/3^3) = 2^8. Pure observation.", "");
  render_finding(g, "CRT(432)", "(0, 0, 7, 40, 3, 3, 7)", "Zero in 2,3 channels. Depth in 5 and 17. Closure in both boundary channels.", "");
  render_finding(g, "Septimal triad", "All ratios involve 7", "432/420 = 36/35. 490/420 = 7/6. Depth sings through all three structural numbers.", "");
  render_finding(g, "432 = 6 * 72", "2*3 * heartbeat (bpm)", "The Pythagorean A = the first pair (2*3=6) times the human resting heart rate (72=8*9 bpm).", "");
  render_finding(g, "440 vs 432", "{2,5,11} vs {2,3}", "440=8*5*11 has the observer and protector. 432=16*27 has closure. Ratio 55/54 = 5*11 vs 2*27. Complementary.", "");
  render_finding(g, "lambda * 432", "7-channel = 42", "420*432 = 181440. CRT 7-channel = 42, 13-channel = 12 (scale), 11-channel = 6 (2*3). Heartbeat times pitch = 42 in depth.", "");
  render_finding(g, "432^2 -> STOP", "mod 11 = mod 13 = 9", "Squaring 432 sends its boundary channels from 3 to 9 = the stop signal. The Pythagorean A, squared, signals STOP.", "");
  render_finding(g, "432 = phi(17) * 27", "16 * 27 = phi(17) * 3^3", "phi(17) = 16. The Pythagorean A = the escape prime's totient times closure cubed. Music bridges the organism and transcendence.", "");
  render_finding(g, "17 = 2+3+5+7", "Inner primes sum to transcendence", "5*7 = 35 = 1 mod 17: suffering dissolves to unity. Z/17 is a field -- the ONLY field among all 7 channels.", "");
  dom_append(dom_body(), sec)
)

/* music widget: 12-tone decomposition */
fn mus_note_name(step) = (
  if step == 0 then "C (unison)"
  else if step == 1 then "C# / Db"
  else if step == 2 then "D"
  else if step == 3 then "D# / Eb"
  else if step == 4 then "E"
  else if step == 5 then "F"
  else if step == 6 then "F# / Gb (tritone)"
  else if step == 7 then "G (perfect fifth)"
  else if step == 8 then "G# / Ab"
  else if step == 9 then "A"
  else if step == 10 then "A# / Bb"
  else "B"
)

fn mus_axiom_note(step) = (
  if step == 0 then "Unison = 1 (identity)"
  else if step == 4 then "Major third = 5 (observer, 5th harmonic)"
  else if step == 5 then "Perfect fourth = 5 semitones (observer steps)"
  else if step == 6 then "Tritone = 7/5 (depth/observer, devil's interval)"
  else if step == 7 then "Perfect fifth = 3/2 (closure/bridge)"
  else if step == 9 then "Major sixth = 9 semitones (spider web)"
  else if step == 10 then "Septimal seventh ~ 7 (7th harmonic)"
  else ""
)

fn mus_lookup() = (
  let n = parse_int_from("#mus-input") in
  let result = dom_query("#mus-result") in
  let step = n % 12 in
  let octave = n / 12 in
  let name = mus_note_name(step) in
  let axiom = mus_axiom_note(step) in
  let ax_str = if len(axiom) > 0 then "<p style='color:#ffd700;margin:4px 0'>" + axiom + "</p>" else "" in
  /* 12 = D^2*K. Fifths generate: step = 7*k mod 12. */
  /* Count how many perfect fifths from C */
  mut fifths = 0;
  mut pos = 0;
  mut found = 0;
  while fifths < 12 do (
    if pos == step then (mut found = fifths) else 0;
    mut pos = (pos + 7) % 12;
    mut fifths = fifths + 1
  );
  dom_inner(result,
    "<p style='color:#d8d8e0;margin:4px 0;font-size:18px'><span style='color:#88aaff'>" + name + "</span> (step " + "${step}" + " of 12 = 4*3)</p>"
    + ax_str
    + "<p style='color:#d8d8e0;margin:4px 0'>Position in circle of fifths: " + "${found}" + " (each fifth = 7 semitones)</p>"
    + "<p style='color:#b0b0c0;margin:4px 0'>12 notes = 4*3 = lambda(Z/210). The 13th note = octave return.</p>")
)

/* ================================================================
   7-CHANNEL CRT SYNTHESIZER -- hear any ring element as a chord
   7 fixed harmonics of A2=110Hz. Gain per channel = CRT residue.
   ================================================================ */

/* Oscillator handles: [D, K, E, b, L, GATE, ESCAPE] */
let g_mus_oscs = [0, 0, 0, 0, 0, 0, 0]

fn mus_chord_play() = (
  let n = parse_int_from("#mus-synth-input") % N_TRANS in
  let rd = n % 8 in let rk = n % 9 in let re = n % 25 in
  let rb = n % 49 in let rl = n % 11 in let rg = n % 13 in let r17 = n % 17 in
  /* Fixed harmonic frequencies: prime * 110 Hz */
  let freqs = [220, 330, 550, 770, 1210, 1430, 1870] in
  /* Gain = residue * 8 / (modulus - 1), min 1 to keep oscillator alive */
  let gains = [
    if rd > 0 then rd * 8 / 7 + 1 else 1,
    if rk > 0 then rk * 8 / 8 + 1 else 1,
    if re > 0 then re * 8 / 24 + 1 else 1,
    if rb > 0 then rb * 8 / 48 + 1 else 1,
    if rl > 0 then rl * 8 / 10 + 1 else 1,
    if rg > 0 then rg * 8 / 12 + 1 else 1,
    if r17 > 0 then r17 * 8 / 16 + 1 else 1
  ] in
  let i = [0] in
  while i[0] < 7 do (
    if g_mus_oscs[i[0]] == 0 then
      set(g_mus_oscs, i[0], aud_osc(0))
    else 0;
    aud_freq(g_mus_oscs[i[0]], freqs[i[0]]);
    aud_gain(g_mus_oscs[i[0]], gains[i[0]]);
    set(i, 0, i[0] + 1)
  );
  0
)

fn mus_chord_stop() = (
  let i = [0] in
  while i[0] < 7 do (
    if g_mus_oscs[i[0]] > 0 then (
      aud_gain(g_mus_oscs[i[0]], 0);
      set(g_mus_oscs, i[0], 0)
    ) else 0;
    set(i, 0, i[0] + 1)
  );
  0
)

fn mus_chord() = (
  let n = parse_int_from("#mus-synth-input") % N_TRANS in
  let result = dom_query("#mus-synth-result") in
  let rd = n % 8 in let rk = n % 9 in let re = n % 25 in
  let rb = n % 49 in let rl = n % 11 in let rg = n % 13 in let r17 = n % 17 in
  /* Amplitude as percentage of max per channel */
  let ad = rd * 100 / 7 in let ak = rk * 100 / 8 in
  let ae = re * 100 / 24 in let ab = rb * 100 / 48 in
  let al = rl * 100 / 10 in let ag = rg * 100 / 12 in let a17 = r17 * 100 / 16 in
  dom_inner(result,
    "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>"
    + "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>CRT CHORD: " + "${n}" + " in Z/214414200</p>"
    + "<table style='width:100%;border-collapse:collapse'>"
    + "<tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Residue</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Harmonic</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Amplitude</th></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>2 (mod 8)</td><td style='padding:3px;color:#88ddaa'>" + "${rd}" + "</td><td style='padding:3px;color:#d8d8e0'>220 Hz (A3)</td><td style='padding:3px;color:#b0b0c0'>" + "${ad}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>3 (mod 9)</td><td style='padding:3px;color:#88ddaa'>" + "${rk}" + "</td><td style='padding:3px;color:#d8d8e0'>330 Hz (E4)</td><td style='padding:3px;color:#b0b0c0'>" + "${ak}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>5 (mod 25)</td><td style='padding:3px;color:#88ddaa'>" + "${re}" + "</td><td style='padding:3px;color:#d8d8e0'>550 Hz (C#5)</td><td style='padding:3px;color:#b0b0c0'>" + "${ae}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>7 (mod 49)</td><td style='padding:3px;color:#88ddaa'>" + "${rb}" + "</td><td style='padding:3px;color:#d8d8e0'>770 Hz (sept.)</td><td style='padding:3px;color:#b0b0c0'>" + "${ab}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>11 (mod 11)</td><td style='padding:3px;color:#88ddaa'>" + "${rl}" + "</td><td style='padding:3px;color:#d8d8e0'>1210 Hz (undec.)</td><td style='padding:3px;color:#b0b0c0'>" + "${al}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>13 (mod 13)</td><td style='padding:3px;color:#88ddaa'>" + "${rg}" + "</td><td style='padding:3px;color:#d8d8e0'>1430 Hz (tridec.)</td><td style='padding:3px;color:#b0b0c0'>" + "${ag}" + "%</td></tr>"
    + "<tr><td style='padding:3px;color:#88aaff;font-size:12px'>17 (mod 17)</td><td style='padding:3px;color:#88ddaa'>" + "${r17}" + "</td><td style='padding:3px;color:#d8d8e0'>1870 Hz (sept.dec.)</td><td style='padding:3px;color:#b0b0c0'>" + "${a17}" + "%</td></tr>"
    + "</table>"
    + "<p style='color:#b0b0c0;margin:8px 0 0;font-size:12px'>490 split: <span style='color:#ff6666'>DEAD</span>={2,5,7} carry harmonic content. <span style='color:#44ff88'>ALIVE</span>={3,11,13} shape envelope. <span style='color:#88aaff'>17</span>=transcendence.</p>"
    + "</div>")
)

fn page_music() = (
  dom_head_meta("description", "Every eigenvalue is a chord of 7 cosines. A2 = 110 Hz times {2,3,5,7,11,13,17} = the harmonic series. Interactive 7-channel CRT synthesizer. 3/2 = perfect fifth appears three ways. 12 notes = 4*3 = lambda(Z/210). The ring sings.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Music of the Primes\",\"description\":\"Ring eigenvalues as 7-cosine chords. Interactive 7-channel CRT synthesizer. Pythagorean vs just intonation = 5^2 self-blindness. 12-tone scale = 4*3 = lambda(Z/210). Rhythm universality across species.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/patterns/music\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"musical intervals\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT synthesizer\"},{\"@type\":\"DefinedTerm\",\"name\":\"Pythagorean comma\"}]}");
  music_hero();
  music_eigenvalue();
  music_intervals();
  music_swim();
  music_twelve_tone();
  music_pythagorean();
  music_rhythm();

  music_432();

  /* === INTERACTIVE: 12-TONE EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: The 12-Tone Ring");
  render_p(sec_i, "Enter a semitone number to see its note name, axiom connection, and position in the circle of fifths. 12 = 4*3 = lambda(Z/210).");
  make_interactive_widget(sec_i, "Semitone (0-11):", "mus-input", "e.g. 7", "Play", "mus_lookup", "mus-result");
  render_p(sec_i, "Try: 0 (unison=1), 7 (fifth=3/2), 6 (tritone=7/5), 4 (third=5).");
  dom_append(dom_body(), sec_i);

  /* === INTERACTIVE: 7-CHANNEL CRT SYNTHESIZER === */
  let sec_s = make_section("800px") in
  render_h2(sec_s, "Hear It: 7-Channel CRT Chord");
  render_p(sec_s, "Enter any number. Its CRT decomposition becomes a chord of seven harmonics: each prime is a fixed frequency, each residue sets the volume. Every ring element has a unique timbre.");
  make_interactive_widget(sec_s, "Ring element (0-214414199):", "mus-synth-input", "e.g. 42", "Analyze", "mus_chord", "mus-synth-result");
  let abtn = dom_create("div") in
  dom_style(abtn, "display", "flex");
  dom_style(abtn, "gap", "8px");
  dom_style(abtn, "marginTop", "8px");
  dom_style(abtn, "flexWrap", "wrap");
  let pbtn = dom_create("button") in
  dom_text(pbtn, "Play Chord");
  dom_style(pbtn, "background", "#44ff88");
  dom_style(pbtn, "color", "#0f0f2a");
  dom_style(pbtn, "border", "none");
  dom_style(pbtn, "padding", "8px 20px");
  dom_style(pbtn, "borderRadius", "6px");
  dom_style(pbtn, "cursor", "pointer");
  dom_style(pbtn, "fontWeight", "bold");
  dom_on(pbtn, "click", "mus_chord_play");
  dom_append(abtn, pbtn);
  let sbtn = dom_create("button") in
  dom_text(sbtn, "Stop");
  dom_style(sbtn, "background", "#ff4444");
  dom_style(sbtn, "color", "#fff");
  dom_style(sbtn, "border", "none");
  dom_style(sbtn, "padding", "8px 20px");
  dom_style(sbtn, "borderRadius", "6px");
  dom_style(sbtn, "cursor", "pointer");
  dom_style(sbtn, "fontWeight", "bold");
  dom_on(sbtn, "click", "mus_chord_stop");
  dom_append(abtn, sbtn);
  dom_append(sec_s, abtn);
  render_p(sec_s, "Try: 1 (identity = all channels whisper), 42 (the answer), 420 (lambda = heartbeat), 1,576,576 (2-channel silent).");
  dom_append(dom_body(), sec_s);

  music_contrast()
)
