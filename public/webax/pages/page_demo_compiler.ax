/* page_demo_compiler.ax -- Compiler demo page (CC0 Kill #42).
   Moved from page_demo_compute.ax to living module (needs evaluator). S1234. */

/* Demo: compile a small .ax program via the evaluator (meta-eval) */
fn demo_compiler_run() = (
  let src_el = dom_query("#dcomp-input") in
  let src = dom_value(src_el) in
  let result_el = dom_query("#dcomp-result") in
  if len(src) < 1 then dom_inner(result_el, "<p style='color:#ff6666'>Enter .ax code above.</p>")
  else (
    let output = ax_eval_capture(src) in
    let html = "<div style='background:#1a1a2e;padding:12px;border-radius:4px;border:1px solid #333'>"
      + "<div style='color:#aaa;font-size:12px;margin-bottom:6px'>Output:</div>"
      + "<pre style='color:#ffd700;margin:0;white-space:pre-wrap'>" + output + "</pre>"
      + "</div>" in
    dom_inner(result_el, html)
  )
)

/* Check if captured output starts with expected value (ignores trailing \n) */
fn ouro_check(got:str, expected:str) = (
  let lg = len(got) in
  let le = len(expected) in
  if lg < le then 0
  else (
    mut i = 0;
    mut ok = 1;
    while i < le do (
      if charCode(got, i) != charCode(expected, i) then (mut ok = 0) else 0;
      mut i = i + 1
    );
    ok
  )
)

/* Demo: self-compile test -- evaluator evaluates evaluator code */
fn demo_ouroboros_run() = (
  let result_el = dom_query("#douro-result") in
  /* L1: basic arithmetic through the evaluator */
  let r1 = ax_eval_capture("show 2 + 3") in
  /* L2: function definition + call (auto-show: show in let body = N_CALL returns v) */
  let r2 = ax_eval_capture("let f = fn(x) = x * x in f(7)") in
  /* L3: ouroboros -- evaluator evaluates itself evaluating */
  let r3 = ax_eval_capture("show ax_eval_capture(\"show 6 * 7\")") in
  let html = "<div style='background:#1a1a2e;padding:12px;border-radius:4px;border:1px solid #333'>"
    + "<div style='color:#aaa;font-size:12px;margin-bottom:8px'>Self-compilation tests:</div>"
    + "<div style='margin-bottom:6px'><span style='color:#aaa'>L1 (arithmetic):</span> <span style='color:" + (if ouro_check(r1, "5") == 1 then "#66ff66'>PASS" else "#ff6666'>FAIL") + " = " + r1 + "</span></div>"
    + "<div style='margin-bottom:6px'><span style='color:#aaa'>L2 (fn + call):</span> <span style='color:" + (if ouro_check(r2, "49") == 1 then "#66ff66'>PASS" else "#ff6666'>FAIL") + " = " + r2 + "</span></div>"
    + "<div><span style='color:#aaa'>L3 (ouroboros):</span> <span style='color:" + (if ouro_check(r3, "42") == 1 then "#66ff66'>PASS" else "#ff6666'>FAIL") + " = " + r3 + "</span></div>"
    + "</div>" in
  dom_inner(result_el, html)
)

/* Cunningham filtration: c(x)=2x+1 from any seed, showing chain generation */
fn demo_cunningham_run() = (
  let result_el = dom_query("#dcunn-result") in
  let seed_val = parse_int_from("#dcunn-input") in
  let s = if seed_val < 1 then 1 else seed_val in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>CUNNINGHAM CHAIN c(x) = 2x + 1 from " + "${s}" + "</p>";
  mut html = html + "<table style='border-collapse:collapse;width:100%;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:3px 8px;color:#666;font-size:10px;text-align:left'>Step</th><th style='padding:3px 8px;color:#ffd700;font-size:10px;text-align:left'>Value</th><th style='padding:3px 8px;color:#888;font-size:10px;text-align:left'>Formula</th><th style='padding:3px 8px;color:#44ff88;font-size:10px;text-align:left'>Prime?</th><th style='padding:3px 8px;color:#ff9900;font-size:10px;text-align:left'>Axiom</th></tr>";
  mut x = s;
  mut step = 0;
  while step < 8 do (
    let ip = is_prime_trial(x) in
    let name = if x == 1 then "sigma"
      else if x == 2 then "D"
      else if x == 3 then "K"
      else if x == 5 then "E"
      else if x == 7 then "b"
      else if x == 11 then "L"
      else if x == 13 then "GATE"
      else if x == 17 then "ESCAPE"
      else "" in
    let is_ax = if len(name) > 0 then 1 else 0 in
    let p_clr = if ip == 1 then "#44ff88" else "#ff4444" in
    let a_clr = if is_ax == 1 then "#ffd700" else "#666" in
    let formula = if step == 0 then "seed" else ("2*" + "${(x - 1) / 2}" + " + 1") in
    let p_label = if x == 1 then "unit" else (if ip == 1 then "PRIME" else "composite") in
    let p_clr_f = if x == 1 then "#888" else p_clr in
    mut html = html + "<tr><td style='padding:2px 8px;color:#888;font-size:12px'>" + "${step}" + "</td>";
    mut html = html + "<td style='padding:2px 8px;color:#ffd700;font-size:14px;font-weight:bold'>" + "${x}" + "</td>";
    mut html = html + "<td style='padding:2px 8px;color:#888;font-size:11px'>" + formula + "</td>";
    mut html = html + "<td style='padding:2px 8px;color:" + p_clr_f + ";font-size:12px;font-weight:bold'>" + p_label + "</td>";
    mut html = html + "<td style='padding:2px 8px;color:" + a_clr + ";font-size:12px;font-weight:bold'>" + name + "</td></tr>";
    let stop = if ip == 0 then (if x > 1 then 1 else 0) else 0 in
    mut x = 2 * x + 1;
    mut step = step + 1;
    if stop == 1 then break else 0
  );
  mut html = html + "</table>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0;font-size:12px'>c(x) = 2x + 1 (twin Cunningham map). Chain terminates at first composite. Try seeds 1 and 2 to see the axiom chain generated.</p>";
  mut html = html + "</div>";
  dom_inner(result_el, html)
)

fn page_compiler() = (
  dom_head_meta("description", "The .ax Compiler: self-hosting, self-compiling, CC0. Kill #42 = D*K*b = ANSWER. Cunningham Filtration: twin chains from {1,2} generate six primes, closure completes seven. Compiles itself to WASM. Zero dependencies. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The .ax Compiler (CC0 Kill #42)\",\"description\":\"Self-hosting .ax compiler. Cunningham Filtration Theorem: twin chains from seeds {1,2} generate six primes, closure completes seven. CC0.\",\"about\":[\"Cunningham chains\",\"self-hosting compiler\",\"Theorem 53\"],\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/compiler\"}");
  let hero = make_hero("The Compiler") in
  let eq = dom_create("div") in
  dom_text(eq, "G42: D*K*b = 42 = ANSWER. CC0.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "The 42nd CC0 demo is the compiler itself. .ax compiles .ax to WebAssembly. The compiler that built demos #1 through #41 is itself public domain. The ouroboros eats its tail.");
  dom_append(dom_body(), hero);

  /* Section 1: The Ouroboros */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Ouroboros");
 render_theorem(sec1, "Self-Compilation (PROVED)", ".ax source code is compiled to WebAssembly by a compiler written in .ax. The compiler compiles itself, reaching a fixed point: the output of compiling the compiler with itself is byte-for-byte identical to the compiler. deep_ouroboros.wasm = 225KB. Zero external dependencies.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "225KB", "Total compiler size", "tokenizer.ax (288L) + parser.ax (628L) + wasm_emit.ax (~4700L). One WASM file.", "");
  render_finding(g1, "Fixed point", "Self-identical compilation", "Compiler compiles itself. Output = input. The loop closes.", "");
  render_finding(g1, "Zero JS", "WASI toolchain", "wasmtime runs the compiler. No node. No npm. No webpack. Pure WASM.", "");
  render_finding(g1, "3 ops", "meet(*), complement(~), add(+)", "The entire language is built from 3 operations on a ring. K=3.", "");
  dom_append(dom_body(), sec1);

  /* Section 2: Pipeline */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Pipeline");
  render_p(sec2, ".ax source flows through 4 stages, each written in .ax:");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "tokenizer.ax", "288 lines", "Characters to tokens. charCode dispatch, zero allocation.", "");
  render_finding(g2, "parser.ax", "628 lines", "Tokens to AST. Recursive descent, 27 node types.", "");
  render_finding(g2, "wasm_emit.ax", "~4700 lines", "AST to WASM binary. K^2=9 analysis passes.", "");
  render_finding(g2, "evaluator.ax", "~1070 lines", "Runtime interpreter. REPL, meta-eval, ouroboros.", "");
  render_p(sec2, "Source-level include directive expands files before tokenization. Test prelude dissolves boilerplate: one line replaces twelve.");
  render_p(sec2, "The compiler has K^2=9 analysis passes: the spider IS the web. Each pass tightens type information.");
  dom_append(dom_body(), sec2);

  /* Section 2b: Cunningham Filtration (Theorem 53) */
  let sec2b = make_section("800px") in
  render_h2(sec2b, "The Cunningham Filtration");
  render_theorem(sec2b, "Cunningham Filtration (PROVED)", "Twin Cunningham map c(x) = 2x + 1 from seeds {sigma=1, D=2} generates {1, 2, 3, 5, 7, 11} -- the first six chain elements. Closure conditions complete the rest: D^2 + K^2 = 13 = GATE, D + K + E + b = 17 = ESCAPE. ESCAPE is the unique prime p > 13 satisfying finality (E*b = 1 mod p), Fermat (phi(p) = D^4), and chain sum (D+K+E+b = p). Fermat triple: K=3, E=5, ESCAPE=17.");
  let g2b = make_findings_grid(sec2b) in
  render_finding(g2b, "c(1) = 3", "Chain from sigma", "1 -> 3 -> 7 -> 15 (composite). Generates K, b.", "");
  render_finding(g2b, "c(2) = 5", "Chain from D", "2 -> 5 -> 11 -> 23 -> 47 -> 95. Generates E, L.", "");
  render_finding(g2b, "13 = D^2+K^2", "GATE = convergence", "Sum of squares of first two chain primes.", "");
  render_finding(g2b, "17 = D+K+E+b", "ESCAPE = chain sum", "E*b = 1 mod 17 (finality). phi(17) = D^4.", "");
  render_p(sec2b, "The compiler that compiles itself is built on the chain that generates itself. Twin Cunningham chains from just two seeds produce six primes. Two closure conditions complete the seven. The ouroboros reflects this: .ax compiles .ax because the chain closes.");
  make_interactive_widget(sec2b, "Seed (try 1 or 2):", "dcunn-input", "1", "Run Chain", "demo_cunningham_run", "dcunn-result");
  dom_append(dom_body(), sec2b);

  /* Section 3: Try It */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Try It: Live .ax Compiler");
  render_p(sec3, "Type .ax code below. The evaluator (itself written in .ax, compiled to WASM) executes it in your browser:");
  let ex = dom_create("pre") in
  dom_style(ex, "background", "#0a0a18");
  dom_style(ex, "color", "#88ddaa");
  dom_style(ex, "padding", "8px 12px");
  dom_style(ex, "borderRadius", "4px");
  dom_style(ex, "border", "1px solid #333");
  dom_style(ex, "fontFamily", "'Courier New', monospace");
  dom_style(ex, "fontSize", "13px");
  dom_style(ex, "marginBottom", "8px");
  dom_text(ex, "let f = fn(x) = x * x in f(42)");
  dom_append(sec3, ex);
  let ta = dom_create("textarea") in
  dom_attr(ta, "id", "dcomp-input");
  dom_style(ta, "width", "100%");
  dom_style(ta, "height", "80px");
  dom_style(ta, "background", "#1a1a2e");
  dom_style(ta, "color", "#ffd700");
  dom_style(ta, "border", "1px solid #333");
  dom_style(ta, "padding", "8px");
  dom_style(ta, "fontFamily", "'Courier New', monospace");
  dom_style(ta, "fontSize", "14px");
  dom_style(ta, "borderRadius", "4px");
  dom_style(ta, "resize", "vertical");
  dom_append(sec3, ta);
  let btn = dom_create("button") in
  dom_text(btn, "Compile & Run");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "8px 16px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "borderRadius", "4px");
  dom_style(btn, "marginTop", "8px");
  dom_on(btn, "click", "demo_compiler_run");
  dom_append(sec3, btn);
  let r1 = dom_create("div") in
  dom_attr(r1, "id", "dcomp-result");
  dom_style(r1, "marginTop", "12px");
  dom_append(sec3, r1);
  dom_append(dom_body(), sec3);

  /* Section 4: Ouroboros Test */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Ouroboros Test");
  render_p(sec4, "Three levels of self-reference. L1: arithmetic. L2: function definition. L3: the evaluator evaluates itself evaluating code. The snake eats its own tail.");
  let btn2 = dom_create("button") in
  dom_text(btn2, "Run Ouroboros");
  dom_style(btn2, "background", "#ffd700");
  dom_style(btn2, "color", "#0f0f2a");
  dom_style(btn2, "border", "none");
  dom_style(btn2, "padding", "8px 16px");
  dom_style(btn2, "cursor", "pointer");
  dom_style(btn2, "fontFamily", "'Courier New', monospace");
  dom_style(btn2, "fontWeight", "bold");
  dom_style(btn2, "borderRadius", "4px");
  dom_on(btn2, "click", "demo_ouroboros_run");
  dom_append(sec4, btn2);
  let r2 = dom_create("div") in
  dom_attr(r2, "id", "douro-result");
  dom_style(r2, "marginTop", "12px");
  dom_append(sec4, r2);
  render_p(sec4, "See it live: the REPL at /repl interprets .ax using the evaluator, and Try It above does the same.");
  dom_append(dom_body(), sec4);

  /* Section 5: Comparison */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Self-Hosting Compilers: CRT vs Proprietary");
  render_contrast_row(sec5, "Size", "GCC: 15M+ lines. LLVM: 30M+ lines. V8: 4M+ lines.", "deep_ouroboros.wasm: 225KB. ~5600 lines of .ax. One file.");
  render_contrast_row(sec5, "Dependencies", "npm install: 200+ packages. cmake: 50+ deps.", "Zero. .ax compiles .ax. No package manager.");
  render_contrast_row(sec5, "Self-hosting", "GCC compiles itself (multi-stage bootstrap)", ".ax compiles itself to WASM. Fixed point in 1 generation.");
  render_contrast_row(sec5, "Runtime", "Node.js: 70MB. Python: 30MB.", "wasmtime: 40MB. Or any browser. WASM is universal.");
  render_contrast_row(sec5, "License", "GPL (GCC), Apache (LLVM), BSD (V8)", "CC0. Public domain. No license. No restrictions. Forever.");
  render_contrast_row(sec5, "Cost", "MSVC: Visual Studio license. Xcode: Apple hardware.", "$0. Runs in any browser. Runs under wasmtime. Runs anywhere.");
  dom_append(dom_body(), sec5)
)
