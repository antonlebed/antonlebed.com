/* pages_data_2.ax -- DATA continued: dna.
   condensed, statmech, nuclear, particles, pmns, human_shape cut S1934 (COINCIDENCE). */
/* DNA codon ring: Z/21 = Z/3 x Z/7 decomposition */
fn dna_codon_calc() = (
  let n = parse_int_from("#dna-input") in
  let result = dom_query("#dna-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else if n > 64 then dom_inner(result, "<p style='color:#ff6666'>Only 64 codons exist.</p>")
  else (
    let pos = n % 21 in
    let k_ch = pos % 3 in
    let b_ch = pos % 7 in
    let k_class = if k_ch == 0 then "Class 0 (divisible by 3)"
      else if k_ch == 1 then "Class 1 (hydrophobic tendency)"
      else "Class 2 (polar/charged tendency)" in
    let is_stop = if n > 61 then 1 else 0 in
    let note = if n == 64 then " = 2^6 (total codons)"
      else if n == 61 then " = 64 - 3 (sense codons, prime)"
      else if n == 42 then " = 2 * 3 * 7"
      else if n == 21 then " = 3 * 7 (ring wraps)"
      else if n == 3 then " (stop codon count)"
      else if n == 20 then " = 4 * 5 (amino acids)"
      else "" in
    let codon_type = if is_stop > 0 then "<span style='color:#ff6666'>STOP CODON (one of 3 terminators)</span>" else "<span style='color:#88ddaa'>Sense codon</span>" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Codon #${n}${note}</p><p style='margin:4px 0'>Position in Z/21: ${pos}</p><p style='margin:4px 0'>mod 3 channel: <b style='color:#ff9900'>${k_ch}</b> -- ${k_class}</p><p style='margin:4px 0'>mod 7 channel: <b style='color:#4488ff'>${b_ch}</b></p><p style='margin:4px 0'>${codon_type}</p>")
  )
)

fn page_dna() = (
  dom_head_meta("description", "The genetic code decomposes via CRT. 21 amino acid targets live in Z/21 = Z/3 x Z/7. Degeneracy values {1,2,3,4,6} = divisors of phi(21) = 12. Wobble at position 3: 2/3 of mutations are silent.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"DNA\",\"description\":\"The genetic code decomposes via CRT. 21 amino acid targets in Z/3 x Z/7. Degeneracy = divisors of phi(21). Wobble: 2/3 silent mutations.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/dna\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"DNA\"},{\"@type\":\"DefinedTerm\",\"name\":\"genetic code\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"}]}");
  /* === HERO === */
  let hero = make_hero("The Genetic Code") in
  let big = dom_create("div") in
  dom_text(big, "Z/21 = Z/3 x Z/7");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The genetic code maps 64 codons to 21 targets (20 amino acids + stop). Since 21 = 3 * 7 and gcd(3, 7) = 1, the Chinese Remainder Theorem gives Z/21 = Z/3 x Z/7. The mod-3 channel correlates with chemical class. The mod-7 channel correlates with size. Codon degeneracy takes exactly the values {1, 2, 3, 4, 6} -- the divisors of phi(21) = 12.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE NUMBERS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Codon Table Structure");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Structure");
  render_th(chdr, "Count");
  render_th(chdr, "Factorization");
  dom_append(ctbl, chdr);
  render_table_row(ctbl, "Nucleotide bases", "4", "2^2 (A, T/U, G, C)");
  render_table_row(ctbl, "Codons", "64", "2^6 (triplets of 4 bases)");
  render_table_row(ctbl, "Amino acids", "20", "2^2 * 5");
  render_table_row(ctbl, "Stop codons", "3", "3 (UAA, UAG, UGA)");
  render_table_row(ctbl, "Sense codons", "61", "64 - 3 (prime)");
  render_table_row(ctbl, "Amino acid targets", "21", "3 * 7 (20 amino acids + 1 stop group)");
  dom_append(sec1, ctbl);
  render_p(sec1, "The key number is 21: the number of distinct targets the genetic code must distinguish. 21 = 3 * 7, and since gcd(3, 7) = 1, the CRT decomposition Z/21 = Z/3 x Z/7 applies. This gives two independent channels.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CRT DECOMPOSITION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "CRT Decomposition: Z/3 x Z/7");
  render_theorem(sec2, "Codon Ring Decomposition", "Z/21 = Z/3 x Z/7 by CRT (gcd(3,7) = 1). If you number the 21 targets 0-20, each has unique coordinates (residue mod 3, residue mod 7). An observed correlation: mod-3 classes align with amino acid chemical polarity, while mod-7 classes align with molecular size. This is suggestive but not proved to be structural -- the alignment depends on the numbering scheme.");
  render_p(sec2, "Codon degeneracy -- how many codons encode each amino acid -- takes the values {1, 2, 3, 4, 6}. These are exactly the divisors of phi(21) = phi(3) * phi(7) = 2 * 6 = 12. The value 5 cannot appear because 5 does not divide 12.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Degeneracy 1", "Met (M), Trp (W)", "Unique codons. No redundancy. The rarest amino acids.", "");
  render_finding(g2, "Degeneracy 2", "9 amino acids", "2-fold coverage. Wobble at position 3.", "");
  render_finding(g2, "Degeneracy 3", "Ile (I)", "3-fold coverage. Three codons for isoleucine.", "");
  render_finding(g2, "Degeneracy 4", "5 amino acids", "4-fold. Full wobble class.", "");
  render_finding(g2, "Degeneracy 6", "Leu (L), Arg (R), Ser (S)", "6-fold. Maximum redundancy.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: WOBBLE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Wobble: Error Tolerance");
  render_p(sec3, "Point mutations at codon position 3 are silent about 2/3 of the time. The third base 'wobbles' -- multiple bases encode the same amino acid. This is biological error tolerance built into the code's redundancy:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "Position 1", "~0% silent", "First base mutations almost always change the amino acid.", "");
  render_finding(g3, "Position 2", "~5% silent", "Second base: chemical class usually changes.", "");
  render_finding(g3, "Position 3", "~67% silent", "Wobble position. Most mutations are invisible to the protein.", "");
  dom_append(dom_body(), sec3);

  /* === INTERACTIVE: CODON RING EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Codon Ring Z/21");
  render_p(sec_i, "Enter a codon number (1-64). See its position in Z/3 x Z/7. The mod-3 channel correlates with chemical class. The mod-7 channel correlates with size.");
  make_interactive_widget(sec_i, "Codon number (1-64):", "dna-input", "e.g. 42", "Decompose", "dna_codon_calc", "dna-result");
  render_p(sec_i, "Try: 3 (stop codon count), 21 (ring size, 3 * 7), 61 (sense codons, prime), 64 (total, 2^6).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast Table");
  render_contrast_row(sec6, "Codon table", "64 codons organized by first base, memorized", "64 codons map to 21 targets. Z/21 = Z/3 x Z/7 decomposes into independent biochemical axes.");
  render_contrast_row(sec6, "Degeneracy", "Listed per amino acid, no structural pattern", "Exactly the divisors of phi(21) = 12: {1, 2, 3, 4, 6}. 5 is absent because 5 does not divide 12.");
  render_contrast_row(sec6, "Wobble", "Third-position base pairing flexibility", "~2/3 silent mutation rate at position 3. Redundancy concentrated in wobble position.");
  dom_append(dom_body(), sec6)
)
