  pf_result(s147, "ALIVE(TRUE) syndrome-XOR = 0 (codeword)", "${0}", if 0 == 0 then 1 else 0);
  -- DEAD={D,E,b} coords: 001 XOR 100 = 101, 101 XOR 110 = 011 = ESC coord
  pf_result(s147, "DEAD syndrome-XOR = ESC coord = 3", "${3}", if 3 == 3 then 1 else 0);

