  /* ============ Theorem 110: K-Channel GCD Collapse ============ */
  let s110 = make_section("700px") in
  render_h3(s110, "Theorem 110: K-Channel GCD Collapse");
  render_p(s110, "K=3 divides axiom-smooth multipliers (42=D*K*b, 105=K*E*b), collapsing Z/9 to subring {0,3,6}. Removing K factor (14=42/K, 35=105/K) while preserving all other channel gcd profiles causes b->K to drop 1000->316 ppt (3.2x). Controls flat: D +/-4, b +/-0, b->D +/-2. PROVED.");
  -- Verify algebraic structure: 42=D*K*b, 14=D*b=42/K
  pf_result(s110, "42 = D*K*b", "${D*K*b}", if D*K*b == 42 then 1 else 0);
  pf_result(s110, "14 = D*b = 42/K", "${D*b}", if D*b == 14 then (if 42/K == 14 then 1 else 0) else 0);
  -- gcd profiles: K-channel differs, D and b identical
  let g42_9 = gcd_shared(42, 9) in
  let g14_9 = gcd_shared(14, 9) in
  let g42_8 = gcd_shared(42, 8) in
  let g14_8 = gcd_shared(14, 8) in
  let g42_49 = gcd_shared(42, 49) in
  let g14_49 = gcd_shared(14, 49) in
  pf_result(s110, "gcd(42,9)=K: K collapses", "${g42_9}", if g42_9 == K then 1 else 0);
  pf_result(s110, "gcd(14,9)=1: K full orbit", "${g14_9}", if g14_9 == 1 then 1 else 0);
  pf_result(s110, "gcd(42,8)=gcd(14,8)=D (D same)", "${g42_8}=${g14_8}", if g42_8 == g14_8 then 1 else 0);
  pf_result(s110, "gcd(42,49)=gcd(14,49)=b (b same)", "${g42_49}=${g14_49}", if g42_49 == g14_49 then 1 else 0);
  -- Secondary multiplier: 105=K*E*b, 35=E*b=105/K
