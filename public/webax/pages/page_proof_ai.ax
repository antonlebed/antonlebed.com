 render_p(s144, "The free sums {K=3, b=7, D^3=8} form a projective/affine F_2 sequence. K=|P^1(F_2)| (line), b=|P^2(F_2)| (Fano plane), D^3=|F_2^3| (affine cube). Product = 168 = |GL(3,F_2)| = Aut(Fano).");

