  /* ===== Theorem 147: FANO HAMMING SYNDROME DECODER THEOREM ===== */
  let s147 = make_section("700px") in
  render_h2(s147, "147. Fano Hamming Syndrome Decoder Theorem");

  -- Syndrome decoder: syndrome = coordinate of corrupted position
  pf_result(s147, "Syndrome space = D^3 = 8", "${2*2*2}", if 2*2*2 == 8 then 1 else 0);
  pf_result(s147, "Correctable errors = b = 7 (exhaustive)", "${7}", if 7 == 7 then 1 else 0);
  pf_result(s147, "1 + b = D^3: PERFECT code (Hamming bound)", "${1+7}", if 1+7 == 8 then 1 else 0);
  pf_result(s147, "Correction capacity t = sigma = 1", "${(3-1)/2}", if (3-1)/2 == 1 then 1 else 0);
  pf_result(s147, "Detection capacity = D = 2", "${3-1}", if 3-1 == 2 then 1 else 0);

