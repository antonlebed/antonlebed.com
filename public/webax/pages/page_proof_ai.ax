  pf_result(s146, "Rate 4/7: b*4 = D^2*7 = 28", "${7*4}", if 7*4 == 4*7 then 1 else 0);

  -- Sol B: check = {D,K,E}, product = 30
  pf_result(s146, "Sol B check {D,K,E} prod = 30 = primorial(E)", "${2*3*5}", if 2*3*5 == 30 then 1 else 0);
