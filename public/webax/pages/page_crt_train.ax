fn ct_gpu_mul() = gpu_bench(1, 100000, dom_query("#ct-gpu-mul"))
fn ct_gpu_eig() = gpu_bench(2, 100000, dom_query("#ct-gpu-eig"))

/* ===== PAGE ===== */
fn page_crt_train() = (
  dom_head_meta("description", "CRT neural network: 6 independent channels, block-diagonal backprop, L=11 error detection. Live training on 5 datasets (4-500 pts). i32 fixed-point and f64 float modes. Adjustable learning rate. CPU and GPU mini-batch SGD with leaky ReLU and golden interleave. Loss, accuracy, and per-channel convergence curves.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Neural Network\",\"description\":\"6 independent channels, block-diagonal backprop, L=11 ECC. 5 datasets (XOR, Circle, Spiral, Moons, Blobs). GPU via WebGPU.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/living/crt_train\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT neural network\"},{\"@type\":\"DefinedTerm\",\"name\":\"block-diagonal backprop\"}]}");

  /* === HERO (Tower_K: training = closure) === */
  let hero = make_hero("CRT Neural Network") in
  let big = dom_create("div") in
  dom_text(big, "Tower_K closes. 6 channels. L=11 free. Dual bloom.");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Train a neural network split into the 6 TRUE micro tower tops: Z/8, Z/9, Z/25, Z/49, Z/11, Z/13. Each channel trains in Tower_K closure — alone, independently. Tower_D dual bloom: standard network (red) beside CRT ensemble (green). Kill any channel (Tower_GATE boundary) — graceful degradation. Corrupt weights — Tower_L detects it for free. E=5 datasets. Two modes: i32 fixed-point and f64 native float.");
  dom_append(dom_body(), hero);

  /* === HIDDEN STATE === */
  let ws = dom_create("textarea") in dom_attr(ws, "id", "ct-w");
  dom_style(ws, "display", "none"); dom_append(dom_body(), ws);
  let ks = dom_create("textarea") in dom_attr(ks, "id", "ct-kills");
  dom_attr(ks, "value", "0,0,0,0,0,0");
  dom_style(ks, "display", "none"); dom_append(dom_body(), ks);
  let en = dom_create("textarea") in dom_attr(en, "id", "ct-epoch-n");
  dom_attr(en, "value", "0");
  dom_style(en, "display", "none"); dom_append(dom_body(), en);
  let lh = dom_create("textarea") in dom_attr(lh, "id", "ct-loss-hist");
  dom_style(lh, "display", "none"); dom_append(dom_body(), lh);
  let ah = dom_create("textarea") in dom_attr(ah, "id", "ct-acc-hist");
  dom_style(ah, "display", "none"); dom_append(dom_body(), ah);
  let clh = dom_create("textarea") in dom_attr(clh, "id", "ct-ch-loss-hist");
  dom_style(clh, "display", "none"); dom_append(dom_body(), clh);
  let tk = dom_create("textarea") in dom_attr(tk, "id", "ct-task");
  dom_attr(tk, "value", "0");
  dom_style(tk, "display", "none"); dom_append(dom_body(), tk);
  let epc = dom_create("textarea") in dom_attr(epc, "id", "ct-epc");
  dom_attr(epc, "value", "200");
  dom_style(epc, "display", "none"); dom_append(dom_body(), epc);
  let lrs = dom_create("textarea") in dom_attr(lrs, "id", "ct-lr");
  dom_attr(lrs, "value", "150");
  dom_style(lrs, "display", "none"); dom_append(dom_body(), lrs);
  let wfs = dom_create("textarea") in dom_attr(wfs, "id", "ct-wf");
  dom_style(wfs, "display", "none"); dom_append(dom_body(), wfs);

  /* === SEC 1: HOW IT WORKS (tower inventory) === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  let pre = dom_create("pre") in
  dom_text(pre, "STANDARD NEURAL NETWORK:\n  Forward:  x -> W*x + b -> ReLU -> output\n  Backward: full Jacobian (all neurons interact)\n  Cost: O(N^2) per layer\n\nCRT NEURAL NETWORK:\n  Forward:  x -> 6 independent sub-networks -> average\n  Backward: 6 INDEPENDENT Jacobians (block-diagonal)\n  Cost: O(sum(m_i^2)) = O(8^2+9^2+25^2+49^2+11^2+13^2) = O(3461)\n\n  Channel D (mod 8):   Tower_D  — bridge      (depth 3, unique)\n  Channel K (mod 9):   Tower_K  — closure     (depth 2)\n  Channel E (mod 25):  Tower_E  — observer    (depth 2)\n  Channel b (mod 49):  Tower_b  — depth       (depth 2)\n  Channel L (mod 11):  Tower_L  — protector   (ECC, always on)\n  Channel GATE (mod 13): Tower_GATE — boundary (quality gate)\n\nAt N=12612600: 46 BILLION x fewer gradient ops.\nL=11 = free error detection on every inference.");
  dom_style(pre, "background", "#0a0a1a");
  dom_style(pre, "padding", "16px");
  dom_style(pre, "borderRadius", "4px");
  dom_style(pre, "overflow", "auto");
  dom_style(pre, "fontSize", "0.85em");
  dom_style(pre, "lineHeight", "1.6");
  dom_style(pre, "color", "#ccc");
  dom_append(sec1, pre);
  dom_append(dom_body(), sec1);

  /* === SEC 2: LIVE TRAINING (Tower_K: closure machine) === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Live Training");
  render_p(sec2, "Standard = one 2->8->1 network (33 params). CRT = six independent 2->4->1 networks (102 params, 6 micro tower channels x 17 params each), outputs averaged. E=5 tasks: XOR (trivial), Circle (radial boundary), Moons (interleaving crescents), Spiral (hard), Blobs (500 pts, GPU scale). Adjustable learning rate: low (0.05) = stable but slow, high (0.50) = fast but may overshoot. CPU Train = fixed-point i32. CPU Train (f64) = native float with leaky ReLU + sigmoid + cross-entropy (Tower_E precision). GPU uses mini-batch SGD + leaky ReLU 25% + golden interleave (stride 137).");

  /* Task selector */
  let task_row = dom_create("div") in
  dom_style(task_row, "margin", "12px 0");
  dom_style(task_row, "display", "flex");
  dom_style(task_row, "flexWrap", "wrap");
  dom_style(task_row, "alignItems", "center");
  dom_style(task_row, "gap", "8px");
  let task_lbl = dom_create("span") in
  dom_text(task_lbl, "Task: ");
  dom_style(task_lbl, "color", "#888");
  dom_append(task_row, task_lbl);
  let b_xor = dom_create("button") in
  dom_attr(b_xor, "id", "ct-task-xor");
  dom_text(b_xor, "XOR (4 pts)");
  ct_nn_btn(b_xor);
  dom_style(b_xor, "background", "#2a3a4e");
  dom_style(b_xor, "borderColor", "#88ddaa");
  dom_on(b_xor, "click", "on_ct_set_xor");
  dom_append(task_row, b_xor);
  let b_circle = dom_create("button") in
  dom_attr(b_circle, "id", "ct-task-circle");
  dom_text(b_circle, "Circle (50 pts)");
  ct_nn_btn(b_circle);
  dom_on(b_circle, "click", "on_ct_set_circle");
  dom_append(task_row, b_circle);
  let b_spiral = dom_create("button") in
  dom_attr(b_spiral, "id", "ct-task-spiral");
  dom_text(b_spiral, "Spiral (200 pts)");
  ct_nn_btn(b_spiral);
  dom_on(b_spiral, "click", "on_ct_set_spiral");
  dom_append(task_row, b_spiral);
  let b_moons = dom_create("button") in
  dom_attr(b_moons, "id", "ct-task-moons");
  dom_text(b_moons, "Moons (100 pts)");
  ct_nn_btn(b_moons);
  dom_on(b_moons, "click", "on_ct_set_moons");
  dom_append(task_row, b_moons);
  let b_blobs = dom_create("button") in
  dom_attr(b_blobs, "id", "ct-task-blobs");
  dom_text(b_blobs, "Blobs (500 pts)");
  ct_nn_btn(b_blobs);
  dom_on(b_blobs, "click", "on_ct_set_blobs");
  dom_append(task_row, b_blobs);
  dom_append(sec2, task_row);

  /* Epoch selector */
  let ep_row = dom_create("div") in
  dom_style(ep_row, "margin", "12px 0");
  dom_style(ep_row, "display", "flex");
  dom_style(ep_row, "flexWrap", "wrap");
  dom_style(ep_row, "alignItems", "center");
  dom_style(ep_row, "gap", "8px");
  let ep_lbl = dom_create("span") in
  dom_text(ep_lbl, "Epochs/click: ");
  dom_style(ep_lbl, "color", "#888");
  dom_append(ep_row, ep_lbl);
  let be200 = dom_create("button") in
  dom_attr(be200, "id", "ct-ep200");
  dom_text(be200, "200"); ct_nn_btn(be200);
  dom_style(be200, "background", "#2a3a4e");
  dom_style(be200, "borderColor", "#88ddaa");
  dom_on(be200, "click", "on_ct_ep200");
  dom_append(ep_row, be200);
  let be400 = dom_create("button") in
  dom_attr(be400, "id", "ct-ep400");
  dom_text(be400, "400"); ct_nn_btn(be400);
  dom_on(be400, "click", "on_ct_ep400");
  dom_append(ep_row, be400);
  let be1k = dom_create("button") in
  dom_attr(be1k, "id", "ct-ep1000");
  dom_text(be1k, "1000"); ct_nn_btn(be1k);
  dom_on(be1k, "click", "on_ct_ep1000");
  dom_append(ep_row, be1k);
  let be2k = dom_create("button") in
  dom_attr(be2k, "id", "ct-ep2000");
  dom_text(be2k, "2000"); ct_nn_btn(be2k);
  dom_on(be2k, "click", "on_ct_ep2000");
  dom_append(ep_row, be2k);
  dom_append(sec2, ep_row);

  /* Learning rate selector */
  let lr_row = dom_create("div") in
  dom_style(lr_row, "margin", "12px 0");
  dom_style(lr_row, "display", "flex");
  dom_style(lr_row, "flexWrap", "wrap");
  dom_style(lr_row, "alignItems", "center");
  dom_style(lr_row, "gap", "8px");
  let lr_lbl = dom_create("span") in
  dom_text(lr_lbl, "Learning rate: ");
  dom_style(lr_lbl, "color", "#888");
  dom_append(lr_row, lr_lbl);
  let blr50 = dom_create("button") in
  dom_attr(blr50, "id", "ct-lr50");
  dom_text(blr50, "0.05"); ct_nn_btn(blr50);
  dom_on(blr50, "click", "on_ct_lr50");
  dom_append(lr_row, blr50);
  let blr100 = dom_create("button") in
  dom_attr(blr100, "id", "ct-lr100");
  dom_text(blr100, "0.10"); ct_nn_btn(blr100);
  dom_on(blr100, "click", "on_ct_lr100");
  dom_append(lr_row, blr100);
  let blr150 = dom_create("button") in
  dom_attr(blr150, "id", "ct-lr150");
  dom_text(blr150, "0.15"); ct_nn_btn(blr150);
  dom_style(blr150, "background", "#2a3a4e");
  dom_style(blr150, "borderColor", "#88ddaa");
  dom_on(blr150, "click", "on_ct_lr150");
  dom_append(lr_row, blr150);
  let blr300 = dom_create("button") in
  dom_attr(blr300, "id", "ct-lr300");
  dom_text(blr300, "0.30"); ct_nn_btn(blr300);
  dom_on(blr300, "click", "on_ct_lr300");
  dom_append(lr_row, blr300);
  let blr500 = dom_create("button") in
  dom_attr(blr500, "id", "ct-lr500");
  dom_text(blr500, "0.50"); ct_nn_btn(blr500);
  dom_on(blr500, "click", "on_ct_lr500");
  dom_append(lr_row, blr500);
  dom_append(sec2, lr_row);

  /* Buttons */
  let btns = dom_create("div") in
  dom_style(btns, "margin", "16px 0");
  let b_init = dom_create("button") in
  dom_text(b_init, "Initialize");
  ct_nn_btn(b_init);
  dom_on(b_init, "click", "on_ct_init");
  dom_append(btns, b_init);
  let b_train = dom_create("button") in
  dom_text(b_train, "CPU Train");
  ct_nn_btn(b_train);
  dom_style(b_train, "marginLeft", "8px");
  dom_on(b_train, "click", "on_ct_train");
  dom_append(btns, b_train);
  let b_f64 = dom_create("button") in
  dom_text(b_f64, "CPU Train (f64)");
  ct_nn_btn(b_f64);
  dom_style(b_f64, "marginLeft", "8px");
  dom_style(b_f64, "background", "#1a2a1e");
  dom_style(b_f64, "borderColor", "#66bb88");
  dom_on(b_f64, "click", "on_ct_train_f64");
  dom_append(btns, b_f64);
  let ep = dom_create("span") in
  dom_attr(ep, "id", "ct-epoch");
  dom_text(ep, "Epoch: 0");
  dom_style(ep, "marginLeft", "16px");
  dom_style(ep, "color", "#888");
  dom_append(btns, ep);
  dom_append(sec2, btns);
  /* CPU timing result */
  let cpu_res = dom_create("div") in
  dom_attr(cpu_res, "id", "ct-cpu-result");
  dom_style(cpu_res, "color", "#88ddaa");
  dom_style(cpu_res, "fontSize", "0.9em");
  dom_style(cpu_res, "marginBottom", "8px");
  dom_append(sec2, cpu_res);

  /* Side-by-side canvases */
  let row = dom_create("div") in
  dom_style(row, "display", "flex");
  dom_style(row, "gap", "16px");
  dom_style(row, "flexWrap", "wrap");
  dom_style(row, "margin", "16px 0");

  let std_box = dom_create("div") in
  let std_lbl = dom_create("div") in
  dom_text(std_lbl, "Standard Network");
  dom_style(std_lbl, "color", "#ff6666");
  dom_style(std_lbl, "fontWeight", "bold");
  dom_style(std_lbl, "marginBottom", "8px");
  dom_append(std_box, std_lbl);
  let std_cvs = dom_create("canvas") in
  dom_attr(std_cvs, "id", "ct-std-cvs");
  cvs_setsize(std_cvs, 320, 200);
  dom_style(std_cvs, "border", "1px solid #444");
  dom_style(std_cvs, "borderRadius", "4px");
  dom_append(std_box, std_cvs);
  let std_st = dom_create("div") in
  dom_attr(std_st, "id", "ct-std-stats");
  dom_style(std_st, "color", "#aaa");
  dom_style(std_st, "marginTop", "8px");
  dom_text(std_st, "Click Initialize");
  dom_append(std_box, std_st);
  dom_append(row, std_box);

  let crt_box = dom_create("div") in
  let crt_lbl = dom_create("div") in
  dom_text(crt_lbl, "CRT Network (6 channels)");
  dom_style(crt_lbl, "color", "#6aeaa0");
  dom_style(crt_lbl, "fontWeight", "bold");
  dom_style(crt_lbl, "marginBottom", "8px");
  dom_append(crt_box, crt_lbl);
  let crt_cvs = dom_create("canvas") in
  dom_attr(crt_cvs, "id", "ct-crt-cvs");
  cvs_setsize(crt_cvs, 320, 200);
  dom_style(crt_cvs, "border", "1px solid #444");
  dom_style(crt_cvs, "borderRadius", "4px");
  dom_append(crt_box, crt_cvs);
  let crt_st = dom_create("div") in
  dom_attr(crt_st, "id", "ct-crt-stats");
  dom_style(crt_st, "color", "#aaa");
  dom_style(crt_st, "marginTop", "8px");
  dom_text(crt_st, "Click Initialize");
  dom_append(crt_box, crt_st);
  dom_append(row, crt_box);
  dom_append(sec2, row);

  /* Loss curve */
  let loss_lbl = dom_create("div") in
  dom_text(loss_lbl, "Loss Curve");
  dom_style(loss_lbl, "color", "#ffd700");
  dom_style(loss_lbl, "fontWeight", "bold");
  dom_style(loss_lbl, "marginTop", "16px");
  dom_style(loss_lbl, "marginBottom", "8px");
  dom_append(sec2, loss_lbl);
  let loss_cvs = dom_create("canvas") in
  dom_attr(loss_cvs, "id", "ct-loss-cvs");
  cvs_setsize(loss_cvs, 320, 120);
  dom_style(loss_cvs, "border", "1px solid #444");
  dom_style(loss_cvs, "borderRadius", "4px");
  dom_style(loss_cvs, "maxWidth", "100%");
  dom_append(sec2, loss_cvs);
  let loss_hint = dom_create("div") in
  dom_text(loss_hint, "Each dot = loss after 200 epochs. Red = standard, green = CRT.");
  dom_style(loss_hint, "color", "#666");
  dom_style(loss_hint, "fontSize", "0.85em");
  dom_style(loss_hint, "marginTop", "4px");
  dom_append(sec2, loss_hint);

  /* Accuracy curve */
  let acc_lbl = dom_create("div") in
  dom_text(acc_lbl, "Accuracy Curve");
  dom_style(acc_lbl, "color", "#ffd700");
  dom_style(acc_lbl, "fontWeight", "bold");
  dom_style(acc_lbl, "marginTop", "16px");
  dom_style(acc_lbl, "marginBottom", "8px");
  dom_append(sec2, acc_lbl);
  let acc_cvs = dom_create("canvas") in
  dom_attr(acc_cvs, "id", "ct-acc-cvs");
  cvs_setsize(acc_cvs, 320, 120);
  dom_style(acc_cvs, "border", "1px solid #444");
  dom_style(acc_cvs, "borderRadius", "4px");
  dom_style(acc_cvs, "maxWidth", "100%");
  dom_append(sec2, acc_cvs);
  let acc_hint = dom_create("div") in
  dom_text(acc_hint, "Each dot = accuracy (%) after 200 epochs. 50% gridline = random chance.");
  dom_style(acc_hint, "color", "#666");
  dom_style(acc_hint, "fontSize", "0.85em");
  dom_style(acc_hint, "marginTop", "4px");
  dom_append(sec2, acc_hint);

  /* Channel loss curve */
  let ch_lbl = dom_create("div") in
  dom_text(ch_lbl, "Per-Channel Loss");
  dom_style(ch_lbl, "color", "#ffd700");
  dom_style(ch_lbl, "fontWeight", "bold");
  dom_style(ch_lbl, "marginTop", "16px");
  dom_style(ch_lbl, "marginBottom", "8px");
  dom_append(sec2, ch_lbl);
  let ch_cvs = dom_create("canvas") in
  dom_attr(ch_cvs, "id", "ct-ch-loss-cvs");
  cvs_setsize(ch_cvs, 320, 120);
  dom_style(ch_cvs, "border", "1px solid #444");
  dom_style(ch_cvs, "borderRadius", "4px");
  dom_style(ch_cvs, "maxWidth", "100%");
  dom_append(sec2, ch_cvs);
  let ch_hint = dom_create("div") in
  dom_text(ch_hint, "Each trace = one CRT channel's loss. Channels converge independently (block-diagonal backprop).");
  dom_style(ch_hint, "color", "#666");
  dom_style(ch_hint, "fontSize", "0.85em");
  dom_style(ch_hint, "marginTop", "4px");
  dom_append(sec2, ch_hint);

  let spiral_note = dom_create("div") in
  dom_text(spiral_note, "XOR (4 pts) converges in ~200 epochs. Blobs (500 pts) in ~3000. Circle and Moons need 3000+. Spiral (200 pts) is hardest -- the 3-turn boundary stretches 8 hidden units. Learning rate: 0.05 = stable but slow, 0.50 = fast but may overshoot. CPU Train: i32 mini-batch SGD. CPU Train (f64): native float, leaky ReLU + sigmoid -- Circle 50/50, Spiral 114/200 (+10 over i32). GPU: mini-batch SGD + leaky ReLU 25%.");
  dom_style(spiral_note, "color", "#666");
  dom_style(spiral_note, "fontSize", "0.85em");
  dom_style(spiral_note, "marginTop", "8px");
  dom_style(spiral_note, "fontStyle", "italic");
  dom_append(sec2, spiral_note);

  dom_append(dom_body(), sec2);

  /* === SEC 3: CHANNEL ISOLATION (Tower_GATE: boundary test) === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Channel Isolation (Tower_GATE)");
  render_p(sec3, "Tower_GATE = 13 = the boundary between inside and outside. Kill individual channels during inference — the CRT network degrades gracefully because each channel is an independent micro tower. A standard network has no structural channel decomposition — failure is not isolated to independent components.");

  let kill_row = dom_create("div") in
  dom_style(kill_row, "display", "flex");
  dom_style(kill_row, "gap", "8px");
  dom_style(kill_row, "flexWrap", "wrap");
  dom_style(kill_row, "margin", "16px 0");
  mut c = 0;
  while c < 6 do (
    let btn = dom_create("button") in
    let name = if c == 0 then "Toggle D" else if c == 1 then "Toggle K" else if c == 2 then "Toggle E" else if c == 3 then "Toggle b" else if c == 4 then "Toggle L" else "Toggle G" in
    dom_text(btn, name);
    ct_nn_btn(btn);
    let cb = if c == 0 then "on_kill_d" else if c == 1 then "on_kill_k" else if c == 2 then "on_kill_e" else if c == 3 then "on_kill_b" else if c == 4 then "on_kill_l" else "on_kill_g" in
    dom_on(btn, "click", cb);
    dom_style(btn, "borderColor", ct_ch_color(c));
    dom_append(kill_row, btn);
    mut c = c + 1
  );
  dom_append(sec3, kill_row);

  let ch_row = dom_create("div") in
  dom_style(ch_row, "display", "flex");
  dom_style(ch_row, "gap", "16px");
  dom_style(ch_row, "flexWrap", "wrap");
  dom_style(ch_row, "margin", "16px 0");
  mut c = 0;
  while c < 6 do (
    let ch_box = dom_create("div") in
    dom_attr(ch_box, "id", "ct-ch${c}");
    let name = if c == 0 then "D" else if c == 1 then "K" else if c == 2 then "E" else if c == 3 then "b" else if c == 4 then "L" else "G" in
    dom_text(ch_box, "${name}: -");
    dom_style(ch_box, "padding", "8px 12px");
    dom_style(ch_box, "background", "#16213e");
    dom_style(ch_box, "borderRadius", "4px");
    dom_style(ch_box, "color", "#888");
    dom_append(ch_row, ch_box);
    mut c = c + 1
  );
  dom_append(sec3, ch_row);
  render_p(sec3, "Even with channels dead, remaining micro towers reconstruct a partial answer. With Tower_L alive, corruption in any other channel is detectable — the protector watches all.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: L=11 ERROR DETECTION (Tower_L: protector) === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "L=11 Error Detection (Tower_L)");
  render_p(sec4, "Tower_L = 11 = sigma+D+K+E, the protector. Corrupt the b-channel weights with random noise. L=11 detects corruption by comparing its independent prediction against the corrupted consensus. No additional cost — Tower_L trains as part of CRT decomposition, protecting all other channels for free.");
  let corr_btn = dom_create("button") in
  dom_text(corr_btn, "Corrupt b-channel");
  ct_nn_btn(corr_btn);
  dom_on(corr_btn, "click", "on_ct_corrupt");
  dom_append(sec4, corr_btn);
  let corr_out = dom_create("div") in
  dom_attr(corr_out, "id", "ct-corrupt-out");
  dom_style(corr_out, "marginTop", "16px");
  dom_style(corr_out, "padding", "12px");
  dom_style(corr_out, "background", "#1a1a2e");
  dom_style(corr_out, "borderRadius", "4px");
  dom_style(corr_out, "color", "#aaa");
  dom_text(corr_out, "Train a model, then click to corrupt and detect.");
  dom_append(sec4, corr_out);
  dom_append(dom_body(), sec4);

  /* === SEC 5: THE NUMBERS (Tower_D: dual bloom) === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Standard vs CRT (Tower_D)");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  dom_style(ctbl, "tableLayout", "fixed");
  let chdr = dom_create("tr") in
  let th1 = dom_create("th") in dom_text(th1, "Property");
  dom_style(th1, "width", "25%");
  dom_style(th1, "padding", "clamp(4px, 1.5vw, 12px)");
  dom_style(th1, "color", "#ffd700"); dom_style(th1, "fontSize", "clamp(10px, 2.5vw, 12px)");
  dom_style(th1, "textTransform", "uppercase"); dom_style(th1, "textAlign", "left");
  dom_append(chdr, th1);
  let th2 = dom_create("th") in dom_text(th2, "Standard");
  dom_style(th2, "width", "37%");
  dom_style(th2, "padding", "clamp(4px, 1.5vw, 12px)");
  dom_style(th2, "color", "#ffd700"); dom_style(th2, "fontSize", "clamp(10px, 2.5vw, 12px)");
  dom_style(th2, "textTransform", "uppercase"); dom_style(th2, "textAlign", "center");
  dom_append(chdr, th2);
  let th3 = dom_create("th") in dom_text(th3, "CRT");
  dom_style(th3, "width", "38%");
  dom_style(th3, "padding", "clamp(4px, 1.5vw, 12px)");
  dom_style(th3, "color", "#ffd700"); dom_style(th3, "fontSize", "clamp(10px, 2.5vw, 12px)");
  dom_style(th3, "textTransform", "uppercase"); dom_style(th3, "textAlign", "left");
  dom_append(chdr, th3);
  dom_append(ctbl, chdr);
  render_table_row(ctbl, "Backprop", "Full Jacobian", "Block-diagonal (6 independent)");
  render_table_row(ctbl, "Ops at N=12612600", "N^2 = 159 trillion", "sum(m_i^2) = 3,461");
  render_table_row(ctbl, "Savings", "1x", "46,000,000,000x");
  render_table_row(ctbl, "Channel failure", "Entangled", "Graceful degradation");
  render_table_row(ctbl, "Error detection", "External validation", "L=11 built-in (free)");
  render_table_row(ctbl, "Parallelism", "Synchronous", "6 independent machines");
  render_table_row(ctbl, "Hot swap", "Retrain everything", "Add/remove channels");
  dom_append(sec5, ctbl);
  render_p(sec5, "Tower_D = 2 = the bridge. This table IS dual bloom — two views, same data. CRT decomposition is EXACT — the Chinese Remainder Theorem guarantees unique reconstruction. The 46B x savings is the mathematical ratio N^2/sum(m_i^2) at N=12612600 (TRUE ring).");
  render_p(sec5, "HONEST NOTE: This comparison overstates practical benefit. Real neural networks do not have N=12612600 parameters in one layer. The block-diagonal structure trades off representational capacity for computational independence. Whether CRT decomposition improves real ML workloads has not been benchmarked against PyTorch or JAX. The demos above are toy problems. The architecture idea (independent sub-networks with built-in ECC) is novel; its practical value is an open question.");
  render_theorem(sec5, "24x mulmod Elimination (S1237, COMPUTED)", "In Z/12612600, each ring multiply requires mulmod with ~24 binary-method iterations (log2 N). Per-channel: one i32 multiply (max 48*48=2304, no overflow). Forward + backward: 9 multiplies per sample. Full ring: 9 x 24 = 216 iterations. Per-channel parallel: 9 i32 ops across 6 channels = 9 wall-clock ops. Speedup: 24x from mulmod elimination alone, 6x additional from channel parallelism. Verified via test_crt_backprop.ax: 120/120 gradient channel checks pass. Per-channel training converged on XOR (6 independent networks, CRT-reconstructed 4/4). CC0.");
  dom_append(dom_body(), sec5);

  /* === SEC 5b: GPU BLOCK-DIAGONAL BACKPROP (Tower_ESCAPE: transcend to GPU) === */
  let secg = make_section("800px") in
  render_h2(secg, "GPU Backprop (Tower_ESCAPE)");
  /* S1233: gpu_init async — always render, gpu_bench checks at click time */
  render_p(secg, "Tower_ESCAPE = 17 = transcendence. E*b dissolves to sigma mod 17. GPU compute IS the escape — CRT block-diagonal backprop maps directly to WGSL compute shaders: 6 independent channels = 6 workgroups, each a micro tower operating in parallel. Each benchmark dispatches 100,000 ring elements through the TRUE ring Z/12612600.");
  let mk_btn = fn(label) = (
    let b = dom_create("button") in
    dom_text(b, label); ct_nn_btn(b);
    dom_style(b, "marginRight", "8px"); dom_style(b, "marginBottom", "8px"); b
  ) in
  let b1 = mk_btn("Ring Add (forward pass)") in
  let b2 = mk_btn("CRT Multiply (gradient)") in
  let b3 = mk_btn("Eigenvalue (convergence)") in
  let r1 = dom_create("div") in dom_attr(r1, "id", "ct-gpu-add");
  let r2 = dom_create("div") in dom_attr(r2, "id", "ct-gpu-mul");
  let r3 = dom_create("div") in dom_attr(r3, "id", "ct-gpu-eig");
  dom_on(b1, "click", "ct_gpu_add");
  dom_on(b2, "click", "ct_gpu_mul");
  dom_on(b3, "click", "ct_gpu_eig");
  dom_append(secg, b1); dom_append(secg, b2); dom_append(secg, b3);
  dom_append(secg, r1); dom_append(secg, r2); dom_append(secg, r3);
  render_p(secg, "Each operation runs as a WGSL compute shader with 6 CRT channels. Ring Add = forward pass accumulation. CRT Multiply = block-diagonal gradient step. Eigenvalue = convergence check. All verified against CPU.");

  /* GPU Training */
  let gpu_sep = dom_create("div") in
  dom_style(gpu_sep, "borderTop", "1px solid #333");
  dom_style(gpu_sep, "marginTop", "24px");
  dom_style(gpu_sep, "paddingTop", "16px");
  dom_append(secg, gpu_sep);
  let gpu_lbl = dom_create("div") in
  dom_text(gpu_lbl, "GPU Training (WebGPU compute)");
  dom_style(gpu_lbl, "color", "#ffd700");
  dom_style(gpu_lbl, "fontWeight", "bold");
  dom_style(gpu_lbl, "marginBottom", "8px");
  dom_append(secg, gpu_lbl);
  render_p(secg, "Train the same CRT network on GPU. Mini-batch SGD with leaky ReLU 25% and golden interleave (stride 137), matching CPU training. 7 networks (1 standard + 6 CRT channels) in a single WGSL compute dispatch. Uses the selected learning rate and epoch count. Atomic gradient accumulation in workgroup shared memory.");
  /* GPU-section task selector (mirrors top selector; shares state via ct_update_task_indicators) */
  let gpu_task_row = dom_create("div") in
  dom_style(gpu_task_row, "margin", "12px 0");
  dom_style(gpu_task_row, "display", "flex");
  dom_style(gpu_task_row, "flexWrap", "wrap");
  dom_style(gpu_task_row, "alignItems", "center");
  dom_style(gpu_task_row, "gap", "8px");
  let gpu_task_lbl = dom_create("span") in
  dom_text(gpu_task_lbl, "Task: ");
  dom_style(gpu_task_lbl, "color", "#888");
  dom_append(gpu_task_row, gpu_task_lbl);
  let b2_xor = dom_create("button") in
  dom_attr(b2_xor, "id", "ct-task2-xor");
  dom_text(b2_xor, "XOR (4 pts)");
  ct_nn_btn(b2_xor);
  dom_style(b2_xor, "background", "#2a3a4e");
  dom_style(b2_xor, "borderColor", "#88ddaa");
  dom_on(b2_xor, "click", "on_ct_set_xor");
  dom_append(gpu_task_row, b2_xor);
  let b2_circle = dom_create("button") in
  dom_attr(b2_circle, "id", "ct-task2-circle");
  dom_text(b2_circle, "Circle (50 pts)");
  ct_nn_btn(b2_circle);
  dom_on(b2_circle, "click", "on_ct_set_circle");
  dom_append(gpu_task_row, b2_circle);
  let b2_spiral = dom_create("button") in
  dom_attr(b2_spiral, "id", "ct-task2-spiral");
  dom_text(b2_spiral, "Spiral (200 pts)");
  ct_nn_btn(b2_spiral);
  dom_on(b2_spiral, "click", "on_ct_set_spiral");
  dom_append(gpu_task_row, b2_spiral);
  let b2_moons = dom_create("button") in
  dom_attr(b2_moons, "id", "ct-task2-moons");
  dom_text(b2_moons, "Moons (100 pts)");
  ct_nn_btn(b2_moons);
  dom_on(b2_moons, "click", "on_ct_set_moons");
  dom_append(gpu_task_row, b2_moons);
  let b2_blobs = dom_create("button") in
  dom_attr(b2_blobs, "id", "ct-task2-blobs");
  dom_text(b2_blobs, "Blobs (500 pts)");
  ct_nn_btn(b2_blobs);
  dom_on(b2_blobs, "click", "on_ct_set_blobs");
  dom_append(gpu_task_row, b2_blobs);
  dom_append(secg, gpu_task_row);
  let b_gpu = dom_create("button") in
  dom_text(b_gpu, "GPU Train");
  ct_nn_btn(b_gpu);
  dom_on(b_gpu, "click", "on_ct_gpu_train");
  dom_append(secg, b_gpu);
  let gpu_res = dom_create("div") in
  dom_attr(gpu_res, "id", "ct-gpu-result");
  dom_style(gpu_res, "marginTop", "8px");
  dom_append(secg, gpu_res);

  dom_append(dom_body(), secg);

  /* === SEC 5c: MODEL EXPORT (Tower_GATE: boundary crossing) === */
  let secx = make_section("800px") in
  render_h2(secx, "Export Model (Tower_GATE)");
  render_p(secx, "Export trained weights as 135 comma-separated i32 values (scale 1000) from CPU Train mode. Copy and reuse in .ax programs or external tools. (f64 weights stored separately.)");
  let b_exp = dom_create("button") in
  dom_text(b_exp, "Export Weights");
  ct_nn_btn(b_exp);
  dom_on(b_exp, "click", "on_ct_export");
  dom_append(secx, b_exp);
  let exp_out = dom_create("pre") in
  dom_attr(exp_out, "id", "ct-export-out");
  dom_style(exp_out, "background", "#0a0a1a");
  dom_style(exp_out, "padding", "12px");
  dom_style(exp_out, "borderRadius", "4px");
  dom_style(exp_out, "marginTop", "12px");
  dom_style(exp_out, "fontSize", "0.8em");
  dom_style(exp_out, "color", "#aaa");
  dom_style(exp_out, "whiteSpace", "pre-wrap");
  dom_style(exp_out, "wordBreak", "break-all");
  dom_style(exp_out, "maxHeight", "200px");
  dom_style(exp_out, "overflow", "auto");
  dom_text(exp_out, "Train a model, then export.");
  dom_append(secx, exp_out);
  dom_append(dom_body(), secx);

  /* === SEC 6: f64 TRAINING (Tower_E: observer precision) === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "f64 Training (Tower_E)");
  render_p(sec6, "Tower_E = the observer. E^2=0 mod 25: the observer cannot see itself (PROVED). f64 mode maps to Tower_E's theme — higher precision observation. Native float lifts the i32 truncation veil. Same 7-network architecture (1 standard nh=8 + 6 CRT nh=4 = 135 params), native WASM float64: leaky ReLU hidden (alpha=0.01), sigmoid output, cross-entropy gradient. No clipping, no overflow, no fixed-point truncation.");
  let pre6 = dom_create("pre") in
  dom_text(pre6, "i32 FIXED-POINT (CPU Train):\n  Scale 1000. Gradients clipped +-1000. Weights clamped +-5000.\n  Circle: 49/50.  Spiral: 104/200.  Moons: 73/100.\n\nf64 NATIVE FLOAT (CPU Train f64):\n  sigmoid(x) = 1/(1+exp(-x)).  leaky_relu(x, 0.01).\n  Circle: 50/50 (perfect).  Spiral: 114/200 (+10).  Moons: 74/100.\n\nWHY f64 WINS:\n  No gradient truncation at decision boundaries.\n  Sigmoid output = proper [0,1] probabilities.\n  Cross-entropy gradient = (sigmoid(z) - target), no clipping needed.\n  He initialization with sqrt() = proper scale per fan-in.");
  dom_style(pre6, "background", "#0a0a1a");
  dom_style(pre6, "padding", "16px");
  dom_style(pre6, "borderRadius", "4px");
  dom_style(pre6, "overflow", "auto");
  dom_style(pre6, "fontSize", "0.85em");
  dom_style(pre6, "lineHeight", "1.6");
  dom_style(pre6, "color", "#ccc");
  dom_append(sec6, pre6);
  render_p(sec6, "Both modes use the same CRT decomposition: 6 independent sub-networks whose predictions are averaged at inference. This is classic ensemble regularization -- each channel sees the full training signal, trains independently, and averaging smooths individual errors. The f64 mode makes this visible: smoother decision boundaries, faster convergence, higher accuracy on all datasets. Tested: momentum SGD helps the standard network (Moons 71 to 83 at beta=0.9) but HURTS CRT (74 to 69). Similarly, adding a second hidden layer helps standard (Moons 71 to 84) but NOT CRT (74 to 72). Both momentum and depth add regularization that a single large network needs, but CRT's ensemble averaging already provides it. LR robustness: sweeping 7 learning rates (0.10 to 2.00), CRT accuracy varies by only 7 points on Moons vs 13 for standard -- 46 percent less sensitive. CRT works well with any LR in the 0.25 to 1.50 range without per-task tuning. CRT does not need external regularization -- the structure IS the regularizer.");
  dom_append(dom_body(), sec6);

  /* === SEC 7: IMPLEMENTATION (Tower_K: self-hosting closure) === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Implementation (Tower_K)");
  render_p(sec7, "Tower_K = closure. This demo IS closure — .ax compiled to WebAssembly by a self-hosting .ax compiler (the ouroboros). Two training modes: i32 fixed-point (scale 1000) and f64 native float (leaky ReLU + sigmoid + cross-entropy). 135 parameters: 33 standard (nh=8) + 102 CRT (6 channels x 17 params). Training: mini-batch SGD with golden interleave — perm[i] = (i*137) % nd — the phyllotaxis constant as CRT mixing schedule. 137 = floor(golden angle in degrees). CRT = 6 independent micro towers averaged at inference = built-in ensemble regularization.");
  let link = dom_create("a") in
  dom_text(link, "Full CRT AI architecture >");
  dom_attr(link, "href", "/living/ai");
  dom_style(link, "color", "#ff9900");
  dom_style(link, "display", "block");
  dom_style(link, "marginTop", "16px");
  dom_append(sec7, link);
  dom_append(dom_body(), sec7);
  /* Draw initial curve placeholders */
  ct_draw_loss_curve();
  ct_draw_acc_curve();
  ct_draw_ch_loss_curve()
)
