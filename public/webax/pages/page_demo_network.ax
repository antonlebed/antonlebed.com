/* page_demo_network.ax -- Network demo pages: consensus, timetabling. Split from page_demos.ax. */

/* Modular multiply for CRT reconstruction. a is small (0-48), bb up to N-1. */
fn net_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb % m;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

/* ================================================================
   CRT CONSENSUS -- dedicated demo page /demos/consensus. CC0 kill B10.
   7-channel independent voting. O(n) messages.
   ================================================================ */

fn demo_consensus_run() = (
  let n_nodes = parse_int_from("#dcon-nodes") in
  let result_el = dom_query("#dcon-result") in
  let value = parse_int_from("#dcon-value") in
  let n_byz = parse_int_from("#dcon-byz") in
  if n_nodes < 5 then dom_inner(result_el, "<p style='color:#ff6666'>Need at least 5 nodes.</p>")
  else if n_byz >= n_nodes then dom_inner(result_el, "<p style='color:#ff6666'>Byzantine count must be less than node count.</p>")
  else (
    let nn = 214414200 in
    let vtf = value % nn in
    let mods = [8, 9, 25, 49, 11, 13, 17] in
    let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
    let tv = [vtf % 8, vtf % 9, vtf % 25, vtf % 49, vtf % 11, vtf % 13, vtf % 17] in
    let honest = [0, 0, 0, 0, 0, 0, 0] in
    mut i = 0;
    while i < n_nodes do (
      let is_byz = if i < n_byz then 1 else 0 in
      mut ch = 0;
      while ch < 7 do (
        let m = mods[ch] in
        let vote = if is_byz == 1 then rand(m) else tv[ch] in
        if vote == tv[ch] then set(honest, ch, honest[ch] + 1) else 0;
        mut ch = ch + 1
      );
      mut i = i + 1
    );
    let half = n_nodes / 2 in
    mut channels_ok = 0;
    mut recon = 0;
    mut ch2 = 0;
    while ch2 < 7 do (
      if honest[ch2] > half then (
        mut recon = (recon + net_mulmod(tv[ch2], idem[ch2])) % nn;
        mut channels_ok = channels_ok + 1
      ) else 0;
      mut ch2 = ch2 + 1
    );
    let correct = if channels_ok == 7 then (if recon == vtf then 1 else 0) else 0 in
    let byz_pct = (n_byz * 100) / n_nodes in
    mut maj_html = "";
    mut ch3 = 0;
    while ch3 < 7 do (
      let m = mods[ch3] in
      mut maj_html = maj_html + "mod" + "${m}" + "=" + "${honest[ch3]}" + "/" + "${n_nodes}" + " ";
      mut ch3 = ch3 + 1
    );
    dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT CONSENSUS: " + "${n_nodes}" + " nodes, " + "${n_byz}" + " Byzantine (" + "${byz_pct}" + "%)</p><p style='margin:4px 0;color:#b0b0c0'>True value: " + "${vtf}" + " = (" + "${tv[0]}" + "," + "${tv[1]}" + "," + "${tv[2]}" + "," + "${tv[3]}" + "," + "${tv[4]}" + "," + "${tv[5]}" + "," + "${tv[6]}" + ")</p><p style='margin:4px 0;color:#b0b0c0'>Channel majorities: " + maj_html + "</p><p style='margin:4px 0;color:" + (if correct == 1 then "#44ff88" else "#ff4444") + ";font-size:16px'>" + (if correct == 1 then "CONSENSUS CORRECT" else "CONSENSUS FAILED") + " (" + "${channels_ok}" + "/7 channels held)</p></div>")
  )
)

fn demo_consensus_sweep() = (
  let result_el = dom_query("#dcon-sweep-result") in
  let n = 51 in let value = 42 in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  let tv = [value % 8, value % 9, value % 25, value % 49, value % 11, value % 13, value % 17] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>STRESS TEST: 51 nodes, value=42, sweeping Byzantine 0-25</p><table style='width:100%;border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Byz</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>%</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>OK</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Result</th></tr>";
  mut byz = 0;
  while byz < 26 do (
    let hh = [0, 0, 0, 0, 0, 0, 0] in
    mut i = 0;
    while i < n do (
      let is_byz = if i < byz then 1 else 0 in
      mut ch = 0;
      while ch < 7 do (
        let m = mods[ch] in
        let vote = if is_byz == 1 then rand(m) else tv[ch] in
        if vote == tv[ch] then set(hh, ch, hh[ch] + 1) else 0;
        mut ch = ch + 1
      );
      mut i = i + 1
    );
    let half = n / 2 in
    mut ok = 0;
    mut ch2 = 0;
    while ch2 < 7 do (
      if hh[ch2] > half then mut ok = ok + 1 else 0;
      mut ch2 = ch2 + 1
    );
    let pct = (byz * 100) / n in
    let color = if ok == 7 then "#44ff88" else "#ff4444" in
    mut html = html + "<tr><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${byz}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${pct}" + "%</td><td style='padding:3px;color:" + color + ";font-size:12px'>" + "${ok}" + "/7</td><td style='padding:3px;color:" + color + ";font-size:12px'>" + (if ok == 7 then "CORRECT" else "FAILED") + "</td></tr>";
    mut byz = byz + 1
  );
  dom_inner(result_el, html + "</table></div>")
)

fn page_consensus() = (
  dom_head_meta("description", "CRT Byzantine Consensus. 7 independent voting channels over Z/214,414,200. O(n) messages. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Byzantine Consensus\",\"description\":\"7-channel independent voting over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/consensus\"}");
  let hero = make_hero("CRT Consensus") in
  let eq = dom_create("div") in
  dom_text(eq, "Blockchain patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "Majority vote scales to distributed consensus. Each CRT channel = independent voting group. Byzantine nodes in one channel cannot affect others. CRT reconstructs the global consensus from 7 independent local votes. O(n) messages. No blockchain.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Fault Tolerance", "Traditional BFT: tolerates f < n/3 with O(n^2) messages. CRT: 7 independent channels vote by majority. Any single channel can be fully corrupted and the other 6 still reconstruct correctly. Channel independence = algebraic firewall.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "Decompose", "CRT scatter", "True value decomposed into 7 channels. Each node votes in all 7 independently.", "");
  render_finding(g1, "Vote", "Per-channel majority", "Each channel: honest majority wins. 3 is the minimum for majority.", "");
  render_finding(g1, "Reconstruct", "CRT fold", "7 channel winners reconstructed to unique global value via CRT.", "");
  render_finding(g1, "Contain", "Algebraic firewall", "Byzantine corruption in one channel CANNOT propagate to others.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Nodes (min 5):", "dcon-nodes", "e.g. 25", "Run Consensus", "demo_consensus_run", "dcon-result");
  let extras = dom_create("div") in
  dom_style(extras, "display", "flex");
  dom_style(extras, "gap", "8px");
  dom_style(extras, "alignItems", "center");
  dom_style(extras, "marginBottom", "12px");
  let inp_v = dom_create("input") in
  dom_attr(inp_v, "type", "text");
  dom_attr(inp_v, "id", "dcon-value");
  dom_attr(inp_v, "placeholder", "value (e.g. 42)");
  dom_attr(inp_v, "value", "42");
  dom_style(inp_v, "background", "#111");
  dom_style(inp_v, "color", "#eee");
  dom_style(inp_v, "border", "1px solid #333");
  dom_style(inp_v, "padding", "6px 8px");
  dom_style(inp_v, "fontFamily", "'Courier New', monospace");
  dom_style(inp_v, "width", "100px");
  dom_append(extras, inp_v);
  let inp_b = dom_create("input") in
  dom_attr(inp_b, "type", "text");
  dom_attr(inp_b, "id", "dcon-byz");
  dom_attr(inp_b, "placeholder", "byzantine (e.g. 5)");
  dom_attr(inp_b, "value", "5");
  dom_style(inp_b, "background", "#111");
  dom_style(inp_b, "color", "#eee");
  dom_style(inp_b, "border", "1px solid #333");
  dom_style(inp_b, "padding", "6px 8px");
  dom_style(inp_b, "fontFamily", "'Courier New', monospace");
  dom_style(inp_b, "width", "120px");
  dom_append(extras, inp_b);
  dom_append(sec2, extras);
  dom_append(dom_body(), sec2);
  let sec3c = make_section("800px") in
  render_h2(sec3c, "Byzantine Sweep");
  render_p(sec3c, "Sweep Byzantine count 0-25 on 51-node network.");
  let btn2 = dom_create("button") in
  dom_text(btn2, "Run Sweep");
  dom_style(btn2, "background", "#ffd700");
  dom_style(btn2, "color", "#0f0f2a");
  dom_style(btn2, "border", "none");
  dom_style(btn2, "padding", "8px 16px");
  dom_style(btn2, "cursor", "pointer");
  dom_style(btn2, "fontFamily", "'Courier New', monospace");
  dom_style(btn2, "fontWeight", "bold");
  dom_style(btn2, "borderRadius", "4px");
  dom_on(btn2, "click", "demo_consensus_sweep");
  dom_append(sec3c, btn2);
  let sr = dom_create("div") in
  dom_attr(sr, "id", "dcon-sweep-result");
  dom_append(sec3c, sr);
  dom_append(dom_body(), sec3c);
  let sec4 = make_section("800px") in
  render_h2(sec4, "CRT Consensus vs Traditional");
  render_contrast_row(sec4, "Messages/round", "O(n^2) in PBFT", "O(n) -- each node votes in its channel");
  render_contrast_row(sec4, "Fault tolerance", "f < n/3 (33%)", "Per-channel majority across 7 independent channels");
  render_contrast_row(sec4, "Energy cost", "PoW: EXTREME", "NEGLIGIBLE -- modular arithmetic");
  render_contrast_row(sec4, "Finality", "Blockchain: ~6 blocks", "1 round -- CRT reconstruction instant");
  render_contrast_row(sec4, "Code complexity", "~50,000 LOC", "<200 LOC -- CRT consensus protocol");
  render_contrast_row(sec4, "Channels", "Single voting dimension", "7 algebraically independent dimensions");
  dom_append(dom_body(), sec4)
)

/* ================================================================
   CRT RNG -- dedicated demo page /demos/rng. CC0 kill A9.
   7-channel primitive root mixing.
   ================================================================ */

/* ================================================================
   CRT TIMETABLING -- dedicated demo page /demos/timetabling. CC0 kill C17.
   CRT-factored constraint satisfaction. 7 constraint dimensions.
   Each channel = one scheduling constraint. CRT = conflict-free assignment.
   3 data channels = resource constraints (room, teacher, group).
   4 parity channels = temporal constraints (period, day, week, term).
   ================================================================ */

/* Assign event i to a 7-dimensional CRT slot.
   Uses a hash-like scatter to avoid sequential clustering.
   Each channel = one constraint dimension. */
fn tt_assign(event_id) = (
  let nn = 214414200 in
  let seed = event_id * 137 + 41 in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let r0 = (seed * 3 + event_id + 1) % 8 in
  let r1 = (seed * 5 + event_id * 2 + 1) % 9 in
  let r2 = (seed * 7 + event_id * 3 + 1) % 25 in
  let r3 = (seed * 11 + event_id * 5 + 1) % 49 in
  let r4 = (seed * 13 + event_id * 7 + 1) % 11 in
  let r5 = (seed * 17 + event_id * 11 + 1) % 13 in
  let r6 = (seed * 19 + event_id * 13 + 1) % 17 in
  let res = [r0, r1, r2, r3, r4, r5, r6] in
  mut slot = 0;
  mut ch = 0;
  while ch < 7 do (
    mut slot = (slot + net_mulmod(res[ch], idem[ch])) % nn;
    mut ch = ch + 1
  );
  slot
)

/* Check if two events conflict in channel ch (share same residue) */
fn tt_conflict_ch(a, b, m) = if a % m == b % m then 1 else 0

fn demo_tt_run() = (
  let n_events = parse_int_from("#dtt-input") in
  let result_el = dom_query("#dtt-result") in
  if n_events < 2 then dom_inner(result_el, "<p style='color:#ff6666'>Need at least 2 events.</p>")
  else if n_events > 50 then dom_inner(result_el, "<p style='color:#ff6666'>Max 50 events for display.</p>")
  else (
    let mods = [8, 9, 25, 49, 11, 13, 17] in
    let labels = ["Room", "Period", "Teacher", "Group", "Day", "Week", "Term"] in
    mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 12px'>CRT TIMETABLE: " + "${n_events}" + " events across 7 constraint dimensions</p>";
    /* Build table header */
    mut html = html + "<table style='width:100%;border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Event</th>";
    mut hh = 0;
    while hh < 7 do (
      let is_data = if hh == 0 then 1 else if hh == 2 then 1 else if hh == 3 then 1 else 0 in
      let hcolor = if is_data == 1 then "#ff6666" else "#88ddaa" in
      mut html = html + "<th style='text-align:left;padding:4px;color:" + hcolor + ";font-size:11px'>" + labels[hh] + "(" + "${mods[hh]}" + ")</th>";
      mut hh = hh + 1
    );
    mut html = html + "<th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>CRT Slot</th></tr>";
    /* Show first 12 event assignments */
    let show_n = if n_events > 12 then 12 else n_events in
    mut i = 0;
    while i < show_n do (
      let slot = tt_assign(i) in
      mut html = html + "<tr><td style='padding:3px;color:#ffd700;font-size:12px'>E" + "${i}" + "</td>";
      mut rc = 0;
      while rc < 7 do (
        let is_data = if rc == 0 then 1 else if rc == 2 then 1 else if rc == 3 then 1 else 0 in
        let rcolor = if is_data == 1 then "#ff6666" else "#88ddaa" in
        let rv = slot % mods[rc] in
        mut html = html + "<td style='padding:3px;color:" + rcolor + ";font-size:12px'>" + "${rv}" + "</td>";
        mut rc = rc + 1
      );
      mut html = html + "<td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${slot}" + "</td></tr>";
      mut i = i + 1
    );
    mut html = html + "</table>";
    if n_events > 12 then mut html = html + "<p style='color:#888;font-size:11px;margin:4px 0'>(" + "${n_events - 12}" + " more events not shown)</p>" else 0;
    /* Data/parity split annotation */
    mut html = html + "<p style='color:#ffd700;margin:12px 0 4px'>3+4 SPLIT</p><p style='color:#ff6666;margin:2px 0;font-size:12px'>Data: mod 8 (room), mod 25 (teacher), mod 49 (group) -- resource constraints</p><p style='color:#88ddaa;margin:2px 0;font-size:12px'>Parity: mod 9 (period), mod 11 (day), mod 13 (week), mod 17 (term) -- temporal constraints</p><p style='color:#b0b0c0;margin:2px 0;font-size:12px'>4 parity channels encode the full temporal skeleton of the schedule</p>";
    /* Conflict analysis: check all pairs per channel */
    let conf = [0, 0, 0, 0, 0, 0, 0] in
    mut full_conf = 0;
    mut ii = 0;
    while ii < n_events do (
      let si = tt_assign(ii) in
      mut jj = ii + 1;
      while jj < n_events do (
        let sj = tt_assign(jj) in
        mut ch_matches = 0;
        mut cc = 0;
        while cc < 7 do (
          let conflict = tt_conflict_ch(si, sj, mods[cc]) in
          set(conf, cc, conf[cc] + conflict);
          mut ch_matches = ch_matches + conflict;
          mut cc = cc + 1
        );
        if ch_matches == 7 then mut full_conf = full_conf + 1 else 0;
        mut jj = jj + 1
      );
      mut ii = ii + 1
    );
    let pairs = n_events * (n_events - 1) / 2 in
    mut html = html + "<p style='color:#ffd700;margin:12px 0 4px'>CONFLICT ANALYSIS (" + "${pairs}" + " pairs)</p><table style='width:100%;border-collapse:collapse'><tr>";
    mut cc2 = 0;
    while cc2 < 7 do (
      let is_data = if cc2 == 0 then 1 else if cc2 == 2 then 1 else if cc2 == 3 then 1 else 0 in
      let ccolor = if is_data == 1 then "#ff6666" else "#88ddaa" in
      mut html = html + "<td style='padding:3px;color:" + ccolor + ";font-size:12px'>" + labels[cc2] + "(/" + "${mods[cc2]}" + "): " + "${conf[cc2]}" + "</td>";
      if cc2 == 3 then mut html = html + "</tr><tr>" else 0;
      mut cc2 = cc2 + 1
    );
    mut html = html + "</tr></table>";
    mut html = html + "<p style='color:" + (if full_conf == 0 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>FULL CONFLICTS (all 7 channels): <b>" + "${full_conf}" + "</b>" + (if full_conf == 0 then " -- CONFLICT-FREE SCHEDULE" else "") + "</p><p style='color:#b0b0c0;font-size:12px;margin:4px 0'>CRT capacity: 8*9*25*49*11*13*17 = 214,414,200 unique slots. Per-channel overlaps are expected (pigeonhole). Full conflict = same slot = impossible for distinct assignments.</p></div>";
    dom_inner(result_el, html)
  )
)

fn demo_tt_batch() = (
  let result_el = dom_query("#dtt-batch-result") in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  /* Test: schedule 20, 50, 100 events. Count full conflicts */
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH STRESS TEST</p><table style='width:100%;border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Events</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Pairs</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Full Conflicts</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Result</th></tr>";
  let sizes = [20, 50, 100] in
  mut si = 0;
  while si < 3 do (
    let n = sizes[si] in
    mut fc = 0;
    mut ii = 0;
    while ii < n do (
      let ssi = tt_assign(ii) in
      mut jj = ii + 1;
      while jj < n do (
        let ssj = tt_assign(jj) in
        mut eq = 0;
        mut cc = 0;
        while cc < 7 do (
          if ssi % mods[cc] == ssj % mods[cc] then mut eq = eq + 1 else 0;
          mut cc = cc + 1
        );
        if eq == 7 then mut fc = fc + 1 else 0;
        mut jj = jj + 1
      );
      mut ii = ii + 1
    );
    let pp = n * (n - 1) / 2 in
    let color = if fc == 0 then "#44ff88" else "#ff4444" in
    mut html = html + "<tr><td style='padding:4px;color:#b0b0c0;font-size:13px'>" + "${n}" + "</td><td style='padding:4px;color:#888;font-size:13px'>" + "${pp}" + "</td><td style='padding:4px;color:" + color + ";font-size:13px;font-weight:bold'>" + "${fc}" + "</td><td style='padding:4px;color:" + color + ";font-size:13px'>" + (if fc == 0 then "CONFLICT-FREE" else "CONFLICTS") + "</td></tr>";
    mut si = si + 1
  );
  dom_inner(result_el, html + "</table><p style='color:#b0b0c0;font-size:12px;margin:8px 0'>CRT guarantees: unique assignments can never collide. 214,414,200 slots across 7 constraint dimensions. Birthday paradox requires ~14,600 events for 50% single-channel collision (room sharing), but full 7-channel collision requires identical CRT address = duplicate assignment.</p></div>")
)

fn page_timetabling() = (
  dom_head_meta("description", "CRT Timetabling. 7-channel constraint satisfaction over Z/214,414,200. Resource vs temporal constraints. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Timetabling\",\"description\":\"7-channel constraint satisfaction for scheduling over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/timetabling\"}");
  let hero = make_hero("CRT Timetabling") in
  let eq = dom_create("div") in
  dom_text(eq, "OR software patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT decomposition IS constraint satisfaction. Every scheduling event maps to a unique 7-dimensional address. Each channel = one constraint: room, period, teacher, group, day, week, term. 3 data channels encode resource constraints (room/teacher/group). 4 parity channels encode temporal constraints (period/day/week/term). 214,414,200 conflict-free slots.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Scheduling Principle", "A schedule with R rooms, P periods, T teachers, G groups, D days, W weeks, and S terms has R*P*T*G*D*W*S possible slots. CRT maps this to Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17 = Z/214,414,200. Each event gets a UNIQUE CRT address. Two events conflict only if they share the same residue in a constraint channel. Full conflict (all 7 channels) = same slot = impossible for distinct assignments.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 constraints", "CRT channels", "room(8), period(9), teacher(25), group(49), day(11), week(13), term(17).", "");
  render_finding(g1, "3+4 split", "Resource vs temporal", "3 data = resource. 4 parity = temporal. Independent dimensions.", "");
  render_finding(g1, "Independence", "Per-channel check", "Room conflict and day conflict are algebraically independent events.", "");
  render_finding(g1, "Capacity", "214,414,200 slots", "8 rooms * 9 periods * 25 teachers * 49 groups * 11 days * 13 weeks * 17 terms.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Number of events to schedule (2-50):", "dtt-input", "e.g. 20", "Schedule", "demo_tt_run", "dtt-result");
  render_p(sec2, "Each event gets a unique 7-channel CRT address. Red = resource (data channels). Green = temporal (parity channels).");
  dom_append(dom_body(), sec2);
  let sec3h = make_section("800px") in
  render_h2(sec3h, "Batch Stress Test");
  render_p(sec3h, "Schedule 20, 50, and 100 events. Count full conflicts (events assigned to identical slots).");
  let btn = dom_create("button") in
  dom_text(btn, "Run Batch Test");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "8px 16px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "borderRadius", "4px");
  dom_on(btn, "click", "demo_tt_batch");
  dom_append(sec3h, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dtt-batch-result");
  dom_append(sec3h, br);
  dom_append(dom_body(), sec3h);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Timetabling vs Traditional");
  render_contrast_row(sec3, "Approach", "Constraint propagation / backtracking", "CRT: direct channel assignment. No search.");
  render_contrast_row(sec3, "Complexity", "NP-hard (exponential worst case)", "O(n) per event (CRT decomposition)");
  render_contrast_row(sec3, "Conflict detection", "Constraint graph traversal", "Per-channel modular comparison");
  render_contrast_row(sec3, "Scalability", "Degrades with constraints", "7 channels independent. Scales linearly.");
  render_contrast_row(sec3, "Patent status", "Gurobi/CPLEX/OR-Tools patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3);
  let sec4 = make_section("800px") in
  render_h2(sec4, "The 3+4 Split");
  render_theorem(sec4, "Resource-Temporal Independence", "The 7 channels partition into 3 data channels {mod 8, mod 25, mod 49} (resource constraints: room, teacher, group) and 4 parity channels {mod 9, mod 11, mod 13, mod 17} (temporal constraints: period, day, week, term). The 4 temporal channels ALONE determine when events occur. The 3 resource channels determine where and who. Resources and time are algebraically independent -- the deepest structure of any scheduling problem.");
  render_p(sec4, "The moduli {8,9,25,49,11,13,17} decompose as 2^3, 3^2, 5^2, 7^2, 11, 13, 17. The split groups by underlying prime: {2,5,7} moduli (8, 25, 49) encode resource dimensions, {3,11,13,17} moduli (9, 11, 13, 17) encode temporal dimensions. Any schedule that works temporally can be independently filled with resources. 4 channels encode the full temporal skeleton of a 7-dimensional schedule.");
)
