/* page_ring_sweep.ax -- Phase G2: Ring Sweep.
   8 rings on the same task. Conclusive comparison of ring structure effects.
   Tests: tower ladder (4-7ch), fat vs thin, Pareto vs balanced, chain vs random. */

fn page_ring_sweep() = (
  let hero = make_section("800px") in
  render_h2(hero, "Ring Sweep");
  render_p(hero, "Phase G2 asks: does the axiom ring have COMPUTATIONAL advantages over other rings? We test 8 rings on the same learning task: context-dependent function selection with per-channel evolution. Same architecture, same seeds, different moduli.");
  render_p(hero, "The task: 4 functions (ring multiplications by different weights), 160 training examples, 200 generations of per-channel evolutionary search. Each ring gets the same random seed and the same task structure. The only variable is the moduli.");
  dom_append(dom_body(), hero);

  -- 8 rings tested
  let sec1 = make_section("800px") in
  render_h2(sec1, "8 Rings Tested");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "TRANS", "[8,9,25,49,11,13,17] 7ch", "Axiom ring. Pareto-fat chain-constrained. The standard.", "");
  render_finding(g1, "TRUE", "[8,9,25,49,11,13] 6ch", "Axiom minus ESCAPE. 6 channels.", "");
  render_finding(g1, "DEEP", "[8,9,25,49,11] 5ch", "Body without skin. 5 fat channels.", "");
  render_finding(g1, "DATA", "[2,3,5,7] 4ch", "Thin data ring. 4 small channels.", "");
  render_finding(g1, "RAND7", "[8,9,23,47,11,13,19] 7ch", "Random coprimes. Same sizes, no chain.", "");
  render_finding(g1, "THIN7", "[2,3,5,7,11,13,17] 7ch", "Axiom primes, no fattening.", "");
  render_finding(g1, "BALANCED", "[11,13,17,19,23,29,31] 7ch", "All similar sizes (~20). No structure.", "");
  render_finding(g1, "FAT", "[16,27,25,49,11,13,17] 7ch", "Over-fattened: D^4, K^3 instead of D^3, K^2.", "");
  dom_append(dom_body(), sec1);

  -- Results
  let sec2 = make_section("800px") in
  render_h2(sec2, "Results: ch_score %");
  render_p(sec2, "Per-channel hit percentage (ch_score / max). Higher = better per-channel learning. 200 gen evolution, seed 42/100/200.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "DATA 4ch", "90%", "BEST per-channel. Fewest channels = easiest search per channel.", "");
  render_finding(g2, "THIN7 7ch", "80%", "Unfat axiom. Small channels (2-17) easy to search.", "");
  render_finding(g2, "DEEP 5ch", "77%", "5 fat channels. Good balance of ch count and searchability.", "");
  render_finding(g2, "RAND7 7ch", "76%", "Random coprimes. Matches axiom. Structure doesn't help ch_score.", "");
  render_finding(g2, "TRANS 7ch", "74%", "Axiom ring. Middle of pack on ch_score.", "");
  render_finding(g2, "TRUE 6ch", "68%", "6ch axiom. Below DEEP despite fewer channels.", "");
  render_finding(g2, "FAT 7ch", "67%", "Over-fattened. Large channels (16,27) hard to search.", "");
  render_finding(g2, "BALANCED 7ch", "66%", "WORST 7ch. All channels large (11-31). Hardest search.", "");
  dom_append(dom_body(), sec2);

  -- Exact match
  let sec3 = make_section("800px") in
  render_h2(sec3, "Results: Exact Match");
  render_p(sec3, "All channels correct simultaneously. Harder than ch_score -- requires coherence across channels. Out of 160 training examples.");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "DATA", "112/160 (70%)", "BEST exact. Fewer channels = easier to get all right.", "");
  render_finding(g3, "TRANS", "98/160 (61%)", "Axiom ring. SECOND best. Pareto fattening helps coherence.", "");
  render_finding(g3, "DEEP", "93/160 (58%)", "5ch fat. Good exact match.", "");
  render_finding(g3, "BALANCED", "91/160 (57%)", "Despite worst ch_score, decent exact. Uniform sizes help coherence.", "");
  render_finding(g3, "RAND7", "77/160 (48%)", "Axiom beats random by +27% on exact match.", "");
  render_finding(g3, "THIN7", "73/160 (46%)", "Unfat axiom. Good ch_score but worse exact than fat version.", "");
  render_finding(g3, "FAT", "58/160 (36%)", "Over-fattened. WORST among 7ch rings. Too-large channels hurt.", "");
  render_finding(g3, "TRUE", "46/160 (29%)", "WORST overall. 6ch stochastic anomaly (attn=70, highest).", "");
  dom_append(dom_body(), sec3);

  -- Key comparisons
  let sec4 = make_section("800px") in
  render_h2(sec4, "Key Comparisons");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Axiom vs Random", "ch: 74% vs 76%. Exact: 98 vs 77.", "Chain constraints give NO ch_score advantage. But +27% exact match from coherence.", "");
  render_finding(g4, "Fat vs Thin", "ch: 74% vs 80%. Exact: 98 vs 73.", "Fattening HURTS ch_score (larger search). HELPS exact (better reconstruction).", "");
  render_finding(g4, "Pareto vs Balanced", "ch: 74% vs 66%. Exact: 98 vs 91.", "Pareto distribution IS better. Varied channel sizes give both ch and exact advantage.", "");
  render_finding(g4, "Pareto vs Over-fat", "ch: 74% vs 67%. Exact: 98 vs 58.", "Over-fattening HURTS. Pareto {3,2,2,2,1,1,1} is validated over {4,3,2,2,1,1,1}.", "");
  render_finding(g4, "Tower ladder", "ch: 90/77/68/74 (4/5/6/7ch)", "Fewer channels = higher ch%. More channels = harder coordination.", "");
  dom_append(dom_body(), sec4);

  -- Conclusions
  let sec5 = make_section("800px") in
  render_h2(sec5, "Conclusions");
  render_p(sec5, "CRT as computation substrate works for ALL rings. The technique is universal. The axiom ring's specific contribution is the Pareto fattening: it helps exact reconstruction (+27% over random) despite slightly harder per-channel search (-2% ch_score). Chain constraints provide no measurable ch_score advantage.");
  render_p(sec5, "Fewer channels is better for per-channel learning (DATA 90% vs TRANS 74%). Over-fattening hurts (FAT 67% vs TRANS 74%). The Pareto exponents {3,2,2,2,1,1,1} beat both uniform (BALANCED 66%) and over-fat (FAT 67%). The axiom ring's channel distribution is the right one for this task.");
  render_p(sec5, "Open question: is there a ring that beats the axiom on BOTH ch_score AND exact match? DATA (4ch) wins ch_score but has fewer channels. A 4-channel fat ring [8,9,25,49] might combine DATA's ch_score with TRANS's exact coherence. Phase G2 continues.");
  dom_append(dom_body(), sec5);

  0
)
