  let sec = make_section("800px") in
  render_h2(sec, "Theorem Pointers");
  render_p(sec, "The spinning-spheres canvas is backed by two Phase OMEGA theorems and the Gabriel-Horn anchor in GEOMETRY.md section IX. STRUCTURAL analogs of Clay-Millennium statements, NOT Clay proofs = but the ring as capped horn is proved mathematics on the 108-ring heartbeat lattice.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Anchor");
  render_th(hdr, "Claim");
  render_th(hdr, "Where");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Thm 33 (YM gap, Ω.MP.3+T.1)", "Gap = 4*sin^2(pi/49) identical across all 108 rings", "/proof Theorem 33 (S1436)");
  render_table_row(tbl, "Thm 34 (NS horn, Ω.MP.4+GH.2)", "Discrete NS on Z/N has global existence; ring IS the horn compactification", "/proof Theorem 34 (S1437)");
  render_table_row(tbl, "GEOMETRY section IX", "CRT torus is the Gabriel-Horn cap of Z^k", "GEOMETRY.md (Phase OMEGA geometric anchor)");
  render_table_row(tbl, "AXIOM_FORM YM block", "b^2 forced; q_max = 49 unconditionally on the 108-lattice", "AXIOM_FORM.md YANG-MILLS GAP LATTICE UNIVERSALITY THEOREM");
  render_table_row(tbl, "AXIOM_FORM NS block", "CRT orthogonality forbids coupled blowup; ring = horn cap", "AXIOM_FORM.md NAVIER-STOKES HORN ANALOG THEOREM");
  dom_append(dom_body(), sec)
)

