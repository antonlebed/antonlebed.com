  dom_head_meta("description", "Spinning Spheres: T^7 CRT torus as a Gabriel-Horn cap of the ambient integer lattice. Seven bounded orbit shells = horn's finite-volume side. STRUCTURAL Yang-Mills mass-gap analog (gap 4*sin^2(pi/49) is a 0-form on 108 lambda=420 rings) + STRUCTURAL Navier-Stokes horn analog (CRT decomposes the Laplacian into 7 orthogonal per-channel Laplacians, forbidding coupled blowup). Hardware-validated on ESP32 and FPGA: 24h drift test, ECC detection 100%, round-trip recovery 100%, K^2=9 pipeline at 267 MHz.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Spinning Spheres\",\"description\":\"T^7 CRT torus = Gabriel-Horn cap of Z^k. STRUCTURAL Yang-Mills and Navier-Stokes analogs on the 108-ring heartbeat lattice. Hardware-validated ECC.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/structure/sphere\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"T^7 torus\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gabriel-Horn compactification\"},{\"@type\":\"DefinedTerm\",\"name\":\"Yang-Mills structural analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"Navier-Stokes horn analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT dynamics\"},{\"@type\":\"DefinedTerm\",\"name\":\"angular momentum\"}]}");
  sph_hero();
  sph_canvas_section();
  sph_horn_cap();
  sph_orbits();
  sph_angmom();
  sph_detect();
  sph_recover();
  sph_boundary();
