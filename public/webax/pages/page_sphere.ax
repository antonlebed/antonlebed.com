/* ================================================================
   PAGE: SPINNING SPHERES -- 7 concentric circles rotating at CRT rates.
   Phase S step S6. A ring spinning fast = sphere. 7 nested = machine.
   Each channel's marker dot orbits at angular velocity 2*pi/q_i.
   At step = lambda = 1680, all markers realign. The heartbeat.
   ================================================================ */

/* ===== INTEGER TRIG (fixed-point *1000, 64ths of full circle) ===== */
fn _sph_sq(k) = if k == 0 then 0 else if k == 1 then 98 else if k == 2 then 195 else if k == 3 then 290 else if k == 4 then 383 else if k == 5 then 471 else if k == 6 then 556 else if k == 7 then 634 else if k == 8 then 707 else if k == 9 then 773 else if k == 10 then 831 else if k == 11 then 882 else if k == 12 then 924 else if k == 13 then 957 else if k == 14 then 981 else 996

fn sph_sin64(a) = (
  let a2 = ((a % 64) + 64) % 64 in
  if a2 < 16 then _sph_sq(a2)
  else if a2 < 32 then _sph_sq(32 - a2)
  else if a2 < 48 then 0 - _sph_sq(a2 - 32)
  else 0 - _sph_sq(64 - a2)
)
fn sph_cos64(a) = sph_sin64(a + 16)

/* ===== GLOBAL STATE ===== */
let sph_ctx = [0]
let sph_step = [0]
let sph_playing = [0]
let sph_speed = [4]
let sph_frame = [0]

/* 7 channel moduli in DATA-first order: D, K, E, b, L, GATE, ESCAPE */
let sph_q = [8, 9, 25, 49, 11, 13, 17]
/* Radii: inner DATA shells, outer ALIVE shells */
let sph_r = [30, 50, 70, 90, 110, 130, 150]
/* Colors: warm for DATA (D,K,E,b), cool for ALIVE (L,GATE,ESCAPE) */

fn sph_color(i) = (
  if i == 0 then "#ff4444"
  else if i == 1 then "#ff8800"
  else if i == 2 then "#ffcc00"
  else if i == 3 then "#ff6688"
  else if i == 4 then "#44ff88"
  else if i == 5 then "#44aaff"
  else "#aa88ff"
)

fn sph_ring_color(i) = (
  if i == 0 then "#441111"
  else if i == 1 then "#442200"
  else if i == 2 then "#443300"
  else if i == 3 then "#441122"
  else if i == 4 then "#114422"
  else if i == 5 then "#112244"
  else "#221144"
)

fn sph_label(i) = (
  if i == 0 then "D"
  else if i == 1 then "K"
  else if i == 2 then "E"
  else if i == 3 then "b"
  else if i == 4 then "L"
  else if i == 5 then "G"
  else "17"
)

/* ===== DRAW ONE FRAME ===== */
fn sph_draw() = (
  let ctx = sph_ctx[0] in
  let t = sph_step[0] in
  let cx = 175 in let cy = 185 in
  /* Clear */
  cvs_fillstyle(ctx, "#0a0a18");
  cvs_fillrect(ctx, 0, 0, 350, 370);
  /* Draw concentric orbit rings */
  mut i = 0;
  while i < 7 do (
    let r = sph_r[i] in
    cvs_strokestyle(ctx, sph_ring_color(i));
    cvs_linewidth(ctx, 1);
    cvs_beginpath(ctx);
    cvs_arc(ctx, cx, cy, r, 0, 36000);
    cvs_stroke(ctx);
    mut i = i + 1
  );
  /* Draw void at center */
  cvs_fillstyle(ctx, "#222244");
  cvs_beginpath(ctx);
  cvs_arc(ctx, cx, cy, 8, 0, 36000);
  cvs_fill(ctx);
  cvs_fillstyle(ctx, "#ffd700");
  cvs_font(ctx, "8px monospace");
  cvs_filltext(ctx, "0", cx - 3, cy + 3);
  /* Draw marker dots on each orbit */
  mut j = 0;
  while j < 7 do (
    let q = sph_q[j] in
    let r = sph_r[j] in
    /* Angle in 64ths: (t mod q) * 64 / q. Negative direction = clockwise. */
    let residue = t % q in
    let angle64 = (residue * 64) / q in
    let mx = cx + r * sph_cos64(angle64) / 1000 in
    let my = cy - r * sph_sin64(angle64) / 1000 in
    /* Marker dot */
    cvs_fillstyle(ctx, sph_color(j));
    cvs_beginpath(ctx);
    cvs_arc(ctx, mx, my, 6, 0, 36000);
    cvs_fill(ctx);
    /* Label */
    cvs_fillstyle(ctx, "#ffffff");
    cvs_font(ctx, "9px monospace");
    cvs_filltext(ctx, sph_label(j), mx - 4, my + 3);
    mut j = j + 1
  );
  /* Alignment line from void to 12-o'clock when all aligned */
  let phase = t % 1680 in
  if phase == 0 then (
    cvs_strokestyle(ctx, "#ffd700");
    cvs_linewidth(ctx, 2);
    cvs_beginpath(ctx);
    cvs_moveto(ctx, cx, cy - 8);
    cvs_lineto(ctx, cx, cy - 150);
    cvs_stroke(ctx)
  ) else 0;
  /* HUD: step counter + lambda progress */
  cvs_fillstyle(ctx, "#b0b0c0");
  cvs_font(ctx, "11px monospace");
  cvs_filltext(ctx, "step ${t}", 8, 14);
  let pct = (phase * 100) / 1680 in
  cvs_filltext(ctx, "heartbeat: ${pct}%", 200, 14);
  /* Progress bar */
  cvs_fillstyle(ctx, "#1a1a2e");
  cvs_fillrect(ctx, 8, 354, 334, 8);
  let barW = (phase * 334) / 1680 in
  let barClr = if phase < 840 then "#44ff88" else "#ffd700" in
  cvs_fillstyle(ctx, barClr);
  cvs_fillrect(ctx, 8, 354, barW, 8)
)

/* ===== ANIMATION TICK ===== */
/* sph_speed: 1=x0.25, 2=x0.5, 4=x1, 8=x2, 16=x4, 32=x8, 64=x16, 128=x32.
   Base rate: 1 step per 32 frames (~2 steps/sec at 60fps).
   speed>=32: advance speed/32 steps per frame.
   speed<32: advance 1 step every 32/speed frames. */
fn sph_tick() = (
  if sph_playing[0] == 1 then (
    let spd = sph_speed[0] in
    let f = sph_frame[0] + 1 in
    set(sph_frame, 0, f);
    if spd >= 32 then (
      set(sph_step, 0, sph_step[0] + spd / 32);
      sph_draw()
    ) else (
      let div = 32 / spd in
      if f % div == 0 then (
        set(sph_step, 0, sph_step[0] + 1);
        sph_draw()
      ) else 0
    )
  ) else 0
)

/* ===== CONTROLS ===== */
fn sph_play() = (
  set(sph_playing, 0, 1)
)

fn sph_pause() = (
  set(sph_playing, 0, 0)
)

fn sph_step_fwd() = (
  set(sph_step, 0, sph_step[0] + 1);
  sph_draw()
)

fn sph_reset() = (
  set(sph_step, 0, 0);
  sph_draw()
)

fn sph_jump_lambda() = (
  let t = sph_step[0] in
  let phase = t % 1680 in
  let next = t + (1680 - phase) in
  set(sph_step, 0, next);
  sph_draw()
)

fn sph_speed_label(s) = (
  if s == 1 then "x0.25"
  else if s == 2 then "x0.5"
  else if s == 4 then "x1"
  else if s == 8 then "x2"
  else if s == 16 then "x4"
  else if s == 32 then "x8"
  else if s == 64 then "x16"
  else "x32"
)

fn sph_speed_up() = (
  let s = sph_speed[0] in
  if s < 128 then set(sph_speed, 0, s * 2) else 0;
  let el = dom_query("#sph-speed-lbl") in
  dom_inner(el, sph_speed_label(sph_speed[0]))
)

fn sph_speed_down() = (
  let s = sph_speed[0] in
  if s > 1 then set(sph_speed, 0, s / 2) else 0;
  let el = dom_query("#sph-speed-lbl") in
  dom_inner(el, sph_speed_label(sph_speed[0]))
)

/* ===== HERO ===== */
fn sph_hero() = (
  let hero = make_hero("Spinning Spheres") in
  render_p(hero, "A ring spinning fast enough looks like a sphere. An address orbiting fast enough fills its channel. Stack 7 such spheres concentrically: inner DATA layers spin fast, outer ALIVE layers wrap as parity. The void at the center pilots everything.");
  render_p(hero, "Below: 7 concentric orbits, one per CRT channel. Each dot's angular velocity is 2*pi/q where q is the channel modulus. At step 1680 (lambda), ALL dots realign. That is the heartbeat.");
  dom_append(dom_body(), hero)
)

/* ===== CANVAS + CONTROLS SECTION ===== */
fn sph_canvas_section() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Machine");
  /* Canvas */
  let cvs = dom_create("canvas") in
  dom_attr(cvs, "id", "sph-canvas");
  cvs_setsize(cvs, 350, 370);
  dom_style(cvs, "display", "block");
  dom_style(cvs, "background", "#0a0a18");
  dom_style(cvs, "maxWidth", "100%");
  dom_style(cvs, "border", "1px solid #333");
  dom_style(cvs, "borderRadius", "8px");
  dom_style(cvs, "margin", "0 auto 12px");
  dom_append(sec, cvs);
  let ctx = cvs_getctx(cvs) in
  set(sph_ctx, 0, ctx);
  /* Control buttons — string literals for test scanner */
  let ctrls = dom_create("div") in
  dom_style(ctrls, "display", "flex");
  dom_style(ctrls, "gap", "6px");
  dom_style(ctrls, "flexWrap", "wrap");
  dom_style(ctrls, "justifyContent", "center");
  dom_style(ctrls, "marginBottom", "12px");
  let bs = "6px 12px" in let br = "4px" in let fs = "12px" in
  let b1 = dom_create("button") in dom_text(b1, "Play"); dom_style(b1, "padding", bs); dom_style(b1, "cursor", "pointer"); dom_style(b1, "background", "#228833"); dom_style(b1, "color", "#fff"); dom_style(b1, "border", "none"); dom_style(b1, "borderRadius", br); dom_style(b1, "fontSize", fs); dom_on(b1, "click", "sph_play"); dom_append(ctrls, b1);
  let b2 = dom_create("button") in dom_text(b2, "Pause"); dom_style(b2, "padding", bs); dom_style(b2, "cursor", "pointer"); dom_style(b2, "background", "#884422"); dom_style(b2, "color", "#fff"); dom_style(b2, "border", "none"); dom_style(b2, "borderRadius", br); dom_style(b2, "fontSize", fs); dom_on(b2, "click", "sph_pause"); dom_append(ctrls, b2);
  let b3 = dom_create("button") in dom_text(b3, "Step"); dom_style(b3, "padding", bs); dom_style(b3, "cursor", "pointer"); dom_style(b3, "background", "#336688"); dom_style(b3, "color", "#fff"); dom_style(b3, "border", "none"); dom_style(b3, "borderRadius", br); dom_style(b3, "fontSize", fs); dom_on(b3, "click", "sph_step_fwd"); dom_append(ctrls, b3);
  let b4 = dom_create("button") in dom_text(b4, "Reset"); dom_style(b4, "padding", bs); dom_style(b4, "cursor", "pointer"); dom_style(b4, "background", "#663344"); dom_style(b4, "color", "#fff"); dom_style(b4, "border", "none"); dom_style(b4, "borderRadius", br); dom_style(b4, "fontSize", fs); dom_on(b4, "click", "sph_reset"); dom_append(ctrls, b4);
  let b5 = dom_create("button") in dom_text(b5, "Jump to lambda"); dom_style(b5, "padding", bs); dom_style(b5, "cursor", "pointer"); dom_style(b5, "background", "#886622"); dom_style(b5, "color", "#fff"); dom_style(b5, "border", "none"); dom_style(b5, "borderRadius", br); dom_style(b5, "fontSize", fs); dom_on(b5, "click", "sph_jump_lambda"); dom_append(ctrls, b5);
  let b6 = dom_create("button") in dom_text(b6, "Slower"); dom_style(b6, "padding", bs); dom_style(b6, "cursor", "pointer"); dom_style(b6, "background", "#444466"); dom_style(b6, "color", "#fff"); dom_style(b6, "border", "none"); dom_style(b6, "borderRadius", br); dom_style(b6, "fontSize", fs); dom_on(b6, "click", "sph_speed_down"); dom_append(ctrls, b6);
  let spd_lbl = dom_create("span") in dom_attr(spd_lbl, "id", "sph-speed-lbl"); dom_text(spd_lbl, "x1"); dom_style(spd_lbl, "color", "#ffd700"); dom_style(spd_lbl, "fontSize", fs); dom_style(spd_lbl, "padding", "6px 4px"); dom_append(ctrls, spd_lbl);
  let b7 = dom_create("button") in dom_text(b7, "Faster"); dom_style(b7, "padding", bs); dom_style(b7, "cursor", "pointer"); dom_style(b7, "background", "#444466"); dom_style(b7, "color", "#fff"); dom_style(b7, "border", "none"); dom_style(b7, "borderRadius", br); dom_style(b7, "fontSize", fs); dom_on(b7, "click", "sph_speed_up"); dom_append(ctrls, b7);
  dom_append(sec, ctrls);
  dom_append(dom_body(), sec);
  /* Initial draw + start animation loop */
  sph_draw();
  raf("sph_tick")
)

/* ===== CHANNEL LEGEND ===== */
fn sph_legend() = (
  let sec = make_section("800px") in
  render_h2(sec, "Channel Rates");
  render_p(sec, "Each channel completes a full orbit in q steps. Smaller modulus = faster orbit. In one heartbeat (1680 steps):");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus");
  render_th(hdr, "Orbits/heartbeat");
  render_th(hdr, "Role");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D (bridge)", "8", "210", "Fastest. Coarsest resolution.");
  render_table_row_4(tbl, "K (closure)", "9", "186", "K^2=9 stop signal.");
  render_table_row_4(tbl, "E (observer)", "25", "67", "Self-blind (E^2=0 mod 25).");
  render_table_row_4(tbl, "b (depth)", "49", "34", "Slowest DATA. Finest resolution.");
  render_table_row_4(tbl, "L (protector)", "11", "152", "ECC parity field.");
  render_table_row_4(tbl, "GATE (skin)", "13", "129", "ECC parity field.");
  render_table_row_4(tbl, "ESCAPE (17)", "17", "98", "Transcendence. ECC parity field.");
  render_p(sec, "DATA channels {D, K, E, b} carry information (warm colors, inner orbits). ALIVE channels {L, GATE, ESCAPE} carry parity (cool colors, outer orbits). The fat DATA channels have more positions but complete fewer orbits. The thin ALIVE channels are fields -- arithmetic is exact.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Heartbeat = 7", "1680 / 240 = b", "Fat channels buy exactly one factor of depth in heartbeat period. The ratio of TRANS to THIN lambda is the depth prime.", "S1331");
  render_finding(g, "Angular momentum = b", "7 = depth prime", "Between sigma and D, the sum of phase differences across all 7 channels is always 7. Angular momentum IS CRT distance -- a static invariant measured dynamically. See section below.", "S1334");
  dom_append(dom_body(), sec)
)

/* ===== OPERATIONAL BOUNDARY SECTION (S1343) ===== */
fn sph_boundary() = (
  let sec = make_section("800px") in
  render_h2(sec, "Operational Boundary");
  render_p(sec, "ECC3 triple parity (L + GATE + ESCAPE, rate 4/7) gives 100% single-channel correction. But what happens when two channels are corrupted simultaneously? This defines the operational boundary: how many errors can the system tolerate before it must retransmit?");
  render_p(sec, "Exhaustive computation: all 88,200 data values, all 21 channel pairs, all possible error combinations. 535 million 2-channel error patterns tested. Zero undetected.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Error type");
  render_th(hdr, "Count");
  render_th(hdr, "Detection");
  render_th(hdr, "Correction");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1 channel", "any", "100%", "100% (auto-heal)");
  render_table_row_4(tbl, "2 channels (DATA+DATA)", "187M patterns", "100%", "retransmit");
  render_table_row_4(tbl, "2 channels (DATA+PAR)", "265M patterns", "100%", "retransmit");
  render_table_row_4(tbl, "2 channels (PAR+PAR)", "42M patterns", "100%", "retransmit");
  render_p(sec, "The key guarantee: 2431 = 11 * 13 * 17 (parity product) exceeds 49^2 = 2401 (max data channel squared). This margin of 30 means no pair of data-channel errors can produce a syndrome-invisible delta. Every 2-channel error flips at least one parity check.");
  render_p(sec, "Protocol: detect() on every received packet. Clean -> accept. Error -> retransmit via -1 round-trip. The mesh already implements this (S5b). One error auto-heals. Two errors trigger retransmit. The algebra decides.");
  let g = make_findings_grid(sec) in
  render_finding(g, "535M exhaustive = 0 silent", "test_multi_ecc.c + .ax 45/45", "Every possible 2-channel error pattern across all 21 channel pairs and all 88,200 data values: 100% detected. Zero silent corruption. The parity product 2431 > max_channel^2 = 2401 is the algebraic guard.", "S1343");
  render_finding(g, "1 error = heal, 2 = retransmit", "Operational boundary", "This is the standard Hamming-distance-3 trade-off: correct 1 or detect 2, not both simultaneously. The ESP32 mesh uses detect-only mode with -1 round-trip recovery, which is safe for any number of detected errors.", "S1343");
  dom_append(dom_body(), sec)
)

/* ===== PHYSICS SECTION ===== */
fn sph_physics() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why Spheres");
  render_p(sec, "A point orbiting a circle at constant speed traces the circle. But viewed from outside -- averaged over time -- it fills a disc. At higher dimensions, a point orbiting a torus fills the torus surface. The spinning ring IS the sphere, experienced over time.");
  render_p(sec, "The FPGA implementation makes this literal: a counter cycles 0 to 214,414,199 at 267 MHz. Full orbit in 0.8 seconds. Each clock tick, the CRT decomposition gives 7 independent channel coordinates -- the point's position on T^7. The spinning counter IS the ring made physical.");
  render_p(sec, "The ESP32 mesh implements the same dynamics across 3 distributed boards. Each board is one element in the ring. Communication via ESP-NOW at 3-second heartbeat. Round-trip cancellation (the -1 theorem) recovers timing offsets at O(1) per channel.");
  let g = make_findings_grid(sec) in
  render_finding(g, "FPGA: 267 MHz orbit", "crt_k9_pipeline.v", "9-stage pipeline, 7 channels decomposed in parallel. 6555 LUT4 (31% of Tang Nano 20K). The counter IS the spinning address.", "S1265");
  render_finding(g, "ESP32: 3-board mesh", "crt_mesh.c", "K=3 boards, algebraic addressing, L=11 ECC per packet. CAL_PROBE/CAL_ECHO auto-calibrate via round-trip.", "S1329");
  render_finding(g, "Void pilots", "0 mod q = 0 for all q", "Element 0 (void) has residue 0 in every channel. It sees every layer simultaneously. Void is the natural hub of the spinning structure.", "S1331");
  dom_append(dom_body(), sec)
)

/* ===== ANGULAR MOMENTUM SECTION (S1334) ===== */
fn sph_angmom() = (
  let sec = make_section("800px") in
  render_h2(sec, "Angular Momentum");
  render_p(sec, "When two elements spin at the same stride, the sum of their phase differences across all 7 channels is constant. It never changes -- the step cancels out. This constant IS the CRT distance between the two elements.");
  render_p(sec, "For sigma(1) and D(2), the angular momentum is 7 -- the depth prime b. They differ by 1 in every channel, and 1+1+1+1+1+1+1 = 7. This was measured on ESP32 hardware: every SPIN packet between the sigma board and D board shows ang_mom = 7. Consistent across all observations.");
  /* Distance examples */
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair");
  render_th(hdr, "CRT Distance");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row(tbl, "sigma(1), D(2)", "7", "Differ by 1 on all 7 channels.");
  render_table_row(tbl, "sigma(1), K(3)", "14", "Differ by 2 on all channels.");
  render_table_row(tbl, "D(2), K(3)", "7", "Differ by 1 on all channels.");
  render_table_row(tbl, "void(0), K(3)", "21", "Void is 3 steps from K.");
  render_table_row(tbl, "Maximum possible", "63", "All channels antipodal.");
  render_p(sec, "The angular momentum depends on which two elements you compare, not on how long the ring has been spinning. It is a static invariant disguised as a dynamic measurement. The rotation contributes nothing -- the structure was already there.");
  /* Findings */
  let g = make_findings_grid(sec) in
  render_finding(g, "ang_mom = 7 = b", "Measured on ESP32", "Between sigma and D boards, the sum of phase differences is always 7 = depth prime. CRT distance IS angular momentum. Proved: dist(a+s, b+s) = dist(a, b) because step s cancels.", "S1334");
  render_finding(g, "Clock drift detector", "Quantized by CRT", "If clocks drift by delta, ang_mom shifts: drift 0 gives 7, drift 1 gives 0, drift 5 gives 28. Any deviation from the expected constant = drift detected. No GPS needed.", "S1334");
  render_finding(g, "Different strides", "Pseudo-random mixing", "When elements step at different rates, angular momentum becomes step-dependent and averages to about 33 over a lambda cycle. The rotation IS the mixing.", "S1334");
  dom_append(dom_body(), sec)
)

/* ===== HARDWARE VALIDATION SECTION (S1337-S1339) ===== */
fn sph_hardware() = (
  let sec = make_section("800px") in
  render_h2(sec, "Hardware Validation");
  render_p(sec, "Three ESP32 boards form a CRT mesh: void(0), sigma(1), D(2). Communication via ESP-NOW broadcast at 3-second heartbeat. Each board sends its SPIN phase vector. The receiver computes angular momentum, checks ECC, and verifies the -1 round-trip theorem.");
  render_p(sec, "The validation builds in stages. Each stage proves a stronger property of the spinning structure:");
  /* Results table */
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Stage");
  render_th(hdr, "Result");
  render_th(hdr, "What it proves");
  dom_append(tbl, hdr);
  render_table_row(tbl, "S4: Void-as-hub", "162+ RX, 0 ECC fail", "Void receives from all peers. Natural hub.");
  render_table_row(tbl, "S5: Error detection", "100% detect rate", "L=11 parity catches every injected error.");
  render_table_row(tbl, "S5b: Error recovery", "100% recovery (4/4)", "-1 mirror round-trip recovers original value.");
  render_table_row(tbl, "S7: 30-min stability", "540/540 ang_mom=47", "Zero drift over 1801 seconds. 0 natural ECC failures.");
  render_table_row(tbl, "S9: Time-domain injection", "72/72 = 100% detect", "Phase-independent: b-channel and L-channel injection detected at all rotation phases.");
  render_p(sec, "S5b is the key result. D board injects L-channel error (+1 mod 11) on every 5th packet. Void detects ECC failure, mirrors the corrupted integer (N - corrupted), and sends it back. D applies the same error on the return path, then mirrors again. The algebra: x + eL becomes (N - x - eL) + eL = N - x becomes x. Two errors, two mirrors, perfect cancellation.");
  render_p(sec, "S7 confirms long-term stability. Over 30 minutes of continuous operation, the angular momentum between void and sigma stayed at exactly 47 for all 540 observations. Zero clock drift at 3-second resolution. 840 clean packets, zero natural ECC failures.");
  render_h3(sec, "S8: Stride Experiments");
  render_p(sec, "When two boards spin at different strides, angular momentum becomes time-varying. The theory predicts the average should equal sum(q_i/4) = 33 (uniform phase mixing). Three stride ratios tested on hardware, 90 packets each:");
  let t2 = make_table(sec) in
  let h2 = dom_create("tr") in
  render_th(h2, "Stride");
  render_th(h2, "avg ang_mom");
  render_th(h2, "delta from 33");
  render_th(h2, "range");
  dom_append(t2, h2);
  render_table_row_4(t2, "1:2", "33.00", "0.00", "14-47");
  render_table_row_4(t2, "1:7 (depth)", "33.22", "+0.22", "16-53");
  render_table_row_4(t2, "1:17", "35.08", "+2.08 (D lock)", "14-53");
  render_p(sec, "Stride 1:2 matches the prediction exactly. Stride 1:7 is near-exact. Stride 1:17 shows a +2.08 bias. Analysis (S1342) reveals the mechanism: the stride DIFFERENCE 16 = 0 mod 8 freezes the D channel, not ESCAPE. The D-channel angular momentum becomes constant at circ_dist((2+delta)%8, 0, 8) where delta is the boot offset. With delta=2, D contributes 4 instead of the average 2, explaining the +2 bias exactly. General rule: gcd(stride_diff, q_i) = q_i freezes channel i.");
  /* Findings */
  let g = make_findings_grid(sec) in
  render_finding(g, "Detect + Recover + Clock", "One ring, one protocol", "L=11 detects corruption. The -1 mirror recovers the original. Angular momentum measures clock drift. All three from the same algebraic structure. All CC0.", "S1339");
  render_finding(g, "corrupted = 116953202", "mirror = 97460998", "Element 2 with L+1 error reconstructs to 2 + e_L = 116953202. Void mirrors to N - 116953202 = 97460998. Return-path L+1 plus final mirror yields 2. Exact.", "S1339");
  render_finding(g, "D-channel lock +2.08", "stride_diff mod 8 = 0", "Stride 1:17 has stride difference 16. Since 16 mod 8 = 0, the D-channel angular momentum freezes. Boot offset delta=2 gives D-contribution = 4 (max). Analytic prediction: 34.89. Hardware: 35.08. Corrects S1340 ESCAPE attribution: ESCAPE phase IS frozen on sender, but ang_mom contribution still varies.", "S1342");
  render_finding(g, "Phase-independent ECC", "72/72 across all phases", "Time-domain injection: corrupt b-channel (54 packets) and L-channel (18 packets) across lambda progress 5-109. 100% detection at every phase, including all 7 channel wrap points. Triple parity makes any single-channel error always detectable.", "S1342");
  render_finding(g, "Ring = isolation hierarchy", "stride N/q isolates channel", "Isolation stride for channel i = N/q_i. To observe only ESCAPE: spin at TRUE = N/17. To observe only D: spin at OMEGA = N/8. Each sub-ring isolates the channel it excludes. The ring hierarchy IS the channel isolation hierarchy.", "S1342");
  dom_append(dom_body(), sec)
)

/* ===== MAIN PAGE ===== */
fn page_sphere() = (
  dom_head_meta("description", "Spinning Spheres: 7 concentric orbits visualizing CRT channel dynamics. Each channel spins at its own rate. At lambda=1680, all realign. Interactive animation with play/pause/step controls. Angular momentum = 7 = b (depth prime). Hardware-validated: detection, recovery, clock drift.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Spinning Spheres\",\"description\":\"7 concentric CRT channel orbits. Lambda=1680 heartbeat. Angular momentum equals CRT distance. Hardware-validated on 3 ESP32 boards: ECC detection 100%, round-trip recovery 100%, clock drift measurement.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/structure/sphere\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"spinning spheres\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT dynamics\"},{\"@type\":\"DefinedTerm\",\"name\":\"angular momentum\"},{\"@type\":\"DefinedTerm\",\"name\":\"hardware validation\"},{\"@type\":\"DefinedTerm\",\"name\":\"error recovery\"}]}");
  sph_hero();
  sph_canvas_section();
  sph_legend();
  sph_angmom();
  sph_hardware();
  sph_boundary();
  sph_physics()
)
