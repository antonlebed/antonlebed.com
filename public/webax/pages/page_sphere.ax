/* ================================================================
   PAGE: SPINNING SPHERES — seven orbits through the tower lens.
   A ring spinning fast = sphere. 7 nested = the Septilix machine.
   Each channel's marker dot orbits at angular velocity 2*pi/q_i.
   Full return: lcm(8,9,25,49,11,13,17) = TRANS = 214,414,200.
   Lambda = 1680 is the multiplicative exponent, not the additive
   return. Only D (mod 8) returns to 0 at step 1680.
   Tower-organized: hero, machine (canvas), seven orbits (tower
   inventory), angular momentum (cross-tower), detection (Tower_L),
   recovery (Tower_D), boundary (Tower_GATE), heartbeat (Tower_C),
   isolation (Tower_ESCAPE), silicon (Tower_K).
   ================================================================ */

/* ===== INTEGER TRIG (fixed-point *1000, 64ths of full circle) ===== */
fn _sph_sq(k) = if k == 0 then 0 else if k == 1 then 98 else if k == 2 then 195 else if k == 3 then 290 else if k == 4 then 383 else if k == 5 then 471 else if k == 6 then 556 else if k == 7 then 634 else if k == 8 then 707 else if k == 9 then 773 else if k == 10 then 831 else if k == 11 then 882 else if k == 12 then 924 else if k == 13 then 957 else if k == 14 then 981 else 996

fn sph_sin64(a) = (
  let a2 = ((a % 64) + 64) % 64 in
  if a2 < 16 then _sph_sq(a2)
  else if a2 < 32 then _sph_sq(32 - a2)
  else if a2 < 48 then 0 - _sph_sq(a2 - 32)
  else 0 - _sph_sq(64 - a2)
)
fn sph_cos64(a) = sph_sin64(a + 16)

/* ===== GLOBAL STATE ===== */
let sph_ctx = [0]
let sph_step = [0]
let sph_playing = [0]
let sph_speed = [4]
let sph_frame = [0]

/* 7 channel moduli in DATA-first order: D, K, E, b, L, GATE, ESCAPE */
let sph_q = [8, 9, 25, 49, 11, 13, 17]
/* Radii: inner DATA shells, outer ALIVE shells */
let sph_r = [30, 50, 70, 90, 110, 130, 150]
/* Colors: warm for DATA (D,K,E,b), cool for ALIVE (L,GATE,ESCAPE) */

fn sph_color(i) = (
  if i == 0 then "#ff4444"
  else if i == 1 then "#ff8800"
  else if i == 2 then "#ffcc00"
  else if i == 3 then "#ff6688"
  else if i == 4 then "#44ff88"
  else if i == 5 then "#44aaff"
  else "#aa88ff"
)

fn sph_ring_color(i) = (
  if i == 0 then "#441111"
  else if i == 1 then "#442200"
  else if i == 2 then "#443300"
  else if i == 3 then "#441122"
  else if i == 4 then "#114422"
  else if i == 5 then "#112244"
  else "#221144"
)

fn sph_label(i) = (
  if i == 0 then "D"
  else if i == 1 then "K"
  else if i == 2 then "E"
  else if i == 3 then "b"
  else if i == 4 then "L"
  else if i == 5 then "G"
  else "17"
)

/* ===== DRAW ONE FRAME ===== */
fn sph_draw() = (
  let ctx = sph_ctx[0] in
  let t = sph_step[0] in
  let cx = 175 in let cy = 185 in
  /* Clear */
  cvs_fillstyle(ctx, "#0a0a18");
  cvs_fillrect(ctx, 0, 0, 350, 370);
  /* Draw concentric orbit rings */
  mut i = 0;
  while i < 7 do (
    let r = sph_r[i] in
    cvs_strokestyle(ctx, sph_ring_color(i));
    cvs_linewidth(ctx, 1);
    cvs_beginpath(ctx);
    cvs_arc(ctx, cx, cy, r, 0, 36000);
    cvs_stroke(ctx);
    mut i = i + 1
  );
  /* Draw void at center */
  cvs_fillstyle(ctx, "#222244");
  cvs_beginpath(ctx);
  cvs_arc(ctx, cx, cy, 8, 0, 36000);
  cvs_fill(ctx);
  cvs_fillstyle(ctx, "#ffd700");
  cvs_font(ctx, "8px monospace");
  cvs_filltext(ctx, "0", cx - 3, cy + 3);
  /* Draw marker dots on each orbit */
  mut j = 0;
  while j < 7 do (
    let q = sph_q[j] in
    let r = sph_r[j] in
    /* Angle in 64ths: (t mod q) * 64 / q. Negative direction = clockwise. */
    let residue = t % q in
    let angle64 = (residue * 64) / q in
    let mx = cx + r * sph_cos64(angle64) / 1000 in
    let my = cy - r * sph_sin64(angle64) / 1000 in
    /* Marker dot */
    cvs_fillstyle(ctx, sph_color(j));
    cvs_beginpath(ctx);
    cvs_arc(ctx, mx, my, 6, 0, 36000);
    cvs_fill(ctx);
    /* Label */
    cvs_fillstyle(ctx, "#ffffff");
    cvs_font(ctx, "9px monospace");
    cvs_filltext(ctx, sph_label(j), mx - 4, my + 3);
    mut j = j + 1
  );
  /* Gold line at lambda=1680 cycle boundary (multiplicative exponent marker) */
  let phase = t % 1680 in
  if phase == 0 then (
    cvs_strokestyle(ctx, "#ffd700");
    cvs_linewidth(ctx, 2);
    cvs_beginpath(ctx);
    cvs_moveto(ctx, cx, cy - 8);
    cvs_lineto(ctx, cx, cy - 150);
    cvs_stroke(ctx)
  ) else 0;
  /* HUD: step counter + lambda cycle progress */
  cvs_fillstyle(ctx, "#b0b0c0");
  cvs_font(ctx, "11px monospace");
  cvs_filltext(ctx, "step ${t}", 8, 14);
  let pct = (phase * 100) / 1680 in
  cvs_filltext(ctx, "lambda: ${pct}%", 220, 14);
  /* Progress bar: lambda cycle */
  cvs_fillstyle(ctx, "#1a1a2e");
  cvs_fillrect(ctx, 8, 354, 334, 8);
  let barW = (phase * 334) / 1680 in
  let barClr = if phase < 840 then "#44ff88" else "#ffd700" in
  cvs_fillstyle(ctx, barClr);
  cvs_fillrect(ctx, 8, 354, barW, 8)
)

/* ===== ANIMATION TICK ===== */
/* sph_speed: 1=x0.25, 2=x0.5, 4=x1, 8=x2, 16=x4, 32=x8, 64=x16, 128=x32.
   Base rate: 1 step per 32 frames (~2 steps/sec at 60fps).
   speed>=32: advance speed/32 steps per frame.
   speed<32: advance 1 step every 32/speed frames. */
fn sph_tick() = (
  if sph_playing[0] == 1 then (
    let spd = sph_speed[0] in
    let f = sph_frame[0] + 1 in
    set(sph_frame, 0, f);
    if spd >= 32 then (
      set(sph_step, 0, sph_step[0] + spd / 32);
      sph_draw()
    ) else (
      let div = 32 / spd in
      if f % div == 0 then (
        set(sph_step, 0, sph_step[0] + 1);
        sph_draw()
      ) else 0
    )
  ) else 0
)

/* ===== CONTROLS ===== */
fn sph_play() = (
  set(sph_playing, 0, 1)
)

fn sph_pause() = (
  set(sph_playing, 0, 0)
)

fn sph_step_fwd() = (
  set(sph_step, 0, sph_step[0] + 1);
  sph_draw()
)

fn sph_reset() = (
  set(sph_step, 0, 0);
  sph_draw()
)

fn sph_jump_lambda() = (
  let t = sph_step[0] in
  let phase = t % 1680 in
  let next = t + (1680 - phase) in
  set(sph_step, 0, next);
  sph_draw()
)

fn sph_speed_label(s) = (
  if s == 1 then "x0.25"
  else if s == 2 then "x0.5"
  else if s == 4 then "x1"
  else if s == 8 then "x2"
  else if s == 16 then "x4"
  else if s == 32 then "x8"
  else if s == 64 then "x16"
  else "x32"
)

fn sph_speed_up() = (
  let s = sph_speed[0] in
  if s < 128 then set(sph_speed, 0, s * 2) else 0;
  let el = dom_query("#sph-speed-lbl") in
  dom_inner(el, sph_speed_label(sph_speed[0]))
)

fn sph_speed_down() = (
  let s = sph_speed[0] in
  if s > 1 then set(sph_speed, 0, s / 2) else 0;
  let el = dom_query("#sph-speed-lbl") in
  dom_inner(el, sph_speed_label(sph_speed[0]))
)

/* ===== HERO (T^7 torus + Gabriel-Horn cap, Phase OMEGA spine) ===== */
fn sph_hero() = (
  let hero = make_hero("Spinning Spheres") in
  render_p(hero, "Seven CRT channels stack into a T^7 torus: S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17). An address orbiting fast fills its channel; a ring spinning fast looks like a sphere. The canvas below IS this T^7 torus projected to seven nested orbit shells, each dot the element's position on its own circle.");
  render_p(hero, "The ring IS the Gabriel-Horn cap of the ambient integer lattice. Unbounded Z^7 has infinite-mode Laplacian spectrum = an infinite-surface horn. The ring truncates modes at k <= N-1, capping the horn at finite volume. That cap is what you see: seven bounded circles. Tower_b's q = 49 channel is the slowest orbit and carries the finest angular resolution; a uniform spectral floor gap = 4*sin^2(pi/49) ~ 0.01644 lives on that b-axis.");
  render_p(hero, "Two Clay-Millennium STRUCTURAL analogs sit inside this one canvas. STRUCTURAL Yang-Mills mass-gap analog (Thm 33, S1436): the gap is a 0-form on all 108 lambda=420 heartbeat-lattice rings (TRANS is one). STRUCTURAL Navier-Stokes horn analog (Thm 34, S1437): CRT decomposes the graph Laplacian into seven orthogonal per-channel Laplacians, so finite-time blowup would demand simultaneous singularity in independent channels = forbidden by CRT orthogonality. NOT Clay proofs. The abelian CRT Cayley graph is to non-abelian YM / continuum NS what a finite-dim ODE is to a PDE on R^4 / R^3.");
  render_p(hero, "Below: T^7 rendered as seven concentric orbit shells. Each dot orbits at angular velocity 2*pi/q_i. Full realignment (all seven dots return simultaneously) requires lcm(8,9,25,49,11,13,17) = TRANS = 214,414,200 steps. The gold line marks lambda = 1680, the multiplicative exponent of the unit group.");
  dom_append(dom_body(), hero)
)

/* ===== CANVAS + CONTROLS SECTION ===== */
fn sph_canvas_section() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Machine");
  /* Canvas */
  let cvs = dom_create("canvas") in
  dom_attr(cvs, "id", "sph-canvas");
  cvs_setsize(cvs, 350, 370);
  dom_style(cvs, "display", "block");
  dom_style(cvs, "background", "#0a0a18");
  dom_style(cvs, "maxWidth", "100%");
  dom_style(cvs, "border", "1px solid #333");
  dom_style(cvs, "borderRadius", "8px");
  dom_style(cvs, "margin", "0 auto 12px");
  dom_append(sec, cvs);
  let ctx = cvs_getctx(cvs) in
  set(sph_ctx, 0, ctx);
  /* Control buttons */
  let ctrls = dom_create("div") in
  dom_style(ctrls, "display", "flex");
  dom_style(ctrls, "gap", "6px");
  dom_style(ctrls, "flexWrap", "wrap");
  dom_style(ctrls, "justifyContent", "center");
  dom_style(ctrls, "marginBottom", "12px");
  let bs = "6px 12px" in let br = "4px" in let fs = "12px" in
  let b1 = dom_create("button") in dom_text(b1, "Play"); dom_style(b1, "padding", bs); dom_style(b1, "cursor", "pointer"); dom_style(b1, "background", "#228833"); dom_style(b1, "color", "#fff"); dom_style(b1, "border", "none"); dom_style(b1, "borderRadius", br); dom_style(b1, "fontSize", fs); dom_on(b1, "click", "sph_play"); dom_append(ctrls, b1);
  let b2 = dom_create("button") in dom_text(b2, "Pause"); dom_style(b2, "padding", bs); dom_style(b2, "cursor", "pointer"); dom_style(b2, "background", "#884422"); dom_style(b2, "color", "#fff"); dom_style(b2, "border", "none"); dom_style(b2, "borderRadius", br); dom_style(b2, "fontSize", fs); dom_on(b2, "click", "sph_pause"); dom_append(ctrls, b2);
  let b3 = dom_create("button") in dom_text(b3, "Step"); dom_style(b3, "padding", bs); dom_style(b3, "cursor", "pointer"); dom_style(b3, "background", "#336688"); dom_style(b3, "color", "#fff"); dom_style(b3, "border", "none"); dom_style(b3, "borderRadius", br); dom_style(b3, "fontSize", fs); dom_on(b3, "click", "sph_step_fwd"); dom_append(ctrls, b3);
  let b4 = dom_create("button") in dom_text(b4, "Reset"); dom_style(b4, "padding", bs); dom_style(b4, "cursor", "pointer"); dom_style(b4, "background", "#663344"); dom_style(b4, "color", "#fff"); dom_style(b4, "border", "none"); dom_style(b4, "borderRadius", br); dom_style(b4, "fontSize", fs); dom_on(b4, "click", "sph_reset"); dom_append(ctrls, b4);
  let b5 = dom_create("button") in dom_text(b5, "Jump to lambda"); dom_style(b5, "padding", bs); dom_style(b5, "cursor", "pointer"); dom_style(b5, "background", "#886622"); dom_style(b5, "color", "#fff"); dom_style(b5, "border", "none"); dom_style(b5, "borderRadius", br); dom_style(b5, "fontSize", fs); dom_on(b5, "click", "sph_jump_lambda"); dom_append(ctrls, b5);
  let b6 = dom_create("button") in dom_text(b6, "Slower"); dom_style(b6, "padding", bs); dom_style(b6, "cursor", "pointer"); dom_style(b6, "background", "#444466"); dom_style(b6, "color", "#fff"); dom_style(b6, "border", "none"); dom_style(b6, "borderRadius", br); dom_style(b6, "fontSize", fs); dom_on(b6, "click", "sph_speed_down"); dom_append(ctrls, b6);
  let spd_lbl = dom_create("span") in dom_attr(spd_lbl, "id", "sph-speed-lbl"); dom_text(spd_lbl, "x1"); dom_style(spd_lbl, "color", "#ffd700"); dom_style(spd_lbl, "fontSize", fs); dom_style(spd_lbl, "padding", "6px 4px"); dom_append(ctrls, spd_lbl);
  let b7 = dom_create("button") in dom_text(b7, "Faster"); dom_style(b7, "padding", bs); dom_style(b7, "cursor", "pointer"); dom_style(b7, "background", "#444466"); dom_style(b7, "color", "#fff"); dom_style(b7, "border", "none"); dom_style(b7, "borderRadius", br); dom_style(b7, "fontSize", fs); dom_on(b7, "click", "sph_speed_up"); dom_append(ctrls, b7);
  dom_append(sec, ctrls);
  dom_append(dom_body(), sec);
  /* Initial draw + start animation loop */
  sph_draw();
  raf("sph_tick")
)

/* ===== THE CAPPED HORN (Gabriel-Horn anchor; MP.4 + GH.2 ground truth) ===== */
fn sph_horn_cap() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Capped Horn");
  render_p(sec, "Gabriel's Horn = y = 1/x rotated about the x-axis for x >= 1. Volume = pi (finite). Surface = infinity (diverges logarithmically). Paradox: finite paint, unpaintable surface. The ring realizes the paradox geometrically = its state space IS the horn's finite-volume side; the continuum integer lattice Z^k IS its unbounded-surface side.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Aspect");
  render_th(hdr, "Gabriel's Horn");
  render_th(hdr, "CRT ring Z/N");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Volume side", "Volume = pi (finite)", "Ring state space (N*d dims, finite)");
  render_table_row(tbl, "Surface side", "Surface = infinity", "Continuum Z^k infinite-mode spectrum");
  render_table_row(tbl, "The cap", "Rotation at x = R", "Truncate Fourier modes at k <= N-1");
  render_table_row(tbl, "Inside the cap", "Finite paint", "Bounded L^2-energy E(t) <= E(0)");
  render_table_row(tbl, "Outside the cap", "Unbounded coat", "Clay-NS open on R^3 (unbounded modes)");
  render_p(sec, "The canvas above IS the cap. Seven bounded orbit shells = T^7 torus rendered as the horn's finite-volume side. The ring has no horn-surface side because it has no uncapped mode. Clay-NS stays open because R^3 cannot be truncated without breaking Galilean invariance and scale symmetry; the ring eliminates the paradox by capping at N.");
  let g = make_findings_grid(sec) in
  render_finding(g, "CRT = 7 per-channel Laplacians", "Ω.MP.4 core, S1437", "On TRANS = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17, the graph Laplacian is a direct sum of 7 per-channel Laplacians on orthogonal Fourier subspaces. Finite-time blowup would need simultaneous singularity across independent channels = CRT orthogonality forbids coupled explosion. Seven micro-horns, not one coupled horn.", "S1437");
  render_finding(g, "b^2-forced gap floor 0.01644", "S1436 + S1437 share controller", "b^2 = 49 strictly dominates every other channel width (D^4=16, K^2=9, E^2=25, L=11, GATE=13). Therefore q_max = 49 unconditionally and gap = 4*sin^2(pi/49) is identical across all 108 lambda=420 rings = a 0-form on the heartbeat lattice. YM and NS STRUCTURAL analogs read this single b^2-forced invariant through different physical variables.", "S1436+S1437");
  render_finding(g, "STRUCTURAL analogs, NOT Clay proofs", "Honest framing (non-negotiable)", "Discrete NS on a finite-dim ODE has global existence trivially; the content is the structural MAPPING. Abelian CRT Cayley graphs are to non-abelian quantum YM on R^4 what free-field lattice gap is to interacting YM. Ring = capped horn; Clay-problem = uncapped continuum.", "S1437");
  dom_append(dom_body(), sec)
)

/* ===== SEVEN ORBITS (tower inventory) ===== */
fn sph_orbits() = (
  let sec = make_section("800px") in
  render_h2(sec, "Seven Orbits");
  render_p(sec, "Each orbit IS a micro tower made visible. The modulus q is the tower top. The orbit period is q steps. The number of complete orbits in one lambda cycle (1680 steps) = floor(1680/q). Only D divides 1680 evenly.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Orbit");
  render_th(hdr, "q");
  render_th(hdr, "Tower depth");
  render_th(hdr, "Orbits/lambda");
  render_th(hdr, "Role");
  dom_append(tbl, hdr);
  render_table_row_5(tbl, "D", "8", "3 (unique)", "210 (exact)", "Fastest. Bridge instrument.");
  render_table_row_5(tbl, "K", "9", "2", "186 (+6/9)", "Closure engine.");
  render_table_row_5(tbl, "E", "25", "2", "67 (+5/25)", "Observer. E^2=0 mod 25.");
  render_table_row_5(tbl, "b", "49", "2", "34 (+14/49)", "Slowest DATA. Depth prime.");
  render_table_row_5(tbl, "L", "11", "1", "152 (+8/11)", "Protector. ECC parity.");
  render_table_row_5(tbl, "GATE", "13", "1", "129 (+3/13)", "Boundary. ECC parity.");
  render_table_row_5(tbl, "ESCAPE", "17", "1", "98 (+14/17)", "Transcendence. ECC parity.");
  render_p(sec, "DATA channels {D, K, E, b} carry information (warm colors, inner orbits). ALIVE channels {L, GATE, ESCAPE} carry parity (cool colors, outer orbits). Fattening gives each DATA channel p^e positions (vs p thin), but the speed ordering is not DATA-vs-ALIVE: D (period 8) is fastest overall, while b (period 49) is slowest.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Lambda = b * 240", "1680 = 7 * lcm(2,6,20,10,12,16)", "The depth prime b=7 contributes exactly one factor to the multiplicative exponent. Remove b-fattening (lambda(49)=42) and the remaining channel lambdas give lcm = 240. The ratio lambda/240 = b.", "S1331");
  render_finding(g, "Full return = TRANS", "lcm(8,9,...,17) = 214414200", "The additive orbit period (when all 7 dots return to start simultaneously) equals the product of all moduli, which is TRANS itself. Lambda = 1680 is the multiplicative exponent (a^1680 = 1 for coprime a), not the additive return.", "TT29");
  dom_append(dom_body(), sec)
)

/* ===== ANGULAR MOMENTUM (cross-tower) ===== */
fn sph_angmom() = (
  let sec = make_section("800px") in
  render_h2(sec, "Angular Momentum");
  render_p(sec, "When two elements spin at the same stride, the sum of their circular phase differences across all 7 channels is constant. The step cancels out. This constant IS the CRT distance between the two elements, measured dynamically.");
  render_p(sec, "For sigma(1) and D(2): differ by 1 in every channel. circ_dist(1, q) = 1 for all q >= 3. Sum = 7 * 1 = 7 = b. Measured on ESP32 hardware: every SPIN packet between the sigma board and D board shows ang_mom = 7.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair");
  render_th(hdr, "CRT distance");
  render_th(hdr, "Why");
  dom_append(tbl, hdr);
  render_table_row(tbl, "sigma(1), D(2)", "7 = b", "Differ by 1 on all 7 channels.");
  render_table_row(tbl, "sigma(1), K(3)", "14 = D*b", "Differ by 2 on all channels.");
  render_table_row(tbl, "D(2), K(3)", "7 = b", "Differ by 1 on all channels.");
  render_table_row(tbl, "void(0), K(3)", "21 = K*b", "Differ by 3 on all channels.");
  render_table_row(tbl, "Maximum", "63", "All channels antipodal: sum floor(q/2).");
  render_p(sec, "The angular momentum depends on which elements you compare, not on how long the ring has been spinning. Rotation contributes nothing -- the structure was already there. A dynamic measurement revealing a static invariant.");
  let g = make_findings_grid(sec) in
  render_finding(g, "ang_mom(1,2) = 7 = b", "ESP32 S1334", "CRT distance IS angular momentum. Proved: dist(a+s, b+s) = dist(a, b) because stride s cancels in every channel. Same-stride constancy is algebraic, not empirical.", "S1334");
  render_finding(g, "Different strides: avg 33", "ESP32 + test 40/40", "When elements step at different rates, angular momentum varies. Per-channel expectation: E[circ_dist in Z/q] = q/4 (even) or (q^2-1)/(4q) (odd). Total: 32.86. Hardware: 33.00 (stride 1:2, 90 packets). Verified: test_ang_mom.ax 40/40, FPGA crt_ang_mom.v 710 cells.", "S1350");
  dom_append(dom_body(), sec)
)

/* ===== DETECTION (Tower_L — the protector) ===== */
fn sph_detect() = (
  let sec = make_section("800px") in
  render_h2(sec, "Detection");
  render_p(sec, "Tower_L = the protector. L = 11 = sigma + D + K + E. ECC3 triple parity uses all three ALIVE channels (L + GATE + ESCAPE, rate 4/7). Any single-channel corruption is 100% detectable and correctable.");
  render_p(sec, "Measured on ESP32 (S5, S9): L-channel injection detected at 100% rate. Phase-independent: 72/72 tests across all rotation phases, including all 7 channel wrap points. Time does not affect ECC detectability.");
  let g = make_findings_grid(sec) in
  render_finding(g, "100% single-channel detect", "S5: every injected error caught", "L=11 parity catches every single-channel error. The parity product 11*13*17 = 2431 exceeds max_data^2 = 49^2 = 2401. Margin of 30 means no data-channel error can hide.", "S1334");
  render_finding(g, "Phase-independent ECC", "72/72, S9", "b-channel (54 tests) and L-channel (18 tests) injection across lambda progress 5-109. 100% detection at every phase, including all 7 channel wrap points. Triple parity makes any single-channel error always detectable.", "S1342");
  dom_append(dom_body(), sec)
)

/* ===== RECOVERY (Tower_D — the bridge) ===== */
fn sph_recover() = (
  let sec = make_section("800px") in
  render_h2(sec, "Recovery");
  render_p(sec, "Tower_D = the bridge. D = 2 = duality, involution, the -1 mirror. When corruption is detected, the -1 round-trip cancels it. The algebra: x + e becomes (N - x - e) + e = N - x becomes x. Two errors, two mirrors, perfect cancellation.");
  render_p(sec, "Measured on ESP32 (S5b): D board injects L-channel error (+1 mod 11) on every 5th packet. Void detects, mirrors the corrupted value (N - corrupted), sends back. D applies same error on return, mirrors again. Result: 100% recovery (4/4 targeted tests).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Round-trip recovery 4/4", "S5b: -1 theorem on radio", "corrupted = 116953202 (element 2 + e_L). mirror = 97460998. Return L+1 plus final mirror yields 2. Exact.", "S1339");
  dom_append(dom_body(), sec)
)

/* ===== OPERATIONAL BOUNDARY (Tower_GATE — the skin) ===== */
fn sph_boundary() = (
  let sec = make_section("800px") in
  render_h2(sec, "Operational Boundary");
  render_p(sec, "Tower_GATE = the boundary between inside and outside. GATE = 13 = skin. Here: the boundary between auto-heal (1 error) and retransmit (2 errors). Exhaustive computation: 535 million 2-channel error patterns tested. Zero undetected.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Error type");
  render_th(hdr, "Count");
  render_th(hdr, "Detection");
  render_th(hdr, "Correction");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1 channel", "any", "100%", "100% (auto-heal)");
  render_table_row_4(tbl, "2 ch (DATA+DATA)", "202M", "100%", "retransmit");
  render_table_row_4(tbl, "2 ch (DATA+PAR)", "292M", "100%", "retransmit");
  render_table_row_4(tbl, "2 ch (PAR+PAR)", "42M", "100%", "retransmit");
  render_p(sec, "The algebraic guard: parity product 2431 = 11*13*17 exceeds 49^2 = 2401. Margin of 30 means no pair of data-channel errors can produce a syndrome-invisible delta. Protocol: detect() on every packet. Clean = accept. Error = retransmit via -1 round-trip.");
  let g = make_findings_grid(sec) in
  render_finding(g, "535M exhaustive = 0 silent", "test_multi_ecc 45/45", "Every possible 2-channel error pattern across all 21 channel pairs and all 88,200 data values: 100% detected. The parity product exceeding max_data^2 is the algebraic proof.", "S1343");
  render_finding(g, "FPGA: 88200 ECC on silicon", "crt_k9_ecc.v V2, 1696 LUT4", "All 88,200 data values tested with b-channel +1 corruption on Tang Nano 20K at 27 MHz. 0 false negatives. Syndrome: d + 27000 mod 88200, then triple parity check. All 6 LEDs ON = proof.", "S1344");
  dom_append(dom_body(), sec)
)

/* ===== HEARTBEAT STABILITY (Tower_C) ===== */
fn sph_heartbeat() = (
  let sec = make_section("800px") in
  render_h2(sec, "Heartbeat Stability");
  render_p(sec, "Tower_C = the heartbeat fiber. Lambda = 1680 = the multiplicative exponent (a^1680 = 1 for all a coprime to TRANS). The heartbeat is not the spin period (that is TRANS) but the algebraic pulse of the unit group.");
  render_p(sec, "The 24-hour drift test (S10): 3 boards spinning continuously, stride=1. Void captures angular momentum from both sigma and D every 3 seconds. 51,738 packets total. Result: ang_mom = 34 for every single observation. Zero drift. Zero ECC failures.");
  render_p(sec, "The value 34 depends on boot timing: boards power on at different moments, creating a fixed CRT distance between their spinning phases. Same-stride constancy means this is provably step-independent: any boot offset giving 34 stays at 34 forever. Verified: test_drift.ax 62/62.");
  render_p(sec, "Drift sensitivity: a single-beat drift (3 seconds) would change ang_mom from 34 to 33. Over 24 hours (28,800 beats), ang_mom stayed exactly 34. ESP32 clocks stable to within 3 seconds per 24 hours (< 35 ppm). CRT provides free clock monitoring with zero protocol overhead.");
  let g = make_findings_grid(sec) in
  render_finding(g, "24h zero drift", "ang_mom=34, 51738 pkts", "25,827 from sigma, 25,911 from D. All at ang_mom = 34. Zero ECC failures. Zero calibration delta. The CRT structure IS the clock monitor.", "S1357");
  render_finding(g, "30-min stability", "540/540 ang_mom=47", "Earlier 30-minute test: 1801 seconds, 840 clean packets, 0 natural ECC failures. Angular momentum constant at 47 throughout.", "S1337");
  render_finding(g, "Free clock monitoring", "ang_mom drift detector", "If clocks drift by delta beats, ang_mom shifts. Drift 0 gives 7, drift 1 gives 0, drift 5 gives 28. Any deviation from expected constant = drift detected. No GPS, no protocol overhead.", "S1334");
  dom_append(dom_body(), sec)
)

/* ===== STRIDE AND ISOLATION (Tower_ESCAPE) ===== */
fn sph_isolation() = (
  let sec = make_section("800px") in
  render_h2(sec, "Stride and Isolation");
  render_p(sec, "Tower_ESCAPE = transcendence. ESCAPE = 17, the TRANS-exclusive channel (not in TRUE). All three ALIVE channels (Z/11, Z/13, Z/17) are fields. When boards spin at different strides, angular momentum becomes step-dependent. The stride DIFFERENCE determines which channels are frozen.");
  render_h3(sec, "Stride Lock Theorem");
  render_p(sec, "gcd(stride_diff, q_i) = q_i freezes channel i. The D-channel has modulus 8. Any stride difference divisible by 8 locks D at a constant angular momentum contribution. Three stride ratios tested on hardware (90 packets each):");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Stride");
  render_th(hdr, "avg ang_mom");
  render_th(hdr, "delta from 33");
  render_th(hdr, "mechanism");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1:2", "33.00", "0.00", "No channel locked.");
  render_table_row_4(tbl, "1:7 (depth)", "33.22", "+0.22", "Near-uniform mixing.");
  render_table_row_4(tbl, "1:17", "35.08", "+2.08", "D locked (16 mod 8=0).");
  render_h3(sec, "Channel Isolation Hierarchy");
  render_p(sec, "Isolation stride for channel i = N/q_i. To observe ONLY one channel, spin at the stride that makes all others period-1. The ring hierarchy IS the isolation hierarchy:");
  let t2 = make_table(sec) in
  let h2 = dom_create("tr") in
  render_th(h2, "Isolate");
  render_th(h2, "Stride = N/q");
  render_th(h2, "Ring");
  dom_append(t2, h2);
  render_table_row(t2, "ESCAPE (q=17)", "12612600", "TRUE");
  render_table_row(t2, "GATE (q=13)", "16493400", "");
  render_table_row(t2, "L (q=11)", "19492200", "");
  render_table_row(t2, "b (q=49)", "4375800", "");
  render_table_row(t2, "E (q=25)", "8576568", "");
  render_table_row(t2, "K (q=9)", "23823800", "");
  render_table_row(t2, "D (q=8)", "26801775", "OMEGA");
  let g = make_findings_grid(sec) in
  render_finding(g, "D-channel lock +2.08", "stride_diff 16 mod 8 = 0", "Stride 1:17 has stride difference 16. Since 16 mod 8 = 0, D-channel freezes. Boot offset delta=2 gives D-contribution = 4 (max). Corrects S1340 ESCAPE attribution: ESCAPE phase IS frozen on sender, but ang_mom contribution still varies.", "S1342");
  render_finding(g, "Ring = isolation", "N/q hierarchy", "Each sub-ring isolates the channel it excludes. Stride at TRUE = N/17 isolates ESCAPE. Stride at OMEGA = N/8 isolates D.", "S1342");
  dom_append(dom_body(), sec)
)

/* ===== SILICON PROOF (Tower_K — K^2=9 pipeline) ===== */
fn sph_silicon() = (
  let sec = make_section("800px") in
  render_h2(sec, "Silicon");
  render_p(sec, "Tower_K = closure. K^2 = 9 = the parallelism unit. The FPGA implementations prove the spinning structure on silicon, where the ring physically orbits at clock speed.");
  let g = make_findings_grid(sec) in
  render_finding(g, "K^2=9 pipeline at 267 MHz", "crt_k9_pipeline.v, 6555 LUT4 (31%)", "9-stage pipeline, 7 channels decomposed in parallel. Counter cycles 0 to 214,414,199 at 267 MHz. Full orbit in 0.8 seconds. The spinning counter IS the ring made physical on Tang Nano 20K.", "S1265");
  render_finding(g, "ECC3 on silicon", "crt_k9_ecc.v V2, 1696 LUT4 (8%)", "88,200 syndrome checks at 27 MHz. Inject b+1, compute d+27000 mod 88200, check all 3 parity channels. 0 false negatives. All 6 LEDs ON = proof.", "S1344");
  render_finding(g, "CRT polyrhythm", "crt_polyrhythm.v, 196 cells", "6 LEDs = 6 TRUE channels. Each LED shows cos(2*pi*r/q) sign at human-visible rate. D blinks at ~3.2 Hz, b at ~0.5 Hz. The depth prime IS the slowest orbit. 6 independent wrap-around counters (CRT isomorphism). The spinning sphere, visible to the eyes.", "S1345");
  render_finding(g, "Angular momentum on FPGA", "crt_ang_mom.v, 710 cells (2.4%)", "Two spinning addresses (stride 1:2) on TRANS torus. 14 wrap-around counters compute circular CRT distance every cycle. Proof phase sweeps all 214M addresses in ~8 seconds: min=0 (alignment), max=63 (all antipodal). Lambda-cycle sum: 55205/1680 = 32.86, matching ESP32.", "S1350");
  render_finding(g, "Void pilots all layers", "0 mod q = 0 for all q", "Element 0 (void) has residue 0 in every channel. It sees every layer simultaneously. Void is the natural hub of the spinning structure.", "S1331");
  dom_append(dom_body(), sec)
)

