  let sec = make_section("800px") in
  render_h2(sec, "The Mirror Element");
  render_p(sec, "Most properties of -1 are elementary algebra true in any Z/NZ. The ONE genuinely non-elementary result:");
  render_theorem(sec, "Round-Trip Cancellation (S1328, 37/37)", "-1 is the UNIQUE involution where round-trip phase conjugation cancels errors. Send x, corrupt to x+e, mirror to N-x-e, corrupt again to N-x. Only u=-1 has u(u+1)=0, making the error vanish. All other involutions leave residual. O(1) cost.");
  render_p(sec, "D-Spaced Decality: all 9 gaps between {-1, 0, 1, 2, 3, 5, 7, 11, 13, 17} are D-powers {1, 1, 1, 1, 2, 2, 4, 2, 4}. Counts {4, 3, 2} descend as {D^2, K, D}. Product = 24 = tau(420). Sum = 9 = K^2. Span = 18 = D*K^2.");
  dom_append(dom_body(), sec)
)

