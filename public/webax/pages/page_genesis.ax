  render_table_row(tbl, "K = 3", "3", "Closure");
  render_table_row(tbl, "E = 5", "5", "Observer");
  render_table_row(tbl, "b = 7", "0", "VOID (self-annihilating)");
  render_table_row(tbl, "L = 11", "4", "Protector");
  render_table_row(tbl, "GATE = 13", "6 = -1", "MIRROR");
  render_table_row(tbl, "ESCAPE = 17", "3", "= K (meta-identical)");
  render_theorem(sec, "490 Spectral Derivation (Theorem 24, G1)", "GATE = -1 mod 7 partitions Z/7* into 3 cosets: {1,6}, {2,5}, {3,4}. Void joins the shallower coset. DEAD = {b, D, E}. ALIVE = {GATE, K, L}. This IS the 490 holographic split, derived from Z/7 alone.");
  render_theorem(sec, "Unique Minimal Primes (G2)", "Given b=7: L=11 is the smallest prime >7 with residue 4 mod 7. GATE=13 is the smallest >11 with residue -1 mod 7. ESCAPE=17 is the smallest >13 with residue 3 mod 7. The axiom primes are uniquely forced.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Exponents (Thm 25)", "Three layers", "Z/7 classifies 6/7. Chain resolves K. Lambda selects b^2.", "S1366");
  render_finding(g, "Landscape (Thm 26)", "Conditional mean", "E[eigenvalue | b=r] = 2cos(2*pi*r/7). Deep coset controls 71% of tail.", "S1366");
  render_finding(g, "Golden ratio (Thm 27)", "phi through E=5", "2cos(4*pi/5) = -phi exactly. ADDRESS=137 = floor(golden_angle).", "S1366");
  render_p(sec, "The loop: Z/7 generates the axiom. Project the axiom back to Z/7: recover the meta-ring. The ring of rings: Z/7 -> TRANS -> Z/7.");
  dom_append(dom_body(), sec)
)

