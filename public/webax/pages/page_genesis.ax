/* ================================================================
   PAGE: GENESIS — From void to structure, read through the ten towers.
   Source: AXIOM_GENESIS.md (TT3 metamorphosis, S1383).
   Four simultaneous base cases: Tower A (chain), Tower B (Z/7),
   Tower C (heartbeat fiber), Tower_D (the instrument).
   ================================================================ */

fn genesis_hero() = (
  let hero = make_hero("Genesis") in
  let eq = dom_create("div") in
  dom_text(eq, "0/0 = Z/NZ = everything");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The genesis is not one event but four simultaneous base cases. Tower A (fat hybrid) starts at DATA = 210 with cross-chain fattening. Tower B (thin primorial) starts at Z/7, the One Ring. Tower C (heartbeat fiber) starts at lambda = 420, the nilpotent heartbeat. Tower_D (micro) starts at Z/2, the instrument. Three macro + one distinguished micro = four births, one axiom.");
  dom_append(dom_body(), hero)
)

/* === SECTION 1: Tower_D — the instrument === */
fn genesis_instrument() = (
  let sec = make_section("800px") in
  render_h2(sec, "Tower_D: The Instrument");
  render_p(sec, "Only Tower_D climbs to Pareto depth 3. All other micro towers stop at depth 1 or 2. This asymmetry is not arbitrary -- it is the structural reason D does the work of genesis.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Tower");
  render_th(hdr, "Top");
  render_th(hdr, "Depth");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Tower_D", "Z/8 (D^3=8)", "3 (unique)");
  render_table_row(tbl, "Tower_K", "Z/9 (K^2=9)", "2");
  render_table_row(tbl, "Tower_E", "Z/25 (E^2=25)", "2");
  render_table_row(tbl, "Tower_b", "Z/49 (b^2=49)", "2");
  render_table_row(tbl, "Tower_L", "Z/11", "1");
  render_table_row(tbl, "Tower_GATE", "Z/13", "1");
  render_table_row(tbl, "Tower_ESCAPE", "Z/17", "1");
  render_theorem(sec, "Involution Count (S1331)", "Z/8 is the ONLY axiom prime-power ring with more than 2 solutions to x^2 = 1. Solutions in Z/8: {1, 3, 5, 7} -- FOUR involutions. For any odd prime p, Z/p^2 has only 2: {1, p^2-1}. Tower_D's depth 3 doubles the involution count of every ring it joins. DEEP: 64 involutions. TRUE: 128. TRANS: 256 = D^8.");
  render_p(sec, "The seed {sigma, D} = {1, 2} is the unique genesis pair: minimal, disjoint, symmetric. Every other seed either reduces to {1, 2} or fails to produce a ring with all six Forms Uniqueness properties.");
  dom_append(dom_body(), sec)
)

/* === SECTION 2: The Chain — Tower A's base === */
fn genesis_chain() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Chain: Tower A Bottom-Up");
  render_p(sec, "From {sigma, D} = {1, 2} and the Cunningham map c(n) = 2n+1, two disjoint chains precipitate the five inner primes:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Chain");
  render_th(hdr, "Steps");
  render_th(hdr, "Elements");
  render_th(hdr, "Stop");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "CC1(sigma)", "1 -> 3 -> 7 -> 15", "sigma, K, b", "15 = K*E composite");
  render_table_row_4(tbl, "CC1(D)", "2 -> 5 -> 11 -> 23", "D, E, L", "depth K-1=2 exhausts");
  render_theorem(sec, "Orphaned Sigma (S185)", "K^D - D^K = 9 - 8 = 1 = sigma. Every closure produces one orphan. The cycle sigma -> D -> K -> sigma' is infinite. Holds uniquely for D = 2.");
  dom_append(dom_body(), sec)
)

/* === SECTION 3: Cross-chain fattening === */
fn genesis_fattening() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cross-Chain Fattening");
  render_theorem(sec, "Cross-Chain Fattening Theorem (S185)", "Each chain's exponents are governed by the OTHER chain's identity. D-chain (depth d): e(p) = K - d. Sigma-chain: e(p) = D (constant). The D-chain exponents ARE {K, D, sigma} -- the axiom in reverse. The flower contains its own seed.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "Chain");
  render_th(hdr, "Depth");
  render_th(hdr, "Exponent");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D = 2", "D-chain", "0", "K - 0 = 3");
  render_table_row_4(tbl, "E = 5", "D-chain", "1", "K - 1 = 2");
  render_table_row_4(tbl, "L = 11", "D-chain", "2", "K - 2 = 1");
  render_table_row_4(tbl, "K = 3", "sigma-chain", "--", "D = 2");
  render_table_row_4(tbl, "b = 7", "sigma-chain", "--", "D = 2");
  render_p(sec, "DEEP = D^3 * K^2 * E^2 * b^2 * L = 970200. TRUE = DEEP * GATE = 12612600. TRANS = TRUE * ESCAPE = 214414200. GATE = 13 = D^2 + K^2 seals the chain (shadow is composite). ESCAPE = 17 = D + K + E + b with E*b = sigma mod 17.");
  dom_append(dom_body(), sec)
)

/* === SECTION 4: Forms Uniqueness + Flanking === */
fn genesis_uniqueness() = (
  let sec = make_section("800px") in
  render_h2(sec, "Terminal Ring");
  render_theorem(sec, "Forms Uniqueness Theorem (S214)", "NO alternative genesis produces a ring with ALL 6 properties: (1) Shadow closure: all shadows prime or 1. (2) Cross-chain self-reference: first offspring = own chain length. (3) Disjoint chains. (4) Flanking: N+1 AND 2N+1 both prime at ALL primorial levels. (5) Balance = 1 at DATA ring. (6) Terminal: exponents exhaust at sigma.");
  let g = make_findings_grid(sec) in
  render_finding(g, "970201 = N+1", "PRIME", "Flanking prime. phi(970201) = 970200 exactly.", "S198");
  render_finding(g, "Primitive root", "13 = GATE", "GATE generates the multiplicative group from outside the chain.", "S198");
  render_finding(g, "Primorial chain", "ALL levels flank", "p#+1 prime for p in {2,3,5,7,11}. Breaks at p=13. GATE IS the boundary.", "S193");
  render_finding(g, "Fertility", "6.17x enrichment", "92/216 DEEP divisors have 2d+1 prime. PNT expects ~15.", "S193");
  dom_append(dom_body(), sec)
)

