/* page_chain_ai.ax -- Ring-specific chain constraints (S1912).
   Tests whether the axiom's specific ring outperforms arbitrary coprimes.
   Result: NO advantage for text prediction. Chain constraints are prime-level,
   not element-level. The ring's value is structural, not statistical. */

fn page_chain_ai() = (
  let hero = make_section("800px") in
  render_h2(hero, "Chain Constraints: Ring vs Random");
  render_p(hero, "Previous experiments proved CRT decomposition helps -- but any coprime moduli give similar results. This experiment asks: does THIS ring's specific structure (chain-constrained primes) outperform arbitrary coprimes of similar sizes?");
  render_p(hero, "The chain primes satisfy algebraic constraints: 3^2-2=7, 5*7=1 mod 17, 3^2+2=11. These relationships between the ring's seven primes create a tight web. Do they help prediction?");
  dom_append(dom_body(), hero);

  -- Experiment setup
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Experiment");
  render_p(sec1, "Same 471-character corpus, same tally-based bigram prediction, same majority-vote CRT reconstruction. Two sets of moduli:");
  render_p(sec1, "RING: [8, 9, 25, 49, 11, 13, 17]. Product = 214,414,200. Chain-constrained primes with 6+ algebraic relationships.");
  render_p(sec1, "RANDOM: [8, 9, 23, 47, 11, 13, 19]. Product = 211,469,544 (1.4% different). Same sizes, all coprime, no chain relationships. Four moduli shared (8, 9, 11, 13).");
  dom_append(dom_body(), sec1);

  -- Results
  let sec2 = make_section("800px") in
  render_h2(sec2, "Results: No Advantage");
  render_p(sec2, "Character-level accuracy: TIED at 172/470 (36.6%) for both ring and random. Channel-level score: ring 1341, random 1355 -- random wins by 14 (1.0%). The chain constraints provide no prediction advantage.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Ring accuracy", "172/470 (36.6%)", "Same as HDC baseline. Chain structure adds nothing to tally decoding.", "");
  render_finding(g2, "Random accuracy", "172/470 (36.6%)", "TIED. Arbitrary coprimes of similar sizes match the ring.", "");
  render_finding(g2, "Ring ch_score", "1341/3290", "Sum of per-channel correct predictions across 470 bigrams.", "");
  render_finding(g2, "Random ch_score", "1355/3290", "Random wins by 14 (1.0%). Driven entirely by one channel.", "");
  dom_append(dom_body(), sec2);

  -- Channel analysis
  let sec3 = make_section("800px") in
  render_h2(sec3, "Channel-Level Analysis");
  render_p(sec3, "Four shared moduli (8, 9, 11, 13) produce IDENTICAL per-channel scores -- proving the experimental infrastructure is correct. The difference comes from three non-shared channels:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "mod 25 vs mod 23", "172 vs 192 (-20)", "mod-23 (prime) beats mod-25 (5^2). Prime moduli have more uniform char distribution.", "");
  render_finding(g3, "mod 49 vs mod 47", "172 vs 172 (0)", "Tied. Both near 49: similar collision patterns for 128 ASCII chars.", "");
  render_finding(g3, "mod 17 vs mod 19", "191 vs 185 (+6)", "Ring's mod-17 wins. Smaller modulus = fewer residue classes = better statistics.", "");
  render_finding(g3, "Shared channels", "4/4 identical", "mod 8, mod 9, mod 11, mod 13: same modulus = same prediction. Control verified.", "");
  dom_append(dom_body(), sec3);

  -- 4-channel reconstruction
  let sec4 = make_section("800px") in
  render_h2(sec4, "4-Channel Reconstruction");
  render_p(sec4, "Using only the first 4 channels ([8,9,25,49] for ring; [8,9,23,47] for random), reconstruct the full character. Products 88,200 and 77,832 both exceed 128, so both uniquely determine any ASCII character from 4 channels.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Ring 4ch", "168/470", "Channels [8,9,25,49] (product 88,200). 4-channel accuracy.", "");
  render_finding(g4, "Random 4ch", "164/470", "Channels [8,9,23,47] (product 77,832). 4 fewer correct.", "");
  render_finding(g4, "Advantage", "+4 (marginal)", "2.4% advantage, likely within statistical noise at n=470.", "");
  dom_append(dom_body(), sec4);

  -- Why
  let sec5 = make_section("800px") in
  render_h2(sec5, "Why Chain Constraints Don't Help");
  render_p(sec5, "Chain constraints (3^2-2=7, 5*7=1 mod 17) are relationships between PRIMES, not between element residues. For a character c, (c%25 * c%49) % 17 does NOT equal c%17 -- it fails for 118 of 128 characters. The constraints create the ring's algebraic identity but don't constrain individual elements.");
  render_p(sec5, "For ASCII text (chars 0-127 in a ring of 214 million), the characters are far below the ring's scale. Any 3 channels with product > 128 uniquely determine the character. The chain's cross-channel redundancy is structurally present but statistically invisible at text scale.");
  render_p(sec5, "CRT advantage = statistical tractability. It comes from the decomposition TECHNIQUE, not from this particular ring's chain structure. The ring's chain constraints may matter for ring-scale tasks (multiplicative structure, eigenvalue computation) but not for text prediction.");
  dom_append(dom_body(), sec5);

  0
)
