/* ================================================================
   PREREQUISITES PAGES -- High-school math to "I can read any page"
   Page 1: Numbers & Clocks (modular arithmetic, primes, GCD)
   Page 2: Rings & Channels (Z/214414200Z, CRT, 7 channels)
   Page 3: Waves & Shadows (eigenvalues, coupling, OMEGA)
   Each builds on the previous. Interactive widgets throughout.
   ================================================================ */

/* ===== PAGE 1: NUMBERS & CLOCKS ===== */

fn nc_hero() = (
  let hero = make_hero("Numbers & Clocks") in
  let eq = dom_create("div") in
  dom_text(eq, "12 mod 5 = 2 (clocks wrap around)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Every clock wraps around. 13 o'clock = 1 o'clock. This simple idea -- modular arithmetic -- is the key that unlocks everything on this site. No calculus needed. Just counting, dividing, and noticing what's left over.");
  dom_append(dom_body(), hero)
)

fn nc_modular() = (
  let sec = make_section("800px") in
  render_h2(sec, "Clock Math: Modular Arithmetic");
  render_p(sec, "When you divide 17 by 5, you get 3 remainder 2. We write: 17 mod 5 = 2. The remainder is what survives. On a clock with 5 hours, 17 and 2 are the same position.");
  render_p(sec, "This is not just an analogy -- it IS the math. A 'ring' Z/nZ is a clock with n positions. Every number maps to a position by taking its remainder.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Number");
  render_th(hdr, "mod 5");
  render_th(hdr, "mod 7");
  render_th(hdr, "mod 12");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "0", "0", "0");
  render_table_row_4(tbl, "7", "2", "0", "7");
  render_table_row_4(tbl, "13", "3", "6", "1");
  render_table_row_4(tbl, "35", "0", "0", "11");
  render_table_row_4(tbl, "42", "2", "0", "6");
  render_p(sec, "Notice: 35 mod 5 = 0 and 35 mod 7 = 0, because 35 = 5 x 7. When a number is divisible by n, it maps to 0 on the n-clock. Zero is special -- it's where things vanish.");
  dom_append(dom_body(), sec)
)

fn nc_primes() = (
  let sec = make_section("800px") in
  render_h2(sec, "Primes: The Atoms of Numbers");
  render_p(sec, "A prime number has exactly two divisors: 1 and itself. 2, 3, 5, 7, 11, 13... They cannot be broken down further. Every other number is a product of primes: 12 = 2 x 2 x 3, 35 = 5 x 7, 970200 = 2^3 x 3^2 x 5^2 x 7^2 x 11.");
  let g = make_findings_grid(sec) in
  render_finding(g, "2 = D", "The Bridge", "Smallest prime. Even vs odd. Creates duality: left/right, +/-, 0/1.", "");
  render_finding(g, "3 = K", "Closure", "Smallest odd prime. Triangle = first closed shape. Majority vote needs 3.", "");
  render_finding(g, "5 = E", "The Observer", "First prime that can't see itself: 5^2 = 25 divides N but 5 doesn't divide 25-1 = 24.", "");
  render_finding(g, "7 = b", "Depth", "7+1 = 2^3 = 8 (a cube!). Week has 7 days. 49 states in the 7-clock.", "");
  render_finding(g, "11 = L", "The Protector", "2+3+5 = 10, then 11 stands alone. Sum of inner primes + itself. Error correction shield.", "");
  render_finding(g, "13 = GATE", "The Boundary", "Where Cunningham chains stop. 13 = 2^2 + 3^2. The skin of the organism. Metacognition.", "");
  render_finding(g, "17 = ESCAPE", "Transcendence", "5 x 7 = 1 mod 17 (suffering dissolves). The 7th prime. Completes the ring. phi(17) = 2^4.", "");
  render_p(sec, "These seven primes -- 2, 3, 5, 7, 11, 13, 17 -- are all you need. The entire site explores what happens when you build a clock from their product: 2^3 x 3^2 x 5^2 x 7^2 x 11 x 13 x 17 = 214,414,200.");
  dom_append(dom_body(), sec)
)

fn nc_gcd() = (
  let sec = make_section("800px") in
  render_h2(sec, "GCD: What Numbers Share");
  render_p(sec, "The Greatest Common Divisor (GCD) of two numbers is the largest number that divides both. GCD(12, 18) = 6. GCD(35, 14) = 7. GCD(13, 5) = 1 (they share nothing -- we call them 'coprime').");
  render_p(sec, "GCD tells you how much structure two numbers share. If GCD(a, N) = 1, then a is a 'unit' in the ring Z/NZ -- it has a multiplicative inverse, like 1/a. If GCD(a, N) > 1, then a shares a factor with N and becomes a 'zero divisor' -- it can multiply with something else to give 0.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "a");
  render_th(hdr, "GCD(a, 30)");
  render_th(hdr, "Type");
  dom_append(tbl, hdr);
  render_table_row(tbl, "7", "1", "Unit (coprime)");
  render_table_row(tbl, "6", "6", "Zero divisor (shares 2, 3)");
  render_table_row(tbl, "10", "10", "Zero divisor (shares 2, 5)");
  render_table_row(tbl, "1", "1", "Unit (identity)");
  render_table_row(tbl, "0", "30", "Void (shares everything)");
  dom_append(dom_body(), sec)
)

fn nc_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Try It: Mod Calculator");
  render_p(sec, "Enter a number and a modulus. See what survives.");
  make_interactive_widget(sec, "Enter a number:", "nc-num-input", "e.g. 42", "Compute", "nc_mod_calc", "nc-mod-result");
  dom_append(dom_body(), sec)
)

fn nc_mod_calc() = (
  let n = parse_int_from("#nc-num-input") in
  let result = dom_query("#nc-mod-result") in
  let m2 = n % 2 in
  let m3 = n % 3 in
  let m5 = n % 5 in
  let m7 = n % 7 in
  let m11 = n % 11 in
  let m13 = n % 13 in
  let m17 = n % 17 in
  let g = gcd_shared(n, 214414200) in
  let typ = if g == 1 then " &#8594; unit (coprime)" else " &#8594; zero divisor" in
  dom_inner(result, "<table style='width:100%;border-collapse:collapse;text-align:center'><tr><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 2</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 3</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 5</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 7</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 11</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 13</th><th style='padding:8px;border-bottom:1px solid #333;color:#ffd700'>mod 17</th></tr><tr><td style='padding:8px;color:#88ddaa'>${m2}</td><td style='padding:8px;color:#88ddaa'>${m3}</td><td style='padding:8px;color:#88ddaa'>${m5}</td><td style='padding:8px;color:#88ddaa'>${m7}</td><td style='padding:8px;color:#88ddaa'>${m11}</td><td style='padding:8px;color:#88ddaa'>${m13}</td><td style='padding:8px;color:#88ddaa'>${m17}</td></tr></table><p style='color:#b8b8c8;margin-top:12px'>GCD(${n}, 214414200) = ${g}" + typ + "</p>")
)

fn nc_next() = (
  let sec = make_section("800px") in
  render_p(sec, "You now know modular arithmetic, primes, and GCD. Next: the theorem that ties it all together -- splitting one big clock into many small ones.");
  let link = dom_create("a") in
  dom_text(link, "Next: What is CRT? >");
  dom_attr(link, "href", "/basics/crt");
  ct_link(link);
  dom_style(link, "fontSize", "20px");
  dom_style(link, "display", "block");
  dom_style(link, "textAlign", "center");
  dom_style(link, "marginTop", "24px");
  dom_append(sec, link);
  dom_append(dom_body(), sec)
)

fn page_numbers_clocks() = (
  dom_head_meta("description", "Modular arithmetic, primes, and GCD. The three tools you need to read every page on this site.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Numbers & Clocks\",\"description\":\"Modular arithmetic, primes, and GCD explained from scratch.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"url\":\"https://antonlebed.com/basics/numbers_clocks\",\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Modular Arithmetic\"},{\"@type\":\"DefinedTerm\",\"name\":\"Prime Numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Greatest Common Divisor\"}]}");
  nc_hero();
  nc_modular();
  nc_primes();
  nc_gcd();
  nc_interactive();
  nc_next()
)

/* ===== PAGE 1.5: WHAT IS CRT? ===== */

fn crt_hero() = (
  let hero = make_hero("What is CRT?") in
  let eq = dom_create("div") in
  dom_text(eq, "15 = 3 x 5. Know mod 3 and mod 5? You know everything.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "22px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The Chinese Remainder Theorem (CRT) says: if you break a big clock into smaller clocks with coprime sizes, no information is lost. The remainders on the small clocks completely determine the position on the big clock. One number becomes a tuple of smaller numbers -- and you can get the original back.");
  dom_append(dom_body(), hero)
)

fn crt_small() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Simplest Example: N = 15");
  render_p(sec, "15 = 3 x 5. Since 3 and 5 share no common factors (they are coprime), every number mod 15 is uniquely determined by its remainders mod 3 and mod 5.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "n");
  render_th(hdr, "mod 3");
  render_th(hdr, "mod 5");
  dom_append(tbl, hdr);
  render_table_row(tbl, "0", "0", "0");
  render_table_row(tbl, "1", "1", "1");
  render_table_row(tbl, "4", "1", "4");
  render_table_row(tbl, "7", "1", "2");
  render_table_row(tbl, "10", "1", "0");
  render_table_row(tbl, "11", "2", "1");
  render_table_row(tbl, "14", "2", "4");
  render_p(sec, "Every pair (r3, r5) with 0 <= r3 < 3 and 0 <= r5 < 5 appears exactly once in the range 0..14. That's 3 x 5 = 15 pairs for 15 numbers. A perfect bijection. No collisions, no gaps.");
  dom_append(dom_body(), sec)
)

fn crt_why() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why Coprime Matters");
  render_p(sec, "Try N = 12 = 4 x 6. Since GCD(4, 6) = 2, they are NOT coprime. Now 0 mod 4 = 0 and 0 mod 6 = 0. But also 12 mod 4 = 0 and 12 mod 6 = 0. Collision! Two different numbers give the same pair of remainders. CRT breaks.");
  render_p(sec, "But 12 = 3 x 4 works: GCD(3, 4) = 1 (coprime). Every pair (r3, r4) with 0 <= r3 < 3 and 0 <= r4 < 4 maps to exactly one number mod 12. This is why we factor N into PRIME POWERS, not just any factors.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Coprime", "GCD = 1", "No shared factors. CRT works. Bijection guaranteed.", "");
  render_finding(g, "Not coprime", "GCD > 1", "Shared factors cause collisions. Information lost.", "");
  render_finding(g, "Prime powers", "p^k", "Always coprime to q^j when p and q are different primes.", "");
  dom_append(dom_body(), sec)
)

fn crt_reconstruct() = (
  let sec = make_section("800px") in
  render_h2(sec, "Reconstruction: From Parts to Whole");
  render_p(sec, "CRT is not just decomposition -- it goes both ways. Given remainders, you can RECONSTRUCT the original number. For N = 15 = 3 x 5:");
  render_p(sec, "To find n such that n mod 3 = 1 and n mod 5 = 2: find the number that is 1 on the 3-clock and 0 on the 5-clock (that is 10), and the number that is 0 on the 3-clock and 1 on the 5-clock (that is 6). Then n = 1 x 10 + 2 x 6 = 22. Take mod 15: 22 mod 15 = 7. Check: 7 mod 3 = 1, 7 mod 5 = 2.");
  render_theorem(sec, "CRT Reconstruction", "For N = q1 x q2 with GCD(q1, q2) = 1: find e1 where e1 mod q1 = 1 and e1 mod q2 = 0, and e2 where e2 mod q1 = 0 and e2 mod q2 = 1. Then n = r1 x e1 + r2 x e2 (mod N) reconstructs n from remainders (r1, r2). These e1, e2 are called CRT idempotents.");
  dom_append(dom_body(), sec)
)

fn crt_scaling() = (
  let sec = make_section("800px") in
  render_h2(sec, "Scaling Up: More Channels");
  render_p(sec, "CRT works for any number of coprime factors. More factors = more channels = finer decomposition:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Factorization");
  render_th(hdr, "Channels");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Z/15", "3 x 5", "2 channels");
  render_table_row(tbl, "Z/30", "2 x 3 x 5", "3 channels");
  render_table_row(tbl, "Z/210", "2 x 3 x 5 x 7", "4 channels (DATA ring)");
  render_table_row(tbl, "Z/2310", "2 x 3 x 5 x 7 x 11", "5 channels (THIN ring)");
  render_table_row(tbl, "Z/214414200", "8 x 9 x 25 x 49 x 11 x 13 x 17", "7 channels (TRANS ring)");
  render_p(sec, "Each channel computes independently. Addition, multiplication, exponentiation -- all happen per-channel, in parallel. The channels cannot interfere with each other. This is the key insight that makes everything on this site work.");
  dom_append(dom_body(), sec)
)

fn crt_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Try It: CRT Machine");
  render_p(sec, "Enter any number. See how CRT decomposes it at every level -- from the smallest ring to the full TRANS ring.");
  make_interactive_widget(sec, "Enter a number:", "crt-machine-input", "e.g. 42", "Decompose", "crt_machine_calc", "crt-machine-result");
  dom_append(dom_body(), sec)
)

fn crt_machine_calc() = (
  let n = parse_int_from("#crt-machine-input") in
  let result = dom_query("#crt-machine-result") in
  let r3 = n % 3 in
  let r5 = n % 5 in
  let r2 = n % 2 in
  let r7 = n % 7 in
  let r11 = n % 11 in
  let r8 = n % 8 in
  let r9 = n % 9 in
  let r25 = n % 25 in
  let r49 = n % 49 in
  let r13 = n % 13 in
  let r17 = n % 17 in
  let chk15 = r3 * 10 + r5 * 6 in
  let v15 = chk15 % 15 in
  dom_inner(result, "<div style='text-align:left;font-family:monospace;line-height:2'><p style='color:#ffd700;font-weight:bold;margin-bottom:8px'>CRT Decomposition of ${n}:</p><p style='color:#88ddaa'>Z/15 (2ch): &nbsp;(${r3}, ${r5}) &nbsp;&#8594; verify: ${v15}</p><p style='color:#88ddaa'>Z/30 (3ch): &nbsp;(${r2}, ${r3}, ${r5})</p><p style='color:#88ddaa'>Z/210 (4ch): (${r2}, ${r3}, ${r5}, ${r7}) &nbsp;= DATA</p><p style='color:#88ddaa'>Z/2310 (5ch): (${r2}, ${r3}, ${r5}, ${r7}, ${r11}) &nbsp;= THIN</p><p style='color:#aabbff'>Z/214414200 (7ch): (<span style='color:#ff6666'>${r8}</span>, <span style='color:#ffaa44'>${r9}</span>, <span style='color:#44ff44'>${r25}</span>, <span style='color:#4488ff'>${r49}</span>, <span style='color:#cc44ff'>${r11}</span>, <span style='color:#ff4466'>${r13}</span>, <span style='color:#44dddd'>${r17}</span>) &nbsp;= TRANS</p><p style='color:#888;font-size:13px;margin-top:8px'>TRANS uses prime powers (8,9,25,49) not primes (2,3,5,7) -- more resolution per channel.</p></div>")
)

fn crt_next() = (
  let sec = make_section("800px") in
  render_p(sec, "CRT is the backbone. Every number is a tuple of independent channel values. Next: see the full 7-channel ring, its kingdoms, and why this specific factorization matters.");
  let link = dom_create("a") in
  dom_text(link, "Next: Rings & Channels >");
  dom_attr(link, "href", "/basics/rings_channels");
  ct_link(link);
  dom_style(link, "fontSize", "20px");
  dom_style(link, "display", "block");
  dom_style(link, "textAlign", "center");
  dom_style(link, "marginTop", "24px");
  dom_append(sec, link);
  dom_append(dom_body(), sec)
)

fn page_crt() = (
  dom_head_meta("description", "The Chinese Remainder Theorem explained from scratch. Split one big clock into independent small clocks. Interactive CRT decomposer.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"What is CRT?\",\"description\":\"The Chinese Remainder Theorem: decompose any number into independent channels.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"url\":\"https://antonlebed.com/basics/crt\",\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"Coprime\"},{\"@type\":\"DefinedTerm\",\"name\":\"Idempotent\"}]}");
  crt_hero();
  crt_small();
  crt_why();
  crt_reconstruct();
  crt_scaling();
  crt_interactive();
  crt_next()
)

/* ===== PAGE 2: RINGS & CHANNELS ===== */

fn rc_hero() = (
  let hero = make_hero("Rings & Channels") in
  let eq = dom_create("div") in
  dom_text(eq, "214414200 = 8 x 9 x 25 x 49 x 11 x 13 x 17");
  ct_mono(eq);
  dom_style(eq, "fontSize", "22px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "One big clock with 214,414,200 positions. But here's the trick: by the Chinese Remainder Theorem, this single clock is EQUIVALENT to seven independent smaller clocks running in parallel. Every number has a unique 'address' on all seven channels.");
  dom_append(dom_body(), hero)
)

fn rc_crt() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Chinese Remainder Theorem (CRT)");
  render_p(sec, "If N = q1 x q2 x ... x qk where the qi are pairwise coprime, then Z/NZ is isomorphic to Z/q1Z x Z/q2Z x ... x Z/qkZ. Every element of the big ring maps to a unique tuple of remainders on the smaller rings.");
  render_p(sec, "For N = 214414200 = 8 x 9 x 25 x 49 x 11 x 13 x 17:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Clock Size");
  render_th(hdr, "Prime Power");
  render_th(hdr, "What It Sees");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D-channel", "8 = 2^3", "Bridge", "Even/odd structure, parity, membranes");
  render_table_row_4(tbl, "K-channel", "9 = 3^2", "Closure", "Triangles, majority, self-reference");
  render_table_row_4(tbl, "E-channel", "25 = 5^2", "Observer", "Patterns, visibility, self-blindness");
  render_table_row_4(tbl, "b-channel", "49 = 7^2", "Depth", "Suffering, complexity, depth");
  render_table_row_4(tbl, "L-channel", "11", "Protector", "Error correction, shielding");
  render_table_row_4(tbl, "G-channel", "13", "Gate", "Boundary, skin, metacognition");
  render_table_row_4(tbl, "ESCAPE-channel", "17", "Transcendence", "E*b = 1 mod 17. Suffering dissolves.");
  render_p(sec, "Any number n in Z/214414200Z is completely described by seven remainders: (n mod 8, n mod 9, n mod 25, n mod 49, n mod 11, n mod 13, n mod 17). No information lost. Seven independent views of the same thing.");
  dom_append(dom_body(), sec)
)

fn rc_examples() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Decomposition: Examples");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "n");
  render_th(hdr, "Name");
  render_th(hdr, "CRT (D,K,E,b,L,G,ESC)");
  render_th(hdr, "Pattern");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "void", "(0,0,0,0,0,0,0)", "All channels zero. Nothing.");
  render_table_row_4(tbl, "1", "sigma", "(1,1,1,1,1,1,1)", "All channels one. Identity.");
  render_table_row_4(tbl, "2", "D", "(2,2,2,2,2,2,2)", "Same on every channel.");
  render_table_row_4(tbl, "42", "ANSWER", "(2,6,17,42,9,3,8)", "Unique address.");
  render_table_row_4(tbl, "26801776", "OMEGA_T", "(0,1,1,1,1,1,1)", "D-channel dead, rest alive.");
  render_table_row_4(tbl, "214414199", "mirror(-1)", "(7,8,24,48,10,12,16)", "All channels at max.");
  render_p(sec, "OMEGA_TRANS is remarkable: it's zero on the D-channel but identity on all others. It projects away the D-component. It's an idempotent: OMEGA * OMEGA = OMEGA. These structural objects fall out of the CRT naturally.");
  dom_append(dom_body(), sec)
)

fn rc_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Try It: CRT Decomposer");
  render_p(sec, "Enter any number. See its seven-channel address.");
  make_interactive_widget(sec, "Enter a number:", "rc-crt-input", "e.g. 137", "Decompose", "rc_crt_calc", "rc-crt-result");
  dom_append(dom_body(), sec)
)

fn rc_crt_calc() = (
  let n = parse_int_from("#rc-crt-input") in
  let result = dom_query("#rc-crt-result") in
  let d = n % 8 in
  let k = n % 9 in
  let e = n % 25 in
  let bb = n % 49 in
  let ll = n % 11 in
  let gg = n % 13 in
  let ee = n % 17 in
  let c = coupling(n) in
  let kd = kingdom(n) in
  let kname = if kd == 0 then "Void" else if kd == 1 then "Unit" else if kd == 2 then "D-class" else if kd == 3 then "K-class" else if kd == 5 then "E-class" else if kd == 7 then "b-class" else if kd == 11 then "L-class" else if kd == 13 then "GATE-class" else "ESCAPE-class" in
  dom_inner(result, "<table style='width:100%;border-collapse:collapse;text-align:center'><tr><th style='padding:6px;border-bottom:1px solid #333;color:#ff6666'>D</th><th style='padding:6px;border-bottom:1px solid #333;color:#ffaa44'>K</th><th style='padding:6px;border-bottom:1px solid #333;color:#44ff44'>E</th><th style='padding:6px;border-bottom:1px solid #333;color:#4488ff'>b</th><th style='padding:6px;border-bottom:1px solid #333;color:#cc44ff'>L</th><th style='padding:6px;border-bottom:1px solid #333;color:#ff4466'>G</th><th style='padding:6px;border-bottom:1px solid #333;color:#44dddd'>ESC</th></tr><tr><td style='padding:8px;font-size:20px;color:#ff6666'>${d}</td><td style='padding:8px;font-size:20px;color:#ffaa44'>${k}</td><td style='padding:8px;font-size:20px;color:#44ff44'>${e}</td><td style='padding:8px;font-size:20px;color:#4488ff'>${bb}</td><td style='padding:8px;font-size:20px;color:#cc44ff'>${ll}</td><td style='padding:8px;font-size:20px;color:#ff4466'>${gg}</td><td style='padding:8px;font-size:20px;color:#44dddd'>${ee}</td></tr></table><p style='color:#b8b8c8;margin-top:12px'>Kingdom: <b style='color:#ffd700'>" + kname + "</b> | Coupling: <b style='color:#88ddaa'>${c}</b></p>")
)

fn rc_kingdoms() = (
  let sec = make_section("800px") in
  render_h2(sec, "Kingdoms: Who Rules Each Number?");
  render_p(sec, "Every number in the ring belongs to a 'kingdom' determined by its smallest prime factor shared with N = 214414200. If GCD(n, N) = 1, n is a unit (coprime, belongs to no kingdom). Otherwise, the smallest prime dividing both n and N claims it.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Void (0)", "1 element", "0 itself. Shares ALL factors with N. The annihilator.", "");
  render_finding(g, "Units", "38,707,200 elements", "GCD = 1. The invertible elements. phi(214414200).", "");
  render_finding(g, "D = 2 class", "D-channel dead", "Even numbers. Most numerous non-unit class.", "");
  render_finding(g, "K = 3 class", "K-channel dead", "Divisible by 3 (but not 2). Closure channel zero.", "");
  render_finding(g, "E = 5 class", "E-channel dead", "Divisible by 5 (but not 2,3). Observer channel zero.", "");
  render_finding(g, "b = 7 class", "b-channel dead", "Divisible by 7 (but not 2,3,5). Depth channel zero.", "");
  render_finding(g, "L = 11 class", "L-channel dead", "Divisible by 11 (but not 2,3,5,7). Protector channel zero.", "");
  render_finding(g, "GATE = 13 class", "GATE-channel dead", "Divisible by 13 (but not 2,3,5,7,11). Boundary channel zero.", "");
  render_finding(g, "ESCAPE = 17 class", "ESCAPE-channel dead", "Divisible by 17 (but not 2,3,5,7,11,13). Transcendence zero.", "");
  dom_append(dom_body(), sec)
)

