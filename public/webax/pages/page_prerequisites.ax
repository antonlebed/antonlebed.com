  render_finding(g, "Eigenvalues", "Waves & Shadows", "Vibration, coupling, OMEGA. The dynamics.", "");
  render_p(sec, "Start exploring. Every page builds on these three ideas. The Worldview page tells the full story. The Derive page shows the chain from 0/0 to all of this. The interactive widgets on every page let you verify every claim yourself.");
  let link = dom_create("a") in
