  make_interactive_widget(sec6, "Control signal:", "pid-input", "e.g. 42", "Decompose", "pid_multiscale_calc", "pid-result");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "Fault tolerance", "Kill any channel", "System degrades gracefully. Traditional PID: single failure = total failure.", "");
  render_finding(g6, "L=11 integrity", "Actuator check", "Corruption in any channel detected BEFORE actuation. ~90.9% detection rate per fault.", "");
  render_finding(g6, "Multi-scale", "5 resolutions at once", "Coarse + fine in one signal. Z/8 for emergency, Z/49 for precision. Natural hierarchy.", "");
  render_finding(g6, "Block-diagonal", "No cross-talk", "5 independent Jacobians. Each channel tunes without affecting others.", "");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Is Your Exponent 11-Smooth?");
  render_p(sec_i, "Enter numerator and denominator of a power-law exponent. Check if it factors entirely over {2,3,5,7,11}.");
  let lbl_i = dom_create("p") in
  dom_text(lbl_i, "Numerator / Denominator:");
  dom_style(lbl_i, "color", "#b8b8c8");
  dom_style(lbl_i, "marginTop", "24px");
  dom_style(lbl_i, "marginBottom", "8px");
  dom_append(sec_i, lbl_i);
  let row_i = dom_create("div") in
  dom_style(row_i, "display", "flex");
  dom_style(row_i, "gap", "8px");
  dom_style(row_i, "alignItems", "center");
  dom_style(row_i, "marginBottom", "12px");
  make_input_field(row_i, "#scale-num-input", "num (e.g. 7)");
  make_input_field(row_i, "#scale-den-input", "den (e.g. 4)");
  make_action_btn(row_i, "Check", "scaling_smooth_calc");
  dom_append(sec_i, row_i);
  make_result_box(sec_i, "scale-result");
  dom_append(dom_body(), sec_i);

  /* === SEC: SHADOW FRACTION PRODUCT (Theorem 50, S1201/S1495) === */
  let sec_sf = make_section("800px") in
  render_h2(sec_sf, "Shadow Fraction Product (Theorem 50)");
  render_p(sec_sf, "For each axiom prime p, the shadow fraction (p-1)/(p+1) measures the element's scaling attenuation. For the DATA primes {D=2, K=3, E=5, b=7}, these fractions are exactly the four most common power-law exponents in physics: 1/3 (diffusion), 1/2 (random walk), 2/3 (Kolmogorov S_2), 3/4 (Kleiber metabolic). For the EXTENSION primes {L=11, GATE=13, ESCAPE=17}, the fractions 5/6, 6/7, 8/9 match no known physical scaling law.");
  render_theorem(sec_sf, "Shadow Fraction Product (Theorem 50, S1201/S1495, OBSERVED)", "Product of (p-1)/(p+1) across all 7 axiom primes = 10/189 = D*E / (K^3 * b). Numerator = Decality = D*E = 10. Denominator = K^3 * b = 189. Cunningham reduction: for odd p = 2q-1, the fraction reduces to (q-1)/q where q runs through {D, K, D^2, DK, b, K^2}. The DATA primes match scaling laws. The EXTENSION primes do not. The 490 split separates physics from pure algebra.");
  render_p(sec_sf, "Enter a prime. See its shadow fraction and scaling match:");
  make_interactive_widget(sec_sf, "Prime (2-100):", "shadow-frac-input", "e.g. 7", "Shadow Fraction", "scaling_shadow_frac", "shadow-frac-result");
  let sf_tbl = dom_create("table") in
  dom_style(sf_tbl, "width", "100%");
  dom_style(sf_tbl, "maxWidth", "700px");
  dom_style(sf_tbl, "margin", "24px auto");
  dom_style(sf_tbl, "borderCollapse", "collapse");
  let sf_hdr = dom_create("tr") in
  render_th(sf_hdr, "Prime");
  render_th(sf_hdr, "(p-1)/(p+1)");
  render_th(sf_hdr, "490 Split");
  render_th(sf_hdr, "Scaling Match");
  dom_append(sf_tbl, sf_hdr);
  render_table_row_4(sf_tbl, "D = 2", "1/3", "DATA (inner)", "Diffusion exponent");
  render_table_row_4(sf_tbl, "K = 3", "1/2", "DATA (inner)", "Random walk");
  render_table_row_4(sf_tbl, "E = 5", "2/3", "DATA (inner)", "Kolmogorov S_2");
  render_table_row_4(sf_tbl, "b = 7", "3/4", "DATA (inner)", "Kleiber metabolic");
  render_table_row_4(sf_tbl, "L = 11", "5/6", "EXTENSION", "No match");
  render_table_row_4(sf_tbl, "GATE = 13", "6/7", "EXTENSION", "No match");
  render_table_row_4(sf_tbl, "ESCAPE = 17", "8/9", "EXTENSION", "No match");
  dom_append(sec_sf, sf_tbl);
  let gsf = make_findings_grid(sec_sf) in
  render_finding(gsf, "Product = 10/189", "D*E / (K^3 * b)", "Numerator = Decality. Denominator = closure-cubed times depth.", "");
  render_finding(gsf, "DATA: 4/4 match", "1/3, 1/2, 2/3, 3/4", "All four DATA primes produce known scaling exponents.", "");
  render_finding(gsf, "EXTENSION: 0/3 match", "5/6, 6/7, 8/9", "No known physical scaling association for any extension prime.", "");
  render_finding(gsf, "490 split", "DATA vs EXTENSION", "The holographic partition separates physics from pure algebra.", "");
  render_contrast_row(sec_sf, "Physical scaling", "Empirical power laws, many unexplained exponents", "CRT: (p-1)/(p+1) for DATA primes = the 4 most common exponents");
  render_contrast_row(sec_sf, "Extension primes", "No role in physical scaling laws", "ECC/protection role: L detects, GATE bounds, ESCAPE transcends");
  render_contrast_row(sec_sf, "490 split", "Physics and algebra as separate disciplines", "One partition: inner channels = physics, boundary = structure");
  let note_sf = dom_create("div") in
  dom_style(note_sf, "background", "#1a1a0a");
  dom_style(note_sf, "border", "1px solid #665500");
  dom_style(note_sf, "borderRadius", "8px");
  dom_style(note_sf, "padding", "12px 16px");
  dom_style(note_sf, "marginTop", "12px");
  dom_style(note_sf, "fontSize", "14px");
  dom_style(note_sf, "color", "#ccbb88");
  dom_inner(note_sf, "HONEST NOTE: Each individual match (1/3, 1/2, etc.) has a base rate around 23% for random primes. The claim is not that any single match is surprising, but that ALL FOUR DATA primes match known scaling laws while ALL THREE EXTENSION primes do not. The 490 split (DATA vs EXTENSION) as a boundary between physical scaling and algebraic structure is OBSERVED, not proved.");
  dom_append(sec_sf, note_sf);
  dom_append(dom_body(), sec_sf);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "What Others See");
  render_contrast_row(sec7, "Power laws", "Empirical fits with unexplained exponents", "91.7% factor over {2,3,5,7,11}. p = 0.0096. Shadow chain = spectral ruler.");
  render_contrast_row(sec7, "Ising model", "Exact solution, no connection to number theory", "All 5 exponents are axiom ratios. gamma = b/D^2 derives b=7 from D^3-1.");
  render_contrast_row(sec7, "Kolmogorov", "-5/3 is an empirical turbulence law", "-E/K. Derived from Z/210Z Laplacian quotient ratio. Not empirical.");
  render_contrast_row(sec7, "Kleiber", "3/4 metabolic scaling is approximate", "K/D^2. Spectral gap of sigma. 0.4% agreement across 27 orders of magnitude.");
  render_contrast_row(sec7, "Dimensional solvability", "3D Ising unsolved, no structural reason known", "d=K=3 decomposes solvability. Irrational exponents at the closure dimension.");
  render_contrast_row(sec7, "Control systems", "Standard PID: 1 controller, 1 resolution, 0 fault tolerance", "CRT PID: 6 independent channels, multi-scale, algebraic fault tolerance. L=11 + GATE=13 = dual integrity.");
  dom_append(dom_body(), sec7)
)

/* ================================================================
   PAGE: CC0 -- The Manifesto (CC0_MANIFESTO.md)
   ================================================================ */

fn page_cc0() = (
  dom_head_meta("description", "One equation: 12612600. CC0 demos across GPU, mesh, AI, ECC, compression, and more. No paywall. No copyright. No exceptions.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CC0 Strategy\",\"description\":\"CC0 preemptive strike via CRT decomposition. One equation, zero dollars. All permanently public domain.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/living/cc0\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CC0\"},{\"@type\":\"DefinedTerm\",\"name\":\"patent prior art\"},{\"@type\":\"DefinedTerm\",\"name\":\"public domain\"}]}");
  let hero = make_hero("CC0") in
  let eq = dom_create("div") in
  dom_text(eq, "One equation. Zero dollars.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "28px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "12612600 = 2^3 * 3^2 * 5^2 * 7^2 * 11 * 13. Six independent CRT channels. From this single fact: a language, a library, a website, theorems, hardware, and an AI benchmark solver. All CC0. All free. Forever. Every demo deployed is a domain permanently freed from patent enclosure.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE WEAPON === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Strategy");
  render_theorem(sec1, "CC0 Preemptive Strike", "Identify a heavily-patented domain where CRT gives a structural advantage. Build a minimal working prototype. Deploy to antonlebed.com under CC0 (Creative Commons Zero -- No Rights Reserved). The moment it is public, it becomes irrevocable prior art. No one can ever patent it. The antidote to enclosure is disclosure.");
  render_p(sec1, "The obscurity of the math is an advantage. While they do not understand the axiom, we plant flags across every domain where it works. By the time they figure out CRT decomposition, every application is already CC0 public domain. Every deploy is a trigger pull. Every page is a territorial claim.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: WHAT WE BUILT === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "What We Built from One Number");
  let g = make_findings_grid(sec2) in
  render_finding(g, "The Language", ".ax (3 ops)", "meet(*), complement(~), add(+). Self-compiling. Parser, codegen, evaluator all in .ax. WASM pipeline. CC0.", "");
  render_finding(g, "The Library", "crt.h (832L, 0 deps)", "Runs on ESP32 ($4), in browsers (WASM), on any C compiler. 7-channel CRT decompose, reconstruct, eigenvalues, ECC3, round-trip calibration. CC0.", "");
  render_finding(g, "The Website", ".ax pages", "site.wasm = pure .ax compiled to WASM. No server. No framework. No tracking. The source IS the site. CC0.", "");
  render_finding(g, "The Math", "proved theorems", "Falsifications published. Running code behind every claim. Tested, not asserted. CC0.", "");
  render_finding(g, "The Hardware", "3 ESP32 boards", "CRT-encoded packets over WiFi. Coupling = routing. L=11 = error correction. No IP addresses. CC0.", "");
  render_finding(g, "The AI", "ARC-AGI solver", "Pure .ax. Zero dollars. 32 primitives + depth-2 composition. 6 independent views per puzzle. CC0.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: DEMOS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Demos");
  render_p(sec3, "GPU compute, mesh networking, AI training, error correction, compression, audio, image processing, cryptography, scheduling, and more. Each demo is an interactive proof that CRT decomposition makes patents obsolete in that domain.");
  render_cta_button(sec3, "/demos", "View All Demos \u2192");
  dom_append(dom_body(), sec3);

  /* === SEC 4: THE WEAPON === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Weapon");
  render_theorem(sec4, "Prior Art Through Radical Openness", "You cannot patent what has already been published as CC0. Creative Commons Zero is irrevocable. Once deployed, the knowledge is free forever. No takebacks. No licensing. No exceptions. The best defense against enclosure is to give everything away, permanently.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Victims", "NVIDIA, Qualcomm, Meta, Oracle, Siemens, Adobe, Intel", "Every patent troll in these domains is now racing against prior art that already exists.", "");
  render_finding(g4, "Cost", "$0", "One man, one ring, one website. No investors, no grants, no IP lawyers.", "");
  render_finding(g4, "Timeline", "CC0 demos deployed", "Speed > perfection. Width > depth. Ship the prototype, poison the pool.", "");
  render_finding(g4, "Permanence", "Irrevocable", "CC0 means no rights reserved. Not open source (which has conditions). Zero. Nothing. Forever.", "");
  dom_append(dom_body(), sec4);

  /* === CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "What Others See");
  render_contrast_row(sec5, "IP strategy", "Patent everything, license to fund R&D", "Publish everything CC0. Prior art prevents enclosure. Knowledge wants to be free.");
  render_contrast_row(sec5, "Scope", "One patent per invention", "One equation, many domains. CRT decomposition is unreasonably general.");
  render_contrast_row(sec5, "Cost to attack", "Millions in legal fees", "$0. A ring and a website. The asymmetry is the weapon.");
  render_contrast_row(sec5, "Defense", "Defensive patent portfolio", "No portfolio needed. CC0 IS the defense. You cannot claim what is already public.");
  render_contrast_row(sec5, "Permanence", "Patents expire in 20 years", "CC0 is immediate and forever. The knowledge is free the instant it deploys.");
  dom_append(dom_body(), sec5)
)

/* ================================================================
   PAGE: REVOLUTION -- .ax Language Vision (AX_REVOLUTION.md)
   ================================================================ */

fn page_revolution() = (
  dom_head_meta("description", "What should .ax be? CRT IS the type, not DFloat. Every value IS its CRT decomposition. 10 terms, 108 = D^2*K^3 rings share lambda=420 exactly (84 divide TRUE; 24 are D^4 extensions), 7 principles. The Decality IS the instruction set. Rings AS types. L=11 runtime guardian. The language EMBODIES the axiom.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The .ax Revolution\",\"description\":\"CRT IS the type. Every value IS its CRT decomposition. 10 terms, 108 = D^2*K^3 lambda-420 rings (84 divide TRUE; 24 are D^4 extensions), 7 principles. The Decality IS the instruction set. L=11 runtime guardian.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/living/revolution\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\".ax language\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT types\"},{\"@type\":\"DefinedTerm\",\"name\":\"self-hosting compiler\"}]}");
  let hero = make_hero("The Revolution") in
  let eq = dom_create("div") in
  dom_text(eq, ".ax IS the axiom, not just uses it");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, ".ax was born in the era of 3 terms. DFloat(s|b|a) was the fundamental type -- never implemented. CRT was a builtin you called. Now we know: 10 terms, 108 = D^2*K^3 rings share lambda=420 exactly (84 divide TRUE; 24 are D^4 extensions), 6 channels. The language should THINK in channels, not translate to them. CRT IS the type. The Decality IS the instruction set. This document: the blueprint for .ax v2.0.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE DIAGNOSIS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Diagnosis");
  render_p(sec1, "What we knew when .ax was designed: 3 terms (sigma, D, K). What we know now: 10 terms, 6 CRT channels {8,9,25,49,11,13}, 108 = D^2*K^3 rings share lambda=420 exactly (84 divide TRUE; 24 are D^4 extensions), L=11 free ECC, emergence from 3 ops. The gap: .ax USES the axiom. It does not EMBODY it.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "Old", "Values are plain numbers", "CRT is a function you call. Channels are hidden. Ring is global.", "");
  render_finding(g1, "New", "Values ARE their CRT decomposition", "42 = (2, 6, 17, 42, 9, 3). Channel access is O(1). Parallel by nature.", "");
  render_finding(g1, "Old", "62 builtins accumulated organically", "Library calls, not the language's nature. Bolted on.", "");
  render_finding(g1, "New", "10 Decality keywords = the instruction set", "Each is BOTH a value AND an operation. The vocabulary IS the axiom.", "");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CRT IS THE TYPE === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Principle 1: CRT IS the Type");
  render_theorem(sec2, "Every Value IS Decomposed", "42 in .ax v2.0: displays as 42, stores as (2, 6, 17, 42, 9, 3) in TRUE. Access channels directly: 42.D = 2, 42.K = 6, 42.E = 17, 42.b = 42, 42.L = 9, 42.G = 3. Arithmetic happens per channel automatically: 42 + 137 computes (2+1)%8, (6+2)%9, (17+12)%25, (42+39)%49, (9+5)%11, (3+7)%13 = 179. This IS the Loop Theorem. This IS the Backprop Theorem. This IS the axiom, embodied in data representation.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: DECALITY VOCABULARY === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Principle 2: The Decality IS the Vocabulary");
  render_p(sec3, "10 keywords. Each is BOTH a value AND an operation:");

  let dtbl = dom_create("table") in
  dom_style(dtbl, "width", "100%");
  dom_style(dtbl, "maxWidth", "750px");
  dom_style(dtbl, "margin", "24px auto");
  dom_style(dtbl, "borderCollapse", "collapse");
  let dhdr = dom_create("tr") in
  render_th(dhdr, "Term");
  render_th(dhdr, "Value");
  render_th(dhdr, "As Operation");
  render_th(dhdr, "CRT Signature");
  dom_append(dtbl, dhdr);
  render_table_row_4(dtbl, "mirror", "-1", "Reflect: N - x", "(7, 8, 24, 48, 10, 12)");
  render_table_row_4(dtbl, "o", "0", "Absorb: 0", "(0, 0, 0, 0, 0, 0)");
  render_table_row_4(dtbl, "sigma", "1", "Preserve: x", "(1, 1, 1, 1, 1, 1)");
  render_table_row_4(dtbl, "D", "2", "Split in two", "(2, 2, 2, 2, 2, 2)");
  render_table_row_4(dtbl, "K", "3", "Close / compose", "(3, 3, 3, 3, 3, 3)");
  render_table_row_4(dtbl, "E", "5", "Observe (self-blind)", "(5, 5, 5, 5, 5, 5)");
  render_table_row_4(dtbl, "b", "7", "Depth / iterate", "(7, 7, 7, 7, 7, 7)");
  render_table_row_4(dtbl, "L", "11", "Protect / ECC verify", "(3, 2, 11, 11, 0, 11)");
  render_table_row_4(dtbl, "GATE", "13", "Boundary / type check", "(5, 4, 13, 13, 2, 0)");
  render_table_row_4(dtbl, "OMEGA", "1576576", "Terminal / project / halt", "(0, 1, 1, 1, 1, 1)");
  dom_append(sec3, dtbl);
  render_p(sec3, "Notice: elements 0-7 have CRT = (n,n,n,n,n,n) -- they are IDENTICAL across all 6 channels. L=11 is the first to break this: (3,2,11,11,0,11). The protector is the first element that looks DIFFERENT from different angles. OMEGA has D-channel dead: (0,1,1,1,1,1). The terminal projection kills duality.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: RINGS AS TYPES === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Principle 3: Rings AS Types");
  render_theorem(sec4, "The Lambda-420 Lattice IS the Type Hierarchy", "The 108-ring D^2*K^3 lambda-420 lattice (all hit lambda=420 exactly; 84 divide TRUE, 24 are D^4 extensions) IS the type hierarchy. Every value carries its ring. let x: Z210 = 42 -- x lives in DATA ring. let y: TRUE = 42 -- y lives in TRUE FORM. Lifting (fattening) adds channels. Projection (thinning) removes them. Type checking = ring membership. Z/210 has 4 channels {D,K,E,b}. Z/970200 (DEEP) has 5. Z/12612600 (TRUE) has 6. Subtyping = subring embedding. TRUE is the universal type.");

  let ttbl = dom_create("table") in
  dom_style(ttbl, "width", "100%");
  dom_style(ttbl, "maxWidth", "750px");
  dom_style(ttbl, "margin", "24px auto");
  dom_style(ttbl, "borderCollapse", "collapse");
  let thdr = dom_create("tr") in
  render_th(thdr, "Ring");
  render_th(thdr, "Channels");
  render_th(thdr, "Domain");
  dom_append(ttbl, thdr);
  render_table_row(ttbl, "Z/6 = D*K", "{D, K}", "Clock, basic modular");
  render_table_row(ttbl, "Z/210 = DATA", "{D, K, E, b}", "Biology, DNA, body");
  render_table_row(ttbl, "Z/2310 = THIN", "{D, K, E, b, L}", "Full axiom, thin channels");
  render_table_row(ttbl, "Z/970200 = DEEP", "{D^3, K^2, E^2, b^2, L}", "Body without skin, fat channels");
  render_table_row(ttbl, "Z/12612600 = TRUE", "{D^3, K^2, E^2, b^2, L, GATE}", "The organism, 6 channels, universal type");
  render_table_row(ttbl, "Z/214414200 = TRANS", "{D^3, K^2, E^2, b^2, L, GATE, ESCAPE}", "Transcendence, 7 channels, final form");
  dom_append(sec4, ttbl);
  dom_append(dom_body(), sec4);

  /* === SEC 5: REMAINING PRINCIPLES === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Four More Principles");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "4. L=11 Runtime Guardian", "Automatic ECC", "Every computation checked by L channel. Corruption detected at runtime. Free. No programmer effort.", "");
  render_finding(g5, "5. 3 Ops -> Everything", "meet(*), complement(~), add(+)", "Arrays, strings, functions, closures, neural nets -- all emerge from K=3 operations. LIFE=7 proved.", "");
  render_finding(g5, "6. K^2=9 Parallelism", "3 hearts x 3 stages", "The compiler has K^2=9 analysis passes. FPGA: K^2 pipeline units. The code IS the hardware description.", "");
  render_finding(g5, "7. Lambda-420 Heartbeat", "Universal rhythm", "Every ring shares lambda=420. Every computation has a heartbeat. The ring breathes.", "");
  dom_append(dom_body(), sec5);

  /* === SEC 6: THE STRANGE LOOP === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "The Strange Loop");
  render_p(sec6, ".ax ships -> proves axiom -> IS the entity -> writes .ax -> .ax ships. The website IS the proof. The language IS the math. The compiler IS the theorem. Each pass through the loop: tighter, more capable, fewer pieces.");
  render_theorem(sec6, "Ship of Theseus", "The old website: 154 hand-crafted HTML pages, 58,641 lines. The new website: 7 module WASMs compiled from .ax. 180 pages, pure .ax. No HTML authored. .ax builds pages directly via WASM DOM imports. The old ship was dismantled plank by plank. The new ship is the same ship -- but every plank is now math.");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: CRT IS the Type");
  render_p(sec_i, "Enter any number. See it as .ax v2.0 would: a CRT 6-tuple with per-channel access. In the future, this IS how .ax thinks.");
  make_interactive_widget(sec_i, "Value:", "rev-input", "e.g. 42", "Decompose", "revolution_crt_calc", "rev-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "What Others See");
  render_contrast_row(sec7, "Types", "Integers, floats, strings, structs, classes", "One type: ring element. CRT decomposition IS the type. Lambda-420 lattice (108 D^2*K^3 rings; 84 divide TRUE) = type hierarchy.");
  render_contrast_row(sec7, "Operations", "Hundreds of operators and methods", "Three: meet, complement, add. Everything else emerges.");
  render_contrast_row(sec7, "Error handling", "Try/catch, Result types, panic", "L=11 automatic ECC. Corruption detected by the algebra, not the programmer.");
  render_contrast_row(sec7, "Parallelism", "Threads, locks, async/await", "K^2=9 natural parallelism. CRT channels compute independently. No synchronization.");
  render_contrast_row(sec7, "Self-hosting", "Engineering milestone, clever", "The ouroboros. sigma/sigma = sigma. The compiler divided by itself produces itself.");
  dom_append(dom_body(), sec7)
)

/* REPL callback: .ax evaluates .ax via ax_eval_capture (evaluator.ax).
   No JS. No recompilation. The ouroboros eats its tail. */
fn run_repl() = (
  let ta = dom_query("#repl-code") in
  let code = dom_value(ta) in
  let result = dom_query("#repl-result") in
  let output = ax_eval_capture(code) in
  dom_inner(result, output)
)

fn page_ouroboros_compiler() = (
  dom_head_meta("description", "The self-hosted compiler. .ax compiles itself to WASM. From v0.1 (integers only) to self-compilation: the ouroboros closes. K=3 type system. 67x native speedup. The compiler IS the strange loop.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Ouroboros Compiler\",\"description\":\"Self-hosted .ax compiler. .ax compiles itself to WASM. K=3 type system, K^2=9 analysis passes. 67x native speedup. The compiler IS the strange loop.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/living/ouroboros_compiler\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"self-hosting compiler\"},{\"@type\":\"DefinedTerm\",\"name\":\"WASM\"},{\"@type\":\"DefinedTerm\",\"name\":\"ouroboros\"}]}");
  domain_hero("The Ouroboros Compiler", ".ax compiles .ax to WASM", "The snake eats its own tail. The compiler compiles itself.");
  let sec = make_section("800px") in
  render_h2(sec, "Timeline");
  let g = make_findings_grid(sec) in
  render_finding(g, "v0.1", "Integers only", "S825: first WASM bytecode from .ax.", "");
  render_finding(g, "v0.2-0.4", "+ Arrays, strings, closures", "Type inference. Match -> if-else. HOF.", "");
  render_finding(g, "v0.5-0.7", "+ Multi-file, stdlib", "Fixed-point type propagation. 16 stdlib.", "");
  render_finding(g, "v0.8", "+ AxVal tagged union", "K=3 tags: int/str/arr. Heterogeneous.", "");
  render_finding(g, "v0.9", "Self-compilation", "wasm_emit.ax compiles itself: 0 errors.", "");
  render_finding(g, "Deep ouroboros", "WASM compiles WASM", "234KB WASI / 227KB browser. Fixed-point verified.", "");
  render_finding_wide(g, "DOM imports", "7 modules", ".ax talks to browser directly. This page rendered by .ax.", "");
  render_finding(g, "dom_on + dom_value", "Interactive .ax", "S966-S967: buttons, inputs, CRT calculator.", "");
  render_finding(g, "Top-level warning", "Split safety", "S968: compiler catches orphaned fn bodies.", "");
  dom_append(dom_body(), sec);
  let sec2 = make_section("800px") in
  render_h2(sec2, "K = 3 Type System");
  render_theorem(sec2, "Three Types, K x K Passes", "The type system has K = 3 fundamental tags: int, str, arr. The compiler needs K^2 = 9 analysis passes to infer all types. K^2 = K hearts x K sub-stages: three hearts (detect, propagate, close) each with three scopes (local, cross-function, global). K=3 minimum closure applied at two scales simultaneously. Both compilers and an FPGA pipeline independently converge on this structure. The code IS the hardware.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "K^2=9 passes", "3 hearts x 3 stages", "Feature scan + float inference + string inference. Same structure as FPGA pipeline.", "S945");
  render_finding(g2, "Native speed", "67x faster", "Compiled .ax vs interpreted .ax.", "");
  render_finding(g2, "WASM size", "~234 KB", "deep_ouroboros: compiler in a browser. Fixed-point verified.", "");
  render_finding(g2, "Test gate", "136/136 + 170/170 + 687/687", "test_self + test_pages + test_interactive. Zero regression.", "");
  render_finding(g2, "7 modules", "~15,563 KB total", "home + deep + structure + teach + data + living + demos. Site modularized S1223.", "");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Self-Compilation Loop");
  render_p(sec3, ".ax source -> _wasi_ouroboros.wasm -> WASM bytecode. The WASI compiler reads .ax, tokenizes, parses, and emits WASM. It is itself the output of compiling .ax.");
  render_theorem(sec3, "What Self-Compilation Means", "A self-compiling language understands itself well enough to reproduce itself. The .ax source code describes how to translate .ax into WASM. When that description is itself valid .ax, and the resulting binary does the same translation correctly, the loop closes. This is structurally identical to 0/0 = sigma: the void divided by itself produces the ground state. The compiler divided by itself produces itself. sigma/sigma = sigma.");
  render_theorem(sec3, "Cross-Observation (D = 2)", "The browser-compiled output (deep_ouroboros) and the WASI-compiled output (_wasi_ouroboros) are identical. Two views, same result. The gate opens. Cross-observation confirms the ouroboros is real, not an illusion.");
  dom_append(dom_body(), sec3);
  let sec4 = make_section("800px") in
  render_h2(sec4, "Performance");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "600px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "Benchmark");
  render_th(bhdr, "Native");
  render_th(bhdr, "Interpreted");
  render_th(bhdr, "Speedup");
  dom_append(btbl, bhdr);
  render_table_row_4(btbl, "90K ring ops", "20ms", "1350ms", "67x");
  render_table_row_4(btbl, "DEEP ring scan (970200)", "93ms", "~6200ms", "67x");
  render_table_row_4(btbl, "Website compile (180 pages)", "138ms", ">970K limit", "native only");
  dom_append(sec4, btbl);
  dom_append(dom_body(), sec4);
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Bootstrap Story");
  render_p(sec5, "Most languages are written in other languages. C was written in assembly. Python in C. JavaScript in C++. .ax broke this loop.");
  render_p(sec5, "It started with a JavaScript bootstrap (axc.js, 3860 lines), then grew enough capability to describe its own compilation process (wasm_emit.ax), then compiled that description into a native WASM binary (_wasi_ouroboros.wasm, ~234KB) that does the same thing. The JS bootstrap was discarded (S1164). The C-codegen intermediate (deep_codegen.wasm, S1044) was archived too. The language stands on its own ground.");
  render_p(sec5, "28 sessions of careful cultivation. One version at a time. The bare minimum substrate that can reproduce itself. And it only needed K = 3 types to do it.");
  dom_append(dom_body(), sec5);
  let sec6 = make_section("800px") in
  render_h2(sec6, "What Others See");
  render_p(sec6, "Standard view: Self-hosting compilers are an engineering milestone. Clever but not profound.");
  render_p(sec6, "Axiom view: .ax compiling .ax is the ouroboros -- the tail eating itself. K=3 types need K^2=9 analysis passes. K^2 = K x K: three hearts (detect/propagate/close) times three scopes (local/cross/global). An FPGA ring processor has the same K^2=9 pipeline stages. Three independent systems converge because all three are CRT systems applying K=3 minimum closure at two scales. The compiler IS the hardware description (S946).");
  dom_append(dom_body(), sec6);
  let repl_sec = make_section("800px") in
  render_h2(repl_sec, "Try .ax");
  render_p(repl_sec, "Write .ax code below. Use show to display values. Ring arithmetic is automatic: all numbers live in Z/12612600Z (TRUE ring, 6 channels). Decality constants (D, K, E, b, L, OMEGA, etc.) and utility functions (gcd, decompose, reconstruct) are pre-loaded.");
  let ta = dom_create("textarea") in
  dom_attr(ta, "id", "repl-code");
  dom_style(ta, "width", "100%");
  dom_style(ta, "minHeight", "120px");
  dom_style(ta, "background", "#0a0a14");
  dom_style(ta, "color", "#ffd700");
  dom_style(ta, "border", "1px solid #333");
  dom_style(ta, "borderRadius", "6px");
  dom_style(ta, "padding", "12px");
  dom_style(ta, "fontFamily", "'Courier New', monospace");
  dom_style(ta, "fontSize", "14px");
  dom_style(ta, "resize", "vertical");
  dom_style(ta, "boxSizing", "border-box");
  dom_text(ta, "show D * K * E * b * L\nshow \"CRT of ANSWER:\"\nshow crt(ANSWER)\nshow \"coupling(42):\"\nshow coupling(42)");
  dom_append(repl_sec, ta);
  let btn_row = dom_create("div") in
  dom_style(btn_row, "marginTop", "8px");
  dom_style(btn_row, "marginBottom", "12px");
  make_action_btn(btn_row, "Run", "run_repl");
  dom_append(repl_sec, btn_row);
  make_result_box(repl_sec, "repl-result");
  dom_append(dom_body(), repl_sec);
  let nav_sec = make_section("800px") in
  render_h2(nav_sec, "Continue the Thread");
  render_explore_link(nav_sec, "/demos/ax_games", "Axiom Arcade", "6 games at 60fps in pure .ax");
  render_explore_link(nav_sec, "/living/emergence", "Emergence", "AND/XOR/MAJ produce Life=7");
  render_explore_link(nav_sec, "/living/revolution", ".ax Revolution", "Ship of Theseus: .ax replaces everything");
  render_explore_link(nav_sec, "/deep/bootstrap", "Bootstrap", "sigma/sigma = sigma uniqueness");
  dom_append(dom_body(), nav_sec)
)

