  render_table_row_4(rtbl, "Z/970200 = DEEP", "Deep", "5 fat", "48750 classes. Sits inside the 108-ring lambda=420 lattice (84 = D^2*K*b divide TRUE; 24 = D^4 extensions reach 2*TRUE). phi = 201600. Body without skin.");
  render_table_row_4(rtbl, "Z/12612600 = TRUE", "Living", "6", "341250 classes. TRUE = DEEP*GATE (GATE adds skin). THE ring.");
  dom_append(sec3, rtbl);
