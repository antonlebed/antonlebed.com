/* page_ring_substrate.ax -- Phase F: Ring as Computation Substrate (S1915).
   First test of ring arithmetic as the sole computation mechanism.
   Ring-attention (channel matching) + ring-FFN (per-channel multiplication).
   Evolutionary per-channel search. Axiom vs random coprimes. */

fn page_ring_substrate() = (
  let hero = make_section("800px") in
  render_h2(hero, "Ring Substrate");
  render_p(hero, "Phase F asks: can ring arithmetic serve as the SOLE computation substrate? Not CRT decomposing a neural network (Phase B). Not CRT as a technique (Phase E). The ring IS the latent space. Every intermediate value is a ring element. Every operation is ring arithmetic. Zero floats.");
  render_p(hero, "This page reports the first Ring Substrate experiment: context-dependent function learning with 4 ring multiplications, evolutionary per-channel search, and axiom vs random coprime control.");
  dom_append(dom_body(), hero);

  -- Architecture
  let sec1 = make_section("800px") in
  render_h2(sec1, "Architecture");
  render_p(sec1, "All computation is ring arithmetic. No floats, no dot-product attention, no dense FFN. The ring's structure IS the machine.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "ATTEND", "Channel matching", "coupling(context, prototype) = count of channels where ctx%q == proto%q. Replaces dot-product attention.", "S1915");
  render_finding(g1, "TRANSFORM", "Ring multiplication", "output_ch = (input_ch * weight_ch) % q_ch. Per-channel independence = block-diagonal for free.", "S1915");
  render_finding(g1, "SELECT", "Argmax", "Pick prototype with highest channel match. Route to corresponding weight.", "S1915");
  render_finding(g1, "LEARN", "Per-channel evolution", "Mutate one channel of one parameter. Accept if ch_score improves. 200 generations x 56 trials.", "S1915");
  dom_append(dom_body(), sec1);

  -- Results
  let sec2 = make_section("800px") in
  render_h2(sec2, "Results");
  render_p(sec2, "4 functions (ring multiplications by known weights). 160 train, 40 test. Context signals with noise=50. ch_score = per-channel hit count (max 1120 train, 280 test).");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Axiom ch_score", "839/1120 (74.9%)", "From 271 initial (24.2%). Learns. 200 gen converge.", "S1915");
  render_finding(g2, "Random ch_score", "854/1120 (76.3%)", "From 247 initial (22.1%). Also learns. Slightly higher.", "S1915");
  render_finding(g2, "Axiom exact", "98/160 (61.3%)", "All 7 channels correct simultaneously. Beats random.", "S1915");
  render_finding(g2, "Random exact", "77/160 (48.1%)", "Axiom exact +27%. Axiom errors are coherent, not scattered.", "S1915");
  render_finding(g2, "Axiom test exact", "16/40 (40%)", "Generalizes. Random test exact: 9/40 (22.5%). Axiom 1.8x.", "S1915");
  render_finding(g2, "Attention", "52/160 axiom, 61/160 random", "32.5% vs 38.1%. Both well above 25% random baseline.", "S1915");
  dom_append(dom_body(), sec2);

  -- 490 Split
  let sec3 = make_section("800px") in
  render_h2(sec3, "490 Split Emerges");
  render_p(sec3, "The model discovers the 490 split without being told. ALIVE channels (K,L,GATE) dominate attention. DEAD channels (D,E,b) are weaker discriminators. The split is: ALIVE = strategy/selection, DEAD = data/perception.");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "ALIVE={K,L,GATE}", "53 unique discriminations", "Strategy channels. K(9)=28, G(13)=18, L(11)=7. K dominates.", "S1915");
  render_finding(g3, "DEAD={D,E,b}", "32 unique discriminations", "Data channels. D(8)=16, E(25)=12, b(49)=4. Larger channels harder to optimize.", "S1915");
  render_finding(g3, "ESCAPE", "8 unique discriminations", "Transcendence channel: between ALIVE and DEAD.", "S1915");
  render_finding(g3, "490 ratio", "ALIVE/DEAD = 1.66x", "Strategy channels 66% more discriminating than data channels for attention.", "S1915");
  dom_append(dom_body(), sec3);

  -- Interpretation
  let sec4 = make_section("800px") in
  render_h2(sec4, "Interpretation");
  render_p(sec4, "Ring substrate learning is VIABLE. All computation was ring arithmetic: integer modular operations for attention, multiplication for FFN, greedy per-channel search for learning. The paradigm works.");
  render_p(sec4, "The axiom ring does not strongly outperform random coprimes on per-channel accuracy (-1.3% ch_score). But it has 27% better exact match: when the axiom ring is right, it is right everywhere; when wrong, wrong everywhere. This coherence is a structural property of the axiom's specific channel sizes and their algebraic relationships.");
  render_p(sec4, "The 490 split emerging in attention is the key finding. The model discovered that ALIVE (smaller, boundary) channels are better for routing, while DEAD (larger, data) channels carry information. This is exactly what the axiom predicts. Not designed, DISCOVERED.");
  dom_append(dom_body(), sec4);

  0
)
