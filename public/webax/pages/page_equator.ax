/* page_equator.ax -- The Equator: Midpoint Eigenvalue Theorem.
   N/2 has CRT=(2^(a-1), 0, 0, ..., 0). Mod 2: 2k-3. Mod 2^a: 2k-4. Shift=1.
   Identity Conservation Law. Two-ladder interleaving. S1095. */

fn eq_value_name(v) = (
  if v == 0 - 1 then "-1"
  else if v == 0 then "0"
  else if v == 1 then "1"
  else if v == 2 then "2"
  else if v == 3 then "3"
  else if v == 4 then "4 (2^2)"
  else if v == 5 then "5"
  else if v == 6 then "6 (2*3)"
  else if v == 7 then "7"
  else if v == 8 then "8 (2^3)"
  else if v == 9 then "9 (3^2)"
  else if v == 10 then "10 (2*5)"
  else "${v}"
)

fn eq_explore() = (
  let k = parse_int_from("#eq-input") in
  let result = dom_query("#eq-result") in
  if k < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter k >= 1.</p>")
  else if k > 10 then dom_inner(result, "<p style='color:#ff6666'>Max k = 10.</p>")
  else (
    let thin_mid = 2 * k - 3 in
    let fat_mid = 2 * k - 4 in
    let thin_max = 2 * k - 1 in
    let fat_max = 2 * k in
    let tn = eq_value_name(thin_mid) in
    let fn_ = eq_value_name(fat_mid) in
    let tmx = eq_value_name(thin_max) in
    let fmx = eq_value_name(fat_max) in
    let cell = "<td style='padding:8px 16px;border:1px solid #333;text-align:center;font-family:monospace'" in
    let th = "<th style='padding:6px 12px;color:#888;font-size:0.9em'>" in
    dom_inner(result,
      "<div style='margin:12px 0'>"
      + "<table style='border-collapse:collapse;margin:0 auto'>"
      + "<tr>" + th + "</th>" + th + "Midpoint</th>" + th + "Maximum</th>" + th + "Gap</th></tr>"
      + "<tr>" + th + "mod 2</th>"
        + cell + ";color:#4caf50;font-weight:bold'>" + "${thin_mid}" + " = " + tn + "</td>"
        + cell + ";color:#4caf50'>" + "${thin_max}" + " = " + tmx + "</td>"
        + cell + ";color:#888'>" + "${thin_max - thin_mid}" + "</td></tr>"
      + "<tr>" + th + "mod 2^a</th>"
        + cell + ";color:#aa44ff;font-weight:bold'>" + "${fat_mid}" + " = " + fn_ + "</td>"
        + cell + ";color:#aa44ff'>" + "${fat_max}" + " = " + fmx + "</td>"
        + cell + ";color:#888'>" + "${fat_max - fat_mid}" + "</td></tr>"
      + "</table>"
      + "<p style='text-align:center;margin:12px 0;color:#ffd700'>"
        + "Shift: mod 2 - mod 2^a = " + "${thin_mid - fat_mid}" + " = 1 (always). "
        + "Identity conserved.</p>"
      + "<p style='text-align:center;color:#a0a0b0;font-size:0.9em'>"
        + "Mod-2 contribution: cos(pi) = -1. Mod-2^a contribution: 2cos(pi) = -2. "
        + "Each odd channel: 2cos(0) = +2.</p>"
      + "</div>"
    )
  )
)

fn page_equator() = (
  dom_head_meta("description", "The Equator: Midpoint eigenvalue theorem. N/2 has all odd CRT channels at zero, only the mod-2 channel dissents. Mod 2: 2k-3. Mod 2^a: 2k-4. Shift = 1.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Equator\",\"description\":\"Midpoint Eigenvalue Theorem: N/2 eigenvalue walks through every integer from -1 to 8 as channels are added. Mod 2: 2k-3, mod 2^a: 2k-4, shift = 1. Identity Conservation Law.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/equator\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"midpoint eigenvalue\"},{\"@type\":\"DefinedTerm\",\"name\":\"identity conservation\"},{\"@type\":\"DefinedTerm\",\"name\":\"spectral equator\"}]}");

  /* === HERO === */
  let hero = make_hero("The Equator") in
  let big = dom_create("div") in
  dom_text(big, "Mod 2: eigenvalue 7. Mod 2^a: eigenvalue 6. Shift = 1.");
  ct_mono(big);
  dom_style(big, "fontSize", "26px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Every ring has a midpoint: N/2. Where every odd channel sees zero and only the mod-2 channel dissents. The eigenvalue at this equator reveals the ring's identity. As channels are added, the midpoint walks through every integer from -1 to 8.");
  dom_append(dom_body(), hero);

  /* === SEC 1: MIDPOINT CRT === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Midpoint CRT Theorem");
 render_theorem(sec1, "Midpoint CRT (PROVED)", "For N = 2^a * m (m odd), the CRT decomposition of N/2 has: mod-2^a residue = 2^(a-1) = half the modulus. All odd channels: residue = 0 (divisible by every odd factor of N). Proof: N/2 = 2^(a-1) * m. Since m is odd, N/2 mod 2^a = 2^(a-1). For any odd prime power p^k dividing N: N/2 = (N/p^k) * p^k / 2, and since 2 divides N/p^k, the result is divisible by p^k. QED.");
  render_p(sec1, "The consequence: the midpoint eigenvalue depends on just two things -- the mod-2 channel contribution (always negative) and the number of odd channels (always positive at zero).");
  dom_append(dom_body(), sec1);

  /* === SEC 2: MIDPOINT EIGENVALUE === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Midpoint Eigenvalue Theorem");
 render_theorem(sec2, "Midpoint Eigenvalue (PROVED)", "For a ring with k CRT channels: Mod 2 (squarefree): midpoint eigenvalue = 2k - 3 (always odd). Mod 2^a (a >= 2): midpoint eigenvalue = 2k - 4 (always even). Shift = 1 (universal, independent of k). Proof: Each odd channel with residue 0 contributes 2cos(0) = 2. The mod-2 channel contributes cos(pi) = -1. The mod-2^a channel contributes 2cos(pi) = -2. Mod 2: -1 + 2(k-1) = 2k-3. Mod 2^a: -2 + 2(k-1) = 2k-4. Difference = 1. QED.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: THE TWO LADDERS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Two Ladders");
  render_p(sec3, "As channels are added, the midpoint eigenvalue traces two distinct ladders. They interleave to cover every integer from -1 to 8.");
  let ltbl = make_table(sec3) in
  let lhdr = dom_create("tr") in
  render_th(lhdr, "Value");
  render_th(lhdr, "Factorization");
  render_th(lhdr, "Source");
  render_th(lhdr, "Ring");
  dom_append(ltbl, lhdr);
  render_table_row_4(ltbl, "-1", "(negative)", "mod 2, k=1", "Z/2");
  render_table_row_4(ltbl, "0", "0", "mod 2^a, k=2", "Z/4*Z/9");
  render_table_row_4(ltbl, "1", "1", "mod 2, k=2", "Z/6");
  render_table_row_4(ltbl, "2", "2", "mod 2^a, k=3", "Z/4*Z/9*Z/25");
  render_table_row_4(ltbl, "3", "3", "mod 2, k=3", "Z/30");
  render_table_row_4(ltbl, "4", "2^2", "mod 2^a, k=4", "Z/8*Z/9*Z/25*Z/49");
  render_table_row_4(ltbl, "5", "5", "mod 2, k=4", "Z/210");
  render_table_row_4(ltbl, "6", "2*3", "mod 2^a, k=5", "Z/970,200");
  render_table_row_4(ltbl, "7", "7", "mod 2, k=5", "Z/2,310");
  render_table_row_4(ltbl, "8", "2^3", "mod 2^a, k=6", "Z/12,612,600");
  render_p(sec3, "The mod-2 ladder traces odd values: -1, 1, 3, 5, 7. The mod-2^a ladder traces even values: 0, 2, 4, 6, 8. Together they cover every integer from -1 to 8 -- the eleven terms of the ring (with 17 and 26,801,776 completing the set at Z/214,414,200).");
  dom_append(dom_body(), sec3);

  /* === SEC 4: SIGMA CONSERVATION === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Identity Conservation Law");
 render_theorem(sec4, "Identity Conservation (PROVED)", "Raising the 2-channel from mod 2 to mod 2^a (a >= 2): max eigenvalue shifts +1 (from 2k-1 to 2k). Midpoint eigenvalue shifts -1 (from 2k-3 to 2k-4). The same 1 appears at both transitions. The identity element is redistributed, not created or destroyed.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Z/2,310 equator", "7", "The squarefree ring's midpoint eigenvalue is 7 (at k=5).", "");
  render_finding(g4, "Z/970,200 equator", "6 = 2*3", "The prime-power ring's midpoint eigenvalue is 6 = 2*3 (at k=5).", "");
  render_finding(g4, "The shift", "1", "Raising the 2-channel costs exactly 1 at the equator. Universal.", "");
  render_finding(g4, "Max eigenvalue", "9 (mod 2) to 10 (mod 2^a)", "The +1 gained at the pole matches the -1 lost at the equator.", "");
  dom_append(dom_body(), sec4);

  /* === SEC 5: CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast");
  let ctbl = make_table(sec5) in
  let ch = dom_create("tr") in
  render_th(ch, "Aspect");
  render_th(ch, "Standard view");
  render_th(ch, "Ring structure");
  dom_append(ctbl, ch);
  render_contrast_row(ctbl, "N/2", "Just an element like any other", "The equator: all odd channels agree, only the mod-2 channel dissents");
  render_contrast_row(ctbl, "Eigenvalue", "Some number", "Traces the chain as channels grow: -1, 0, 1, 2, 3, ..., 8");
  render_contrast_row(ctbl, "Mod 2 vs mod 2^a", "Minor technical distinction", "Two ladders interleaving to cover all integers from -1 to 8");
  render_contrast_row(ctbl, "The shift", "Off by 1", "The identity (= 1) is conserved between equator and pole");
  dom_append(dom_body(), sec5);

  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Midpoint Eigenvalue");
  render_p(sec_i, "Enter the number of CRT channels k. See the midpoint eigenvalue for both mod-2 and mod-2^a rings.");
  make_interactive_widget(sec_i, "Channels k:", "eq-input", "e.g. 6", "Compute", "eq_explore", "eq-result");
  render_p(sec_i, "Try: k=1 (value -1), k=2 (value 1 or 0), k=5 (value 7 or 6), k=6 (value 8 at Z/12,612,600).");
  dom_append(dom_body(), sec_i)
)
