  render_finding(g, "Higher levels", "5460 adds {53,79,131,157}", "4 new compatible primes at lambda = 5460 = 420*13.", "");
  render_finding(g, "Nested", "6 | 12 | 60 | 420 | 5460", "Each level = previous * next chain prime.", "");
  render_finding(g, "Lambda counts", "1, 2, 3, 5, 9, 13", "Distinct lambda values among divisors of each ring.", "");
  dom_append(dom_body(), sec)
)

