  let g = make_findings_grid(sec) in
  render_finding(g, "Lambda-420 lattice", "108 = 4 * 27", "All 108 rings hit lambda = 420 exactly (7^2 forced). 108/12 = 9.", "");
  render_finding(g, "Inside Z/12,612,600", "84", "Of the 108, exactly 84 divide 12,612,600. 84 = 2*42. 84/108 = 7/9. The other 24 extend to 2*12,612,600.", "");
  render_finding(g, "Hasse Edges", "282", "Covering relations: A covers B iff B|A and A/B is prime-power.", "");
  render_finding(g, "Diameter", "10", "Unique at lambda = 420. Equals the number of terms in {-1,0,1,2,3,5,7,11,13,1576576}.", "");
  render_finding(g, "Height", "8", "Longest chain in the divisor poset.", "");
  render_finding(g, "Max Width", "21", "Widest antichain at rank 4. 21 = 3*7.", "");
  render_finding(g, "Center", "420,420", "420 * 1001. Highest betweenness centrality.", "");
  render_finding(g, "Spectral Gap", "0.016", "4*sin^2(pi/49). Identical across all 108 lambda-420 rings (7^2 forced in every one).", "");
  render_finding_wide(g, "Triangle-Free", "Girth = 4", "Zero triangles. 538 four-cycles. Square geometry.", "");
  dom_append(dom_body(), sec)
)

fn lattice_why108() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why 108 Lambda-420 Rings, 84 Inside Z/12,612,600");
  render_theorem(sec, "Two-Constraint Theorem (PROVED)", "All 108 lambda-420 rings share two forcing constraints. 7^2 = 49 is always present (lambda needs factor 7; 7^3 = 343 gives lambda 294 which does not divide 420 -- 7^2 is forced exactly). 7^2 alone gives lambda = 42. Two more factors are needed for lambda = 420: (1) factor 4 from 2^e with e >= 4, or 5^e with e >= 1, or 13. (2) factor 5 from 5^2 or 11. Inclusion-exclusion on 180 candidates: 180 - 72 = 108.");
  render_theorem(sec, "Sub-Ring Count", "Of the 108 lambda-420 rings, exactly 84 divide Z/12,612,600 (2-exponent at most 3, since 12,612,600 has 2^3 = 8): inclusion-exclusion 144 - 60 = 84. The remaining 24 extend beyond (2-exponent = 4, reaching 2 * 12,612,600 = 25,225,200): 36 - 12 = 24. Sum: 84 + 24 = 108. Ratio 84/108 = 7/9.");
  render_theorem(sec, "Partition", "108 = 32 + 76. 32 rings contain all five chain primes; 76 are partial. By prime count: 1 + 11 + 36 + 44 + 16.");
  dom_append(dom_body(), sec)
)

