  render_p(sec, "Try: N=12612600 (84-subset), N=970200 (84-subset), N=2310 (lambda=60, outside lattice), N=210 (lambda=12, outside), N=25225200 (24-extension), N=1225 (= 25*49, smallest member).");
  dom_append(dom_body(), sec)
)

