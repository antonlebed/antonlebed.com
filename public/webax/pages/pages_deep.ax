  dom_head_meta("description", "108 rings share Carmichael lambda = 420 exactly (49 forced). 84 divide Z/12,612,600; 24 extend to twice that. Spectral gap 0.016 universal. Diameter = 10. 61 detects the boundary. Free sums = chain primes {3, 7, 8}. Triangular decomposition.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"108 Rings, One Period\",\"description\":\"108 rings share Carmichael lambda = 420 exactly (7^2 = 49 forced). 84 divide Z/12,612,600; 24 extend. Spectral gap 4*sin^2(pi/49) universal. 61 is a primitive root of Z/49 that discriminates the 84/24 boundary. Free sums are chain primes. Nilpotent product theorem. Triangular decomposition.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/ideas/lattice\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Lattice Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"Carmichael Function\"},{\"@type\":\"DefinedTerm\",\"name\":\"Ring Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"Nilpotent Elements\"},{\"@type\":\"DefinedTerm\",\"name\":\"Primitive Roots\"}]}");
