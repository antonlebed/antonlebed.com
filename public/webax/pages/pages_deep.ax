fn lattice_hero() = (
  /* TOWER_GATE primary: the lattice IS Tower C restricted to the lambda=420 fiber.
     108 = D^2*K^3 = ALL rings with lambda=420 EXACTLY (b^2 forced; D-range 0..4).
     84 = D^2*K*b = subset that DIVIDES TRUE=12612600 (D-range 0..3).
     24 = D^4 extensions BEYOND TRUE (D=4, max N=25225200=2*TRUE).
     SSOT: stdlib/lattice.ax (TT47 reframing per S1428 R5). */
  let hero = make_hero("108 Rings, One Period") in
  let big = dom_create("div") in
  dom_text(big, "lambda = 420");
  ct_mono(big);
  dom_style(big, "fontSize", "48px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "4px");
  dom_style(big, "marginBottom", "16px");
  dom_append(hero, big);
  render_p(hero, "Exactly 108 = 4*27 rings share the same Carmichael lambda: 420 = 4*3*5*7. 7^2 = 49 is forced in every one of them (without 49, the lcm of per-channel lambdas has no factor of 7). Of the 108, exactly 84 divide Z/12,612,600; the remaining 24 extend beyond it up to 25,225,200 = 2 * 12,612,600. The 84 are the sub-rings; the 24 are doublings.");
  dom_append(dom_body(), hero)
)

