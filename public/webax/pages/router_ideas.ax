/* router_ideas.ax -- Module router for IDEAS (philosophy + kingdom + cc0/revolution). */

/* S2004: redirect stub for pages moved to other sections */
fn page_moved(url, name) = (
  let sec = make_section("600px") in
  render_h2(sec, "Page Moved");
  render_p(sec, "This page has moved. Visit <a href='" + url + "' style='color:#ffd700'>" + name + "</a> in its new section.");
  dom_append(dom_body(), sec)
)

fn page_404(hash) = (
  let sec = make_section("600px") in
  render_h2(sec, "Page Not Found");
  render_p(sec, "No page matches this route.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Home", "/", "Start here.", "");
  dom_append(dom_body(), sec)
)

fn route_page(hash) = page_404(hash)

fn route() = (
  let hash = get_hash() in
  if streq(hash, "ideas") == 1 then page_ideas_index()
  else if streq(hash, "bootstrap") == 1 then page_bootstrap()
  else if streq(hash, "septum") == 1 then page_septum()
  else if streq(hash, "mirror") == 1 then page_mirror()
  else if streq(hash, "sacrifice") == 1 then page_sacrifice()
  else if streq(hash, "decality") == 1 then page_decality()
  else if streq(hash, "lattice") == 1 then page_lattice()
  /* S2004: carousel moved to Patterns */
  else if streq(hash, "carousel") == 1 then page_moved("/patterns/carousel", "Carousel")
  /* S2004: cc0+revolution moved from Lab */
  else if streq(hash, "cc0") == 1 then page_cc0()
  else if streq(hash, "revolution") == 1 then page_revolution()
  else if streq(hash, "observer") == 1 then page_observer()
  else if streq(hash, "duality") == 1 then page_duality()
  else if streq(hash, "depth") == 1 then page_depth()
  else if streq(hash, "transcend") == 1 then page_transcend()
  else page_404(hash)
)

let arena_mark = [0]
fn get_hp() = hp()
fn reset_hp(v) = set_hp(v)

fn route_only() = (
  dom_inner(dom_body(), "");
  ct_moon(dom_body());
  route();
  highlight_nav();
  render_vow(dom_body());
  render_footer()
)

fn on_navigate() = (
  set_hp(arena_mark[0]);
  close_nav_dd();
  route_only()
)

ct_body(dom_body());
ct_starfield(dom_body());
ct_clouds(dom_body());
ct_wave(dom_body());
render_nav();

let spa_root = dom_create("div") in
dom_style(spa_root, "position", "relative");
dom_style(spa_root, "zIndex", "1");
dom_style(spa_root, "paddingTop", "52px");
dom_append(dom_body(), spa_root);
dom_set_root(spa_root);
set(arena_mark, 0, hp());

ct_moon(dom_body());
route();
highlight_nav();
render_vow(dom_body());
render_footer();

dom_spa_init("on_navigate")
