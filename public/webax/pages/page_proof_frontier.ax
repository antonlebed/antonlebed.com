  let cu_i41 = (if 2*20+1 == 41 then 1 else 0) in                           -- c(D^2*E)
  let cu_i47 = (if 2*23+1 == 47 then 1 else 0) in                           -- c(c(L))
  -- Termination: c(47)=95=E*f(E) composite
  let cu_seal = (if 2*47+1 == 5*19 then 1 else 0) in
  -- Args DATA-smooth: 6=D*K, 8=D^3, 9=K^2, 15=K*E, 18=D*K^2, 20=D^2*E
