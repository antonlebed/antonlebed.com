/* ================================================================
   PAGE: OBSERVER -- 5, Self-Blindness, mod-3 to mod-5 Boundary
   ================================================================ */
/* observer helpers */
fn observer_hero() = (
  let hero = make_hero("The Self-Blind Prime") in
  let eq = dom_create("div") in
  dom_text(eq, "5^2 = 25 = 0 mod 5");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "5 is the arithmetic mean of 3 and 7. It is the only chain prime whose square vanishes in its own channel: 25 mod 5 = 0. This self-nullification has algebraic consequences throughout the ring. In Z/2,310, CRT(5) = (1, 2, 0, 5, 5) -- the mod-5 channel is zero. 5 is invisible to itself.");
  dom_append(dom_body(), hero)
)

fn observer_proofs() = (
  let sec = make_section("800px") in
  render_h2(sec, "Properties of 5");
  let g = make_findings_grid(sec) in
  render_finding(g, "Midpoint", "5 = (3 + 7) / 2", "Exact arithmetic mean of 3 and 7.", "");
  render_finding(g, "Minimax", "5 minimizes max{|x-3|, |x-7|}", "At x = 5: max = 2. Minimum over all integers.", "");
  render_finding(g, "Gaussian norm", "5 = 1^2 + 2^2", "5 splits in Z[i] as (1+2i)(1-2i). The only chain prime that is a sum of two squares.", "");
  render_finding(g, "Algebraic", "5 = 7 - 2", "Also 5 * 2 = 3 + 7, and 3 * 5 = 3 + 5 + 7. The chain primes generate each other.", "");
  render_finding(g, "Spectral gap", "4*sin^2(pi/p) < 2 iff p > 4", "5 is the first prime where the spectral gap drops below 2. Proved for all p.", "");
  render_finding(g, "Surplus", "phi(210) - 8 = 48 - 8 = 40 = 8*5", "The Euler totient surplus of Z/210 factors as 2^3 * 5.", "");
  dom_append(dom_body(), sec)
)

fn observer_blindness() = (
  let sec = make_section("800px") in
  render_h2(sec, "Self-Blindness");
  render_theorem(sec, "Symmetric Eigenvalue Distribution", "5 has all odd central moments equal to 0. Its eigenvalue distribution is perfectly symmetric. The even moments follow a geometric series: mu_{2k} = (5/4)^k. This is unique among the chain primes -- all others have asymmetric distributions.");
  render_p(sec, "5 mod 4 = 1. It is the only chain prime congruent to 1 mod 4. Several consequences follow:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Legendre(-1, 5) = +1", "-1 is a quadratic residue mod 5", "Among {3, 5, 7, 11}: only 5 has -1 as a square (2^2 = 4 = -1 mod 5). Because 5 = 1 mod 4.", "");
  render_finding(g, "Gaussian splitting", "5 = (1+2i)(1-2i)", "5 splits in the Gaussian integers Z[i]. The only chain prime that does (3, 7, 11 are all inert).", "");
  render_finding(g, "Zero self-indexing", "0 in 348,513 primes", "5 never appears at its own index in the prime sequence. 2: 28%, 3: 6.6%, 7: 0.9%, 11: 0.3%.", "");
  render_finding(g, "CRT self-nullification", "CRT(5) = (1, 2, 0, 5, 5)", "The mod-25 component is zero. 5 vanishes in its own channel.", "");
  dom_append(dom_body(), sec)
)

fn observer_legendre() = (
  let sec = make_section("800px") in
  render_h2(sec, "Legendre Symbol: Is 5 a Square?");
  render_theorem(sec, "Quadratic Residue Pattern", "The Legendre symbol (5|p) asks: is 5 a square mod p? The answer across chain primes: (5|3) = -1, (5|5) = 0, (5|7) = -1, (5|11) = +1. Only mod 11 sees 5 as a quadratic residue. Product: (-1)(0)(-1)(+1) is undefined (5 ramifies at itself).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime p");
  render_th(hdr, "(5|p)");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2", "n/a", "5 is odd -- parity carries no information here.");
  render_table_row(tbl, "3", "-1", "5 is not a square mod 3. (Residues: {0, 1}).");
  render_table_row(tbl, "5", "0", "5 divides 5. Ramified -- not a residue, not a non-residue.");
  render_table_row(tbl, "7", "-1", "5 is not a square mod 7. (Squares mod 7: {0, 1, 2, 4}).");
  render_table_row(tbl, "11", "+1", "5 IS a square mod 11: 4^2 = 16 = 5 mod 11.");
  render_p(sec, "Golden ratio connection: phi = (1 + sqrt(5))/2 is a primitive root mod 11 (order 10 = phi(11)). At 5 itself, phi is ramified -- sqrt(5) splits into equal conjugates. At 13, (5|13) = -1: the golden ratio is blocked.");
  dom_append(dom_body(), sec)
)

fn observer_boundary() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Mod-3 to Mod-5 Cliff");
  render_theorem(sec, "Determinism to Randomness in One Step", "In the mod-3 channel, prime gap transitions have structural zeros: 3 consecutive primes cover all residues (pigeonhole). Zero exceptions in 148,933 primes. In mod 5: all 25 transitions are positive. No forbidden transitions. Mutual information drops 28x. Entropy jumps from 78% to 98.4%.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "MI (bits)");
  render_th(hdr, "Entropy");
  render_th(hdr, "Character");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "mod 2", "0.000", "100%", "Pure noise. Parity carries nothing.");
  render_table_row_4(tbl, "mod 3", "0.323", "78%", "Deterministic. Structural zeros. 94% of gap information.");
  render_table_row_4(tbl, "mod 5", "0.012", "98.4%", "Statistical. All transitions open. The cliff.");
  render_table_row_4(tbl, "mod 7", "0.019", "97%", "Near-random. Information dissolves.");
  render_table_row_4(tbl, "mod 11", "0.095", "88%", "More structured than mod 5 or mod 7.");
  render_p(sec, "Three doors: one always locked. Five: none locked. The transition from determinism to randomness happens in a single step, between mod 3 and mod 5.");
  dom_append(dom_body(), sec)
)

