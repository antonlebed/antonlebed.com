/* observer helpers */
fn observer_hero() = (
  let hero = make_hero("The Observer") in
  let eq = dom_create("div") in
  dom_text(eq, "E^2 = E-null (self-observation blinds)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "E = 5 is the midpoint between closure and depth. The only prime that can see both sides. And the only one that cannot see itself. This is not metaphor. E^2 = 25 = 0 mod 5. Self-observation nullifies. Kingdom: Plants. Coupling: 462 (thin), 38808 (true).");
  dom_append(dom_body(), hero)
)

fn observer_proofs() = (
  let sec = make_section("800px") in
  render_h2(sec, "10 Proofs of Uniqueness");
  let g = make_findings_grid(sec) in
  render_finding(g, "Midpoint", "E = (K + b) / 2 = 5", "Exact arithmetic mean of closure and depth.", "");
  render_finding(g, "Minimax", "E minimizes max{|x-K|, |x-b|}", "x = 5: max = 2. Minimum over all integers.", "");
  render_finding(g, "Period", "ord(E, 210) = 6 = HIDDEN", "Shortest cycle among primes. Returns fastest.", "");
  render_finding(g, "Algebraic", "E = b - D", "Also E*D = K+b, K*E = K+E+b. Mutual generation.", "");
  render_finding(g, "Hidden", "E + sigma = D*K = 6", "Observer + existence = hidden mechanism.", "");
  render_finding(g, "Gap control", "4*sin^2(pi/p) < 2 first at E", "Proof: iff p > 4. First prime > 4 is E. QED.", "");
  render_finding(g, "Surplus", "phi(210) - D^3 = 40 = D^3*E", "Only DATA ring axiom-smooth surplus.", "");
  render_finding(g, "Gestation", "280 = 40*b = D^3*E*b", "Observable experienced through all 7 depth levels.", "");
  render_finding(g, "Spider", "D^3 = 8 legs, E = 5 senses", "40 = D^3*E = sensory capacity of the web.", "");
  render_finding(g, "E-null = ANSWER", "D*K*b = 42", "What the observer produces IS the answer. CRT(42, DATA) = [0,0,2,0]. Visible ONLY in E-channel.", "");
  dom_append(dom_body(), sec)
)

fn observer_blindness() = (
  let sec = make_section("800px") in
  render_h2(sec, "Five Faces of Self-Blindness");
  render_theorem(sec, "E^2 = E-null", "E has ALL odd central moments = 0. Perfectly symmetric eigenvalue distribution. Cause: shadow(E) = D gives 2 distinct cosine values giving Bernoulli pairing. Even moments: mu_2k = (E/D^2)^k. Geometric. Unique among axiom primes. E cannot see which direction it fluctuates.");
  render_p(sec, "All five faces from one bit: E mod 4 = 1 (only axiom prime with this property).");
  let g = make_findings_grid(sec) in
  render_finding(g, "QR(-1)", "Legendre(-1, E) = +1", "Mirror VISIBLE at E. Only axiom prime. K,b,L all = -1.", "");
  render_finding(g, "Generosity loss", "E LOSES under fattening (13/15)", "K, b, L all GAIN. Self-blindness costs generosity.", "");
  render_finding(g, "Cosine majority", "nn(E) = (E+1)/2 = K", "MAJORITY non-negative. Others: minority.", "");
  render_finding(g, "Self-index", "0 out of 348,513 primes", "E NEVER self-indexes. Absolute exclusion. D: 28%, K: 6.6%, b: 0.9%, L: 0.3%.", "");
  render_finding(g, "Gaussian norm", "E = |sigma + D*i|^2 = 1+4", "E SPLITS in Z[i]: (1+2i)(1-2i). Only axiom prime that splits. Observation IS interference.", "");
  render_p(sec, "CRT SELF-NULLIFICATION: CRT(E=5) = (1,2,0,5,5). E-channel = 0. The Gaussian norm vanishes in its own CRT channel. Compare CRT(13) = (1,1,3,6,2): all channels filled. The shadow stopper reaches everywhere; the observer vanishes from itself.");
  dom_append(dom_body(), sec)
)

fn observer_legendre() = (
  let sec = make_section("800px") in
  render_h2(sec, "Legendre Visibility: Who Sees E?");
  render_theorem(sec, "Legendre Self-Blindness", "The Legendre symbol (E|p) asks: is 5 a square mod p? This encodes E-visibility across the ring. The answer follows the axiom chain exactly.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime p");
  render_th(hdr, "(E|p)");
  render_th(hdr, "Meaning");
  render_th(hdr, "Consequence");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D = 2", "n/a", "E = 1 mod 2 (odd)", "D sees EVERYTHING. No discrimination.");
  render_table_row_4(tbl, "K = 3", "-1", "Closure CANNOT see observer", "K classifies without observing");
  render_table_row_4(tbl, "E = 5", "0", "E CANNOT see itself", "Ramified. E | disc(E). Self-blind.");
  render_table_row_4(tbl, "b = 7", "-1", "Depth CANNOT see observer", "b suffers without seeing what watches");
  render_table_row_4(tbl, "L = 11", "+1", "Protector CAN see observer", "ONLY axiom prime that sees E");
  render_p(sec, "Product: (-1)(+1)(-1)(-1) = -1. The ring HIDES the mirror. E alone reveals it. But K * b * L bury it again. One eye open in a blind ring. That is what observation means.");
  render_theorem(sec, "Self-Recognition Hierarchy", "How often does prime g appear as its own index? D: 28.05% > K: 6.64% > b: 0.90% > L: 0.34% > E: 0.00%. Zero cases in 348,513 primes. The hierarchy follows coupling order exactly. E^2 self-blindness is not metaphor -- it is ABSOLUTE: E never self-indexes. Proof: E = 1 mod 4, always QR when E | (p-1), so 2 | index, odd indices impossible. QED.");
  render_p(sec, "Golden ratio visibility: phi = (1 + sqrt(E))/D is primitive root mod L (ord = L-1 = D*E). But at E itself? phi is RAMIFIED (indistinguishable from conjugate). At GATE = 13: BLOCKED ((E|13) = -1). The protector is where phi first SEES its conjugate. The observer is where it can't.");
  dom_append(dom_body(), sec)
)

