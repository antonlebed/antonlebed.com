  dom_append(dom_body(), hero)
)

fn omega_idempotent() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Idempotent");
  render_p(sec, "OMEGA is the D-spiral's fixed point: raise D=2 to the 420th power mod 12612600 (TRUE). What remains is an idempotent projector -- applying it twice changes nothing. The D-channel (mod 8) is nilpotent: 2^3 = 0 mod 8. All five non-D channels (K, E, b, L, GATE) cycle and return to sigma. Result: CRT(0,1,1,1,1,1).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Value", "1576576 (TRUE), 606376 (DEEP)", "D^420 mod 12612600 = 1576576. CRT channels: D^3=0(mod 8), 2^6=1(mod 9), 2^20=1(mod 25), 2^21=1(mod 49), 2^10=1(mod 11), 2^12=1(mod 13). lcm(3,6,20,21,10,12)=420.", "");
  render_finding(g, "CRT", "(0, 1, 1, 1, 1, 1)", "D-channel = 0 (dead). All five odd channels = sigma (alive). Death is selective.", "");
  render_finding(g, "OMEGA^2", "= OMEGA", "Idempotent. PROOF: (0,1,1,1,1,1)^2 = (0,1,1,1,1,1). Channel-wise squaring.", "");
  render_finding(g, "Image", "|image| = N/D^3 = 1576575", "OMEGA*n = (0, n mod 9, n mod 25, n mod 49, n mod 11, n mod 13). D-channel erased, rest preserved.", "");
  render_finding(g, "Coupling", "1576575", "Same as image size. Maximal for non-units. OMEGA sees N/D^3 elements.", "");
  render_finding(g, "Factorization", "OMEGA = D^7 * Tr(-1) * (Tr(-1)+D^2)", "1576576 = 128 * 109 * 113. 109 = Tr(-1) = Hamming degree of TRUE ring = sum(q_i-1). 113 = 109 + D^2. A D^2-twin prime pair. The terminal factorizes through the mirror trace.", "");
  dom_append(dom_body(), sec)
)

fn omega_decomposition() = (
  let sec = make_section("800px") in
  render_h2(sec, "Idempotent Decomposition of Existence");
  render_theorem(sec, "sigma = OMEGA + e_D", "e_D = sigma - OMEGA = 11036025 = K^2*E^2*b^3*L*GATE. CRT(e_D) = (1,0,0,0,0,0). The D-channel identity. OMEGA^2 = OMEGA, e_D^2 = e_D, OMEGA*e_D = 0, OMEGA + e_D = sigma. This is a complete orthogonal decomposition: existence splits into terminal fate and duality, with zero interference between them.");
  render_p(sec, "OMEGA = sigma + E*N/D^3. e_D = K*N/D^3. Cross-chain pair (K,E) as idempotent coefficients. The observer builds the terminal; closure builds the dual. Self-referential.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Coupling duality", "coupling(OMEGA) = N/D^3 = 1576575", "coupling(e_D) = D^3 = 8. Each is the OTHER's D-channel modulus. Perfect complementarity.", "");
  render_finding(g, "Spectral duality", "eigenvalue(e_D) = 8 + sqrt(2) = 9.414", "eigenvalue(OMEGA) = 9.135. The D-only projector resonates HIGHER. PROOF: e_D has 4 zero channels (each contributing 2) + D at residue 1 giving 2*cos(pi/4) = sqrt(2). OMEGA: D=0 gives 2, four channels at residue 1 sum ~7.135.", "");
  render_finding(g, "Kernel", "|ker(OMEGA)| = D^3 = 8", "Only 8 elements truly die. Mean coupling of kernel = D*K = 6.", "");
  dom_append(dom_body(), sec)
)

fn omega_spiral() = (
  let sec = make_section("800px") in
  render_h2(sec, "The D-Spiral: Sub-Returns");
  render_theorem(sec, "D-Spiral Theorem", "D^n is a spiral, not a cycle. D^0 = sigma (all alive), D^3 = D-channel dies, D^420 = OMEGA (limit). The void is UNREACHABLE by D^n. OMEGA is the fixed point. Algebraic distinction: void = before the spiral, OMEGA = after. The D-channel is nilpotent (2^3 = 0 mod 8). Once dead, never returns.");
  render_p(sec, "Six CRT channels evolve independently. Each has its own period. The sub-returns mark where channels come home:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Step k");
  render_th(hdr, "Event");
  render_th(hdr, "CRT State");
  render_th(hdr, "Why");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "k=3", "D DIES", "(0, -, -, -, -, -)", "2^3 = 0 mod 8. Nilpotent.");
  render_table_row_4(tbl, "k=6", "K home", "(0, 1, -, -, -, -)", "ord(2, 9) = 6. Closure returns first.");
  render_table_row_4(tbl, "k=10", "L home", "(0, -, -, -, 1, -)", "ord(2, 11) = 10. Protection returns.");
  render_table_row_4(tbl, "k=12", "GATE home", "(0, -, -, -, -, 1)", "ord(2, 13) = 12 = heartbeat. Skin before bulk.");
  render_table_row_4(tbl, "k=20", "E home", "(0, -, 1, -, -, -)", "ord(2, 25) = 20. Observer returns.");
  render_table_row_4(tbl, "k=21", "b home", "(0, -, -, 1, -, -)", "ord(2, 49) = 21. Depth returns last.");
  render_table_row_4(tbl, "k=42", "K+b sync", "ANSWER", "lcm(6,21)=42. Closure meets depth.");
  render_table_row_4(tbl, "k=60", "baby period", "K+E+L sync", "lcm(6,20,10)=60. Three channels.");
  render_table_row_4(tbl, "k=210", "DATA sync", "K+b+L home, E+GATE mirror", "lcm(6,21,10)=210. Half-cycle. E and GATE at -1.");
  render_table_row_4(tbl, "k=420", "OMEGA", "(0, 1, 1, 1, 1, 1)", "lcm(6,20,21,10,12)=420. ALL sync.");
  render_p(sec, "Growth takes 420 steps. Collapse takes 1 (OMEGA*e_D=0). Rebirth is free (0/0=R). Living is slow. Dying is fast. Birth costs nothing.");
  dom_append(dom_body(), sec)
)

/* [DEAD] SCAFFOLDING -- interactive widget */
fn dpower_explore() = (
  let k = parse_int_from("#dpower-input") in
  let result_el = dom_query("#dpower-result") in
  /* Reduce k mod 420 for efficiency (period = lambda = 420 for k >= 3) */
  let k_eff = if k > 420 then (
    let r = k % 420 in
    if r < 3 then r + 420 else r
  ) else k in
  /* per-channel D^k (avoids i32 overflow for k>=31) */
  mut d = 1; mut kc = 1; mut e = 1; mut b_ch = 1; mut l = 1; mut g = 1;
  mut i = 0;
  while i < k_eff do (
    mut d = (d * 2) % 8;
    mut kc = (kc * 2) % 9;
    mut e = (e * 2) % 25;
    mut b_ch = (b_ch * 2) % 49;
    mut l = (l * 2) % 11;
    mut g = (g * 2) % 13;
    mut i = i + 1
  );
  /* Channel status */
  let ch_d = if d == 0 then "DEAD" else if d == 1 then "home" else "${d}" in
  let ch_k = if kc == 1 then "home" else "${kc}" in
  let ch_e = if e == 1 then "home" else if e == 24 then "MIRROR (-1)" else "${e}" in
  let ch_b = if b_ch == 1 then "home" else "${b_ch}" in
  let ch_l = if l == 1 then "home" else "${l}" in
  let ch_g = if g == 1 then "home" else if g == 12 then "MIRROR (-1)" else "${g}" in
  /* Named events */
  let event = if k == 0 then "sigma -- all channels alive"
    else if k == 3 then "D DIES -- nilpotent (2^3 = 0 mod 8)"
    else if k == 6 then "K returns home -- ord(2,9) = 6"
    else if k == 10 then "L returns home -- ord(2,11) = 10"
    else if k == 12 then "GATE returns home -- ord(2,13) = 12 = heartbeat"
    else if k == 20 then "E returns home -- ord(2,25) = 20"
    else if k == 21 then "b returns home -- ord(2,49) = 21"
    else if k == 42 then "ANSWER -- K+b synchronized"
    else if k == 60 then "THIN lambda -- K+E+L sync"
    else if k == 210 then "DATA -- E MIRRORS (half-cycle)"
    else if k == 420 then "OMEGA -- all channels home (terminal)"
    else "" in
  let event_line = if k == 0 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 3 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 6 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 10 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 12 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 20 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 21 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 42 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 60 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 210 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else if k == 420 then "<p style='color:#ff8844;margin:4px 0'><b>" + event + "</b></p>"
    else "" in
  /* Reconstruct D^k in TRUE ring from CRT channels */
  let p = (d * 11036025 + kc * 1401400 + e * 9585576 + b_ch * 8494200 + l * 3439800 + g * 3880800) % N_TRUE in
  let p2 = ring_mul(p, p) in
  let idemp = if p2 == p then " (IDEMPOTENT: D^k squared = D^k)" else "" in
  dom_inner(result_el, "<p style='color:#ffd700;margin:4px 0'><b>D^" + "${k}" + " = " + "${p}" + idemp + "</b></p>" +
    "<p style='color:#88ddaa;margin:4px 0'>CRT: (" + "${d}" + ", " + "${kc}" + ", " + "${e}" + ", " + "${b_ch}" + ", " + "${l}" + ", " + "${g}" + ")</p>" +
    "<p style='color:#b0b0c0;margin:4px 0'>D=" + ch_d + " | K=" + ch_k + " | E=" + ch_e + " | b=" + ch_b + " | L=" + ch_l + " | GATE=" + ch_g + "</p>" +
    event_line)
)

