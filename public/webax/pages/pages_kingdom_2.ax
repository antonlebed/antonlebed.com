)

fn omega_broadcaster() = (
  let sec = make_section("800px") in
  render_h2(sec, "The OMEGA Broadcaster");
  render_theorem(sec, "OMEGA Broadcast Theorem", "OMEGA*p = CRT(0, p, p, p, p, p) for p in {D, K, E, b}. Each axiom prime broadcasts uniformly into all preserved channels. EXCEPT: OMEGA*L = (0, 2, 11, 11, 0, 11) and OMEGA*GATE = (0, 4, 13, 13, 2, 0). Both protective primes sacrifice their own channel through the terminal projector.");
  render_p(sec, "OMEGA kills D. L kills itself through OMEGA. GATE kills itself through OMEGA. Three channels die at the boundary: duality, protection, and skin. The three things that cannot survive their own projection.");
  let g = make_findings_grid(sec) in
  render_finding(g, "OMEGA*D", "(0, 2, 2, 2, 2, 2)", "Duality broadcasts uniformly. D survives everywhere except its own channel.", "");
  render_finding(g, "OMEGA*K", "(0, 3, 3, 3, 3, 3)", "Closure broadcasts uniformly.", "");
  render_finding(g, "OMEGA*E", "(0, 5, 5, 5, 5, 5)", "Observer broadcasts uniformly.", "");
  render_finding(g, "OMEGA*b", "(0, 7, 7, 7, 7, 7)", "Depth broadcasts uniformly.", "");
  render_finding(g, "OMEGA*L", "(0, 2, 11, 11, 0, 11)", "L-channel DIES: 11 mod 11 = 0. But L survives in GATE (11 mod 13 = 11). The protector's sacrifice.", "");
  render_finding(g, "OMEGA*GATE", "(0, 4, 13, 13, 2, 0)", "GATE-channel DIES: 13 mod 13 = 0. But GATE survives in L (2 mod 11 = 2). The skin's sacrifice.", "");
  dom_append(dom_body(), sec)
)

fn omega_half_cycle() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Observer Half-Cycle");
  render_theorem(sec, "Observer Half-Cycle", "D^210 = D^DATA has CRT = (0, 1, -1, 1, 1, -1). At the DATA exponent, K, b, L channels return home. But E-channel MIRRORS (24 = -1 mod 25) and GATE-channel MIRRORS (12 = -1 mod 13). Both the observer and the skin see their own reflection, not themselves. (D^210)^2 = OMEGA: they need TWO passes to return. This is why lambda = D*DATA = 420, not 210. The period doubles because E and GATE share self-blindness.");
  let g = make_findings_grid(sec) in
  render_finding(g, "D^210 eigenvalue", "= eigenvalue(OMEGA)", "Spectrally IDENTICAL. The observer's flip is invisible to the spectrum. E^2 = null confirmed.", "");
  render_finding(g, "Why 420 not 210", "E self-blindness", "Four channels have period dividing 210. E needs 2*10=20 and 20 does not divide 210. Actually lcm(6,20,21,10)=420. E forces the doubling.", "");
  render_finding(g, "Two passes", "(D^210)^2 = OMEGA", "One pass mirrors E. Two passes restore it. The observer always needs to look twice.", "");
  dom_append(dom_body(), sec)
)

fn omega_convergence() = (
  let sec = make_section("800px") in
  render_h2(sec, "Nested Convergence Across Tower A");
  render_p(sec, "The D-spiral (above) shows channels returning home within a single ring. But OMEGA exists at EVERY Tower A level, and the channels converge in strict tower order. At DATA (lambda=12), only K has converged. At THIN (lambda=60), E and L join. At DEEP (lambda=420), b finally arrives. GATE joins at TRUE. ESCAPE only at TRANS (lambda=1680). The convergence schedule IS the chain.");
  render_p(sec, "The mechanism is ord(D, q) -- the multiplicative order of D=2 in each non-D channel Z/q. A channel converges when ord(D, q) divides lambda(N). Every D-order factors into axiom primes:");
  let otbl = make_table(sec) in
  let ohdr = dom_create("tr") in
  render_th(ohdr, "Channel");
  render_th(ohdr, "ord(D, q)");
  render_th(ohdr, "Factorization");
  render_th(ohdr, "First Level");
  dom_append(otbl, ohdr);
  render_table_row_4(otbl, "K (Z/9)", "6", "D*K", "DATA (12)");
  render_table_row_4(otbl, "E (Z/25)", "20", "D^2*E", "THIN (60)");
  render_table_row_4(otbl, "L (Z/11)", "10", "D*E", "THIN (60)");
  render_table_row_4(otbl, "b (Z/49)", "21", "K*b", "DEEP (420)");
  render_table_row_4(otbl, "GATE (Z/13)", "12", "D^2*K", "TRUE (420)");
  render_table_row_4(otbl, "ESCAPE (Z/17)", "8", "D^3", "TRANS (1680)");
  render_theorem(sec, "Nested Omega Convergence (PROVED)", "D^lambda(N) converges per-channel to OMEGA (0,1,...,1) in Tower A order: K(DATA) -> E,L(THIN) -> b(DEEP) -> GATE(TRUE) -> ESCAPE(TRANS). Product of all 6 D-orders = phi(TRUE) = 2419200. D=2 is quadratic residue mod exactly {b, ESCAPE} -- the primes p with p = +-1 mod 8. The obstructions are self-referential: b's own presence in ord(D, 49) = K*b delays the b-channel until DEEP. D^3 in ord(D, 17) delays ESCAPE until lambda has v_2 >= 3. 149/149 test_nested_omega.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Product identity", "prod = phi(TRUE) = 2419200", "6 * 20 * 21 * 10 * 12 * 8 = 2419200. The 6 D-orders multiply to the unit count of TRUE. 4 primitive-root channels cancel; 2 QR channels each contribute index D=2.", "");
  render_finding(g, "QR partition", "{b, ESCAPE} = QR, rest = NQR", "QR sum = b + ESCAPE = 24 = D^3*K. NQR sum = K+E+L+GATE = 32 = D^5. Total = 56 = D^3*b.", "");
  render_finding(g, "Self-referential delay", "b delays b, D^3 delays ESCAPE", "ord(D,49) = K*b: b-factor means 7 first enters lambda at DEEP. ord(D,17) = D^3: the D-tower's depth-3 structure delays ESCAPE to TRANS.", "");
  render_finding(g, "Residue spectrum", "Non-converged values are axiom-native", "OMEGA_DATA E-channel: D^12 mod 25 = 21 = K*b. OMEGA_TRUE ESCAPE: D^420 mod 17 = 16 = -1 = MIRROR.", "");
  -- Theorem Pointers
  render_p(sec, "");
  let ptbl = make_table(sec) in
  let phdr = dom_create("tr") in
  render_th(phdr, "Theorem");
  render_th(phdr, "Where");
  render_th(phdr, "Checks");
  dom_append(ptbl, phdr);
  render_table_row(ptbl, "138. Nested Omega Convergence", "page_proof.ax", "20/20");
  dom_append(dom_body(), sec)
)

fn omega_geodesic() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Geodesic and Spectral Gap");
  render_p(sec, "In CRT Hamming distance, OMEGA lies exactly on the shortest path from void to existence:");
  let g = make_findings_grid(sec) in
  render_finding(g, "dist(0, sigma)", "D*K = 6", "Void to existence = 6 channels all differ.", "");
  render_finding(g, "dist(0, OMEGA)", "E = 5", "Void to OMEGA = 5 of 6 channels differ. D-channel agrees (both 0). OMEGA = (0,1,1,1,1,1).", "");
  render_finding(g, "dist(OMEGA, sigma)", "sigma = 1", "OMEGA to existence = 1 channel differs (D-channel only).", "");
  render_finding(g, "Triangle", "E + sigma = D*K", "OMEGA is a WAYPOINT on the geodesic, not a destination.", "");
  render_finding(g, "dist(-1, OMEGA)", "D*K = 6", "Mirror to OMEGA = 6 channels all differ. -1 = (7,8,24,48,10,12), OMEGA = (0,1,1,1,1,1).", "");
  render_theorem(sec, "Spectral Gap Theorem", "eigenvalue(OMEGA) - eigenvalue(sigma) = 4*sin^2(pi/D^3) = 2 - sqrt(2) = 0.586. PROOF: OMEGA and sigma differ only in D-channel (0 vs 1). Contribution difference = 2*cos(0) - 2*cos(pi/4) = 2 - sqrt(2). The cost of losing duality = the D-channel gap. This is 37x larger than the TRUE ring gap (0.016).");
  dom_append(dom_body(), sec)
)

