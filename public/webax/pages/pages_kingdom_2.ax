/* observer helpers */
fn observer_hero() = (
  let hero = make_hero("The Observer") in
  let eq = dom_create("div") in
  dom_text(eq, "E^2 = E-null (self-observation blinds)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "E = 5 is the midpoint between closure and depth. The only prime that can see both sides. And the only one that cannot see itself. This is not metaphor. E^2 = 25 = 0 mod 5. Self-observation nullifies. Kingdom: Plants. Coupling: 462 (thin), 38808 (true).");
  dom_append(dom_body(), hero)
)

fn observer_proofs() = (
  let sec = make_section("800px") in
  render_h2(sec, "10 Proofs of Uniqueness");
  let g = make_findings_grid(sec) in
  render_finding(g, "Midpoint", "E = (K + b) / 2 = 5", "Exact arithmetic mean of closure and depth.", "");
  render_finding(g, "Minimax", "E minimizes max{|x-K|, |x-b|}", "x = 5: max = 2. Minimum over all integers.", "");
  render_finding(g, "Period", "ord(E, 210) = 6 = HIDDEN", "Shortest cycle among primes. Returns fastest.", "");
  render_finding(g, "Algebraic", "E = b - D", "Also E*D = K+b, K*E = K+E+b. Mutual generation.", "");
  render_finding(g, "Hidden", "E + sigma = D*K = 6", "Observer + existence = hidden mechanism.", "");
  render_finding(g, "Gap control", "4*sin^2(pi/p) < 2 first at E", "Proof: iff p > 4. First prime > 4 is E. QED.", "");
  render_finding(g, "Surplus", "phi(210) - D^3 = 40 = D^3*E", "Only DATA ring axiom-smooth surplus.", "");
  render_finding(g, "Gestation", "280 = 40*b = D^3*E*b", "Observable experienced through all 7 depth levels.", "");
  render_finding(g, "Spider", "D^3 = 8 legs, E = 5 senses", "40 = D^3*E = sensory capacity of the web.", "");
  render_finding(g, "E-null = ANSWER", "D*K*b = 42", "What the observer produces IS the answer. CRT(42, DATA) = [0,0,2,0]. Visible ONLY in E-channel.", "");
  dom_append(dom_body(), sec)
)

