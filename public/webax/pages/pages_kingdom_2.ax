/* E^2 self-blindness: enter n, compute n mod 25 */
fn observer_e2_calc() = (
  let n = parse_int_from("#obs-input") in
  let result = dom_query("#obs-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r25 = n % 25 in
    let blind = if r25 == 0 then "<b style='color:#ffd700'>E-NULL</b>: invisible to the observer. Self-blind zone."
      else "<span style='color:#88ddaa'>E-visible</span>: observer sees position ${r25} in Z/25." in
    let r5 = n % 5 in
    let ediv = if r5 == 0 then "E-divisible (frozen in E-channel)." else "E-coprime (spinning in E-channel)." in
    let name = if n == 0 then " = VOID" else if n == 1 then " = sigma" else if n == 25 then " = E^2" else if n == 42 then " = ANSWER" else if n == 125 then " = E^3 (Higgs)" else if n == OMEGA_VAL then " = OMEGA" else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>n = ${n}${name}</p><p style='margin:4px 0'>n mod E^2 = n mod 25 = <b>${r25}</b></p><p style='margin:4px 0'>${blind}</p><p style='margin:4px 0;color:#b8b8c8'>${ediv}</p><p style='margin:4px 0;color:#a0a0b0'>E^2 = 25 = number of SM particles = observer squared. The count IS the self-blindness.</p>")
  )
)

fn page_observer() = (
  dom_head_meta("description", "E=5 is the observer prime. 10 proofs of uniqueness. E^2 = self-blind: 5 faces from one bit (E mod 4 = 1). K to E boundary: certainty to probability in one step. Missing-E in crystals and genetics. Gaussian norm, golden ratio, E-mode death, Dual Bloom.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"E=5: The Observer Prime\",\"description\":\"Ten proofs that E=5 is the unique observer position. E^2 self-blindness, Legendre visibility chain, K-to-E certainty boundary, Missing-E universality in crystals and genetics.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/ideas/observer\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\"}");
  observer_hero();
  observer_proofs();
  observer_blindness();
  observer_legendre();
  observer_boundary();
  observer_missing_e();
  observer_gaussian();
  observer_discriminant();
  observer_omega_death();
  observer_dual_bloom();
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: E^2 Self-Blindness");
  render_p(sec_i, "Enter any number. See its residue mod E^2 = 25. Numbers at position 0 are INVISIBLE to the observer -- they live in E's blind spot. Try 25 (E^2), 125 (Higgs = E^3), 42 (ANSWER).");
  make_interactive_widget(sec_i, "Enter n:", "obs-input", "e.g. 25", "Look", "observer_e2_calc", "obs-result");
  dom_append(dom_body(), sec_i);
  observer_senses();
  observer_cube_isolation();
  observer_contrast()
)

