/* observer_cube_isolation CUT S1980: D^3=8 cube embedding is insider framework. Spider references. */

fn observer_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard View");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "5^2 mod 5 = 0", "Trivially true for any prime", "5 is the only chain prime where this self-nullification has spectral consequences (symmetric moments).");
  render_contrast_row(tbl, "5-fold symmetry", "Forbidden by lattice periodicity", "cos(2pi/5) is irrational. 5 is excluded from periodic crystal lattices.");
  render_contrast_row(tbl, "Golden ratio", "Aesthetic preference", "phi = (1+sqrt(5))/2. Discriminant of p^2-p-1 is 5. PROVED.");
  render_contrast_row(tbl, "Mod-3 to mod-5 cliff", "Gap statistics change", "Mutual information drops 28x in one step. Deterministic at mod 3, statistical at mod 5.");
  dom_append(dom_body(), sec)
)

/* E^2 self-blindness: enter n, compute n mod 25 */
fn observer_e2_calc() = (
  let n = parse_int_from("#obs-input") in
  let result = dom_query("#obs-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r25 = n % 25 in
    let blind = if r25 == 0 then "<b style='color:#ffd700'>Zero mod 25</b>: in the blind spot. Divisible by 25."
      else "<span style='color:#88ddaa'>Nonzero mod 25</span>: position ${r25} in Z/25." in
    let r5 = n % 5 in
    let ediv = if r5 == 0 then "Divisible by 5 (frozen in mod-5 channel)." else "Coprime to 5 (active in mod-5 channel)." in
    let name = if n == 0 then " = zero" else if n == 1 then " = identity" else if n == 25 then " = 5^2" else if n == 125 then " = 5^3" else if n == OMEGA_VAL then " = 2^420 mod 12612600" else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>n = ${n}${name}</p><p style='margin:4px 0'>n mod 25 = <b>${r25}</b></p><p style='margin:4px 0'>${blind}</p><p style='margin:4px 0;color:#b8b8c8'>${ediv}</p>")
  )
)

fn page_observer() = (
  dom_head_meta("description", "5 is the self-blind prime: 5^2 = 0 mod 5. Symmetric eigenvalue distribution. Legendre symbol (5|p) across chain primes. Mod-3 to mod-5 cliff: mutual information drops 28x. Discriminant of x^2-5x+5 equals 5.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"5: The Self-Blind Prime\",\"description\":\"5 is the arithmetic mean of 3 and 7. Its square vanishes mod 5 (self-nullification). Legendre symbol pattern across chain primes. Mod-3 to mod-5 boundary: determinism to randomness. Discriminant of x^2-5x+5 equals 5.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/ideas/observer\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\"}");
  observer_hero();
  observer_proofs();
  observer_blindness();
  observer_legendre();
  observer_boundary();
  observer_discriminant();
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Mod-25 Residue");
  render_p(sec_i, "Enter any number to see its residue mod 25. Numbers at position 0 are in the blind spot -- divisible by 5^2. Try 25, 125 (= 5^3), 210.");
  make_interactive_widget(sec_i, "Enter n:", "obs-input", "e.g. 25", "Look", "observer_e2_calc", "obs-result");
  dom_append(dom_body(), sec_i);
  observer_contrast()
)

