   is small-numbers mythology (7 crystal systems = coincidence, 1651 BW groups = thin). */

/* observer_gaussian CUT S1980: KEY/ADDRESS named constants, FACE PRINCIPLE mythology.
   Gaussian splitting already covered in observer_blindness. */

fn observer_discriminant() = (
  let sec = make_section("800px") in
  render_h2(sec, "Self-Referential Discriminant");
  render_theorem(sec, "Discriminant = 5 (PROVED)",
    "The polynomial x^2 - 5x + 5 has discriminant 5^2 - 4*5 = 5(5-4) = 5. Among chain primes, only 5 gives a nonzero discriminant for x^2 - px + p: for p = 2 the discriminant is 2(2-4) = -4, and for p = 3 it is 3(3-4) = -3. At p = 5: disc = 5. The polynomial's discriminant equals the prime itself.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Identity");
  render_th(hdr, "Value");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row(tbl, "disc(x^2 - 5x + 5)", "5", "Self-referential: the discriminant equals the prime.");
  render_table_row(tbl, "5^2 mod 5", "0", "Self-nullification in its own channel.");
  render_table_row(tbl, "2^(-1) mod 25", "13", "The modular inverse of 2 in mod 25 is 13.");
  render_table_row(tbl, "(25-1)/2 + 1", "13", "The number of equivalence classes in mod 25 is also 13.");
  render_table_row(tbl, "25 + 1", "26 = 2 * 13", "5^2 + 1 factors as 2 * 13.");
  render_p(sec, "The number 13 appears from 5 in multiple independent ways: as the modular inverse of 2 in Z/25, as the class count (25-1)/2+1, and from 5^2+1 = 2*13. These are proved arithmetic identities, not coincidences -- they follow from 5 = 1 mod 4.");
  dom_append(dom_body(), sec)
)

