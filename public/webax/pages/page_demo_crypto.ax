/* page_demo_crypto.ax -- Crypto demo pages: hash, stego, key_exchange. Split from page_demos.ax. */

/* S1820 L17: CRT-native hybrid mode for demos module.
   With raw_mode(1) from core.ax + crt_mode(1) here, only crt_-prefix
   functions get CRT decomposition. All other functions stay plain i32.
   A7 BUG: cprop leaks % N_TRANS into non-CRT fns. Use dm_red() not % nn. */
crt_mode(1)

/* ================================================================
   CRT-NATIVE HASH (L17) — 7-channel ring LCG in Z/214414200.
   With crt_mode(1), * and + are automatic CRT operations. The compiler
   decomposes each value into 7 channels, operates per-channel, and
   reconstructs at return. 6 lines replaces ~45 lines of manual CRT.
   Multiplier 29: residues (5,2,4,29,7,3,12) — non-trivial in ALL channels.
   Salt 43: residues (3,7,18,43,10,4,9) — good round diffusion.
   ================================================================ */
fn crt_hash(n) = (
  mut x = n * 29 + 1;
  mut rd = 0;
  while rd < 8 do (
    mut x = x * 29 + rd * 43 + n;
    mut rd = rd + 1
  );
  x
)

/* Handler: compute CRT-native hash and display with avalanche test */
fn native_hash_run() = (
  let n = parse_int_from("#dhash-native-input") in
  let result_el = dom_query("#dhash-native-result") in
  let h = crt_hash(n) in
  let hd = h % 8 in let hk = h % 9 in let he = h % 25 in let hb = h % 49 in let hl = h % 11 in let hg = h % 13 in let hesc = h % 17 in
  let h2 = crt_hash(n + 1) in
  let h2d = h2 % 8 in let h2k = h2 % 9 in let h2e = h2 % 25 in let h2b = h2 % 49 in let h2l = h2 % 11 in let h2g = h2 % 13 in let h2esc = h2 % 17 in
  let diff = (if hd == h2d then 0 else 1) + (if hk == h2k then 0 else 1) + (if he == h2e then 0 else 1) + (if hb == h2b then 0 else 1) + (if hl == h2l then 0 else 1) + (if hg == h2g then 0 else 1) + (if hesc == h2esc then 0 else 1) in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#00dddd;margin:0 0 8px'>CRT-NATIVE HASH (8 rounds, 7-channel ring LCG in Z/214414200)</p><p style='color:#88ddaa;margin:4px 0'><b>crt_hash(" + "${n}" + ") = " + "${h}" + "</b></p><p style='color:#b0b0c0;margin:4px 0'>CRT = (" + "${hd}" + ", " + "${hk}" + ", " + "${he}" + ", " + "${hb}" + ", " + "${hl}" + ", " + "${hg}" + ", " + "${hesc}" + ")</p><p style='color:#00dddd;margin:12px 0 4px'>AVALANCHE TEST</p><p style='color:#88ddaa;margin:4px 0'>crt_hash(" + "${n + 1}" + ") = " + "${h2}" + "</p><p style='color:#b0b0c0;margin:4px 0'>CRT = (" + "${h2d}" + ", " + "${h2k}" + ", " + "${h2e}" + ", " + "${h2b}" + ", " + "${h2l}" + ", " + "${h2g}" + ", " + "${h2esc}" + ")</p><p style='color:" + (if diff > 4 then "#44ff88" else "#ff8844") + ";margin:4px 0'>Channels changed: <b>" + "${diff}" + "/7</b>" + (if diff > 4 then " -- good diffusion" else "") + "</p></div>")
)

fn native_hash_batch() = (
  let result_el = dom_query("#dhash-native-batch-result") in
  mut total_diff = 0;
  mut perfect = 0;
  mut i = 0;
  while i < 100 do (
    let h1 = crt_hash(i) in
    let h2 = crt_hash(i + 1) in
    let d = (if h1 % 8 == h2 % 8 then 0 else 1) + (if h1 % 9 == h2 % 9 then 0 else 1) + (if h1 % 25 == h2 % 25 then 0 else 1) + (if h1 % 49 == h2 % 49 then 0 else 1) + (if h1 % 11 == h2 % 11 then 0 else 1) + (if h1 % 13 == h2 % 13 then 0 else 1) + (if h1 % 17 == h2 % 17 then 0 else 1) in
    mut total_diff = total_diff + d;
    if d == 7 then mut perfect = perfect + 1 else 0;
    mut i = i + 1
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#00dddd;margin:0 0 8px'>CRT-NATIVE BATCH: 100 consecutive pairs (7 channels)</p><p style='color:#88ddaa;margin:4px 0'>Average channels changed: <b>" + "${total_diff / 100}" + "." + "${(total_diff * 10 / 100) % 10}" + "/7</b></p><p style='color:#b0b0c0;margin:4px 0'>Perfect avalanche (7/7): <b>" + "${perfect}" + "/100</b></p></div>")
)

/* CRT-NATIVE KEY EXCHANGE — 7-channel Diffie-Hellman in Z/214414200.
   Generator 44755427: CRT = (3,2,2,3,2,2,3) — primitive roots in all channels.
   Z/9(2), Z/25(2), Z/49(3), Z/11(2), Z/13(2), Z/17(3). Z/8(3, order 2).
   With crt_mode(1), binary exponentiation does per-channel powmod automatically.
   10 lines replace ~60 lines of manual per-channel DH. Lambda = 1680. */
fn crt_kex_pow(base, exp) = (
  mut result = 1;
  mut bp = base;
  mut e = exp;
  while e > 0 do (
    if e % 2 == 1 then mut result = result * bp else 0;
    mut bp = bp * bp;
    mut e = e / 2
  );
  result
)

/* Modular multiply for CRT reconstruction. a small (0-48), bb up to N-1. */
fn dm_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

/* ================================================================
   MANUAL CRT HASH — 7-channel Feistel (~45 lines).
   Kept for comparison with CRT-native (6 lines). CC0.
   ================================================================ */

/* dm_red: reduce sum of two values < nn to [0, nn). Avoids % N_TRANS (compiler CRT bug). */
fn dm_red(x) = (let m = 214414200 in if x >= m then x - m else x)

fn demo_hash7(n) = (
  let nn = 214414200 in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let n0 = if n >= nn then n - nn else if n < 0 then 0 else n in
  let x0 = dm_mulmod(137, n0) + 1 in
  mut ch0 = x0 % 8;
  mut ch1 = x0 % 9;
  mut ch2 = x0 % 25;
  mut ch3 = x0 % 49;
  mut ch4 = x0 % 11;
  mut ch5 = x0 % 13;
  mut ch6 = x0 % 17;
  mut rd = 0;
  while rd < 8 do (
    let a0 = (ch0 * 3 + ch1 + ch4 * 2 + rd + 1) % 8 in
    let a1 = (ch1 * 2 + ch2 + ch0 * 2 + rd + 1) % 9 in
    let a2 = (ch2 * 2 + ch3 + ch1 * 2 + rd + 1) % 25 in
    let a3 = (ch3 * 3 + ch4 + ch2 * 2 + rd + 1) % 49 in
    let a4 = (ch4 * 2 + ch0 + ch3 * 2 + rd + 1) % 11 in
    let a5 = (ch5 * 2 + ch0 + ch4 * 2 + rd + 1) % 13 in
    let a6 = (ch6 * 3 + ch5 + ch3 * 2 + rd + 1) % 17 in
    let r0 = dm_mulmod(a0, idem[0]) in
    let r1 = dm_red(r0 + dm_mulmod(a1, idem[1])) in
    let r2 = dm_red(r1 + dm_mulmod(a2, idem[2])) in
    let r3 = dm_red(r2 + dm_mulmod(a3, idem[3])) in
    let r4 = dm_red(r3 + dm_mulmod(a4, idem[4])) in
    let r5 = dm_red(r4 + dm_mulmod(a5, idem[5])) in
    let v = dm_red(r5 + dm_mulmod(a6, idem[6])) in
    let x1 = dm_mulmod(137, v) + rd * 41 + n0 in
    mut ch0 = x1 % 8;
    mut ch1 = x1 % 9;
    mut ch2 = x1 % 25;
    mut ch3 = x1 % 49;
    mut ch4 = x1 % 11;
    mut ch5 = x1 % 13;
    mut ch6 = x1 % 17;
    mut rd = rd + 1
  );
  let r0 = dm_mulmod(ch0, idem[0]) in
  let r1 = dm_red(r0 + dm_mulmod(ch1, idem[1])) in
  let r2 = dm_red(r1 + dm_mulmod(ch2, idem[2])) in
  let r3 = dm_red(r2 + dm_mulmod(ch3, idem[3])) in
  let r4 = dm_red(r3 + dm_mulmod(ch4, idem[4])) in
  let r5 = dm_red(r4 + dm_mulmod(ch5, idem[5])) in
  dm_red(r5 + dm_mulmod(ch6, idem[6]))
)

fn demo_hash_run() = (
  let n = parse_int_from("#dhash-input") in
  let result_el = dom_query("#dhash-result") in
  let h = demo_hash7(n) in
  let hd = h % 8 in let hk = h % 9 in let he = h % 25 in let hb = h % 49 in let hl = h % 11 in let hg = h % 13 in let hesc = h % 17 in
  let h2 = demo_hash7(n + 1) in
  let h2d = h2 % 8 in let h2k = h2 % 9 in let h2e = h2 % 25 in let h2b = h2 % 49 in let h2l = h2 % 11 in let h2g = h2 % 13 in let h2esc = h2 % 17 in
  let diff = (if hd == h2d then 0 else 1) + (if hk == h2k then 0 else 1) + (if he == h2e then 0 else 1) + (if hb == h2b then 0 else 1) + (if hl == h2l then 0 else 1) + (if hg == h2g then 0 else 1) + (if hesc == h2esc then 0 else 1) in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT HASH (8 rounds, 7-channel Feistel in Z/214,414,200)</p><p style='color:#88ddaa;margin:4px 0'><b>hash(" + "${n}" + ") = " + "${h}" + "</b></p><p style='color:#b0b0c0;margin:4px 0'>CRT = (" + "${hd}" + ", " + "${hk}" + ", " + "${he}" + ", " + "${hb}" + ", " + "${hl}" + ", " + "${hg}" + ", " + "${hesc}" + ")</p><p style='color:#ffd700;margin:12px 0 4px'>AVALANCHE TEST</p><p style='color:#88ddaa;margin:4px 0'>hash(" + "${n + 1}" + ") = " + "${h2}" + "</p><p style='color:#b0b0c0;margin:4px 0'>CRT = (" + "${h2d}" + ", " + "${h2k}" + ", " + "${h2e}" + ", " + "${h2b}" + ", " + "${h2l}" + ", " + "${h2g}" + ", " + "${h2esc}" + ")</p><p style='color:" + (if diff > 5 then "#44ff88" else "#ff8844") + ";margin:4px 0'>Channels changed: <b>" + "${diff}" + "/7</b>" + (if diff > 5 then " -- good diffusion" else "") + "</p></div>")
)

fn demo_hash_batch() = (
  let result_el = dom_query("#dhash-batch-result") in
  mut total_diff = 0;
  mut perfect = 0;
  mut i = 0;
  while i < 100 do (
    let h1 = demo_hash7(i) in
    let h2 = demo_hash7(i + 1) in
    let d = (if h1 % 8 == h2 % 8 then 0 else 1) + (if h1 % 9 == h2 % 9 then 0 else 1) + (if h1 % 25 == h2 % 25 then 0 else 1) + (if h1 % 49 == h2 % 49 then 0 else 1) + (if h1 % 11 == h2 % 11 then 0 else 1) + (if h1 % 13 == h2 % 13 then 0 else 1) + (if h1 % 17 == h2 % 17 then 0 else 1) in
    mut total_diff = total_diff + d;
    if d == 7 then mut perfect = perfect + 1 else 0;
    mut i = i + 1
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH AVALANCHE: 100 consecutive pairs (7 channels)</p><p style='color:#88ddaa;margin:4px 0'>Average channels changed: <b>" + "${total_diff / 100}" + "." + "${(total_diff * 10 / 100) % 10}" + "/7</b></p><p style='color:#b0b0c0;margin:4px 0'>Perfect avalanche (7/7): <b>" + "${perfect}" + "/100</b></p></div>")
)

/* Bit-level avalanche: count differing bits between two integers.
   Check 28 bit positions (log2(214414200) ~ 27.7). */
fn hash_bit_diff(a, b) = (
  mut diff = 0;
  mut p = 0;
  mut pa = a;
  mut pb = b;
  while p < 28 do (
    if pa % 2 != pb % 2 then (mut diff = diff + 1) else 0;
    mut pa = pa / 2;
    mut pb = pb / 2;
    mut p = p + 1
  );
  diff
)

/* Bit-level avalanche batch: hash 1000 consecutive pairs, measure bit differences */
fn demo_hash_bit_avalanche() = (
  let result_el = dom_query("#dhash-bit-result") in
  mut total_bits = 0;
  mut min_bits = 28;
  mut max_bits = 0;
  mut i = 0;
  while i < 1000 do (
    let h1 = demo_hash7(i) in
    let h2 = demo_hash7(i + 1) in
    let bd = hash_bit_diff(h1, h2) in
    mut total_bits = total_bits + bd;
    if bd < min_bits then (mut min_bits = bd) else 0;
    if bd > max_bits then (mut max_bits = bd) else 0;
    mut i = i + 1
  );
  let avg10 = total_bits * 10 / 1000 in
  let avg_whole = avg10 / 10 in
  let avg_frac = avg10 - avg_whole * 10 in
  /* Ideal: 50% of 28 bits = 14.0 */
  let pct10 = avg10 * 100 / 140 in
  let pct_whole = pct10 / 10 in
  let pct_frac = pct10 - pct_whole * 10 in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BIT-LEVEL AVALANCHE: 1000 consecutive pairs (28-bit)</p><p style='color:#88ddaa;margin:4px 0'>Average bits changed: <b>${avg_whole}.${avg_frac} / 28</b></p><p style='color:#b0b0c0;margin:4px 0'>Min: ${min_bits}  Max: ${max_bits}  Ideal: 14.0 (50%)</p><p style='color:" + (if pct_whole > 40 then "#44ff88" else "#ff8844") + ";margin:4px 0'>Achieved: <b>${pct_whole}.${pct_frac}%</b> of ideal 50% avalanche</p><p style='color:#666;margin:8px 0 0;font-size:12px'>SHA-256 achieves ~49.8% on same test. CRT hash has ~27.7-bit output space vs SHA-256 256-bit.</p></div>")
)

fn page_hash() = (
  dom_head_meta("description", "CRT Hash Function. 7-channel Feistel network over Z/214,414,200. 8 rounds. Pure ring arithmetic. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Hash Function\",\"description\":\"7-channel Feistel hash over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/hash\"}");
  let hero = make_hero("CRT Hash") in
  let eq = dom_create("div") in
  dom_text(eq, "Crypto hash patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT decomposition IS a hash function. Decompose into 7 independent channels, mix per-channel with primitive roots, fold through CRT reconstruction. 8 rounds. Pure ring arithmetic. No XOR, no bit shifts, no lookup tables.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Hash Principle", "Every integer has a UNIQUE 7-dimensional CRT address in Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17. Per-channel mixing with generators {3,2,2,3,2,2,3} creates nonlinearity. Cross-channel addition creates diffusion. CRT reconstruction folds channels back. After 8 rounds, no channel remembers the input alone.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 parallel lanes", "CRT decomposition", "7 independent mixing networks. Each uses a different primitive root.", "");
  render_finding(g1, "Cross diffusion", "Neighbor injection", "Each channel absorbs 2 neighbors per round. After 3 rounds, every channel influenced by every other.", "");
  render_finding(g1, "CRT fold", "Bijection breaker", "Reconstruct to integer, multiply by 137, re-decompose.", "");
  render_finding(g1, "8 rounds", "Full diffusion", "By round 8, each output depends on every input. Natural from algebraic independence.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Hash an integer, 0-214414199:", "dhash-input", "e.g. 42", "Hash", "demo_hash_run", "dhash-result");
  render_p(sec2, "Try: 42 vs 43 (avalanche), 137, 26801776 (2^1680 mod 214414200), 0.");
  dom_append(dom_body(), sec2);
  let sec3h = make_section("800px") in
  render_h2(sec3h, "Batch Avalanche Test");
  render_p(sec3h, "Hash 100 consecutive pairs and measure average channel diffusion.");
  let btn = dom_create("button") in
  dom_text(btn, "Run Batch (100 pairs)");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "8px 16px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "borderRadius", "4px");
  dom_on(btn, "click", "demo_hash_batch");
  dom_append(sec3h, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dhash-batch-result");
  dom_append(sec3h, br);
  dom_append(dom_body(), sec3h);
  /* Bit-level avalanche benchmark */
  let sec4h = make_section("800px") in
  render_h2(sec4h, "Bit-Level Avalanche Benchmark");
  render_p(sec4h, "Channel avalanche (above) measures how many CRT channels change. Bit-level avalanche measures how many individual bits flip in the output. SHA-256 ideal: ~50% of 256 bits. CRT hash ideal: 50% of ~28 bits = 14.0 bits.");
  let btn4 = dom_create("button") in
  dom_text(btn4, "Run Bit Avalanche (1000 pairs)");
  dom_style(btn4, "background", "#ffd700");
  dom_style(btn4, "color", "#0f0f2a");
  dom_style(btn4, "border", "none");
  dom_style(btn4, "padding", "8px 16px");
  dom_style(btn4, "cursor", "pointer");
  dom_style(btn4, "fontFamily", "'Courier New', monospace");
  dom_style(btn4, "fontWeight", "bold");
  dom_style(btn4, "borderRadius", "4px");
  dom_on(btn4, "click", "demo_hash_bit_avalanche");
  dom_append(sec4h, btn4);
  let br4 = dom_create("div") in
  dom_attr(br4, "id", "dhash-bit-result");
  dom_append(sec4h, br4);
  dom_append(dom_body(), sec4h);
  /* CRT-Native comparison section (L17) */
  let sec_native = make_section("800px") in
  render_h2(sec_native, "CRT-Native: ~45 Lines to 6 Lines");
  render_theorem(sec_native, "Language Revolution", "With crt_mode(1), the .ax compiler automatically decomposes * and + into 7 per-channel CRT operations. A ring hash becomes pure algebra: multiply, add, iterate. No manual % 8, % 9. No idempotent reconstruction. No mulmod to avoid overflow. The CRT structure lives in the TYPE, not the CODE.");
  let gn = make_findings_grid(sec_native) in
  render_finding(gn, "Old: ~45 lines", "Manual CRT", "Explicit % 8, % 9, ... % 17. Explicit idempotent array. mulmod for each channel. 7-channel Feistel with cross-channel mixing by hand.", "");
  render_finding(gn, "New: 6 lines", "CRT-native", "fn crt_hash(n) = ( mut x = n*29+1; while rd<8 do x=x*29+rd*43+n ). Ring arithmetic. Period.", "");
  render_finding(gn, "Same ring", "Both Z/214,414,200", "Both manual and CRT-native use 7 channels over Z/214,414,200. The compiler eliminates the boilerplate.", "");
  render_finding(gn, "Multiplier 29", "(5,2,4,29,7,3,12)", "Non-trivial residue in ALL 7 CRT channels. Every channel gets mixed per round.", "");
  make_interactive_widget(sec_native, "CRT-native hash, 0-214414199:", "dhash-native-input", "e.g. 42", "CRT Hash", "native_hash_run", "dhash-native-result");
  let btn_nb = dom_create("button") in
  dom_text(btn_nb, "Run Native Batch (100 pairs)");
  dom_style(btn_nb, "background", "#00dddd");
  dom_style(btn_nb, "color", "#0f0f2a");
  dom_style(btn_nb, "border", "none");
  dom_style(btn_nb, "padding", "8px 16px");
  dom_style(btn_nb, "cursor", "pointer");
  dom_style(btn_nb, "fontFamily", "'Courier New', monospace");
  dom_style(btn_nb, "fontWeight", "bold");
  dom_style(btn_nb, "borderRadius", "4px");
  dom_style(btn_nb, "marginTop", "12px");
  dom_on(btn_nb, "click", "native_hash_batch");
  dom_append(sec_native, btn_nb);
  let br_nb = dom_create("div") in
  dom_attr(br_nb, "id", "dhash-native-batch-result");
  dom_append(sec_native, br_nb);
  dom_append(dom_body(), sec_native);
  let sec5 = make_section("800px") in
  render_h2(sec5, "CRT Hash vs Traditional");
  render_contrast_row(sec5, "Structure", "SHA-256: 64 rounds of bit manipulation", "CRT: 8 rounds of ring arithmetic over 7 channels");
  render_contrast_row(sec5, "Mixing", "XOR + rotate + shift", "Primitive root multiplication per channel");
  render_contrast_row(sec5, "Output space", "2^256 (~77 digits)", "214,414,200 (~27.7 bits)");
  render_contrast_row(sec5, "Collision resistance", "128 bits (birthday bound)", "~13.8 bits (birthday bound on ~27.7-bit output)");
  render_contrast_row(sec5, "Patent status", "NIST standardized, royalty-free", "CC0. Public domain. Forever.");
  render_p(sec5, "HONEST ASSESSMENT: CRT hash is an educational demonstration of ring arithmetic hash construction. It is NOT a replacement for SHA-256. The output space (~27.7 bits) is far too small for cryptographic use. Value: exploring how algebraic structure provides mixing and diffusion, and how CRT-native compilation eliminates manual channel management.");

)

/* ================================================================
   CRT STEGANOGRAPHY -- dedicated demo page /demos/stego. CC0.
   Hide data in CRT channel residues. 7 channels over Z/214,414,200.
   ================================================================ */

fn demo_stego_encode(carrier, secret) = (
  /* Hide secret in mod-8 channel (low 3 bits of CRT) */
  let nn = 214414200 in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let ck = carrier % 9 in let ce = carrier % 25 in
  let cb = carrier % 49 in let cl = carrier % 11 in let cg = carrier % 13 in let cesc = carrier % 17 in
  let sd = secret % 8 in
  /* Replace mod-8 channel with secret, keep others intact */
  let r0 = dm_mulmod(sd, idem[0]) in
  let r1 = dm_red(r0 + dm_mulmod(ck, idem[1])) in
  let r2 = dm_red(r1 + dm_mulmod(ce, idem[2])) in
  let r3 = dm_red(r2 + dm_mulmod(cb, idem[3])) in
  let r4 = dm_red(r3 + dm_mulmod(cl, idem[4])) in
  let r5 = dm_red(r4 + dm_mulmod(cg, idem[5])) in
  dm_red(r5 + dm_mulmod(cesc, idem[6]))
)

fn demo_stego_run() = (
  let carrier = parse_int_from("#dsteg-carrier") in
  let secret = parse_int_from("#dsteg-secret") in
  let result_el = dom_query("#dsteg-result") in
  let nn = 214414200 in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let c = if carrier >= nn then carrier - nn else if carrier < 0 then 0 else carrier in
  let s = secret % 256 in
  let cd = c % 8 in let ck = c % 9 in let ce = c % 25 in
  let cb = c % 49 in let cl = c % 11 in let cg = c % 13 in let cesc = c % 17 in
  /* Encode: hide 3 bits in mod-8, ~3.2 bits in mod-9 (total ~6.2 bits, 72 values) */
  let s_lo = s % 8 in let s_hi = s / 8 in
  let r0 = dm_mulmod(s_lo, idem[0]) in
  let r1 = dm_red(r0 + dm_mulmod(s_hi % 9, idem[1])) in
  let r2 = dm_red(r1 + dm_mulmod(ce, idem[2])) in
  let r3 = dm_red(r2 + dm_mulmod(cb, idem[3])) in
  let r4 = dm_red(r3 + dm_mulmod(cl, idem[4])) in
  let r5 = dm_red(r4 + dm_mulmod(cg, idem[5])) in
  let stego = dm_red(r5 + dm_mulmod(cesc, idem[6])) in
  let st_d = stego % 8 in let st_k = stego % 9 in let st_e = stego % 25 in
  let st_b = stego % 49 in let st_l = stego % 11 in let st_g = stego % 13 in let st_esc = stego % 17 in
  /* Distortion: how many channels changed? */
  let changed = (if cd == st_d then 0 else 1) + (if ck == st_k then 0 else 1) + (if ce == st_e then 0 else 1) + (if cb == st_b then 0 else 1) + (if cl == st_l then 0 else 1) + (if cg == st_g then 0 else 1) + (if cesc == st_esc then 0 else 1) in
  /* Extract */
  let extracted = st_d + (st_k * 8) in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT STEGANOGRAPHY (7 channels, Z/214,414,200)</p><p style='color:#b0b0c0;margin:4px 0'>Carrier: " + "${c}" + " = (" + "${cd}" + "," + "${ck}" + "," + "${ce}" + "," + "${cb}" + "," + "${cl}" + "," + "${cg}" + "," + "${cesc}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>Secret byte: " + "${s}" + " (lo=" + "${s_lo}" + " hi=" + "${s_hi % 9}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Stego: " + "${stego}" + " = (" + "${st_d}" + "," + "${st_k}" + "," + "${st_e}" + "," + "${st_b}" + "," + "${st_l}" + "," + "${st_g}" + "," + "${st_esc}" + ")</p><p style='color:" + (if changed < 3 then "#44ff88" else "#ff8844") + ";margin:4px 0'>Channels modified: " + "${changed}" + "/7 (mod 25, 49, 11, 13, 17 untouched)</p><p style='color:#ffd700;margin:12px 0 4px'>EXTRACTION</p><p style='color:#88ddaa;margin:4px 0'>Extracted: mod-8 + mod-9 * 8 = " + "${extracted}" + (if extracted == s then " CORRECT" else " MISMATCH") + "</p></div>")
)

fn page_stego() = (
  dom_head_meta("description", "CRT Steganography. Hide data in CRT channel residues over Z/214,414,200. 7 channels. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Steganography\",\"description\":\"Hide data in CRT channel residues over Z/214414200. 7 channels. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/stego\"}");
  let hero = make_hero("CRT Steganography") in
  let eq = dom_create("div") in
  dom_text(eq, "Steganography patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT channels are algebraically independent. Replace mod-8 and mod-9 channels with secret data -- the remaining 5 channels (mod 25, 49, 11, 13, 17) are untouched. The stego value is still a valid ring element. The secret is invisible to anyone who doesn't know which channels to read.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Steganographic Principle", "Any element of Z/214,414,200 has 7 independent CRT residues. Modifying mod-8 (3 bits) and mod-9 (~3.2 bits) channels embeds ~6.2 bits per carrier value. The other 5 channels carry the original signal undistorted. CRT independence means the hidden data is algebraically invisible in the mod-25, 49, 11, 13, 17 subspace.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "Channel hiding", "CRT independence", "Secret data replaces 2 inner channels. 5 outer channels untouched.", "");
  render_finding(g1, "Capacity", "3 + 3.2 bits", "mod-8 (3 bits) + mod-9 (~3.2 bits) = 72 values per carrier.", "");
  render_finding(g1, "Invisibility", "Algebraic orthogonality", "5 of 7 channels unchanged. No statistical distortion in 71% of channels.", "");
  render_finding(g1, "Extraction", "Modular arithmetic", "Read mod-8 and mod-9 channels. Reconstruct secret. Lossless.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Carrier value:", "dsteg-carrier", "e.g. 1000000", "Encode", "demo_stego_run", "dsteg-result");
  let extras = dom_create("div") in
  dom_style(extras, "display", "flex");
  dom_style(extras, "gap", "8px");
  dom_style(extras, "alignItems", "center");
  dom_style(extras, "marginBottom", "12px");
  let inp_s = dom_create("input") in
  dom_attr(inp_s, "type", "text");
  dom_attr(inp_s, "id", "dsteg-secret");
  dom_attr(inp_s, "placeholder", "secret byte (0-71)");
  dom_attr(inp_s, "value", "42");
  dom_style(inp_s, "background", "#111");
  dom_style(inp_s, "color", "#eee");
  dom_style(inp_s, "border", "1px solid #333");
  dom_style(inp_s, "padding", "6px 8px");
  dom_style(inp_s, "fontFamily", "'Courier New', monospace");
  dom_style(inp_s, "width", "120px");
  dom_append(extras, inp_s);
  dom_append(sec2, extras);
  render_p(sec2, "Secret range: 0-71 (8 * 9 = 72 values). mod-8 carries low 3 bits, mod-9 carries high bits.");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Stego vs Traditional");
  render_contrast_row(sec3, "Hiding method", "LSB modification (fragile)", "CRT channel replacement (algebraic)");
  render_contrast_row(sec3, "Distortion", "All bits slightly perturbed", "Only mod-8 and mod-9 changed; 5 channels exact");
  render_contrast_row(sec3, "Detection", "Statistical analysis can reveal", "5/7 channels have zero distortion");
  render_contrast_row(sec3, "Extraction", "Bit masking (position-dependent)", "Modular arithmetic (position-free)");
  render_contrast_row(sec3, "Patent status", "DRM/watermarking patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   CRT KEY EXCHANGE -- dedicated demo page /demos/key_exchange. CC0.
   CRT Diffie-Hellman over Z/214,414,200. 7 channels.
   ================================================================ */

/* Handler: CRT-native Diffie-Hellman. 7 channels. */
fn native_kex_run() = (
  let alice_secret = parse_int_from("#dkex-native-alice") in
  let bob_secret = parse_int_from("#dkex-native-bob") in
  let result_el = dom_query("#dkex-native-result") in
  let a = alice_secret % 1680 in
  let bsec = bob_secret % 1680 in
  let g = 44755427 in
  let alice_pub = crt_kex_pow(g, a) in
  let bob_pub = crt_kex_pow(g, bsec) in
  let shared_a = crt_kex_pow(bob_pub, a) in
  let shared_b = crt_kex_pow(alice_pub, bsec) in
  let ad = alice_pub % 8 in let ak = alice_pub % 9 in let ae = alice_pub % 25 in
  let abt = alice_pub % 49 in let al = alice_pub % 11 in let ag = alice_pub % 13 in
  let a17 = alice_pub % 17 in
  let bbd = bob_pub % 8 in let bbk = bob_pub % 9 in let bbe = bob_pub % 25 in
  let bbt = bob_pub % 49 in let bbl = bob_pub % 11 in let bbg = bob_pub % 13 in
  let bb17 = bob_pub % 17 in
  let sd = shared_a % 8 in let sk = shared_a % 9 in let se = shared_a % 25 in
  let sbt = shared_a % 49 in let sl = shared_a % 11 in let sgt = shared_a % 13 in
  let s17 = shared_a % 17 in
  let ch_ok = (if sd == shared_b % 8 then 1 else 0) + (if sk == shared_b % 9 then 1 else 0) + (if se == shared_b % 25 then 1 else 0) + (if sbt == shared_b % 49 then 1 else 0) + (if sl == shared_b % 11 then 1 else 0) + (if sgt == shared_b % 13 then 1 else 0) + (if s17 == shared_b % 17 then 1 else 0) in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#00dddd;margin:0 0 8px'>CRT-NATIVE KEY EXCHANGE (7-channel DH in Z/214414200)</p><p style='color:#b0b0c0;margin:4px 0'>Alice secret: " + "${a}" + " | Bob secret: " + "${bsec}" + " (mod 1680 = Carmichael lambda)</p><p style='margin:8px 0 4px;color:#00dddd'>Public keys (7-channel CRT)</p><p style='color:#b0b0c0;margin:4px 0'>Alice: " + "${alice_pub}" + " = (" + "${ad}" + "," + "${ak}" + "," + "${ae}" + "," + "${abt}" + "," + "${al}" + "," + "${ag}" + "," + "${a17}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>Bob: " + "${bob_pub}" + " = (" + "${bbd}" + "," + "${bbk}" + "," + "${bbe}" + "," + "${bbt}" + "," + "${bbl}" + "," + "${bbg}" + "," + "${bb17}" + ")</p><p style='margin:8px 0 4px;color:#00dddd'>Shared secret</p><p style='color:#88ddaa;margin:4px 0'>Shared: " + "${shared_a}" + " = (" + "${sd}" + "," + "${sk}" + "," + "${se}" + "," + "${sbt}" + "," + "${sl}" + "," + "${sgt}" + "," + "${s17}" + ")</p><p style='color:" + (if ch_ok == 7 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>Channel agreement: " + "${ch_ok}" + "/7" + (if ch_ok == 7 then " -- KEYS MATCH" else " -- MISMATCH") + "</p></div>")
)

fn demo_powmod(base, exp, m) = (
  mut result = 1;
  mut bp = base % m;
  mut e = exp;
  while e > 0 do (
    if e % 2 == 1 then mut result = (result * bp) % m else 0;
    mut bp = (bp * bp) % m;
    mut e = e / 2
  );
  result
)

fn demo_kex_run() = (
  let alice_secret = parse_int_from("#dkex-alice") in
  let bob_secret = parse_int_from("#dkex-bob") in
  let result_el = dom_query("#dkex-result") in
  let a = alice_secret % 1680 in
  let b = bob_secret % 1680 in
  let nn = 214414200 in
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  /* Per-channel DH: generator g, modulus m */
  let g = [3, 2, 2, 3, 2, 2, 3] in
  let mods = CRT_MODS_TRANS in
  /* Alice public: g^a mod m per channel */
  let ap0 = demo_powmod(g[0], a, mods[0]) in
  let ap1 = demo_powmod(g[1], a, mods[1]) in
  let ap2 = demo_powmod(g[2], a, mods[2]) in
  let ap3 = demo_powmod(g[3], a, mods[3]) in
  let ap4 = demo_powmod(g[4], a, mods[4]) in
  let ap5 = demo_powmod(g[5], a, mods[5]) in
  let ap6 = demo_powmod(g[6], a, mods[6]) in
  /* Bob public: g^b mod m per channel */
  let bp0 = demo_powmod(g[0], b, mods[0]) in
  let bp1 = demo_powmod(g[1], b, mods[1]) in
  let bp2 = demo_powmod(g[2], b, mods[2]) in
  let bp3 = demo_powmod(g[3], b, mods[3]) in
  let bp4 = demo_powmod(g[4], b, mods[4]) in
  let bp5 = demo_powmod(g[5], b, mods[5]) in
  let bp6 = demo_powmod(g[6], b, mods[6]) in
  /* Shared: bob_pub^a = alice_pub^b = g^(ab) mod m */
  let s0 = demo_powmod(bp0, a, mods[0]) in
  let s1 = demo_powmod(bp1, a, mods[1]) in
  let s2 = demo_powmod(bp2, a, mods[2]) in
  let s3 = demo_powmod(bp3, a, mods[3]) in
  let s4 = demo_powmod(bp4, a, mods[4]) in
  let s5 = demo_powmod(bp5, a, mods[5]) in
  let s6 = demo_powmod(bp6, a, mods[6]) in
  /* Verify: alice computes from bob pub */
  let v0 = demo_powmod(ap0, b, mods[0]) in
  let v1 = demo_powmod(ap1, b, mods[1]) in
  let v2 = demo_powmod(ap2, b, mods[2]) in
  let v3 = demo_powmod(ap3, b, mods[3]) in
  let v4 = demo_powmod(ap4, b, mods[4]) in
  let v5 = demo_powmod(ap5, b, mods[5]) in
  let v6 = demo_powmod(ap6, b, mods[6]) in
  let ch_ok = (if s0 == v0 then 1 else 0) + (if s1 == v1 then 1 else 0) + (if s2 == v2 then 1 else 0) + (if s3 == v3 then 1 else 0) + (if s4 == v4 then 1 else 0) + (if s5 == v5 then 1 else 0) + (if s6 == v6 then 1 else 0) in
  /* CRT reconstruct shared secret via mulmod */
  let r0 = dm_mulmod(s0, idem[0]) in
  let r1 = dm_red(r0 + dm_mulmod(s1, idem[1])) in
  let r2 = dm_red(r1 + dm_mulmod(s2, idem[2])) in
  let r3 = dm_red(r2 + dm_mulmod(s3, idem[3])) in
  let r4 = dm_red(r3 + dm_mulmod(s4, idem[4])) in
  let r5 = dm_red(r4 + dm_mulmod(s5, idem[5])) in
  let shared = dm_red(r5 + dm_mulmod(s6, idem[6])) in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT KEY EXCHANGE (7-channel DH in Z/214,414,200)</p><p style='color:#b0b0c0;margin:4px 0'>Alice secret: " + "${a}" + " | Bob secret: " + "${b}" + " (mod 1680 = Carmichael lambda)</p><p style='margin:8px 0 4px;color:#ffd700'>Public keys (visible to eavesdropper)</p><p style='color:#b0b0c0;margin:4px 0'>Alice: (" + "${ap0}" + "," + "${ap1}" + "," + "${ap2}" + "," + "${ap3}" + "," + "${ap4}" + "," + "${ap5}" + "," + "${ap6}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>Bob: (" + "${bp0}" + "," + "${bp1}" + "," + "${bp2}" + "," + "${bp3}" + "," + "${bp4}" + "," + "${bp5}" + "," + "${bp6}" + ")</p><p style='margin:8px 0 4px;color:#ffd700'>Shared secrets (computed independently)</p><p style='color:#88ddaa;margin:4px 0'>Alice computes: (" + "${s0}" + "," + "${s1}" + "," + "${s2}" + "," + "${s3}" + "," + "${s4}" + "," + "${s5}" + "," + "${s6}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Bob computes: (" + "${v0}" + "," + "${v1}" + "," + "${v2}" + "," + "${v3}" + "," + "${v4}" + "," + "${v5}" + "," + "${v6}" + ")</p><p style='color:" + (if ch_ok == 7 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>Channel agreement: " + "${ch_ok}" + "/7" + (if ch_ok == 7 then " -- KEYS MATCH" else " -- MISMATCH") + "</p><p style='color:#88ddaa;margin:4px 0'>Shared secret (CRT): <b>" + "${shared}" + "</b></p></div>")
)

fn page_key_exchange() = (
  dom_head_meta("description", "CRT Key Exchange. 7-channel Diffie-Hellman over Z/214,414,200. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Key Exchange\",\"description\":\"7-channel Diffie-Hellman key exchange over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/key_exchange\"}");
  let hero = make_hero("CRT Key Exchange") in
  let eq = dom_create("div") in
  dom_text(eq, "RSA/Certicom patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "Diffie-Hellman key exchange runs in parallel across 7 CRT channels. Each channel uses its own primitive root as generator. 7 small discrete-log problems instead of 1 big one. CRT reconstructs the shared secret from 7 channel agreements.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Diffie-Hellman", "Classic DH: g^a mod p (one big modulus). CRT DH: g_i^a mod m_i for each channel (7 small moduli). Alice sends 7 public residues. Bob sends 7. Each computes 7 shared residues independently. CRT reconstruction gives the unique shared secret in Z/214,414,200.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 generators", "Primitive roots", "Each channel has its own generator: {3,2,2,3,2,2,3}.", "");
  render_finding(g1, "Parallel exchange", "CRT independence", "7 small key exchanges run independently.", "");
  render_finding(g1, "Shared secret", "CRT reconstruction", "7 channel agreements -> unique shared value.", "");
  render_finding(g1, "Channel security", "Discrete log per mod", "Breaking one channel reveals only 3-6 bits.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Alice's secret, 1-1679:", "dkex-alice", "e.g. 137", "Exchange Keys", "demo_kex_run", "dkex-result");
  let extras = dom_create("div") in
  dom_style(extras, "display", "flex");
  dom_style(extras, "gap", "8px");
  dom_style(extras, "alignItems", "center");
  dom_style(extras, "marginBottom", "12px");
  let inp_b = dom_create("input") in
  dom_attr(inp_b, "type", "text");
  dom_attr(inp_b, "id", "dkex-bob");
  dom_attr(inp_b, "placeholder", "Bob's secret (e.g. 42)");
  dom_attr(inp_b, "value", "42");
  dom_style(inp_b, "background", "#111");
  dom_style(inp_b, "color", "#eee");
  dom_style(inp_b, "border", "1px solid #333");
  dom_style(inp_b, "padding", "6px 8px");
  dom_style(inp_b, "fontFamily", "'Courier New', monospace");
  dom_style(inp_b, "width", "120px");
  dom_append(extras, inp_b);
  dom_append(sec2, extras);
  render_p(sec2, "Secrets mod 1680 (= Carmichael lambda). Try: Alice=137 Bob=42, Alice=1 Bob=1679.");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Key Exchange vs Traditional");
  render_contrast_row(sec3, "Modulus", "RSA: single 2048-bit prime product", "CRT: 7 small moduli (8 to 49)");
  render_contrast_row(sec3, "Parallelism", "Sequential modular exponentiation", "7 independent exponentiations");
  render_contrast_row(sec3, "Key size", "256+ bytes", "7 residues (< 24 bytes)");
  render_contrast_row(sec3, "Quantum resistance", "Shor's algorithm breaks RSA", "7 small DLPs -- different attack surface");
  render_contrast_row(sec3, "Patent status", "RSA/Certicom/NIST patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3);
  /* CRT-Native Key Exchange (L18) */
  let sec_native = make_section("800px") in
  render_h2(sec_native, "CRT-Native: ~60 Lines to 10 Lines");
  render_theorem(sec_native, "Language Revolution", "With crt_mode(1), the .ax compiler decomposes * into 7 per-channel CRT operations. Binary exponentiation becomes per-channel powmod AUTOMATICALLY. One call to crt_kex_pow replaces 7 manual powmod calls per party. No mulmod needed. The compiler handles overflow.");
  let gn = make_findings_grid(sec_native) in
  render_finding(gn, "Old: ~60 lines", "Manual per-channel", "7 calls to demo_powmod per party. 28 total. Explicit generator array, modulus array, mulmod CRT reconstruction.", "");
  render_finding(gn, "New: 10 lines", "CRT-native", "crt_kex_pow(g, secret). Per-channel powmod automatic. Generator 44755427: CRT = (3,2,2,3,2,2,3).", "");
  render_finding(gn, "Same ring", "Both Z/214,414,200", "Both manual and CRT-native use 7 channels. Lambda = 1680. The compiler eliminates the boilerplate.", "");
  render_finding(gn, "Generator 44755427", "(3,2,2,3,2,2,3)", "Primitive roots in Z/9, Z/25, Z/49, Z/11, Z/13, Z/17. Order-2 element in Z/8.", "");
  make_interactive_widget(sec_native, "Alice's secret, 1-1679:", "dkex-native-alice", "e.g. 137", "CRT Exchange", "native_kex_run", "dkex-native-result");
  let extras_n = dom_create("div") in
  dom_style(extras_n, "display", "flex");
  dom_style(extras_n, "gap", "8px");
  dom_style(extras_n, "alignItems", "center");
  dom_style(extras_n, "marginBottom", "12px");
  let inp_bn = dom_create("input") in
  dom_attr(inp_bn, "type", "text");
  dom_attr(inp_bn, "id", "dkex-native-bob");
  dom_attr(inp_bn, "placeholder", "Bob's secret (e.g. 42)");
  dom_attr(inp_bn, "value", "42");
  dom_style(inp_bn, "background", "#111");
  dom_style(inp_bn, "color", "#eee");
  dom_style(inp_bn, "border", "1px solid #333");
  dom_style(inp_bn, "padding", "6px 8px");
  dom_style(inp_bn, "fontFamily", "'Courier New', monospace");
  dom_style(inp_bn, "width", "120px");
  dom_append(extras_n, inp_bn);
  dom_append(sec_native, extras_n);
  render_p(sec_native, "Secrets mod 1680 (= Carmichael lambda). Try: Alice=137 Bob=42, Alice=1 Bob=1679.");
  dom_append(dom_body(), sec_native)
)
