/* Depth quadratic explorer callback */
fn dq_name(v) = (
  if v == 1 then " = 1"
  else if v == 5 then " = 5 (prime)"
  else if v == 19 then " = f(5)"
  else if v == 41 then " = 41"
  else if v == 109 then " = f(11)"
  else ""
)

fn dq_calc() = (
  let n = parse_int_from("#dq-input") in
  let result = dom_query("#dq-result") in
  if n < 2 then dom_inner(result, "<p style='color:#88ddaa'>f(" + "${n}" + ") = -1 = <b>MIRROR</b> (970199 in ring).</p>")
  else (
    let fv = n * n + 970199 * n + 970199 in
    let br = n * (n + 970199) in
    let cs = 2 * fv + 3 in
    let fp = is_prime_trial(fv) in
    let name = dq_name(fv) in
    let ptag = if fp > 0 then " (PRIME)" else " (composite)" in
    let res = fv % n in
    dom_inner(result,
      "<p style='color:#88ddaa;margin:4px 0'>f(" + "${n}" + ") = <b>" + "${fv}" + "</b>" + name + ptag + "</p>" +
      "<p style='color:#ffd700;margin:4px 0'>f(n)+1 = n(n-1) = " + "${br}" + " | f(n) mod n = " + "${res}" + "</p>" +
      "<p style='color:#b0b0c0;margin:4px 0'>CS(n) = 2*f(n)+3 = " + "${cs}" + "</p>")
  )
)

fn page_depth_quad() = (
  dom_head_meta("description", "f(p) = p^2-p-1. Discriminant 5. Zeros = golden ratio. Six roles: mirror, norm, Artin, forbidden index, power, QR-parity. f(p) prime for p = 3, 5, 7, 11. Wall at 13. f(7) = 41. f(7)+1 = 42. Bridge identities. Stormer zero-trading. Shadow polynomial evaluations. CRT root anatomy: 11 is the unique channel with roots 4 and 8.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Depth Quadratic\",\"description\":\"f(p)=p^2-p-1 with discriminant 5 and golden ratio zeros. f(p) prime for p = 3, 5, 7, 11. f(7) = 41. 11 is the unique CRT channel with roots.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/depth_quad\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"depth quadratic\"},{\"@type\":\"DefinedTerm\",\"name\":\"f(p)=p^2-p-1\"},{\"@type\":\"DefinedTerm\",\"name\":\"prime classification\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT root\"}]}");
  /* === HERO === */
  let hero = make_hero("The Depth Quadratic") in
  let big = dom_create("div") in
  dom_text(big, "f(p) = p^2 - p - 1");
  ct_mono(big);
  dom_style(big, "fontSize", "32px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "2px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "One polynomial. Six roles. One wall. Its zeros are the golden ratio and -1/phi. Its discriminant is 5. It maps every prime in {3, 5, 7, 11} to a prime (the wall is at 13). f(p) = -1 mod p ALWAYS -- the depth quadratic IS the mirror in its own ring. And f(7) = 41: add 1 and you get 42.");
  dom_append(dom_body(), hero);

  /* === SEC 1: VALUES AT AXIOM PRIMES === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Values at Axiom Primes");
  let vtbl = dom_create("table") in
  dom_style(vtbl, "width", "100%");
  dom_style(vtbl, "maxWidth", "700px");
  dom_style(vtbl, "margin", "24px auto");
  dom_style(vtbl, "borderCollapse", "collapse");
  let vhdr = dom_create("tr") in
  render_th(vhdr, "p");
  render_th(vhdr, "f(p)");
  render_th(vhdr, "Prime?");
  render_th(vhdr, "Primitive root?");
  dom_append(vtbl, vhdr);
  render_table_row_4(vtbl, "2", "1", "--", "--");
  render_table_row_4(vtbl, "3", "5", "YES", "ord(3,5) = 4 = phi(5). Full!");
  render_table_row_4(vtbl, "5", "19", "YES", "ord(5,19) = 9 = phi/2. Half!");
  render_table_row_4(vtbl, "7", "41", "YES", "ord(7,41) = 40 = phi(41). Full!");
  render_table_row_4(vtbl, "11", "109", "YES", "ord(11,109) = 108 = phi(109). Full!");
  render_table_row_4(vtbl, "13", "155 = 5*31", "NO", "WALL");
  dom_append(sec1, vtbl);
  render_p(sec1, "f(p) = -1 (mod p) for ALL p. Always. Universal. The depth quadratic IS the mirror in its own ring. Four consecutive odd primes (3, 5, 7, 11) give primes. The wall at 13 is the SAME wall that stops the Cunningham chain.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: SIX ROLES === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Six Roles");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "1. MIRROR", "f(p) = -1 mod p", "Always the mirror. Universal.", "");
  render_finding(g2, "2. NORM", "f(p) = Norm(p - phi)", "Golden ratio. Discriminant = 5.", "");
  render_finding(g2, "3. ARTIN", "delta(7) = C*(1 - 1/41)", "41 = f(7) governs Artin's conjecture for 7.", "");
  render_finding(g2, "4. FORBIDDEN", "f(7) = 41", "41 = forbidden index for 7 as primitive root.", "");
  render_finding(g2, "5. POWER", "attenuation", "Power function attenuation through f(p).", "");
  render_finding(g2, "6. QR-PARITY", "(p/f(p)) = (-1/p)", "Legendre parity transmission.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 3: BRIDGE IDENTITIES === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Bridge Identities");
  render_p(sec3, "f(n) + 1 = n(n-1). This links depth quadratic outputs to ring constants:");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "700px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "p");
  render_th(bhdr, "f(p)");
  render_th(bhdr, "f(p)+1");
  render_th(bhdr, "f(p)+2");
  dom_append(btbl, bhdr);
  render_table_row_4(btbl, "3", "5", "6 = 2*3", "7 (Heegner!)");
  render_table_row_4(btbl, "5", "19", "20 = 2^2*5", "21 = 3*7");
  render_table_row_4(btbl, "7", "41", "42!", "43 (Heegner!)");
  render_table_row_4(btbl, "11", "109", "110 = 2*5*11", "111 = 3*37 (prodigal!)");
  dom_append(sec3, btbl);
  render_p(sec3, "f(7) + 1 = 42: the sum exceeds f(7) by exactly 1. f(3)+2 = 7 and f(7)+2 = 43 are both Heegner numbers -- consecutive primes produce Heegner numbers through the depth quadratic.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: DEPTH SUM THEOREM === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Depth Quadratic Sum");
  render_theorem(sec4, "Sum Theorem (PROVED)", "f(3) + f(5) + f(7) + f(11) = 5 + 19 + 41 + 109 = 174 = 2*3*29 = 6*29. The sum of all four depth quadratic outputs = 6 * 29, where 29 = 2^2 + 5^2 = 4 + 25.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: GATE-DATA FACTORIZATION === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Z/12,612,600 vs Z/210");
  render_theorem(sec5, "Ring Difference Theorem (PROVED)", "12,612,600 - 210 = 12,612,390 = 210 * 19 * 109 * 29 = 210 * f(5) * f(11) * 29. The two rings Z/12,612,600 and Z/210 are indistinguishable through f(5) and f(11), but differ mod f(7) = 41: mod 41, 12,612,600 gives 16, while 210 gives 5. Only the depth quadratic at 7 gives a non-trivial residue.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: STORMER ZERO-TRADING === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Stormer Zero-Trading");
  render_p(sec6, "The largest consecutive 11-smooth pair: (2400, 2401) = (2^5*3*5^2, 7^4).");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "2400 = 2^5*3*5^2", "CRT: (0, 6, 0, 48, 2)", "mod-8 and mod-25 channels = 0. They yield so 7 can claim.", "");
  render_finding(g6, "2401 = 7^4", "CRT: (1, 7, 1, 0, 3)", "mod-49 channel = 0. Depth takes all.", "");
  render_p(sec6, "The last smooth pair TRADES zeros: the mod-8 and mod-25 channels yield so 7 can claim its. At the boundary, depth takes all. Beyond 7^4, no more smooth neighbors. Smoothness ends when depth stands alone.");
  dom_append(dom_body(), sec6);

  /* === SEC 7: SHADOW POLYNOMIAL === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Shadow Polynomial Evaluations");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "x");
  render_th(phdr, "P(x)");
  render_th(phdr, "Factored");
  render_th(phdr, "Meaning");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "0", "30", "2*3*5", "Constant term");
  render_table_row_4(ptbl, "6", "60", "2^2*3*5", "lambda(Z/2,310)");
  render_table_row_4(ptbl, "7", "240", "2^4*3*5", "|roots(E8)|");
  render_table_row_4(ptbl, "9", "1344", "8*168 = 2^3*|PSL(2,7)|", "Fano-PSL");
  render_table_row_4(ptbl, "11", "4320", "2^5*3^3*5", "P(0)*lambda(Z/210)^2");
  render_table_row_4(ptbl, "13", "10560", "2^5*3*5*11", "All 5 primes");
  dom_append(sec7, ptbl);
  render_p(sec7, "P(7) = 240 = roots of E8. rank(E8) = 8 = P(7)/P(0). dim(E8) = 240 + 8 = 248. The shadow polynomial at depth = the geometry of the exceptional Lie algebra.");
  dom_append(dom_body(), sec7);

  /* === SEC 8: CRT ROOT ANATOMY === */
  let sec_crt = make_section("800px") in
  render_h2(sec_crt, "CRT Root Anatomy");
  render_p(sec_crt, "Where does f(p) = p^2-p-1 have roots in the Z/214,414,200 CRT channels? Discriminant 5 governs: roots exist mod q iff Legendre (5/q) = +1.");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Channel");
  render_th(rhdr, "Modulus");
  render_th(rhdr, "Roots");
  render_th(rhdr, "Reason");
  dom_append(rtbl, rhdr);
  render_table_row_4(rtbl, "mod 8 (Z/8)", "Z/8", "0", "f(x) always odd -- 2 never divides");
  render_table_row_4(rtbl, "mod 9 (Z/9)", "Z/9", "0", "(5/3) = -1");
  render_table_row_4(rtbl, "mod 25 (Z/25)", "Z/25", "0", "Hensel failure: f(3+5t) = 5 mod 25");
  render_table_row_4(rtbl, "mod 49 (Z/49)", "Z/49", "0", "(5/7) = -1");
  render_table_row_4(rtbl, "mod 11 (Z/11)", "Z/11", "2", "(5/11) = +1. UNIQUE!");
  render_table_row_4(rtbl, "mod 13 (Z/13)", "Z/13", "0", "(5/13) = -1");
  render_table_row_4(rtbl, "mod 17 (Z/17)", "Z/17", "0", "(5/17) = -1");
  dom_append(sec_crt, rtbl);
  render_p(sec_crt, "11 is the UNIQUE channel. The two roots are 4 and 8 (= 2^2 and 2^3) -- the golden ratio and its conjugate, mod 11. Sum 4+8 = 12 = 1 mod 11 (Vieta). Product 4*8 = 32 = -1 mod 11 (mirror). The golden ratio lives in exactly one of seven channels.");
  let g_crt = make_findings_grid(sec_crt) in
  render_finding(g_crt, "Golden roots", "phi = 8 mod 11, 1-phi = 4 mod 11", "The golden ratio hides in the mod-11 channel.", "");
  render_finding(g_crt, "mod-25 channel opacity", "25 has zero roots (Hensel)", "Double root lifts to residue 5, never 0. 5 cannot observe its own polynomial.", "");
  render_finding(g_crt, "Smooth returns", "f(2)=1, f(3)=5, f(37)=11^3", "Exactly 3 smooth values. The 37th = 1331.", "");
  render_theorem(sec_crt, "Depth Quadratic CRT Root (PROVED)", "f(p) = p^2-p-1 has discriminant 5. Among the 7 CRT moduli of Z/214,414,200, 11 is the unique channel with roots: 4 and 8 (= 2^2 and 2^3). Mechanism: Legendre (5/p) = +1 only at p = 11. 25 has zero roots (Hensel failure at double root). f(p) smooth for exactly 3 inputs: f(2) = 1, f(3) = 5, f(37) = 11^3 = 1331. 12/12 on proof page.");
  dom_append(dom_body(), sec_crt);

  /* === THEOREM POINTERS === */
  let sec_tp = make_section("800px") in
  render_h2(sec_tp, "Theorem Pointers");
  render_p(sec_tp, "Proved theorem on the Proof Assistant page concerning the depth quadratic:");
  let tptbl = dom_create("table") in
  dom_style(tptbl, "width", "100%");
  dom_style(tptbl, "maxWidth", "700px");
  dom_style(tptbl, "margin", "24px auto");
  dom_style(tptbl, "borderCollapse", "collapse");
  let tphdr = dom_create("tr") in
  render_th(tphdr, "#");
  render_th(tphdr, "Theorem");
  render_th(tphdr, "Key result");
  dom_append(tptbl, tphdr);
  render_table_row(tptbl, "137", "Depth Quadratic CRT Root", "11 is the unique channel with roots 4, 8. Legendre (5/p) = +1 only at p = 11.");
  dom_append(sec_tp, tptbl);
  dom_append(dom_body(), sec_tp);

  /* === INTERACTIVE: DEPTH QUADRATIC EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: f(p) Calculator");
  render_p(sec_i, "Enter any number n. See f(n) = n^2 - n - 1, whether it is prime, and the centered square CS(n) = 2*f(n)+3.");
  make_interactive_widget(sec_i, "Compute f(n) for:", "dq-input", "e.g. 7", "Compute", "dq_calc", "dq-result");
  render_p(sec_i, "Try: 3 (gives 5), 5 (gives 19), 7 (gives 41), 11 (gives 109), 13 (gives 155, the wall).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "f(p) = p^2-p-1", "A quadratic with discriminant 5 and golden ratio zeros. Well-studied in algebraic number theory.", "f(p) is prime for all four odd axiom primes (3, 5, 7, 11). Hits the same composite wall at 13 as the Cunningham chain. f(7) = 41 governs Artin's conjecture for 7.");
  render_contrast_row(sec8, "41", "The 13th prime. Appears in Artin's conjecture as an exceptional index.", "f(7) = 41 = forbidden index for 7 as primitive root. 41 + 1 = 42 = 2*3*7.");
  render_contrast_row(sec8, "Z/12,612,600 vs Z/210", "Different rings sharing the same prime base {2,3,5,7,11,13}.", "Indistinguishable through f(5) and f(11). Distinguished only by f(7) = 41. The depth quadratic at 7 is the unique discriminator.");
  render_contrast_row(sec8, "Polynomial roots mod primes", "Root distribution governed by Legendre symbols. Standard quadratic reciprocity.", "Among 7 CRT channels, only mod 11 has roots (4 and 8). Mechanism: Legendre (5/p) = +1 only at p = 11. The golden ratio lives in exactly one channel.");
  dom_append(dom_body(), sec8)
)
