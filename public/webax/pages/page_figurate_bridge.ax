/* Figurate calculator callback */
fn figurate_compute() = (
  let n = parse_int_from("#fig-input") in
  let result = dom_query("#fig-result") in
  if n == 0 then dom_inner(result, "<p style='color:#88ddaa'>CS(0) = 1. The centered square at n = 0 is the identity.</p>")
  else (
    /* CS(n) = 2n^2 - 2n + 1. S1239: real subtraction (raw_mode). */
    let cs = 2 * n * n - 2 * n + 1 in
    /* f(n) = n^2 - n - 1 */
    let fn_val = n * n - n - 1 in
    /* Gap to next: CS(n+1) - CS(n) = 4n */
    let gap = 4 * n in
    /* CH(n) = 3n^2 - 3n + 1 = 3n(n-1) + 1 */
    let ch = 3 * n * (n - 1) + 1 in
    /* S(n) = 6n^2 - 6n + 1 = 6n(n-1) + 1 */
    let star = 6 * n * (n - 1) + 1 in
    let cs_name = if cs == 1 then " (identity)"
      else if cs == 5 then " (prime)"
      else if cs == 13 then " (prime)"
      else if cs == 25 then " = 5^2"
      else if cs == 41 then " (prime)"
      else if cs == 61 then " (prime)"
      else if cs == 85 then " = 5*17"
      else "" in
    let ch_name = if ch == 1 then " (identity)"
      else if ch == 7 then " (prime)"
      else if ch == 19 then " (prime, = f(5))"
      else if ch == 37 then " (prime)"
      else if ch == 61 then " (prime)"
      else if ch == 127 then " = 2^7-1 (Mersenne prime)"
      else "" in
    dom_inner(result,
      "<p style='color:#88ddaa;margin:4px 0'><b>CS(" + "${n}" + ") = " + "${cs}" + "</b>" + cs_name + " | f(" + "${n}" + ") = " + "${fn_val}" + "</p>" +
      "<p style='color:#ffd700;margin:4px 0'>Gap to next: 4*" + "${n}" + " = " + "${gap}" + "</p>" +
      "<p style='color:#b0b0c0;margin:4px 0'>CH(" + "${n}" + ") = " + "${ch}" + ch_name + " | Star S(" + "${n}" + ") = " + "${star}" + "</p>")
  )
)

fn page_figurate_bridge() = (
  dom_head_meta("description", "CS(n) = 2*f(n) + 3: centered squares are twice the quadratic f(n) = n^2-n-1 plus 3. Values {1, 5, 13, 25, 41, 61} at positions 1-6. Star-Hex duality: S(n) = 2*CH(n) - 1. T(20) = 210.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Figurate Numbers\",\"description\":\"Centered squares CS(n)=2*f(n)+3 connect figurate geometry to the quadratic f(n)=n^2-n-1. Star-Hex duality. 210=T(20).\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/figurate_bridge\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"figurate numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"centered squares\"},{\"@type\":\"DefinedTerm\",\"name\":\"star numbers\"}]}");
  /* === HERO === */
  let hero = make_hero("Figurate Numbers") in
  let big = dom_create("div") in
  dom_text(big, "CS(n) = 2*f(n) + 3");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Centered square numbers CS(n) = 2n^2 - 2n + 1 equal twice the quadratic f(n) = n^2 - n - 1, plus 3. The same quadratic whose roots are the golden ratio appears again, now dressed as figurate geometry. At positions 1 through 6 the values are {1, 5, 13, 25, 41, 61} -- four primes, one perfect square (25 = 5^2), and the identity.");
  dom_append(dom_body(), hero);

  /* === SEC 1: CENTERED SQUARE THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Centered Square Theorem");
  render_theorem(sec1, "Centered Square Identity (PROVED)", "CS(n) = 2n^2 - 2n + 1 = 2*f(n) + 3, where f(n) = n^2 - n - 1 is the golden-ratio quadratic. Proof: 2*f(n) + 3 = 2(n^2 - n - 1) + 3 = 2n^2 - 2n - 2 + 3 = CS(n). QED.");
  let ctbl = make_table(sec1) in
  let chdr = dom_create("tr") in
  render_th(chdr, "n");
  render_th(chdr, "f(n)");
  render_th(chdr, "Note");
  render_th(chdr, "CS(n) = 2f+3");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "1", "-1", "f(1) = -1", "1");
  render_table_row_4(ctbl, "2", "1", "f(2) = 1", "5");
  render_table_row_4(ctbl, "3", "5", "f(3) = 5 (prime)", "13");
  render_table_row_4(ctbl, "4", "11", "f(4) = 11 (prime)", "25 = 5^2");
  render_table_row_4(ctbl, "5", "19", "f(5) = 19 (prime)", "41");
  render_table_row_4(ctbl, "6", "29", "f(6) = 29 (prime)", "61");
  render_table_row_4(ctbl, "7", "41", "f(7) = 41 (prime)", "85 = 5*17");
  render_table_row_4(ctbl, "11", "109", "f(11) = 109 (prime)", "221 = 13*17");
  render_p(sec1, "At chain primes, f(n) often produces the next chain prime: f(2) = 1, f(3) = 5, f(5) = 19, f(7) = 41. The centered square maps each n to 2*f(n) + 3: so 2 maps to 5, 3 maps to 13, 5 maps to 41.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: DIFFERENCE THEOREM === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Difference Theorem");
  render_theorem(sec2, "Centered Square Difference (PROVED)", "CS(n+1) - CS(n) = 4n. Proof: CS(n+1) - CS(n) = 2(n+1)n + 1 - 2n(n-1) - 1 = 2n[(n+1) - (n-1)] = 4n. QED.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Gap at n = 1", "4", "CS(2) - CS(1) = 5 - 1.", "");
  render_finding(g2, "Gap at n = 2", "8", "CS(3) - CS(2) = 13 - 5.", "");
  render_finding(g2, "Gap at n = 3", "12", "CS(4) - CS(3) = 25 - 13.", "");
  render_finding(g2, "Gap at n = 7", "28", "CS(8) - CS(7) = 113 - 85.", "");
  render_finding(g2, "Gap at n = 11", "44", "CS(12) - CS(11) = 265 - 221.", "");
  render_p(sec2, "Every gap is 4n. At n = 1, 2, 3, 5, 7, 11: gaps are 4, 8, 12, 20, 28, 44.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: STAR-HEX BRIDGE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Star-Hex Bridge");
  render_theorem(sec3, "Star-Hexagonal Duality (PROVED)", "S(n) = 2*CH(n) - 1, where S(n) = 6n(n-1)+1 (star) and CH(n) = 3n(n-1)+1 (centered hexagonal). Proof: 2*CH(n) - 1 = 2(3n(n-1)+1) - 1 = 6n(n-1)+1 = S(n). QED.");
  let stbl = make_table(sec3) in
  let shdr = dom_create("tr") in
  render_th(shdr, "n");
  render_th(shdr, "CH(n)");
  render_th(shdr, "S(n) = 2*CH-1");
  render_th(shdr, "Note");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "1", "1", "1", "Identity");
  render_table_row_4(stbl, "2", "7", "13", "Both prime");
  render_table_row_4(stbl, "3", "19 = f(5)", "37", "19 = f(5); 37 prime");
  render_table_row_4(stbl, "4", "37", "73", "Both prime");
  render_table_row_4(stbl, "5", "61", "121 = 11^2", "Prime -> square");
  render_table_row_4(stbl, "7", "127 = 2^7-1", "253 = 11*23", "Mersenne prime -> composite");
  render_p(sec3, "At n = 2, the centered hexagonal is 7 and the star number is 13. At n = 3, they are 19 = f(5) and 37 = f(7). Doubling and subtracting 1 transforms centered hexagonals into star numbers.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: DATA AS FIGURATE === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "210 as Figurate Number");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "T(20) = 210", "20th triangular number", "20 = 4*5. The ring Z/210 = 2*3*5*7 is the 20th triangular number.", "");
  render_finding(g4, "P_5(12) = 210", "12th pentagonal number", "12 = lcm of exponents in Z/210. Pentagonal at the Carmichael lambda.", "");
  render_finding(g4, "42 = P_15(3)", "3rd 15-gonal number", "42 = 2*3*7, a product of three chain primes.", "");
  render_p(sec4, "210 sits at position 20 = 4*5 in the triangular family and position 12 in the pentagonal family. Both positions factor into small chain primes.");
  dom_append(dom_body(), sec4);

  /* === INTERACTIVE: FIGURATE CALCULATOR === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Figurate Calculator");
  render_p(sec_i, "Enter n. See centered square CS(n), the quadratic f(n), gap to next CS, centered hexagonal CH(n), and star number S(n).");
  make_interactive_widget(sec_i, "Compute figurate numbers at position:", "fig-input", "e.g. 3", "Compute", "figurate_compute", "fig-result");
  render_p(sec_i, "Try: 2 (CS=5), 3 (CS=13), 5 (CS=41), 7 (CS=85=5*17), 11 (CS=221=13*17).");
  dom_append(dom_body(), sec_i);

  /* === SEC 5: CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast");
  let ctbl5 = make_table(sec5) in
  let ch5 = dom_create("tr") in
  render_th(ch5, "Aspect");
  render_th(ch5, "Standard view");
  render_th(ch5, "Ring structure");
  dom_append(ctbl5, ch5);
  render_contrast_row(ctbl5, "CS values", "1, 5, 13, 25, 41, 61 -- pattern of 2n^2-2n+1", "Four of the first six values are chain primes (5, 13, 41, 61)");
  render_contrast_row(ctbl5, "Identity", "CS(n) = 2n^2-2n+1, a formula", "= 2*f(n) + 3: twice the golden-ratio quadratic plus 3");
  render_contrast_row(ctbl5, "Gaps", "4n = linear in n", "At chain primes: 4, 8, 12, 20, 28, 44");
  render_contrast_row(ctbl5, "Star-Hex", "S = 2*CH - 1, algebraic", "At n=2: CH=7, S=13. At n=3: CH=19=f(5), S=37=f(7)");
  dom_append(dom_body(), sec5)
)
