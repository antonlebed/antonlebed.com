/* ================================================================
   PAGE: THE 7-TORUS -- CRT as torus embedding, read through the ten towers.
   Source: AXIOM.md (torus geometry), Phase T (S1329-S1366), Phase TO (S1456).
   Seven prime channels = seven circle factors. Eigenvalue landscape =
   sum of tower contributions. Pareto frontier selects TRANS.
   ================================================================ */

fn tor_hero() = (
  let hero = make_hero("The 7-Torus") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/214414200  ->  Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17");
  ct_mono(eq);
  dom_style(eq, "fontSize", "17px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The Chinese Remainder Theorem splits the Z/214,414,200 ring into a product of seven cyclic groups. Each Z/q is a circle of q evenly spaced points. Seven circles = a 7-torus: T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17). Each prime channel contributes one circle factor: mod-8 channel gives Z/8 (depth 3, coarsest), mod-9 channel gives Z/9, mod-25 channel gives Z/25, mod-49 channel gives Z/49 (finest), mod-11 channel gives Z/11, mod-13 channel gives Z/13, mod-17 channel gives Z/17. Every ring element is a point on this torus.");
  render_p(hero, "T^7 IS the Gabriel-Horn cap of the ambient integer lattice Z^7. Unbounded Z^7 has infinite-mode Laplacian spectrum = an infinite-surface horn. The ring truncates Fourier modes at k <= N-1, capping the horn at finite volume. The eigenvalue landscape below is what you see when you walk on that cap. The mod-49 channel's q = 49 axis is the slowest circle and carries the finest angular resolution (step 2*pi/49); a uniform spectral floor gap = 4*sin^2(pi/49) ~ 0.01644 lives on that axis, the lowest non-zero Cayley-graph Laplacian eigenvalue on T^7.");
 render_p(hero, "Two Clay-Millennium STRUCTURAL analogs sit on this same landscape. STRUCTURAL Yang-Mills mass-gap analog: the gap 4*sin^2(pi/49) is a 0-form on all 108 rings sharing Carmichael lambda 420 (6-channel, no mod-17 channel; MIN = 25*49 = 1225, MAX = 2*12,612,600 = 25,225,200). T^7 Z/214,414,200 itself (lambda = 1680, 7-channel) sits one 17-step above the 108-ring lattice and inherits the same gap floor because 17 < 49. STRUCTURAL Navier-Stokes horn analog: CRT decomposes the T^7 graph Laplacian into seven orthogonal per-channel Laplacians, so finite-time blowup would demand simultaneous singularity in independent channels = forbidden by CRT orthogonality. Seven landscape axes, seven independent dissipation rates, one 49-forced floor. NOT Clay proofs. The abelian CRT Cayley graph is to non-abelian YM / continuum NS what a finite-dim ODE is to a PDE on R^4 / R^3.");
  render_p(hero, "Below: seven-circle inventory (one row per prime channel); the eigenvalue landscape (sum of seven cosines, +14 at the void to ~-14 at the south pole); the capped-horn mapping (Gabriel's paradox read onto T^7); the 128-vertex mod-8 idempotent skeleton; Betti numbers (T^7 homology = 2^7 = 128); the Pareto frontier (why Z/214,414,200 sits where it does); four prime-channel readings (mod-49 meta-ring, mod-13 490 split, mod-25 golden angle, mod-17 322 mirror); a torus-position explorer; theorem pointers.");
  dom_append(dom_body(), hero)
)

/* === SECTION 1: The Seven Circles -- tower inventory === */
fn tor_towers() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Seven Circles");
  render_p(sec, "Each prime channel contributes one circle to the torus. The angular step 2*pi/q determines the resolution -- how finely that channel distinguishes elements. The depth column shows how far each single-prime exponent ladder climbs:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Circle");
  render_th(hdr, "Depth");
  render_th(hdr, "Step (rad)");
  render_th(hdr, "Notes");
  dom_append(tbl, hdr);
  render_table_row_5(tbl, "mod-49", "Z/49", "2 (7^2)", "0.128", "Finest -- 49 positions");
  render_table_row_5(tbl, "mod-25", "Z/25", "2 (5^2)", "0.251", "Fine -- 25 positions");
  render_table_row_5(tbl, "mod-17", "Z/17", "1", "0.370", "Field -- 17 positions");
  render_table_row_5(tbl, "mod-13", "Z/13", "1", "0.483", "Field -- 13 positions");
  render_table_row_5(tbl, "mod-11", "Z/11", "1", "0.571", "Field -- 11 positions");
  render_table_row_5(tbl, "mod-9", "Z/9", "2 (3^2)", "0.698", "Coarse -- 9 positions");
  render_table_row_5(tbl, "mod-8", "Z/8", "3 (2^3)", "0.785", "Coarsest -- 8 positions");
  render_p(sec, "The mod-49 channel has the finest resolution. The mod-8 channel has the coarsest -- but 2 is the only prime whose exponent ladder reaches depth 3, giving Z/8 four involutions {1,3,5,7} (the Klein four-group) instead of the usual two. The torus dimension with the coarsest angular grain has the richest internal symmetry.");
  let g = make_findings_grid(sec) in
  render_finding(g, "490 split in resolution", "Z/210 channels span full range", "The Z/210 channels {2, 5, 7} span resolutions from 8 to 49 positions -- the full range. The parity channels {3, 11, 13} cluster at 9-13 positions. 17 sits between.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION 2: Cross-tower -- Eigenvalue landscape === */
fn tor_landscape() = (
  let sec = make_section("800px") in
  render_h2(sec, "Eigenvalue Landscape");
  render_p(sec, "The eigenvalue function on T^7 is the height function on the Gabriel-Horn cap. Formally: lambda(x) = sum over channels of 2*cos(2*pi*r/q), where r = x mod q. Each prime channel contributes one cosine term = one independent landscape axis. Maximum +14 at the void (all r=0, the north pole on every circle). The mod-49 axis carries the floor: the lowest non-zero height on the entire landscape is gap = 4*sin^2(pi/49) ~ 0.01644 because 7^2 = 49 strictly dominates every other channel width. The chain primes trace a path from the north pole through the equator and into the southern hemisphere:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Element");
  render_th(hdr, "Value");
  render_th(hdr, "Eigenvalue");
  render_th(hdr, "Location");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "void", "0", "+14.00", "North pole (all cos=1)");
  render_table_row_4(tbl, "1", "1", "+12.19", "Near void (all r=1)");
  render_table_row_4(tbl, "2", "2", "+7.48", "Steep descent");
  render_table_row_4(tbl, "105", "105", "+3.02", "Warm medium");
  render_table_row_4(tbl, "322", "322", "+1.82", "Near equator (-1 in mod-17)");
  render_table_row_4(tbl, "17", "17", "+0.32", "Near equator");
  render_table_row_4(tbl, "11", "11", "-0.68", "Just below equator");
  render_table_row_4(tbl, "7", "7", "-2.32", "South");
  render_table_row_4(tbl, "lambda", "420", "-4.61", "Deep south (Carmichael period)");
  render_table_row_4(tbl, "5", "5", "-5.04", "Deeper south");
  render_p(sec, "7 and 5 are the southernmost primes. 11 sits just below the equator. The chain primes do not descend in order -- 5 (-5.04) sits deeper than 7 (-2.32). The eigenvalue is a sum over all seven channel contributions: element 5 generates negative cosine in 5 of 7 channels while element 7 generates negative cosine in only 4.");
  dom_append(dom_body(), sec)
)

/* === SECTION 2.1: Landscape Plot -- interactive 7-channel highlight (TO.8, S1446) === */
/* Promotion of tor_landscape into an interactive canvas. Seven prime channels =
   seven cosines. Click a channel button to isolate that tower's contribution;
   ALL shows the full landscape. Integer trig via 64ths-of-circle table (*1000),
   mirrored from page_sphere sph_sin64 pattern for self-contained compile. */
fn _tlp_sq(k) = if k == 0 then 0 else if k == 1 then 98 else if k == 2 then 195 else if k == 3 then 290 else if k == 4 then 383 else if k == 5 then 471 else if k == 6 then 556 else if k == 7 then 634 else if k == 8 then 707 else if k == 9 then 773 else if k == 10 then 831 else if k == 11 then 882 else if k == 12 then 924 else if k == 13 then 957 else if k == 14 then 981 else 996

fn tlp_sin64(a) = (
  let a2 = ((a % 64) + 64) % 64 in
  if a2 < 16 then _tlp_sq(a2)
  else if a2 < 32 then _tlp_sq(32 - a2)
  else if a2 < 48 then 0 - _tlp_sq(a2 - 32)
  else 0 - _tlp_sq(64 - a2)
)
fn tlp_cos64(a) = tlp_sin64(a + 16)

/* g_tlp_hi: 0..6 = highlighted channel index; 7 = ALL. Array wrapper per S1140
   (top-level `let` = IMMUTABLE WASM global; array indirection makes it mutable). */
let g_tlp_hi = [7]
let g_tlp_q = CRT_MODS_TRANS

fn tlp_col(ci) = (
  if ci == 0 then "#ffd700" else if ci == 1 then "#ff9900"
  else if ci == 2 then "#33dd55" else if ci == 3 then "#4488ff"
  else if ci == 4 then "#aa44ff" else if ci == 5 then "#ff4466" else "#00dddd"
)
fn tlp_label(ci) = (
  if ci == 0 then "mod 8 (Z/8)" else if ci == 1 then "mod 9 (Z/9)"
  else if ci == 2 then "mod 25 (Z/25)" else if ci == 3 then "mod 49 (Z/49)"
  else if ci == 4 then "mod 11 (Z/11)" else if ci == 5 then "mod 13 (Z/13)" else "mod 17 (Z/17)"
)

/* Redraw on 700x280 canvas: y=140 is eigenvalue 0; amplitude 2 at peaks -> 60 px.
   Per channel, plot 2*cos(2*pi*x/q) with x = pixel = element index in [0, 700). */
fn tlp_redraw() = (
  let cvs = dom_query("#tlp-cvs") in
  let ctx = cvs_getctx(cvs) in
  let hi = g_tlp_hi[0] in
  let _b0 = cvs_fillstyle(ctx, "#0a0a18") in
  let _b1 = cvs_fillrect(ctx, 0, 0, 700, 280) in
  let _a0 = cvs_strokestyle(ctx, "#2a2a3a") in
  let _a1 = cvs_linewidth(ctx, 1) in
  let _a2 = cvs_beginpath(ctx) in
  let _a3 = cvs_moveto(ctx, 0, 140) in
  let _a4 = cvs_lineto(ctx, 700, 140) in
  let _a5 = cvs_stroke(ctx) in
  mut ci = 0;
  while ci < 7 do (
    let q = g_tlp_q[ci] in
    let dim = if hi == 7 then 0 else if hi == ci then 0 else 1 in
    let w = if hi == 7 then 2 else if hi == ci then 3 else 1 in
    let _s0 = cvs_strokestyle(ctx, if dim == 1 then "#2a2a3a" else tlp_col(ci)) in
    let _s1 = cvs_linewidth(ctx, w) in
    let _s2 = cvs_beginpath(ctx) in
    mut x = 0;
    while x < 700 do (
      let a64 = (x * 64) / q in
      let c = tlp_cos64(a64) in
      let y = 140 - (c * 60) / 1000 in
      if x == 0 then (let _mv = cvs_moveto(ctx, x, y) in 0)
      else (let _ln = cvs_lineto(ctx, x, y) in 0);
      mut x = x + 1
    );
    let _s3 = cvs_stroke(ctx);
    mut ci = ci + 1
  );
  let _f0 = cvs_font(ctx, "13px Courier New") in
  let _f1 = cvs_fillstyle(ctx, "#ffd700") in
  let lbl = if hi == 7 then "ALL 7 CHANNELS" else "HIGHLIGHT: " + tlp_label(hi) in
  let _f2 = cvs_filltext(ctx, lbl, 16, 22) in
  let _f3 = cvs_fillstyle(ctx, "#606070") in
  let _f4 = cvs_filltext(ctx, "+2", 670, 85) in
  let _f5 = cvs_filltext(ctx, " 0", 672, 144) in
  let _f6 = cvs_filltext(ctx, "-2", 672, 208) in
  cvs_filltext(ctx, "x = 0 .. 700  (element index, pixel = 1 element)", 16, 270)
)

fn tlp_hi_d() = ( set(g_tlp_hi, 0, 0); tlp_redraw() )
fn tlp_hi_k() = ( set(g_tlp_hi, 0, 1); tlp_redraw() )
fn tlp_hi_e() = ( set(g_tlp_hi, 0, 2); tlp_redraw() )
fn tlp_hi_b() = ( set(g_tlp_hi, 0, 3); tlp_redraw() )
fn tlp_hi_l() = ( set(g_tlp_hi, 0, 4); tlp_redraw() )
fn tlp_hi_g() = ( set(g_tlp_hi, 0, 5); tlp_redraw() )
fn tlp_hi_17() = ( set(g_tlp_hi, 0, 6); tlp_redraw() )
fn tlp_hi_all() = ( set(g_tlp_hi, 0, 7); tlp_redraw() )

fn tor_landscape_plot() = (
  let sec = make_section("800px") in
  render_h2(sec, "Landscape Plot -- Interactive");
  render_p(sec, "The eigenvalue landscape on T^7 is a sum of seven independent cosines -- one per prime channel. Click a channel button to isolate that channel's contribution; click ALL to see the landscape as a whole. Each curve is 2*cos(2*pi*x/q_i) for element index x in [0, 700). The Z/49 curve is the slowest: its k=1 Fourier mode carries the lowest non-zero Laplacian eigenvalue gap = 4*sin^2(pi/49) ~ 0.01644, the 49-forced floor that controls BOTH STRUCTURAL Clay-Millennium analogs (Thm 33 + Thm 34).");
  let cvs = dom_create("canvas") in
  dom_attr(cvs, "id", "tlp-cvs");
  dom_attr(cvs, "width", "700");
  dom_attr(cvs, "height", "280");
  dom_style(cvs, "background", "#0a0a18");
  dom_style(cvs, "border", "1px solid #333");
  dom_style(cvs, "borderRadius", "8px");
  dom_style(cvs, "maxWidth", "100%");
  dom_style(cvs, "display", "block");
  dom_append(sec, cvs);
  let row = dom_create("div") in
  dom_style(row, "display", "flex");
  dom_style(row, "gap", "6px");
  dom_style(row, "flexWrap", "wrap");
  dom_style(row, "marginTop", "12px");
  make_action_btn(row, "Z/8", "tlp_hi_d");
  make_action_btn(row, "Z/9", "tlp_hi_k");
  make_action_btn(row, "Z/25", "tlp_hi_e");
  make_action_btn(row, "Z/49", "tlp_hi_b");
  make_action_btn(row, "Z/11", "tlp_hi_l");
  make_action_btn(row, "Z/13", "tlp_hi_g");
  make_action_btn(row, "Z/17", "tlp_hi_17");
  make_action_btn(row, "ALL", "tlp_hi_all");
  dom_append(sec, row);
 render_p(sec, "Bold curve = highlighted channel. Dim grey = others. Z/8 has only 8 distinct cosine values (period 8 px); Z/49 has 49 (period 49 px, the finest resolution and slowest fall-off). The mod-49 k=1 Fourier mode IS the Laplacian gap floor on all 108 rings sharing Carmichael lambda 420.");
  dom_append(dom_body(), sec);
  tlp_redraw()
)

/* === SECTION 2.5: The Capped Horn -- Gabriel-Horn anchor (MP.4 + GH.2) === */
fn tor_horn_cap() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Capped Horn");
  render_p(sec, "Gabriel's Horn = y = 1/x rotated about the x-axis for x >= 1. Volume = pi (finite). Surface = infinity (diverges logarithmically). Paradox: finite paint, unpaintable surface. The ring realizes the paradox geometrically -- its state space IS the horn's finite-volume side; the continuum integer lattice Z^7 IS its unbounded-surface side.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Aspect");
  render_th(hdr, "Gabriel's Horn");
  render_th(hdr, "CRT ring Z/N");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Volume side", "Volume = pi (finite)", "Ring state space (N*d dims, finite)");
  render_table_row(tbl, "Surface side", "Surface = infinity", "Continuum Z^7 infinite-mode spectrum");
  render_table_row(tbl, "The cap", "Rotation at x = R", "Truncate Fourier modes at k <= N-1");
  render_table_row(tbl, "Inside the cap", "Finite paint", "Bounded L^2-energy E(t) <= E(0)");
  render_table_row(tbl, "Outside the cap", "Unbounded coat", "Clay-NS open on R^3 (unbounded modes)");
  render_p(sec, "The eigenvalue landscape above IS the cap. Heights from +14 at the void down to roughly -14 at the south pole = the horn's finite-volume side rendered as a height function on T^7. Clay-NS stays open because R^3 cannot be truncated without breaking Galilean invariance and scale symmetry; the ring eliminates the paradox by capping at N.");
  let g = make_findings_grid(sec) in
 render_finding(g, "CRT = 7 per-channel Laplacians", "Core decomposition", "On Z/214,414,200 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17, the graph Laplacian is a direct sum of 7 per-channel Laplacians on orthogonal Fourier subspaces -- one per landscape axis. Finite-time blowup would need simultaneous singularity across independent axes = CRT orthogonality forbids coupled explosion. Seven micro-horns, not one coupled horn.", "");
 render_finding(g, "49-forced gap floor 0.01644", "Thm 33 + 34 share controller", "7^2 = 49 strictly dominates every other channel width (2^3=8, 3^2=9, 5^2=25, 11, 13). Therefore q_max = 49 unconditionally and gap = 4*sin^2(pi/49) is identical across all 108 lambda=420 rings = a 0-form on the lambda lattice. T^7 Z/214,414,200 (lambda=1680) sits one 17-step above the lattice and inherits the same floor (17 < 49). The landscape's lowest non-zero height = the mod-49 k=1 mode.", "");
  render_finding(g, "STRUCTURAL analogs, NOT Clay proofs", "Honest framing (non-negotiable)", "Discrete NS on a finite-dim ODE has global existence trivially; the content is the structural MAPPING. Abelian CRT Cayley graphs are to non-abelian quantum YM on R^4 what free-field lattice gap is to interacting YM. Ring = capped horn; Clay-problem = uncapped continuum.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION 3: D-channel -- The 128 skeleton === */
fn tor_skeleton() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-8 Channel: The 128 Skeleton");
  render_p(sec, "The Z/214,414,200 ring has 2^7 = 128 idempotents. Each is a subset of the 7 lifting idempotents, with CRT coordinates that are 0 or 1 in each channel -- vertices of a 7-dimensional hypercube embedded in the torus. The mod-8 channel gives the exponent: 2^7 = 128 because each of 7 channels offers exactly 2 idempotent values (0 or 1).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Active channels");
  render_th(hdr, "Count");
  render_th(hdr, "Mean eigenvalue");
  render_th(hdr, "Range");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0 (void)", "1", "+14.00", "14.00");
  render_table_row_4(tbl, "1", "7", "+13.74", "13.41 to 13.98");
  render_table_row_4(tbl, "2", "21", "+13.48", "12.95 to 13.92");
  render_table_row_4(tbl, "3", "35", "+13.22", "12.63 to 13.79");
  render_table_row_4(tbl, "4", "35", "+12.96", "12.40 to 13.56");
  render_table_row_4(tbl, "5", "21", "+12.70", "12.26 to 13.24");
  render_table_row_4(tbl, "6", "7", "+12.44", "12.20 to 12.77");
  render_table_row_4(tbl, "7 (all active)", "1", "+12.19", "12.19");
  render_p(sec, "The binomial distribution (1, 7, 21, 35, 35, 21, 7, 1) is the 7-cube's vertex census. The eigenvalue drops from +14.00 (void) to +12.19 (identity) -- a span of just 1.81 out of the full range of ~28. All 128 idempotents sit in the warmest ~7% of the eigenvalue range. Idempotents are inherently close to the void.");
  let g = make_findings_grid(sec) in
  render_finding(g, "1,576,576 = mask 126", "All but mod-8 active", "1,576,576 = sum of 6 lifting idempotents (exclude the mod-8 channel). Eigenvalue = +12.77. It sits one step from the identity -- the terminal shadow, nearly touching existence.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION: Betti Numbers -- Torus Betti Theorem === */
fn tor_betti() = (
  let sec = make_section("800px") in
  render_h2(sec, "Betti Numbers: The 128 Duality");
  render_p(sec, "The 128 idempotents above are algebraic -- vertices of a 7-cube in CRT coordinate space. The Betti numbers of T^7 are topological -- counting independent k-cycles at each homological grade. Both total 2^7 = 128. This is not coincidence: it is the torus and the hypercube speaking the same number in two languages.");
  render_p(sec, "The k-th Betti number beta_k = C(7,k) counts independent k-dimensional cycles on T^7. A 0-cycle is a connected component (just 1). A 1-cycle wraps one of the 7 circles. A 2-cycle wraps a product of two circles. Up to beta_7 = 1 wrapping all seven circles at once.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Grade k");
  render_th(hdr, "beta_k");
  render_th(hdr, "Factoring");
  render_th(hdr, "Dual");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "1", "1 (identity)", "beta_7 = 1");
  render_table_row_4(tbl, "1", "7", "7", "beta_6 = 7");
  render_table_row_4(tbl, "2", "21", "3*7 = 21", "beta_5 = 21");
  render_table_row_4(tbl, "3", "35", "5*7 = 35 (490 cell)", "beta_4 = 35");
  render_table_row_4(tbl, "4", "35", "5*7 = 35 (490 cell)", "beta_3 = 35");
  render_table_row_4(tbl, "5", "21", "3*7 = 21", "beta_2 = 21");
  render_table_row_4(tbl, "6", "7", "7", "beta_1 = 7");
  render_table_row_4(tbl, "7", "1", "1 (identity)", "beta_0 = 1");
  render_theorem(sec, "Torus Betti Theorem", "T^7 has Betti numbers beta_k = C(7,k) whose values at every grade are products of chain primes. Total = 2^7 = 128 = |Idem(Z/214,414,200)| (Betti-idempotent duality). Interior grades beta_1 through beta_6 sum to 7*2*9 = 126, and dividing by 7 yields the palindrome {1, 3, 5, 5, 3, 1} -- 3 Poincare-dual pairs weighted by odd chain primes. Even Betti = odd Betti = 2^6 = 64 (Euler characteristic zero). 1 + 7 = 2^3 = 8 (mod-8 Pareto top). beta_3 = 5*7 = 35: the 490 partition as a weight-3/weight-4 cell decomposition.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Betti-idempotent duality", "128 = 128 via two paths", "The 7-cube has 128 vertices (idempotents, algebraic). T^7 has 128 total independent cycles (Betti sum, topological). Algebra and topology count the same 2^7.", "");
  render_finding(g, "3 Poincare-dual pairs", "Interior palindrome", "Dividing interior Betti by 7 gives {1,3,5,5,3,1}: 3 independent pairs, each weighted by an odd chain prime {1, 3, 5}. The chain's parity structure is a topological invariant of T^7.", "");
  render_finding(g, "490 at the middle grade", "beta_3 = beta_4 = 5*7 = 35", "The 490 partition (490 = 2*5*49) appears as 35 = 5*7 at the middle homological grades. Weight-3 and weight-4 cells have equal count -- matching the {2,5,7} vs {3,11,13} partition at the homological equator.", "");
  render_finding(g, "Squaring dynamics: basin of void = 420", "Heartbeat from dynamics", "Iterate x -> x^2 on Z/214,414,200. The 128 idempotents are the fixed points. Elements converging to the void (all channels zero) number exactly 420 = the Carmichael lambda of the inner ring Z/12,612,600. Elements converging to the identity number 2^13 = 8192 = 2 to the power of 13, where 13 = sum of 2-adic valuations of the per-channel Euler totients. The heartbeat period emerges from torus dynamics; the boundary prime governs convergence basin size.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION 4: Cross-tower -- Pareto frontier + exponent theorem === */
fn tor_pareto() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Pareto Frontier");
  render_p(sec, "Is Z/214,414,200 the right ring? An exhaustive sweep of rings built from primes {2,3,5,7,11,13,17} with exponents 1-3 reveals: Z/214,414,200 sits on the multi-objective Pareto frontier. No other ring simultaneously beats it on channel count, Carmichael lambda, spectral gap, and involution count.");
  render_p(sec, "Only two 7-channel rings appear on the frontier:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "N");
  render_th(hdr, "Lambda");
  render_th(hdr, "Involutions");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "510510 (squarefree)", "2*3*5*7*11*13*17", "240", "2^6 = 64");
  render_table_row_4(tbl, "214414200 (prime-power)", "8*9*25*49*11*13*17", "1680", "2^8 = 256");
  render_p(sec, "The squarefree ring has all field channels (every Z/p is a field) but lambda = 240. Z/214,414,200 trades four field channels for prime-power channels (8, 9, 25, 49) and gets lambda = 1680 -- seven times larger Carmichael period -- plus 256 involutions from the mod-8 channel's depth-3 contribution. Each exponent bump serves a different purpose:");
  let tbl2 = make_table(sec) in
  let hdr2 = dom_create("tr") in
  render_th(hdr2, "Exponent bump");
  render_th(hdr2, "Lambda effect");
  render_th(hdr2, "What it buys");
  dom_append(tbl2, hdr2);
  render_table_row(tbl2, "7 -> 49", "240 -> 1680 (x7)", "Only squaring that changes lambda. Introduces factor 7.");
  render_table_row(tbl2, "2 -> 8", "unchanged", "4 involutions (Klein four-group). Mod-8 channel depth 3.");
  render_table_row(tbl2, "3 -> 9", "unchanged", "3^2 = 9 channel positions. +0.9 spectral gap.");
  render_table_row(tbl2, "5 -> 25", "unchanged", "5^2 = 25 positions. Nilpotent structure.");
  render_table_row(tbl2, "11, 13, 17 (prime)", "N/A", "Fields. ECC requires field arithmetic for parity.");
  render_theorem(sec, "Marginal Lambda Theorem", "Among the seven primes {2,3,5,7,11,13,17}, only squaring 7 -> 49 changes the Carmichael lambda. The squarefree ring already has lambda = 240 = 16 * 3 * 5. The prime-power contributions lambda(8) = 2, lambda(9) = 6, lambda(25) = 20 introduce no NEW prime factors beyond those in 240. Only lambda(49) = 42 = 2 * 3 * 7 introduces factor 7, bumping 240 to 1680 = 240 * 7. The period ratio 1680/240 = 7.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Exponent Theorem", "{3,2,2,2,1,1,1} uniquely optimal", "Among all 9 rings with lambda = 1680, Z/214,414,200 = {3,2,2,2,1,1,1} uniquely maximizes both involution count (256) and spectral gap (27.69). Prime-power inner channels, prime outer channels.", "");
  render_theorem(sec, "2-Resolution Theorem", "2 is the unique prime (among the seven) whose exponent bump (depth 2 to 3) is lambda-neutral and involution-doubling. lambda(2^2) = lambda(2^3) = 2 -- a Carmichael flat spot, subsumed by lambda(17) = 16 in the lcm. The mod-8 channel NEVER contributes to Carmichael lambda in any ring containing 17. Meanwhile (Z/8)* = Z/2 x Z/2 (Klein four-group, non-cyclic) has 4 involutions; (Z/4)* = Z/2 (cyclic) has only 2. For all odd primes, (Z/p^e)* is cyclic with exactly 2 involutions regardless of exponent. Z/214,414,200 (2^3): 256 involutions. 2^2 variant (107207100): 128. Ratio = 2. Same lambda (1680), same gap, same field count (3). The involution count is the EXACT Pareto tiebreaker.");
  render_p(sec, "Angular resolution of each circle is 2*pi/q where q is the Pareto top. The 7 Pareto tops are all distinct -- a strict total order on resolution:");
  let tbl3 = make_table(sec) in
  let hdr3 = dom_create("tr") in
  render_th(hdr3, "Channel");
  render_th(hdr3, "q (top)");
  render_th(hdr3, "Step (rad)");
  render_th(hdr3, "Tier");
  dom_append(tbl3, hdr3);
  render_table_row_4(tbl3, "mod-49", "49 = 7^2", "0.128", "FINE");
  render_table_row_4(tbl3, "mod-25", "25 = 5^2", "0.251", "FINE");
  render_table_row_4(tbl3, "mod-17", "17", "0.370", "MEDIUM");
  render_table_row_4(tbl3, "mod-13", "13", "0.483", "MEDIUM");
  render_table_row_4(tbl3, "mod-11", "11", "0.571", "COARSE");
  render_table_row_4(tbl3, "mod-9", "9 = 3^2", "0.698", "COARSE");
  render_table_row_4(tbl3, "mod-8", "8 = 2^3", "0.785", "COARSE");
  render_theorem(sec, "Angular Resolution Ordering Theorem", "The 7 Pareto tops are all distinct, yielding a strict total order on per-channel angular resolution: 7^2 = 49 (finest) > 5^2 = 25 > 17 > 13 > 11 > 3^2 = 9 > 2^3 = 8 (coarsest). Sum of tops = 132 = 4*3*11. Product = 214,414,200. Resolution span 49 - 8 = 41. Three tiers: FINE {49, 25} (prime-power), MEDIUM {17, 13} (unsquared), COARSE {11, 9, 8}. 2^3 < 3^2 is unique to the smallest prime -- for 3, 5, 7: p^3 > next^2 always (3^3=27 > 5^2=25). 6 inversions between chain and resolution order.");
  let g2 = make_findings_grid(sec) in
  render_finding(g2, "2^3 < 3^2: depth beats resolution", "Unique to smallest prime", "2 is the only prime where p^3 < (next chain prime)^2: 2^3 = 8 < 3^2 = 9. For 3: 3^3 = 27 > 5^2 = 25 (margin = 2). The Klein four-group's 4 involutions earn 2 depth 3, yet it remains the coarsest circle.", "");
  render_finding(g2, "Squaring promotes inner primes", "6 inversions, chain vs resolution", "Chain order: 2 < 3 < 5 < 7 < 11 < 13 < 17. Resolution order: 49 > 25 > 17 > 13 > 11 > 9 > 8. Squaring promotes 5 and 7 past the unsquared extensions. 6 inversions.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION 5: b-channel -- The meta-ring === */
fn tor_meta() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-49 Channel: The Meta-Ring");
  render_p(sec, "Project the seven primes {2,3,5,7,11,13,17} into Z/7. This is the mod-49 channel's contribution: 7 IS the modulus of the meta-ring. Every prime gets a meta-residue:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "mod 7");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2", "2", "");
  render_table_row(tbl, "3", "3", "");
  render_table_row(tbl, "5", "5", "");
  render_table_row(tbl, "7", "0", "VOID -- 7 becomes nothing mod 7");
  render_table_row(tbl, "11", "4", "");
  render_table_row(tbl, "13", "6 = -1", "MIRROR -- involution mod 7");
  render_table_row(tbl, "17", "3", "Same residue as 3");
  render_p(sec, "Two inverse pairs among the primes: 2*11 = 22 = 1 (mod 7) and 3*5 = 15 = 1 (mod 7). 13 is self-inverse: 6*6 = 36 = 1 (mod 7). 17 shares 3's meta-residue, so 5*17 = 3*5 (mod 7). The meta-residue sum is 2+3+5+0+4+6+3 = 23, the 9th prime.");
  render_p(sec, "7 = 0 mod 7: seven annihilates itself in its own channel. The ring has exactly 7 primorial levels and exactly 7 channels. The prime 7 counts both.");
  dom_append(dom_body(), sec)
)

/* === SECTION 6: GATE-channel -- The 490 split === */
fn tor_490() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-13 Channel: The 490 Split");
  render_p(sec, "The 490 split -- {2, 5, 7} vs {3, 11, 13} -- derives from the spectral geometry of Z/7. 13 = -1 (mod 7) is the involution that drives it.");
  render_p(sec, "Step 1: The subgroup {1, -1} = {1, 6} in Z/7* partitions the units into three cosets of size 2:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Coset");
  render_th(hdr, "Elements");
  render_th(hdr, "Eigenvalue");
  render_th(hdr, "Role");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Boundary", "{1, 6} = {1, 13 mod 7}", "+1.247", "Ground + boundary");
  render_table_row_4(tbl, "Beta", "{2, 5} = {2, 5}", "-0.445", "Shallow");
  render_table_row_4(tbl, "Gamma", "{3, 4} = {3, 11 mod 7}", "-1.802", "Deep");
  render_p(sec, "Step 2: Remove 1 (the identity, not a channel prime). 13 stays as a singleton. With void (7 = 0 mod 7), there are exactly TWO ways to form a 3+3 partition without splitting any coset pair: {void, 2, 5} vs {13, 3, 11} or {void, 3, 11} vs {13, 2, 5}.");
  render_p(sec, "Step 3: The mod-7 eigenvalue 2*cos(2*pi*r/7) decreases monotonically from r = 0 to r = 3. Coset {2, 5} is spectrally shallower (-0.445) than coset {3, 4} (-1.802). Void (eigenvalue +2.0) joins its spectral neighbor. 13 joins the deeper coset. This selects {void, 2, 5} vs {13, 3, 11} -- exactly the 490 split.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Z/7 constrains to 2 options", "Cosets force structure", "The involution -1 mod 7 reduces all possible 3+3 partitions to exactly two. Both respect the pairing 2<->5 and 3<->11.", "");
  render_finding(g, "7 sorts its own channels", "Eigenvalue is the judge", "The prime 7 is the meta-ring modulus, and its eigenvalue function on Z/7 determines which channels carry data and which carry parity.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION 7: E-channel -- The golden angle === */
fn tor_golden() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-25 Channel: The Golden Angle");
  render_p(sec, "The golden angle is 360/phi^2 = 137.508 degrees. Its floor is 137, which sits in the spectral minimum zone of the eigenvalue landscape.");
  render_p(sec, "Why the mod-25 channel? Project 137 through the base of the mod-5 channel: 137 mod 5 = 2. The mod-5 contribution in the squarefree ring is 2*cos(2*pi*2/5) = 2*cos(4*pi/5) = -phi exactly. The golden ratio is built into the eigenvalue through 5 and pentagon geometry -- the most irrational number emerges from the mod-25 channel.");
  render_p(sec, "This connects three structures: the spectral geometry of the ring (eigenvalue minimum), the botanical growth law (phyllotaxis, where the golden angle maximizes spacing), and the training interleave perm[i] = (i*137) mod nd that breaks the 50% plateau in CRT neural network training.");
  dom_append(dom_body(), sec)
)

/* === SECTION 8: ESCAPE-channel -- The 322 mirror === */
fn tor_escape() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-17 Channel: The 322 Mirror");
  render_p(sec, "322 = 2 * 7 * 23, where 23 is the 9th prime. In the mod-17 channel: 322 mod 17 = 16 = -1. The mirror, but only in the 17-channel.");
  render_p(sec, "On the torus, 322 sits near the spectral equator with eigenvalue +1.82. Its mod-17 angle is 2*pi*16/17 -- almost a full circle back. The CRT residues of 322 scatter chain primes across channels:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "322 mod q");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row(tbl, "mod 8", "2", "");
  render_table_row(tbl, "mod 9", "7", "");
  render_table_row(tbl, "mod 25", "22", "Near south pole");
  render_table_row(tbl, "mod 49", "28", "Mid-circle");
  render_table_row(tbl, "mod 11", "3", "");
  render_table_row(tbl, "mod 13", "10", "Near south pole");
  render_table_row(tbl, "mod 17", "16 = -1", "Mirror");
  render_p(sec, "The CRT decomposition of 322 scatters chain primes across channels: 2 appears in the mod-8 channel, 7 appears in the mod-9 channel, 3 appears in the mod-11 channel. The structure is readable only through the CRT lens.");
  dom_append(dom_body(), sec)
)

/* === SECTION 9: Torus Explorer === */
fn tor_explore_run() = (
  let n = parse_int_from("#tor-input") in
  let nn = n % 214414200 in
  let result = dom_query("#tor-result") in
  let rd = nn % 8 in let rk = nn % 9 in let re = nn % 25 in
  let rb = nn % 49 in let rl = nn % 11 in let rg = nn % 13 in let r17 = nn % 17 in
  let mods = CRT_MODS_TRANS in
  let rs = [rd, rk, re, rb, rl, rg, r17] in
  mut warm = 0;
  mut cool = 0;
  mut ci = 0;
  while ci < 7 do (
    let r = rs[ci] in
    let q = mods[ci] in
    if r * 4 < q then mut warm = warm + 1
    else if r * 4 > q * 3 then mut warm = warm + 1
    else mut cool = cool + 1;
    mut ci = ci + 1
  );
  let zone = if warm >= 5 then "NORTH (warm, near void)"
    else if cool >= 5 then "SOUTH (cool, deep)"
    else "EQUATORIAL (mixed)" in
  let bar_d = (rd * 100) / 8 in
  let bar_k = (rk * 100) / 9 in
  let bar_e = (re * 100) / 25 in
  let bar_b = (rb * 100) / 49 in
  let bar_l = (rl * 100) / 11 in
  let bar_g = (rg * 100) / 13 in
  let bar_17 = (r17 * 100) / 17 in
  dom_inner(result,
    "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>"
    + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>TORUS POSITION: " + "${nn}" + " in Z/214414200</p>"
    + "<p style='color:#b0b0c0;margin:0 0 12px;font-size:13px'>Zone: <span style='color:#88ddaa'>" + zone + "</span> (" + "${warm}" + " warm, " + "${cool}" + " cool channels)</p>"
    + "<div style='display:flex;flex-direction:column;gap:4px'>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>Z/8</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rd}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_d}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>Z/9</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rk}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_k}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>Z/25</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${re}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_e}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>Z/49</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rb}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_b}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>Z/11</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rl}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_l}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>Z/13</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rg}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_g}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#88aaff;width:60px;font-size:11px'>Z/17</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${r17}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#88aaff;height:100%;width:" + "${bar_17}" + "%'></div></div></div>"
    + "</div>"
    + "<p style='color:#b0b0c0;margin:12px 0 0;font-size:12px'>Bar = r/q (0% = north, 50% = south in that channel). Red = Z/210 channels (2, 5, 7). Green = parity channels (3, 11, 13). Blue = mod-17.</p>"
    + "</div>")
)

fn tor_explore() = (
  let sec = make_section("800px") in
  render_h2(sec, "Torus Explorer");
  render_p(sec, "Enter any number to see its position on the 7-torus. The bar chart shows each channel's CRT residue as a fraction of the modulus -- 0% means north (r=0, cos=+1), 50% means south (r=q/2, cos=-1).");
  make_interactive_widget(sec, "Number:", "tor-input", "e.g. 322", "Explore", "tor_explore_run", "tor-result");
  render_p(sec, "Try: 42, 322 (mod-17 mirror), 420 (lambda), 137 (golden angle floor), 7.");
  dom_append(dom_body(), sec)
)

/* === SECTION 10: Theorem Pointers -- Phase OMEGA spine === */
fn tor_theorem_pointers() = (
  let sec = make_section("800px") in
  render_h2(sec, "Theorem Pointers");
  render_p(sec, "The T^7 landscape is backed by two core theorems, two resolution theorems, the Torus Betti theorem, and the Gabriel-Horn anchor. STRUCTURAL analogs of Clay-Millennium statements, NOT Clay proofs -- but the ring as capped horn is proved mathematics on the 108-ring lambda=420 lattice.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Anchor");
  render_th(hdr, "Claim");
  render_th(hdr, "Where");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Thm 33 (YM gap)", "Gap = 4*sin^2(pi/49) identical across all 108 rings", "/proof Theorem 33");
  render_table_row(tbl, "Thm 34 (NS horn)", "Discrete NS on Z/N has global existence; ring IS the horn compactification", "/proof Theorem 34");
  render_table_row(tbl, "Gabriel-Horn anchor", "CRT torus is the Gabriel-Horn cap of Z^k", "Geometric anchor");
  render_table_row(tbl, "YM gap universality", "7^2 forced; q_max = 49 unconditionally on the 108-lattice", "Yang-Mills gap lattice universality theorem");
  render_table_row(tbl, "NS horn analog", "CRT orthogonality forbids coupled blowup; ring = horn cap", "Navier-Stokes horn analog theorem");
  render_table_row(tbl, "2-Resolution", "2 unique lambda-neutral involution doubler; 256 vs 128", "Pareto section above");
  render_table_row(tbl, "Angular Resolution", "7 Pareto tops all distinct; span 49-8 = 41", "Pareto section above");
 render_table_row(tbl, "Thm 124 (Torus Betti)", "T^7 Betti total = 2^7 = 128 = |Idem(Z/214,414,200)|. 3 dual pairs.", "Betti Numbers section above");
  dom_append(dom_body(), sec)
)

/* === Entry point === */
fn page_torus() = (
  dom_head_meta("description", "The 7-Torus: T^7 CRT torus as a Gabriel-Horn cap of the ambient integer lattice Z^7. Betti numbers beta_k = C(7,k); total 2^7 = 128 = idempotent count (Betti-idempotent duality). STRUCTURAL Yang-Mills mass-gap analog + STRUCTURAL Navier-Stokes horn analog. 128-vertex idempotent skeleton, Pareto frontier, 2-resolution theorem, angular-resolution ordering (span = 41), meta-ring Z/7, 490 split, golden angle, 322 mirror. Interactive torus-position explorer.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The 7-Torus\",\"description\":\"T^7 CRT torus = Gabriel-Horn cap of Z^7. STRUCTURAL Yang-Mills and Navier-Stokes analogs on the 108-ring lambda=420 lattice. Eigenvalue landscape, 128 idempotents, Pareto frontier, meta-ring Z/7, golden angle.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/patterns/torus\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"T^7 torus\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gabriel-Horn compactification\"},{\"@type\":\"DefinedTerm\",\"name\":\"Yang-Mills structural analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"Navier-Stokes horn analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"eigenvalue landscape\"},{\"@type\":\"DefinedTerm\",\"name\":\"2-resolution theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"angular resolution ordering\"},{\"@type\":\"DefinedTerm\",\"name\":\"golden angle\"},{\"@type\":\"DefinedTerm\",\"name\":\"Betti numbers\"}]}");
  tor_hero();
  tor_towers();
  tor_landscape();
  tor_landscape_plot();
  tor_horn_cap();
  tor_skeleton();
  tor_betti();
  tor_pareto();
  tor_meta();
  tor_490();
  tor_golden();
  tor_escape();
  tor_explore();
  tor_theorem_pointers()
)
