/* ================================================================
   PAGE: THE 7-TORUS -- CRT as torus map, eigenvalue landscape
   Phase T step T1. The ring is a 7-torus. Numbers are points.
   ================================================================ */

fn tor_hero() = (
  let hero = make_hero("The 7-Torus") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/N  ->  Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17  =  T^7");
  ct_mono(eq);
  dom_style(eq, "fontSize", "18px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The Chinese Remainder Theorem maps the TRANS ring to a product of seven cyclic groups. Each cyclic group Z/q is a circle -- q evenly spaced points. The product of seven circles is a 7-torus. Every ring element is a point on this torus. The eigenvalue function is the landscape.");
  dom_append(dom_body(), hero)
)

fn tor_resolution() = (
  let sec = make_section("800px") in
  render_h2(sec, "Channel Resolution");
  render_p(sec, "Each channel is a circle with q points. The angular step 2*pi/q determines the resolution -- how finely that channel distinguishes elements. Larger modulus = finer resolution:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus");
  render_th(hdr, "Step (rad)");
  render_th(hdr, "Resolution");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "b (depth)", "49", "0.128", "Finest -- 49 positions");
  render_table_row_4(tbl, "E (observer)", "25", "0.251", "Fine -- 25 positions");
  render_table_row_4(tbl, "ESCAPE", "17", "0.370", "Medium -- 17 positions");
  render_table_row_4(tbl, "GATE", "13", "0.483", "Medium -- 13 positions");
  render_table_row_4(tbl, "L (protector)", "11", "0.571", "Moderate -- 11 positions");
  render_table_row_4(tbl, "K (closure)", "9", "0.698", "Coarse -- 9 positions");
  render_table_row_4(tbl, "D (bridge)", "8", "0.785", "Coarsest -- 8 positions");
  render_p(sec, "Depth (b) has the finest resolution. Bridge (D) has the coarsest. On the torus, toggling the b-channel is the smallest move -- exactly 2*pi/49 = 0.128 radians. The cheapest direction IS depth.");
  let g = make_findings_grid(sec) in
  render_finding(g, "490 split", "DATA = coarsest + finest", "The DATA channels {D, E, b} span the full resolution range: 8 to 49 positions. ALIVE channels {K, L, GATE, ESCAPE} have intermediate 9-17.", "S1329");
  render_finding(g, "Nearest neighbors", "Always differ in b", "Among the 128 idempotents, the 64 closest pairs ALL differ only in the b-channel. Distance = 0.128. Toggling depth is always the cheapest algebraic move.", "S1330");
  dom_append(dom_body(), sec)
)

fn tor_landscape() = (
  let sec = make_section("800px") in
  render_h2(sec, "Eigenvalue Landscape");
  render_p(sec, "The eigenvalue function on the torus is: lambda = sum over channels of 2*cos(2*pi*r/q). Maximum +14 at the void (all r=0). Minimum near -14 at the anti-void (each r = floor(q/2)). Key numbers:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Element");
  render_th(hdr, "Value");
  render_th(hdr, "Eigenvalue");
  render_th(hdr, "Location");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "void", "0", "+14.00", "North pole (all cos=1)");
  render_table_row_4(tbl, "sigma", "1", "+12.19", "Near void (all r=1)");
  render_table_row_4(tbl, "anti-void", "93806212", "-13.69", "South pole (r ~ q/2)");
  render_table_row_4(tbl, "D", "2", "+7.48", "Equatorial descent");
  render_table_row_4(tbl, "HYDOR", "105", "+3.02", "Warm medium");
  render_table_row_4(tbl, "322", "322", "+1.82", "Near equator, -1 in ESCAPE");
  render_table_row_4(tbl, "ESCAPE", "17", "+0.32", "Near equator");
  render_table_row_4(tbl, "L", "11", "-0.68", "Just below equator");
  render_table_row_4(tbl, "b", "7", "-2.32", "Deep south");
  render_table_row_4(tbl, "E", "5", "-5.04", "Deeper south");
  render_table_row_4(tbl, "lambda", "420", "-4.61", "Deep south (heartbeat)");
  render_p(sec, "The chain primes trace a path from the north pole (void) through the equator and into the southern hemisphere. Depth (b=7) and observation (E=5) are the southernmost axiom elements. Light (L=11) sits just below the equator -- enlightenment is not warmth.");
  dom_append(dom_body(), sec)
)

fn tor_idempotents() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 128 Idempotent Skeleton");
  render_p(sec, "The 128 idempotents of the TRANS ring form the vertices of a 7-dimensional hypercube embedded in the torus. Each idempotent is a subset of the 7 lifting idempotents, with CRT coordinates that are 0 or 1 in each channel. They all cluster near the north pole:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Active channels");
  render_th(hdr, "Count");
  render_th(hdr, "Mean eigenvalue");
  render_th(hdr, "Eigen range");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0 (void)", "1", "+14.00", "14.00");
  render_table_row_4(tbl, "1", "7", "+13.74", "13.41 to 13.98");
  render_table_row_4(tbl, "2", "21", "+13.48", "12.95 to 13.92");
  render_table_row_4(tbl, "3", "35", "+13.22", "12.63 to 13.79");
  render_table_row_4(tbl, "4", "35", "+12.96", "12.40 to 13.56");
  render_table_row_4(tbl, "5", "21", "+12.70", "12.26 to 13.24");
  render_table_row_4(tbl, "6", "7", "+12.44", "12.20 to 12.77");
  render_table_row_4(tbl, "7 (sigma)", "1", "+12.19", "12.19");
  render_p(sec, "The eigenvalue drops monotonically with the number of active channels. Each channel costs ~0.26 eigenvalue units. The void (0 active) is maximum; sigma (7 active) is the skeleton's minimum. The 7-cube's binomial distribution (1, 7, 21, 35, 35, 21, 7, 1) is the idempotent census.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Skeleton span", "14.00 to 12.19 = 1.81", "The 128 idempotents span only 1.81 out of the theoretical 28. They are ALL in the warmest 13% of the torus. Idempotents are inherently close to the void.", "S1330");
  render_finding(g, "OMEGA = mask 126", "All but D active", "OMEGA = sum of 6 idempotents (exclude D). eigenvalue = +12.77. OMEGA sits one D-step from sigma -- the terminal shadow, nearly touching existence.", "S1330");
  dom_append(dom_body(), sec)
)

fn tor_322() = (
  let sec = make_section("800px") in
  render_h2(sec, "322: The Escape Mirror");
  render_p(sec, "322 = 2 * 7 * 23. It factors through D and b, with the 23rd prime joining them. In the ESCAPE channel: 322 mod 17 = 16 = -1. The mirror, but only in transcendence.");
  render_p(sec, "On the torus, 322 sits near the spectral equator with eigenvalue +1.82. Its ESCAPE angle is 2*pi*16/17 = 5.91 radians -- almost a full circle back. In every other channel, it has non-trivial residues encoding the axiom primes:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "322 mod q");
  render_th(hdr, "Theta");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D (mod 8)", "2 = D", "pi/4", "Bridge");
  render_table_row_4(tbl, "K (mod 9)", "7 = b", "4.89", "Depth in closure");
  render_table_row_4(tbl, "E (mod 25)", "22", "5.53", "Near south pole");
  render_table_row_4(tbl, "b (mod 49)", "28", "3.59", "Mid-circle");
  render_table_row_4(tbl, "L (mod 11)", "3 = K", "1.71", "Closure in protection");
  render_table_row_4(tbl, "GATE (mod 13)", "10", "4.83", "Near south pole");
  render_table_row_4(tbl, "ESCAPE (mod 17)", "16 = -1", "5.91", "Mirror (almost 2*pi)");
  render_p(sec, "The CRT residues of 322 encode axiom primes: D appears in the D-channel, b appears in the K-channel, K appears in the L-channel. This is the axiom's DNA scattered across channels -- readable only through the CRT lens of the torus.");
  dom_append(dom_body(), sec)
)

/* === INTERACTIVE: Torus Explorer === */
fn tor_explore_run() = (
  let n = parse_int_from("#tor-input") in
  let nn = n % 214414200 in
  let result = dom_query("#tor-result") in
  let rd = nn % 8 in let rk = nn % 9 in let re = nn % 25 in
  let rb = nn % 49 in let rl = nn % 11 in let rg = nn % 13 in let r17 = nn % 17 in
  /* Eigenvalue = sum 2*cos(2*pi*r/q). Approximate with integer math.
     cos(2*pi*r/q) ~ 1 - 2*(pi*r/q)^2 for small r/q. For display, use categories. */
  /* Count how many channels have r <= q/4 (warm) vs r >= q/4 (cool) */
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  let rs = [rd, rk, re, rb, rl, rg, r17] in
  mut warm = 0;
  mut cool = 0;
  mut ci = 0;
  while ci < 7 do (
    let r = rs[ci] in
    let q = mods[ci] in
    /* Warm if r < q/4 or r > 3q/4 (near 0 or 2pi), cool if q/4 <= r <= 3q/4 */
    if r * 4 < q then mut warm = warm + 1
    else if r * 4 > q * 3 then mut warm = warm + 1
    else mut cool = cool + 1;
    mut ci = ci + 1
  );
  let zone = if warm >= 5 then "NORTH (warm, near void)"
    else if cool >= 5 then "SOUTH (cool, deep)"
    else "EQUATORIAL (mixed)" in
  /* Bar chart: each channel gets a bar proportional to r/q */
  let bar_d = (rd * 100) / 8 in
  let bar_k = (rk * 100) / 9 in
  let bar_e = (re * 100) / 25 in
  let bar_b = (rb * 100) / 49 in
  let bar_l = (rl * 100) / 11 in
  let bar_g = (rg * 100) / 13 in
  let bar_17 = (r17 * 100) / 17 in
  dom_inner(result,
    "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>"
    + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>TORUS POSITION: " + "${nn}" + " in Z/214414200</p>"
    + "<p style='color:#b0b0c0;margin:0 0 12px;font-size:13px'>Zone: <span style='color:#88ddaa'>" + zone + "</span> (" + "${warm}" + " warm, " + "${cool}" + " cool channels)</p>"
    + "<div style='display:flex;flex-direction:column;gap:4px'>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>D (8)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rd}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_d}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>K (9)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rk}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_k}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>E (25)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${re}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_e}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#ff6666;width:60px;font-size:11px'>b (49)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rb}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#ff6666;height:100%;width:" + "${bar_b}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>L (11)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rl}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_l}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#44ff88;width:60px;font-size:11px'>GATE (13)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${rg}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#44ff88;height:100%;width:" + "${bar_g}" + "%'></div></div></div>"
    + "<div style='display:flex;align-items:center;gap:8px'><span style='color:#88aaff;width:60px;font-size:11px'>ESC (17)</span><span style='color:#88ddaa;font-size:11px;width:24px'>" + "${r17}" + "</span><div style='background:#1a1a2e;flex:1;height:16px;border-radius:4px;overflow:hidden'><div style='background:#88aaff;height:100%;width:" + "${bar_17}" + "%'></div></div></div>"
    + "</div>"
    + "<p style='color:#b0b0c0;margin:12px 0 0;font-size:12px'>Bar = r/q (0% = north, 50% = south in that channel). Red = DATA channels. Green = ALIVE channels. Blue = ESCAPE.</p>"
    + "</div>")
)

fn tor_explore() = (
  let sec = make_section("800px") in
  render_h2(sec, "Torus Explorer");
  render_p(sec, "Enter any number to see its position on the 7-torus. The bar chart shows each channel's CRT residue as a fraction of the modulus -- 0% means north (r=0, cos=+1), 50% means south (r=q/2, cos=-1).");
  make_interactive_widget(sec, "Number:", "tor-input", "e.g. 322", "Explore", "tor_explore_run", "tor-result");
  render_p(sec, "Try: 42 (ANSWER), 322 (escape mirror), 420 (lambda), 137 (ADDRESS), 7 (depth).");
  dom_append(dom_body(), sec)
)

fn tor_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "A number is", "A point on the number line", "A point on a 7-torus. 7 independent angles.");
  render_contrast_row(tbl, "Distance between numbers", "|a - b|", "Geodesic on T^7. Accounts for wrap-around in each channel.");
  render_contrast_row(tbl, "Special numbers", "Primes, composites, etc.", "Critical points of the eigenvalue landscape on T^7.");
  render_contrast_row(tbl, "Resolution", "Uniform (all digits equal)", "Non-uniform. b = finest (49 positions), D = coarsest (8).");
  render_contrast_row(tbl, "Idempotents", "0 and 1 only", "128 = vertices of a 7-cube. The skeleton of the torus.");
  dom_append(dom_body(), sec)
)

fn page_torus() = (
  dom_head_meta("description", "The TRANS ring as a 7-torus. CRT maps every number to a point on T^7. Eigenvalue landscape, 128 idempotent skeleton, channel resolution, 322 as the escape mirror. Interactive torus explorer.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The 7-Torus\",\"description\":\"CRT maps Z/214414200 to a 7-dimensional torus. Eigenvalue landscape analysis. 128 idempotents form the skeleton. Interactive torus explorer.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/structure/torus\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"7-torus\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"eigenvalue landscape\"}]}");
  tor_hero();
  tor_resolution();
  tor_landscape();
  tor_idempotents();
  tor_322();
  tor_explore();
  tor_contrast()
)
