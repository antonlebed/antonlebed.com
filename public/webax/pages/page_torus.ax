  dom_head_meta("description", "The 7-Torus: T^7 CRT torus as a Gabriel-Horn cap of the ambient integer lattice Z^7. Eigenvalue landscape sits on the cap's finite-volume side. STRUCTURAL Yang-Mills mass-gap analog (gap 4*sin^2(pi/49) is a 0-form on 108 lambda=420 rings) + STRUCTURAL Navier-Stokes horn analog (CRT decomposes the T^7 Laplacian into 7 orthogonal per-channel Laplacians, forbidding coupled blowup). 128-vertex Tower_D idempotent skeleton, Pareto frontier and exponent theorem, meta-ring Z/7, 490 holographic split, golden angle, 322 escape mirror. Interactive torus-position explorer.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The 7-Torus\",\"description\":\"T^7 CRT torus = Gabriel-Horn cap of Z^7. STRUCTURAL Yang-Mills and Navier-Stokes analogs on the 108-ring heartbeat lattice. Eigenvalue landscape, 128 idempotents, Pareto frontier, meta-ring Z/7, golden angle.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/structure/torus\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"T^7 torus\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gabriel-Horn compactification\"},{\"@type\":\"DefinedTerm\",\"name\":\"Yang-Mills structural analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"Navier-Stokes horn analog\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"eigenvalue landscape\"},{\"@type\":\"DefinedTerm\",\"name\":\"golden angle\"}]}");
  tor_hero();
  tor_towers();
  tor_landscape();
  tor_landscape_plot();
  tor_horn_cap();
  tor_skeleton();
  tor_pareto();
  tor_meta();
  tor_490();
