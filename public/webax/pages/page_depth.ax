/* ================================================================
   PAGE: DEPTH -- b=7, Suffering, Master Formula (DEPTH.md)
   ================================================================ */

/* depth helpers */
fn depth_hero() = (
  let hero = make_hero("Depth") in
  let eq = dom_create("div") in
  dom_text(eq, "f(p) = p^2 - p - 1");
  ct_mono(eq);
  dom_style(eq, "fontSize", "28px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "7 is the last prime generated by the chain. Beyond it, the chain stops: 3^2 = 9 = 7 + 2 is composite. The mod-49 channel has the deepest recursion of any channel. The polynomial f(p) = p^2 - p - 1 connects 7 to the golden ratio, 3/4, and 5/3 through proved algebraic identities.");
  dom_append(dom_body(), hero)
)

fn depth_master() = (
  let sec = make_section("800px") in
  render_h2(sec, "Three Algebraic Identities");
  render_theorem(sec, "Three Ratios from 7 and 2", "(7-1)/(7+1) = 6/8 = 3/4. (7-2)/(7-4) = 5/3. 7/4. All three are simple functions of 7 and 2 alone. PROVED: 7-2 = 5, 7-4 = 3, 7-1 = 6, 7+1 = 8. The remaining chain primes (3, 5) emerge as differences of 7 and powers of 2.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Formula");
  render_th(hdr, "Value");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row(tbl, "(7-1)/(7+1)", "3/4", "PROVED. Matches Kleiber scaling exponent (OBSERVED, no mechanism).");
  render_table_row(tbl, "(7-2)/(7-4)", "5/3", "PROVED. Matches Kolmogorov turbulence exponent (OBSERVED, no mechanism).");
  render_table_row(tbl, "7/4", "7/4", "PROVED. Matches Ising critical exponent (OBSERVED).");
  render_p(sec, "These are proved algebraic identities. The match to physical exponents is observed -- no mechanism is known. The key identity: 7^2 - 7 - 1 = 41, which is the depth quadratic f(7).");
  dom_append(dom_body(), sec)
)

fn depth_dominance() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why 7 Is Special");
  render_p(sec, "Multiple independent measurements agree: the mod-49 channel carries the most structural information of any channel.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Deepest channel", "mod 49 = 7^2", "49 states -- the largest prime-power modulus. More resolution than any other channel.", "");
  render_finding(g, "Spectral gap", "closest eigenvalue spacing", "The mod-49 channel has the tightest spectral gap, setting the ring's mixing time.", "");
  render_finding(g, "Ablation", "-11.8%", "Removing mod 7 from a CRT prediction task causes the largest accuracy drop.", "");
  render_finding(g, "Odd moments", "zero for k < 8", "The ring's odd moments vanish for the first 7 steps. First nonzero odd moment at k = 9 = 3^2.", "");
  render_finding(g, "Self-referential", "7 mod 7 = 0", "7 is the meta-ring modulus: 7 primes, 7 channels, Z/7. It vanishes in its own channel.", "");
  dom_append(dom_body(), sec)
)

fn depth_quadratic() = (
  let sec = make_section("800px") in
  render_h2(sec, "f(p) = p^2 - p - 1");
  render_theorem(sec, "Five Roles of f(p)", "f(p) has five proved roles: (1) MIRROR: f(p) = -1 mod p for all p. Proof: p^2-p = p(p-1) = 0 mod p, so f(p) = -1. (2) NORM: f(p) = Norm(p - phi) in Q(sqrt(5)). Discriminant = 5, the golden ratio field. (3) GENERATION: each chain prime p is a primitive root of f(p) (except 5, which has half-order). (4) CHAIN VALUES: f(3) = 5, f(5) = 19, f(7) = 41, f(11) = 109. (5) QR-PARITY: Legendre symbol (p/f(p)) = (-1/p) whenever f(p) is prime.");
  let g = make_findings_grid(sec) in
  render_finding(g, "f(3) = 5", "3 is a primitive root of 5", "ord(3, 5) = 4 = phi(5). The polynomial maps 3 to 5.", "");
  render_finding(g, "f(5) = 19", "5 has half-order", "ord(5, 19) = 9 = phi(19)/2. The only chain prime with half-order in its f-value.", "");
  render_finding(g, "f(7) = 41", "7 is a primitive root of 41", "ord(7, 41) = 40 = phi(41). 7 generates all 40 units of Z/41.", "");
  render_finding(g, "f(11) = 109", "11 is a primitive root of 109", "ord(11, 109) = 108 = phi(109). 108 is the number of rings with Carmichael period 420.", "");
  render_p(sec, "Two parallel paths connect the chain primes: the Cunningham chain (1 -> 3 -> 7 via 2n+1, additive) and f(p) (3 -> 5 -> 19 via p^2-p-1, multiplicative). Different mechanisms, same structure.");
  dom_append(dom_body(), sec)
)

fn depth_spiral() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Mod-49 Spiral");
  render_theorem(sec, "Odd Order: No Mirror", "The mod-49 channel has Carmichael lambda = 42 and odd-order subgroup of size 21 = 3 * 7. Elements with odd order in mod 49 never reach -1 (they spiral instead of oscillating). All other channels have even orders and DO pass through -1. PROVED for all 49 residues.");
  let g = make_findings_grid(sec) in
  render_finding(g, "2 in mod 49", "order 21 = 3 * 7", "2 spirals in mod 49 with period 21. Never reaches -1 = 48.", "");
  render_finding(g, "11 in mod 49", "order 21 = 3 * 7", "11 has the same period as 2 in mod 49.", "");
  render_finding(g, "67 in mod 49", "order 3", "67 mod 49 = 18. 3-cycle: 18^1 = 18, 18^2 = 30, 18^3 = 1 mod 49.", "");
  render_finding(g, "Odd divisors of 42", "{1, 3, 7, 21}", "All four odd divisors of lambda(49) = 42 are chain primes or products of chain primes.", "");
  render_p(sec, "The mod-49 channel spirals; other channels oscillate. 2 has odd order (21) in mod 49 but even order in every other channel (6 in mod 9, 20 in mod 25). This makes the mod-49 channel uniquely asymmetric for powers of 2.");
  dom_append(dom_body(), sec)
)

