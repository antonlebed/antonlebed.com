fn depth_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard View");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "(7-1)/(7+1) = 3/4", "Coincidence", "PROVED algebraic identity. Matches Kleiber scaling exponent (OBSERVED, mechanism unknown).");
  render_contrast_row(tbl, "(7-2)/(7-4) = 5/3", "Coincidence", "PROVED algebraic identity. Matches Kolmogorov exponent (OBSERVED, mechanism unknown).");
  render_contrast_row(tbl, "Deepest channel", "7 is not special", "mod 49 has the most states of any channel. Multiple measurements confirm dominance.");
  render_contrast_row(tbl, "Golden ratio", "Aesthetic preference", "Discriminant of f(p) = p^2-p-1 is 5. Roots are the golden ratio. PROVED.");
  render_contrast_row(tbl, "f(7) = 41", "Just a number", "7^2 - 7 - 1 = 41. 7 is a primitive root of 41 (ord = 40 = phi(41)). PROVED.");
  dom_append(dom_body(), sec)
)

/* ================================================================
   INTERACTIVE: DEPTH QUADRATIC EXPLORER
   f(p) = p^2 - p - 1. Enter p, see f(p) and verify f(p) = -1 mod p.
   ================================================================ */

fn depth_quad_compute() = (
  let p = parse_int_from("#dq-input") in
  let result = dom_query("#dq-result") in
  let fp = p * p - p - 1 in
  /* f(p) mod p should always be p-1 = -1 */
  let fp_mod_p = if p > 1 then fp % p else 0 in
  let is_mirror = if p > 1 then (if fp_mod_p == p - 1 then "YES (= p-1 = -1 mod p)" else "NO") else "n/a" in
  /* CRT of f(p) */
  let fd = fp % 8 in let fk = fp % 9 in let fe = fp % 25 in let fb = fp % 49 in let fl = fp % 11 in let fg = fp % 13 in
  /* Check chain values */
  let name = if fp == 5 then " = f(3)"
    else if fp == 19 then " = f(5)"
    else if fp == 41 then " = f(7), primitive root"
    else if fp == 109 then " = f(11), phi(109) = 108"
    else if fp == 155 then " = f(13)"
    else "" in
  dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'><b>p = " + "${p}" + "</b> | f(p) = p^2 - p - 1 = <b>" + "${fp}" + "</b>" + name + "</p><p style='color:#ffd700;margin:4px 0'>f(p) mod p = " + "${fp_mod_p}" + " | Mirror property: " + is_mirror + "</p><p style='color:#ff8844;margin:4px 0'>CRT(" + "${fp}" + ") = (" + "${fd}" + "," + "${fk}" + "," + "${fe}" + "," + "${fb}" + "," + "${fl}" + "," + "${fg}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>p^2 = " + "${p * p}" + " | Identity: 7^2 - 7 - 1 = 41</p>")
)

fn depth_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Depth Quadratic f(p) = p^2 - p - 1");
  render_p(sec, "The depth quadratic has a universal mirror property: f(p) = -1 mod p for ALL p. Proof: p^2-p = p(p-1) = 0 mod p, so f(p) = 0-1 = -1 mod p. Enter any prime (or any number) to verify.");
  make_interactive_widget(sec, "Enter p:", "dq-input", "e.g. 7", "Compute f(p)", "depth_quad_compute", "dq-result");
  render_p(sec, "Try chain primes: 3 (f=5), 5 (f=19), 7 (f=41), 11 (f=109, phi=108). Then try 13 (f=155).");
  dom_append(dom_body(), sec)
)

fn depth_product() = (
  let sec = make_section("800px") in
  render_h2(sec, "105 = 3 * 5 * 7");
  render_p(sec, "The product of the three middle chain primes. It excludes 2 (the pair) and 11 (the check). 105 = 210/2: exactly half of Z/210.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Chain stops at 7", "3^2 = 9 = 7+2", "Beyond 7: only composites. The Cunningham chain produces no more primes.", "");
  render_finding(g, "Asymmetric eigenvalues", "49 is odd", "In every ring containing mod 49, the maximum eigenvalue exceeds |minimum eigenvalue|. Odd moduli produce asymmetric spectra.", "");
  render_finding(g, "3^4 + 24 = 105", "81 + 24 = 105", "The fourth power of 3 plus 24 (the central charge of the Leech lattice / Dedekind eta) equals 105.", "");
  dom_append(dom_body(), sec)
)

fn depth_490() = (
  let sec = make_section("800px") in
  render_h2(sec, "490: A Zero Divisor");
  render_theorem(sec, "490 Spiral (PROVED)", "490 = 2 * 5 * 7^2. CRT(490) in Z/970,200 = (2, 4, 15, 0, 6). The mod-49 channel is zero: 490 is a zero divisor. Powers of 490 progressively kill channels: mod 49 dies at step 1 (7^2 divides 490), mod 25 at step 2 (5^2 divides 490^2), mod 8 at step 3 (2^3 divides 490^3). Only mod 9 and mod 11 survive. The terminal value 490^420 = 960,400 is an idempotent: CRT = (0, 1, 0, 0, 1) in Z/970,200. It permanently projects onto the mod-9 and mod-11 channels.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Channel death sequence", "mod 49 -> mod 25 -> mod 8", "Channels die in order of divisibility. mod 9 and mod 11 survive because 490 is coprime to 9 and 11.", "");
  render_finding(g, "Surviving periods", "3 and 10", "mod-9 orbit has period 3, mod-11 orbit has period 10. lcm(3, 10) = 30.", "");
  render_finding(g, "Terminal idempotent", "960,400", "490^420 = 960,400. CRT = (0, 1, 0, 0, 1). Idempotent: 960,400^2 = 960,400 mod 970,200.", "");
  render_finding(g, "Dual annihilator", "490 * 1,980 = 970,200", "coupling(490) = 1,980. Their product equals the ring size.", "");
  dom_append(dom_body(), sec)
)

fn page_depth() = (
  dom_head_meta("description", "7 is the last chain prime. (7-1)/(7+1) = 3/4, (7-2)/(7-4) = 5/3: proved algebraic identities matching scaling exponents. f(p) = p^2-p-1 has 5 roles. 490 = 2*5*49 is a zero divisor. The mod-49 spiral never mirrors.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Depth: 7\",\"description\":\"7 is the last chain prime. Algebraic identities: (7-1)/(7+1)=3/4, (7-2)/(7-4)=5/3. Depth quadratic f(p)=p^2-p-1 maps chain primes to chain primes. 490 is a zero divisor with a spiral idempotent.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/ideas/depth\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"depth quadratic\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring algebra\"}]}");
  depth_hero();
  depth_master();
  depth_dominance();
  depth_product();
  depth_quadratic();
  depth_interactive();
  depth_490();
  depth_spiral();
  depth_contrast()
)
