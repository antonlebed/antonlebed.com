    p279, 6);
  dom_append(dom_body(), s279);

  -- THM 280: DEVELOPMENTAL PROGRAM THEOREM (S2267)
  let s280 = make_section("700px") in
  render_h2(s280, "280. Developmental Programs");
  render_p(s280, "5 rules (CAPTURE, PRESERVE, ADD, ZERO, SUBTRACT) as developmental program vocabulary. Each rule generates a full 2D-PLUT position table from a single choice. 5-gene genome (1 rule per position) compresses 18750 entries to 5 choices (3750x).");
  pf_result(s280, "Copy genome [0,1,1,1,1]: 1400/1400 (100%). 2 optima in 3125 genomes.", "1400", 1);
  pf_result(s280, "Pattern genome [4,2,1,1,1]: 1400/1400 (100%). 45 optima in 3125 genomes.", "1400", 1);
  pf_result(s280, "Same 5-rule vocabulary solves BOTH memory and computation tasks.", "5", 1);
  pf_result(s280, "Coordinate search (26 evals): copy SUCCEEDS, pattern FAILS.", "26", 1);
  pf_result(s280, "Pattern barrier at rule level: pos 0+1 must coordinate (SUBTRACT+ADD).", "2", 1);
  pf_result(s280, "Exhaustive 3125 genomes: BOTH tasks solved. Compression makes exhaustive tractable.", "3125", 1);
  pf_result(s280, "Compression: 18750 entries -> 5 genes = 3750x.", "${18750 / 5}", if 18750 / 5 == 3750 then 1 else 0);
  pf_result(s280, "Coordination barrier persists at EVERY search level: entries, rules, coordinate.", "3", 1);
  pf_result(s280, "Dissolved only by exhaustive enumeration in compressed space.", "1", 1);
  let p280 = 8 + (if 18750 / 5 == 3750 then 1 else 0) in
  pf_theorem(s280, "DEVELOPMENTAL PROGRAM THEOREM",
    "Five developmental rules (CAPTURE: h=x, PRESERVE: h=h, ADD: h=(h+x)%q, ZERO: h=0, SUBTRACT: h=(h-x+q)%q) compress 18750 2D-PLUT entries to a 5-gene genome (3750x). Copy=[0,1,1,1,1]=100% (2 optima). Pattern=[4,2,1,1,1]=100% (45 optima). Same vocabulary, both tasks. Coordinate search (26 evals): copy succeeds (pos 0 alone suffices), pattern FAILS (pos 0+1 must coordinate). Exhaustive search (3125 genomes): BOTH solved. The coordination barrier persists at ALL levels -- entries (THMs 277-279), rules (coordinate search) -- and is dissolved ONLY by exhaustive enumeration in compressed space. Genomes encode rules, not weights. test_crt_lm_dev_prog.ax 9/9.",
    p280, 9);
  dom_append(dom_body(), s280);

