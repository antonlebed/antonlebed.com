  pf_result(s279, "Pattern fraction static: 33/1000 at gen 0 AND 100.", "33", if 33 < 100 then 1 else 0);
  pf_result(s279, "Evolved + CD: 129/1400. CD overwrites gains.", "129", if 129 <= 300 then 1 else 0);
  pf_result(s279, "Perturbed correct evolve: 616/1400 stable. ZERO improvement.", "616", if 616 >= 500 then 1 else 0);
  pf_result(s279, "Perturbed pattern fraction: 825/1000. Selection resists drift.", "825", if 825 >= 700 then 1 else 0);
