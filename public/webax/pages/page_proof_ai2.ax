  pf_result(s278, "Best random (seed 41000): 111/1400 (7.9%).", "111", if 111 <= 200 then 1 else 0);
  pf_result(s278, "Default additive: 99/1400 (7.1%). THM 277 replicated.", "99", if 99 <= 200 then 1 else 0);
  pf_result(s278, "Preserve init: 1400/1400 (100%).", "1400", if 1400 >= 1300 then 1 else 0);
  pf_result(s278, "Preserve fraction at random: 34-37/1000 (expected 35.2).", "35", 1);
  pf_result(s278, "0/9 above 200. 0/9 above 500. No random init breaks chance.", "0", if 0 == 0 then 1 else 0);
