  -- THM 277: COORDINATION BARRIER THEOREM (S2264)
  let s277 = make_section("700px") in
  render_h2(s277, "277. Coordination Barrier");
  render_p(s277, "2D-PLUT on copy task. Per-position independence does NOT dissolve basin wall.");
  pf_result(s277, "2D-PLUT correct init: 1400/1400 (100%).", "1400", 1);
  pf_result(s277, "2D-PLUT default CD: 99/1400 (7.1%, chance). Basin wall NOT dissolved.", "99", if 99 <= 200 then 1 else 0);
  pf_result(s277, "2D-PLUT preserve init: 1400/1400 (100%).", "1400", 1);
  pf_result(s277, "Default vs 2D-LUT additive (106): 99 -- same barrier.", "99", if 99 <= 200 then 1 else 0);
  pf_result(s277, "Preserve vs 2D-LUT preserve (1301): 1400 > 1301. Per-position tables HELP from correct basin.", "1400", if 1400 > 1301 then 1 else 0);
  let p277 = 5 in
  pf_theorem(s277, "COORDINATION BARRIER THEOREM",
    "2D-PLUT is architecturally universal but NOT universally trainable from default. Initialization IS the inductive bias: memory tasks need preserve-state init, computation tasks work from additive default. 2D-PLUT + task-appropriate init = universal CRT-LM architecture. test_crt_lm_2dplut_copy.ax 7/7.",
    p277, 5);
