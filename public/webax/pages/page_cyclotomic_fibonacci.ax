/* Cyclotomic: split lookup tables into separate functions */
fn cf_phi(n) = (
  if n == 1 then 1 else if n == 2 then 3 else if n == 3 then 7
  else if n == 4 then 5 else if n == 5 then 31 else if n == 6 then 3
  else if n == 7 then 127 else if n == 8 then 17 else if n == 9 then 73
  else if n == 10 then 11 else if n == 11 then 2047 else if n == 12 then 13
  else if n == 13 then 8191 else if n == 14 then 43 else if n == 15 then 151
  else if n == 16 then 257 else if n == 17 then 131071 else if n == 18 then 19
  else if n == 19 then 524287 else if n == 20 then 41 else 0
)

fn cf_name(v) = (
  if v == 1 then " = identity" else if v == 3 then " (chain prime)"
  else if v == 5 then " (chain prime)" else if v == 7 then " (chain prime)"
  else if v == 11 then " (chain prime)" else if v == 13 then " (chain prime)"
  else if v == 17 then " (ring closer)" else if v == 19 then " = f(5)"
  else if v == 31 then " = 2^5-1" else if v == 41 then " = f(7) = 7^2-7-1"
  else if v == 43 then " (Heegner)" else if v == 127 then " = 2^7-1"
  else ""
)

fn cf_smooth(val) = (
  mut v = val;
  while v % 2 == 0 do (mut v = v / 2);
  while v % 3 == 0 do (mut v = v / 3);
  while v % 5 == 0 do (mut v = v / 5);
  while v % 7 == 0 do (mut v = v / 7);
  while v % 11 == 0 do (mut v = v / 11);
  if v == 1 then 1 else 0
)

fn cf_check() = (
  let n = parse_int_from("#cf-input") in
  let result = dom_query("#cf-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else if n > 20 then dom_inner(result, "<p style='color:#ff6666'>Max n=20.</p>")
  else (
    mut pow2 = 1;
    mut pi = 0;
    while pi < n do (mut pow2 = pow2 * 2; mut pi = pi + 1);
    let pv = cf_phi(n) in
    let sm = cf_smooth(pv) in
    let sc = if sm > 0 then "<span style='color:#88ddaa'>SMOOTH</span>" else "<span style='color:#ff6666'>NOT smooth</span>" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>2^" + "${n}" + "-1 = " + "${pow2 - 1}" + "</p><p style='color:#ffd700;margin:4px 0'>Phi_" + "${n}" + "(2) = " + "${pv}" + cf_name(pv) + "</p><p style='margin:4px 0'>" + sc + "</p>")
  )
)

fn page_cyclotomic_fibonacci() = (
  dom_head_meta("description", "Cyclotomic polynomials evaluated at 2 generate the chain primes {1,3,5,7,11,13}. Exactly 6 smooth indices. Fibonacci: F(5)=5 (fixed point), F(7)=13. Pisano periods at chain primes have lcm = 240 = |roots(E8)|. Twin Gate: both divisor sums and Fibonacci break at 13.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Cyclotomic-Fibonacci Bridge\",\"description\":\"Cyclotomic polynomials at 2 generate chain primes. Fibonacci fixed point F(5)=5. Pisano lcm = 240 = E8 roots.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/cyclotomic_fibonacci\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"cyclotomic polynomials\"},{\"@type\":\"DefinedTerm\",\"name\":\"Fibonacci\"},{\"@type\":\"DefinedTerm\",\"name\":\"Pisano periods\"}]}");
  /* === HERO === */
  let hero = make_hero("Cyclotomic-Fibonacci Bridge") in
  let big = dom_create("div") in
  dom_text(big, "Phi_n(2) generates {1, 3, 5, 7, 11, 13}");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Two classical sequences independently produce the ring's primes. Cyclotomic polynomials evaluated at 2 yield {1, 3, 5, 7, 11, 13} -- all six chain primes. The Fibonacci sequence has a fixed point at F(5) = 5, and its periods modulo chain primes have lcm = 240 = |roots(E8)|. Two independent paths, same destination.");
  dom_append(dom_body(), hero);

  /* === SEC 1: CYCLOTOMIC GENERATION === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Cyclotomic Polynomials at x = 2");
  render_theorem(sec1, "Cyclotomic Generation (PROVED)", "Phi_n(2) is 11-smooth for exactly n in {1, 2, 3, 4, 6, 10} -- six values. The distinct outputs are {1, 3, 5, 7, 11} (3 appears twice, from n=2 and n=6). The next index n = 12 gives Phi_12(2) = 13, breaking smoothness.");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "n");
  render_th(chdr, "Phi_n(x)");
  render_th(chdr, "Phi_n(2)");
  render_th(chdr, "11-smooth?");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "1", "x - 1", "1", "Yes");
  render_table_row_4(ctbl, "2", "x + 1", "3", "Yes");
  render_table_row_4(ctbl, "3", "x^2 + x + 1", "7", "Yes");
  render_table_row_4(ctbl, "4", "x^2 + 1", "5", "Yes");
  render_table_row_4(ctbl, "5", "x^4 + ... + 1", "31", "No (31 > 11)");
  render_table_row_4(ctbl, "6", "x^2 - x + 1", "3", "Yes");
  render_table_row_4(ctbl, "10", "x^4 - x^3 + ... + 1", "11", "Yes");
  render_table_row_4(ctbl, "12", "x^4 - x^2 + 1", "13", "Wall: first value > 11");
  dom_append(sec1, ctbl);
  render_p(sec1, "The input 2 itself is not an output -- it is the generator. All other chain primes emerge from evaluating cyclotomic polynomials at 2. The first Mersenne number outside the chain: Phi_5(2) = 31 = 2^5 - 1.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: ZSYGMONDY CHARACTERIZATION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Zsygmondy Characterization");
  render_theorem(sec2, "Zsygmondy Smooth Zone (PROVED)", "Phi_n(2) is 11-smooth if and only if every Zsygmondy primitive prime divisor of 2^n - 1 is at most 11. The primitive primes at indices n = 2, 3, 4, 10 are exactly 3, 7, 5, 11 (the chain primes). Index n = 6 has no primitive prime (the unique Zsygmondy exception at base 2). Index n = 12 introduces 13, which breaks smoothness.");
  let ztbl = dom_create("table") in
  dom_style(ztbl, "width", "100%");
  dom_style(ztbl, "maxWidth", "700px");
  dom_style(ztbl, "margin", "24px auto");
  dom_style(ztbl, "borderCollapse", "collapse");
  let zhdr = dom_create("tr") in
  render_th(zhdr, "Chain prime");
  render_th(zhdr, "Zsygmondy index n");
  render_th(zhdr, "Index");
  dom_append(ztbl, zhdr);
  render_table_row(ztbl, "3", "n = 2", "2");
  render_table_row(ztbl, "5", "n = 4", "4");
  render_table_row(ztbl, "7", "n = 3", "3");
  render_table_row(ztbl, "11", "n = 10", "10");
  render_table_row(ztbl, "13 (wall)", "n = 12", "12 = lambda(Z/210)");
  dom_append(sec2, ztbl);
  dom_append(dom_body(), sec2);

  /* === SEC 3: TWIN GATE THEOREM === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Twin Gate Theorem");
  render_theorem(sec3, "f(x) = Phi_6(x) - 2 (PROVED)", "The polynomial f(x) = x^2 - x - 1 (golden ratio zeros, discriminant 5) equals Phi_6(x) - 2. Also: Phi_3(2) = 7 and Phi_3(3) = 13. The same cyclotomic polynomial maps 2 to 7 and 3 to 13.");
  render_theorem(sec3, "Twin Gate (PROVED)", "Two classical sequences hit the same wall at 13 from opposite sides. Divisor sums: sigma(n) is 11-smooth for n = 1..8, breaks at n = 9 where sigma(9) = 1+3+9 = 13. Fibonacci: F(n) is 11-smooth for n = 0..6, breaks at n = 7 where F(7) = 13. Note: 9 - 7 = 2 and 9 + 7 = 16 = 2^4.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: FIBONACCI MAP === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Fibonacci at Chain Primes");
  let ftbl = dom_create("table") in
  dom_style(ftbl, "width", "100%");
  dom_style(ftbl, "maxWidth", "700px");
  dom_style(ftbl, "margin", "24px auto");
  dom_style(ftbl, "borderCollapse", "collapse");
  let fhdr = dom_create("tr") in
  render_th(fhdr, "n");
  render_th(fhdr, "F(n)");
  render_th(fhdr, "Prime?");
  dom_append(ftbl, fhdr);
  render_table_row(ftbl, "0", "0", "-");
  render_table_row(ftbl, "3", "2", "Yes");
  render_table_row(ftbl, "5", "5 (fixed point!)", "Yes");
  render_table_row(ftbl, "7", "13", "Yes");
  render_table_row(ftbl, "11", "89", "Yes");
  render_table_row(ftbl, "13", "233", "Yes");
  dom_append(sec4, ftbl);
  render_theorem(sec4, "Fibonacci Fixed Point (PROVED)", "F(5) = 5. The prime 5 is a fixed point of the Fibonacci sequence. F(7) = 13: the prime 7 maps to 13. F(p) is prime for all chain primes p in {3,5,7,11,13}. First composite: F(19) = 37 * 113, where 19 = f(5) = 5^2-5-1.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: PISANO-E8 === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Pisano Periods and 240");
  render_theorem(sec5, "Pisano-E8 (PROVED)", "The Pisano period pi(p) (period of Fibonacci mod p) at chain primes: pi(2)=3, pi(3)=8, pi(5)=20, pi(7)=16, pi(11)=10. Their lcm: lcm(3, 8, 20, 16, 10) = 240 = |roots(E8)|. Also: pi(210) = 240.");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "p");
  render_th(phdr, "pi(p)");
  render_th(phdr, "Factorization");
  render_th(phdr, "11-smooth?");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "2", "3", "3", "Yes");
  render_table_row_4(ptbl, "3", "8", "2^3", "Yes");
  render_table_row_4(ptbl, "5", "20", "4*5", "Yes");
  render_table_row_4(ptbl, "7", "16", "2^4", "Yes");
  render_table_row_4(ptbl, "11", "10", "2*5", "Yes");
  render_table_row_4(ptbl, "13", "28", "4*7", "Yes");
  render_table_row_4(ptbl, "37", "76", "4*19", "No (first break)");
  dom_append(sec5, ptbl);
  render_p(sec5, "All Pisano periods at primes up to 31 are 11-smooth. The first non-smooth period occurs at p = 37, where pi(37) = 76 = 4*19. The Legendre symbol (5|p) determines the divisibility pattern: pi(p) divides 2(p+1) when (5|p) = -1, and pi(p) divides (p-1) when (5|p) = 1.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: CYCLOTOMIC ORDER (THM 156) === */
  let sec_ord = make_section("800px") in
  render_h2(sec_ord, "Cyclotomic Order");
  render_p(sec_ord, "Each non-D axiom prime p satisfies p = Phi_{ord(2,p)}(2), where ord(2,p) is the multiplicative order of 2 mod p. The orders are all axiom-native: {2, 4, 3, 10, 12, 8} for {3, 5, 7, 11, 13, 17}. The identity 2^12 - 1 = 4095 = 9*5*7*13 follows from the cyclotomic factorization at lambda(DATA) = 12.");
  render_theorem(sec_ord, "Cyclotomic Order (PROVED)", "Every non-D axiom prime p = Phi_{ord(2,p)}(2). Orders: ord(2,3)=2, ord(2,5)=4, ord(2,7)=3, ord(2,11)=10, ord(2,13)=12, ord(2,17)=8. Order sum = 39 = 3*13. The cyclotomic factorization 2^12 - 1 = 4095 = 9*5*7*13 uses all DATA primes. Extension primes {11, 17} have orders {10, 8} not dividing 12: this is WHY they are extensions. Intruder contamination: Phi_18(2) = 57 = 3*19 (composite). The first 7 primes form the maximal cyclotomic-prime initial segment at x = 2.");
  let go = make_findings_grid(sec_ord) in
  render_finding(go, "Orders are chain values", "{2, 4, 3, 10, 12, 8}", "ord(2,3) = D, ord(2,5) = D^2, ord(2,7) = K, ord(2,11) = D*E, ord(2,13) = D^2*K, ord(2,17) = D^3.", "");
  render_finding(go, "2^12 - 1 = 4095", "= 9*5*7*13 = K^2*E*b*GATE", "The cyclotomic factorization at lambda(DATA): all divisors of 12 contribute Phi factors.", "");
  render_finding(go, "Extension = non-divisor", "10 and 8 do not divide 12", "L and ESCAPE have orders that don't divide lambda(DATA) = 12. This is the algebraic reason they are extensions, not DATA primes.", "");
  render_finding(go, "Intruder = composite", "Phi_18(2) = 57 = 3*19", "Beyond the 6 smooth-index positions, cyclotomic values become composite. 19 = f(5) is the first intruder.", "");
  dom_append(dom_body(), sec_ord);

  /* === INTERACTIVE: CYCLOTOMIC CALCULATOR === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cyclotomic Calculator");
  render_p(sec_i, "Enter n (1-20). See Phi_n(2), the n-th cyclotomic polynomial evaluated at 2. The 11-smooth indices {1, 2, 3, 4, 6, 10} generate all chain primes.");
  make_interactive_widget(sec_i, "Compute Phi_n(2):", "cf-input", "e.g. 12", "Compute", "cf_check", "cf-result");
  render_p(sec_i, "Try: 1 (=1), 2 (=3), 3 (=7), 4 (=5), 10 (=11), 12 (=13). Smooth indices: {1, 2, 3, 4, 6, 10}.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Contrast");
  render_contrast_row(sec7, "Cyclotomic polynomials", "Abstract algebra: Phi_n(x) divides x^n - 1, used in number theory and cryptography", "Phi_n(2) produces all chain primes. Exactly 6 smooth indices. The Zsygmondy primitive prime at each index IS the corresponding chain prime.");
  render_contrast_row(sec7, "Fibonacci numbers", "The sequence 1,1,2,3,5,8,13,... Famous for the golden ratio and spirals", "F(5) = 5 is a fixed point. F(p) is prime for all chain primes. Pisano periods at chain primes have lcm = 240 = |roots(E8)|.");
  render_contrast_row(sec7, "The number 13", "The 6th prime, considered unlucky, no special mathematical role", "13 terminates both smooth runs: sigma(9) = 13 (divisor sums) and F(7) = 13 (Fibonacci). Two independent sequences hit the same wall.");
  dom_append(dom_body(), sec7)
)
