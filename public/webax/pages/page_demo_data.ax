/* page_demo_data.ax -- Data demo pages: db_index, audio. Split from page_demos.ax. */

fn demo_db_run() = (
  let key = parse_int_from("#ddb-input") in
  let result_el = dom_query("#ddb-result") in
  let nn = 214414200 in
  let k = key % nn in
  let mods = CRT_MODS_TRANS in
  let roles = ["primary hash", "integrity tag", "secondary hash", "range partition", "ECC check", "shard selector", "audit channel"] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT INDEX LOOKUP: key = " + "${k}" + "</p><table style='width:100%;border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Modulus</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Bucket</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Type</th></tr>";
  mut ch = 0;
  while ch < 7 do (
    let m = mods[ch] in
    let bucket = k % m in
    let is_data = if ch == 0 then 1 else if ch == 2 then 1 else if ch == 3 then 1 else 0 in
    let color = if is_data == 1 then "#ff6666" else "#44ff88" in
    let tag = if is_data == 1 then "data" else "parity" in
    mut html = html + "<tr><td style='padding:3px;color:" + color + ";font-size:12px'>mod " + "${m}" + "</td><td style='padding:3px;color:#888;font-size:12px'>" + "${m}" + "</td><td style='padding:3px;color:#ffd700;font-size:14px;font-weight:bold'>" + "${bucket}" + "</td><td style='padding:3px;color:" + color + ";font-size:11px'>" + tag + " -- " + roles[ch] + "</td></tr>";
    mut ch = ch + 1
  );
  dom_inner(result_el, html + "</table><p style='color:#ffd700;margin:12px 0 4px'>INDEX PROPERTIES</p><p style='color:#88ddaa;margin:4px 0'>Total buckets: 8+9+25+49+11+13+17 = 132 (stored in memory)</p><p style='color:#88ddaa;margin:4px 0'>Unique keys: 214,414,200 (zero false positives for distinct keys)</p><p style='color:#88ddaa;margin:4px 0'>Lookup: 7 mod operations + 7 bucket reads = O(1)</p><p style='color:#b0b0c0;margin:4px 0'>3 data channels {mod 8, mod 25, mod 49} store data pointers. 4 parity channels {mod 9, mod 11, mod 13, mod 17} verify integrity.</p></div>")
)

fn demo_db_batch() = (
  let result_el = dom_query("#ddb-batch") in
  let nn = 214414200 in
  let mods = CRT_MODS_TRANS in
  /* Insert 500 key pairs, check for false collisions (same 7 residues for different keys) */
  let collisions = [0] in
  let tested = [0] in
  let i = [0] in
  while i[0] < 500 do (
    let k1 = (i[0] * 25717 + 67) % nn in
    let k2 = (i[0] * 25717 + 67 + 1) % nn in
    /* Two adjacent keys -- check if any channel collides */
    mut same_count = 0;
    mut ch = 0;
    while ch < 7 do (
      let m = mods[ch] in
      if k1 % m == k2 % m then mut same_count = same_count + 1 else 0;
      mut ch = ch + 1
    );
    /* Full collision = all 7 match (impossible for k1 != k2 within the ring) */
    if same_count == 7 then
      set(collisions, 0, collisions[0] + 1) else 0;
    set(tested, 0, tested[0] + 1);
    set(i, 0, i[0] + 1)
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH: 500 adjacent-key pairs</p><p style='color:" + (if collisions[0] == 0 then "#44ff88" else "#ff4444") + ";font-size:18px;margin:4px 0'>Full collisions: " + "${collisions[0]}" + "/500 -- " + (if collisions[0] == 0 then "ZERO. CRT = perfect hash." else "unexpected") + "</p><p style='color:#b0b0c0;margin:4px 0'>For distinct keys in Z/214,414,200, CRT guarantees at least one channel differs. 7-dimensional addressing eliminates false positives algebraically, not probabilistically.</p></div>")
)

fn page_db_index() = (
  dom_head_meta("description", "CRT Database Index. 7-dimensional perfect hash via CRT decomposition over Z/214,414,200. O(1) lookup. Zero false positives. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Database Index\",\"description\":\"7-channel perfect hash indexing over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/db_index\"}");
  let hero = make_hero("CRT Database Index") in
  let eq = dom_create("div") in
  dom_text(eq, "Oracle/IBM patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT approach to database indexing. A key mod 7 coprime moduli gives 7 independent bucket addresses. Lookup = 7 mod operations. Insert = 7 bucket writes. Zero false positives for distinct keys within the ring. 132 total buckets address 214,414,200 unique keys.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Perfect Hash", "A key k in Z/214,414,200 maps to 7 residues: (k mod 8, k mod 9, k mod 25, k mod 49, k mod 11, k mod 13, k mod 17). By CRT, this 7-tuple uniquely determines k. Store data at the intersection of 7 buckets. Lookup: compute 7 remainders, read 7 buckets, intersect. 3 data channels {mod 8, mod 25, mod 49} hold data pointers. 4 parity channels {mod 9, mod 11, mod 13, mod 17} hold integrity metadata.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "O(1) lookup", "7 mod + 7 reads", "Constant time regardless of table size. No tree traversal.", "");
  render_finding(g1, "132 buckets", "Sum of moduli", "8+9+25+49+11+13+17 = 132 buckets address 214.4M unique keys.", "");
  render_finding(g1, "Perfect hash", "CRT bijectivity", "Distinct keys in ring always differ in at least one channel.", "");
  render_finding(g1, "3+4 split", "Data + integrity", "3 data channels store pointers. 4 parity channels verify correctness.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Key (0-214414199):", "ddb-input", "e.g. 42", "Lookup", "demo_db_run", "ddb-result");
  render_p(sec2, "Shows 7 bucket addresses for the key. Red = data channels. Green = parity channels.");
  dom_append(dom_body(), sec2);
  let sec2b = make_section("800px") in
  render_h2(sec2b, "Collision Test");
  let btn = dom_create("button") in
  dom_text(btn, "Test 500 Key Pairs");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_db_batch");
  dom_append(sec2b, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "ddb-batch");
  dom_append(sec2b, br);
  dom_append(dom_body(), sec2b);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Index vs B-Tree/Hash Table");
  render_contrast_row(sec3, "Lookup", "B-tree: O(log N). Hash: O(1) amortized", "CRT: O(1) worst-case. 7 mod ops.");
  render_contrast_row(sec3, "Collisions", "Hash tables: requires chaining/probing", "CRT: zero false positives within ring");
  render_contrast_row(sec3, "Storage", "B-tree: node overhead. Hash: load factor waste", "CRT: 132 buckets total. Minimal.");
  render_contrast_row(sec3, "Integrity", "Separate checksums needed", "4 parity channels (mod 9, 11, 13, 17) verify for free.");
  render_contrast_row(sec3, "Patent status", "Oracle/IBM database patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   AUDIO SYNTHESIS -- dedicated demo page /demos/audio. CC0 kill B12.
   CRT eigenvalue frequencies. 7 channels = 7 harmonic components.
   ================================================================ */

/* Audio oscillator handles: 7 channels (mod 8,9,25,49,11,13,17) */
let g_audio_oscs = [0, 0, 0, 0, 0, 0, 0]

fn demo_audio_play() = (
  let note = parse_int_from("#daudio-input") in
  let nn = 214414200 in
  let n = note % nn in
  let mods = CRT_MODS_TRANS in
  let rd = n % 8 in let rk = n % 9 in let re = n % 25 in
  let rb = n % 49 in let rl = n % 11 in let rg = n % 13 in let r17 = n % 17 in
  let freqs = [110 * (8 + rd) / 8, 110 * (9 + rk) / 9, 110 * (25 + re) / 25,
               110 * (49 + rb) / 49, 110 * (11 + rl) / 11, 110 * (13 + rg) / 13, 110 * (17 + r17) / 17] in
  let amps = [rd * 12 / 8, rk * 12 / 9, re * 12 / 25,
              rb * 12 / 49, rl * 12 / 11, rg * 12 / 13, r17 * 12 / 17] in
  let i = [0] in
  while i[0] < 7 do (
    if g_audio_oscs[i[0]] == 0 then
      set(g_audio_oscs, i[0], aud_osc(0))
    else 0;
    aud_freq(g_audio_oscs[i[0]], freqs[i[0]]);
    aud_gain(g_audio_oscs[i[0]], if amps[i[0]] > 0 then amps[i[0]] else 1);
    set(i, 0, i[0] + 1)
  );
  0
)

fn demo_audio_stop() = (
  let i = [0] in
  while i[0] < 7 do (
    if g_audio_oscs[i[0]] > 0 then (
      aud_gain(g_audio_oscs[i[0]], 0);
      set(g_audio_oscs, i[0], 0)
    ) else 0;
    set(i, 0, i[0] + 1)
  );
  0
)

fn demo_audio_run() = (
  let note = parse_int_from("#daudio-input") in
  let result_el = dom_query("#daudio-result") in
  let nn = 214414200 in
  let n = note % nn in
  let mods = CRT_MODS_TRANS in
  let band_names = ["Fundamental", "Envelope", "Overtone", "Depth", "Timing", "Gate", "Detail"] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT SYNTHESIS: note = " + "${n}" + "</p><table style='width:100%;border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Residue</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Freq (Hz)</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Phase</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Amp %</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Type</th></tr>";
  mut timbre = 1;
  mut ch = 0;
  while ch < 7 do (
    let m = mods[ch] in
    let r = n % m in
    let freq = 110 * (m + r) / m in
    let phase = r * 360 / m in
    let amp = r * 100 / m in
    let is_data = if ch == 0 then 1 else if ch == 2 then 1 else if ch == 3 then 1 else 0 in
    let color = if is_data == 1 then "#ff6666" else "#44ff88" in
    let tag = if is_data == 1 then "data" else "parity" in
    mut html = html + "<tr><td style='padding:3px;color:" + color + ";font-size:12px'>mod " + "${m}" + "</td><td style='padding:3px;color:#88ddaa;font-size:12px'>" + "${r}" + "</td><td style='padding:3px;color:#ffd700;font-size:12px'>" + "${freq}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${phase}" + "deg</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${amp}" + "%</td><td style='padding:3px;color:" + color + ";font-size:11px'>" + tag + " -- " + band_names[ch] + "</td></tr>";
    mut timbre = timbre * (r + 1);
    mut ch = ch + 1
  );
  let timbre_val = timbre in
  dom_inner(result_el, html + "</table><p style='color:#ffd700;margin:12px 0 4px'>TIMBRE SIGNATURE</p><p style='color:#88ddaa;margin:4px 0'>Product: " + "${timbre_val}" + " (unique timbre from 7-channel interaction)</p><p style='color:#b0b0c0;margin:4px 0'>3 data channels {mod 8, mod 25, mod 49} carry harmonic content. 4 parity channels {mod 9, mod 11, mod 13, mod 17} shape envelope, timing, gating.</p><p style='color:#b0b0c0;margin:4px 0'>Total unique timbres: 8*9*25*49*11*13*17 = 214,414,200 from 7 independent parameters.</p></div>")
)

fn demo_audio_batch() = (
  let result_el = dom_query("#daudio-batch") in
  let mods = CRT_MODS_TRANS in
  /* Test: verify all notes in range produce valid frequency decompositions */
  let valid = [0] in
  let unique_timbres = [0] in
  let last_timbre = [0] in
  let i = [0] in
  while i[0] < 420 do (
    let n = i[0] * 30030 in /* sample at primorial(13) intervals */
    mut timbre = 1;
    mut ch = 0;
    while ch < 7 do (
      let m = mods[ch] in
      let r = n % m in
      mut timbre = timbre * (r + 1);
      mut ch = ch + 1
    );
    if timbre != last_timbre[0] then (
      set(unique_timbres, 0, unique_timbres[0] + 1);
      set(last_timbre, 0, timbre)
    ) else 0;
    /* All frequencies must be positive (base=110, residue>=0, modulus>0) */
    let freq_0 = 110 * (8 + n % 8) / 8 in
    if freq_0 > 0 then set(valid, 0, valid[0] + 1) else 0;
    set(i, 0, i[0] + 1)
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH: 420 notes (primorial-spaced)</p><p style='color:" + (if valid[0] == 420 then "#44ff88" else "#ff4444") + ";font-size:18px;margin:4px 0'>" + "${valid[0]}" + "/420 valid frequency decompositions</p><p style='color:#88ddaa;margin:4px 0'>Unique timbres sampled: " + "${unique_timbres[0]}" + "</p><p style='color:#b0b0c0;margin:4px 0'>420 sample points across the ring. Each note = 7 independent oscillators shaped by CRT residues. The ring encodes 214,414,200 distinct timbres from 7 independent parameters.</p></div>")
)

fn page_audio() = (
  dom_head_meta("description", "CRT Audio Synthesis. 7 eigenvalue frequencies from CRT decomposition over Z/214,414,200. 214.4M unique timbres. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Audio Synthesis\",\"description\":\"7-channel additive synthesis over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/audio\"}");
  let hero = make_hero("CRT Audio Synthesis") in
  let eq = dom_create("div") in
  dom_text(eq, "Dolby DSP patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT approach to additive synthesis. A note n in Z/214,414,200 decomposes into 7 residues, each driving an independent oscillator. Frequency, phase, and amplitude all derive from modular arithmetic. 7 channels = 7 additive harmonics. 3 data channels carry harmonic content, 4 parity channels shape envelope, timing, and gating. Total unique timbres: 214,414,200.");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Additive Synthesis", "A note n decomposes into 7 residues (n mod 8, n mod 9, ..., n mod 17). Each residue determines: frequency = base * (m + r) / m, phase = 2*pi*r/m, amplitude = r/m. The 7 oscillators sum to produce the output waveform. Because moduli are coprime, the combined Carmichael period = 1680. Mod-8 channel = fundamental (8 states, coarsest), mod-49 channel = finest harmonic (49 states). Mod 9, 11, 13, 17 channels control envelope shape, timing, and gating.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "214.4M timbres", "Ring capacity", "Each CRT tuple = unique waveform. 8*9*25*49*11*13*17 combinations.", "");
  render_finding(g1, "7 oscillators", "CRT channels", "Independent frequency/phase/amplitude per channel. No coupling.", "");
  render_finding(g1, "3+4 split", "Content + control", "3 data channels: harmonics. 4 parity channels: envelope/timing/gating.", "");
  render_finding(g1, "Period 1680", "Carmichael lambda", "Combined waveform repeats every 1680 samples. Ring-intrinsic periodicity.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Note value (0-214414199):", "daudio-input", "e.g. 440", "Synthesize", "demo_audio_run", "daudio-result");
  let abtn = dom_create("div") in
  dom_style(abtn, "display", "flex");
  dom_style(abtn, "gap", "8px");
  dom_style(abtn, "marginTop", "8px");
  let pbtn = dom_create("button") in
  dom_text(pbtn, "Play Sound");
  dom_style(pbtn, "background", "#44ff88");
  dom_style(pbtn, "color", "#0f0f2a");
  dom_style(pbtn, "border", "none");
  dom_style(pbtn, "padding", "8px 20px");
  dom_style(pbtn, "borderRadius", "6px");
  dom_style(pbtn, "cursor", "pointer");
  dom_style(pbtn, "fontWeight", "bold");
  dom_on(pbtn, "click", "demo_audio_play");
  dom_append(abtn, pbtn);
  let sbtn = dom_create("button") in
  dom_text(sbtn, "Stop");
  dom_style(sbtn, "background", "#ff4444");
  dom_style(sbtn, "color", "#fff");
  dom_style(sbtn, "border", "none");
  dom_style(sbtn, "padding", "8px 20px");
  dom_style(sbtn, "borderRadius", "6px");
  dom_style(sbtn, "cursor", "pointer");
  dom_style(sbtn, "fontWeight", "bold");
  dom_on(sbtn, "click", "demo_audio_stop");
  dom_append(abtn, sbtn);
  dom_append(sec2, abtn);
  render_p(sec2, "Decomposes note into 7 channel oscillators. Play Sound creates 7 Web Audio oscillators from CRT residues. Red = data (harmonic content). Green = parity (envelope/timing).");
  dom_append(dom_body(), sec2);
  let sec2b = make_section("800px") in
  render_h2(sec2b, "Batch Test");
  let btn = dom_create("button") in
  dom_text(btn, "Test 420 Notes");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_audio_batch");
  dom_append(sec2b, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "daudio-batch");
  dom_append(sec2b, br);
  dom_append(dom_body(), sec2b);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Synthesis vs DSP");
  render_contrast_row(sec3, "Synthesis model", "Dolby: proprietary filter banks + transform coding", "CRT: 7 modular oscillators. Pure arithmetic.");
  render_contrast_row(sec3, "Timbre space", "Fixed codec profiles (AC-3, AC-4)", "214,414,200 unique timbres from ring structure");
  render_contrast_row(sec3, "Parameters", "Dozens of tunable coefficients", "7 residues. Everything derives from one number.");
  render_contrast_row(sec3, "Periodicity", "Frame-based (256-4096 samples)", "Carmichael period 1680 samples. Ring-intrinsic.");
  render_contrast_row(sec3, "Patent status", "Dolby DSP patents (AC-3, AC-4, Atmos)", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   CRT SORT -- dedicated demo page /demos/sort. CC0 kill D25.
   CRT radix sort: 7 counting sort passes through tiny channels.
   O(7N) for any N in Z/214414200.
   ================================================================ */
