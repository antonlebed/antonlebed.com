/* pages_data_life.ax -- Life domain pages: chemistry. biology+culture cut.
   Split from pages_data.ax. Uses domain_hero() from pages_data.ax. */

fn page_chemistry() = (
  dom_head_meta("description", "Bond angle = arccos(-1/(n-1)). Simplex geometry: denominators are 1, 2, 3. Lone pairs depress by 5/2 = 2.5 degrees (0.02 degree accuracy). Noble gases: all 5 stable have 11-smooth atomic numbers, both unstable do not.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Chemistry\",\"description\":\"Bond angles from simplex geometry. Lone pair depression 5/2 = 2.5 degrees with 0.02 degree accuracy. Noble gas stability tracks 11-smooth atomic numbers.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/chemistry\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"chemistry\"},{\"@type\":\"DefinedTerm\",\"name\":\"bond angle\"},{\"@type\":\"DefinedTerm\",\"name\":\"simplex geometry\"}]}");
  /* === HERO === */
  let hero = make_hero("Chemistry") in
  let big = dom_create("div") in
  dom_text(big, "cos(theta) = -1 / (n - 1)");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Molecular geometry is simplex geometry. The regular simplex in n-1 dimensions has vertex angle arccos(-1/(n-1)). For 2, 3, 4 electron pairs this gives 180, 120, 109.47 degrees. Lone pairs depress the angle by exactly 5/2 = 2.5 degrees, matching measurements to 0.02 degrees.");
  dom_append(dom_body(), hero);

  /* === SEC 1: BOND ANGLES === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Simplex Bond Angles");
  render_p(sec1, "Place n electron pairs around a central atom. They repel to the vertices of a regular simplex. The resulting bond angle is arccos(-1/(n-1)):");
  let t1 = make_table(sec1) in
  let h1 = dom_create("tr") in
  render_th(h1, "Pairs (n)");
  render_th(h1, "Geometry");
  render_th(h1, "Angle");
  render_th(h1, "Denominator");
  dom_append(t1, h1);
  render_table_row_4(t1, "2", "Linear", "180.00 deg", "1");
  render_table_row_4(t1, "3", "Trigonal planar", "120.00 deg", "2");
  render_table_row_4(t1, "4", "Tetrahedral", "109.47 deg", "3");
  render_table_row_4(t1, "6", "Octahedral", "90.00 deg", "-- (cross-polytope)");
  render_p(sec1, "For n = 2, 3, 4 this is the simplex formula. The n = 6 case (octahedral, 90 degrees) is a cross-polytope, not a simplex. Lone pairs occupy vertex positions but do not bond, depressing the observed angle:");
  render_theorem(sec1, "Lone Pair Depression (0.02 deg accuracy)", "Each lone pair depresses the bond angle by 5/2 = 2.5 degrees. CH4: 109.47 (0 lone pairs, predicted = measured). NH3: predicted 106.97, measured 107.00, error 0.03 deg. H2O: predicted 104.47, measured 104.45, error 0.02 deg.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: NOBLE GAS OBSERVATION === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Noble Gas Stability");
  render_p(sec2, "An observed pattern (no proved mechanism): all five stable noble gases have 11-smooth atomic numbers (factorable into {2, 3, 5, 7, 11} only). Both unstable noble gases do not.");
  let t2 = make_table(sec2) in
  let h2 = dom_create("tr") in
  render_th(h2, "Element");
  render_th(h2, "Z");
  render_th(h2, "Factorization");
  render_th(h2, "Stable?");
  dom_append(t2, h2);
  render_table_row_4(t2, "He", "2", "2", "Yes");
  render_table_row_4(t2, "Ne", "10", "2 * 5", "Yes");
  render_table_row_4(t2, "Ar", "18", "2 * 3^2", "Yes");
  render_table_row_4(t2, "Kr", "36", "2^2 * 3^2", "Yes");
  render_table_row_4(t2, "Xe", "54", "2 * 3^3", "Yes");
  render_table_row_4(t2, "Rn", "86", "2 * 43", "No");
  render_table_row_4(t2, "Og", "118", "2 * 59", "No");
  render_p(sec2, "7 for 7. Caveat: noble gas atomic numbers are all even, and small even numbers are more likely to be smooth. A proper null model (fraction of even numbers below 120 that are 11-smooth) would quantify how surprising this is.");
  dom_append(dom_body(), sec2);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Bond Angle Calculator");
  render_p(sec_i, "Enter total electron pairs and lone pairs. The simplex formula gives the base angle; each lone pair subtracts 2.5 degrees. Try 4, 0 (methane) then 4, 1 (ammonia) then 4, 2 (water).");
  let lbl_i = dom_create("p") in
  dom_text(lbl_i, "Electron pairs / Lone pairs:");
  dom_style(lbl_i, "color", "#b8b8c8");
  dom_style(lbl_i, "marginTop", "24px");
  dom_style(lbl_i, "marginBottom", "8px");
  dom_append(sec_i, lbl_i);
  let row_i = dom_create("div") in
  dom_style(row_i, "display", "flex");
  dom_style(row_i, "gap", "8px");
  dom_style(row_i, "alignItems", "center");
  dom_style(row_i, "marginBottom", "12px");
  make_input_field(row_i, "#chem-input-e", "pairs (e.g. 4)");
  make_input_field(row_i, "#chem-input-l", "lone (e.g. 2)");
  make_action_btn(row_i, "Predict", "chemistry_angle_calc");
  dom_append(sec_i, row_i);
  make_result_box(sec_i, "chem-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast Table");
  render_contrast_row(sec5, "Bond angles", "Memorized from tables or VSEPR rules", "arccos(-1/(n-1)) -- one formula, all simplex geometries");
  render_contrast_row(sec5, "Lone pair effect", "Empirical correction (~2-3 deg)", "5/2 = 2.5 degrees per lone pair, accurate to 0.02 deg");
  render_contrast_row(sec5, "Noble gas stability", "Explained by nuclear physics (magic numbers, binding energy)", "Observed: all 5 stable noble gases are 11-smooth, both unstable are not. No mechanism proved.");
  dom_append(dom_body(), sec5)
)

/* page_biology CUT S1976: small-numbers-are-smooth nothingburger.
   "93% axiom-smooth" has no null model -- small numbers are disproportionately smooth.
   biology_smooth_calc handler also removed from pages_data_phys.ax. */

/* page_culture CUT S1944: sports numerology, time divisions trivially explained
   (highly composite numbers chosen for divisibility convenience). culture_number_calc
   also removed from pages_data_phys.ax. */

