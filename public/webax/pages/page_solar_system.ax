/* page_solar_system.ax -- Solar System = Oxygen Atom (S1185).
   8 planets = D^3 = Z(Oxygen). Shell structure. Orbital periods.
   Solar cycle ladder. CRT decomposition interactive. */

/* Helper: factoring display for one prime -- strip p from n, return exponent*100000+remainder. */
fn ss_strip(n, p) = (
  let rem = n in
  let e = 0 in
  while rem % p == 0 do (mut rem = rem / p; mut e = e + 1);
  e * 100000 + rem
)

/* Helper: build factorization string for a number using axiom primes. */
fn ss_factor_str(n) = (
  let rem = n in
  let parts = "" in
  /* D=2 */
  let r2 = ss_strip(rem, 2) in
  let e2 = r2 / 100000 in
  let rem = r2 % 100000 in
  let parts = if e2 == 1 then concat(parts, "D") else if e2 > 1 then concat(parts, "D^${e2}") else parts in
  /* K=3 */
  let r3 = ss_strip(rem, 3) in
  let e3 = r3 / 100000 in
  let rem = r3 % 100000 in
  let sep = if e2 > 0 then if e3 > 0 then " * " else "" else "" in
  let parts = if e3 == 1 then concat(parts, "${sep}K") else if e3 > 1 then concat(parts, "${sep}K^${e3}") else parts in
  /* E=5 */
  let r5 = ss_strip(rem, 5) in
  let e5 = r5 / 100000 in
  let rem = r5 % 100000 in
  let any = e2 + e3 in
  let sep = if any > 0 then if e5 > 0 then " * " else "" else "" in
  let parts = if e5 == 1 then concat(parts, "${sep}E") else if e5 > 1 then concat(parts, "${sep}E^${e5}") else parts in
  /* b=7 */
  let r7 = ss_strip(rem, 7) in
  let e7 = r7 / 100000 in
  let rem = r7 % 100000 in
  let any = any + e5 in
  let sep = if any > 0 then if e7 > 0 then " * " else "" else "" in
  let parts = if e7 == 1 then concat(parts, "${sep}b") else if e7 > 1 then concat(parts, "${sep}b^${e7}") else parts in
  /* L=11 */
  let r11 = ss_strip(rem, 11) in
  let e11 = r11 / 100000 in
  let rem = r11 % 100000 in
  let any = any + e7 in
  let sep = if any > 0 then if e11 > 0 then " * " else "" else "" in
  let parts = if e11 == 1 then concat(parts, "${sep}L") else if e11 > 1 then concat(parts, "${sep}L^${e11}") else parts in
  /* GATE=13 */
  let r13 = ss_strip(rem, 13) in
  let e13 = r13 / 100000 in
  let rem = r13 % 100000 in
  let any = any + e11 in
  let sep = if any > 0 then if e13 > 0 then " * " else "" else "" in
  let parts = if e13 == 1 then concat(parts, "${sep}GATE") else if e13 > 1 then concat(parts, "${sep}GATE^${e13}") else parts in
  /* ESCAPE=17 */
  let r17 = ss_strip(rem, 17) in
  let e17 = r17 / 100000 in
  let rem = r17 % 100000 in
  let any = any + e13 in
  let sep = if any > 0 then if e17 > 0 then " * " else "" else "" in
  let parts = if e17 == 1 then concat(parts, "${sep}ESCAPE") else if e17 > 1 then concat(parts, "${sep}ESCAPE^${e17}") else parts in
  /* Remainder */
  let any = any + e17 in
  if rem > 1 then (
    let sep = if any > 0 then " * " else "" in
    concat(parts, "${sep}${rem}")
  ) else if any == 0 then "1"
  else parts
)

fn ss_crt_calc() = (
  let n = parse_int_from("#ss-input") in
  let result = dom_query("#ss-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter a positive integer.</p>")
  else if n > 1000000 then dom_inner(result, "<p style='color:#ff6666'>Maximum is 1000000.</p>")
  else (
    dom_inner(result, "");
    /* Factorization */
    let fstr = ss_factor_str(n) in
    let fdesc = dom_create("p") in
    dom_inner(fdesc, "<b style='color:#ffd700'>${n}</b> = <span style='color:#aaa'>${fstr}</span>");
    dom_style(fdesc, "color", "#d8d8e0");
    dom_style(fdesc, "marginBottom", "12px");
    dom_append(result, fdesc);

    /* CRT decomposition */
    let tbl = dom_create("table") in
    dom_style(tbl, "width", "100%");
    dom_style(tbl, "maxWidth", "600px");
    dom_style(tbl, "margin", "0 auto");
    dom_style(tbl, "borderCollapse", "collapse");
    let hdr = dom_create("tr") in
    render_th(hdr, "Channel");
    render_th(hdr, "Modulus");
    render_th(hdr, "Residue");
    render_th(hdr, "Void?");
    dom_append(tbl, hdr);
    render_table_row_4(tbl, "D", "8", "${n % 8}", if n % 8 == 0 then "VOID" else "");
    render_table_row_4(tbl, "K", "9", "${n % 9}", if n % 9 == 0 then "VOID" else "");
    render_table_row_4(tbl, "E", "25", "${n % 25}", if n % 25 == 0 then "VOID" else "");
    render_table_row_4(tbl, "b", "49", "${n % 49}", if n % 49 == 0 then "VOID" else "");
    render_table_row_4(tbl, "L", "11", "${n % 11}", if n % 11 == 0 then "VOID" else "");
    render_table_row_4(tbl, "GATE", "13", "${n % 13}", if n % 13 == 0 then "VOID" else "");
    render_table_row_4(tbl, "ESCAPE", "17", "${n % 17}", if n % 17 == 0 then "VOID" else "");
    dom_append(result, tbl);

    /* Smoothness verdict */
    let r2 = ss_strip(n, 2) in
    let rem = r2 % 100000 in
    let r3 = ss_strip(rem, 3) in
    let rem = r3 % 100000 in
    let r5 = ss_strip(rem, 5) in
    let rem = r5 % 100000 in
    let r7 = ss_strip(rem, 7) in
    let rem = r7 % 100000 in
    let r11 = ss_strip(rem, 11) in
    let rem = r11 % 100000 in
    let r13 = ss_strip(rem, 13) in
    let rem = r13 % 100000 in
    let r17 = ss_strip(rem, 17) in
    let rem = r17 % 100000 in
    let verd = dom_create("p") in
    dom_style(verd, "marginTop", "12px");
    dom_style(verd, "fontSize", "14px");
    if rem == 1 then (
      dom_inner(verd, "<span style='color:#33dd55'>Axiom-smooth:</span> ${n} factors entirely into axiom primes {2,3,5,7,11,13,17}.");
      dom_style(verd, "color", "#b8b8c8")
    ) else (
      dom_inner(verd, "<span style='color:#ff9900'>Not smooth:</span> remainder ${rem} after removing axiom primes.");
      dom_style(verd, "color", "#b8b8c8")
    );
    dom_append(result, verd)
  )
)

fn page_solar_system() = (
  dom_head_meta("description", "Solar system as oxygen atom. 8 planets = D^3 = Z(Oxygen). Orbital periods, solar cycles, CRT decomposition. Observed patterns.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Solar System: The Oxygen Atom\",\"description\":\"8 planets map to Z=8 oxygen. Orbital periods factor into axiom primes. Solar cycles align with ring structure.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/solar_system\"}");

  /* === HERO === */
  let hero = make_hero("Solar System") in
  render_p(hero, "Eight planets. One star. The same structure as an oxygen atom with eight electrons.");
  let stats = make_findings_grid(hero) in
  render_finding(stats, "Planets", "D^3 = 8", "Same as oxygen's atomic number.", "");
  render_finding(stats, "Solar Cycle", "L = 11", "Schwabe cycle: mean 11.02 years.", "");
  render_finding(stats, "Sun Rotation", "K^3 = 27", "Carrington rotation: 27.28 days.", "");
  dom_append(dom_body(), hero);

  /* === OXYGEN ATOM === */
  let s1 = make_section("800px") in
  render_h2(s1, "The Oxygen Mapping");
  render_p(s1, "The IAU recognizes 8 planets (2006, no Pluto). Oxygen has atomic number 8 = D^3. The electron configuration of oxygen is 1s^2 + 2s^2 2p^4 -- two inner electrons plus six outer.");
  render_p(s1, "The solar system has the same shape. Two inner rocky planets (Mercury, Venus) orbit close to the Sun, like 1s^2 electrons near the nucleus. Six outer planets (Earth through Neptune) fill the outer shell. The asteroid belt marks the shell boundary -- exactly where Kirkwood resonance gaps clear orbits.");
  render_p(s1, "The Sun is the nucleus. Oxygen-16 has 8 protons + 8 neutrons = D^4 = 16 nucleons. The system mass fraction (Sun = 99.86%) mirrors the nuclear mass fraction in atoms (nucleus carries >99.97% of atomic mass).");
  render_theorem(s1, "Water Closure", "Hydrogen energy: GATE + K/E = 13.6 eV. Oxygen: Z = D^3 = 8 planets. Water H2O: HYDOR = K * E * b = 105. Three atoms (K), ten total electrons (D * E = Decality). The solar system IS the atom that makes water.");
  dom_append(dom_body(), s1);

  /* === ORBITAL PERIODS === */
  let s2 = make_section("800px") in
  render_h2(s2, "Orbital Periods");
  render_p(s2, "Several orbital periods factor cleanly into axiom primes. Mercury is exact. Mars, Saturn, and Neptune are within 2%. Jupiter and Uranus align in years. No mechanism is claimed -- these are observed patterns.");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  dom_style(ptbl, "tableLayout", "fixed");
  dom_style(ptbl, "wordWrap", "break-word");
  let phdr = dom_create("tr") in
  render_th(phdr, "Planet");
  render_th(phdr, "Period");
  render_th(phdr, "Axiom");
  render_th(phdr, "Error");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "Mercury", "87.97 d", "D^3*L = 88", "0.03%");
  render_table_row_4(ptbl, "Venus", "224.7 d", "K^2*E^2 = 225", "0.13%");
  render_table_row_4(ptbl, "Earth", "365.25 d", "E*73 = 365", "not smooth");
  render_table_row_4(ptbl, "Mars", "687 d", "D*b^3 = 686", "0.15%");
  render_table_row_4(ptbl, "Jupiter", "11.86 yr", "L = 11", "7.8%");
  render_table_row_4(ptbl, "Saturn", "29.46 yr", "D*K*E = 30", "1.8%");
  render_table_row_4(ptbl, "Uranus", "84.01 yr", "D^2*K*b = 84", "0.01%");
  render_table_row_4(ptbl, "Neptune", "164.8 yr", "K*E*L = 165", "0.12%");
  dom_append(s2, ptbl);
  render_p(s2, "Inner planets (Mercury, Venus, Mars) align in days. Outer planets (Jupiter through Neptune) align in years. Earth -- the observer -- resists smooth factorization. Its period 365 = 5 * 73, where 73 is not an axiom prime. The observer is blind to its own position (E-channel self-blindness).");
  dom_append(dom_body(), s2);

  /* === SOLAR CYCLE LADDER === */
  let s3 = make_section("800px") in
  render_h2(s3, "Solar Cycle Ladder");
  render_p(s3, "The Sun has multiple nested cycles, from the 27-day rotation to multi-millennial oscillations. Seven of these factor cleanly into axiom primes. Monte Carlo significance (2M trials): p = 0.000023.");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  dom_style(ctbl, "tableLayout", "fixed");
  dom_style(ctbl, "wordWrap", "break-word");
  let chdr = dom_create("tr") in
  render_th(chdr, "Cycle");
  render_th(chdr, "Period");
  render_th(chdr, "Axiom");
  render_th(chdr, "Fit");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "Carrington", "27 days", "K^3", "exact");
  render_table_row_4(ctbl, "QBO", "28 months", "D^2*b", "exact");
  render_table_row_4(ctbl, "Schwabe", "11 years", "L", "exact");
  render_table_row_4(ctbl, "Hale", "22 years", "D*L", "exact");
  render_table_row_4(ctbl, "Gleissberg", "88 years", "D^3*L", "exact");
  render_table_row_4(ctbl, "de Vries", "~210 yr", "DATA = D*K*E*b", "~1%");
  render_table_row_4(ctbl, "Hallstatt", "~2300 yr", "THIN = D*K*E*b*L", "~0.4%");
  dom_append(s3, ctbl);
  render_p(s3, "The ratio ladder is axiom-native: Hale/Schwabe = D. Gleissberg/Schwabe = D^3. de Vries/Schwabe = DATA/L. Hallstatt/de Vries = L. Each layer relates to the previous by an axiom prime.");
  dom_append(dom_body(), s3);

  /* === EXTRA OBSERVATIONS === */
  let s4 = make_section("800px") in
  render_h2(s4, "Further Observations");
  render_p(s4, "TRAPPIST-1 has b = 7 planets at a distance of KEY = 41 light-years. All orbital resonance ratios are 11-smooth. Its mass is K^2% of the Sun.");
  render_p(s4, "The Moon's sidereal period is 27.32 days -- K^3 = 27, matching the Sun's Carrington rotation. Venus and Earth lock in an 8:13 year resonance -- D^3 : GATE, the Fibonacci pair F(6):F(7).");
  render_p(s4, "Kirkwood gaps in the asteroid belt occur at Jupiter resonances with smooth denominators {1,2,3,5,7}. These smooth resonances CLEAR orbits. Inner planet period ratios have GATE = 13 in denominators (Mercury/Venus = 5/13, Venus/Earth = 8/13) -- gate resonances PERSIST. The asteroid belt marks the transition.");
  dom_append(dom_body(), s4);

  /* === INTERACTIVE === */
  let si = make_section("800px") in
  render_h2(si, "Explore: CRT Decomposition");
  render_p(si, "Enter any number (e.g. an orbital period in days) to see its CRT decomposition across the 7 axiom channels and its factorization into axiom primes.");
  make_interactive_widget(si, "Number:", "ss-input", "e.g. 88", "Decompose", "ss_crt_calc", "ss-result");
  dom_append(dom_body(), si);

  /* === HONEST NOTE === */
  let sh = make_section("800px") in
  render_h2(sh, "Honest Assessment");
  render_p(sh, "The oxygen-atom mapping (D^3 = 8 planets, shell structure, mass fraction) is structural and striking. Mercury's 88-day period = D^3 * L is exact. The solar cycle ladder passes Monte Carlo testing at p < 0.00003.");
  render_p(sh, "But orbital periods have no known reason to factor into small primes. Jupiter and Saturn match approximately (2-8%). Uranus moon and ring counts change with new discoveries. No null model has been tested for planetary orbits specifically. These are OBSERVED patterns, not proved mechanisms.");
  render_p(sh, "The axiom provides a lens. Whether that lens reveals structure or imposes it remains an open question. What we can say: 6 of 8 planets have periods within 2% of axiom-smooth values, a 7th (Jupiter) within 8%. That is the data.");
  dom_append(dom_body(), sh)
)
