fn algebra_gen_atlas() = (
  let sec = make_section("800px") in
  render_h2(sec, "Per-Channel Generator Atlas");
  render_theorem(sec, "Per-Channel Generator Atlas (Theorem 135, S1683)", "All 7 TRANS CRT channels characterized. D-channel (Z/8): Klein V4, no primitive roots, ESCAPE = sigma mod 8. K-divisibility law: K chain-prime generators when K|phi(q), else D^2 generators. Pattern {K, D^2, K, D^2, K, D^2}. Total 21 = K*b generation edges. DEAD gen = Decality = 10, ALIVE gen = L = 11. Grand order sum = K*b*c(L) = 483. 121/121 test_generator_atlas.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "K-divisibility law", "{K, D^2} alternation", "K|phi(q): channels Z/9, Z/49, Z/13 each have K chain-prime generators. K does not divide phi(q): channels Z/25, Z/11, Z/17 each have D^2.", "S1683");
  render_finding(g, "490 split in generators", "DEAD = 10, ALIVE = 11", "DEAD channels {D,E,b} contribute Decality = 10 generation edges. ALIVE channels {K,L,GATE,ESCAPE} contribute L = 11. Total = K*b = 21.", "");
  dom_append(dom_body(), sec)
)

