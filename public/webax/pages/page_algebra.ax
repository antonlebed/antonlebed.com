fn algebra_lie_coxeter() = (
  let sec = make_section("800px") in
  render_h2(sec, "Classical Lie Coxeter Staircase");
  render_theorem(sec, "Classical Lie Coxeter Staircase (Theorem 162, S1728)", "A_{p-1} has Coxeter number h=p for all 7 axiom primes: the chain IS the Coxeter staircase. B_p dimension = p*c(p) (Cunningham product). 56 of 57 classical Lie invariants at axiom ranks are axiom-smooth; sole exception B_L dim=L*c(L)=253 where Cunningham first exits. D-series Coxeter sum = 96 = number of lambda-1680 TRANS rings. 198/198 test_classical_lie.ax.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Family");
  render_th(hdr, "At rank p");
  render_th(hdr, "Named constant");
  dom_append(tbl, hdr);
  render_table_row(tbl, "A_{p-1} (SU)", "h = p (all 7 primes)", "The chain IS the Coxeter staircase");
  render_table_row(tbl, "A_6 roots", "42 = ANSWER", "b*(b-1) = D*K*b");
