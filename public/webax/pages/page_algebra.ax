  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Units", "Abstract: elements with multiplicative inverse", "480 keys. Freedom is total or nothing (Prison Theorem). 258 spectral + 30 unit-only = 288.");
  render_contrast_row(tbl, "Idempotents", "Projection operators (linear algebra)", "64 = 2^6 light switches. 6-cube of CRT channel filters. The ring's immune system.");
  render_contrast_row(tbl, "Ring exponents", "Arbitrary choice", "(3,2,2,2,1) = cross-annihilation speeds. Catalan-forced. Self-describing.");
  render_contrast_row(tbl, "Carmichael lambda", "Technical invariant", "Lambda ladder ratios = D,K,E,b. Axiom chain in exact order.");
  render_contrast_row(tbl, "Fermat exponents", "phi(p^e)-1, no pattern", "{K, E, f(E), KEY, K^2}. Sum = b*L. Totient-exponent gap = E.");
  render_contrast_row(tbl, "Multiplicative order", "Random-looking", "Decomposes via CRT. 73728 primitives. Products speak axiom vocabulary.");
  render_contrast_row(tbl, "CRT trace", "Sum of residues, no pattern", "E-multiplication for uniform elements. Trace duality: Tr(n)+Tr(N-n)=102. L swaps D<->K. Named traces ARE axiom constants.");
  render_contrast_row(tbl, "Lie rank", "Abstract algebra classification", "Seven channels = seven affine Dynkin diagrams. DEEP rank sum = 97 = G. GATE adds 12, ESCAPE adds 16 = D^4. Crossed ranks give E7, E8, Leech.");
  render_contrast_row(tbl, "Artin constant", "Conjectured density 37.4%", "VERIFIED: 37.63% for b=7. 97.85% smooth indices. K depletes at ratio 1-1/K. Flanking: b is PR at DATA+1=211.");
  render_contrast_row(tbl, "Axiom-open primes", "No expected structure", "1.54% density, 2x enrichment. All 10 pairs cooperate. K=3 is MI hub. Stephens degree 32 = |idempotents|.");
  render_contrast_row(tbl, "D^3 trapping", "QR is random-looking", "v_2>=3: g=2 NEVER PR. Channel obstruction: D^3,K^2,L opaque; E^2,b^2 transparent. g=13 index=1: stopper=generator.");
  render_contrast_row(tbl, "Gate cluster", "Random primes near 40", "{37,41,43,47}: sum=168=D^3*K*b, mean=ANSWER. Phi_6(b)=43 (self-indexed). Index product=56=dim(E7).");
  render_contrast_row(tbl, "Prime counting function", "Smooth curve, no structure", "pi(KEY)=GATE. G descends through E^2->K^2->D^2. ADDRESS walks reverse axiom chain. Depth sum=GATE=13.");
  render_contrast_row(tbl, "Named constant 67", "Just a prime", "SOUL = additive hub. 8 independent decompositions. KEY+SOUL=108=lattice. Every concept touched.");
  render_contrast_row(tbl, "CRT decomposition", "Technical tool for computing mod products", "Laplacian direct sum across 6 orthogonal Fourier subspaces on TRUE (7 on TRANS). Blocks coupled NS blowup -- Theorem 34 structural global-existence analog (not Clay).");
  render_contrast_row(tbl, "Idempotent classification", "Just 2^k projectors", "K=3 classes (extreme/primitive/composite). Smooth composite counts for k=2..7; KEY exits at k=8.");
  render_contrast_row(tbl, "Involution structure", "x^2=1, count 2", "Z/2^n plateau at n=3 (V4). Same wall as Hurwitz D^3=8 and Bott period 8. TRANS: 256 = 4*2^6.");
  render_contrast_row(tbl, "Regularity", "Von Neumann condition", "Meadow projector: 2^7=128 TRANS attention masks. Algebraic dropout. Zero-support = heartbeat = 420.");
  render_contrast_row(tbl, "Primitive root in Z/p^2", "Random generator", "Z/49: K=3 is PR. Exactly K=3 chain PRs {K,E,ESC}. ESCAPE=K^(E^2). QR/NQR partitions orders.");
  render_contrast_row(tbl, "Generator census", "Channel-by-channel lookup", "7x7 atlas. K-div law: K or D^2 generators. DEAD=10, ALIVE=11. Grand sum K*b*c(L)=483.");
  render_contrast_row(tbl, "Fermat power residues", "gcd(p,phi(q)), no pattern", "7x7 matrix. Row depths sum=GATE. Product=ANSWER. Grand product=10!/6. Palindromic columns.");
  render_contrast_row(tbl, "GCD and prediction", "gcd is a mathematical tool", "gcd(multiplier, channel modulus) governs cross-channel prediction. K's factor collapses Z/9 to deterministic subring. Two mechanisms: absorption (p|42) and entry (E). E-blindness: 42=D*K*b excludes observer.");
  render_contrast_row(tbl, "Orphan prime orders", "No expected structure", "All 42 per-channel orders axiom-smooth. DEEP sum = D^10. ESCAPE ratios: pure D-powers. Shadow divides order for all 7.");
  render_p(sec, "The ring operates: 2419200 units act, 341250 classes see, 64 idempotents solve. Three faces of one ring. The machinery IS the meaning.");
  dom_append(dom_body(), sec)
)

/* dom_on callback: ring calculator -- a+b, a*b, CRT of both (S970) */
fn ring_compute() = (
  let a = parse_int_from("#ring-a") in
  let bv = parse_int_from("#ring-b") in
  let result_el = dom_query("#ring-result") in
  let sum = a + bv in
  let prod = ring_mul(a, bv) in
  let a2 = ring_mul(a, a) in
  let ad = a % 8 in let ak = a % 9 in let ae = a % 25 in let ab_ch = a % 49 in let al = a % 11 in let ag = a % 13 in
  let bd = bv % 8 in let bk = bv % 9 in let be_ch = bv % 25 in let bb_ch = bv % 49 in let bl = bv % 11 in let bg = bv % 13 in
  let sd = sum % 8 in let sk = sum % 9 in let se = sum % 25 in let sb = sum % 49 in let sl = sum % 11 in let sg = sum % 13 in
  let pd = prod % 8 in let pk = prod % 9 in let pe = prod % 25 in let pb = prod % 49 in let pl = prod % 11 in let pg = prod % 13 in
  let is_idem = if a2 == a then "YES -- idempotent (e^2 = e)" else "no" in
  dom_inner(result_el, "<p style='color:#88ddaa;margin:4px 0'><b>a = " + "${a}" + "</b> | CRT = (" + "${ad}" + "," + "${ak}" + "," + "${ae}" + "," + "${ab_ch}" + "," + "${al}" + "," + "${ag}" + ")</p><p style='color:#88ddaa;margin:4px 0'><b>b = " + "${bv}" + "</b> | CRT = (" + "${bd}" + "," + "${bk}" + "," + "${be_ch}" + "," + "${bb_ch}" + "," + "${bl}" + "," + "${bg}" + ")</p><p style='color:#ffd700;margin:8px 0'><b>a + b = " + "${sum}" + "</b> | CRT = (" + "${sd}" + "," + "${sk}" + "," + "${se}" + "," + "${sb}" + "," + "${sl}" + "," + "${sg}" + ") -- SEE (always reversible)</p><p style='color:#ff8844;margin:4px 0'><b>a * b = " + "${prod}" + "</b> | CRT = (" + "${pd}" + "," + "${pk}" + "," + "${pe}" + "," + "${pb}" + "," + "${pl}" + "," + "${pg}" + ") -- ACT</p><p style='color:#b0b0c0;margin:4px 0'>a^2 = " + "${a2}" + " | Idempotent? " + is_idem + "</p>")
)

