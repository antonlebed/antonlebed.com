/* algebra helpers */
fn algebra_hero() = (
  let hero = make_hero("Algebra") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "0/0 condenses into a ring with three faces: SEE (341250 eigenvalue classes), ACT (2419200 units), SOLVE (64 idempotents). Every number is one of three things: a key that opens and closes cleanly, a filter that sorts but can never unsort, or something broken that loses information along the way.");
  render_p(hero, "The six CRT channels are orthogonal: every face decomposes as a direct sum of six per-channel components on independent Fourier subspaces. TRANS adds ESCAPE = Z/17 for seven. This orthogonality is why the discrete Navier-Stokes system has global existence on every lambda=420 ring (Theorem 34, STRUCTURAL analog of Clay-NS, NOT a Clay proof; S1437).");
  dom_append(dom_body(), hero)
)

fn algebra_three_faces() = (
  let sec = make_section("800px") in
  render_h2(sec, "Three Ways to Touch");
  render_p(sec, "Think about three ways of touching something. You can look at it (add) -- always reversible. You can handle it (multiply) -- sometimes things jam. Or you can decide about it (project) -- and once you decide, there is no undeciding.");
  let g = make_findings_grid(sec) in
  render_finding(g, "SEE (+)", "Always reversible", "Addition in Z/NZ. Every element has an additive inverse. Looking never damages.", "");
  render_finding(g, "ACT (*)", "2419200 / 12612600 reversible", "Multiplication. 480 keys in THIN, 2419200 in TRUE. Units = fully reversible elements.", "");
  render_finding(g, "SOLVE (e^2=e)", "64 filters, never reversible", "Idempotents. 2^6 = 64 light switches. Each kills or keeps one CRT channel. The immune system.", "");
  render_finding(g, "Meta-ring", "Z/7 classifies the 2^7 cube", "128 TRANS idempotents = vertices of a 7-cube on T^7. All cluster in the warmest ~7% of the eigenvalue range (12.19-14.00 out of ~28 total).", "G8");
  render_theorem(sec, "Prison Theorem (atlas_06, exhaustive)", "Turn off even ONE switch and every single key breaks. Not most -- ALL 480. 0 violations across all 31 non-trivial filters and all 480 keys. Freedom is total or it is nothing.");
  render_p(sec, "Of 288 eigenvalue classes, 32 filters reach 258 (SOLVE). The remaining 30 belong only to units (ACT). 258 + 30 = 288. The ring splits its spectrum into what can be projected and what can only be traversed.");
  dom_append(dom_body(), sec)
)

fn algebra_crt_damping() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Orthogonality: Structural Damping");
  render_p(sec, "The Cayley graph Laplacian on TRUE = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 is a direct sum of six per-channel Laplacians on orthogonal Fourier subspaces. TRANS adds Z/17 (ESCAPE) for seven. Each Fourier mode lives on exactly one channel, and the channels carry energy independently.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Direct-Sum Laplacian", "T^6: L = L_D + L_K + L_E + L_b + L_L + L_GATE", "Each summand is the cycle Laplacian of Z/q_i with eigenvalues 4*sin^2(pi*k/q_i), k=0..q_i-1. T^7 on TRANS adds L_ESCAPE (Z/17). Independent channels, orthogonal subspaces.", "S1437");
  render_finding(g, "No Coupled Blowup", "Simultaneous singularity across 6 orthogonal channels is forbidden", "Discrete Navier-Stokes on any ring Z/N in the 108 lambda=420 lattice has global smooth solutions. STRUCTURAL analog of Clay-NS global existence, NOT a Clay proof -- the ring truncates modes the continuum cannot.", "Thm 34");
  render_finding(g, "b^2 floor applies per channel", "gap_min = 4*sin^2(pi/49) ~ 0.01644 identical across all 108 lambda=420 rings", "Tower_b supplies the minimum Laplacian gap on every channel that contains it (b^2 = 49 strictly dominates D^4=16, K^2=9, E^2=25, L=11, GATE=13). Same controller as Theorem 33 YM gap universality -- one invariant, two Millennium analogs.", "S1436");
  dom_append(dom_body(), sec)
)

fn algebra_group() = (
