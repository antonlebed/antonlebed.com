fn algebra_gcd_determinism() = (
  let sec = make_section("800px") in
  render_h2(sec, "GCD Collapse and K-Channel Determinism");
  render_p(sec, "Phase A (112 sessions) revealed K=3 occupies a unique boundary: algebraically ALIVE (490 split), operationally DATA (cross-channel prediction matches D,E,b). The mechanism is gcd(multiplier, channel modulus).");
  render_theorem(sec, "K-Channel GCD Collapse (Theorem 110, S1657)", "K=3 divides axiom-smooth multipliers 42=D*K*b and 105=K*E*b, collapsing Z/9 to subring {0,3,6}. Removing K (42/K=14, 105/K=35) preserves all other channel GCDs but restores K to full Z/9. Experiment: b->K drops 1000->316 ppt (3.2x). Controls flat: D +/-4, b +/-0. 14/14 test_k_boundary_gcd.ax.");
  render_theorem(sec, "Universal GCD Collapse (Theorem 111, S1658)", "GCD collapse generalizes to ALL DATA channels via two mechanisms: (a) absorption (D,K,b: p|42) -- non-unit mul contracts within subring; (b) entry (E: E does not divide 42) -- non-unit mul provides only route in. E-blindness: E has largest drop (6.7x) because 42=D*K*b excludes E. K marginal=704 stable across all experiments. 15/15 test_gcd_generalize.ax.");
  render_theorem(sec, "K-Channel Determinism (Theorem 112, S1659)", "b->K=1000 ppt (PERFECT). gcd(42,105)=21=K*b. In Z/9: both multipliers=6, annihilating K-subring. Channels become deterministic add-counters (period K=3, b=7). 7 distinct b-values determine K uniquely. Chain cause: E-D=K forces 42=105 mod K^2. 14/14 test_bk_determinism.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "K boundary duality", "ALIVE algebraically, DATA operationally", "K participates in both chain DATA mechanics (as factor of lambda) and 490 ALIVE set. Its omnipresence makes corruption maximally detectable (784 ppt, 0 false alarms in ECC).", "S1649");
  render_finding(g, "E-blindness in GCD", "42 = D*K*b excludes E", "E requires the entry mechanism (non-unit mul provides subring access). Removing E blocks entry: orbit 5->20 values (6.7x drop). Observer does not participate in the primary multiplier.", "S1658");
  dom_append(dom_body(), sec)
)

