  render_table_row_4(tbl, "TRUE Z/12612600", "2419200 = phi(N)", "420 = D^2*K*E*b", "phi = lambda * phi(THIN) * 12. Fattening factor = 420.");
  render_p(sec, "PHI FACTORIZATION: phi(TRUE) = phi(DEEP) * phi(GATE) = 201600 * 12 = 2419200. phi(DEEP) = lambda * phi(THIN) = 420 * 480 = 201600. GATE adds heartbeat factor phi(13) = 12 = D^2*K. Z/210Z self-inverse subgroup: D^3=8 elements forming (Z/2)^3. Generator sum = 5040 = 7! = b!. Mean = 105 = HYDOR.");
  dom_append(dom_body(), sec)
)

fn algebra_fermat() = (
