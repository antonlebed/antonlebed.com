 render_theorem(sec, "PSL Simple Group Order (Theorem 187)", "|PSL(2,p)| for all 7 chain primes decompose as chain-prime products. Z/210 normalized by 2*3: {1, 2, 2*5, 2^2*7}, sum = 41 = 7^2-7-1. sum_EXT - 17*sum_210 = 2*3^2 = 18. Half-successor maps 13->7, 17->3^2. 18/18 verified.");
