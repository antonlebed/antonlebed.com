  render_finding(g, "Row symmetry", "depths sum = GATE, product = ANSWER", "Row {7,3,2,1}: D is deepest (power-visible in 7 channels). L, GATE, ESCAPE have depth 0 (invisible: gcd=1 everywhere).", "S1684");
  render_finding(g, "Grand product", "604800 = phi(TRUE)/D^2 = 10!/6", "Grand product * D*K = 10! = Decality factorial. The Fermat matrix encodes the complete power residue structure in one object.", "");
  dom_append(dom_body(), sec)
)

