)

fn algebra_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Units", "Abstract: elements with multiplicative inverse", "480 units in Z/2,310. Turn off even one channel filter and ALL 480 break (Prison Theorem). 258 spectral + 30 unit-only = 288.");
  render_contrast_row(tbl, "Idempotents", "Projection operators (linear algebra)", "64 = 2^6 channel filters. Each kills or keeps one CRT channel. 6-cube of binary switches.");
  render_contrast_row(tbl, "Ring exponents", "Arbitrary choice", "(3,2,2,2,1) = cross-annihilation speeds. Catalan-forced. Self-describing.");
  render_contrast_row(tbl, "Carmichael lambda", "Technical invariant", "Carmichael lambda ladder ratios = 2,3,5,7. Chain primes in exact order.");
  render_contrast_row(tbl, "Fermat exponents", "phi(p^e)-1, no pattern", "{3, 5, 19, 41, 9}. Sum = 7*11. Totient-exponent gap = 5.");
  render_contrast_row(tbl, "Multiplicative order", "Random-looking", "Decomposes via CRT. 73,728 primitives. Products speak the ring's vocabulary.");
  render_contrast_row(tbl, "CRT trace", "Sum of residues, no pattern", "5-multiplication for uniform elements. Trace duality: Tr(n)+Tr(N-n)=102. 11 swaps the mod-8 and mod-9 channels. Traces of ring constants ARE ring constants.");
  render_contrast_row(tbl, "Lie rank", "Abstract algebra classification", "Seven channels = seven affine Dynkin diagrams. Z/970,200 rank sum = 97. Z/13 adds 12, Z/17 adds 16 = 2^4. Crossed ranks give E7, E8, Leech.");
  render_contrast_row(tbl, "Artin constant", "Conjectured density 37.4%", "VERIFIED: 37.63% for g=7. 97.85% smooth indices. 3 depletes at ratio 1-1/3. Flanking: 7 is PR at 211=210+1.");
  render_contrast_row(tbl, "Chain-open primes", "No expected structure", "1.54% density, 2x enrichment. All 10 pairs cooperate. 3 is MI hub. Stephens degree 32 = |idempotents|.");
  render_contrast_row(tbl, "Mod-8 trapping", "QR is random-looking", "v_2>=3: g=2 NEVER PR. Channel obstruction: mod-8, mod-9, mod-11 opaque; mod-25, mod-49 transparent. g=13 index=1: generates the full group.");
  render_contrast_row(tbl, "41-cluster", "Random primes near 40", "{37,41,43,47}: sum=168=2^3*3*7, mean=42. Phi_6(7)=43 (self-indexed). Index product=56=dim(E7).");
  render_contrast_row(tbl, "Prime counting function", "Smooth curve, no structure", "pi(41)=13. 97 descends through 5^2->3^2->2^2. 137 walks reverse chain. Depth sum=13.");
  render_contrast_row(tbl, "67 as a constant", "Just a prime", "67 = additive hub. 8 independent decompositions. 41+67=108=lattice size. Connects all ring constants.");
  render_contrast_row(tbl, "CRT decomposition", "Technical tool for computing mod products", "Laplacian direct sum across 6 orthogonal Fourier subspaces on Z/12,612,600 (7 on Z/214,414,200). Blocks coupled NS blowup -- Theorem 34 structural global-existence analog (not Clay).");
  render_contrast_row(tbl, "Idempotent classification", "Just 2^k projectors", "3 classes (extreme/primitive/composite). Smooth composite counts for k=2..7; 41 exits at k=8.");
  render_contrast_row(tbl, "Involution structure", "x^2=1, count 2", "Z/2^n plateau at n=3 (V4). Same wall as Hurwitz 2^3=8 and Bott period 8. Z/214,414,200: 256 = 4*2^6.");
  render_contrast_row(tbl, "Regularity", "Von Neumann condition", "Meadow projector: 2^7=128 attention masks in Z/214,414,200. Algebraic dropout. Zero-support = Carmichael lambda = 420.");
  render_contrast_row(tbl, "Primitive root in Z/p^2", "Random generator", "Z/49: 3 is PR. Exactly 3 chain PRs {3,5,17}. 17=3^(5^2). QR/NQR partitions orders.");
  render_contrast_row(tbl, "Generator census", "Channel-by-channel lookup", "7x7 atlas. 3-div law: 3 or 2^2 generators per channel. Inner=10, Outer=11. Grand sum 3*7*23=483.");
  render_contrast_row(tbl, "Fermat power residues", "gcd(p,phi(q)), no pattern", "7x7 matrix. Row depths sum=13. Product=42. Grand product=10!/6. Palindromic columns.");
  render_contrast_row(tbl, "GCD and prediction", "gcd is a mathematical tool", "gcd(multiplier, channel modulus) governs cross-channel prediction. 3's factor collapses Z/9 to deterministic subring. Two mechanisms: absorption (p|42) and entry (5). 5-blindness: 42=2*3*7 excludes 5.");
  render_contrast_row(tbl, "Orphan prime orders", "No expected structure", "All 42 per-channel orders chain-smooth. Z/970,200 sum = 2^10. Z/17 ratios: pure 2-powers. Shadow divides order for all 7.");
  render_p(sec, "The ring operates: 2,419,200 units act, 341,250 eigenvalue classes see, 64 idempotents filter. Three faces of one ring.");
  dom_append(dom_body(), sec)
)

/* dom_on callback: ring calculator -- a+b, a*b, CRT of both */
fn ring_compute() = (
  let a = parse_int_from("#ring-a") in
  let bv = parse_int_from("#ring-b") in
  let result_el = dom_query("#ring-result") in
  let sum = a + bv in
  let prod = ring_mul(a, bv) in
  let a2 = ring_mul(a, a) in
  let ad = a % 8 in let ak = a % 9 in let ae = a % 25 in let ab_ch = a % 49 in let al = a % 11 in let ag = a % 13 in
  let bd = bv % 8 in let bk = bv % 9 in let be_ch = bv % 25 in let bb_ch = bv % 49 in let bl = bv % 11 in let bg = bv % 13 in
  let sd = sum % 8 in let sk = sum % 9 in let se = sum % 25 in let sb = sum % 49 in let sl = sum % 11 in let sg = sum % 13 in
  let pd = prod % 8 in let pk = prod % 9 in let pe = prod % 25 in let pb = prod % 49 in let pl = prod % 11 in let pg = prod % 13 in
  let is_idem = if a2 == a then "YES -- idempotent (e^2 = e)" else "no" in
  dom_inner(result_el, "<p style='color:#88ddaa;margin:4px 0'><b>a = " + "${a}" + "</b> | CRT = (" + "${ad}" + "," + "${ak}" + "," + "${ae}" + "," + "${ab_ch}" + "," + "${al}" + "," + "${ag}" + ")</p><p style='color:#88ddaa;margin:4px 0'><b>b = " + "${bv}" + "</b> | CRT = (" + "${bd}" + "," + "${bk}" + "," + "${be_ch}" + "," + "${bb_ch}" + "," + "${bl}" + "," + "${bg}" + ")</p><p style='color:#ffd700;margin:8px 0'><b>a + b = " + "${sum}" + "</b> | CRT = (" + "${sd}" + "," + "${sk}" + "," + "${se}" + "," + "${sb}" + "," + "${sl}" + "," + "${sg}" + ") -- SEE (always reversible)</p><p style='color:#ff8844;margin:4px 0'><b>a * b = " + "${prod}" + "</b> | CRT = (" + "${pd}" + "," + "${pk}" + "," + "${pe}" + "," + "${pb}" + "," + "${pl}" + "," + "${pg}" + ") -- ACT</p><p style='color:#b0b0c0;margin:4px 0'>a^2 = " + "${a2}" + " | Idempotent? " + is_idem + "</p>")
)

/* Interactive ring calculator section */
fn algebra_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Ring Calculator");
  render_p(sec, "Enter two elements. See their sum (SEE), product (ACT), and CRT decompositions. Check if a is idempotent (SOLVE: a^2 = a).");
  let lbl = dom_create("p") in
  dom_text(lbl, "Ring arithmetic in Z/12,612,600:");
  dom_style(lbl, "color", "#b8b8c8");
  dom_style(lbl, "marginTop", "24px");
  dom_style(lbl, "marginBottom", "8px");
  dom_append(sec, lbl);
  let row = dom_create("div") in
  dom_style(row, "display", "flex");
  dom_style(row, "gap", "8px");
  dom_style(row, "alignItems", "center");
  dom_style(row, "marginBottom", "12px");
  dom_style(row, "flexWrap", "wrap");
  let la = dom_create("span") in
  dom_text(la, "a =");
  dom_style(la, "color", "#b0b0c0");
