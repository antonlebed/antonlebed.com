fn algebra_trace_staircase() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Trace Staircase");
  render_p(sec, "Order the DEEP moduli by ascending size: D^3=8, K^2=9, L=11, E^2=25, b^2=49. Their cumulative sums trace a staircase through the axiom's named constants.");
  render_theorem(sec, "Trace Staircase (Theorem 127)", "Ascending DEEP moduli {D^3, K^2, L, E^2, b^2} give cumulative sums {8, 17, 28, 53, 102} = {D^3, ESCAPE, THORNS, ANSWER+L, D*K*ESCAPE}. Three identities: ESCAPE = D^3 + K^2, ANSWER = D^3 + K^2 + E^2, sum = D*K*ESC = 102. ISO-TRACE: Tr(HYDOR) = Tr(E) = E^2 = 25 via (D+K)^2 expansion. Staircase duality: D*K^3 - (ANSWER+L) = sigma.");
  let g = make_findings_grid(sec) in
  render_finding(g, "ESCAPE from moduli", "D^3 + K^2 = 8 + 9 = 17", "The first two fat moduli sum to the 7th prime. The ESCAPE prime is literally the sum of the first two channel sizes.", "");
  render_finding(g, "ANSWER from fat moduli", "D^3 + K^2 + E^2 = 42", "The three fat-squared moduli (skipping thin L=11) sum to the answer. Fat channels encode 42; thin L rides free.", "");
  render_finding(g, "ISO-TRACE", "Tr(E) = Tr(HYDOR) = E^2 = 25", "Elements 5 and 105 = 3*5*7 have identical CRT trace. The channel-sum fingerprint cannot distinguish the observer from its cooperative expression.", "");
  dom_append(dom_body(), sec)
)

fn algebra_cunningham_stopper() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cunningham Stopper");
  render_p(sec, "The multiplicative order of D=2 modulo each odd axiom prime governs how far Cunningham chains can extend. The orders split into NR (non-quadratic-residue) and QR classes -- and the split encodes ESCAPE.");
  render_theorem(sec, "Cunningham Stopper (Theorem 129)", "ord_p(D) for 6 odd axiom primes: {D, D^2, K, D*E, D^2*K, D^3} = {2, 4, 3, 10, 12, 8}. Sum = K*GATE = 39. LCM = E! = 120. D is primitive root mod {K, E, L, GATE} (NR primes), half-period mod {b, ESC} (QR primes). NR order sum = D^2*b = 28 (2nd perfect number). QR order sum = L = 11. NR - QR = ESCAPE = 17.");
  let g = make_findings_grid(sec) in
  render_finding(g, "NR-QR encodes ESCAPE", "28 - 11 = 17", "The difference between non-residue and quadratic-residue order sums IS the 7th prime. The QR/NR partition of D=2 across the chain contains ESCAPE.", "");
  render_finding(g, "Chain budget", "K + E = D^3 = 8", "CC1(sigma) has length K = 3, CC1(D) has length E = 5. Their sum equals D^3. Product = K*E = 15 = CC1(sigma) stopper.", "");
  render_finding(g, "LCM = E!", "lcm(2,4,3,10,12,8) = 120 = 5!", "The least common multiple of all six orders is exactly 5 factorial. The observer's factorial unifies all D-orders.", "");
  dom_append(dom_body(), sec)
)

