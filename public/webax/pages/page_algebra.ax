)

fn algebra_gcd_determinism() = (
  let sec = make_section("800px") in
  render_h2(sec, "GCD Collapse and Z/9 Channel Determinism");
  render_p(sec, "3 occupies a unique position: algebraically in the outer partition (490 split), operationally behaving like an inner channel (cross-channel prediction matches 2,5,7). The mechanism is gcd(multiplier, channel modulus).");
 render_theorem(sec, "Z/9 Channel GCD Collapse (Theorem 110)", "3 divides chain-smooth multipliers 42=2*3*7 and 105=3*5*7, collapsing Z/9 to subring {0,3,6}. Removing 3 (42/3=14, 105/3=35) preserves all other channel GCDs but restores Z/9 to full range. Experiment: Z/49->Z/9 drops 1000->316 ppt (3.2x). Controls flat: Z/8 +/-4, Z/49 +/-0. 14/14 verified.");
 render_theorem(sec, "Universal GCD Collapse (Theorem 111)", "GCD collapse generalizes to ALL channels via two mechanisms: (a) absorption (2,3,7: p|42) -- non-unit mul contracts within subring; (b) entry (5: 5 does not divide 42) -- non-unit mul provides only route in. 5-blindness: 5 has largest drop (6.7x) because 42=2*3*7 excludes 5. Z/9 marginal=704 stable across all experiments. 15/15 verified.");
 render_theorem(sec, "Z/9 Channel Determinism (Theorem 112)", "Z/49->Z/9=1000 ppt (PERFECT). gcd(42,105)=21=3*7. In Z/9: both multipliers=6, annihilating Z/9 subring. Channels become deterministic add-counters (period 3, 7). 7 distinct Z/49 values determine Z/9 uniquely. Chain cause: 5-2=3 forces 42=105 mod 3^2. 14/14 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Z/9 boundary duality", "Outer algebraically, Z/210-like operationally", "3 participates in both chain Z/210 mechanics (as factor of lambda) and the 490 outer set. Its omnipresence makes corruption maximally detectable (784 ppt, 0 false alarms in ECC).", "");
  render_finding(g, "5-blindness in GCD", "42 = 2*3*7 excludes 5", "5 requires the entry mechanism (non-unit mul provides subring access). Removing 5 blocks entry: orbit 5->20 values (6.7x drop). 5 does not participate in the primary multiplier.", "");
  dom_append(dom_body(), sec)
)

