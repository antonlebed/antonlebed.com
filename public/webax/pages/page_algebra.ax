  render_table_row_4(tbl, "41", "40", "1", "PRIMITIVE ROOT. f(41) = 11*149");
  render_table_row_4(tbl, "43", "2*3 = 6", "7", "Phi_6(7) = 43. Self-indexed.");
  render_table_row_4(tbl, "47", "23", "2", "f(47) = 2161 prime");
  render_p(sec, "Product of indices: 2^3*7 = 56 = dim(E7 fundamental). 7 is a PRIMITIVE ROOT at 43 = Phi_6(7) = 7^2-7+1 = 42+1. The 6th cyclotomic at 7 equals 42+1. Cyclotomic self-index: ONLY 7 has index(7, Phi_6(7)) = 7. The prime recognizes its own cyclotomic value.");
  dom_append(dom_body(), sec)
)

