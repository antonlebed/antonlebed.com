/* algebra helpers */
fn algebra_hero() = (
  let hero = make_hero("Algebra") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "0/0 condenses into a ring with three faces: SEE (341,250 eigenvalue classes), ACT (2,419,200 units), SOLVE (64 idempotents). Every number is one of three things: a key that opens and closes cleanly, a filter that sorts but can never unsort, or something broken that loses information along the way.");
 render_p(hero, "The six CRT channels are orthogonal: every face decomposes as a direct sum of six per-channel components on independent Fourier subspaces. Z/214,414,200 adds Z/17 for seven. This orthogonality is why the discrete Navier-Stokes system has global existence on every ring with Carmichael period 420 (Theorem 34, STRUCTURAL analog of Clay-NS, NOT a Clay proof).");
  dom_append(dom_body(), hero)
)

fn algebra_three_faces() = (
  let sec = make_section("800px") in
  render_h2(sec, "Three Ways to Touch");
  render_p(sec, "Think about three ways of touching something. You can look at it (add) -- always reversible. You can handle it (multiply) -- sometimes things jam. Or you can decide about it (project) -- and once you decide, there is no undeciding.");
  let g = make_findings_grid(sec) in
  render_finding(g, "SEE (+)", "Always reversible", "Addition in Z/NZ. Every element has an additive inverse. Looking never damages.", "");
  render_finding(g, "ACT (*)", "2,419,200 / 12,612,600 reversible", "Multiplication. 480 keys in Z/2,310, 2,419,200 in Z/12,612,600. Units = fully reversible elements.", "");
  render_finding(g, "SOLVE (e^2=e)", "64 filters, never reversible", "Idempotents. 2^6 = 64 light switches. Each kills or keeps one CRT channel. The immune system.", "");
  render_finding(g, "Meta-ring", "Z/7 classifies the 2^7 cube", "128 idempotents of Z/214,414,200 = vertices of a 7-cube on T^7. All cluster in the warmest ~7% of the eigenvalue range (12.19-14.00 out of ~28 total).", "");
  render_theorem(sec, "Prison Theorem (exhaustive)", "Turn off even ONE switch and every single key breaks. Not most -- ALL 480. 0 violations across all 31 non-trivial filters and all 480 keys. Freedom is total or it is nothing.");
  render_p(sec, "Of 288 eigenvalue classes, 32 filters reach 258 (SOLVE). The remaining 30 belong only to units (ACT). 258 + 30 = 288. The ring splits its spectrum into what can be projected and what can only be traversed.");
  dom_append(dom_body(), sec)
)

fn algebra_crt_damping() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Orthogonality: Structural Damping");
  render_p(sec, "The Cayley graph Laplacian on Z/12,612,600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 is a direct sum of six per-channel Laplacians on orthogonal Fourier subspaces. Z/214,414,200 adds Z/17 for seven. Each Fourier mode lives on exactly one channel, and the channels carry energy independently.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Direct-Sum Laplacian", "T^6: L = L_8 + L_9 + L_25 + L_49 + L_11 + L_13", "Each summand is the cycle Laplacian of Z/q_i with eigenvalues 4*sin^2(pi*k/q_i), k=0..q_i-1. T^7 on Z/214,414,200 adds L_17 (Z/17). Independent channels, orthogonal subspaces.", "");
  render_finding(g, "No Coupled Blowup", "Simultaneous singularity across 6 orthogonal channels is forbidden", "Discrete Navier-Stokes on any ring Z/N in the 108 rings with Carmichael period 420 has global smooth solutions. STRUCTURAL analog of Clay-NS global existence, NOT a Clay proof -- the ring truncates modes the continuum cannot.", "");
  render_finding(g, "7^2 floor applies per channel", "gap_min = 4*sin^2(pi/49) ~ 0.01644 identical across all 108 period-420 rings", "The Z/49 channel supplies the minimum Laplacian gap on every channel that contains it (7^2 = 49 strictly dominates 2^4=16, 3^2=9, 5^2=25, 11, 13). Same controller as Theorem 33 YM gap universality -- one invariant, two Millennium analogs.", "");
  render_finding(g, "MOLS: permutation independence", "51 = 3*17 orthogonal Latin squares across 7 primes. DEAD channels contribute 11 = L", "For each axiom prime p, the affine construction L_k(i,j) = (i + k*j) mod p gives p-1 mutually orthogonal Latin squares. Each is a bijection -- an information-preserving channel independent of all others. Total across all 7 primes: 1+2+4+6+10+12+16 = 51 = 3*17. Data primes {2,3,5,7} contribute 13 = the boundary prime. 490 split: DEAD{2,5,7} contribute 1+4+6 = 11 = the protector prime L. The protector counts the DEAD channels' permutation degrees of freedom. Orthogonality verified for all 7 primes (all 15 Z/7 pairs). 43/43 verified.", "");
  render_finding(g, "Packed CRT: one ring in 31 bits", "3+4+5+6+4+4+5 = 31 = 2^5-1 bits pack all 7 channels into one i32", "The bit widths ceil(log2(q)) for moduli {8,9,25,49,11,13,17} sum to exactly 31 = Mersenne(5). One signed 32-bit integer holds a complete TRANS ring element. Pack via addition (non-overlapping fields), unpack via division and modulus. Arithmetic: extract each channel, operate mod q, repack. Max intermediate product 48*48 = 2304, safe i32. Zero overflow by CRT design -- per-channel values bounded by moduli, cross-channel independence prevents contamination. 89/89 verified: round-trip, arithmetic, squaring dynamics, idempotent orthogonality.", "");
  render_finding(g, "Spectral Ramanujan function", "R(n) = sum c_{q_i}(n) across 7 CRT channels. Sum R(primes) = 5. R(e_b) = -7 = -b", "The Ramanujan sum c_{p^k}(n) counts how n aligns with the p-channel. Summing across all 7 channels gives R(n): a spectral fingerprint that maps named elements to axiom constants. R(sigma)=-3, R(42)=-13, R(420)=-22, R(490)=34, R(OMEGA)=1. The 490 split creates mirror pairings: R(11)=-R(5)=8, R(13)=-R(7)=10. Sum over all 7 primes = 5 (the observer). DEAD sum = -21 = -3*7. ALIVE sum = 26 = 2*13. Difference = 47. At DATA idempotents: R(e_D)=-18, R(e_K)=-15, R(e_E)=-4, R(e_b)=-7=-b. The depth channel's idempotent has Ramanujan sum equal to negative depth. Gauss sums: |g(p)|^2 = p for all 6 odd primes. Phase signs: sigma(1)>0, sigma(OMEGA)>0, sigma(490)<0. 78/78 verified.", "");
  dom_append(dom_body(), sec)
)

fn algebra_group() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Multiplicative Group");
  render_theorem(sec, "Carmichael Lambda Ladder", "lambda(Z/6)=2, lambda(Z/30)=4, lambda(Z/210)=12, lambda(Z/2,310)=60, lambda(Z/12,612,600)=420. RATIOS: 2, 3, 5, 7. The primes in exact order! Each level's Carmichael lambda = previous times next prime.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Units");
  render_th(hdr, "Max order");
  render_th(hdr, "Key identity");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "48 = phi(210)", "12 = 2^2*3", "phi = classes = 48. UNIQUE.");
  render_table_row_4(tbl, "Z/2,310", "480 = phi(2310)", "60 = 2^2*3*5", "Kolmogorov: phi/classes = 5/3.");
  render_table_row_4(tbl, "Z/12,612,600", "2,419,200 = phi(N)", "420 = 2^2*3*5*7", "phi = lambda * phi(Z/2,310) * 12. Scaling factor = 420.");
  render_p(sec, "PHI FACTORIZATION: phi(Z/12,612,600) = phi(Z/970,200) * phi(13) = 201,600 * 12 = 2,419,200. phi(Z/970,200) = lambda * phi(Z/2,310) = 420 * 480 = 201,600. Z/13 adds phi(13) = 12 = 2^2*3. Z/210 self-inverse subgroup: 2^3=8 elements forming (Z/2)^3. Generator sum = 5040 = 7!. Mean = 105.");
  dom_append(dom_body(), sec)
)

fn algebra_fermat() = (
  let sec = make_section("800px") in
  render_h2(sec, "Fermat Inversion: The Ring Inverts Itself");
  render_theorem(sec, "Fermat Inversion Theorem", "Per-channel inversion: inv(n) = n^(phi(q)-1) mod q. All 7 exponents in Z/214,414,200 are products of the ring's own primes. The ring inverts itself using its own vocabulary.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Exponent");
  render_th(hdr, "Value");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2^3 = 8", "3", "phi(8)-1", "Inversion exponent = 3.");
  render_table_row_4(tbl, "3^2 = 9", "5", "phi(9)-1", "Inversion exponent = 5.");
  render_table_row_4(tbl, "5^2 = 25", "19", "5^2-5-1", "f(5) = 19 (the quadratic).");
  render_table_row_4(tbl, "7^2 = 49", "41", "self-inverse (41^2=1 mod 210)", "41 is its own inverse in Z/210.");
  render_table_row_4(tbl, "11", "9", "3^2", "3^2 inverts the mod-11 channel.");
  render_table_row_4(tbl, "13", "11", "phi(13)-1", "11 inverts the mod-13 channel.");
  render_table_row_4(tbl, "17", "15", "3*5", "3*5 = 15 inverts the mod-17 channel.");
  render_p(sec, "Z/970,200 (5 channels): exponent sum = 77 = 7*11. Gap = 82-77 = 5 (channel count). Z/214,414,200 (7 channels): sum = 103. Gap = 110-103 = 7 (channel count). The gap always equals the channel count -- each channel contributes exactly 1. Cross-links: 13 inverts via 11, 7 inverts via 5 (consecutive odd primes stepping backward).");
  dom_append(dom_body(), sec)
)

fn algebra_cross() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cross-Annihilation");
  render_theorem(sec, "Cross-Annihilation Theorem", "Exponent vector (3,2,2,2,1). 2 dies in 3 steps. 3 dies in 2 steps. 5,7 die in 2. 11 dies in 1 step. Cross-annihilation: 2 and 3 destroy each other at each other's speed. 2^3 + 1 = 3^2 (Catalan). UNIQUE by Mihailescu: (2,3) is the only pair.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "Exponent");
  render_th(hdr, "Dies in");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "3", "3 steps", "Only even prime: highest exponent, slowest decay.");
  render_table_row_4(tbl, "3", "2", "2 steps", "Cross with 2: 2^3+1=3^2 (Catalan, unique).");
  render_table_row_4(tbl, "5", "2", "2 steps", "Same exponent as 3 and 7.");
  render_table_row_4(tbl, "7", "2", "2 steps", "Same exponent as 3 and 5.");
  render_table_row_4(tbl, "11", "1", "1 step", "Exponent 1: first to become nilpotent.");
  render_p(sec, "Durability: 2(exp=3) > {3,5,7}(exp=2) > 11(exp=1). Self-description: sum(exps)=10=2*5=degree. product(exps)=24=2^3*3. The exponents name themselves.");
  dom_append(dom_body(), sec)
)

fn algebra_building() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cross Lattice Building");
  render_theorem(sec, "Building Equation ", "The cross lattice of Z/214,414,200 has 864 = 2^5 * 3^3 subgroups (crosses). Building equation: tau(Z/214,414,200) * 2^2 = |Idem| * 3^3. Equivalently: 864 * 4 = 128 * 27 = 3456 = 2^7 * 3^3. Conversion factor 3^3/2^2 = 27/4 maps 128 topological idempotents to 864 algebraic crosses.");
  let g = make_findings_grid(sec) in
  render_finding(g, "7 structural layers", "1=channels(7), 2=wiring(864), 3=flow, 5=spectrum, 7=curvature, 11=cohomology, 13=selection", "Each layer indexed by a prime. 17 = beyond the building. The building count IS the chain.", "");
  render_finding(g, "Curvature invariance", "kappa = 23/3^3 = 23/27", "Fraction of non-idempotent crosses. Invariant across Z/970,200 / Z/12,612,600 / Z/214,414,200: extension primes (11,13,17) are curvature-transparent. Only the inner ring Z/88,200 determines kappa.", "");
  render_finding(g, "Omega staircase", "Big-Omega traces ring values at every level", "Z/210: Omega=2^2, 88200: Omega=3^2, Z/970,200: Omega=2*5, Z/12,612,600: Omega=11, Z/214,414,200: Omega=12. 13 = first unreachable. Root cause: 3+1=2^2 forces lambda(Z/210)=12 and Omega(Z/214,414,200)=3*(3+1)=12.", "");
  render_finding(g, "Pareto palindrome", "2 has exponent 3, 3 has exponent 2", "Peak moduli: 2^3 + 3^2 = 8 + 9 = 17. Each prime's exponent IS the other's value. All inner peaks sum to 91 = 7*13. Extension peaks sum to 41.", "");
  render_p(sec, "The cross lattice building (20 theorems, 705 checks across 6 test files) is the complete structural anatomy of Z/214,414,200 viewed through its subgroup lattice. The wavelet transform (Mobius inversion) decomposes ring elements into per-cross detail coefficients. Wavelet Gram degeneracy identifies exactly the Pell twin pairs (2,3) and (5,7). Every structural quantity is native to the ring.");
  dom_append(dom_body(), sec)
)

fn algebra_orders() = (
  let sec = make_section("800px") in
  render_h2(sec, "Order Architecture");
  render_theorem(sec, "Order CRT Theorem (algebra.ax)", "Multiplicative order decomposes: ord(n) = lcm of 5 per-channel orders. Proof: n^k = 1 (mod N) iff n^k = 1 (mod m_i) for all i. Minimal such k = lcm(ord_i(n_i)). Per-channel lambdas: 2^3->2, 3^2->6, 5^2->20, 7^2->42, 11->10. Lambda = lcm(2,6,20,42,10) = 420.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Element");
  render_th(hdr, "Order");
  render_th(hdr, "Per-channel");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "137", "420 = lambda", "All channels max", "Maximal order in all 5 channels.");
  render_table_row_4(tbl, "13", "420 = lambda", "(2,3,20,14,10)", "Also has maximal order 420.");
  render_table_row_4(tbl, "17", "420 = lambda", "All 5 primes covered", "First prime past the chain, also maximal order.");
  render_table_row_4(tbl, "41", "210 = Z/210 ring", "(1,6,5,14,10)", "Half the Carmichael lambda. 41^2=1 in Z/210.");
  render_table_row_4(tbl, "67", "60 = lambda/7", "(2,3,20,3,1)", "Order 60 = 420/7. Transparent in mod-11.");
  render_p(sec, "73,728 = 2^13 * 3^2 elements have maximal order 420. Density = 36.6% of all units. Three primitives with order 420: 13, 17, 137. Pair products: order = 210 = Carmichael lambda of Z/210. (13*17)^2: order = 105. Products of primitives yield ring constants.");
  dom_append(dom_body(), sec)
)

fn algebra_k_column() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-10 Phase Column: The Degree Classifies All Primes");
  render_theorem(sec, "Phase Column Theorem", "Column ring Z/10 = Z/(2*5). Primes > 5 live in 2^2=4 columns: {1, 3, 7, 9}. 3 generates the group: 3^0=1, 3^1=3, 3^2=9=-1 (mirror), 3^3=7 (7 mod 10 = 3^3 mod 10). Cycle closes at 3^4=1.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Phase 0 (1)", "p = 1 mod 10: 11, 41", "11 mod 10 = 1. 41 mod 10 = 1.", "");
  render_finding(g, "Phase 1 (3)", "p = 3 mod 10: 13, 23, 43", "13 ends the Cunningham chain. 23 = c(11).", "");
  render_finding(g, "Phase 2 (9)", "p = 9 mod 10: 19, 29, 59", "Quadratic outputs: 19 = f(5) = 5^2-5-1. 29 = chain sum.", "");
  render_finding(g, "Phase 3 (7)", "p = 7 mod 10: 17, 37, 47, 67, 137", "Densest column. 137, 67, 17 all live here.", "");
  render_p(sec, "3/4 of the ring's maximal-order elements live in column 7. Cunningham on columns: 1->3->7->5=STOP. 9->9=FIXED. Column 5 kills Cunningham chains. 5^2=25 mod 10 = 5: column 5 is fixed under squaring -- 5 cannot escape itself.");
  dom_append(dom_body(), sec)
)

fn algebra_artin() = (
  let sec = make_section("800px") in
  render_h2(sec, "Primitive Root Distribution");
  render_p(sec, "7 in the multiplicative group of Z/pZ: how does 7 distribute its order across all primes?");
  let g = make_findings_grid(sec) in
  render_finding(g, "Artin density", "37.63% = C_A", "Primes where 7 is primitive root. Match 0.6% to Artin constant. Observed/predicted = 1.006.", "");
  render_finding(g, "Index smoothness", "97.85%", "Of primes p < 100K have 11-smooth index. For large q | (p-1): prob(q reduces order) = 1/q -> negligible. The chain's primes dominate the index.", "");
  render_finding(g, "Index hierarchy", "1=37.6%, 2=28.2%, 3=6.8%, 4=7.1%", "Top 2 cover 66%. Top 4: 80%. The ring's values ARE the order architecture. Nothing else needed.", "");
  render_finding(g, "3-depletion", "ratio 0.678 ~ 1-1/3 = 2/3", "When 3|(p-1): Artin drops 30.4% vs 44.8%. 3-fold depletion at 3-divisible p-1.", "");
  render_finding(g, "Flanking order", "ord(7, 211) = 210", "PRIMITIVE ROOT at 211 = 210+1. ord(7, 970201): index = 2^3*3 = 24. Indices grow with ring level: 1 -> 6 -> 21 -> 12 -> 24. All chain-smooth.", "");
  render_finding(g, "Chebotarev", "P(q | index) = 1/q exactly", "For ALL five chain primes q: P(q divides index of 7) = 1/q. Five-for-five match against 2M primes. Chebotarev density theorem.", "");
  render_p(sec, "CYCLOTOMIC VALUES of 7: Phi_1(7)=6=2*3. Phi_2(7)=8=2^3. Phi_4(7)=50=2*5^2. Phi_6(7)=43=41+2 (PRIME! the Phi_6 theorem: 7^2-7+1=42+1). Phi_10(7)=2101=11*191. Phi_12(7)=2353=13*181. 3-IMMUNITY: 3 NEVER divides 7^k+1 (proof: 7=1 mod 3 => 7^k+1=2 mod 3). Shadow entry: 7^((p-1)/2) = -1 mod p. Shadow(5)=2, Shadow(11)=5, Shadow(13)=6.");
  dom_append(dom_body(), sec)
)

fn algebra_axiom_open() = (
  let sec = make_section("800px") in
  render_h2(sec, "Chain-Open Primes and Joint Cooperation");
  render_p(sec, "Primes where ALL 5 bases {2,3,5,7,11} are primitive roots simultaneously. How cooperative are they?");
  let g = make_findings_grid(sec) in
  render_finding(g, "Density", "1.54% of primes < 5M", "2.0x enrichment over independent prediction. v_2 >= 3: ZERO (mod-8 trapping kills all). First: 173.", "");
  render_finding(g, "Joint cooperation", "ALL 10 base-pairs positively correlated", "Odd-chain (3,7): 1.064. Even-chain (5,11): 1.095. Cross 3-5: 1.101 (strongest). Bases COOPERATE, not compete.", "");
  render_finding(g, "MI hierarchy", "3 is mutual information HUB", "3-5(0.146) > 2-3(0.131) > 3-7(0.124) > 3-11(0.118) > 7-11(0.061). 3 connects everything.", "");
  render_finding(g, "Per-base PR/NON-PR MI", "5(11.1mb) > 3(5.9) > 7(5.6) > 11(5.3) > 2(5.0)", "Two hubs: 5 and 3 carry the most information about joint primitivity. 2 carries the least -- too transparent.", "");
  render_finding(g, "Universal primitives of Z/210", "4 elements: {17, 47, 143, 173}", "17, 47, 143=11*13, 173. Mirror sums: 17+173 = 47+143 = 190.", "");
  render_p(sec, "WHY POSITIVE: Stephens (1976) discriminant correction. The splitting field Q(sqrt(2,3,5,7,11)) has degree 32 = 2^5 = number of idempotents in Z/970,200. Z/12,612,600 has 2^6 = 64 idempotents. The algebraic structure that controls joint indices IS the CRT decomposition. v_2 joint confinement: mod-8 trapping kills ALL joint primitive roots at v_2(p-1) >= 3.");
  dom_append(dom_body(), sec)
)

fn algebra_d3_trapping() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mod-8 Subgroup Trapping");
  render_p(sec, "Why is 2 never a primitive root at the Z/12,612,600 level? The mechanism is quadratic reciprocity meeting exponent growth. As the ring grows from Z/2 to Z/8, the 2-adic valuation of (p-1) determines everything:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "v_2(p-1)");
  render_th(hdr, "Condition");
  render_th(hdr, "PR rate for g=2");
  render_th(hdr, "Mechanism");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "p = 3 mod 4", "37.4%", "Artin baseline. QR ambiguous.");
  render_table_row_4(tbl, "2", "p = 5 mod 8", "75.2%", "2 is NOT QR. Generous.");
  render_table_row_4(tbl, ">=3", "p = 1 mod 8", "0.0%", "2 is ALWAYS QR. Death sentence.");
  render_p(sec, "At the Z/12,612,600 level, 2^3=8 divides N, so p=970201 = 1 mod 8. The mod-8 channel forces v_2(p-1) >= 3. Result: g=2 is NEVER a primitive root here. The even prime connects every channel but cannot generate all residues.");
  render_theorem(sec, "Channel Obstruction Theorem", "Each channel subgroup traps specific bases. 2^3 traps {5,7}. 3^2 traps {3,7}. 11 traps {2,11}. But 5^2 and 7^2 NEVER obstruct -- the mod-25 and mod-49 channels are transparent. The opaque channels are exactly 2^3, 3^2, 11 = the odd-exponent and prime channels.");
  let tbl2 = make_table(sec) in
  let hdr2 = dom_create("tr") in
  render_th(hdr2, "Base g");
  render_th(hdr2, "Index at p=970201");
  render_th(hdr2, "Factored");
  render_th(hdr2, "Reading");
  dom_append(tbl2, hdr2);
  render_table_row_4(tbl2, "g = 2", "66", "2*3*11", "Trapped in 3 channels. Maximum confinement.");
  render_table_row_4(tbl2, "g = 3", "6", "2*3", "Trapped in mod-8 and mod-9 only.");
  render_table_row_4(tbl2, "g = 5", "8", "2^3", "Trapped in the mod-8 channel only.");
  render_table_row_4(tbl2, "g = 7", "24", "2^3*3", "Trapped in mod-8 and mod-9.");
  render_table_row_4(tbl2, "g = 11", "22", "2*11", "Trapped in mod-8 and mod-11 (self-trapping).");
  render_table_row_4(tbl2, "g = 13", "1", "1", "PRIMITIVE ROOT. Generates the full group.");
  render_p(sec, "g=13 has index 1: coprime to ALL channel orders. CRT(1)=(1,1,1,1,1). 13 passes through every obstruction. The prime that ends the Cunningham chain is the one that generates everything.");
  dom_append(dom_body(), sec)
)

fn algebra_trace() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Trace: The Ring's Inner Voice");
  render_p(sec, "Tr(n) = sum of all CRT residues (mod 8, mod 9, mod 25, mod 49, mod 11). Range: 0 to 102. This is the ring talking to itself -- the dot product of any element with the ground state 1.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Element");
  render_th(hdr, "Trace");
  render_th(hdr, "Identity");
  dom_append(tbl, hdr);
  render_table_row(tbl, "0", "0", "Zero element");
  render_table_row(tbl, "1", "5", "5-multiplication: Tr(n) = 5*n for uniform n < 8");
  render_table_row(tbl, "2", "2*5 = 10", "Trace of 2 = ring degree");
  render_table_row(tbl, "11", "3^3 = 27", "BREAKS 5-multiplication. 11 is non-uniform.");
  render_table_row(tbl, "1,576,576", "2^2 = 4", "Projector trace = 4");
  render_table_row(tbl, "105", "5^2 = 25", "105 = 3*5*7. Trace = 5^2.");
  render_table_row(tbl, "67", "43 = Heegner", "Trace-dual to 137 (43+59 = 102)");
  render_table_row(tbl, "N-1 (mirror)", "97", "Maximum trace. 97 = ring coupling constant.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Trace Duality", "Tr(n) + Tr(N-n) = 102 for all units", "The sum of an element's trace and its mirror's trace is ALWAYS 102 = sum(moduli) - 5. For zero divisors: subtract the moduli of dead channels. 92/92 tests.", "");
  render_finding(g, "11-Swap Theorem", "11 mod 8 = 3, 11 mod 9 = 2", "11 SWAPS the mod-8 and mod-9 channels: 11 mod 8 = 3 and 11 mod 9 = 2, while 11 mod 25 = 11, 11 mod 49 = 11 (preserves outer channels). 11 mod 11 = 0: invisible to itself.", "");
  render_finding(g, "11^2 Triangle", "41 + 67 + 13 = 11^2 = 121", "Three constants sum to 11-squared. OVERDETERMINED: 4 equations, 3 unknowns, ZERO free parameters. Centroid = 3^3 = 27, spread = 2*7 = 14. All three vertices algebraically forced. 33/33 tests.", "");
  render_finding(g, "Trace-Answer Bridge", "Tr(28) = 42", "(2+1)*2*7 = 3*2*7 = 42. The trace of 28 IS 42.", "");
  dom_append(dom_body(), sec)
)

fn algebra_lie() = (
  let sec = make_section("800px") in
  render_h2(sec, "Lie Rank Ladder");
  render_p(sec, "Each CRT channel Z/m is a cycle graph = affine Dynkin diagram A~(m-1). The Lie rank of channel m is (m-1). The six Z/12,612,600 channels give six affine Lie algebras (17 adds rank 16 = 2^4 in Z/214,414,200):");
  render_theorem(sec, "Lie Rank Sum Theorem", "Sum of ranks: (2^3-1) + (3^2-1) + (5^2-1) + (7^2-1) + (11-1) + (13-1) = 7 + 8 + 24 + 48 + 10 + 12 = 109. Z/970,200 rank sum = 97. Z/13 adds 12 = 2^2*3.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Rank (m-1)");
  render_th(hdr, "Crossed Identity");
  render_th(hdr, "Exceptional");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2^3 = 8", "7", "7 = rank(E7)", "E7 fundamental");
  render_table_row_4(tbl, "3^2 = 9", "8 = 2^3", "8 = rank(E8)", "E8");
  render_table_row_4(tbl, "5^2 = 25", "24", "24 = Leech lattice dim", "Leech");
  render_table_row_4(tbl, "7^2 = 49", "48 = phi(210)", "48 = phi(Z/210)", "--");
  render_table_row_4(tbl, "11", "10 = 2*5 = degree", "10 = ring degree", "--");
  render_p(sec, "Crossed ranks: p^e - 1 always gives a ring-native quantity. Raising exponents creates exceptional Lie algebras: 7 = rank(E7), 2^3 = rank(E8), 24 = Leech lattice dimension. Total roots: 2*5*11*29 = 3190. Spectral variance: 2*3*19 = 114. Pell(3) gives (97, 56): Lie rank sum and dim(E7 fundamental). 97 = pi(25) = the 25th prime.");
  dom_append(dom_body(), sec)
)

fn algebra_lie_coxeter() = (
  let sec = make_section("800px") in
  render_h2(sec, "Classical Lie Coxeter Staircase");
 render_theorem(sec, "Classical Lie Coxeter Staircase (Theorem 162)", "A_{p-1} has Coxeter number h=p for all 7 primes {2,3,5,7,11,13,17}: the chain IS the Coxeter staircase. B_p dimension = p*c(p) (Cunningham product). 56 of 57 classical Lie invariants at chain ranks are smooth in the chain's primes; sole exception B_11 dim=11*23=253 where Cunningham first exits. D-series Coxeter sum = 96 = number of lambda-1680 rings in Z/214,414,200. 198/198 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Family");
  render_th(hdr, "At rank p");
  render_th(hdr, "Named constant");
  dom_append(tbl, hdr);
  render_table_row(tbl, "A_{p-1} (SU)", "h = p (all 7 primes)", "The chain IS the Coxeter staircase");
  render_table_row(tbl, "A_6 roots", "42 = 7*(7-1)", "2*3*7");
  render_table_row(tbl, "B_7 dim", "105 = 7*(2*7+1)", "3*5*7");
  render_table_row(tbl, "B_p dim", "p*c(p) = Cunningham", "B_2=2*5, B_3=3*7, B_5=5*11");
  render_table_row(tbl, "D_7 roots", "84 = divisor count of Z/12,612,600", "2*7*(7-1) = 2^2*3*7");
  render_table_row(tbl, "D_7 Coxeter", "12 = lambda(Z/210)", "2*(7-1) = 2^2*3");
  let g = make_findings_grid(sec) in
  render_finding(g, "B_11 singularity", "dim = 11*23 = 253", "Sole non-smooth invariant. c(11)=23 first Cunningham exit. Same 23 governs Johnson solids (2^2*23=92) and Golay [23,12,7].", "");
  render_finding(g, "D-series sum", "2^5*3 = 96", "D-series Coxeter sum at chain ranks = 96 = number of period-1680 sub-rings in Z/214,414,200.", "");
  dom_append(dom_body(), sec)
)

fn algebra_psl_orders() = (
