fn algebra_factorial_valuation() = (
  let sec = make_section("800px") in
  render_h2(sec, "Factorial Valuation Matrix");
  render_p(sec, "The 7x7 matrix M[p][q] = v_p(q!) of p-adic valuations of factorial among axiom primes is upper triangular with unit diagonal. Each row tells how deeply a prime divides the factorials of the larger primes.");
  render_theorem(sec, "Factorial Valuation Matrix (Thm 197, S1787, PROVED)", "Trace = b = 7 (all diagonal = 1). Det = sigma = 1 (unipotent). Max entry = K*E = 15 at M[D][ESCAPE]. Row sums read the chain reversed: ANSWER(42), f(E)(19), K^2(9), E(5), K(3), D(2), sigma(1). Column sums = Omega(p!): sigma, D, E, D^3, D^4, D^2*E, c(D*b) = 29. Total = K^4 = 81 = (K^2)^2. Binary digit sums of the 7 axiom primes = D^4 = phi(ESCAPE). Tail sums produce axiom values: KEY = 41 at L, phi(DATA) = 48 at b. DATA row total = K*E^2 = 75, EXT row total = D*K = 6. All 28 non-zero entries axiom-smooth. 139/139 test_factorial_valuation.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Chain reversal", "Rows: 42, 19, 9, 5, 3, 2, 1", "Row sums trace the chain reversed through the stop back to sigma. ANSWER at the D row, sigma at the ESCAPE row. The largest prime generates the smallest valuation row.", "S1787");
  render_finding(g, "Total = K^4", "81 = closure to the fourth", "K^4 = (K^2)^2 -- the chain stop, squared again. Factorial valuations cannot escape the closure's gravitational pull.", "S1787");
  render_finding(g, "Staircase diffs", "23, 10, 4, 2, 1, 1", "First row difference = c(L) = 23 (Cunningham boundary). Second = D*E = 10 (Decality). The factorial staircase encodes the axiom's boundary constants.", "S1787");
  dom_append(dom_body(), sec)
)

fn algebra_factorial_inverse() = (
  let sec = make_section("800px") in
  render_h2(sec, "Factorial Inverse");
  render_p(sec, "The inverse of the factorial valuation matrix has a striking property: ALL 49 entries lie in {-2, -1, 0, 1}. The nilpotent part N = M - I has nilpotent degree exactly b = 7.");
  render_theorem(sec, "Factorial Inverse (Thm 201, S1791, PROVED)", "M^{-1} = I - N + N^2 - ... + N^6 where N is nilpotent of degree b = 7. Only D = 2 entries reach -2, at positions (D,E) and (D,ESCAPE) -- bridge to observer and bridge to transcendence. Subdiagonal = all -1 (chain adjacency). Grand total = -D^3 = -8 (Tower_D top, absorbed). Both sum|row_sums| and sum|col_sums| = D*E = 10 = Decality. Nilpotent power corners (D->ESCAPE k-step flow): K*E(15), KEY(41), D*E^2(50), P(0)(30), K^2(9), sigma(1). K->ESCAPE = +1: positive net flow from closure to escape. 90/90 test_factorial_inverse.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Nilpotent degree = b", "N^7 = 0, N^6 != 0", "The nilpotent part dies at exactly the depth prime. The factorial structure unravels in exactly b = 7 steps.", "S1791");
  render_finding(g, "Only D reaches -2", "(D,E) and (D,ESCAPE)", "The bridge prime alone generates the extremal entries. D connects to E (observer) and ESCAPE (transcendence) with double-strength inverse coupling.", "S1791");
  render_finding(g, "Sum = Decality", "|row| = |col| = 10", "The absolute row-sum and column-sum both equal D*E = 10 = the Decality. The inverse matrix respects the macro tower count in its total variation.", "S1791");
  dom_append(dom_body(), sec)
)

