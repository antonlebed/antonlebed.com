  dom_style(lb, "color", "#b0b0c0");
  dom_append(row, lb);
  make_input_field(row, "ring-b", "e.g. 137");
  make_action_btn(row, "Compute", "ring_compute");
  dom_append(sec, row);
  make_result_box(sec, "ring-result");
  render_p(sec, "Try: a=1576576, b=1576576 -- idempotent! Or a=606376, b=363824 -- sum = 970200 = 0 (Z/970,200 ring).");
  dom_append(dom_body(), sec)
)

fn algebra_idempotent_trinity() = (
  let sec = make_section("800px") in
  render_h2(sec, "Idempotent Trinity");
 render_theorem(sec, "Idempotent Trinity (Theorem 120)", "2^k idempotents partition into 3 classes: EXTREME {0,1} (size 2), PRIMITIVE weight-1 (size k), COMPOSITE weight 2..k-1 (size 2^k-k-2). Composite count is chain-smooth for exactly k=2..7: 3, 2*5, 5^2, 2^3*7, 7*17. At k=8: 7^2-7-1=41 exits the smooth zone. 1,576,576 is weight-(k-1) composite; 1 = 1,576,576 + e_2, orthogonal. 15/15 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "k=3 (Z/210 base)", "composites = 3", "Z/30 = Z/2 x Z/3 x Z/5. Three primitives {15, 10, 6}, three composites, two extremes.", "");
  render_finding(g, "k=7 (Z/214,414,200)", "composites = 7*17 = 119", "128 total = 2^7. Extreme(2) + primitive(7) + composite(119). 1,576,576 = weight-6.", "");
  render_finding(g, "k=8 exit", "7^2-7-1 = 41", "2^8-8-2 = 246 = 2*3*41. The quadratic f(7) = 41 is the first non-smooth composite count.", "");
  dom_append(dom_body(), sec)
)

fn algebra_hurwitz() = (
  let sec = make_section("800px") in
  render_h2(sec, "Hurwitz Wall: Why the Mod-8 Channel Has Exponent 3");
 render_theorem(sec, "Hurwitz Mod-8 Wall (Theorem 117)", "Z/2^n involutions: 1, 2, 4, 4, 4... Plateau at n=3 (Klein four-group V4 = Z/2 x Z/2). Odd primes: always exactly 2. The 2-channel's unique Pareto exponent 3 = Hurwitz's 2^3 = 8 normed-division-algebra wall (R, C, H, O) = Bott period 8. Root cause: 2-adic stabilization of Z/2^n*. Z/214,414,200 has 256 = 4*2^6 involutions: the 2-channel contributes 4 (V4), every odd channel contributes 2. 15/15 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Three lenses, one wall", "2^3 = 8", "Ring theory (involution plateau), topology (Hurwitz algebras R/C/H/O), K-theory (Bott periodicity 8). All the same 2-adic stabilization.", "");
  render_finding(g, "Involution product", "4 * 2^6 = 256", "The 2-channel contributes 4 (unique). Six odd primes contribute 2 each. Product = Z/214,414,200 involution count.", "");
  dom_append(dom_body(), sec)
)

fn algebra_meadow() = (
  let sec = make_section("800px") in
  render_h2(sec, "Meadow Projector");
 render_theorem(sec, "Meadow Projector (Theorem 118)", "Support projector pi: Z/N -> Idem(Z/N) via per-channel regularity. pi(n)_i = 1 if gcd(n, p_i) = 1, else 0. Properties: pi^2 = pi, pi(ab) = pi(a)*pi(b), pi(n)*n = n iff n is regular. Defines algebraic dropout: each element carries its own 2^k-valued attention mask. |pi^-1(0)| = N/rad(N) = 420 = Carmichael lambda. 128 attention masks in Z/214,414,200 from ring structure. 15/15 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Dropout masks", "2^7 = 128 in Z/214,414,200", "Each element projects to a binary string selecting which channels are alive. The ring's own immune system: 128 possible masks, not learned -- algebraically given.", "");
  render_finding(g, "Regular fraction", "43/120 of Z/970,200", "35.8% of Z/970,200 elements are regular (von Neumann). Z/2,310 is 100% regular (meadow). Raising exponents trades meadow for involutions.", "");
  dom_append(dom_body(), sec)
)

fn algebra_z49_gen() = (
  let sec = make_section("800px") in
  render_h2(sec, "Z/49 Generator");
 render_theorem(sec, "Z/49 Generator (Theorem 134)", "Z/7^2* is cyclic of order phi(7^2) = 2*3*7 = 42. 3 is a primitive root, generating the entire mod-49 channel. Exactly 3 chain primes {3, 5, 17} are primitive roots; sum = 5^2 = 25. Total 12 = lambda(Z/210) primitive roots, sum = 2^2*3*5^2 = 300. Mirror of each has order 3*7 = 21. 17 = 3^(5^2) mod 7^2: 3 raised to the 25th power gives 17. 116/116 test_z49_generator.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "3 generates Z/49", "ord(3, Z/49) = 42 = phi(49)", "3 is a primitive root in the mod-49 channel. 3^21 = -1 mod 49. 3 generates everything.", "");
  render_finding(g, "QR/NQR partition", "QR orders odd, NQR even", "QR orders: {1,3,7,21}. NQR orders: {2,6,14,42}. The parity of the order classifies quadratic residuosity.", "");
  dom_append(dom_body(), sec)
)

fn algebra_gen_atlas() = (
  let sec = make_section("800px") in
  render_h2(sec, "Per-Channel Generator Atlas");
 render_theorem(sec, "Per-Channel Generator Atlas (Theorem 135)", "All 7 Z/214,414,200 CRT channels characterized. 2-channel (Z/8): Klein V4, no primitive roots, 17 = 1 mod 8. 3-divisibility law: 3 chain-prime generators when 3|phi(q), else 2^2 generators. Pattern {3, 2^2, 3, 2^2, 3, 2^2}. Total 21 = 3*7 generation edges. Inner channels gen = 10, Outer gen = 11. Grand order sum = 3*7*23 = 483. 121/121 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "3-divisibility law", "{3, 2^2} alternation", "3|phi(q): channels Z/9, Z/49, Z/13 each have 3 chain-prime generators. 3 does not divide phi(q): channels Z/25, Z/11, Z/17 each have 2^2.", "");
  render_finding(g, "490 split in generators", "Inner = 10, Outer = 11", "Inner channels {mod-8, mod-25, mod-49} contribute 10 generation edges. Outer channels {mod-9, mod-11, mod-13, mod-17} contribute 11. Total = 3*7 = 21.", "");
  dom_append(dom_body(), sec)
)

fn algebra_fermat_matrix() = (
  let sec = make_section("800px") in
  render_h2(sec, "Fermat Power Residue Matrix");
 render_theorem(sec, "Fermat Power Residue Matrix (Theorem 136)", "The 7x7 matrix gcd(chain_prime, phi(Z/214,414,200 modulus)) controls all power residue structure. Row depths {7,3,2,1,0,0,0} sum to 13. Product of nonzero depths = 42. Grand product = phi(Z/12,612,600)/2^2 = 10!/6. Column depths palindromic {1,2,2,3,2,2,1}. 490 split: inner depth = 10, outer depth = 3. Diagonal product = 210. Extension primes 11,13,17 are power-invisible everywhere. 147/147 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Row symmetry", "depths sum = 13, product = 42", "Row {7,3,2,1}: 2 is deepest (power-visible in 7 channels). 11, 13, 17 have depth 0 (invisible: gcd=1 everywhere).", "");
  render_finding(g, "Grand product", "604,800 = phi(Z/12,612,600)/2^2 = 10!/6", "Grand product * 2*3 = 10! = 10 factorial. The Fermat matrix encodes the complete power residue structure in one object.", "");
  dom_append(dom_body(), sec)
)

fn algebra_orphan_orders() = (
  let sec = make_section("800px") in
  render_h2(sec, "Orphan Order Spectrum");
 render_theorem(sec, "Orphan Order Spectrum (Theorem 133)", "7 orphan compatible primes {29,31,43,61,71,211,421} decomposed per CRT channel. All 42 per-channel orders chain-smooth. 2-channel universally ord=2. Z/970,200 order sum = 2^10 = 1024. Z/13 elevates 71 and 421 to full lambda generators. Z/17 extension ratios all 2-powers with exponent sum = 2*7 = 14. 4/7 are Z/214,414,200 lambda generators. 125/125 verified.");
