  render_finding(g, "42-41", "42 - 41 = 1", "2*3*7 - (7^2-7-1) = 1. 42 exceeds 41 by exactly the ground state.", "");
  render_finding(g, "67 and 97 Order Twins", "Both ord 60, differ by 2*3*5 = 30", "Trade 2<->11 invisibility. 18 + 42 = ord(67) = 60.", "");
  render_finding(g, "Mod-8 Trapping", "2 never primitive root at Z/12,612,600 level", "At Z/12,612,600 + 1: g=2 index = 2*3*11 = 66 (maximum confinement). g=13: index = 1 (primitive root). See full mod-8 trapping section above.", "");
