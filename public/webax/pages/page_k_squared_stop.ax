/* K^2 bootstrap step name */
fn k9_sname(s) = (
  if s == 0 then "2 (fixed point)"
  else if s == 1 then "1"
  else if s == 2 then "1"
  else if s == 3 then "3"
  else if s == 4 then "4"
  else if s == 5 then "5"
  else if s == 7 then "7"
  else "${s}"
)

fn k9_check() = (
  let n = parse_int_from("#k9-input") in
  let result = dom_query("#k9-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    let c1 = n % 8 in
    let c2 = n % 9 in
    let c3 = n % 25 in
    let c4 = n % 49 in
    let c5 = n % 11 in
    let c6 = n % 13 in
    mut v = n;
    mut steps = 0;
    while v > 2 do (
      mut v = v / 2 + 1;
      mut steps = steps + 1
    );
    let k9 = n % 9 in
    let k9n = if k9 == 0 then " mod-9 channel = 0." else if k9 == 1 then " 1 mod 9." else "" in
    dom_inner(result, "<p style='color:#ffd700;margin:4px 0'>CRT(" + "${n}" + ") = (" + "${c1}" + "," + "${c2}" + "," + "${c3}" + "," + "${c4}" + "," + "${c5}" + "," + "${c6}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Bootstrap: " + "${steps}" + " steps = " + k9_sname(steps) + "</p><p style='color:#ff9900;margin:4px 0'>mod 9 = " + "${k9}" + "." + k9n + "</p>")
  )
)

fn page_k_squared_stop() = (
  dom_head_meta("description", "3^2 = 2^3 + 1. The only consecutive prime powers (Mihailescu 2002). Three independent proofs the pair (2,3) is forced. Fano plane connection. CRT(9) = (1,0,9,9,9,9): the mod-9 channel vanishes.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"3-Squared Stop\",\"description\":\"3^2=9=2^3+1, the only consecutive prime powers (Mihailescu 2002). CRT(9)=(1,0,9,9,9,9): mod-9 channel vanishes.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/k_squared_stop\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Catalan conjecture\"},{\"@type\":\"DefinedTerm\",\"name\":\"consecutive prime powers\"}]}");
  /* === HERO === */
  let hero = make_hero("Why Does It Stop?") in
  let big = dom_create("div") in
  dom_text(big, "3^2 = 2^3 + 1");
  ct_mono(big);
  dom_style(big, "fontSize", "36px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "2px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The prime chain grows: 1, 2, 3, 5, 7, 11. Each prime emerges from the ones before it via the Cunningham map c(p) = 2p + 1. But after 7, c(4) = 9 -- and 9 is not prime. The chain stops. Not accident: 9 = 8 + 1 satisfies a unique identity proved by Mihailescu in 2002 as the resolution of Catalan's 158-year-old conjecture.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THREE PROOFS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Three Independent Proofs");
  render_p(sec1, "The identity (2,3) is forced by three different roads:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "1. Catalan", "3^2 = 2^3 + 1", "Mihailescu 2002: the ONLY consecutive proper prime powers in all of mathematics.", "");
  render_finding(g1, "2. Cunningham Map", "c(7) = 15 = 3*5", "The map c(p) = 2p+1 applied to 7 gives 15 = 3*5 (composite). Only the pair (2,3) forces c to stop at 3^2.", "");
  render_finding(g1, "3. Uniqueness", "2 is unique", "Among all primes p, only p=2 produces a Cunningham chain where 2p+1 at the stop is the product of two earlier chain primes (3*5).", "");
  render_theorem(sec1, "The Forced Chain", "From 3^2 = 2^3 + 1 alone, the entire chain follows: (2,3) -> c(2) = 5 -> c(3) = 7 -> c(5) = 11 -> c(7) = 15 = 3*5. The ring Z/970,200 = 2^3 * 3^2 * 5^2 * 7^2 * 11 emerges from a single equation: 9 = 8 + 1.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: FOUR PAIRINGS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Four Pairings");
  render_p(sec2, "9 can be partitioned into pairs where both parts appear in the ring's structure:");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "Pair");
  render_th(phdr, "Factored");
  render_th(phdr, "Product");
  render_th(phdr, "Note");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "1 + 8", "1 + 2^3", "8", "Identity + cube");
  render_table_row_4(ptbl, "2 + 7", "2 + 7", "14", "Smallest + largest chain prime below 9");
  render_table_row_4(ptbl, "4 + 5", "2^2 + 5", "20", "Prime power + prime");
  render_table_row_4(ptbl, "3 + 6", "3 + 2*3", "18", "3 + its own double");
  dom_append(sec2, ptbl);
  render_theorem(sec2, "Pair Products Theorem (PROVED)", "The three symmetric products {8, 14, 20} form an arithmetic progression with step 2*3 = 6. Their sum = 42 = 2*3*7. All four products {8, 14, 18, 20} sum to 60 = phi(Z/2,310)/8.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: WHY 9 APPEARS EVERYWHERE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Why 9 Appears Everywhere");
  render_p(sec3, "9 is not just where the chain stops. It appears independently across arithmetic, algebra, and spectral analysis:");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "#");
  render_th(rhdr, "Source");
  render_th(rhdr, "Identity");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "1", "Catalan", "3^2 = 2^3 + 1 (unique consecutive prime powers)");
  render_table_row(rtbl, "2", "Cunningham", "c(4) = 2*4+1 = 9 (first composite in the chain)");
  render_table_row(rtbl, "3", "Polynomial", "f(3) = 3^2-3-1 = 5, so 3+5+1 = 9");
  render_table_row(rtbl, "4", "Sum", "2 + 7 = 9 (smallest + largest prime below 9 in the chain)");
  render_table_row(rtbl, "5", "Reversal", "4 + 5 = 9, and 4 + 9 = 13 = 2^2+3^2");
  render_table_row(rtbl, "6", "Spectral", "Eigenvalue variance at the 5-channel ring = 9");
  render_table_row(rtbl, "7", "CRT", "CRT(9) = (1,0,9,9,9,9): mod-9 channel = 0");
  render_table_row(rtbl, "8", "Degree", "Spectral degree across 6 channels = 1+2+2+2+2 = 9");
  render_table_row(rtbl, "9", "Swim", "Eigenvalue walk hits local max at 9 before 11");
  render_table_row(rtbl, "10", "Lambda split", "3 divides lambda(p^e) for {3,7,13} but not {2,5,11}");
  dom_append(sec3, rtbl);
  render_p(sec3, "Identity #7 is the deepest: CRT(9) in Z/12,612,600 has mod-9 channel = 0. The number that stops the chain is invisible to its own channel. 3 cannot see its own square.");
  render_theorem(sec3, "Mod-9 Projector (PROVED)", "The CRT idempotent for the mod-9 channel is 1,401,400. CRT = (0,1,0,0,0,0) -- it isolates the mod-9 channel and zeros everything else. 1,401,400^2 = 1,401,400 (mod 12,612,600). This is unique: for the other five primes, the analogous element is NOT idempotent (residues 7,4,3,4,10 in the target channel). Adding the mod-13 channel purifies it: 7*13 = 91 = 1 (mod 9).");
  dom_append(dom_body(), sec3);

  /* === SEC 4: FANO PLANE === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Fano-PSL Bridge");
  render_p(sec4, "The shadow polynomial P(x) = (x-1)(x-2)(x-3)(x-5) at x = 9:");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "P(9) = 1344", "8 * |PSL(2,7)|", "8 * 168. The cube times the Fano plane's symmetry group.", "");
  render_finding(g4, "Fano plane", "7 points, 3 per line", "The smallest finite projective plane. 7 points, 7 lines, 3 points per line.", "");
  render_finding(g4, "|PSL(2,7)| = 168", "7(7^2-1)/2", "7 * 48/2 = 168. Automorphism group of the Fano plane.", "");
  dom_append(dom_body(), sec4);

  /* === SEC 5: CLASS BOOTSTRAP === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Class Bootstrap");
  render_p(sec5, "Start from any CRT channel size. Apply floor(q/2)+1 iteratively. Every channel converges to 2 -- and the chain lengths are the ring's primes:");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "700px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "Channel");
  render_th(bhdr, "Chain");
  render_th(bhdr, "Length");
  dom_append(btbl, bhdr);
  render_table_row(btbl, "7^2 = 49", "49->25->13->7->4->3->2", "7 steps");
  render_table_row(btbl, "5^2 = 25", "25->13->7->4->3->2", "5 steps");
  render_table_row(btbl, "3^2 = 9", "9->5->3->2", "3 steps");
  render_table_row(btbl, "2^3 = 8", "8->5->3->2", "3 steps");
  render_table_row(btbl, "11", "11->6->4->3->2", "4 steps");
  dom_append(sec5, btbl);
  render_p(sec5, "2 is the unique fixed point: floor(2/2)+1 = 2. The prime chain is its own convergence.");
  dom_append(dom_body(), sec5);

  /* === SEC 5b: ONE-WAY VALVE === */
  let sec5b = make_section("800px") in
  render_h2(sec5b, "The One-Way Valve");
  render_p(sec5b, "The class bootstrap has a FORWARD map too: B(p) = (p^2+1)/2. What it does to each chain prime reveals a phase transition at p = 5.");

  let vtbl = dom_create("table") in
  dom_style(vtbl, "width", "100%");
  dom_style(vtbl, "maxWidth", "700px");
  dom_style(vtbl, "margin", "24px auto");
  dom_style(vtbl, "borderCollapse", "collapse");
  let vhdr = dom_create("tr") in
  render_th(vhdr, "Input p");
  render_th(vhdr, "B(p)");
  render_th(vhdr, "Factorization");
  render_th(vhdr, "Smooth?");
  dom_append(vtbl, vhdr);
  render_table_row_4(vtbl, "3", "5", "5", "YES");
  render_table_row_4(vtbl, "7", "25", "5^2", "YES");
  render_table_row_4(vtbl, "5", "13", "13", "NO");
  render_table_row_4(vtbl, "11", "61", "61", "NO");
  render_table_row_4(vtbl, "13", "85", "5 * 17", "NO");
  render_table_row_4(vtbl, "17", "145", "5 * 29", "NO");
  render_table_row_4(vtbl, "19", "181", "prime", "NO");
  render_table_row_4(vtbl, "23", "265", "5 * 53", "NO");
  render_table_row_4(vtbl, "31", "481", "13 * 37", "NO");
  render_table_row_4(vtbl, "37", "685", "5 * 137", "NO");
  render_table_row_4(vtbl, "41", "841", "29^2", "NO");
  render_table_row_4(vtbl, "47", "1105", "5 * 13 * 17", "NO");
  dom_append(sec5b, vtbl);

  render_p(sec5b, "2 stands outside: B(2) = 5/2 is not an integer. 2 is the fixed point of descent, not a participant in ascent.");

  render_theorem(sec5b, "One-Way Valve Theorem (PROVED)", "B(p) = (p^2+1)/2 partitions chain primes into CONDENSERS {3,7} producing 11-smooth output {5, 25}, and RADIATORS {5, 11} producing non-smooth output {13, 61}. All 8 intruders map to non-smooth composites (0/8 smooth). 13 is one-way: chain primes condense in, intruders radiate out.");

  render_p(sec5b, "B(47) = 1105 = 5*13*17: the last intruder's output weaves together a chain prime, a stopper, and another intruder.");

  render_h2(sec5b, "Intruder Descent Lengths");
  render_p(sec5b, "Apply B to each intruder, then descend back to 2 via floor(n/2)+1. Count the steps:");

  let dtbl = dom_create("table") in
  dom_style(dtbl, "width", "100%");
  dom_style(dtbl, "maxWidth", "700px");
  dom_style(dtbl, "margin", "24px auto");
  dom_style(dtbl, "borderCollapse", "collapse");
  let dhdr = dom_create("tr") in
  render_th(dhdr, "Intruder");
  render_th(dhdr, "B(p)");
  render_th(dhdr, "Descent length");
  render_th(dhdr, "Factored");
  dom_append(dtbl, dhdr);
  render_table_row_4(dtbl, "13", "85", "7", "prime");
  render_table_row_4(dtbl, "17", "145", "8", "2^3");
  render_table_row_4(dtbl, "19", "181", "8", "2^3");
  render_table_row_4(dtbl, "23", "265", "9", "3^2");
  render_table_row_4(dtbl, "31", "481", "9", "3^2");
  render_table_row_4(dtbl, "37", "685", "10", "2*5");
  render_table_row_4(dtbl, "41", "841", "10", "2*5");
  render_table_row_4(dtbl, "47", "1105", "11", "prime");
  dom_append(sec5b, dtbl);

  render_theorem(sec5b, "Intruder Descent Theorem (PROVED)", "The 8 intruders' B-descent lengths are {7, 8, 8, 9, 9, 10, 10, 11}. Five consecutive integers from 7 to 11 in a 1-2-2-2-1 symmetric pattern. The first intruder (13) has descent 7. The last intruder (47) has descent 11. Boundary intruders are singletons; inner intruders pair up.");

  render_p(sec5b, "The descent from B(31) = 481 traces a reverse tour: 481 -> 241 -> 121 -> 61 -> 31 -> 16 -> 9 -> 5 -> 3 -> 2. And B(23) = 265 passes through 67.");
  dom_append(dom_body(), sec5b);

  /* === INTERACTIVE: 9-ANALYZER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: 9-Analyzer");
  render_p(sec_i, "Enter any n. See its CRT decomposition, mod-9 residue, and class bootstrap convergence to 2.");
  make_interactive_widget(sec_i, "Analyze n:", "k9-input", "e.g. 9", "Analyze", "k9_check", "k9-result");
  render_p(sec_i, "Try: 9 (mod-9 channel = 0), 8 (= 2^3), 42, 108, 1576576 (= 2^420 mod 12612600), 13.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "The chain stops at 9", "Coincidence of small numbers.", "3^2 = 2^3 + 1 is a universal boundary (Mihailescu 2002). The four pairings of 9 have products summing to 42 = 2*3*7. P(9) = 8*|PSL(2,7)|.");
  render_contrast_row(sec8, "9 = 3^2", "A small perfect square.", "CRT(9) = (1,0,9,9,9,9): mod-9 channel vanishes. The mod-9 idempotent 1,401,400 is the only channel projector that is also its own coupling value.");
  render_contrast_row(sec8, "Catalan's conjecture", "A curiosity: 8 and 9 are the only consecutive prime powers.", "From 9 = 8 + 1 alone, the chain follows: (2,3) forced, then 5, 7, 11 by Cunningham. One equation, six primes, the ring Z/12,612,600.");
  render_contrast_row(sec8, "Class bootstrap", "Abstract algebraic invariants.", "The class bootstrap is a one-way valve: chain primes condense in (smooth output), intruders radiate out (0/8 smooth). Descent lengths span 7-11 in a 1-2-2-2-1 pattern.");
  dom_append(dom_body(), sec8)
)
