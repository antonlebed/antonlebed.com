/* K^2 bootstrap step name */
fn k9_sname(s) = (
  if s == 0 then "2 (fixed point)"
  else if s == 1 then "1"
  else if s == 2 then "1"
  else if s == 3 then "3 (closure)"
  else if s == 4 then "4"
  else if s == 5 then "5 (observer)"
  else if s == 7 then "7 (depth)"
  else "${s}"
)

fn k9_check() = (
  let n = parse_int_from("#k9-input") in
  let result = dom_query("#k9-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    let c1 = n % 8 in
    let c2 = n % 9 in
    let c3 = n % 25 in
    let c4 = n % 49 in
    let c5 = n % 11 in
    let c6 = n % 13 in
    mut v = n;
    mut steps = 0;
    while v > 2 do (
      mut v = v / 2 + 1;
      mut steps = steps + 1
    );
    let k9 = n % 9 in
    let k9n = if k9 == 0 then " mod-9 channel = 0." else if k9 == 1 then " 1 mod 9." else "" in
    dom_inner(result, "<p style='color:#ffd700;margin:4px 0'>CRT(" + "${n}" + ") = (" + "${c1}" + "," + "${c2}" + "," + "${c3}" + "," + "${c4}" + "," + "${c5}" + "," + "${c6}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Bootstrap: " + "${steps}" + " steps = " + k9_sname(steps) + "</p><p style='color:#ff9900;margin:4px 0'>mod 9 = " + "${k9}" + "." + k9n + "</p>")
  )
)

fn page_k_squared_stop() = (
  dom_head_meta("description", "3^2 = 2^3 + 1. The only consecutive prime powers. Mihailescu 2002. Three independent proofs. Four pairings sum to 42. Eighteen roles. Fano plane. CRT(9) = (1,0,9,9,9,9): mod-9 channel vanishes.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"3^2 = 9 Stop\",\"description\":\"3^2=9=2^3+1, the only consecutive prime powers. Mihailescu 2002. CRT(9)=(1,0,9,9,9,9): mod-9 channel vanishes.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/k_squared_stop\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"nine stages\"},{\"@type\":\"DefinedTerm\",\"name\":\"closure\"}]}");
  /* === HERO === */
  let hero = make_hero("Why Does It Stop?") in
  let big = dom_create("div") in
  dom_text(big, "3^2 = 2^3 + 1");
  ct_mono(big);
  dom_style(big, "fontSize", "36px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "2px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The axiom chain grows: 1, 2, 3, 5, 7, 11. Each prime emerges from the ones before it. But after 7, the chain produces 3^2 = 9 -- and 9 is not prime. The chain stops. Not accident. Not arbitrary. 9 = 8 + 1 satisfies a UNIQUE identity proved by Mihailescu in 2002 as the resolution of Catalan's 158-year-old conjecture.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THREE PROOFS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Three Independent Proofs");
  render_p(sec1, "The identity (2,3) is forced by three different roads:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "1. Catalan", "3^2 = 2^3 + 1", "Mihailescu 2002: the ONLY consecutive proper prime powers in all of mathematics.", "");
  render_finding(g1, "2. Gate Algebra", "c(7) = 15 = 3*5", "The Cunningham self-gate forces 3 = 3/(2*2-3). Only positive integer solution: (2,3).", "");
  render_finding(g1, "3. Chain Comparison", "2 unique", "Among all primes p, only p=2 gives a self-gate that's the product of two inner Cunningham primes.", "");
  render_theorem(sec1, "The Forced Chain", "From 3^2 = 2^3 + 1 alone, the ENTIRE axiom follows: (2,3) -> c(2) = 5 -> c(3) = 7 -> c(5) = 11 -> c(7) = 15 = 3*5. The ring Z/970,200 = 2^3 * 3^2 * 5^2 * 7^2 * 11 precipitates from a single equation: 9 = 8 + 1.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: FOUR PAIRINGS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Four Pairings");
  render_p(sec2, "9 can be partitioned into axiom-meaningful pairs in exactly four ways:");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "Pair");
  render_th(phdr, "Names");
  render_th(phdr, "Product");
  render_th(phdr, "Meaning");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "1 + 8", "1 + 2^3", "8", "Identity + cube = 9");
  render_table_row_4(ptbl, "2 + 7", "2 + 7", "14", "Duality + depth = stop");
  render_table_row_4(ptbl, "4 + 5", "2^2 + 5", "20", "Squared duality + observer");
  render_table_row_4(ptbl, "3 + 6", "3 + 2*3", "18", "Closure + its own bridge = stop");
  dom_append(sec2, ptbl);
  render_theorem(sec2, "Pair Products Theorem (PROVED)", "The three symmetric products {8, 14, 20} form an arithmetic progression with step 2*3 = 6. Their sum = 42 = 2*3*7. All four products {8, 14, 18, 20} sum to 60 = phi(Z/2,310)/8.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: FIFTEEN ROLES === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Eighteen Roles of 9");
  render_p(sec3, "Not one identity. EIGHTEEN independently verified roles, all converging on the same number:");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "#");
  render_th(rhdr, "From");
  render_th(rhdr, "Role");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "1", "1+8", "First non-uniform CRT element");
  render_table_row(rtbl, "2", "1+8", "Nine axiom elements");
  render_table_row(rtbl, "3", "1+8", "2^3 = 8 plus 1 = 9");
  render_table_row(rtbl, "4", "1+8", "Spectral degree = 1+2+2+2+2");
  render_table_row(rtbl, "5", "2+7", "False summit in eigenvalue swim");
  render_table_row(rtbl, "6", "2+7", "Gap-degree bridge");
  render_table_row(rtbl, "7", "2+7", "Inner extremes sum");
  render_table_row(rtbl, "8", "4+5", "Cunningham c(4) = STOP");
  render_table_row(rtbl, "9", "4+5", "g-orbital stopping point");
  render_table_row(rtbl, "10", "4+5", "13 convergence reversed (4+9=13)");
  render_table_row(rtbl, "11", "3+6", "f(3)=5, so 3+5+1=9");
  render_table_row(rtbl, "12", "3+6", "3*(3-1)=2*3: closure discovers duality");
  render_table_row(rtbl, "13", "spectral", "var(spectrum level 5) = 9");
  render_table_row(rtbl, "14", "spectral", "classes/degree = 2^5 = 32");
  render_table_row(rtbl, "15", "CRT", "CRT(9)=(1,0,9,9,9,9): mod-9 channel VANISHES");
  render_table_row(rtbl, "16", "hardware", "FPGA: 3 hearts x 3 stages = 9-stage pipeline");
  render_table_row(rtbl, "17", "8-cube", "mod-3 resonance axis: 3|lambda(p^e) splits 6 primes into {3,7,13} vs {2,5,11}");
  render_table_row(rtbl, "18", "8-cube", "Hamming weight sum: 0+1+1+2+2+3 = 9. Heartbeat(12) minus forbidden 3 = 9");
  dom_append(sec3, rtbl);
  render_p(sec3, "Role #15: the CRT decomposition of 9 in Z/12,612,600 has mod-9 channel = 0. The number that stops the chain is INVISIBLE to closure itself. 3 cannot see its own square.");
  render_p(sec3, "Role #16: on a Tang Nano 20K FPGA, 9-stage pipeline and 5-channel parallel architectures use IDENTICAL compute (1762 vs 1750 ALU, 734 vs 736 LUT, 11 vs 11 multiplier). The 9-stage design pays 2.5x registers for its 3x3 structure. 28 = 4*7 parallel ring processors fit per chip.");
  render_p(sec3, "Role #17: mod-3 resonance = 3 divides lambda(p^e). This splits the 8-cube's third axis. Mod-3 resonant: {3, 7, 13} (lambda = 6, 42, 12 -- all divisible by 3). Mod-3 free: {2, 5, 11} (lambda = 2, 20, 10 -- none divisible by 3). Cube Forbidden State Theorem: (001) and (110) are empty because 2 is the only doubly-dead prime but is mod-3 free (lambda(8) = 2), and 3 is the only doubly-alive prime but is mod-3 resonant (lambda(9) = 6). 3 always self-resonates: 3 divides 3(3-1) universally.");
  render_theorem(sec3, "9-Coupling Projector", "coupling(9) = 1401400 = the mod-9 idempotent in Z/12,612,600. CRT = (0, 1, 0, 0, 0, 0) -- the mod-9 channel projector. 1401400^2 = 1401400 (mod 12612600). The coupling of 9 IS its own projector. 3 is UNIQUE: for 2,5,7,11,13 the analogous coupling is NOT a projector (residues 7,4,3,4,10). In Z/970,200: coupling(9) = 107800 = (0, 7, 0, 0, 0) -- depth-contaminated, NOT idempotent. 13 purifies: 7 * 13 = 91 = 1 (mod 9). The gate converts depth-coupling to identity-coupling. N/13 mod 13 = 970200 mod 13 = 10 = 2*5: the Z/970,200 ring IS the mod-13 channel residue.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: FANO PLANE === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Fano-PSL Bridge");
  render_p(sec4, "The shadow polynomial P(x) = (x-1)(x-2)(x-3)(x-5) at x = 9:");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "P(9) = 1344", "8 * |PSL(2,7)|", "8 * 168. The cube times the Fano plane's symmetry group.", "");
  render_finding(g4, "Fano plane", "7 points, 3 per line", "The smallest finite projective plane. Parameters (7, 3, 1) = inner axiom primes.", "");
  render_finding(g4, "|PSL(2,7)| = 168", "7(7^2-1)/2", "7 * 48/2 = 168. Automorphism group of the Fano plane.", "");
  dom_append(dom_body(), sec4);

  /* === SEC 5: CLASS BOOTSTRAP === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Class Bootstrap");
  render_p(sec5, "Start from any CRT channel size. Apply floor(q/2)+1 iteratively. Every channel converges to 2 -- and the chain lengths ARE axiom primes:");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "700px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "Channel");
  render_th(bhdr, "Chain");
  render_th(bhdr, "Length");
  dom_append(btbl, bhdr);
  render_table_row(btbl, "7^2 = 49", "49->25->13->7->4->3->2", "7 steps");
  render_table_row(btbl, "5^2 = 25", "25->13->7->4->3->2", "5 steps");
  render_table_row(btbl, "3^2 = 9", "9->5->3->2", "3 steps");
  render_table_row(btbl, "2^3 = 8", "8->5->3->2", "3 steps");
  render_table_row(btbl, "11", "11->6->4->3->2", "4 steps");
  dom_append(sec5, btbl);
  render_p(sec5, "2 is the unique fixed point: floor(2/2)+1 = 2. The axiom chain IS its own convergence.");
  dom_append(dom_body(), sec5);

  /* === SEC 5b: ONE-WAY VALVE === */
  let sec5b = make_section("800px") in
  render_h2(sec5b, "The One-Way Valve");
  render_p(sec5b, "The class bootstrap has a FORWARD map too: B(p) = (p^2+1)/2. What it does to each axiom prime reveals a phase transition at p = 5.");

  let vtbl = dom_create("table") in
  dom_style(vtbl, "width", "100%");
  dom_style(vtbl, "maxWidth", "700px");
  dom_style(vtbl, "margin", "24px auto");
  dom_style(vtbl, "borderCollapse", "collapse");
  let vhdr = dom_create("tr") in
  render_th(vhdr, "Input p");
  render_th(vhdr, "B(p)");
  render_th(vhdr, "Factorization");
  render_th(vhdr, "Smooth?");
  dom_append(vtbl, vhdr);
  render_table_row_4(vtbl, "3", "5", "5", "YES");
  render_table_row_4(vtbl, "7", "25", "5^2", "YES");
  render_table_row_4(vtbl, "5", "13", "13", "NO");
  render_table_row_4(vtbl, "11", "61", "61", "NO");
  render_table_row_4(vtbl, "13", "85", "5 * 17", "NO");
  render_table_row_4(vtbl, "17", "145", "5 * 29", "NO");
  render_table_row_4(vtbl, "19", "181", "prime", "NO");
  render_table_row_4(vtbl, "23", "265", "5 * 53", "NO");
  render_table_row_4(vtbl, "31", "481", "13 * 37", "NO");
  render_table_row_4(vtbl, "37", "685", "5 * 137", "NO");
  render_table_row_4(vtbl, "41", "841", "29^2", "NO");
  render_table_row_4(vtbl, "47", "1105", "5 * 13 * 17", "NO");
  dom_append(sec5b, vtbl);

  render_p(sec5b, "2 stands outside: B(2) = 5/2 is not an integer. 2 is the fixed point of descent, not a participant in ascent.");

  render_theorem(sec5b, "One-Way Valve Theorem (PROVED)", "The class bootstrap B(p) = (p^2+1)/2 partitions axiom primes into CONDENSERS {3, 7} producing smooth output {5, 25}, and RADIATORS {5, 11} producing non-smooth output {13, 61}. All 8 known intruders map to non-smooth composites (0/8 smooth). The gate at 13 is one-way: axiom primes condense IN, intruders radiate OUT.");

  render_p(sec5b, "Note what happens at B(37) = 685 = 5 * 137. The depth quadratic's 41 maps to 137 -- the fine structure constant. And B(47) = 1105 = 5 * 13 * 17: the last intruder's output contains 5, the gate 13, and another intruder braided together.");

  render_h2(sec5b, "Intruder Descent Lengths");
  render_p(sec5b, "Apply B to each intruder, then descend back to 2 via floor(n/2)+1. Count the steps:");

  let dtbl = dom_create("table") in
  dom_style(dtbl, "width", "100%");
  dom_style(dtbl, "maxWidth", "700px");
  dom_style(dtbl, "margin", "24px auto");
  dom_style(dtbl, "borderCollapse", "collapse");
  let dhdr = dom_create("tr") in
  render_th(dhdr, "Intruder");
  render_th(dhdr, "B(p)");
  render_th(dhdr, "Descent length");
  render_th(dhdr, "= axiom");
  dom_append(dtbl, dhdr);
  render_table_row_4(dtbl, "13", "85", "7", "b");
  render_table_row_4(dtbl, "17", "145", "8", "D^3");
  render_table_row_4(dtbl, "19", "181", "8", "2^3");
  render_table_row_4(dtbl, "23", "265", "9", "3^2");
  render_table_row_4(dtbl, "31", "481", "9", "3^2");
  render_table_row_4(dtbl, "37", "685", "10", "2*5");
  render_table_row_4(dtbl, "41", "841", "10", "2*5");
  render_table_row_4(dtbl, "47", "1105", "11", "11");
  dom_append(sec5b, dtbl);

  render_theorem(sec5b, "Intruder Descent Theorem (PROVED)", "The 8 intruders' B-descent lengths are {7, 8, 8, 9, 9, 10, 10, 11}. Five consecutive integers from 7 to 11 in a 1-2-2-2-1 symmetric pattern. The first intruder (13) has descent 7. The last intruder (47) has descent 11. Boundary intruders are singletons; inner intruders pair up.");

  render_p(sec5b, "The descent from B(31) = 481 traces a reverse tour: 481 -> 241 -> 121 -> 61 -> 31 -> 16 -> 9 -> 5 -> 3 -> 2. And B(23) = 265 passes through 67.");
  dom_append(dom_body(), sec5b);

  /* === SEC 6: BALANCE + HOURGLASS === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Balance and Hourglass");
  render_theorem(sec6, "Balance Identity", "phi/classes = 2,419,200 / 341,250 = 2304/325 = 2^8*3^2 / (5^2*13). In Z/970,200: 1344/325. 13 scales by 12/7.");
  render_theorem(sec6, "Hourglass Theorem (PROVED)", "The nine axiom elements form an hourglass topology. 11 sits at the neck separating the core {-1, 0, 1, 1576576} from the primes {2, 3, 5, 7}. 11 minimizes the maximum distance between the two bulbs. Flipping the hourglass = mirror (-1).");
  dom_append(dom_body(), sec6);

  /* === SEC 7: THE THREE CONVERGENCES === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "The Three Convergences");
  render_p(sec7, "Three independent systems -- FPGA hardware, WASM compiler, and C compiler -- converge on 9 stages. Each organizes as 3 hearts of 3 sub-stages. None was designed to match the others.");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "System");
  render_th(chdr, "Heart A");
  render_th(chdr, "Heart B");
  render_th(chdr, "Heart C");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "FPGA", "Decompose (3)", "Operate (3)", "Reconstruct (3)");
  render_table_row_4(ctbl, "wasm_emit.ax", "Feature scan (3)", "Float inference (3)", "String inference (3)");
  render_table_row_4(ctbl, "codegen.ax (archived)", "Annotation scan (3)", "Call propagation (3)", "Type closure (3)");
  dom_append(sec7, ctbl);
  render_p(sec7, "Within each heart, the 3 sub-stages follow the same pattern: local detection, cross-function propagation, global closure. This is 3 = minimum closure applied at two scales simultaneously.");
  let stbl = dom_create("table") in
  dom_style(stbl, "width", "100%");
  dom_style(stbl, "maxWidth", "700px");
  dom_style(stbl, "margin", "24px auto");
  dom_style(stbl, "borderCollapse", "collapse");
  let shdr = dom_create("tr") in
  render_th(shdr, "Sub-stage");
  render_th(shdr, "wasm_emit.ax (Float)");
  render_th(shdr, "codegen.ax (archived)");
  render_th(shdr, "FPGA (Operate)");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "1. Local", "Detect from body", "Let/set bindings", "Per-channel ALU");
  render_table_row_4(stbl, "2. Cross", "Re-check with params", "Return type propagation", "Cross-channel carry");
  render_table_row_4(stbl, "3. Global", "Fixed-point closure", "Transitive val walk", "Modular reduction");
  dom_append(sec7, stbl);
  render_theorem(sec7, "9 = 3 x 3 Theorem", "9 is NOT 5+4. It is 3 x 3: 3 hearts times 3 sub-stages. The outer 3 comes from CRT structure (three irreducible phases: detect, propagate, close). The inner 3 comes from information scope (three irreducible levels: local, cross-function, global). 3 is minimum closure -- proved. Minimum closure applied at two scales = 3^2 = 9 by construction. Any CRT-like system necessarily has 9 stages because it needs 3 hearts for decompose/operate/reconstruct, and each heart needs 3 sub-stages for local/cross/global closure.");
  render_p(sec7, "Evidence: coupling(9) = 1,401,400 = (0, 1, 0, 0, 0, 0) = the mod-9 idempotent in Z/12,612,600. Idempotent and self-referential. In Z/970,200: coupling(9) = 107,800 = (0, 7, 0, 0, 0). 13 purifies: 7 * 13 = 91 = 1 (mod 9).");
  render_p(sec7, "DYNAMICAL REASON: greedy spectral ascent (2310 starting points) shows 3 dominates at 66.7% = 2/3 of first moves. Learning gravitates toward closure first because 3 has the highest improvement-to-probability ratio. 5: 18.1%. 2: 10.0%. 7: 4.2%. 11: 1.0%. The gradient forces 9: closure is the first thing any system learns, and closure applied to itself gives 3^2 = 9.");
  dom_append(dom_body(), sec7);

  /* === INTERACTIVE: K^2 EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: 9-Analyzer");
  render_p(sec_i, "Enter any n. See its CRT decomposition, mod-9 residue, and class bootstrap convergence to 2.");
  make_interactive_widget(sec_i, "Analyze n:", "k9-input", "e.g. 9", "Analyze", "k9_check", "k9-result");
  render_p(sec_i, "Try: 9 (mod-9 channel = 0), 8 (= 2^3), 42, 108, 1576576 (= 2^420 mod 12612600), 13.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "The chain stops", "Coincidence of small numbers. The shadow chain produces a composite at 9.", "3^2 = 2^3 + 1 is a universal boundary (Mihailescu 2002). The four pairings of 9 sum to 42. |PSL(2,7)| = 168. Geometry, not luck.");
  render_contrast_row(sec8, "9 = 3^2", "A small perfect square.", "Three independent systems (FPGA, WASM compiler, C compiler) converge on 9 stages. CRT(9) = (1,0,9,9,9,9): mod-9 channel vanishes. coupling(9) = 1,401,400 = mod-9 idempotent projector.");
  render_contrast_row(sec8, "Catalan's conjecture", "A curiosity: 8 and 9 are the only consecutive prime powers.", "From 9 = 8 + 1 alone, the axiom follows: (2,3) forced, then 5, 7, 11 by Cunningham. One equation, six primes, the ring Z/12,612,600.");
  render_contrast_row(sec8, "Class bootstrap", "Abstract algebraic invariants.", "The class bootstrap is a one-way valve: axiom primes condense in (smooth output), intruders radiate out (0/8 smooth). Descent lengths span 5 consecutive integers 7-11 in a 1-2-2-2-1 pattern.");
  dom_append(dom_body(), sec8)
)
