/* page_proof_helpers.ax -- Shared utilities for all proof sub-pages.
   Constants, CRT arithmetic, theorem/result rendering.
   Included by build_lab_entry.ax BEFORE any page_proof_*.ax files.
   S1760: mode flag + sub-page navigation for proof page split. */

/* Mode flag: 0=chain (full page render), 1=standalone (sub-page mode) */
let _pf_mode = [0]

/* Global check counters (reset per sub-page, used by pf_standalone_summary) */
let _pf_total = [0]
let _pf_pass = [0]

/* Sub-page navigation bar (renders links to all proof sub-pages) */
fn pf_sub_nav(parent) = (
  let nav = dom_create("div") in
  dom_style(nav, "display", "flex");
  dom_style(nav, "flexWrap", "wrap");
  dom_style(nav, "gap", "8px");
  dom_style(nav, "justifyContent", "center");
  dom_style(nav, "marginBottom", "32px");
  let items = [
    "/lab/proof_core", "Core (23)",
    "/lab/proof_structure", "Structure (51)",
    "/lab/proof_ai", "AI & Coding (67)",
    "/lab/proof_frontier", "Geometry (56)"
  ] in
  mut ni = 0;
  while ni < 8 do (
    let a = dom_create("a") in
    dom_attr(a, "href", items[ni]);
    dom_text(a, items[ni + 1]);
    dom_style(a, "color", "#ffd700");
    dom_style(a, "fontSize", "13px");
    dom_style(a, "padding", "4px 12px");
    dom_style(a, "border", "1px solid #333");
    dom_style(a, "borderRadius", "4px");
    dom_style(a, "textDecoration", "none");
    dom_append(nav, a);
    mut ni = ni + 2
  );
  dom_append(parent, nav)
)

/* Sub-page hero section */
fn pf_sub_hero(title:str, subtitle:str, desc:str) = (
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "60px 20px 24px");
  let h1 = dom_create("h1") in
  dom_text(h1, title);
  ct_heading(h1);
  dom_style(h1, "fontSize", "28px");
  dom_style(h1, "marginBottom", "8px");
  dom_append(hero, h1);
  let sub = dom_create("p") in
  dom_text(sub, subtitle);
  dom_style(sub, "color", "#aaa");
  dom_style(sub, "fontSize", "15px");
  dom_append(hero, sub);
  let d = dom_create("p") in
  dom_text(d, desc);
  dom_style(d, "color", "#666");
  dom_style(d, "fontSize", "12px");
  dom_style(d, "marginTop", "8px");
  dom_append(hero, d);
  dom_append(dom_body(), hero);
  pf_sub_nav(dom_body())
)

/* Standalone summary (for sub-pages, shows pass/total with red/green) */
fn pf_standalone_summary(local_pass, section_name:str) = (
  let total = _pf_total[0] in
  let pass = _pf_pass[0] in
  let summary = make_section("700px") in
  render_h2(summary, "Summary");
  let sbox = dom_create("div") in
  ct_card(sbox);
  dom_style(sbox, "textAlign", "center");
  dom_style(sbox, "padding", "24px");
  let st = dom_create("div") in
  dom_text(st, "${pass} / ${total} checks verified");
  dom_style(st, "fontSize", "24px");
  dom_style(st, "color", if pass == total then "#44cc44" else "#cc4444");
  dom_style(st, "fontWeight", "bold");
  dom_append(sbox, st);
  let sd = dom_create("div") in
  dom_text(sd, section_name);
  dom_style(sd, "color", "#888");
  dom_style(sd, "marginTop", "8px");
  dom_style(sd, "fontSize", "13px");
  dom_append(sbox, sd);
  dom_append(summary, sbox);
  dom_append(dom_body(), summary)
)

/* CRT lifting idempotents: use CRT_ED..CRT_EG from core.ax (SSOT S2010).
   PF_E* aliases kept for proof page readability. PF_OMEGA = OMEGA_VAL from core.ax. */
let PF_ED = CRT_ED
let PF_EK = CRT_EK
let PF_EE = CRT_EE
let PF_EB = CRT_EB
let PF_EL = CRT_EL
let PF_EG = CRT_EG
let PF_OMEGA = OMEGA_VAL

/* Count idempotents in Z/m (exhaustive: test all 0..m-1). Small m only. */
fn pf_count_idem(m) = (
  mut c = 0; mut i = 0;
  while i < m do (
    if (i * i) % m == i then mut c = c + 1 else 0;
    mut i = i + 1
  );
  c
)

/* CRT reconstruct from 6 channels — delegates to ring_recon (core.ax SSOT). */
fn pf_reconstruct(d, k, e, b, l, g) = ring_recon(d, k, e, b, l, g)

/* Decompose n into 6 CRT channels */
fn pf_decompose(n) = [n % 8, n % 9, n % 25, n % 49, n % 11, n % 13]

/* Ring multiply via CRT: decompose, multiply per-channel, reconstruct.
   Per-channel max: 48*48=2304. No overflow. */
fn pf_mul(a, b) = (
  pf_reconstruct(
    (a%8)*(b%8)%8, (a%9)*(b%9)%9, (a%25)*(b%25)%25,
    (a%49)*(b%49)%49, (a%11)*(b%11)%11, (a%13)*(b%13)%13)
)

/* Ring add (simple mod) */
fn pf_add(a, b) = (a + b) % N_TRUE

/* Modular exponentiation: base^exp mod m (for small moduli) */
fn powmod_pf(base, exp, m) = (
  mut r = 1; mut bp = base % m; mut e = exp;
  while e > 0 do (
    if e % 2 == 1 then mut r = r * bp % m else 0;
    mut bp = bp * bp % m;
    mut e = e / 2
  );
  r
)

/* Theorem summary card with PASS/FAIL indicator. pass=checks passed, total=checks expected. */
fn pf_theorem(parent, title:str, detail:str, pass, total) = (
  let card = dom_create("div") in
  ct_card(card);
  dom_style(card, "marginBottom", "16px");
  let ok = if pass == total then 1 else 0 in
  dom_style(card, "borderLeft", if ok == 1 then "3px solid #44cc44" else "3px solid #cc4444");
  let st = dom_create("span") in
  dom_text(st, if ok == 1 then "PASS  " else "FAIL  ");
  dom_style(st, "color", if ok == 1 then "#44cc44" else "#cc4444");
  dom_style(st, "fontFamily", "Courier New, monospace");
  dom_style(st, "fontWeight", "bold");
  dom_append(card, st);
  let cnt = dom_create("span") in
  dom_text(cnt, "${pass}/${total}  ");
  dom_style(cnt, "color", "#888");
  dom_style(cnt, "fontFamily", "Courier New, monospace");
  dom_style(cnt, "fontSize", "13px");
  dom_append(card, cnt);
  let t = dom_create("div") in
  dom_text(t, title);
  ct_gold(t);
  dom_style(t, "fontSize", "14px");
  dom_style(t, "textTransform", "uppercase");
  dom_style(t, "letterSpacing", "2px");
  dom_style(t, "marginTop", "6px");
  dom_style(t, "marginBottom", "8px");
  dom_append(card, t);
  let bd = dom_create("div") in
  dom_text(bd, detail);
  dom_style(bd, "color", "#a0a0b0");
  dom_style(bd, "fontSize", "13px");
  dom_style(bd, "lineHeight", "1.6");
  dom_append(card, bd);
  dom_append(parent, card)
)

/* pf_result: count only, no DOM render. Computation runs in caller.
   pf_theorem (below) renders the visible summary card per theorem. */
fn pf_result(parent, title:str, detail:str, ok) = (
  set(_pf_total, 0, _pf_total[0] + 1);
  if ok == 1 then set(_pf_pass, 0, _pf_pass[0] + 1) else 0
)

/* Modular multiply avoiding i32 overflow (for moduli > sqrt(2^31)) */
fn mulmod_big(a, b, m) = (
  mut r = 0; mut aa = a % m; mut bb = b;
  while bb > 0 do (
    if bb % 2 == 1 then mut r = (r + aa) % m else 0;
    mut aa = (aa + aa) % m;
    mut bb = bb / 2
  );
  r
)

/* Modular exponentiation using mulmod_big (safe for large moduli) */
fn powmod_big(base, exp, m) = (
  mut r = 1; mut bp = base % m; mut e = exp;
  while e > 0 do (
    if e % 2 == 1 then mut r = mulmod_big(r, bp, m) else 0;
    mut bp = mulmod_big(bp, bp, m);
    mut e = e / 2
  );
  r
)

/* Count involutions (x^2 = 1) in Z/m (exhaustive). Small m only. */
fn pf_count_invol(m) = (
  mut c = 0; mut i = 0;
  while i < m do (
    if (i * i) % m == 1 then mut c = c + 1 else 0;
    mut i = i + 1
  );
  c
)

/* Standard genetic code: codon (n1,n2,n3) -> AA index 0-19 or 20=stop */
fn pf_codon_aa(n1, n2, n3) = (
  if n1 == 0 then (
    if n2 == 0 then (if n3 == 0 then 13 else if n3 == 1 then 12 else if n3 == 2 then 13 else 12)
    else if n2 == 1 then 7
    else if n2 == 2 then (if n3 == 0 then 18 else if n3 == 1 then 5 else if n3 == 2 then 18 else 5)
    else (if n3 == 0 then 2 else if n3 == 1 then 2 else if n3 == 2 then 3 else 2))
  else if n1 == 1 then (
    if n2 == 0 then (if n3 == 0 then 11 else if n3 == 1 then 10 else if n3 == 2 then 11 else 10)
    else if n2 == 1 then 6 else if n2 == 2 then 18 else 1)
  else if n1 == 2 then (
    if n2 == 0 then (if n3 == 0 then 15 else if n3 == 1 then 14 else if n3 == 2 then 15 else 14)
    else if n2 == 1 then 8 else if n2 == 2 then 19 else 4)
  else (
    if n2 == 0 then (if n3 == 0 then 20 else if n3 == 1 then 9 else if n3 == 2 then 20 else 9)
    else if n2 == 1 then 5
    else if n2 == 2 then (if n3 == 0 then 20 else if n3 == 1 then 16 else if n3 == 2 then 17 else 16)
    else (if n3 == 0 then 1 else if n3 == 1 then 0 else if n3 == 2 then 1 else 0))
)

/* Count nonzero zero-product pairs in Z/m: a>0, b>0, (a*b)%m==0 (exhaustive) */
fn pf_nzp(m) = (
  mut c = 0; mut a = 1;
  while a < m do (
    mut bj = 1;
    while bj < m do (
      if (a * bj) % m == 0 then mut c = c + 1 else 0;
      mut bj = bj + 1
    );
    mut a = a + 1
  );
  c
)

/* Trial division primality for small n */
fn pf_is_prime(n) = (
  if n < 2 then 0
  else if n < 4 then 1
  else if n % 2 == 0 then 0
  else (
    mut d = 3; mut ok = 1;
    while d * d <= n do (
      if n % d == 0 then (mut ok = 0; mut d = n)
      else mut d = d + 2
    );
    ok
  )
)

/* Check if n >= 1 is a power of 2 */
fn pf_is_pow2(n) = (
  if n <= 0 then 0
  else (
    mut x = n; mut bad = 0;
    while x > 1 do (
      if x % 2 != 0 then (mut bad = 1; mut x = 1)
      else mut x = x / 2
    );
    if bad == 1 then 0 else 1
  )
)

/* Cyclotomic Phi_p(x) for prime p: x^{p-1}+x^{p-2}+...+1 = (x^p-1)/(x-1) */
fn pf_phi_prime(x, p) = (
  mut s = 0; mut pw = 1; mut i = 0;
  while i < p do (
    mut s = s + pw;
    mut pw = pw * x;
    mut i = i + 1
  );
  s
)

/* Count primes p in [lo,hi] where E*b = 1 mod p */
fn pf_finality_scan(lo, hi) = (
  mut count = 0; mut p = lo;
  while p <= hi do (
    if pf_is_prime(p) == 1 then (
      if (E * b) % p == 1 then mut count = count + 1 else 0
    ) else 0;
    mut p = p + 1
  );
  count
)

/* Check if n is 7-smooth (all prime factors in {2,3,5,7}) */
fn pf_is_smooth(n) = (
  if n <= 1 then 1
  else (
    mut x = n;
    while x % 2 == 0 do mut x = x / 2;
    while x % 3 == 0 do mut x = x / 3;
    while x % 5 == 0 do mut x = x / 5;
    while x % 7 == 0 do mut x = x / 7;
    if x == 1 then 1 else 0
  )
)

/* Check if n is axiom-smooth (all prime factors in {2,3,5,7,11,13,17}) */
fn pf_is_axiom_smooth(n) = (
  if n <= 1 then 1
  else (
    mut x = n;
    while x % 2 == 0 do mut x = x / 2;
    while x % 3 == 0 do mut x = x / 3;
    while x % 5 == 0 do mut x = x / 5;
    while x % 7 == 0 do mut x = x / 7;
    while x % 11 == 0 do mut x = x / 11;
    while x % 13 == 0 do mut x = x / 13;
    while x % 17 == 0 do mut x = x / 17;
    if x == 1 then 1 else 0
  )
)

/* Count units x in Z/m with x^d = 1 (brute force, small m) */
fn pf_count_xd1(m, d) = (
  mut c = 0; mut x = 1;
  while x < m do (
    if powmod_pf(x, d, m) == 1 then mut c = c + 1 else 0;
    mut x = x + 1
  );
  c
)

/* Cunningham map c(n) = 2n+1 */
fn pf_cunn(n) = 2 * n + 1

/* LCM */
fn pf_lcm(a, b) = a / gcd_shared(a, b) * b

/* Carmichael lambda for prime power p^k */
fn pf_lambda_pk(p, k) = (
  if k == 0 then 1
  else if p == 2 then (
    if k == 1 then 1
    else if k == 2 then 2
    else powmod_pf(2, k - 2, 1000000000)
  )
  else (
    mut r = p - 1; mut i = 1;
    while i < k do (mut r = r * p; mut i = i + 1);
    r
  )
)

/* Euler phi for prime power p^k */
fn pf_phi_pk(p, k) = (
  if k == 0 then 1
  else (
    mut r = p - 1; mut i = 1;
    while i < k do (mut r = r * p; mut i = i + 1);
    r
  )
)

/* Multiplicative order of a mod m */
fn pf_ord(a, m) = (
  if gcd_shared(a, m) > 1 then 0
  else (
    mut k = 1; mut p = a % m;
    while p > 1 do (
      mut p = p * a % m;
      mut k = k + 1
    );
    k
  )
)

/* Class number h(-d) for imaginary quadratic field Q(sqrt(-d)).
   Counts reduced positive definite binary quadratic forms of discriminant -d. */
fn pf_class_number(d) = (
  mut h = 0
  mut a = 1
  while a * a * 3 <= d do (
    mut bb = 0
    while bb <= a do (
      let t = bb * bb + d in
      if t % (4 * a) == 0 then (
        let c = t / (4 * a) in
        if c >= a then (
          mut h = h + 1;
          if bb > 0 then (
            if bb < a then (
              if c > a then mut h = h + 1 else 0
            ) else 0
          ) else 0
        ) else 0
      ) else 0;
      mut bb = bb + 1
    );
    mut a = a + 1
  );
  h
)

/* Is d such that -d is a fundamental discriminant? */
fn pf_is_sqfree(n) = (
  mut i = 2
  mut ok = 1
  while i * i <= n do (
    if n % (i * i) == 0 then (mut ok = 0; mut i = n)
    else mut i = i + 1
  );
  ok
)

fn pf_is_fund(d) = (
  if d <= 0 then 0
  else if d % 4 == 3 then pf_is_sqfree(d)
  else if d % 8 == 4 then pf_is_sqfree(d / 4)
  else if d % 4 == 0 then (
    let q = d / 4 in
    if q % 4 == 2 then pf_is_sqfree(q)
    else if q % 4 == 3 then pf_is_sqfree(q)
    else 0
  )
  else 0
)
