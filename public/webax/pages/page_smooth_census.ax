/* Smooth checker callback: trial divide by {2,3,5,7,11} */
fn sm_check() = (
  let n = parse_int_from("#sm-input") in
  let result = dom_query("#sm-result") in
  if n < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 2.</p>")
  else (
    mut v = n;
    mut e2 = 0;
    while v % 2 == 0 do (mut v = v / 2; mut e2 = e2 + 1);
    mut e3 = 0;
    while v % 3 == 0 do (mut v = v / 3; mut e3 = e3 + 1);
    mut e5 = 0;
    while v % 5 == 0 do (mut v = v / 5; mut e5 = e5 + 1);
    mut e7 = 0;
    while v % 7 == 0 do (mut v = v / 7; mut e7 = e7 + 1);
    mut e11 = 0;
    while v % 11 == 0 do (mut v = v / 11; mut e11 = e11 + 1);
    let smooth = if v == 1 then 1 else 0 in
    /* Build factorization string */
    let f2 = if e2 > 0 then "2^" + "${e2}" else "" in
    let f3 = if e3 > 0 then (if e2 > 0 then " * " else "") + "3^" + "${e3}" else "" in
    let f5 = if e5 > 0 then (if e2 + e3 > 0 then " * " else "") + "5^" + "${e5}" else "" in
    let f7 = if e7 > 0 then (if e2 + e3 + e5 > 0 then " * " else "") + "7^" + "${e7}" else "" in
    let f11 = if e11 > 0 then (if e2 + e3 + e5 + e7 > 0 then " * " else "") + "11^" + "${e11}" else "" in
    let rem = if v > 1 then (if e2 + e3 + e5 + e7 + e11 > 0 then " * " else "") + "<span style='color:#ff6666'>" + "${v}" + "</span>" else "" in
    let fstr = f2 + f3 + f5 + f7 + f11 + rem in
    let verd = if smooth > 0 then "<span style='color:#88ddaa'>11-SMOOTH</span>" else "<span style='color:#ff6666'>NOT SMOOTH</span> (cofactor " + "${v}" + ")" in
    let note = if n == 13 then " -- first prime beyond {2,3,5,7,11}."
      else if n == 42 then " = 2*3*7. Smooth."
      else if n == 420 then " = 2^2*3*5*7. The Carmichael lambda of Z/12,612,600."
      else if n == 2310 then " = 2*3*5*7*11. Product of the first five primes."
      else if n == 108 then " = 2^2*3^3. Smooth."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>" + "${n}" + " = " + fstr + "</p><p style='margin:4px 0'>" + verd + note + "</p>")
  )
)

fn page_smooth_census() = (
  dom_head_meta("description", "13 is the universal boundary of 11-smoothness. Every binomial C(n,k) for n <= 12 is 11-smooth. Seven classical sequences confirm: 13 is the wall. Run lengths: 5, 6, 8, 11, 12.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Smooth Census\",\"description\":\"13 is the universal boundary of 11-smoothness. Seven independent sequences, one wall. Binomial coefficients smooth for n <= 12.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/smooth_census\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"smooth numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"11-smooth\"},{\"@type\":\"DefinedTerm\",\"name\":\"prime factorization\"}]}");
  /* === HERO === */
  let hero = make_hero("The Smooth Census") in
  let big = dom_create("div") in
  dom_text(big, "run(k) = 13 - k");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "An integer is 11-smooth if its only prime factors come from {2, 3, 5, 7, 11}. For n <= 12, every binomial coefficient C(n,k) is 11-smooth. At n = 13, the prime 13 enters every C(13,k) for 0 < k < 13. Seven independent classical sequences confirm the same boundary: 13 is the universal wall.");
  dom_append(dom_body(), hero);

  /* === SEC 1: BINOMIAL SMOOTH THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Binomial Smooth Theorem");
  render_p(sec1, "For n <= 12, the factorial n! contains only primes <= 11. So C(n,k) = n!/(k!(n-k)!) is a ratio of 11-smooth numbers, hence 11-smooth. At n = 13, the prime 13 enters 13! and divides C(13,k) for all 0 < k < 13 (by Lucas theorem: 13 is prime, so 13 | C(13,k)).");
  render_theorem(sec1, "Binomial Smooth Theorem (PROVED)", "C(n,k) is 11-smooth for all k <= n <= 12. At n = 13, every C(13,k) = 13 * (smooth number). The smooth run length at depth k is run(k) = 13 - k.");
  let btbl = make_table(sec1) in
  let bhdr = dom_create("tr") in
  render_th(bhdr, "k");
  render_th(bhdr, "Run = 13-k");
  render_th(bhdr, "C(13,k)/13");
  dom_append(btbl, bhdr);
  render_table_row(btbl, "1", "12", "1");
  render_table_row(btbl, "2", "11", "6 = 2*3");
  render_table_row(btbl, "3", "10", "22 = 2*11");
  render_table_row(btbl, "4", "9", "55 = 5*11");
  render_table_row(btbl, "5", "8", "99 = 9*11");
  render_table_row(btbl, "6", "7", "132 = 4*3*11");
  render_table_row(btbl, "7", "6", "132 = 4*3*11");
  render_table_row(btbl, "8", "5", "99 = 9*11");
  render_table_row(btbl, "9", "4", "55 = 5*11");
  render_table_row(btbl, "10", "3", "22 = 2*11");
  render_table_row(btbl, "11", "2", "6 = 2*3");
  render_table_row(btbl, "12", "1", "1");
  render_p(sec1, "Run lengths are {12, 11, 10, ..., 1}. The quotients C(13,k)/13 form a palindrome: {1, 6, 22, 55, 99, 132, 132, 99, 55, 22, 6, 1}. Every quotient is 11-smooth. Pascal's triangle is smooth below row 13.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: INDEPENDENT SMOOTH CENSUS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Independent Smooth Census");
  render_p(sec2, "Classical sequences whose smooth runs are independent of binomial coefficients. Each has an initial 11-smooth run, then 13 appears:");
  let ctbl = make_table(sec2) in
  let chdr = dom_create("tr") in
  render_th(chdr, "Sequence");
  render_th(chdr, "Smooth run");
  render_th(chdr, "First non-smooth");
  dom_append(ctbl, chdr);
  render_table_row(ctbl, "Bernoulli denom B_2n", "5", "denom(B_12) = 2730 = 2*3*5*7*13");
  render_table_row(ctbl, "Fibonacci F(n)", "6", "F(7) = 13");
  render_table_row(ctbl, "Catalan C_n", "6", "C_7 = 429 = 3*11*13");
  render_table_row(ctbl, "Sum of divisors sigma(n)", "8", "sigma(9) = 1+3+9 = 13");
  render_table_row(ctbl, "Triangle T(n)", "11", "T(12) = 78 = 2*3*13");
  render_table_row(ctbl, "Partition p(n)", "12", "p(13) = 101 (prime > 11)");
  render_table_row(ctbl, "Bell B(n)", "5", "B(5) = 52 = 4*13");
  render_p(sec2, "In 6 of 7 sequences, 13 appears in the blocking value itself. In partitions, 13 is the blocking position: p(13) = 101 is the first non-smooth partition number.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: HOW 13 ENTERS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "How 13 Enters Each Sequence");
  render_p(sec3, "Each entry mechanism is independent. Divisor sums, recurrences, combinatorial products, von Staudt-Clausen -- all different mathematics, same wall.");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "sigma(9) = 13", "Sum of divisors", "1 + 3 + 9 = 13. The divisors of 9 = 3^2 sum to exactly 13.", "");
  render_finding(g3, "F(7) = 13", "Fibonacci", "The 7th Fibonacci number is 13. Cumulative addition: 1, 1, 2, 3, 5, 8, 13.", "");
  render_finding(g3, "B(5) = 52", "Bell numbers", "52 = 4 * 13. The 5th Bell number contains 13 as a factor.", "");
  render_finding(g3, "p(13) = 101", "Partitions", "The 13th partition number is 101, a prime larger than 11.", "");
  dom_append(dom_body(), sec3);

  /* === SEC 4: THE SMOOTH LADDER === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Smooth Ladder");
  render_p(sec4, "Ordering by run length, the sequences form a ladder from 5 to 12. The distinct run lengths are {5, 6, 8, 11, 12}. Gaps between rungs: 1, 2, 3, 1.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Run = 5", "Bernoulli, Bell", "Two sequences share this rung.", "");
  render_finding(g4, "Run = 6", "Fibonacci, Catalan", "F(7) = 13 directly; C_7 = 429 = 3*11*13.", "");
  render_finding(g4, "Run = 8", "sigma(n)", "The divisor sum function.", "");
  render_finding(g4, "Run = 11", "Triangle numbers", "T(n) = C(n+1,2) is a binomial coefficient.", "");
  render_finding(g4, "Run = 12", "Partition function", "13 is the blocking position, not value.", "");
  render_finding_wide(g4, "Combined", "All integers 1..12 appear as run lengths", "The binomial theorem contributes every value 1..12. The seven sequences sample 5 distinct rungs from that range.", "");
  dom_append(dom_body(), sec4);

  /* === INTERACTIVE: SMOOTH CHECKER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Smooth Checker");
  render_p(sec_i, "Enter any positive integer. See its factorization into {2, 3, 5, 7, 11} and whether it is 11-smooth.");
  make_interactive_widget(sec_i, "Check smoothness of n:", "sm-input", "e.g. 2310", "Check", "sm_check", "sm-result");
  render_p(sec_i, "Try: 13 (first non-smooth prime), 42, 420, 2310 = 2*3*5*7*11, 970200, 12612600.");
  dom_append(dom_body(), sec_i);

  /* === SEC 6: CRT SMOOTH PROJECTION (THM 130) === */
  let sec_proj = make_section("800px") in
  render_h2(sec_proj, "CRT Smooth Projection");
  render_p(sec_proj, "Which CRT channels can contain non-smooth residues? Only the fat channels Z/25 (E^2) and Z/49 (b^2). Every residue in Z/8, Z/9, Z/11, Z/13, and Z/17 is 11-smooth -- all moduli are themselves smooth. The fat channels are the ONLY place intruder primes can appear.");
  render_theorem(sec_proj, "CRT Smooth Projection (PROVED)", "Only fat channels Z/25 and Z/49 contain non-axiom-smooth residues. E-channel: 2 intruders {f(5) = 19, c(11) = 23}. b-channel: 10 non-smooth values (8 intruder primes + 2 composites). CRT-smooth fraction = 897/1225 = c(11)*3*13 / (25*49). Intruder product: 19*23 = 437 = lambda + ESCAPE. ADDRESS = 137 projects to chain elements: mod 30 = ESCAPE, mod 42 = L, mod 70 = SOUL. KEY = 41 is NOT CRT-smooth (b-channel intruder).");
  let gp = make_findings_grid(sec_proj) in
  render_finding(gp, "E-channel: 2 intruders", "{f(5) = 19, c(11) = 23}", "The depth quadratic and Cunningham map produce the only non-smooth residues in Z/25. 23 out of 25 residues are smooth.", "");
  render_finding(gp, "b-channel: 10 intruders", "8 primes + 2 composites in Z/49", "8 primes > 17: {19, 23, 29, 31, 37, 41, 43, 47}. 2 composites: {38=2*19, 46=2*23}. 39 out of 49 residues are axiom-smooth.", "");
  render_finding(gp, "897/1225 smooth", "= 73.2%", "CRT-smooth fraction: 23*39 / (25*49). The numerator 897 = c(11)*3*13 is itself axiom-smooth.", "");
  render_finding(gp, "ADDRESS projects", "137 mod 30 = 17, mod 42 = 11, mod 70 = 67", "The prime 137 projects to ESCAPE, L, and SOUL through three chain-based moduli. Bookend: 137 mod 2 = 137 mod 17 = 1.", "");
  dom_append(dom_body(), sec_proj);

  /* === SEC 5: CONTRAST === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Contrast");
  let ctbl5 = make_table(sec5) in
  let ch5 = dom_create("tr") in
  render_th(ch5, "Aspect");
  render_th(ch5, "Standard view");
  render_th(ch5, "Ring structure");
  dom_append(ctbl5, ch5);
  render_contrast_row(ctbl5, "Smooth runs", "Scattered counts: 5, 6, 8, 11, 12", "All five run lengths are chain primes or their products: 5, 6=2*3, 8=2^3, 11, 12=4*3");
  render_contrast_row(ctbl5, "Blocker", "13 is the next prime after 11", "13 = 2^2 + 3^2, where {2,3,5,7,11} generate the ring Z/2,310");
  render_contrast_row(ctbl5, "Entry pattern", "Each sequence has its own mechanism", "All mechanisms hit 13. Pascal row 13 assigns run lengths 12 down to 1");
  render_contrast_row(ctbl5, "Ladder gaps", "1, 2, 3, 1 -- small integers", "Gaps 1, 2, 3, 1 -- only the three smallest positive integers appear");
  dom_append(dom_body(), sec5)
)
