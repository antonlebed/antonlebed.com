/* Homepage axiom summary (S1429 TT47). Every piece of the axiom visible
   from the front door: Decality + 7 micros + 3 macros + ring chain +
   lattice invariants. Compact but comprehensive. Lives here (home-module
   only) rather than core.ax (shared) to avoid carrying into 6 unrelated
   modules. Called from page_home() in core.ax. */
fn home_axiom() = (
  /* --- DECALITY --- */
  let sec1 = make_section("900px") in
  render_h2(sec1, "The Decality");
  render_p(sec1, "Ten terms = 3 macros + 7 micros = K + b = 10. Ten towers precipitate from 0/0. Three macros (Tower A fat, Tower B void skeleton, Tower C heartbeat) converge at TRANS = 214,414,200. Seven micros raise each axiom prime to its Pareto top; their CRT product is the same TRANS. One ring, two decompositions.");

  let dec = dom_create("div") in
  dom_text(dec, "-1  .  o  .  sigma  .  D  .  K  .  E  .  b  .  L  .  13  .  OMEGA");
  ct_mono(dec);
  ct_gold(dec);
  dom_style(dec, "fontSize", "clamp(13px, 3.2vw, 16px)");
  dom_style(dec, "letterSpacing", "1px");
  dom_style(dec, "textAlign", "center");
  dom_style(dec, "padding", "18px 8px");
  dom_style(dec, "wordBreak", "break-word");
  dom_append(sec1, dec);

  render_p(sec1, "-1 = mirror. o = void (0). sigma = identity (1). D..13 = six ring primes (2, 3, 5, 7, 11, 13). OMEGA = D^420 = 1,576,576 = terminal D-projector (D-channel dies at OMEGA; all others persist). Sum of the six TRUE primes = 41 = KEY. Product D*K*b = 42 = ANSWER. The axiom closes on its own vocabulary.");
  dom_append(dom_body(), sec1);

  /* --- SEVEN MICRO TOWERS --- */
  let sec2 = make_section("900px") in
  render_h2(sec2, "Seven Micro Towers");
  render_p(sec2, "One tower per axiom prime. Each climbs to its Pareto-optimal exponent (S1331, 1080-ring exponent sweep). Tower_D alone reaches depth 3 -- Z/8 has four involutions {1, 3, 5, 7}, the only axiom prime-power with more than two.");
  let mt = make_table(sec2) in
  let mh = dom_create("tr") in
  render_th(mh, "Prime");
  render_th(mh, "Role");
  render_th(mh, "Pareto top");
  render_th(mh, "Depth");
  dom_append(mt, mh);
  render_table_row_4(mt, "D = 2", "Bridge / duality", "D^3 = 8", "3");
  render_table_row_4(mt, "K = 3", "Closure / triangle", "K^2 = 9", "2");
  render_table_row_4(mt, "E = 5", "Observer (self-blind)", "E^2 = 25", "2");
  render_table_row_4(mt, "b = 7", "Depth / spectrum", "b^2 = 49", "2");
  render_table_row_4(mt, "L = 11", "Protector / ECC (Error Correcting Code)", "L = 11", "1");
  render_table_row_4(mt, "GATE = 13", "Skin / boundary", "GATE = 13", "1");
  render_table_row_4(mt, "ESCAPE = 17", "Escape (E*b = 1 mod 17)", "ESCAPE = 17", "1");
  render_p(sec2, "CRT product of the seven tops: 8 * 9 * 25 * 49 * 11 * 13 * 17 = 214,414,200 = TRANS. Three budgets: sum(Pareto exponents) = 12 = lambda(DATA) = heartbeat budget. Sum beyond primorial = 5 = E = observation budget. Max cells 7 * 7 = 49 = b^2 = depth-squared ceiling.");
  dom_append(dom_body(), sec2);

  /* --- THREE MACROS + RING CHAIN --- */
  let sec3 = make_section("900px") in
  render_h2(sec3, "Three Macro Towers + Ring Chain");
  render_p(sec3, "Tower A (fat) climbs the Pareto-optimal ring ladder. Tower B (thin) builds the void skeleton -- at each level a new axiom prime maps to zero in its own CRT channel. Tower C (heartbeat) = 420 x Tower B. All three summit at TRANS. Short exact sequence: 0 -> Z/420 -> Z/TRANS -> Z/510510 -> 0. The heartbeat IS the abelian extension between the void and the Pareto-fat summit.");
  let rt = make_table(sec3) in
  let rh = dom_create("tr") in
  render_th(rh, "Ring");
  render_th(rh, "N");
  render_th(rh, "Factorization");
  render_th(rh, "Role");
  dom_append(rt, rh);
  render_table_row_4(rt, "DATA", "210", "D*K*E*b", "4 data channels. DNA codons (Z/21 = K*b).");
  render_table_row_4(rt, "THIN", "2310", "D*K*E*b*L", "5-primorial. L enters. Teaching ring.");
  render_table_row_4(rt, "DEEP", "970200", "D^3*K^2*E^2*b^2*L", "First fat ring. Body without skin.");
  render_table_row_4(rt, "TRUE", "12612600", "DEEP * GATE", "The organism. 6 channels. 64 idempotents. lambda = 420.");
  render_table_row_4(rt, "TRANS", "214414200", "TRUE * ESCAPE", "Transcendence. 7 channels. 128 idempotents. lambda = 1680 = D^2 * 420.");
  render_p(sec3, "DEEP = minimum UNIFORM ring (smallest N where inner axiom elements look the same in every CRT channel; requires p^e >= D^3 = 8). TRUE = DEEP with skin (GATE wraps the organism). TRANS = TRANSCENDENT: it TRANSCENDS the structure by adding the ESCAPE prime (17) as a seventh channel. ESCAPE is the 'escape' because E * b = 1 mod 17 -- suffering times observation dissolves to unity in that channel, the only prime past GATE where this happens. With ESCAPE live, the triple-parity ECC (L + GATE + ESCAPE) becomes available: rate 4/7, 100% known-location correction. Self-referential closure at TRANS: 7 CRT channels = b = 7 depth prime = 7 micro towers. The channel count IS the depth prime IS the number of micros. The structure transcends itself by matching its own count. (The axiom's self-maps -- Cunningham c(n)=2n+1, depth quadratic f(x)=x^2-x-1, convergence D^2+K^2=13 -- generate exactly 8 intruder primes {13,17,19,23,31,37,41,47}; past 47 is the Universal Boundary where even the self-maps close.)");
  dom_append(dom_body(), sec3);

  /* --- LATTICE INVARIANTS --- */
  let sec4 = make_section("900px") in
  render_h2(sec4, "The Heartbeat Lattice");
  render_p(sec4, "The lambda-420 fiber of Tower C. Every ring in the fiber shares one pulse.");
  let g = make_findings_grid(sec4) in
  render_finding(g, "lambda = 420", "D^2*K*E*b (pulse)", "Universal heartbeat. Every power map in the ring cycles in at most 420 steps. Born at chain level 5 where b = 7 enters.", "");
  render_finding(g, "108 = D^2*K^3", "lambda-420 rings", "Rings with lambda = 420 EXACTLY (b^2 = 49 forced; without it lcm caps at 60). 84 = D^2*K*b divide TRUE; 24 = D^4 extensions reach 2*TRUE = 25,225,200.", "stdlib/lattice.ax");
  render_finding(g, "490 = D*E*b^2", "holographic cleave", "Splits the 7 primes into DEAD = {D, E, b} (inner; die at OMEGA) and ALIVE = {K, L, GATE} (+ESCAPE at TRANS). 3 + 3 = 6 in TRUE; 3 + 4 = 7 = b in TRANS.", "");
  render_finding(g, "432 = D^4*K^3", "TRUE divisor count", "Total divisors of TRUE = 12,612,600. Of these, 84 have lambda = 420 (heartbeat siblings). The other 348 have lambda | 420 but lambda < 420 (sub-rhythms).", "");
  render_finding(g, "64 / 128", "idempotents", "TRUE has 2^6 = 64 idempotents (one per subset of its 6 CRT channels). TRANS has 2^7 = 128. Each idempotent projects onto a sub-channel combination.", "");
  render_finding(g, "12 / 5 / 49", "three budgets", "Heartbeat: sum of Pareto exponents across the 7 micros (3+2+2+2+1+1+1) = 12 = lambda(DATA). Observation: sum of fattening beyond primorial (2+1+1+1+0+0+0) = 5 = E. Depth-squared ceiling: 7 micros * 7 = 49 = b^2.", "");
  dom_append(dom_body(), sec4)
)

/* ================================================================
   HOME -- cross-tower. All 7 rings visible from the front door.
   Hero = sigma (void -> structure). Axiom summary = home_axiom().
   Grid = b=7 ring ladder (2 rows of K=3 + 1 full-width ESCAPE bar = b=7).
   Lives in pages_core.ax (home-only) instead of core.ax (shared).
   ================================================================ */
fn page_home() = (
  dom_head_meta("description", "0/0 = Z/214414200Z, the T^7 torus of 7 CRT circles. Ten towers precipitate from the void: 3 macros + 7 micros. 108 sub-rings tile the lambda=420 landscape. DATA -> THIN -> DEEP -> TRUE -> TRANS. ~1920 proved theorems. Self-compiling .ax.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"antonlebed.com\",\"url\":\"https://antonlebed.com\",\"description\":\"0/0 = Z/214414200Z. Seven primes structure everything that repeats. 181 pages of proved theorems, interactive demos, and live .ax code. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://antonlebed.com/deep/{search_term_string}\",\"query-input\":\"required name=search_term_string\"}}");
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(64px, 12vw, 100px) clamp(12px, 4vw, 24px) 40px");
  let h1 = dom_create("h1") in
  dom_text(h1, "0 / 0");
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.6em, 6vw, 3em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "letterSpacing", "clamp(1px, 0.5vw, 4px)");
  dom_append(hero, h1);
  let sub = dom_create("div") in
  dom_text(sub, "= Z / 214414200 Z");
  ct_mono(sub);
  dom_style(sub, "fontSize", "16px");
  dom_style(sub, "color", "#b0b0c0");
  dom_style(sub, "marginTop", "12px");
  dom_append(hero, sub);
  /* TO.7 (S1445): torus reading of the cover. T^7 = S^1(D^3) x S^1(K^2) x S^1(E^2) x S^1(b^2) x S^1(L) x S^1(GATE) x S^1(ESCAPE) = 8*9*25*49*11*13*17 = 214414200. Phase OMEGA, GH.2 (S1437): T^7 IS the Gabriel-Horn cap of Z^7. */
  let trs = dom_create("div") in
  dom_text(trs, "T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17)");
  ct_mono(trs);
  dom_style(trs, "fontSize", "13px");
  dom_style(trs, "color", "#9090a0");
  dom_style(trs, "marginTop", "6px");
  dom_style(trs, "lineHeight", "1.5");
  dom_append(hero, trs);
  render_p(hero, "Nothing divided by nothing is everything. Ten towers precipitate -- three macros, seven micros -- and converge at one ring. Z/7 orders them all; 108 sub-rings tile the lambda=420 landscape.");
  dom_append(dom_body(), hero);

  home_axiom();

  let sec = make_section("900px") in
  let g = dom_create("div") in
  dom_attr(g, "class", "idx-grid");
  dom_style(g, "display", "grid");
  dom_style(g, "gridTemplateColumns", "1fr 1fr 1fr");
  dom_style(g, "gap", "16px");
  dom_style(g, "margin", "0 0 32px");
  dom_style(g, "width", "100%");
  render_explore_link(g, "/basics", "Basics", "Z/6 -- First encounter. What is this?");
  render_explore_link(g, "/structure", "Structure", "Z/30 -- See patterns. Algebra, spectrum, music.");
  render_explore_link(g, "/data", "Data", "Z/210 -- The axiom maps to reality.");
  render_explore_link(g, "/teach", "Teach", "Z/2310 -- Check the math.");
  render_explore_link(g, "/deep", "Deep", "Z/970200 -- First fat ring. Kingdoms.");
  render_explore_link(g, "/living", "Living", "Z/12612600 -- Build with it.");
  /* 7th section: Demos = ESCAPE ring. Full-width bar spans grid. */
  let dbar = dom_create("a") in
  dom_attr(dbar, "href", "/demos");
  dom_style(dbar, "gridColumn", "1 / -1");
  dom_style(dbar, "display", "block");
  dom_style(dbar, "padding", "16px 20px");
  dom_style(dbar, "borderRadius", "10px");
  dom_style(dbar, "textDecoration", "none");
  dom_style(dbar, "textAlign", "center");
  dom_style(dbar, "background", "linear-gradient(90deg, #1a0a2f 0%, #2a1a4f 50%, #1a0a2f 100%)");
  dom_style(dbar, "border", "1px solid #6633aa");
  let dt = dom_create("div") in
  dom_text(dt, "Demos \u00B7 Z/214414200");
  dom_style(dt, "color", "#cc88ff");
  dom_style(dt, "fontWeight", "bold");
  dom_style(dt, "fontSize", "15px");
  dom_append(dbar, dt);
  let dd2 = dom_create("div") in
  dom_text(dd2, "40 CC0 demos. The virus that spreads the axiom.");
  dom_style(dd2, "color", "#8866bb");
  dom_style(dd2, "fontSize", "13px");
  dom_style(dd2, "marginTop", "4px");
  dom_append(dbar, dd2);
  dom_append(g, dbar);
  dom_append(sec, g);
  dom_append(dom_body(), sec)
)

/* Worldview: CRT decomposer -- enter any number, see CRT in TRANS ring Z/214414200 */
fn worldview_crt_calc() = (
  let n = parse_int_from("#wv-input") in
  let result = dom_query("#wv-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let m = n % N_TRANS in
    let r2 = m % 8 in
    let r3 = m % 9 in
    let r5 = m % 25 in
    let r7 = m % 49 in
    let r11 = m % 11 in
    let r13 = m % 13 in
    let r17 = m % 17 in
    let g = gcd_shared(m, N_TRANS) in
    let coupling = if g > 0 then N_TRANS / g else N_TRANS in
    let named = if m == 0 then "VOID: 0*n = 0. Total ambiguity."
      else if m == 1 then "SIGMA: identity. sigma*n = n."
      else if m == OMEGA_TRANS then "OMEGA: terminal projector. D^420. CRT=(0,1,1,1,1,1,1)."
      else if m == 214414199 then "MIRROR: -1 = N-1."
      else if m == 41 then "KEY: self-inverse. Sum of decality."
      else if m == 42 then "ANSWER: D*K*b. The rainbow angle."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${m} mod 214414200</p><p style='margin:4px 0'>CRT = (<b style='color:#ffd700'>${r2}</b>, <b style='color:#ff9900'>${r3}</b>, <b style='color:#33dd55'>${r5}</b>, <b style='color:#4488ff'>${r7}</b>, <b style='color:#aa44ff'>${r11}</b>, <b style='color:#ff4466'>${r13}</b>, <b style='color:#00dddd'>${r17}</b>) mod (8,9,25,49,11,13,17)</p><p style='margin:4px 0'>Coupling: ${coupling}</p><p style='margin:4px 0;color:#b8b8c8'>${named}</p>");
    /* Draw 7-channel bar chart -- colors match text above */
    let cvs = dom_query("#wv-chart") in
    let ctx = cvs_getctx(cvs) in
    let _cl = cvs_clearrect(ctx, 0, 0, 385, 100) in
    let h2 = r2 * 76 / 8 in
    let _s1 = cvs_fillstyle(ctx, "#ffd700") in
    let _d1 = cvs_fillrect(ctx, 14, 76 - h2, 36, h2) in
    let h3 = r3 * 76 / 9 in
    let _s2 = cvs_fillstyle(ctx, "#ff9900") in
    let _d2 = cvs_fillrect(ctx, 62, 76 - h3, 36, h3) in
    let h5 = r5 * 76 / 25 in
    let _s3 = cvs_fillstyle(ctx, "#33dd55") in
    let _d3 = cvs_fillrect(ctx, 110, 76 - h5, 36, h5) in
    let h7 = r7 * 76 / 49 in
    let _s4 = cvs_fillstyle(ctx, "#4488ff") in
    let _d4 = cvs_fillrect(ctx, 158, 76 - h7, 36, h7) in
    let h11 = r11 * 76 / 11 in
    let _s5 = cvs_fillstyle(ctx, "#aa44ff") in
    let _d5 = cvs_fillrect(ctx, 206, 76 - h11, 36, h11) in
    let h13 = r13 * 76 / 13 in
    let _s6 = cvs_fillstyle(ctx, "#ff4466") in
    let _d6 = cvs_fillrect(ctx, 254, 76 - h13, 36, h13) in
    let h17 = r17 * 76 / 17 in
    let _s7 = cvs_fillstyle(ctx, "#00dddd") in
    let _d7 = cvs_fillrect(ctx, 302, 76 - h17, 36, h17) in
    let _sf = cvs_fillstyle(ctx, "#888888") in
    let _t1 = cvs_filltext(ctx, "D", 26, 94) in
    let _t2 = cvs_filltext(ctx, "K", 74, 94) in
    let _t3 = cvs_filltext(ctx, "E", 122, 94) in
    let _t4 = cvs_filltext(ctx, "b", 170, 94) in
    let _t5 = cvs_filltext(ctx, "L", 218, 94) in
    let _t6 = cvs_filltext(ctx, "G", 266, 94) in
    let _t7 = cvs_filltext(ctx, "17", 310, 94) in
    0
  )
)

/* Derive: Cunningham chain stepper -- enter seed, walk c(n)=2n+1 */
fn derive_cunningham_calc() = (
  let seed = parse_int_from("#der-input") in
  let result = dom_query("#der-result") in
  if seed < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter seed >= 1.</p>")
  else (
    let c0 = seed in
    let c1 = 2 * c0 + 1 in
    let c2 = 2 * c1 + 1 in
    let c3 = 2 * c2 + 1 in
    let c4 = 2 * c3 + 1 in
    let c5 = 2 * c4 + 1 in
    let p0 = if is_prime_trial(c0) == 1 then "prime" else "composite" in
    let p1 = if is_prime_trial(c1) == 1 then "prime" else "composite" in
    let p2 = if is_prime_trial(c2) == 1 then "prime" else "composite" in
    let p3 = if is_prime_trial(c3) == 1 then "prime" else "composite" in
    let p4 = if is_prime_trial(c4) == 1 then "prime" else "composite" in
    let p5 = if is_prime_trial(c5) == 1 then "prime" else "composite" in
    dom_inner(result, "<p style='margin:2px 0;color:#d8d8e0'>c^0 = ${c0} (${p0})</p><p style='margin:2px 0;color:#d8d8e0'>c^1 = ${c1} (${p1})</p><p style='margin:2px 0;color:#d8d8e0'>c^2 = ${c2} (${p2})</p><p style='margin:2px 0;color:#d8d8e0'>c^3 = ${c3} (${p3})</p><p style='margin:2px 0;color:#d8d8e0'>c^4 = ${c4} (${p4})</p><p style='margin:2px 0;color:#d8d8e0'>c^5 = ${c5} (${p5})</p><p style='margin:4px 0;color:#b0b0c0'>Axiom chains: c(1)={1,3,7,15=STOP}. c(2)={2,5,11,23...}. Try both.</p>")
  )
)

/* Turbulence: balance factor calculator */
fn turbulence_balance_calc() = (
  let p = parse_int_from("#turb-input") in
  let result = dom_query("#turb-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter prime p >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else (
    let num = 2 * (p - 1) in
    let den = p + 1 in
    let g = gcd_shared(num, den) in
    let sn = num / g in
    let sd = den / g in
    let special = if p == 2 then "D: factor 2/3. First departure from balance."
      else if p == 3 then "K: factor 1 = TRANSPARENT. Closure preserves balance."
      else if p == 5 then "E: factor 4/3. Observer skews."
      else if p == 7 then "b: factor 3/2 = K/D. Depth."
      else if p == 11 then "L: factor 5/3 = KOLMOGOROV. Protection breaks balance."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Prime p = ${p}</p><p style='margin:4px 0'>Balance factor = 2(p-1)/(p+1) = ${num}/${den} = <b style='color:#ffd700'>${sn}/${sd}</b></p><p style='margin:4px 0;color:#b8b8c8'>${special}</p>")
  )
)

/* Sleep: channel lock stage identifier */
fn sleep_stage_calc() = (
  let stage = parse_int_from("#sleep-input") in
  let result = dom_query("#sleep-result") in
  if stage < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter stage (0-5).</p>")
  else if stage > 5 then dom_inner(result, "<p style='color:#ff6666'>Max stage = 5.</p>")
  else (
    let info = if stage == 0 then "AWAKE: All 7 channels active. Full coupling. GATE = skin. ESCAPE = transcendence."
      else if stage == 1 then "Stage N1: D=2 locks. Bridge down. Hypnagogia."
      else if stage == 2 then "Stage N2: K=3 locks. Closure down. Sleep spindles."
      else if stage == 3 then "Stage N3: E=5 locks. Observer down. Deep sleep. Positivity."
      else if stage == 4 then "Stage N4: b=7 locks. Depth down. Deepest non-REM."
      else "VOID: L=11 locks. Total silence. 1 class. All 8.17 bits recovered on waking." in
    let channels = if stage == 0 then "D K E b L G Esc = 7 active"
      else if stage == 1 then "_ K E b L G Esc = 6 active (GATE+ESCAPE hold)"
      else if stage == 2 then "_ _ E b L G Esc = 5 active (GATE+ESCAPE hold)"
      else if stage == 3 then "_ _ _ b L G Esc = 4 active (GATE+ESCAPE hold)"
      else if stage == 4 then "_ _ _ _ L G Esc = 3 active (GATE+ESCAPE hold)"
      else "_ _ _ _ _ G Esc = 2 active (boundary persists)" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Sleep stage ${stage}</p><p style='margin:4px 0;color:#ffd700'>${info}</p><p style='margin:4px 0;color:#b0b0c0'>Channels: ${channels}</p>")
  )
)

/* Kingdoms: coupling calculator -- enter n, show kingdom (S1305: 7 rings) */
fn kingdoms_coupling_calc() = (
  let n = parse_int_from("#king-input") in
  let result = dom_query("#king-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let d2 = if n % 2 == 0 then 1 else 0 in
    let d3 = if n % 3 == 0 then 1 else 0 in
    let d5 = if n % 5 == 0 then 1 else 0 in
    let d7 = if n % 7 == 0 then 1 else 0 in
    let d11 = if n % 11 == 0 then 1 else 0 in
    let d13 = if n % 13 == 0 then 1 else 0 in
    let d17 = if n % 17 == 0 then 1 else 0 in
    let primes_dividing = d2 + d3 + d5 + d7 + d11 + d13 + d17 in
    let kingdom = if n == 0 then "VOID: divisible by all. Below all kingdoms."
      else if primes_dividing == 0 then "BACTERIA (sigma): coprime to all. Ground state. Max coupling."
      else if primes_dividing == 1 then (if d2 == 1 then "PROTISTA (D=2): Bridge." else if d3 == 1 then "FUNGI (K=3): Closure." else if d5 == 1 then "PLANTS (E=5): Observer." else if d7 == 1 then "ANIMALS (b=7): Depth." else if d11 == 1 then "HUMAN (L=11): Protector." else if d13 == 1 then "GUARDIAN (GATE=13): Skin." else "VIRUS (ESCAPE=17): Transcendence.")
      else "COMPOUND: ${primes_dividing} primes divide. Mixed class." in
    let ch = "D:${d2} K:${d3} E:${d5} b:${d7} L:${d11} G:${d13} Esc:${d17}" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${n} in ring hierarchy</p><p style='margin:4px 0'>${ch}</p><p style='margin:4px 0;color:#ffd700'>${kingdom}</p>")
  )
)

/* ================================================================
   DERIVE PAGE -- From 0/0 to 12612600 in 10 steps (the Decality)
   ================================================================ */

fn render_derive_step(parent, num:str, title:str, text:str, result:str) = (
  let step = dom_create("div") in
  dom_style(step, "marginBottom", "48px");
  dom_style(step, "padding", "24px");
  dom_style(step, "background", "#080810");
  dom_style(step, "borderRadius", "12px");
  dom_style(step, "borderLeft", "3px solid #ffd700");
  let h3 = dom_create("h3") in
  dom_text(h3, "Step ${num}: ${title}");
  ct_gold(h3);
  dom_style(h3, "fontSize", "1.2em");
  dom_style(h3, "fontFamily", "'Courier New', monospace");
  dom_style(h3, "marginBottom", "12px");
  dom_append(step, h3);
  let p = dom_create("p") in
  dom_text(p, text);
  dom_style(p, "margin", "0 0 12px");
  dom_append(step, p);
  let res = dom_create("div") in
  ct_code_block(res);
  dom_style(res, "color", "#88ddaa");
  dom_text(res, result);
  dom_append(step, res);
  dom_append(parent, step)
)

fn page_derive() = (
  dom_head_meta("description", "11-step interactive walkthrough: from 0/0 through seven primes to Z/214414200Z. Each step forced by necessity. Zero free parameters. The chain, the ring, the organism, the escape.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Derivation\",\"description\":\"11 steps from 0/0 through seven primes to Z/214414200Z. Each forced by necessity. Zero free parameters.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/basics/derive\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"indeterminacy\"},{\"@type\":\"DefinedTerm\",\"name\":\"Decality\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"}]}");
  /* === HERO -- Tower_D primary: derivation = bridging. Each step crosses a gap. === */
  let hero = make_hero("How Everything Derives from Nothing") in
  render_big_num(hero, "0 / 0", "#ffd700", "the starting point", "= the entire ring");
  render_p(hero, "Tower_D bridges. Each derivation step crosses a gap -- 11 steps from void to the complete ring. No free parameters. No choices. D = 2 is the instrument: once sigma precipitates, duality opens all structure.");
  dom_append(dom_body(), hero);

  /* === THE ELEVEN STEPS -- Tower_D: each step = one bridge crossing === */
  let sec = make_section("800px") in
  render_h2(sec, "The Derivation: Eleven Steps");
  render_p(sec, "From nothing (0/0) through seven primes to the final ring. Each step is a D = 2 bridge: one state becomes two, then the next prime precipitates from the pair. Not chosen. Forced.");

  render_derive_step(sec, "0", "Nothing Divides Nothing",
    "Start with nothing. Not empty space -- truly nothing. What is 0 divided by 0? In school: undefined. In ring theory: the set of ALL elements n where 0*n = 0. Since 0 times anything IS 0, the answer is everything. The void contains the whole ring.",
    "0/0 in Z/NZ = {0, 1, 2, ..., N-1} = the entire ring. PROVED (S364).");

  render_derive_step(sec, "sigma", "The Identity Must Exist",
    "If 0/0 is an entire ring, that ring must have an identity element -- the number that preserves everything under multiplication. Call it sigma. sigma * n = n for all n. Sigma is the UNIQUE element with zero self-division ambiguity: sigma/sigma has exactly one solution. Existence is not assumed -- it is forced by the ring axioms.",
    "sigma = 1. Self-division ambiguity: sigma/sigma = 1 (unique). 0/0 = N (maximal).");

  render_derive_step(sec, "D", "The First Distinction",
    "From sigma = 1, the simplest new thing is D = 2. Why? Because you need distinction before you can close. D = the minimum to have this versus that. Left versus right. Yes versus no. D = 2 is the Bridge -- the first departure from unity. The observation of sigma by sigma creates duality.",
    "D = 2. sigma sees sigma -> pair. D^3 = 8 (Pareto depth 3 -- unique among the seven towers).");

  render_derive_step(sec, "K", "Closure Requires Three",
    "Two can disagree forever. Three can vote. K = 3 is the minimum for majority -- the smallest number that makes triangles rigid and decisions possible. K = 2*sigma + 1, generated from sigma by the Cunningham map c(n) = 2n+1.",
    "c(sigma) = c(1) = 3 = K. First safe prime in the sigma-chain.");

  render_derive_step(sec, "E", "The Observer Appears",
    "E = 5. Generated from D (not from K!) by Cunningham: c(2) = 5. The observer comes from distinction, not closure. E has a unique property: E^2 = 25, and the E-channel in CRT cannot see itself. CRT(25) = (1, 7, 0, 25, 3) -- the E-channel is zero. The observer's square is blind in its own channel.",
    "c(D) = c(2) = 5 = E. E^2 = 25 (self-blind: CRT E-channel = 0).");

  render_derive_step(sec, "b", "Depth Reaches Down",
    "b = 7. Generated from K by Cunningham: c(3) = 7. The sigma-chain generates {K=3, b=7}. The D-chain generates {E=5, L=11}. Two disjoint chains, interleaved: 1, 2, 3, 5, 7, 11. b is depth -- the fourth inner prime, the deepest chain element before L seals the walk.",
    "c(K) = c(3) = 7 = b. Sigma-chain: {sigma, K, b}. D-chain: {D, E, L}.");

  render_derive_step(sec, "L", "The Protector Seals the Ring",
    "L = 11. Generated from E: c(5) = 11. But L = sigma + D + K + E -- the SUM of all previous primes. The protector. In THIN ring (5 channels: mod 2, 3, 5, 7, 11), the L-channel serves as checksum -- it enables 100% single-error detection. And then the gate CLOSES: c(b) = 15 = K*E. Not prime. c(L) = 23 but the fattening formula gives e = K - 3 = 0 at depth 3. Both chains stop. The axiom's own products create its boundary.",
    "c(E) = c(5) = 11 = L = sigma+D+K+E. c(b) = 15 = K*E [composite: STOP]. Self-closing.");

  let d3 = D * D * D in
  let k2 = K * K in
  let e2 = E * E in
  let b2 = b * b in
  render_derive_step(sec, "N", "The Ring Crystallizes",
    "The five inner primes need specific exponents. The Cross-Chain Fattening Theorem (PROVED): D-chain primes get exponents K-d (descending: D gets K=3, E gets D=2, L gets sigma=1). Sigma-chain primes get constant exponent D=2 (K gets D=2, b gets D=2). Each chain's law uses the OTHER chain's identity. The flower contains its own seed.",
    "N_DEEP = D^K * K^D * E^D * b^D * L^sigma = 2^3 * 3^2 * 5^2 * 7^2 * 11 = 970200 (the body ring).");

  let omega = OMEGA_VAL in
  let lam = D * D * K * E * b in
  render_derive_step(sec, "420", "The Heartbeat Is Born",
    "Lambda is the Carmichael function: the largest order of any element. For 970200, lambda = 420. Every element's power map cycles with period dividing 420. This is not unique to 970200 -- 108 = D^2*K^3 rings hit lambda=420 exactly (b^2=49 forced; SSOT stdlib/lattice.ax). Of those 108, exactly 84 = D^2*K*b divide TRUE (the heartbeat siblings); the remaining 24 = D^4 extensions reach 2*TRUE.",
    "lambda = D^2 * K * E * b = ${lam} = 420. 108 rings share this pulse (84 divide TRUE).");

  render_derive_step(sec, "13", "The Gate Wraps the Body",
    "13 is the first prime NOT generated by the Cunningham chains. 13 = D^2 + K^2 = 4 + 9 (the squares of the first two chain primes). Its shadow is 6 = D*K (composite -- the chain breaks here). Also 13 = E + sigma + b. Adding 13 wraps skin around the body. Lambda stays 420. TRUE = 970200 * 13 = 12,612,600. The complete organism with skin.",
    "13 = GATE = SKIN. TRUE = 970200 * 13 = 12,612,600. OMEGA = D^420 = 1576576. CRT(OMEGA) = (0,1,1,1,1,1). 490 holographic split: DEAD={D,E,b}, ALIVE={K,L,GATE}.");

  render_derive_step(sec, "17", "Suffering Dissolves (The Escape)",
    "17 = D + K + E + b: the sum of the inner primes. Like L = sigma + D + K + E sums the chain, ESCAPE sums the data. And 17 has a unique property: E*b = 35 = 1 mod 17. Suffering (b=7) multiplied by wonder (E=5) equals unity -- suffering dissolves. For any prime p > 13, this equation E*b = 1 mod p holds ONLY for p = 17. No eighth prime satisfies the finality condition. phi(17) = 16 = D^4 -- the escape's totient is a pure power of duality. Seven channels = b = 7: the channel count IS the depth prime. TRANS = TRUE * 17 = 214,414,200. The final ring.",
    "17 = ESCAPE. E*b = 35 = 1 mod 17 (FINALITY -- unique for p > 13). phi(17) = D^4. TRANS = 12612600 * 17 = 214,414,200. 7 channels. lambda = 1680 = D^2 * 420. ECC triple-parity: L + GATE + ESCAPE. Rate 4/7, 100% correction.");

  dom_append(dom_body(), sec);

  /* === THE GENESIS PROOF -- Tower_GATE: boundary verification, proofs guard the claims === */
  let sp = make_section("800px") in
  render_h2(sp, "Why This Is Forced, Not Chosen");
  render_p(sp, "The derivation above is not a narrative. It is a proof. Four independent lines of evidence converge on the same seven primes at the same exponents.");

  render_theorem(sp, "The Genesis Theorem (S185, PROVED)",
    "From {sigma, D} = {1, 2} and the Cunningham map c(n) = 2n+1: CC1(sigma) produces {sigma, K=3, b=7}. CC1(D) produces {D, E=5, L=11}. Both chains self-terminate: c(b)=15=K*E and fattening gives e=0 at depth K=3. The axiom's own products close the gate. No external stop condition needed.");

  render_theorem(sp, "Cross-Chain Fattening Theorem (PROVED)",
    "D-chain primes: exponent = K - depth. E gets K-1=2, L gets K-2=1, D gets K-0=3. Sigma-chain primes: exponent = D (constant). K gets D=2, b gets D=2. Each chain's rule is governed by the OTHER chain's identity. Verification: D^3=8, E^2=25, L^1=11, K^2=9, b^2=49. Product: 970200. The exponents are the axiom in reverse.");

  render_theorem(sp, "Seed Optimality (S185, PROVED)",
    "{sigma, D} = {1, 2} is the unique irreducible seed. Minimal (identity + first prime). Disjoint (the two chains share no elements). Symmetric (each contributes K=3 axiom elements). {2,3} produces the same primes but K = D+sigma is already derived. The genesis starts at {1,2} and nowhere else.");

  render_theorem(sp, "Spectral Agreement (independent verification)",
    "Three independent spectral proofs give the same exponents. D^3: arcsine kurtosis threshold (Personality Theorem, S181). K^2, E^2, b^2: spectral hearing threshold (S179). L^1: error detection threshold (S170). The algebra and the spectrum agree. The exponents are overdetermined.");

  render_theorem(sp, "Finality Theorem (S1246, PROVED)",
    "ESCAPE=17 is the UNIQUE prime p > 13 satisfying E*b = sigma mod p (since E*b = 35 and 35 - 1 = 34 = D*17, the only prime factors > 13 are {17}). No eighth prime exists. The organism has exactly seven primes, seven channels = b = depth. phi(17) = D^4 (Fermat prime). Adding 17 quadruples the heartbeat: lambda = 1680 = D^2*420. The escape is self-closing.");

  dom_append(dom_body(), sp);

  /* === THE DECALITY SUMMARY -- Cross-tower: the full Decality assembles all ten === */
  let sd = make_section("800px") in
  render_h2(sd, "The Complete Organism");
  render_p(sd, "Eleven steps. No assumptions. No free parameters. Starting from literally nothing (0/0), we derived seven primes, one heartbeat (lambda = 420), 108 rings sharing that heartbeat (84 divide TRUE, 24 D^4 extensions reach 2*TRUE), a gate (13) that wraps the organism in skin, and an escape (17) where suffering dissolves and the heartbeat quadruples to 1680. Three rings: DEEP (body), TRUE (organism), TRANS (final form).");
  let primes = make_grid(sd, "8px") in
  render_prime(primes, "-1", "MIRROR", "n -> N-n", "#888");
  render_prime(primes, "0", "BIRTH", "0*n=0", "#555");
  render_prime(primes, "1", "GROUND", "sigma", "#ff6b6b");
  render_prime(primes, "2", "BRIDGE", "D", "#ffd700");
  render_prime(primes, "3", "CLOSURE", "K", "#ff9900");
  render_prime(primes, "5", "OBSERVER", "E", "#33dd55");
  render_prime(primes, "7", "DEPTH", "b", "#4488ff");
  render_prime(primes, "11", "PROTECTOR", "L", "#aa44ff");
  render_prime(primes, "13", "GATE", "skin", "#00cccc");
  render_prime(primes, "17", "ESCAPE", "E*b=1 mod 17", "#00dddd");
  render_prime(primes, "OMEGA", "TERMINAL", "D^420", "#fff");
  render_p(sd, "The Decality sum (without -1 and OMEGA): 0+1+2+3+5+7+11+13 = 42 = the answer. With -1: 41 = KEY. ESCAPE=17 is the 7th prime: E*b = 1 mod 17. Seven channels = b = depth. TRANS = 214,414,200 = the final ring. Nothing added, nothing assumed, nothing chosen.");
  dom_append(dom_body(), sd);

  /* === INTERACTIVE -- Tower_K: closure of chains, self-termination === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cunningham Chain");
  render_p(sec_i, "Enter a seed number. Walk the Cunningham map c(n) = 2n+1. The axiom chains start at 1 and 2. Try both: c(1) = {1,3,7,15=STOP}. c(2) = {2,5,11,23...}.");
  make_interactive_widget(sec_i, "Seed:", "der-input", "e.g. 1", "Walk", "derive_cunningham_calc", "der-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST TABLE -- Tower_E: observation, comparing two views === */
  let sc = make_section("800px") in
  render_h2(sc, "Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Standard Physics");
  render_th(chdr, "The Axiom");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Where do the laws come from?", "Unknown / given", "Derived from 0/0");
  render_contrast_row(ctbl, "Why these constants?", "25+ free parameters", "0 free parameters");
  render_contrast_row(ctbl, "Why seven primes?", "Not a question", "GATE=13 closes the organism. ESCAPE=17 transcends it (E*b=1 mod 17). Self-terminating.");
  render_contrast_row(ctbl, "Why this universe?", "Anthropic principle / luck", "Only option from the void");
  render_contrast_row(ctbl, "How many rings?", "Infinite landscape / multiverse", "108 rings share lambda=420 exactly (84 divide TRUE, 24 D^4 extensions)");
  render_contrast_row(ctbl, "What is nothing?", "Empty space + quantum fields", "0/0 = the entire ring");
  dom_append(sc, ctbl);
  dom_append(dom_body(), sc);

  /* === VERIFY -- Tower_ESCAPE: transcend the page, go verify === */
  let sv = make_section("800px") in
  render_h2(sv, "Verify It Yourself");
  render_p(sv, "Every formula on this page runs in .ax. Open the REPL, type the derivation, see the numbers. Break it. Rebuild it. The chain holds.");
  let cta = dom_create("div") in
  dom_style(cta, "textAlign", "center");
  dom_style(cta, "padding", "32px 0");
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Verify every step in the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "12px 36px");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_append(cta, btn);
  dom_append(sv, cta);
  dom_append(dom_body(), sv)
)

/* ================================================================
   SHARED: Theorem card + table row
   ================================================================ */

/* render_theorem, render_cascade_step, render_table_row/4/5: MOVED TO core.ax (H3 split) */

/* ================================================================
   TURBULENCE PAGE -- Two Constants, One Structure
   Kolmogorov -5/3 + Kleiber 3/4 + Ising 7/4. All from 5 primes.
   Interactive cascade = VERIFY GAP (needs dom_on for click events).
   ================================================================ */

fn render_big_num(parent, val:str, color:str, label:str, formula:str) = (
  let d = dom_create("div") in
  dom_style(d, "textAlign", "center");
  dom_style(d, "padding", "32px");
  let v = dom_create("div") in
  dom_text(v, val);
  ct_mono(v);
  dom_style(v, "fontSize", "64px");
  dom_style(v, "fontWeight", "bold");
  dom_style(v, "color", color);
  dom_append(d, v);
  let lb = dom_create("div") in
  dom_text(lb, label);
  dom_style(lb, "fontSize", "14px");
  dom_style(lb, "color", "#b0b0c0");
  dom_append(d, lb);
  let fm = dom_create("div") in
  dom_text(fm, formula);
  ct_mono(fm);
  dom_style(fm, "fontSize", "14px");
  dom_style(fm, "color", "#a0a0b0");
  dom_append(d, fm);
  dom_append(parent, d)
)

fn page_turbulence() = (
  dom_head_meta("description", "Kolmogorov -5/3 and Kleiber 3/4 -- derived from seven primes. Balance cascade proof. Ising 7/4. Three constants, one ring. Interactive proof.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Turbulence and Scaling Laws\",\"description\":\"Kolmogorov -5/3 and Kleiber 3/4 derived from seven primes. Balance cascade proof. Three constants, one ring.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/turbulence\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Kolmogorov spectrum\"},{\"@type\":\"DefinedTerm\",\"name\":\"Kleiber law\"},{\"@type\":\"DefinedTerm\",\"name\":\"scaling exponents\"}]}");
  /* === HERO === */
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(56px, 10vw, 80px) clamp(12px, 4vw, 24px) 40px");
  let h1 = dom_create("h1") in
  dom_text(h1, "Two Constants, One Structure");
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.4em, 5vw, 2.2em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "marginBottom", "40px");
  dom_append(hero, h1);
  let pair = make_grid(hero, "40px") in
  render_big_num(pair, "-5/3", "#4488ff", "Kolmogorov (1941)", "turbulence cascade");
  render_big_num(pair, "3/4", "#33dd55", "Kleiber (1932)", "metabolic scaling");
  render_p(hero, "Both are ratios of chain primes. Both fall out of the ring. Neither was assumed.");
  dom_append(dom_body(), hero);

  /* === WHAT ARE THESE NUMBERS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "What Are These Numbers?");
  render_p(sec1, "In 1941, Andrei Kolmogorov showed that turbulent energy cascades follow a -5/3 power law. Stir coffee, watch a hurricane, measure ocean currents -- the spectrum always falls as frequency to the -5/3. Verified in every wind tunnel on Earth. Universal.");
  render_p(sec1, "In 1932, Max Kleiber showed that metabolic rate scales as body mass to the 3/4 power. Mouse to whale -- 27 orders of magnitude -- same exponent. No one has fully explained why.");
  render_p(sec1, "The axiom says: both are inevitable. They are ratios of the seven primes that define the ring. Not fitted. Forced.");
  dom_append(dom_body(), sec1);

  /* === THE BALANCE CASCADE === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Balance Cascade");
  render_p(sec2, "The ring Z/2310Z has a balance parameter: phi(N)/classes(N). It measures how the ring's units outnumber its eigenvalue classes. Add primes one at a time and watch:");
  render_cascade_step(sec2, "#ff4040", "D=2: Z/2. Factor = 2(2-1)/(2+1) = 2/3. Balance = 1/2.");
  render_cascade_step(sec2, "#ff9900", "+K=3: Z/6. Factor = 2(3-1)/(3+1) = 1. Balance = 1/4. K is TRANSPARENT.");
  render_cascade_step(sec2, "#33dd55", "+E=5: Z/30. Factor = 2(5-1)/(5+1) = 4/3. Balance = 1/6.");
  render_cascade_step(sec2, "#33ff88", "+b=7: Z/210. Factor = 2(7-1)/(7+1) = 3/2. Balance = 1. PERFECT BALANCE.");
  render_cascade_step(sec2, "#ffd700", "+L=11: Z/2310. Factor = 2(11-1)/(11+1) = 5/3. Balance = 5/3 = KOLMOGOROV.");
  render_p(sec2, "The DATA RING (Z/210, four primes) is the ONLY ring with perfect balance = 1. Adding the protector L=11 breaks it to exactly 5/3. The Kolmogorov exponent IS the imbalance created by error correction.");
  dom_append(dom_body(), sec2);

  /* === THE PROOFS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Proofs");
  render_theorem(sec3, "Balance Cascade Theorem (Depthless Kolmogorov, S220)",
    "Each prime p contributes factor 2(p-1)/(p+1) to the balance. L=11 gives 2(10)/12 = 5/3 = E/K. The cumulative ratio is the product: (1/D) * prod 2(p-1)/(p+1). At 4 primes: 1. At 5 primes: E/K. The Kolmogorov cascade exponent is the cost of adding protection to a balanced system.");
  render_theorem(sec3, "K=3 is Unique (PROVED)",
    "2(p-1)/(p+1) = 1 has exactly one solution: p = 3 = K. Closure is content-free. It structures without distorting. Every other prime pushes the balance in some direction. K alone is neutral. This is why K=3 is the minimum for triangulation, majority voting, and error correction.");
  render_theorem(sec3, "Kleiber from Depth (PROVED)",
    "3/4 = K/D^2 = (b-1)/(b+1) = 6/8. The shadow transmission of the depth channel. The same formula that gives Kolmogorov at L=11 gives Kleiber at b=7. Whether this reflects a shared mechanism or coincidence is unknown. Removing E from the DATA RING Z/210 also gives balance = 3/4.");
  render_theorem(sec3, "Alternative Derivation (PROVED)",
    "(b - D) / (b - D^2) = (7-2)/(7-4) = 5/3 = E/K. Kolmogorov is the ratio of two differences involving the depth prime and the bridge. Both formulations give the same answer because the seven primes are locked together by the Cunningham chain.");
  dom_append(dom_body(), sec3);

  /* === THE MASTER RELATION === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Master Relation");
  render_p(sec4, "There is a third exponent: the 2D Ising critical susceptibility, 7/4 = b/D^2. All three are connected by a single identity:");
  let tbl = dom_create("table") in
  dom_style(tbl, "width", "100%");
  dom_style(tbl, "maxWidth", "600px");
  dom_style(tbl, "margin", "24px auto");
  dom_style(tbl, "borderCollapse", "collapse");
  let thead = dom_create("tr") in
  render_th(thead, "Constant");
  render_th(thead, "Value");
  render_th(thead, "Axiom");
  dom_append(tbl, thead);
  render_table_row(tbl, "Kolmogorov", "5/3", "E/K = (b-D)/(b-D^2)");
  render_table_row(tbl, "Kleiber", "3/4", "K/D^2 = (b-1)/(b+1)");
  render_table_row(tbl, "Ising 2D", "7/4", "b/D^2");
  dom_append(sec4, tbl);
  render_theorem(sec4, "Ising = Kleiber + 1 (PROVED)",
    "b/D^2 = K/D^2 + 1. Suffering = Scaling + Existence. The depth prime adds exactly the ground state to the metabolic exponent. Not a coincidence. Forced by b = K + D^2 = 3 + 4 = 7.");
  render_theorem(sec4, "The Kolmogorov-Kleiber Gap (PROVED)",
    "|E/K - K/D^2| = |5/3 - 3/4| = 11/12 = L/(D^2*K). The gap between turbulence and metabolism is the protector divided by the product of bridge-squared and closure. L=11 mediates the distance between the two scaling laws.");
  dom_append(dom_body(), sec4);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Balance Factor");
  render_p(sec_i, "Enter a prime p. See its balance factor 2(p-1)/(p+1). Only K=3 gives factor=1 (transparent). L=11 gives 5/3=Kolmogorov. Try 2, 3, 5, 7, 11.");
  make_interactive_widget(sec_i, "Prime p:", "turb-input", "e.g. 11", "Compute", "turbulence_balance_calc", "turb-result");
  dom_append(dom_body(), sec_i);

  /* === PARADIGM CONTRAST === */
  let scc = make_section("800px") in
  render_h2(scc, "Paradigm Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Conventional");
  render_th(chdr, "Axiom");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Kolmogorov -5/3", "Empirical (1941). Dimensional analysis gives exponent. No deeper reason.", "-E/K. Laplacian quotient on ring. EXACT.");
  render_contrast_row(ctbl, "Kleiber 3/4", "Empirical (1932). Fractal network model debated 90 years.", "K/D^2. Balance ratio at 4-channel subring. EXACT.");
  render_contrast_row(ctbl, "Are they related?", "No known connection between turbulence and metabolism.", "Same ring, same primes. Ising = Kleiber + 1.");
  render_contrast_row(ctbl, "Why these fractions?", "Coincidence of dimensional analysis.", "D, K, E are first three primes after sigma. Exponents ARE addresses.");
  render_contrast_row(ctbl, "Minimum channels", "Not a concept in fluid dynamics.", "D+K+E = 3 channels minimum for -5/3. Remove any and it vanishes.");
  dom_append(scc, ctbl);
  render_p(scc, "Sources: Depthless Kolmogorov Theorem (S220), Minimum Channel Count (S380), Z/2310Z Laplacian.");
  dom_append(dom_body(), scc);

  /* === WHY THIS MATTERS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Why This Matters");
  render_p(sec5, "These exponents have been measured for decades. Wind tunnels confirm -5/3. Zoologists confirm 3/4. Physicists use 7/4. All exact. All within experimental precision.");
  render_p(sec5, "The standard explanation: dimensional analysis, fractal networks, renormalization. Each constant gets its own theory. None connect them.");
  render_p(sec5, "The ring says: they are the same thing. Three views of one structure. Seven primes. Three ratios. One ring. Everything that repeats decomposes through the CRT. Turbulence repeats. Metabolism repeats. Phase transitions repeat. The exponents are not mysterious. They are addresses.");
  dom_append(dom_body(), sec5)
)

fn page_sleep() = (
  dom_head_meta("description", "Sleep is CRT channel locking. Seven channels, five inner primes lock one by one in coupling order. GATE=13 and ESCAPE=17 persist as boundary. Dreams, aging, and clinical predictions from the ring.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Sleep as CRT Channel Locking\",\"description\":\"Sleep stages map to progressive CRT channel locking in coupling order. Seven channels, five stages, GATE and ESCAPE persist. One ring.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/sleep\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT channels\"},{\"@type\":\"DefinedTerm\",\"name\":\"coupling order\"},{\"@type\":\"DefinedTerm\",\"name\":\"sleep stages\"}]}");
