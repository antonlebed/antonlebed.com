  render_p(si, "When you fall asleep, your brain does not hit a power button. It turns off five inner stations one at a time, starting with the cheapest to silence and ending with the most expensive. GATE (skin) and ESCAPE (transcendence) persist -- the organism's boundary does not sleep. The order of locking is always the same.");
  dom_append(dom_body(), si);

  /* === THE FIVE STAGES === */
  let sec1 = make_section("800px") in
