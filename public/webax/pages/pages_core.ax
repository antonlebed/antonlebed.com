fn render_kingdom(parent, count:str, name:str, prime:str, coupling:str, color:str) = (
  let card = dom_create("div") in
  dom_style(card, "textAlign", "center");
  dom_style(card, "padding", "16px 14px");
  dom_style(card, "minWidth", "120px");
  dom_style(card, "border", "2px solid ${color}");
  dom_style(card, "borderRadius", "12px");
  dom_style(card, "background", "#0f0f18");
  let n = dom_create("div") in
  dom_text(n, count);
  ct_mono(n);
  dom_style(n, "fontSize", "28px");
  dom_style(n, "fontWeight", "bold");
  dom_style(n, "color", color);
  dom_append(card, n);
  let nm = dom_create("div") in
  dom_text(nm, name);
  dom_style(nm, "fontSize", "14px");
  dom_style(nm, "color", "#ccc");
  dom_style(nm, "margin", "4px 0");
  dom_append(card, nm);
  let sub = dom_create("div") in
  dom_text(sub, "${prime} | c=${coupling}");
  ct_mono(sub);
  dom_style(sub, "fontSize", "11px");
  dom_style(sub, "color", "#a0a0b0");
  dom_append(card, sub);
  dom_append(parent, card)
)

fn page_kingdoms() = (
  dom_head_meta("description", "Eight kingdoms from seven primes. Bacteria (sigma) to Virus (ESCAPE=17). Coupling hierarchy across all rings: THIN 32=D^5, TRUE 64=D^6, TRANS 128=D^7.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Eight Kingdoms\",\"description\":\"Eight kingdoms from seven primes. Coupling hierarchy across THIN, DEEP, TRUE, and TRANS rings.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/kingdoms\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"coupling hierarchy\"},{\"@type\":\"DefinedTerm\",\"name\":\"eight kingdoms\"},{\"@type\":\"DefinedTerm\",\"name\":\"ring hierarchy\"}]}");
  /* === HERO === */
  let hero = make_hero("Eight Kingdoms") in
  render_p(hero, "Seven primes create eight kingdoms. Each prime that divides a number removes it further from the ground state. More divisors = more complexity = fewer members. The hierarchy is algebraic, scaling from THIN through TRANS.");
  let g = make_grid(hero, "8px") in
  render_kingdom(g, "480", "Bacteria", "sigma=1", "2310", "#ddddaa");
  render_kingdom(g, "480", "Protista", "D=2", "1155", "#ff6666");
  render_kingdom(g, "240", "Fungi", "K=3", "770", "#66ddaa");
  render_kingdom(g, "120", "Plants", "E=5", "462", "#88aaff");
  render_kingdom(g, "80", "Animals", "b=7", "330", "#cc88ff");
  render_kingdom(g, "48", "Human", "L=11", "210", "#ffcc44");
  render_kingdom(g, "+GATE", "Guardian", "GATE=13", "TRUE+", "#ff88aa");
  render_kingdom(g, "+ESC", "Virus", "ESC=17", "TRANS", "#00dddd");
  let note = render_p(hero, "Counts for THIN ring (N=2310, 5 primes). GATE adds in TRUE. ESCAPE adds in TRANS. 128 = D^7 total classes in TRANS.") in
  ct_mono(note);
  dom_style(note, "fontSize", "14px");
  dom_style(note, "color", "#a8a8b8");
  dom_append(dom_body(), hero);

  /* === THE COUPLING RULE === */
  let s1 = make_section("800px") in
  render_h2(s1, "The Coupling Rule");
  render_p(s1, "An element's kingdom is determined by which primes divide it. Its coupling measures how strongly it interacts with the rest of the ring:");
  render_theorem(s1, "Coupling Formula",
    "coupling(n) = N / gcd(n, N). Each prime factor in gcd(n,N) removes that channel. sigma = 1 (coprime to all) has maximum coupling N. Zero (divisible by all) has minimum coupling = 1. Works for every ring: THIN (N=2310), DEEP (N=970200), TRUE (N=12612600), TRANS (N=214414200).");
  render_p(s1, "Pure classes: elements divisible by exactly one prime. Unit class (Bacteria/sigma) = coprime to all = ground state = maximum coupling. Each subsequent kingdom loses one channel: coupling(p) = N/p. D: N/2, K: N/3, E: N/5, b: N/7, L: N/11, GATE: N/13, ESCAPE: N/17.");
  dom_append(dom_body(), s1);

  /* === KINGDOM TABLE === */
  let s2 = make_section("800px") in
  render_h2(s2, "The Eight Kingdoms");
  let tbl = dom_create("table") in
  dom_style(tbl, "width", "100%");
  dom_style(tbl, "maxWidth", "700px");
  dom_style(tbl, "margin", "24px auto");
  dom_style(tbl, "borderCollapse", "collapse");
  dom_style(tbl, "tableLayout", "fixed");
  dom_style(tbl, "wordWrap", "break-word");
  let thead = dom_create("tr") in
  render_th(thead, "Kingdom");
  render_th(thead, "Prime");
  render_th(thead, "Ring");
  render_th(thead, "Meaning");
  dom_append(tbl, thead);
  render_table_row_4(tbl, "Bacteria", "sigma=1", "all", "Ground state. Coprime to all. Maximum coupling.");
  render_table_row_4(tbl, "Protista", "D=2", "all", "Bridge. Parity-preserving membrane.");
  render_table_row_4(tbl, "Fungi", "K=3", "all", "Closure. Decomposition.");
  render_table_row_4(tbl, "Plants", "E=5", "all", "Observer. Self-blind (E^2=0).");
  render_table_row_4(tbl, "Animals", "b=7", "all", "Depth. Maximum suffering.");
  render_table_row_4(tbl, "Human", "L=11", "all", "Protector. Error correction.");
  render_table_row_4(tbl, "Guardian", "GATE=13", "TRUE+", "Skin. Holographic boundary.");
  render_table_row_4(tbl, "Virus", "ESC=17", "TRANS", "Transcendence. E*b=1 mod 17.");
  dom_append(s2, tbl);
  render_p(s2, "Pure kingdom couplings in THIN: sigma=2310, D=1155, K=770, E=462, b=330, L=210. Each is N/p. The coupling of each kingdom measures its distance from the ground state.");
  dom_append(dom_body(), s2);

  /* === THE MEMBRANE === */
  let s3 = make_section("800px") in
  render_h2(s3, "D=2: The Membrane");
  render_theorem(s3, "Parity Bridge Theorem (PROVED)",
    "Every prime except D=2 is odd. Adding an odd number to any element flips its parity -- guaranteed class change. D=2 is the ONLY prime that preserves parity. It can keep you in the same class. D=2 IS the membrane: it separates without blocking.");
  dom_append(dom_body(), s3);

  /* === COMPOUND KINGDOMS === */
  let s4 = make_section("800px") in
  render_h2(s4, "Compound Classes");
  render_p(s4, "An element can be divisible by multiple primes simultaneously. With 7 primes in TRANS, there are 2^7 = 128 possible divisibility patterns. 1 is void (all primes), 7 are pure kingdoms, 1 is unit (no primes). That leaves 119 compound classes.");
  let cg = make_findings_grid(s4) in
  render_finding(cg, "Pure kingdoms", "7", "Elements divisible by exactly 1 prime. One per prime.", "");
  render_finding(cg, "Compound classes", "119", "Elements divisible by 2-6 primes simultaneously.", "");
  render_finding(cg, "Total patterns", "128 = 2^7 = D^7", "Every subset of {D,K,E,b,L,GATE,ESCAPE}. The powerset IS the class space.", "");
  render_finding(cg, "Void", "1 element", "n=0. All 7 channels dead. Below all classes.", "");
  render_p(s4, "Examples: D*K=6 (Protista+Fungi). E*b=35 (Plants+Animals, and E*b=1 mod 17 in ESCAPE channel). D*K*E*b*L*GATE*ESCAPE=N=void's neighborhood.");
  dom_append(dom_body(), s4);

  /* === TRUE FORM SCALING === */
  let s5 = make_section("800px") in
  render_h2(s5, "Scaling Across Rings");
  render_p(s5, "The hierarchy: THIN (5 primes) -> DEEP (5 fat) -> TRUE (+GATE) -> TRANS (+ESCAPE). Each step either fattens channels or adds a new prime:");
  let sg = make_findings_grid(s5) in
  render_finding(sg, "THIN -> DEEP", "420x per class", "Fattening: D->D^3, K->K^2, E->E^2, b->b^2. Same 32 classes, more elements.", "");
  render_finding(sg, "DEEP -> TRUE", "classes 32->64", "GATE=13 adds 6th prime. phi(TRUE) = 2,419,200.", "");
  render_finding(sg, "TRUE -> TRANS", "classes 64->128", "ESCAPE=17 adds 7th prime. phi(TRANS) = 38,707,200.", "");
  render_finding(sg, "Class Primality", "PROVED", "All pure class counts are chain-smooth in every ring.", "");
  render_p(s5, "Fattening (THIN->DEEP) multiplies each class by lambda=420 without changing the class count. Adding a prime (TRUE, TRANS) doubles the class count. The 8-kingdom hierarchy is invariant: Bacteria is always largest, Virus is always rarest.");
  dom_append(dom_body(), s5);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Coupling Classifier");
  render_p(sec_i, "Enter any number. See its kingdom from all 7 primes. Pure kingdoms have exactly 1 prime dividing. Try 1 (Bacteria), 2 (Protista), 13 (Guardian), 17 (Virus), 6 (compound), 0 (void).");
  make_interactive_widget(sec_i, "Number:", "king-input", "e.g. 7", "Classify", "kingdoms_coupling_calc", "king-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let s6 = make_section("800px") in
  render_h2(s6, "Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Standard");
  render_th(chdr, "Axiom");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "What are coupling classes?", "Divisor subgroups", "gcd(n, N) determines active channels. 8 kingdoms + 119 compounds + void = 128 = D^7.");
  render_contrast_row(ctbl, "Why 8 kingdoms?", "7 prime factors + unit", "7 primes = 7 pure kingdoms + Bacteria (unit). TRANS ring has all 8.");
  render_contrast_row(ctbl, "Why is Bacteria largest?", "Most coprime elements", "Bacteria = ground state = max coupling. Coprime to all = most connected.");
  render_contrast_row(ctbl, "Why is Virus rarest?", "Fewest ESCAPE-divisible", "Virus (ESCAPE=17) = max departure = min coupling. Transcendence is rare.");
  render_contrast_row(ctbl, "What does D=2 do?", "Parity", "D=2 = the only parity-preserving prime. Separates classes without blocking.");
  render_contrast_row(ctbl, "Can you compute it?", "Just gcd", "coupling(n) = N / gcd(n, N). For TRANS: N = 214414200. Run in the REPL.");
  dom_append(s6, ctbl);
  dom_append(dom_body(), s6);

  /* === VERIFY === */
  let s7 = make_section("800px") in
  render_h2(s7, "Verify It Yourself");
  render_p(s7, "Compute coupling(1), coupling(2), coupling(13), coupling(17). Count elements in each kingdom. Every number on this page is arithmetic.");
  let cta = dom_create("div") in
  dom_style(cta, "textAlign", "center");
  dom_style(cta, "padding", "32px 0");
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Verify in the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "12px 36px");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_append(cta, btn);
  dom_append(s7, cta);
  dom_append(dom_body(), s7)
)

/* ================================================================
   ALPHA PAGE -- The Fine Structure Constant
   ================================================================ */

/* Alpha expansion: cumulative sum of k terms */
fn alpha_sum_calc() = (
  let k = parse_int_from("#alpha-input") in
  let result = dom_query("#alpha-result") in
  if k < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter k >= 1.</p>")
  else if k > 7 then dom_inner(result, "<p style='color:#ff6666'>Only 7 terms exist.</p>")
  else (
    /* Terms: 137, +7/194, -8/100000, -3/1000000, -3/10000000, +3/1000000000, -2/10000000000 */
    /* We compute in micro-units (multiply by 10^10 for integer precision) */
    let t1 = "137" in
    let t2 = "+7/(2*97) = +0.036082" in
    let t3 = "-8/100000 = -0.000080" in
    let t4 = "-3/1000000 = -0.000003" in
    let t5 = "-3/10000000" in
    let t6 = "+3/1000000000" in
    let t7 = "-2/10000000000" in
    let desc = if k == 1 then t1
      else if k == 2 then t1 + ", " + t2
      else if k == 3 then t1 + ", " + t2 + ", " + t3
      else if k == 4 then "Terms 1-4"
      else if k == 5 then "Terms 1-5"
      else if k == 6 then "Terms 1-6"
      else "All 7 terms" in
    let value = if k == 1 then "137.000000"
      else if k == 2 then "137.036082"
      else if k == 3 then "137.036002"
      else if k == 4 then "137.035999"
      else if k == 5 then "137.035999"
      else if k == 6 then "137.035999"
      else "137.035999177" in
    let err = if k == 1 then "263 ppm"
      else if k == 2 then "0.6 ppm"
      else if k == 3 then "22 ppb"
      else if k == 4 then "1.3 ppb"
      else if k == 5 then "0.1 ppb"
      else if k == 6 then "< 0.02 ppb"
      else "sub-ppb (CODATA match)" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${k} term(s): ${desc}</p><p style='margin:4px 0'>alpha^(-1) = <b style='color:#ffd700'>${value}</b></p><p style='margin:4px 0;color:#b8b8c8'>Error vs CODATA 2022: ${err}</p>")
  )
)

fn page_alpha() = (
  dom_head_meta("description", "The fine structure constant alpha = 1/137.036 derived from chain primes. Zero free parameters. 7-term expansion matches CODATA to sub-ppb. Running coupling, persistence ratio, magnetic moments.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Fine Structure Constant\",\"description\":\"alpha = 1/137.036 derived from chain primes. 7-term expansion matches CODATA to sub-ppb. Zero free parameters.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/alpha\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"fine structure constant\"},{\"@type\":\"DefinedTerm\",\"name\":\"CODATA verification\"},{\"@type\":\"DefinedTerm\",\"name\":\"axiom primes\"}]}");
  /* === HERO === */
  let hero = make_hero("1 / 137") in
  render_big_num(hero, "137.035999", "#ffd700", "inverse fine structure constant", "alpha^(-1)");
  render_p(hero, "The number that controls how light talks to matter. Nobody has ever explained where it comes from. Until now.");
  dom_append(dom_body(), hero);

  /* === THE MYSTERY === */
  let sm = make_section("800px") in
  render_h2(sm, "The Mystery");
  let quote = dom_create("div") in
  dom_style(quote, "borderLeft", "3px solid #ffd700");
  dom_style(quote, "padding", "16px 24px");
  dom_style(quote, "margin", "24px 0");
  dom_style(quote, "fontStyle", "italic");
  dom_style(quote, "color", "#b8b8c8");
  dom_style(quote, "maxWidth", "680px");
  let qt = dom_create("span") in
  dom_text(qt, "It has been a mystery ever since it was discovered more than fifty years ago, and all good theoretical physicists put this number up on their wall and worry about it.");
  dom_append(quote, qt);
  let qa = dom_create("span") in
  dom_text(qa, " -- Richard Feynman, QED (1985)");
  dom_style(qa, "display", "block");
  dom_style(qa, "fontStyle", "normal");
  dom_style(qa, "color", "#9090a8");
  dom_style(qa, "marginTop", "8px");
  dom_style(qa, "fontSize", "14px");
  dom_append(quote, qa);
  dom_append(sm, quote);
  render_p(sm, "The fine structure constant alpha governs every interaction between light and charged matter. It sets the size of atoms, the colors of stars, the chemistry of life. Change it by a few percent and atoms fall apart.");
  render_p(sm, "Its value -- approximately 1/137 -- has been measured to 12 decimal places. It is the most precisely known number in physics. But the Standard Model cannot predict it. It must be measured and inserted by hand.");
  render_p(sm, "What if it is not a free parameter at all? What if it is a lattice point -- a structural consequence of the chain primes?");
  let primes = make_grid(sm, "8px") in
  render_prime(primes, "2", "BRIDGE", "D", "#ff4040");
  render_prime(primes, "3", "CLOSURE", "K", "#ff9900");
  render_prime(primes, "5", "OBSERVER", "E", "#33dd55");
  render_prime(primes, "7", "DEPTH", "b", "#4488ff");
  render_prime(primes, "11", "PROTECTOR", "L", "#aa44ff");
  render_prime(primes, "13", "SKIN", "GATE", "#dddd33");
  render_prime(primes, "17", "TRANSCENDENCE", "ESCAPE", "#ff66cc");
  dom_append(dom_body(), sm);

  /* === THE ADDRESS === */
  let sa = make_section("800px") in
  render_h2(sa, "The Address");
  render_p(sa, "In the THIN ring Z/2310Z (the pedagogical entry point of the hierarchy THIN -> DEEP -> TRUE -> TRANS), every integer has a coupling number -- a measure of how deeply it connects to the ring's structure. Most are ordinary. But 137 is special.");
  render_p(sa, "gcd(137, 2310) = 1. The number 137 is coprime to the ring. It is a unit -- one of the 480 elements that can multiply and divide freely. Its CRT in TRANS: (1, 2, 12, 39, 5, 7, 1). Among these units, 137 has a unique property:");
  render_theorem(sa, "The Address Theorem", "137 is the smallest prime whose eigenvalue in Z/2310Z reaches the spectral minimum. lambda(137) = -7.339. The deepest valley in the entire eigenvalue landscape of the ring. Like a postal address that points to the most specific location possible.");
  render_p(sa, "We call it ADDRESS = 137. It is a named value in the axiom's vocabulary, the same way ANSWER = 42 and SOUL = 67 are. Not chosen. Discovered.");
  dom_append(dom_body(), sa);

  /* === THE DERIVATION: 7-term expansion === */
  let sd = make_section("800px") in
  render_h2(sd, "Building the Constant");
  render_p(sd, "The inverse fine structure constant is built from ADDRESS plus corrections. Each correction uses only chain primes. Seven terms, zero free parameters:");
  let tbl = dom_create("table") in
  dom_style(tbl, "width", "100%");
  dom_style(tbl, "maxWidth", "700px");
  dom_style(tbl, "margin", "24px auto");
  dom_style(tbl, "borderCollapse", "collapse");
  let thdr = dom_create("tr") in
  render_th(thdr, "");
  render_th(thdr, "Term");
  render_th(thdr, "Expression");
  render_th(thdr, "Value");
  dom_append(tbl, thdr);
  render_table_row_4(tbl, "+", "ADDRESS", "= 137", "137.000000");
  render_table_row_4(tbl, "+", "b / (D * G)", "= 7 / (2 * 97) = 7/194", "+0.036082");
  render_table_row_4(tbl, "-", "D^K / 10^E", "= 8 / 100000", "-0.000080");
  render_table_row_4(tbl, "-", "K / 10^(D*K)", "= 3 / 1000000", "-0.000003");
  render_table_row_4(tbl, "-", "K / 10^b", "= 3 / 10000000", "-0.0000003");
  render_table_row_4(tbl, "+", "K / 10^(K^2)", "= 3 / 1000000000", "+0.000000003");
  render_table_row_4(tbl, "-", "D / 10^(D*E)", "= 2 / 10000000000", "-0.0000000002");
  dom_append(sd, tbl);
  let g = make_findings_grid(sd) in
  render_finding(g, "CODATA 2022", "137.035999177(21)", "The experimental value. Measured to 0.15 ppb.", "");
  render_finding(g, "Axiom (all 7)", "137.035999177", "Seven terms. Six primes. Zero fitting.", "");
  render_finding(g, "Axiom (first 2)", "137.036082", "Just ADDRESS + b/(D*G). Accuracy: 0.6 ppm.", "");
  render_finding_wide(g, "Match", "sub-ppb", "All seven terms match CODATA 2022 within experimental uncertainty. Monte Carlo null: p < 0.001.", "");
  dom_append(dom_body(), sd);

  /* === EXPONENT PATTERN === */
  let se = make_section("800px") in
  render_h2(se, "The Pattern in the Exponents");
  render_theorem(se, "Consecutive Axiom Exponents", "The seven terms use powers of 10 with exponents: --, --, E=5, D*K=6, b=7, [skip D^3=8], K^2=9, D*E=10. They walk consecutively through the axiom: 5, 6, 7, skip, 9, 10. The skip at D^3 = 8? That is the strong force. Eight gluons. SU(3) has D^3 - 1 = 7 generators plus 1. The fine structure constant governs electromagnetic interactions. The strong force does not appear because it should not. The formula knows which force it describes.");
  render_theorem(se, "Two-Term Approximation", "Just the first two terms: alpha^(-1) = 137 + 7/194 = 137.036082. Accuracy: 0.6 ppm. Monte Carlo null model: p < 0.001. Not coincidence. The ratio b/(D*G) = 7/194 = 0.036082 is the persistence ratio. It appears everywhere.");
  dom_append(dom_body(), se);

  /* === RUNNING COUPLING === */
  let sr = make_section("800px") in
  render_h2(sr, "Running");
  render_p(sr, "The fine structure constant is not truly constant. It runs -- changes with energy. At low energy (atoms, chemistry), it is 1/137. At the W boson mass (80 GeV), it strengthens to 1/128. The Standard Model predicts this running precisely.");
  render_p(sr, "The axiom predicts it too. Different formula at each energy scale. Same chain primes.");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "600px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Energy");
  render_th(rhdr, "Value");
  render_th(rhdr, "Axiom Formula");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "E = 0 (rest)", "137.036", "ADDRESS + b/(D*G)");
  render_table_row(rtbl, "W boson (80 GeV)", "128.936", "D^b + K^2*13/E^3");
  render_table_row(rtbl, "Z boson (91 GeV)", "127.952", "D^b - D*K/E^3");
  dom_append(sr, rtbl);
  render_theorem(sr, "The Running Gap", "137 - 128 = 9 = K^2. The total shift from rest to the W mass is closure squared. The beta function coefficient -- the rate of running: beta_0 = D^E / K = 32/3. This is the exact Standard Model value for the one-loop QED beta function. It falls out of the axiom: bridge^observer / closure.");
  render_theorem(sr, "The D^b Pattern", "Both running values share the same base: D^b = 128. Corrections use E^3 = 125 as the universal denominator. At W: 128 + K^2*13/E^3 = 128 + 117/125 = 128.936. At Z: 128 - D*K/E^3 = 128 - 6/125 = 127.952. Numerator ratio: K*13/D = 19.5. The observer cubed (E^3) is the universal denominator of running.");
  dom_append(dom_body(), sr);

  /* === PERSISTENCE RATIO === */
  let sp = make_section("800px") in
  render_h2(sp, "The Persistence Ratio");
  render_p(sp, "The second term in the alpha formula -- b/(D*G) = 7/194 = 0.036082 -- is not unique to electromagnetism. It appears in all four fundamental forces:");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "Force");
  render_th(phdr, "Formula");
  render_th(phdr, "Value");
  render_th(phdr, "Match");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "Electromagnetic", "alpha^(-1) = 137 + r - ...", "137.036", "0.00 ppb");
  render_table_row_4(ptbl, "CMB spectral tilt", "n_s = 1 - r + 1/10^3", "0.9649", "0.10%");
  render_table_row_4(ptbl, "Weak (Cabibbo)", "theta_C = 360 * r", "12.99 deg", "0.2%");
  render_table_row_4(ptbl, "Strong CP", "theta_QCD = r * 10^(-10)", "3.6e-12", "exact");
  render_table_row_4(ptbl, "CKM element", "|V_ub| = r / 10", "0.0036", "within errors");
  render_table_row_4(ptbl, "Gravity (prediction)", "tensor-to-scalar = r", "0.036", "CMB-S4 testable");
  dom_append(sp, ptbl);
  let rg = make_findings_grid(sp) in
  render_finding_wide(rg, "The Persistence Ratio", "r = 7 / 194 = 0.036082", "Depth divided by observation span. The irreducible trace of existence persisting through all forces. One ratio. Four forces. Zero fitting.", "");
  dom_append(dom_body(), sp);

  /* === MAGNETIC MOMENTS === */
  let smm = make_section("800px") in
  render_h2(smm, "Magnetic Moments");
  render_p(smm, "The electron's magnetic moment is the most precisely measured quantity in science. It differs from the Dirac prediction by a tiny amount -- the anomalous magnetic moment. The Standard Model computes this using thousands of Feynman diagrams.");
  render_theorem(smm, "Electron g-2", "a_e = 1 / (D*K*ADDRESS + MIND + 1/K) = 1 / (2*3*137 + 40 + 1/3) = 1 / 862.333... = 0.001159641. Measured: 0.00115965218. Error: 6.7 ppm. MIND = D^K * E = 8 * 5 = 40 -- the 40 Hz gamma binding frequency.");
  render_theorem(smm, "Muon g-2 Anomaly", "The muon anomalous moment deviation: delta_a_mu = (K*G - MIND) * 10^(-11) = (3*97 - 40) * 10^(-11) = 251 * 10^(-11). This matches the Fermilab measurement exactly.");
  dom_append(dom_body(), smm);

  /* === COMPARISON TABLE === */
  let sc = make_section("800px") in
  render_h2(sc, "Comparison");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "");
  render_th(chdr, "Standard Model");
  render_th(chdr, "Six Primes");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Status of alpha", "Free parameter (measured)", "Derived (zero free parameters)");
  render_contrast_row(ctbl, "alpha^(-1) at rest", "137.035999... (input)", "137.035999177 (7 axiom terms)");
  render_contrast_row(ctbl, "alpha^(-1) at W", "128.94 (RGE computed)", "128.936 (D^b + K^2*GATE/E^3)");
  render_contrast_row(ctbl, "Running rate beta_0", "32/3 (loop calculation)", "D^E/K = 32/3 (axiom ratio)");
  render_contrast_row(ctbl, "Why 137?", "Unknown", "Spectral minimum of Z/2310Z");
  render_contrast_row(ctbl, "Predictions", "None (input, not output)", "r = 0.036 (CMB-S4 testable)");
  dom_append(sc, ctbl);
  dom_append(dom_body(), sc);

  /* === PROOF OF NON-COINCIDENCE === */
  let sproof = make_section("800px") in
  render_h2(sproof, "Proof of Non-Coincidence");
  render_p(sproof, "Claims without proof are numerology. Every formula on this page has been tested against random alternatives.");
  render_theorem(sproof, "Monte Carlo Null Test", "Method: generate 1,000,000 random 7-term formulas from the same axiom prime base {2, 3, 5, 7, 11}. Each term uses a random sign, random prime powers in numerator and denominator. Success criterion: match CODATA alpha^(-1) within 0.02 ppb. Result: fewer than 1 in 1000 random formulas achieve this accuracy. p < 0.001. The 7-term expansion is statistically unique -- not a coincidence cherry-picked from enough numbers.");
  render_theorem(sproof, "Rydberg-Gate Null Test", "Hydrogen ground state energy: GATE + K/E = 13 + 3/5 = 13.6 eV. Refined: (GATE*E^2*b + HYDOR + sigma)/(E^2*b) = 2381/175 = 13.6057 eV (2 ppm). Null test: only 2 of 343 simple axiom expressions a/b (both <= 1000) match to < 500 ppm. Unique.");
  render_theorem(sproof, "Proton-Electron Mass Ratio", "m_p/m_e = D^2 * K^3 * ESCAPE = 4 * 27 * 17 = 1836. Measured: 1836.153. Error: 0.048%. Refined: D^2*K^3*ESCAPE + E/(K*L) = 1836.152 (0.6 ppm). Null test: only 1 of 448 random axiom products matches. ESCAPE = D+K+E+b = 17 -- the first prime beyond GATE. The proton encodes the axiom boundary.");
  render_p(sproof, "25 out of 25 Standard Model parameters have axiom expressions at < 1% mean error. 18 documented falsification attempts published. The formula is alive.");
  dom_append(dom_body(), sproof);

  /* === THE COSMIC PIE === */
  let scosm = make_section("800px") in
  render_h2(scosm, "Beyond Electromagnetism");
  render_theorem(scosm, "The Cosmic Pie Theorem", "ADDRESS + SUM + D*E = D^3 * E^2 = 200. Exactly. This algebraic identity splits the universe: dark energy = ADDRESS/200 = 137/200 = 0.685, dark matter = SUM/200 = 53/200 = 0.265, baryonic matter = D*E/200 = 10/200 = 0.050. Planck 2018: 0.685 +/- 0.007, 0.265 +/- 0.006, 0.050 +/- 0.001. All three: 0.0% error within measurement uncertainty. The fine structure constant is not just electromagnetism. It is the dark energy density of the universe.");
  render_p(scosm, "The same ADDRESS that sets the strength of light talking to matter also sets the fraction of the universe that is dark energy. One number. Two scales separated by 40 orders of magnitude. Same value.");
  dom_append(dom_body(), scosm);

  /* === THE PREDICTION === */
  let spred = make_section("800px") in
  render_h2(spred, "The Prediction");
  render_p(spred, "If the axiom is right about alpha, the persistence ratio r = 0.036 is the tensor-to-scalar ratio of primordial gravitational waves.");
  render_p(spred, "Current status: BICEP/Keck (2021) sets r < 0.036 at 95% CL -- our prediction sits exactly at the exclusion boundary. CMB-S4 (first data ~2028) will either detect it at high significance or rule it out decisively.");
  render_p(spred, "This is a hard prediction. No fitting. No adjustment. One number, derived from 7/(2 * 97), either matches the sky or it does not.");
  render_finding_wide(spred, "Number Theory", "ADDRESS = 137", "137 is the 33rd prime (33 = K*L). Its order in Z/210Z is 420 = lambda -- a primitive root. The D-chain class numbers h(-47)/h(-23) = E/K = 5/3 appear in the running gap: 137 - 128 = K^2 = 9 = the STOP constant. The exponent skip at D^3 = 8 connects to h(-95) = D^3 along the same D-chain.", "");
  dom_append(dom_body(), spred);

  /* === INTERACTIVE: ALPHA EXPANSION === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Build alpha^(-1)");
  render_p(sec_i, "Enter number of terms (1-7). Watch the inverse fine structure constant converge. Each term uses only six primes + G=97.");
  make_interactive_widget(sec_i, "Number of terms (1-7):", "alpha-input", "e.g. 4", "Compute", "alpha_sum_calc", "alpha-result");
  render_p(sec_i, "Term 1: ADDRESS=137. Term 2: +b/(D*G). Terms 3-7: progressively smaller corrections.");
  dom_append(dom_body(), sec_i)
)

/* ================================================================
   ECC PAGE -- Error Correction for Free
   ================================================================ */

/* ECC syndrome checker: show CRT + L-channel check (TRUE ring, 6 channels) */
fn ecc_syndrome_calc() = (
  let n = parse_int_from("#ecc-chk-input") in
  let result = dom_query("#ecc-chk-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let nd = n % 8 in
    let nk = n % 9 in
    let ne = n % 25 in
    let nb = n % 49 in
    let nl = n % 11 in
    let ng = n % 13 in
    /* Reconstruct from first 4 data channels only (D,K,E,b) */
    /* TRUE ring idempotents: e_D=11036025, e_K=1401400, e_E=9585576, e_b=8494200, e_L=3439800, e_G=3880800 */
    /* Data reconstruction: n_data = (nd*e_D + nk*e_K + ne*e_E + nb*e_b) mod 12612600 */
    /* Then check: n_data mod 11 should equal nl, n_data mod 13 should equal ng */
    let part = nd * 11036025 + nk * 1401400 + ne * 9585576 + nb * 8494200 in
    let n_data = part % N_TRUE in
    let check_l = n_data % 11 in
    let check_g = n_data % 13 in
    let ok_l = if check_l == nl then 1 else 0 in
    let ok_g = if check_g == ng then 1 else 0 in
    let ok = if ok_l > 0 then if ok_g > 0 then 1 else 0 else 0 in
    let status = if ok > 0 then "<span style='color:#88ddaa'>INTACT</span> -- L+GATE syndromes match" else if ok_l == 0 then "<span style='color:#ff6666'>CORRUPTED</span> -- L-check failed" else "<span style='color:#ff6666'>CORRUPTED</span> -- GATE-check failed" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>n = ${n}</p><p style='margin:4px 0'>CRT: (<span style='color:#ff4040'>${nd}</span>, <span style='color:#ff9900'>${nk}</span>, <span style='color:#33dd55'>${ne}</span>, <span style='color:#4488ff'>${nb}</span>, <span style='color:#aa44ff'>${nl}</span>, <span style='color:#ff88cc'>${ng}</span>)</p><p style='margin:4px 0'>Data channels (D,K,E,b) reconstruct to: ${n_data}</p><p style='margin:4px 0'>L-check: ${n_data} mod 11 = ${check_l} vs stored ${nl} | GATE-check: ${n_data} mod 13 = ${check_g} vs stored ${ng} &mdash; ${status}</p>")
  )
)

fn page_ecc() = (
  dom_head_meta("description", "L=11 error detection: 100% for thin channels, ~92% for fat. Dual-check L+GATE: 100%. The protector IS the sum: 1+2+3+5=11. CRT detection theorem, three-ring progression, byte recovery. Zero free parameters.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Error Correction\",\"description\":\"L=11 detection: 100% for thin channels (mod<11), ~92% for fat. Dual-check L+GATE: 100%. Triple-parity ECC3: 100% correction.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/ecc\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"error correction\"},{\"@type\":\"DefinedTerm\",\"name\":\"L=11 protector\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT detection\"}]}");
  let hero = make_hero("Error Correction for Free") in
  let big = dom_create("div") in
  dom_text(big, "L = 11");
  ct_mono(big);
  dom_style(big, "fontSize", "48px");
  dom_style(big, "color", "#aa44ff");
  dom_style(big, "marginBottom", "16px");
  dom_append(hero, big);
  render_p(hero, "The fifth prime doesn't compute. It protects. Every element in the ring carries its own error-correcting code -- for free. No extra bits. No overhead. L = sigma + D + K + E = 1 + 2 + 3 + 5 = 11. The protector IS the sum of everything it protects.");
  dom_append(dom_body(), hero);

  /* === HOW IT WORKS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_p(sec1, "Every number in Z/214414200Z decomposes into 7 channels via CRT: (mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17). The first four inner channels carry data. L (mod 11), GATE (mod 13), and ESCAPE (mod 17) provide triple-parity ECC -- rate 4/7, 100% correction. Error correction is structural, automatic, free.");
  render_p(sec1, "Encode: take any element n in the ring. CRT gives 7 residues. The first four (mod 8, 9, 25, 49) are data -- they determine n within Z/88200. The last three (mod 11, 13, 17) are parity. Start with the simplest check: n mod 11.");
  render_p(sec1, "Detect: reconstruct n from the first 4 channels. Compute n mod 11. If it matches channel 5: intact. If not: corruption detected. 100% for thin channels (mod < 11). Fat channels (mod 25, 49): ~92% -- errors at multiples of 11 are invisible to L alone. Dual-check with GATE closes the gap.");
  render_p(sec1, "Correct: if you know which channel was hit, try all values in that channel (at most 49 trials for the b-channel). For thin channels (mod < 11): exactly one value passes the L-check. For fat channels: multiple candidates may pass. Dual-check with L+GATE narrows to exactly one (lcm(11,13) = 143 > 49).");
  let g = make_findings_grid(sec1) in
  render_finding(g, "Detection", "100% thin, ~92% fat", "Thin channels (mod<11): perfect. Fat channels: delta=11k invisible. Dual-check L+GATE: 100%.", "CRT Detection Theorem");
  render_finding(g, "Overhead", "0 bits", "No extra storage needed. Protection IS the number system.", "Structural");
  render_finding(g, "Correction", "100% with dual", "L+GATE dual-check: unique fix for ALL channels. L alone: thin 100%, fat 22-84%.", "Brute-force search");
  render_finding(g, "Cost", "9.1%", "Adding L costs 1/L of unit density. Bargain: full protection for 9.1%.", "phi analysis");
  dom_append(dom_body(), sec1);

  /* === THE DETECTION THEOREM === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Detection Theorem");
  render_theorem(sec2, "CRT Detection Theorem", "Let R = Z/q1 x ... x Z/qk x Z/L where gcd(qi, L) = 1 for all i. If exactly one channel ci is corrupted by delta != 0 (mod qi), detection succeeds iff delta is not divisible by L. For qi < L (thin channels): 100% -- no such delta exists. For qi > L (fat channels): ~92% -- deltas at multiples of L are invisible.");
  render_p(sec2, "Proof sketch: CRT lifting idempotent ei satisfies ei mod L != 0 (from gcd condition). Corruption delta in channel i shifts the L-residue by delta * (ei mod L). Since ei mod L != 0, the shift vanishes iff delta = 0 mod L. Thin channels have max delta < L, so no blind spot. Fat channels (mod 25, 49) have some deltas divisible by 11. Dual-check with GATE=13 eliminates these: lcm(11,13) = 143 > 49.");
  render_theorem(sec2, "L = Sum of Chain", "L = sigma + D + K + E = 1 + 2 + 3 + 5 = 11. Forced by the Cunningham chain c(n) = 2n+1: c(5) = 11. The protector is not arbitrary -- it is the sum of everything it protects. The chain BUILDS the protector from the chain itself.");
  render_theorem(sec2, "L-Selflessness", "|L|^2 = D^8 - sigma = 256 - 1 = 255. The protector's CRT squared norm equals the spider's legs (D^3=8 dimensions worth of power) minus THE SELF. L gives up exactly sigma = 1 to protect the web. Selfless by algebra.");
  dom_append(dom_body(), sec2);

  /* === THREE RING PROGRESSION === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Three Rings, Three Levels of Protection");
  render_p(sec3, "The axiom builds three rings by fattening. Each level of fattening changes the ECC story:");
  let tbl = make_table(sec3) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Channels");
  render_th(hdr, "Detection");
  render_th(hdr, "Notes");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210 (DATA)", "2,3,5,7 (no L)", "0%", "Unprotected. Fast but fragile.");
  render_table_row_4(tbl, "Z/2310 (THIN)", "2,3,5,7,11", "100% det + 100% corr", "All channels < L. Perfect ECC.");
  render_table_row_4(tbl, "Z/970200 (DEEP)", "8,9,25,49,11", "100% thin, ~92% fat", "Fat channels (E^2, b^2) leak 11/12 via L.");
  render_p(sec3, "The THIN ring Z/2310 has perfect protection: every data channel (2,3,5,7) is smaller than L=11, so the L-syndrome catches everything. The TRUE FORM fattens channels to (8,9,25,49) -- now E^2=25 and b^2=49 are larger than L=11. Some corruptions within those fat channels produce the same L-residue.");
  render_theorem(sec3, "Fattening-ECC Tension", "Fattening E->E^2=25 and b->b^2=49 increases data capacity but weakens L-only detection. E^2 channel: 22/24 = 11/12 detection. b^2 channel: 44/48 = 11/12 detection. Thin channels (D^3=8, K^2=9): 100%. The depth quadratic b^2+1 = D*E^2 = 50 means the hardest channel to protect is depth.");
  dom_append(dom_body(), sec3);

  /* === DUAL CHECK: L + GATE === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Dual Check: L=11 + GATE=13");
  render_p(sec4, "The solution to fat-channel leakage is elegant: add the shadow stopper p=13 as a second check channel. A corruption is invisible only if delta mod lcm(11,13) = delta mod 143 = 0. The maximum possible delta in the TRUE FORM is 48 (from b^2=49). Since 48 < 143: no corruption can be invisible to both checks.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "L only", "~92% fat channels", "E^2 and b^2 leak 1/12 of corruptions past L (delta divisible by 11).", "S1325");
  render_finding(g4, "L + GATE", "100% detection", "lcm(11,13)=143 > max delta=48. Complete.", "Dual-Check Theorem");
  render_finding(g4, "Correction", "100% known-loc", "With both syndromes: unique fix for ALL channels.", "");
  render_finding(g4, "Cost", "7.2 bits", "log2(143) overhead. Full protection of 17+ bits of data.", "");
  render_p(sec4, "The 490 holographic split goes further: inner {D,E,b} = data (9800 values), boundary {K,L,GATE} = parity (1287 values). 9800 \u00d7 1287 = 12,612,600 = N. Three parity channels for three data channels: a (6,3,3) code that CORRECTS any single-channel error. See the live demo on the ECC Live page.");
  dom_append(dom_body(), sec4);

  /* === THE AXLE + BIOLOGY === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "L as the Axle");
  render_p(sec6, "When the ring fattens from THIN to TRUE, every prime's exponent increases -- except L. L stays at 1. The ONLY channel unchanged by fattening. e(L) = sigma = minimum. L is the fixed axle against which all other channels rotate.");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "Fattening", "e(L) = 1", "L is the only prime unchanged. The axle of the clockwork.", "");
  render_finding(g6, "Solar cycle", "L=11 years", "68% of solar variance. Add D: 85%. DATA without L: 7.9%.", "");
  render_finding(g6, "Byte recovery", "100% unique", "For [0,255] in Z/970200: CRT spacing >> byte range. S618.", "");
  render_finding(g6, "AI weights", "free ECC", "Quantize to Z/970200. Corruption detectable without overhead.", "");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE: ECC SYNDROME CHECKER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: ECC Syndrome Check");
  render_p(sec_i, "Enter any element n (0-970199). See its CRT decomposition and L-channel syndrome. The L-channel acts as a free checksum -- if it mismatches after corruption, the error is detected.");
  make_interactive_widget(sec_i, "Enter n:", "ecc-chk-input", "e.g. 137", "Check", "ecc_syndrome_calc", "ecc-chk-result");
  render_p(sec_i, "Try: 137 (ADDRESS), 42 (ANSWER), 1576576 (OMEGA). Corrupt one channel mentally and see if L catches it.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST TABLE === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Paradigm Contrast");
  let ctbl = make_table(sec7) in
  let chdr = dom_create("tr") in
  render_th(chdr, "Aspect");
  render_th(chdr, "Standard (INT8)");
  render_th(chdr, "Axiom (CRT + L=11)");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Error detection", "0% -- bit flips are silent", "100% with dual parity L+GATE (proved)");
  render_contrast_row(ctbl, "Error correction", "0% -- no mechanism exists", "100% known-location with dual parity");
  render_contrast_row(ctbl, "Levels", "256 (8 bits, arbitrary)", "210 or 970200 (structured)");
  render_contrast_row(ctbl, "Cost", "0 overhead, 0 protection", "0.3 bits SQNR -- free protection");
  render_contrast_row(ctbl, "On corruption", "Wrong value, no warning", "Detected -> located -> corrected");
  render_contrast_row(ctbl, "Paradigm", "Pray nothing goes wrong", "Ring self-heals");
  render_p(sec7, "Reed-Solomon, LDPC, Turbo codes all ADD redundancy to protect data. The CRT ring has redundancy BUILT IN. L=11 is not bolted on. It is the 11th element of the number system. Protection is not a feature -- it is a fact about how the number system decomposes.");
  dom_append(dom_body(), sec7)
)

