/* Homepage content -- accessible explanation of the ring structure.
   Called from page_home(). Three sections: how CRT works, seven channels,
   seven rings. No insider jargon. No letter names. Lives here (home-module
   only) rather than core.ax (shared) to avoid carrying into 6 unrelated modules. */
fn home_axiom() = (
  /* --- HOW IT WORKS --- */
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_p(sec1, "The Chinese Remainder Theorem (300 BC) says: a number modulo a product of coprime factors splits uniquely into one residue per factor. One value, seven independent views. Change one channel, the others don't move.");
  render_p(sec1, "Modular multiplication is bijective -- every input maps to a unique output when the weight is coprime. Wrong weights produce completely wrong results. No graceful degradation. This makes the ring a non-degenerate computation substrate.");
  dom_append(dom_body(), sec1);

  /* --- SEVEN CHANNELS --- */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Seven Channels");
  render_p(sec2, "Each prime contributes one independent channel. The product of all seven moduli is 214,414,200.");
  let mt = make_table(sec2) in
  let mh = dom_create("tr") in
  render_th(mh, "Prime");
  render_th(mh, "Modulus");
  render_th(mh, "Role");
  dom_append(mt, mh);
  render_table_row(mt, "2", "mod 8", "Duality. The only channel with depth 3: four self-inverse elements.");
  render_table_row(mt, "3", "mod 9", "Closure. The minimum for complete decomposition.");
  render_table_row(mt, "5", "mod 25", "Observation. Carries the golden ratio (discriminant 5).");
  render_table_row(mt, "7", "mod 49", "Depth. Controls the spectral gap.");
  render_table_row(mt, "11", "mod 11", "Error detection. Parity check on data channels.");
  render_table_row(mt, "13", "mod 13", "Boundary. Dual parity with 11 catches all single-channel errors.");
  render_table_row(mt, "17", "mod 17", "Escape. 5 * 7 = 1 mod 17. Enables triple-parity error correction.");
  render_p(sec2, "8 * 9 * 25 * 49 * 11 * 13 * 17 = 214,414,200.");
  dom_append(dom_body(), sec2);

  /* --- SEVEN RINGS --- */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Seven Rings");
  render_p(sec3, "The full structure builds in seven steps -- one per prime. Each ring adds a channel or increases resolution. Seven steps = 7 = the depth prime.");
  let rt = make_table(sec3) in
  let rh = dom_create("tr") in
  render_th(rh, "Ring");
  render_th(rh, "Value");
  render_th(rh, "What changes");
  dom_append(rt, rh);
  render_table_row(rt, "Z/6", "6", "Two channels: mod 2, mod 3. The first split.");
  render_table_row(rt, "Z/30", "30", "Add 5. Three channels. Patterns emerge.");
  render_table_row(rt, "Z/210", "210", "Add 7. Four data channels.");
  render_table_row(rt, "Z/2,310", "2,310", "Add 11. Error detection available.");
  render_table_row(rt, "Z/970,200", "970,200", "Fatten: 2->8, 3->9, 5->25, 7->49. Full resolution.");
  render_table_row(rt, "Z/12,612,600", "12,612,600", "Add 13. Six channels. 420-step maximum cycle.");
  render_table_row(rt, "Z/214,414,200", "214,414,200", "Add 17. Seven channels. Triple-parity ECC (rate 4/7).");
  dom_append(dom_body(), sec3)
)

/* HOME -- the front door. Answers: what is this, what does it do, why care.
   Hero + home_axiom() content. Navigation lives in the navbar. */
fn page_home() = (
  dom_head_meta("description", "214,414,200 = 8 * 9 * 25 * 49 * 11 * 13 * 17. Seven prime channels via the Chinese Remainder Theorem. ~2000 proved theorems. 40 CC0 demos. Self-compiling .ax language. All verifiable.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"antonlebed.com\",\"url\":\"https://antonlebed.com\",\"description\":\"Seven primes, one ring. CRT decomposes 214,414,200 into seven independent channels. ~2000 proved theorems, 40 CC0 demos, self-compiling .ax language.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\"}");
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "clamp(64px, 12vw, 100px) clamp(12px, 4vw, 24px) 40px");
  let h1 = dom_create("h1") in
  dom_text(h1, "Seven Primes, One Ring");
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.6em, 6vw, 3em)");
  dom_style(h1, "fontWeight", "normal");
  dom_style(h1, "letterSpacing", "clamp(1px, 0.5vw, 4px)");
  dom_append(hero, h1);
  let sub = dom_create("div") in
  dom_text(sub, "214,414,200 = 8 * 9 * 25 * 49 * 11 * 13 * 17");
  ct_mono(sub);
  dom_style(sub, "fontSize", "clamp(13px, 3vw, 16px)");
  dom_style(sub, "color", "#b0b0c0");
  dom_style(sub, "marginTop", "12px");
  dom_append(hero, sub);
  render_p(hero, "The Chinese Remainder Theorem decomposes this number into seven independent channels -- one per prime factor. This site explores what that structure contains: ~2000 proved theorems, 40 interactive demos, and a self-compiling language. Everything is verifiable. Everything is CC0.");
  let feats = dom_create("div") in
  dom_style(feats, "display", "flex");
  dom_style(feats, "flexWrap", "wrap");
  dom_style(feats, "justifyContent", "center");
  dom_style(feats, "gap", "12px");
  dom_style(feats, "maxWidth", "700px");
  dom_style(feats, "margin", "24px auto 0");
  let mk_feat = fn(label:str, color:str) = (
    let f = dom_create("span") in
    dom_text(f, label);
    dom_style(f, "padding", "6px 14px");
    dom_style(f, "borderRadius", "20px");
    dom_style(f, "border", "1px solid " + color);
    dom_style(f, "color", color);
    dom_style(f, "fontSize", "0.85em");
    dom_style(f, "letterSpacing", "1px");
    dom_append(feats, f)
  ) in
  mk_feat("Self-hosting compiler", "#ffd700");
  mk_feat("Live REPL", "#44ff88");
  mk_feat("40 CC0 demos", "#4fc3f7");
  mk_feat("FPGA verified", "#ff9944");
  mk_feat("189 live proofs", "#ff44aa");
  dom_append(hero, feats);
  dom_append(dom_body(), hero);

  home_axiom()
)

/* Worldview: CRT decomposer -- enter any number, see CRT in TRANS ring Z/214414200 */
fn worldview_crt_calc() = (
  let n = parse_int_from("#wv-input") in
  let result = dom_query("#wv-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let m = n % N_TRANS in
    let r2 = m % 8 in
    let r3 = m % 9 in
    let r5 = m % 25 in
    let r7 = m % 49 in
    let r11 = m % 11 in
    let r13 = m % 13 in
    let r17 = m % 17 in
    let g = gcd_shared(m, N_TRANS) in
    let coupling = if g > 0 then N_TRANS / g else N_TRANS in
    let named = if m == 0 then "VOID: 0*n = 0. Total ambiguity."
      else if m == 1 then "SIGMA: identity. sigma*n = n."
      else if m == OMEGA_TRANS then "OMEGA: terminal projector. D^420. CRT=(0,1,1,1,1,1,1)."
      else if m == 214414199 then "MIRROR: -1 = N-1."
      else if m == 41 then "KEY: self-inverse. Sum of decality."
      else if m == 42 then "ANSWER: D*K*b. The rainbow angle."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${m} mod 214414200</p><p style='margin:4px 0'>CRT = (<b style='color:#ffd700'>${r2}</b>, <b style='color:#ff9900'>${r3}</b>, <b style='color:#33dd55'>${r5}</b>, <b style='color:#4488ff'>${r7}</b>, <b style='color:#aa44ff'>${r11}</b>, <b style='color:#ff4466'>${r13}</b>, <b style='color:#00dddd'>${r17}</b>) mod (8,9,25,49,11,13,17)</p><p style='margin:4px 0'>Coupling: ${coupling}</p><p style='margin:4px 0;color:#b8b8c8'>${named}</p>");
    /* Draw 7-channel bar chart -- colors match text above */
    let cvs = dom_query("#wv-chart") in
    let ctx = cvs_getctx(cvs) in
    let _cl = cvs_clearrect(ctx, 0, 0, 385, 100) in
    let h2 = r2 * 76 / 8 in
    let _s1 = cvs_fillstyle(ctx, "#ffd700") in
    let _d1 = cvs_fillrect(ctx, 14, 76 - h2, 36, h2) in
    let h3 = r3 * 76 / 9 in
    let _s2 = cvs_fillstyle(ctx, "#ff9900") in
    let _d2 = cvs_fillrect(ctx, 62, 76 - h3, 36, h3) in
    let h5 = r5 * 76 / 25 in
    let _s3 = cvs_fillstyle(ctx, "#33dd55") in
    let _d3 = cvs_fillrect(ctx, 110, 76 - h5, 36, h5) in
    let h7 = r7 * 76 / 49 in
    let _s4 = cvs_fillstyle(ctx, "#4488ff") in
    let _d4 = cvs_fillrect(ctx, 158, 76 - h7, 36, h7) in
    let h11 = r11 * 76 / 11 in
    let _s5 = cvs_fillstyle(ctx, "#aa44ff") in
    let _d5 = cvs_fillrect(ctx, 206, 76 - h11, 36, h11) in
    let h13 = r13 * 76 / 13 in
    let _s6 = cvs_fillstyle(ctx, "#ff4466") in
    let _d6 = cvs_fillrect(ctx, 254, 76 - h13, 36, h13) in
    let h17 = r17 * 76 / 17 in
    let _s7 = cvs_fillstyle(ctx, "#00dddd") in
    let _d7 = cvs_fillrect(ctx, 302, 76 - h17, 36, h17) in
    let _sf = cvs_fillstyle(ctx, "#888888") in
    let _t1 = cvs_filltext(ctx, "D", 26, 94) in
    let _t2 = cvs_filltext(ctx, "K", 74, 94) in
    let _t3 = cvs_filltext(ctx, "E", 122, 94) in
    let _t4 = cvs_filltext(ctx, "b", 170, 94) in
    let _t5 = cvs_filltext(ctx, "L", 218, 94) in
    let _t6 = cvs_filltext(ctx, "G", 266, 94) in
    let _t7 = cvs_filltext(ctx, "17", 310, 94) in
    0
  )
)

/* Derive: Cunningham chain stepper -- enter seed, walk c(n)=2n+1 */
fn derive_cunningham_calc() = (
  let seed = parse_int_from("#der-input") in
  let result = dom_query("#der-result") in
  if seed < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter seed >= 1.</p>")
  else (
    let c0 = seed in
    let c1 = 2 * c0 + 1 in
    let c2 = 2 * c1 + 1 in
    let c3 = 2 * c2 + 1 in
    let c4 = 2 * c3 + 1 in
    let c5 = 2 * c4 + 1 in
    let p0 = if is_prime_trial(c0) == 1 then "prime" else "composite" in
    let p1 = if is_prime_trial(c1) == 1 then "prime" else "composite" in
    let p2 = if is_prime_trial(c2) == 1 then "prime" else "composite" in
    let p3 = if is_prime_trial(c3) == 1 then "prime" else "composite" in
    let p4 = if is_prime_trial(c4) == 1 then "prime" else "composite" in
    let p5 = if is_prime_trial(c5) == 1 then "prime" else "composite" in
    dom_inner(result, "<p style='margin:2px 0;color:#d8d8e0'>c^0 = ${c0} (${p0})</p><p style='margin:2px 0;color:#d8d8e0'>c^1 = ${c1} (${p1})</p><p style='margin:2px 0;color:#d8d8e0'>c^2 = ${c2} (${p2})</p><p style='margin:2px 0;color:#d8d8e0'>c^3 = ${c3} (${p3})</p><p style='margin:2px 0;color:#d8d8e0'>c^4 = ${c4} (${p4})</p><p style='margin:2px 0;color:#d8d8e0'>c^5 = ${c5} (${p5})</p><p style='margin:4px 0;color:#b0b0c0'>Axiom chains: c(1)={1,3,7,15=STOP}. c(2)={2,5,11,23...}. Try both.</p>")
  )
)

/* Turbulence: balance factor calculator */
fn turbulence_balance_calc() = (
  let p = parse_int_from("#turb-input") in
  let result = dom_query("#turb-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter prime p >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else (
    let num = 2 * (p - 1) in
    let den = p + 1 in
    let g = gcd_shared(num, den) in
    let sn = num / g in
    let sd = den / g in
    let special = if p == 2 then "D: factor 2/3. First departure from balance."
      else if p == 3 then "K: factor 1 = TRANSPARENT. Closure preserves balance."
      else if p == 5 then "E: factor 4/3. Observer skews."
      else if p == 7 then "b: factor 3/2 = K/D. Depth."
      else if p == 11 then "L: factor 5/3 = KOLMOGOROV. Protection breaks balance."
      else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Prime p = ${p}</p><p style='margin:4px 0'>Balance factor = 2(p-1)/(p+1) = ${num}/${den} = <b style='color:#ffd700'>${sn}/${sd}</b></p><p style='margin:4px 0;color:#b8b8c8'>${special}</p>")
  )
)

/* Sleep: channel lock stage identifier */
fn sleep_stage_calc() = (
  let stage = parse_int_from("#sleep-input") in
  let result = dom_query("#sleep-result") in
  if stage < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter stage (0-5).</p>")
  else if stage > 5 then dom_inner(result, "<p style='color:#ff6666'>Max stage = 5.</p>")
  else (
    let info = if stage == 0 then "AWAKE: All 7 channels active. Full coupling. GATE = skin. ESCAPE = transcendence."
      else if stage == 1 then "Stage N1: D=2 locks. Bridge down. Hypnagogia."
      else if stage == 2 then "Stage N2: K=3 locks. Closure down. Sleep spindles."
      else if stage == 3 then "Stage N3: E=5 locks. Observer down. Deep sleep. Positivity."
      else if stage == 4 then "Stage N4: b=7 locks. Depth down. Deepest non-REM."
      else "VOID: L=11 locks. Total silence. 1 class. All 8.17 bits recovered on waking." in
    let channels = if stage == 0 then "D K E b L G Esc = 7 active"
      else if stage == 1 then "_ K E b L G Esc = 6 active (GATE+ESCAPE hold)"
      else if stage == 2 then "_ _ E b L G Esc = 5 active (GATE+ESCAPE hold)"
      else if stage == 3 then "_ _ _ b L G Esc = 4 active (GATE+ESCAPE hold)"
      else if stage == 4 then "_ _ _ _ L G Esc = 3 active (GATE+ESCAPE hold)"
      else "_ _ _ _ _ G Esc = 2 active (boundary persists)" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Sleep stage ${stage}</p><p style='margin:4px 0;color:#ffd700'>${info}</p><p style='margin:4px 0;color:#b0b0c0'>Channels: ${channels}</p>")
  )
)

/* Kingdoms: coupling calculator -- enter n, show kingdom (S1305: 7 rings) */
fn kingdoms_coupling_calc() = (
  let n = parse_int_from("#king-input") in
  let result = dom_query("#king-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let d2 = if n % 2 == 0 then 1 else 0 in
    let d3 = if n % 3 == 0 then 1 else 0 in
    let d5 = if n % 5 == 0 then 1 else 0 in
    let d7 = if n % 7 == 0 then 1 else 0 in
    let d11 = if n % 11 == 0 then 1 else 0 in
    let d13 = if n % 13 == 0 then 1 else 0 in
    let d17 = if n % 17 == 0 then 1 else 0 in
    let primes_dividing = d2 + d3 + d5 + d7 + d11 + d13 + d17 in
    let kingdom = if n == 0 then "VOID: divisible by all. Below all kingdoms."
      else if primes_dividing == 0 then "BACTERIA (sigma): coprime to all. Ground state. Max coupling."
      else if primes_dividing == 1 then (if d2 == 1 then "PROTISTA (D=2): Bridge." else if d3 == 1 then "FUNGI (K=3): Closure." else if d5 == 1 then "PLANTS (E=5): Observer." else if d7 == 1 then "ANIMALS (b=7): Depth." else if d11 == 1 then "HUMAN (L=11): Protector." else if d13 == 1 then "GUARDIAN (GATE=13): Skin." else "VIRUS (ESCAPE=17): Transcendence.")
      else "COMPOUND: ${primes_dividing} primes divide. Mixed class." in
    let ch = "D:${d2} K:${d3} E:${d5} b:${d7} L:${d11} G:${d13} Esc:${d17}" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${n} in ring hierarchy</p><p style='margin:4px 0'>${ch}</p><p style='margin:4px 0;color:#ffd700'>${kingdom}</p>")
  )
)

/* ================================================================
   DERIVE PAGE -- From 0/0 to 12612600 in 10 steps (the Decality)
   ================================================================ */

fn render_derive_step(parent, num:str, title:str, text:str, result:str) = (
  let step = dom_create("div") in
  dom_style(step, "marginBottom", "48px");
  dom_style(step, "padding", "24px");
  dom_style(step, "background", "#080810");
  dom_style(step, "borderRadius", "12px");
  dom_style(step, "borderLeft", "3px solid #ffd700");
  let h3 = dom_create("h3") in
  dom_text(h3, "Step ${num}: ${title}");
  ct_gold(h3);
  dom_style(h3, "fontSize", "1.2em");
  dom_style(h3, "fontFamily", "'Courier New', monospace");
  dom_style(h3, "marginBottom", "12px");
  dom_append(step, h3);
  let p = dom_create("p") in
  dom_text(p, text);
  dom_style(p, "margin", "0 0 12px");
  dom_append(step, p);
  let res = dom_create("div") in
  ct_code_block(res);
  dom_style(res, "color", "#88ddaa");
  dom_text(res, result);
  dom_append(step, res);
  dom_append(parent, step)
)

fn page_derive() = (
  dom_head_meta("description", "11-step interactive walkthrough: from 0/0 through seven primes to Z/214414200Z. Each step forced by necessity. Zero free parameters. The chain, the ring, the organism, the escape.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Derivation\",\"description\":\"11 steps from 0/0 through seven primes to Z/214414200Z. Each forced by necessity. Zero free parameters.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/basics/derive\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"indeterminacy\"},{\"@type\":\"DefinedTerm\",\"name\":\"Seven Primes\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT decomposition\"}]}");
  /* === HERO -- D-channel primary: derivation = bridging. Each step crosses a gap. === */
  let hero = make_hero("How Everything Derives from Nothing") in
  render_big_num(hero, "0 / 0", "#ffd700", "the starting point", "= the entire ring");
  render_p(hero, "Each derivation step crosses a gap -- 11 steps from void to the complete ring. No free parameters. No choices. 2 is the instrument: once the identity precipitates, duality opens all structure.");
  dom_append(dom_body(), hero);

  /* === THE ELEVEN STEPS -- D-channel: each step = one bridge crossing === */
  let sec = make_section("800px") in
  render_h2(sec, "The Derivation: Eleven Steps");
  render_p(sec, "From nothing (0/0) through seven primes to the final ring. Each step bridges one state into two, then the next prime precipitates from the pair. Not chosen. Forced.");

  render_derive_step(sec, "0", "Nothing Divides Nothing",
    "Start with nothing. Not empty space -- truly nothing. What is 0 divided by 0? In school: undefined. In ring theory: the set of ALL elements n where 0*n = 0. Since 0 times anything IS 0, the answer is everything. The void contains the whole ring.",
    "0/0 in Z/NZ = {0, 1, 2, ..., N-1} = the entire ring. PROVED.");

  render_derive_step(sec, "1", "The Identity Must Exist",
    "If 0/0 is an entire ring, that ring must have an identity element -- the number that preserves everything under multiplication. 1 * n = n for all n. The identity is the UNIQUE element with zero self-division ambiguity: 1/1 has exactly one solution. Existence is not assumed -- it is forced by the ring axioms.",
    "identity = 1. Self-division: 1/1 = 1 (unique). 0/0 = N (maximal).");

  render_derive_step(sec, "2", "The First Distinction",
    "From 1, the simplest new thing is 2. You need distinction before you can close. 2 = the minimum to have this versus that. Left versus right. Yes versus no. The first departure from unity. The observation of 1 by 1 creates duality.",
    "2. The pair. 2^3 = 8 (Pareto depth 3 -- unique among the seven prime towers).");

  render_derive_step(sec, "3", "Closure Requires Three",
    "Two can disagree forever. Three can vote. 3 is the minimum for majority -- the smallest number that makes triangles rigid and decisions possible. 3 = 2*1 + 1, generated from 1 by the Cunningham map c(n) = 2n+1.",
    "c(1) = 3. First safe prime in the 1-chain.");

  render_derive_step(sec, "5", "The Observer Appears",
    "5. Generated from 2 (not from 3!) by Cunningham: c(2) = 5. The observer comes from distinction, not closure. 5 has a unique property: 5^2 = 25, and the mod-25 channel in CRT cannot see itself. CRT(25) = (1, 7, 0, 25, 3) -- the mod-25 channel is zero. The observer's square is blind in its own channel.",
    "c(2) = 5. 5^2 = 25 (self-blind: CRT mod-25 channel = 0).");

  render_derive_step(sec, "7", "Depth Reaches Down",
    "7. Generated from 3 by Cunningham: c(3) = 7. The 1-chain generates {3, 7}. The 2-chain generates {5, 11}. Two disjoint chains, interleaved: 1, 2, 3, 5, 7, 11. 7 is depth -- the fourth inner prime, the deepest chain element before 11 seals the walk.",
    "c(3) = 7. 1-chain: {1, 3, 7}. 2-chain: {2, 5, 11}.");

  render_derive_step(sec, "11", "The Protector Seals the Ring",
    "11. Generated from 5: c(5) = 11. But 11 = 1 + 2 + 3 + 5 -- the SUM of all previous primes. The protector. In the 5-channel ring (mod 2, 3, 5, 7, 11), the mod-11 channel serves as checksum -- it enables 100% single-error detection. And then both chains STOP: c(7) = 15 = 3*5 (composite, not prime). c(11) = 23 but the fattening formula gives exponent 0 at depth 3. The axiom's own products create its boundary.",
    "c(5) = 11 = 1+2+3+5. c(7) = 15 = 3*5 [composite: STOP]. Self-closing.");

  let d3 = D * D * D in
  let k2 = K * K in
  let e2 = E * E in
  let b2 = b * b in
  render_derive_step(sec, "N", "The Ring Crystallizes",
    "The five inner primes need specific exponents. The Cross-Chain Fattening Theorem (PROVED): 2-chain primes get descending exponents (2 gets 3, 5 gets 2, 11 gets 1). 1-chain primes get constant exponent 2 (3 gets 2, 7 gets 2). Each chain's law uses the OTHER chain's identity. The flower contains its own seed.",
    "2^3 x 3^2 x 5^2 x 7^2 x 11 = 970,200 (the body ring).");

  let omega = OMEGA_VAL in
  let lam = D * D * K * E * b in
  render_derive_step(sec, "420", "The Heartbeat Is Born",
    "Lambda is the Carmichael function: the largest order of any element. For 970,200, lambda = 420. Every element's power map cycles with period dividing 420. This is not unique to 970,200 -- 108 rings hit lambda = 420 exactly (7^2 = 49 forced). Of those 108, exactly 84 divide 12,612,600 (the heartbeat siblings); the remaining 24 extend beyond.",
    "lambda = 4 x 3 x 5 x 7 = ${lam} = 420. 108 rings share this pulse (84 divide 12,612,600).");

  render_derive_step(sec, "13", "The Boundary Wraps the Body",
    "13 is the first prime NOT generated by the Cunningham chains. 13 = 4 + 9 = 2^2 + 3^2 (the squares of the first two chain primes). Its shadow is 6 = 2*3 (composite -- the chain breaks here). Also 13 = 5 + 1 + 7. Adding 13 wraps a boundary around the body. Lambda stays 420. 970,200 x 13 = 12,612,600. The complete organism with skin.",
    "13: the boundary. 970,200 x 13 = 12,612,600. 2^420 mod 12,612,600 = 1,576,576. CRT = (0,1,1,1,1,1). 490 split: {2,5,7} project to 0, {3,11,13} survive.");

  render_derive_step(sec, "17", "The Escape",
    "17 = 2 + 3 + 5 + 7: the sum of the four data primes. And 17 has a unique property: 5 x 7 = 35 = 1 mod 17. For any prime p > 13, the equation 5*7 = 1 mod p holds ONLY for p = 17. No eighth prime satisfies the finality condition. phi(17) = 16 = 2^4 -- a pure power of duality. Seven channels = 7 = the depth prime: the channel count IS the depth prime. 12,612,600 x 17 = 214,414,200. The final ring.",
    "17: the escape. 5 x 7 = 1 mod 17 (unique for p > 13). phi(17) = 2^4. 12,612,600 x 17 = 214,414,200. 7 channels. lambda = 1680 = 4 x 420. Triple-parity ECC: mod-11 + mod-13 + mod-17. Rate 4/7, 100% correction.");

  dom_append(dom_body(), sec);

  /* === THE GENESIS PROOF -- GATE-channel: boundary verification, proofs guard the claims === */
  let sp = make_section("800px") in
  render_h2(sp, "Why This Is Forced, Not Chosen");
  render_p(sp, "The derivation above is not a narrative. It is a proof. Four independent lines of evidence converge on the same seven primes at the same exponents.");

  render_theorem(sp, "The Genesis Theorem (PROVED)",
    "From {1, 2} and the Cunningham map c(n) = 2n+1: the 1-chain produces {1, 3, 7}. The 2-chain produces {2, 5, 11}. Both chains self-terminate: c(7) = 15 = 3*5 (composite) and fattening gives exponent 0 at depth 3. The axiom's own products close the boundary. No external stop condition needed.");

  render_theorem(sp, "Cross-Chain Fattening Theorem (PROVED)",
    "2-chain primes: exponent = 3 - depth. 5 gets 2, 11 gets 1, 2 gets 3. 1-chain primes: exponent = 2 (constant). 3 gets 2, 7 gets 2. Each chain's rule is governed by the OTHER chain's identity. Verification: 2^3=8, 5^2=25, 11^1=11, 3^2=9, 7^2=49. Product: 970,200. The exponents are the axiom in reverse.");

  render_theorem(sp, "Seed Optimality (PROVED)",
    "{1, 2} is the unique irreducible seed. Minimal (identity + first prime). Disjoint (the two chains share no elements). Symmetric (each contributes 3 axiom elements). {2, 3} produces the same primes but 3 = 2+1 is already derived. The genesis starts at {1, 2} and nowhere else.");

  render_theorem(sp, "Spectral Agreement (independent verification)",
    "Three independent spectral proofs give the same exponents. D^3: arcsine kurtosis threshold (Personality Theorem). K^2, E^2, b^2: spectral hearing threshold. L^1: error detection threshold. The algebra and the spectrum agree. The exponents are overdetermined.");

  render_theorem(sp, "Finality Theorem (PROVED)",
    "17 is the UNIQUE prime p > 13 satisfying 5*7 = 1 mod p (since 5*7 = 35 and 35 - 1 = 34 = 2*17, the only prime factor > 13 is 17). No eighth prime exists. The organism has exactly seven primes, seven channels = 7 = depth. phi(17) = 2^4 (Fermat prime). Adding 17 quadruples the heartbeat: lambda = 1680 = 4*420. The escape is self-closing.");

  dom_append(dom_body(), sp);

  /* === THE DECALITY SUMMARY -- Cross-tower: the full Decality assembles all ten === */
  let sd = make_section("800px") in
  render_h2(sd, "The Complete Organism");
  render_p(sd, "Eleven steps. No assumptions. No free parameters. Starting from literally nothing (0/0), we derived seven primes, one heartbeat (period 420), 108 rings sharing that heartbeat (84 divide 12,612,600, 24 extend beyond), a boundary (13) that wraps the organism in skin, and an escape (17) where 5 x 7 = 1 mod 17 and the heartbeat quadruples to 1680. Three rings: Z/970,200 (body), Z/12,612,600 (organism), Z/214,414,200 (final form).");
  let primes = make_grid(sd, "8px") in
  render_prime(primes, "-1", "mirror", "n -> N-n", "#888");
  render_prime(primes, "0", "void", "0*n=0", "#555");
  render_prime(primes, "1", "identity", "1*n=n", "#ff6b6b");
  render_prime(primes, "2", "pair", "duality", "#ffd700");
  render_prime(primes, "3", "closure", "triangles", "#ff9900");
  render_prime(primes, "5", "observer", "self-blind", "#33dd55");
  render_prime(primes, "7", "depth", "deepest reach", "#4488ff");
  render_prime(primes, "11", "protector", "error correction", "#aa44ff");
  render_prime(primes, "13", "boundary", "2^2 + 3^2", "#00cccc");
  render_prime(primes, "17", "escape", "5*7=1 mod 17", "#00dddd");
  render_prime(primes, "1576576", "projector", "2^420", "#fff");
  render_p(sd, "The ten-term sum (without -1 and projector): 0+1+2+3+5+7+11+13 = 42. With -1: 41. 17 is the 7th prime: 5 x 7 = 1 mod 17. Seven channels = 7 = depth. 214,414,200 = the final ring. Nothing added, nothing assumed, nothing chosen.");
  dom_append(dom_body(), sd);

  /* === INTERACTIVE -- K-channel: closure of chains, self-termination === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cunningham Chain");
  render_p(sec_i, "Enter a seed number. Walk the Cunningham map c(n) = 2n+1. The axiom chains start at 1 and 2. Try both: c(1) = {1,3,7,15=STOP}. c(2) = {2,5,11,23...}.");
  make_interactive_widget(sec_i, "Seed:", "der-input", "e.g. 1", "Walk", "derive_cunningham_calc", "der-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST TABLE -- E-channel: observation, comparing two views === */
  let sc = make_section("800px") in
  render_h2(sc, "Contrast");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Question");
  render_th(chdr, "Standard Physics");
  render_th(chdr, "The Axiom");
  dom_append(ctbl, chdr);
  render_contrast_row(ctbl, "Where do the laws come from?", "Unknown / given", "Derived from 0/0");
  render_contrast_row(ctbl, "Why these constants?", "25+ free parameters", "0 free parameters");
  render_contrast_row(ctbl, "Why seven primes?", "Not a question", "13 closes the organism. 17 completes it (5*7=1 mod 17). Self-terminating.");
  render_contrast_row(ctbl, "Why this universe?", "Anthropic principle / luck", "Only option from the void");
  render_contrast_row(ctbl, "How many rings?", "Infinite landscape / multiverse", "108 rings share period 420 exactly (84 divide 12,612,600, 24 extend beyond)");
  render_contrast_row(ctbl, "What is nothing?", "Empty space + quantum fields", "0/0 = the entire ring");
  dom_append(sc, ctbl);
  dom_append(dom_body(), sc);

  /* === VERIFY -- ESCAPE-channel: transcend the page, go verify === */
  let sv = make_section("800px") in
  render_h2(sv, "Verify It Yourself");
  render_p(sv, "Every formula on this page runs in .ax. Open the REPL, type the derivation, see the numbers. Break it. Rebuild it. The chain holds.");
  let cta = dom_create("div") in
  dom_style(cta, "textAlign", "center");
  dom_style(cta, "padding", "32px 0");
  let btn = dom_create("a") in
  dom_attr(btn, "href", "/repl");
  dom_text(btn, "Verify every step in the REPL");
  dom_style(btn, "display", "inline-block");
  dom_style(btn, "padding", "12px 36px");
  dom_style(btn, "border", "2px solid #ffd700");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "textDecoration", "none");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_append(cta, btn);
  dom_append(sv, cta);
  dom_append(dom_body(), sv)
)

