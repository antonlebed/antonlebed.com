/* fano_e8 widget: shadow polynomial P(x) */
fn fe_compute() = (
  let x = parse_int_from("#fe-input") in
  let result = dom_query("#fe-result") in
  if x < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter x >= 1.</p>")
  else (
    let p = (x - 1) * (x - 2) * (x - 3) * (x - 5) in
    let name = if x == 1 then "1: P(1) = 0. Identity is a root."
      else if x == 2 then "2: P(2) = 0. The even prime is a root."
      else if x == 3 then "3: P(3) = 0. The triangle prime is a root."
      else if x == 5 then "5: P(5) = 0. The golden-ratio prime is a root."
      else if x == 7 then "7: P(7) = 240 = |roots(E8)| = 2^4 * 3 * 5."
      else if x == 9 then "9: P(9) = 1344 = 8 * |PSL(2,7)|."
      else if x == 11 then "11: P(11) = 10*9*8*6 = 4320."
      else if x == 13 then "13: P(13) = 12*11*10*8 = 10560."
      else if x == 17 then "17: P(17) = 16*15*14*12 = 40320 = 8!."
      else "" in
    let nstr = if len(name) > 0 then "<p style='color:#ffd700;margin:4px 0'>" + name + "</p>" else "" in
    /* Check smoothness of p */
    mut v = p;
    while v % 2 == 0 do (mut v = v / 2);
    while v % 3 == 0 do (mut v = v / 3);
    while v % 5 == 0 do (mut v = v / 5);
    while v % 7 == 0 do (mut v = v / 7);
    while v % 11 == 0 do (mut v = v / 11);
    let sm = if p == 0 then "<span style='color:#ffd700'>ROOT (zero)</span>"
      else if v == 1 then "<span style='color:#88ddaa'>11-SMOOTH</span>"
      else "<span style='color:#ff6666'>NOT SMOOTH</span> (cofactor " + "${v}" + ")" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>P(" + "${x}" + ") = (" + "${x}" + "-1)(" + "${x}" + "-2)(" + "${x}" + "-3)(" + "${x}" + "-5) = " + "${p}" + "</p>" + nstr + "<p style='margin:4px 0'>" + sm + "</p>")
  )
)

fn page_fano_e8() = (
  dom_head_meta("description", "E8 root count 240 = [S_8 : GL(3,F_2)] = P(7). GL(3,F_2) = PSL(2,F_7) = unique simple group of order 168. Fano plane: 7 points, 3 per line. Hamming [7,4,3] at rate 4/7. Extended Hamming [8,4,4] gives E8 via Construction A. Golay [23,12,7] exhausts binary perfect codes. Leech lattice in 24 dimensions. Monster group: all 7 axiom-prime exponents smooth.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Fano Plane and E8\",\"description\":\"E8 root count 240 = [S_8 : GL(3,F_2)] = P(7). Fano = Hamming [7,4,3], rate 4/7. Extended Hamming [8,4,4] gives E8 via Construction A. Golay [23,12,7] exhausts binary perfect codes. Leech lattice: kissing 196560, all axiom-smooth. Monster group: all 7 exponents smooth.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/fano_e8\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Fano plane\"},{\"@type\":\"DefinedTerm\",\"name\":\"E8\"},{\"@type\":\"DefinedTerm\",\"name\":\"Hamming code\"},{\"@type\":\"DefinedTerm\",\"name\":\"Golay code\"},{\"@type\":\"DefinedTerm\",\"name\":\"Leech lattice\"},{\"@type\":\"DefinedTerm\",\"name\":\"Monster group\"},{\"@type\":\"DefinedTerm\",\"name\":\"error-correcting codes\"}]}");
  /* === HERO === */
  let hero = make_hero("Fano Plane and E8") in
  let big = dom_create("div") in
  dom_text(big, "240 * 168 = 8!");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The shadow polynomial P(x) = (x-1)(x-2)(x-3)(x-5) evaluated at 7 gives 240, the E8 root count. The Fano plane's symmetry group PSL(2,7) has 168 elements. Their product is 8! = 40,320. The Fano plane is the Hamming [7,4,3] code at rate 4/7. Extending to [8,4,4] gives the E8 lattice via Construction A. The Golay code [23,12,7] completes the picture: together with Hamming, these exhaust all binary perfect codes.");
  dom_append(dom_body(), hero);

  /* === SEC 1: E8 INDEX THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The E8 Index Theorem");
  render_theorem(sec1, "E8 Index (PROVED)", "|roots(E8)| = [S_8 : GL(3, F_2)]. The E8 root count equals the index of the Fano automorphism group GL(3, F_2) inside S_8. Proof: |GL(3, F_2)| = (8-1)(8-2)(8-4) = 7*6*4 = 168. Index = 8!/168 = 240. QED.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "P(7) = 240", "6 * 5 * 4 * 2 = 240", "= 2^4 * 3 * 5 = |roots(E8)|. The shadow polynomial at 7.", "");
  render_finding(g1, "P(9) = 1344", "8 * 7 * 6 * 4 = 1344", "= 8 * 168. Shadow polynomial at 9 = 8 times the Fano symmetry group order.", "");
  render_finding(g1, "P(17) = 40320", "16 * 15 * 14 * 12 = 40320", "= 8!. Shadow polynomial at 17 = the full symmetric group on 8 letters.", "");
  dom_append(dom_body(), sec1);

  /* === SEC 2: DUALITY ISOMORPHISM === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Duality Isomorphism");
  render_p(sec2, "The ring's most striking group-theoretic fact: two seemingly unrelated groups are the same.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "GL(3, F_2)", "168 elements", "3 dimensions over the 2-element field. Acts on PG(2,2) = Fano plane with 7 points.", "");
  render_finding(g2, "PSL(2, F_7)", "168 elements", "2 dimensions over the 7-element field. Acts on PG(1,7) with 8 points.", "");
  render_theorem(sec2, "Duality Isomorphism (PROVED)", "GL(3, F_2) = PSL(2, F_7). Both are the unique simple group of order 168. Three dimensions over F_2 = two dimensions over F_7. The primes 3 and 7 swap roles through the prime 2.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: FANO PLANE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Fano Plane");
  render_p(sec3, "PG(2, F_2) = the projective plane over F_2. Seven points. Seven lines. Three points per line. One shared point per pair of lines. Parameters (7, 3, 1) = Steiner triple system S(2,3,7). Point count = (2^3 - 1)/(2 - 1) = 7.");
  render_p(sec3, "The Catalan equation 3^2 = 2^3 + 1 (Mihailescu 2002) ties four identities together: 2^3 - 1 = 7 (Fano points), 2^3 + 1 = 9 (the only consecutive prime powers), 9 - 2 = 7, 9 + 2 = 11. One equation = four theorems.");
  dom_append(dom_body(), sec3);

  /* === SEC 5: ROOT ANATOMY === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "E8 Root Anatomy");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "700px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Root type");
  render_th(rhdr, "Count");
  render_th(rhdr, "Coordinates");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "Basis roots", "112 = 2^4 * 7", "(+/-1, +/-1, 0^6) permutations");
  render_table_row(rtbl, "Code roots", "128 = 2^7", "(+/-1/2)^8 with even minus count");
  render_table_row(rtbl, "Total", "240 = 112 + 128", "= 2^4 * 3 * 5");
  dom_append(sec5, rtbl);
  render_p(sec5, "The factorizations 240 = 2^4 * 3 * 5 and 168 = 2^3 * 3 * 7 share {2,3}. Their unique primes are 5 and 7. Product: 240 * 168 = 8! = 40,320.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: NINE PATHS + OCTONIONS === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Nine Paths to 240");
  let eptbl = dom_create("table") in
  dom_style(eptbl, "width", "100%");
  dom_style(eptbl, "maxWidth", "700px");
  dom_style(eptbl, "margin", "24px auto");
  dom_style(eptbl, "borderCollapse", "collapse");
  let ephdr = dom_create("tr") in
  render_th(ephdr, "Path");
  render_th(ephdr, "Formula");
  render_th(ephdr, "Field");
  dom_append(eptbl, ephdr);
  render_table_row(eptbl, "1. Index", "[S_8 : GL(3, F_2)] = 8!/168", "Combinatorics");
  render_table_row(eptbl, "2. Shadow", "P(7) = 6*5*4*2", "Spectral theory");
  render_table_row(eptbl, "3. Geometry", "112 + 128 (basis + code roots)", "Root systems");
  render_table_row(eptbl, "4. Factorial", "2 * 5! = 2 * 120", "Factorial algebra");
  render_table_row(eptbl, "5. Eisenstein", "-2k/B_k at k = 4", "Modular forms");
  render_table_row(eptbl, "6. Kissing", "tau(8) = 240 spheres", "Sphere packing");
  render_table_row(eptbl, "7. Pisano", "lcm(pi(2), pi(3), pi(5), pi(7), pi(11))", "Fibonacci mod");
  render_table_row(eptbl, "8. Fibonacci", "pi(210) = 240", "Pisano period");
  render_table_row(eptbl, "9. Cascade", "8 * 5 * 3 * 2 = 240", "Iterated halving");
  dom_append(sec6, eptbl);
  render_p(sec6, "Nine independent paths to 240 = 2^4 * 3 * 5. All routes converge on the same factorization.");
  dom_append(dom_body(), sec6);

  /* === SEC 7: OCTONIONS + HAMMING === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Octonions and Hamming Code");
  render_p(sec7, "The Fano plane governs octonion multiplication: 7 imaginary units, 3 per multiplication rule (each line), 8 total basis elements. Octonions are the last normed division algebra (Hurwitz 1898). R(1) -> C(2) -> H(4) -> O(8). Cayley-Dickson doubles each time; the sedenions (16 dimensions) lose alternativity.");
  render_p(sec7, "The E8 lattice comes from the [8,4,4] extended Hamming code. The original [7,4,3] Hamming has Aut = GL(3, F_2), the same 168-element group. Extension adds a parity check bit: 7 + 1 = 8. E8 = union of 2 copies of D_8 offset by a codeword. GL(3, F_2) is the symmetry at every step.");
  dom_append(dom_body(), sec7);

  /* === SEC 8: EXCEPTIONALITY === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "E8 Exceptionality");
  render_theorem(sec8, "E8 Unique Index (PROVED)", "Among all exceptional Lie algebras {G2, F4, E6, E7, E8}, only E8 has root count = [S_n : GL(k, F_q)] for any k >= 2. Exhaustive search over n <= 15, q in {2,3,5,7,11,13}. GL(3, F_2) is the unique GL(k, F_q) with order 168.");
  dom_append(dom_body(), sec8);

  /* === SEC 9A: FANO LABELING (THM 145) === */
  let sec_inc = make_section("800px") in
  render_h2(sec_inc, "Fano Labeling");
  render_theorem(sec_inc, "Fano Labeling (PROVED)", "The seven primes {2, 3, 5, 7, 11, 13, 17} label the Fano plane so that all 7 line-sums are 11-smooth. Unique up to GL(3, F_2) symmetry. The lines {3, 5, 7} (sum 15, product 105) and {3, 11, 13} (sum 27, product 429) both appear. Total 11-smooth labelings = 84 = 168/2.");
  let gi = make_findings_grid(sec_inc) in
  render_finding(gi, "{3, 5, 7} line", "sum = 15 = 3*5, product = 105", "The three odd primes below 11 form a Fano line.", "");
  render_finding(gi, "{3, 11, 13} line", "sum = 27 = 3^3, product = 429", "Includes 11 (parity checksum: 1+2+3+5 = 11) and 13 = 2^2 + 3^2.", "");
  render_finding(gi, "84 = 168/2", "Aut(Fano) / stabilizer", "The sole orbit under GL(3, F_2) has stabilizer Z/2. 84 total smooth labelings.", "");
  dom_append(dom_body(), sec_inc);

  /* === SEC 9B: HAMMING CODE BRIDGE (THMS 146+147) === */
  let sec_ham = make_section("800px") in
  render_h2(sec_ham, "Hamming Code");
  render_theorem(sec_ham, "Fano-Hamming (PROVED)", "The Fano plane PG(2, F_2) is the Hamming [7, 4, 3] code. Rate = 4/7. Codewords = 2^4 = 16. Syndromes = 2^3 = 8. The code is PERFECT: the Hamming sphere of radius 1 covers all of F_2^7 exactly (1 + 7 = 8 = 2^3).");
  render_theorem(sec_ham, "Syndrome Decoder (PROVED)", "Single-error correction for all 7 positions via syndrome decoding. The syndrome is the F_2^3 coordinate of the corrupted position. The primes {3, 11, 13} have syndrome-XOR = 0 (they form a codeword). The primes {2, 5, 7} have nonzero syndromes.");
  let gh = make_findings_grid(sec_ham) in
  render_finding(gh, "[7, 4, 3]", "n = 7, k = 4, d = 3", "Length, dimension, distance. Rate 4/7.", "");
  render_finding(gh, "Perfect code", "1 + 7 = 2^3 = 8", "Hamming bound exactly met. 2^4 codewords * 2^3 sphere = 2^7 = 128 total vectors.", "");
  dom_append(dom_body(), sec_ham);

  /* === SEC 9C: EXTENDED HAMMING E8 (THM 148) === */
  let sec_ext = make_section("800px") in
  render_h2(sec_ext, "Extended Hamming and E8");
  render_theorem(sec_ext, "Extended Hamming E8 (PROVED)", "Extended Hamming [8, 4, 4]: all parameters are powers of 2. Self-dual (C = C^perp). Extension adds a parity bit: 7 + 1 = 8 (Fano plane + one point = the 3-cube). E8 via Construction A: 224 + 16 = 240 = |roots(E8)|. |Aut([8,4,4])| = P(9) = 1344.");
  let ge = make_findings_grid(sec_ext) in
  render_finding(ge, "[8, 4, 4]", "n = 8, k = 4, d = 4", "All powers of 2. Half-rate code: k/n = 1/2.", "");
  render_finding(ge, "7 + 1 = 8", "Fano + parity = cube", "The Fano plane plus one point is the 3-dimensional cube over F_2.", "");
  render_finding(ge, "Construction A", "224 + 16 = 240", "Weight-4 codewords give 2 * 7 * 16 = 224 roots. Weight-0/8 give 16. Total = 240 = P(7).", "");
  render_finding(ge, "|Aut| = P(9)", "1344 = 8 * 168", "Shadow polynomial at 9 = the automorphism group order of [8,4,4].", "");
  dom_append(dom_body(), sec_ext);

  /* === SEC 9D: GOLAY CODES (THMS 150+155) === */
  let sec_gol = make_section("800px") in
  render_h2(sec_gol, "Golay Codes");
  render_theorem(sec_gol, "Binary Golay (PROVED)", "Binary Golay [23, 12, 7]: n = 2*11 + 1, k = 12, d = 7. Check bits = 23 - 12 = 11. Error correction = 3. Weight enumerator: A_7 = 253 = 11*23. Complementary weight-pair differences are {9, 7, 1}, summing to 17. Sphere volume = 2^11 = 2048. |M_23| = P(17) * 253 = 40320 * 253 = 10,200,960.");
  render_theorem(sec_gol, "Perfect Code Exhaustion (PROVED)", "Binary Golay [23, 12, 7] and ternary Golay [11, 6, 5] exhaust all nontrivial perfect codes beyond Hamming (Tietavainen-van Lint). Alphabets are 2 and 3 only -- the first two primes. Together with Hamming [7, 4, 3]: exactly two families of binary perfect codes.");
  let gg = make_findings_grid(sec_gol) in
  render_finding(gg, "[23, 12, 7]", "n = 23, k = 12, d = 7", "Check bits = 11. Correction capability = 3. All parameters related to the ring's primes.", "");
  render_finding(gg, "Weight-pair diffs", "{9, 7, 1} sum to 17", "Pairs (7,16), (8,15), (11,12) have diffs 9, 7, 1. Sum = 17.", "");
  render_finding(gg, "Two alphabets", "Binary (2) and ternary (3) only", "Ternary Golay [11, 6, 5]. Perfect codes exist only over alphabets 2 and 3.", "");
  render_finding(gg, "Two binary families", "Hamming + Golay = all", "Tietavainen-van Lint: these two exhaust all binary perfect codes.", "");
  dom_append(dom_body(), sec_gol);

  /* === SEC 9F: LEECH LATTICE (THM 151) === */
  let sec_leech = make_section("800px") in
  render_h2(sec_leech, "Leech Lattice");
  render_p(sec_leech, "The Leech lattice in 24 dimensions is built from the extended Golay code [24, 12, 8] via Construction A. Its parameters are all axiom-native, and the Mathieu group exponent sums trace a staircase through the axiom chain.");
  render_theorem(sec_leech, "Leech Axiom Lattice (PROVED)", "dim = 24 = 2^3 * 3. min_norm = 4 = 2^2. kissing = 196,560 = 2^4 * 3^3 * 5 * 7 * 13 (zero intruders). E8-to-Leech lift = kissing(Leech) / kissing(E8) = 196560 / 240 = 819 = 9 * 7 * 13. Steiner system S(5,8,24) has 759 = 3 * 11 * 23 blocks. 24 Niemeier lattices = dim(Leech). All parameters axiom-smooth.");
  let gl = make_findings_grid(sec_leech) in
  render_finding(gl, "kissing = 196,560", "2^4 * 3^3 * 5 * 7 * 13", "The kissing number uses exactly the first 6 axiom primes. Zero intruder primes. ESCAPE absent.", "");
  render_finding(gl, "Leech/E8 = 819", "9 * 7 * 13 = K^2 * b * GATE", "The lift factor from E8 to Leech is a product of three axiom primes.", "");
  render_finding(gl, "Mathieu staircase", "{8, 11, 12, 13, 17}", "Exponent sums of M_11 through M_24 trace {D^3, L, 12, GATE, ESCAPE} -- the chain elements.", "");
  render_finding(gl, "Conway |Co_0|", "exp_sum = 40 = 2^3 * 5", "The Conway group exponent sum is D^3 * E. Mathieu degree gap = 22 - 12 = 10 = Decality.", "");
  dom_append(dom_body(), sec_leech);

  /* === SEC 9G: MONSTER GROUP (THM 152) === */
  let sec_mon = make_section("800px") in
  render_h2(sec_mon, "Monster Group");
  render_p(sec_mon, "The Monster group is the largest sporadic simple group. All seven axiom-prime exponents in its order are axiom-smooth. The Monster-Conway excess reveals a direct connection to the Leech lattice dimension.");
  render_theorem(sec_mon, "Monster Axiom Exponent (PROVED)", "v_2(M) = 46 = 2*23, v_3(M) = 20 = 4*5, v_5(M) = 9 = 3^2, v_7(M) = 6 = 2*3, v_11(M) = 2, v_13(M) = 3, v_17(M) = 1. All axiom-smooth. Axiom exp sum = 87 = 3*29. DATA exp sum = 81 = 3^4. Monster-Conway excess: {24, 11, 5, 4, 1, 2} = {dim(Leech), L, E, D^2, sigma, D}. The 2-excess is exactly 24 = the Leech lattice dimension. The 5-excess is a fixed point: E maps to itself.");
  let gm = make_findings_grid(sec_mon) in
  render_finding(gm, "All 7 exponents smooth", "46, 20, 9, 6, 2, 3, 1", "The seven axiom-prime valuations of |Monster| use only axiom primes in their own factorizations.", "");
  render_finding(gm, "2-excess = 24", "46 - 22 = dim(Leech)", "The Monster needs exactly 24 more factors of 2 than Conway -- the Leech lattice dimension.", "");
  render_finding(gm, "5-excess = 5", "9 - 4 = E (fixed point)", "The observer prime is a fixed point of the Monster-Conway excess map.", "");
  render_finding(gm, "7-excess sum = 48", "= phi(210) = phi(DATA)", "The total 7-prime excess equals Euler's totient of the DATA ring.", "");
  dom_append(dom_body(), sec_mon);

  /* === SEC 9E: FANO CONSENSUS EQUIVALENCE === */
  let sec_cons = make_section("800px") in
  render_h2(sec_cons, "Fano Consensus");
  render_theorem(sec_cons, "Fano Consensus Equivalence (PROVED)", "Two-level Fano voting (2/3 majority per line, then 4/7 of line-votes) produces identical outcomes to flat 4/7 majority for all 128 input patterns. The Fano plane's BIBD structure decomposes flat consensus without changing any outcome. Both schemes are self-dual and monotone.");
  let gc = make_findings_grid(sec_cons) in
  render_finding(gc, "128/128 agree", "0 disagreements", "Exhaustive verification over all 2^7 binary patterns.", "");
  render_finding(gc, "490 split", "K=3 DEAD lines, 4 ALIVE lines", "ALIVE-majority lines = 4/7 = ECC rate. Total DEAD across lines = 9 = 3^2.", "");
  render_finding(gc, "HYDOR = consensus", "K*E*b = 105", "The Fano line {3,5,7} has product 105. The same three coprime primes form the hierarchical consensus levels: 2/3, 3/5, 4/7.", "");
  render_finding(gc, "Depth = K = 3", "4th level needs 9 = STOP", "Consensus depth saturates at K=3 levels. K^2=9 per group -> chain wall.", "");
  dom_append(dom_body(), sec_cons);

  /* === CONTRAST === */
  let sec9 = make_section("800px") in
  render_h2(sec9, "Contrast Table");
  render_contrast_row(sec9, "E8", "Exceptional Lie algebra with 240 roots, studied in high energy physics", "240 = [S_8 : GL(3, F_2)] = P(7). Nine independent paths to the same number. Factorization 2^4 * 3 * 5 uses only three small primes.");
  render_contrast_row(sec9, "Fano plane", "Smallest projective plane, 7 points, combinatorial curiosity", "Parameters (7, 3, 1) are the ring's primes. Automorphism group GL(3, F_2) = PSL(2, F_7): the duality isomorphism.");
  render_contrast_row(sec9, "240 and 168", "Root count and group order, no obvious connection to small primes", "Product = 8! = 40,320. Factorizations share {2, 3}; unique primes are 5 and 7. Ratio = 240/168 = 10/7.");
  render_contrast_row(sec9, "Perfect codes", "Hamming and Golay are known perfect codes, parameters seem arbitrary", "Hamming [7, 4, 3] and Golay [23, 12, 7]: all parameters trace to small primes. Perfect codes exist only over alphabets {2, 3}. These two families exhaust all binary perfect codes.");
  dom_append(dom_body(), sec9);

  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Shadow Polynomial P(x)");
  render_p(sec_i, "P(x) = (x-1)(x-2)(x-3)(x-5). Roots at {1, 2, 3, 5}. Enter x to evaluate and check 11-smoothness.");
  make_interactive_widget(sec_i, "Evaluate P(x) at x =", "fe-input", "e.g. 7", "Evaluate", "fe_compute", "fe-result");
  render_p(sec_i, "Try: 7 (P(7) = 240 = E8 roots), 9 (P(9) = 1344), 13 (P(13) = 10560), 17 (P(17) = 40320 = 8!).");
  dom_append(dom_body(), sec_i)
)
