/* page_crt_stats.ax -- CRT Significance Testing prototype.
   Z/21 = Z/3 x Z/7. Permutation test on amino acid hydrophobicity.
   Approach C: data chooses its own ring. The ring IS the test design.
   S1209: Phase C strange loop -- CRT as statistical test framework. */

/* Kyte-Doolittle hydrophobicity x10 + 50 (offset avoids ring negative wrap).
   AA order: alphabetical 1-letter code (A=0 .. Y=19, *=20). */
fn cs_h(i) = if i==0 then 68 else if i==1 then 75 else if i==2 then 15 else if i==3 then 15 else if i==4 then 78 else if i==5 then 46 else if i==6 then 18 else if i==7 then 95 else if i==8 then 11 else if i==9 then 88 else if i==10 then 69 else if i==11 then 15 else if i==12 then 34 else if i==13 then 15 else if i==14 then 5 else if i==15 then 42 else if i==16 then 43 else if i==17 then 92 else if i==18 then 41 else if i==19 then 37 else 50

/* Display strings for hydrophobicity (signed, human-readable) */
fn cs_hs(i) = if i==0 then "+1.8" else if i==1 then "+2.5" else if i==2 then "-3.5" else if i==3 then "-3.5" else if i==4 then "+2.8" else if i==5 then "-0.4" else if i==6 then "-3.2" else if i==7 then "+4.5" else if i==8 then "-3.9" else if i==9 then "+3.8" else if i==10 then "+1.9" else if i==11 then "-3.5" else if i==12 then "-1.6" else if i==13 then "-3.5" else if i==14 then "-4.5" else if i==15 then "-0.8" else if i==16 then "-0.7" else if i==17 then "+4.2" else if i==18 then "-0.9" else if i==19 then "-1.3" else "+0.0"

fn cs_aa(i) = if i==0 then "A" else if i==1 then "C" else if i==2 then "D" else if i==3 then "E" else if i==4 then "F" else if i==5 then "G" else if i==6 then "H" else if i==7 then "I" else if i==8 then "K" else if i==9 then "L" else if i==10 then "M" else if i==11 then "N" else if i==12 then "P" else if i==13 then "Q" else if i==14 then "R" else if i==15 then "S" else if i==16 then "T" else if i==17 then "V" else if i==18 then "W" else if i==19 then "Y" else "*"

/* H statistic: sum of squared group sums, grouping 21 elements by index mod p.
   Equal group sizes guaranteed: 21/3=7, 21/7=3. Higher H = more between-group spread.
   Specialized for p=3 and p=7 to avoid mut-in-while perf bug (H2.11 S1232). */
fn cs_hstat3(arr) = (
  let s0 = arr[0]+arr[3]+arr[6]+arr[9]+arr[12]+arr[15]+arr[18] in
  let s1 = arr[1]+arr[4]+arr[7]+arr[10]+arr[13]+arr[16]+arr[19] in
  let s2 = arr[2]+arr[5]+arr[8]+arr[11]+arr[14]+arr[17]+arr[20] in
  s0*s0 + s1*s1 + s2*s2
)
fn cs_hstat7(arr) = (
  let s0 = arr[0]+arr[7]+arr[14] in
  let s1 = arr[1]+arr[8]+arr[15] in
  let s2 = arr[2]+arr[9]+arr[16] in
  let s3 = arr[3]+arr[10]+arr[17] in
  let s4 = arr[4]+arr[11]+arr[18] in
  let s5 = arr[5]+arr[12]+arr[19] in
  let s6 = arr[6]+arr[13]+arr[20] in
  s0*s0+s1*s1+s2*s2+s3*s3+s4*s4+s5*s5+s6*s6
)

/* Group sum for a single group g under mod p grouping */
fn cs_gsum(arr, p, g) = (
  mut s = 0; mut i = g;
  while i < 21 do (s = s + arr[i]; mut i = i + p);
  s
)

/* Build group sum arrays for CRT channels. Returns grand sum. No while loop. */
fn cs_r2_build(arr, gm3, gm7) = (
  set(gm3, 0, arr[0]+arr[3]+arr[6]+arr[9]+arr[12]+arr[15]+arr[18]);
  set(gm3, 1, arr[1]+arr[4]+arr[7]+arr[10]+arr[13]+arr[16]+arr[19]);
  set(gm3, 2, arr[2]+arr[5]+arr[8]+arr[11]+arr[14]+arr[17]+arr[20]);
  set(gm7, 0, arr[0]+arr[7]+arr[14]);
  set(gm7, 1, arr[1]+arr[8]+arr[15]);
  set(gm7, 2, arr[2]+arr[9]+arr[16]);
  set(gm7, 3, arr[3]+arr[10]+arr[17]);
  set(gm7, 4, arr[4]+arr[11]+arr[18]);
  set(gm7, 5, arr[5]+arr[12]+arr[19]);
  set(gm7, 6, arr[6]+arr[13]+arr[20]);
  gm3[0] + gm3[1] + gm3[2]
)

/* R^2 x 1000 from CRT reconstruction via f64 (S1324, dissolves integer overflow workaround).
   Predicted: 21*y_hat = 3*g3[i%3] + 7*g7[i%7] - S.
   Residual: 21*(y - y_hat) = 21*x - 3*g3 - 7*g7 + S. Separated loop for H2.11. */
fn cs_r2_loop(arr, gm3, gm7, grand) = (
  mut ss_tot = toFloat(0); mut ss_res = toFloat(0);
  mut i = 0;
  while i < 21 do (
    let dev = toFloat(21 * arr[i] - grand) in
    let res = toFloat(21 * arr[i] - 3 * gm3[i % 3] - 7 * gm7[i % 7] + grand) in
    mut ss_tot = ss_tot + dev * dev;
    mut ss_res = ss_res + res * res;
    mut i = i + 1
  );
  if ss_tot == toFloat(0) then 1000
  else toInt(toFloat(1000) * (toFloat(1) - ss_res / ss_tot))
)

/* Compute R^2 x 1000 for 21 elements in Z/3 x Z/7. */
fn cs_r2(arr) = (
  let gm3 = alloc(3) in
  let gm7 = alloc(7) in
  let grand = cs_r2_build(arr, gm3, gm7) in
  cs_r2_loop(arr, gm3, gm7, grand)
)

/* Simple LCG RNG. 137 coprime to N_TRUE (137 is prime, not in {2,3,5,7,11,13}). */
fn cs_rng(s) = s * 137 + 73

/* Copy src to dst (21 elements) then Fisher-Yates shuffle. Returns new seed.
   Extracted as function to avoid mut-in-while perf bug (H2.11 S1232). */
fn cs_copy_shuffle(dst, src, seed) = (
  mut k = 0;
  while k < 21 do (set(dst, k, src[k]); mut k = k + 1);
  mut s = seed;
  mut si = 20;
  while si > 0 do (
    mut s = cs_rng(s);
    let j = s % (si + 1) in
    let tmp = dst[si] in set(dst, si, dst[j]); set(dst, j, tmp);
    mut si = si - 1
  );
  s
)

/* Permutation loop: compute exceedance counts. Returns results in out array.
   Separated from display to avoid H2.11 compiler perf bug (many let+mut in one fn). */
fn cs_perm_loop(hydro, seed_in, out) = (
  let h3 = cs_hstat3(hydro) in
  let h7 = cs_hstat7(hydro) in
  let perm = alloc(21) in
  mut c3 = 0; mut c7 = 0; mut cb = 0;
  mut seed = seed_in + 42;
  mut p = 0;
  while p < 500 do (
    mut seed = cs_copy_shuffle(perm, hydro, seed);
    let ph3 = cs_hstat3(perm) in
    let ph7 = cs_hstat7(perm) in
    if ph3 >= h3 then mut c3 = c3 + 1 else 0;
    if ph7 >= h7 then mut c7 = c7 + 1 else 0;
    if ph3 >= h3 then (if ph7 >= h7 then mut cb = cb + 1 else 0) else 0;
    mut p = p + 1
  );
  set(out, 0, h3); set(out, 1, h7); set(out, 2, c3); set(out, 3, c7); set(out, 4, cb);
  0
)

/* Display perm test results. Separated to keep cs_perm_test's function body small
   (many let+template in one fn triggers H2.11 compiler perf bug). */
fn cs_perm_show(rel, seed_in, hydro, h3, h7, c3, c7, cb, r2_obs) = (
  let np = 500 in
  /* Group sums inlined — calling cs_gsum (which has mut+while) poisons the entire call chain (H2.11) */
  let g30 = hydro[0]+hydro[3]+hydro[6]+hydro[9]+hydro[12]+hydro[15]+hydro[18] in
  let g31 = hydro[1]+hydro[4]+hydro[7]+hydro[10]+hydro[13]+hydro[16]+hydro[19] in
  let g32 = hydro[2]+hydro[5]+hydro[8]+hydro[11]+hydro[14]+hydro[17]+hydro[20] in
  let obs_x_np = cb * np in
  let exp_joint = c3 * c7 in
  dom_inner(rel, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>" +
    "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>CRT Permutation Test (n=500, seed=${seed_in})</p>" +
    "<table style='width:100%;border-collapse:collapse;margin:8px 0'>" +
    "<tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Channel</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>H observed</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Exceedances</th></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#44cc44'>K (mod 3)</td><td style='padding:6px;color:#b0b0c0'>${h3}</td><td style='padding:6px;color:#b0b0c0'>${c3} / ${np}</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#4488ff'>b (mod 7)</td><td style='padding:6px;color:#b0b0c0'>${h7}</td><td style='padding:6px;color:#b0b0c0'>${c7} / ${np}</td></tr>" +
    "<tr><td style='padding:6px;color:#ffd700;font-weight:bold'>JOINT</td><td style='padding:6px;color:#b0b0c0'>--</td><td style='padding:6px;color:#ffd700;font-weight:bold'>${cb} / ${np}</td></tr></table>" +
    "<p style='color:#ff8844;margin:12px 0 4px;font-size:14px;font-weight:bold'>R&sup2; reconstruction: ${r2_obs / 10}.${r2_obs % 10}% | null: 37.0% | excess: ${(r2_obs - 370) / 10}%</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>R&sup2; is computed on the observed data (fixed, independent of seed). It measures how much CRT channel group means explain the data. Null E[R&sup2;] = 1 - (1-2/20)(1-6/20) = 37% for n=21 in Z/3 x Z/7. Excess above null = genuine signal.</p>" +
    "<p style='color:#b0b0c0;margin:8px 0 4px;font-size:13px'>Group sums (mod 3, offset +50): ${g30}, ${g31}, ${g32}. Grand sum: 952.</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>Independence: joint*500=${obs_x_np}, expected c3*c7=${exp_joint}. Similar = channels independent.</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>Traditional: eigenvalue-hydrophobicity r=0.409, p=0.073 (marginal, S1208).</p>" +
    "</div>")
)

/* Build hydro array (extracted — having a while loop + calling cs_gsum in same fn triggers H2.11) */
fn cs_build_hydro(arr) = (
  mut i = 0;
  while i < 21 do (set(arr, i, cs_h(i)); mut i = i + 1);
  0
)

/* Permutation test callback -- triggered by button click.
   NO while loops in this function body — all computation in helper fns (H2.11 workaround). */
fn cs_perm_test() = (
  let seed_in = parse_int_from("#cstats-input") in
  let rel = dom_query("#cstats-result") in
  let hydro = alloc(21) in
  cs_build_hydro(hydro);
  let r = alloc(5) in
  cs_perm_loop(hydro, seed_in, r);
  let r2 = cs_r2(hydro) in
  cs_perm_show(rel, seed_in, hydro, r[0], r[1], r[2], r[3], r[4], r2)
)
)

/* === SYNTHETIC VALIDATION ===
   Generate data with known channel structure. Test if CRT finds it.
   Three scenarios: signal in mod 3, signal in mod 7, pure noise.
   For each: 20 trials, 50 permutations per trial. Report detection rate. */

/* Generate synthetic data: base value depends on channel, plus noise.
   mode=0: noise only. mode=3: signal in mod-3. mode=7: signal in mod-7. */
fn cs_synth(arr, seed, mode) = (
  mut s = seed;
  mut i = 0;
  while i < 21 do (
    mut s = cs_rng(s);
    let noise = s % 30 in
    let base = if mode == 3 then (i % 3) * 25
      else if mode == 7 then (i % 7) * 10
      else 0 in
    set(arr, i, 20 + base + noise);
    mut i = i + 1
  );
  s
)

/* Generate synthetic data with parameterized signal strength.
   str=0: pure noise. str=30: strong signal. Signal = group_index * str.
   mode=3: signal in mod-3 groups. mode=7: signal in mod-7 groups. */
fn cs_synth_str(arr, seed, mode, str) = (
  mut s = seed;
  mut i = 0;
  while i < 21 do (
    mut s = cs_rng(s);
    let noise = s % 30 in
    let base = if mode == 3 then (i % 3) * str
      else if mode == 7 then (i % 7) * str
      else 0 in
    set(arr, i, 20 + base + noise);
    mut i = i + 1
  );
  s
)

/* Run one power-curve trial at given signal strength. Returns detection bits. */
fn cs_power_trial(seed, mode, str, threshold) = (
  let data = alloc(21) in
  let perm = alloc(21) in
  mut s = cs_synth_str(data, seed, mode, str);
  let h3_obs = cs_hstat3(data) in
  let h7_obs = cs_hstat7(data) in
  mut c3 = 0; mut c7 = 0; mut cb = 0;
  mut p = 0;
  while p < 50 do (
    mut s = cs_copy_shuffle(perm, data, s);
    let ph3 = cs_hstat3(perm) in
    let ph7 = cs_hstat7(perm) in
    if ph3 >= h3_obs then mut c3 = c3 + 1 else 0;
    if ph7 >= h7_obs then mut c7 = c7 + 1 else 0;
    if ph3 >= h3_obs then (if ph7 >= h7_obs then mut cb = cb + 1 else 0) else 0;
    mut p = p + 1
  );
  let d3 = if c3 < threshold then 1 else 0 in
  let d7 = if c7 < threshold then 2 else 0 in
  let dj = if cb < threshold then 4 else 0 in
  d3 + d7 + dj
)

/* Run power sweep at one strength level. 15 trials. Results in out[0..2]. */
fn cs_power_at(seed_base, mode, str, thr, out) = (
  mut det3 = 0; mut det7 = 0; mut detj = 0;
  mut seed = seed_base;
  mut t = 0;
  while t < 15 do (
    mut seed = cs_rng(seed);
    let r = cs_power_trial(seed, mode, str, thr) in
    if r % 2 == 1 then mut det3 = det3 + 1 else 0;
    if (r / 2) % 2 == 1 then mut det7 = det7 + 1 else 0;
    if (r / 4) % 2 == 1 then mut detj = detj + 1 else 0;
    mut t = t + 1
  );
  set(out, 0, det3); set(out, 1, det7); set(out, 2, detj);
  0
)

/* Power curve callback: sweep signal strength 0..30 for mod-3 signal.
   Shows detection rate vs effect size — the S-curve of statistical power. */
fn cs_power_curve() = (
  let seed_in = parse_int_from("#cspower-input") in
  let rel = dom_query("#cspower-result") in
  let thr = 2 in
  let r = alloc(3) in
  /* 7 strength levels: 0, 5, 10, 15, 20, 25, 30 — signal in mod-3 */
  cs_power_at(seed_in + 100, 3, 0, thr, r);
  let d30 = r[0] in let d70 = r[1] in let dj0 = r[2] in
  cs_power_at(seed_in + 200, 3, 5, thr, r);
  let d35 = r[0] in let d75 = r[1] in let dj5 = r[2] in
  cs_power_at(seed_in + 300, 3, 10, thr, r);
  let d310 = r[0] in let d710 = r[1] in let dj10 = r[2] in
  cs_power_at(seed_in + 400, 3, 15, thr, r);
  let d315 = r[0] in let d715 = r[1] in let dj15 = r[2] in
  cs_power_at(seed_in + 500, 3, 20, thr, r);
  let d320 = r[0] in let d720 = r[1] in let dj20 = r[2] in
  cs_power_at(seed_in + 600, 3, 25, thr, r);
  let d325 = r[0] in let d725 = r[1] in let dj25 = r[2] in
  cs_power_at(seed_in + 700, 3, 30, thr, r);
  let d330 = r[0] in let d730 = r[1] in let dj30 = r[2] in
  dom_inner(rel, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>" +
    "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>Power Curve: mod-3 signal (15 trials x 50 perms, seed ${seed_in})</p>" +
    "<table style='width:100%;border-collapse:collapse;margin:8px 0;table-layout:fixed;word-wrap:break-word'>" +
    "<tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Strength</th><th style='text-align:left;padding:6px;color:#44cc44;font-size:12px'>mod-3 (signal)</th><th style='text-align:left;padding:6px;color:#4488ff;font-size:12px'>mod-7 (null)</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Joint</th></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>0 (noise)</td><td style='padding:6px;color:#b0b0c0'>${d30}/15</td><td style='padding:6px;color:#b0b0c0'>${d70}/15</td><td style='padding:6px;color:#b0b0c0'>${dj0}/15</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>5</td><td style='padding:6px;color:#b0b0c0'>${d35}/15</td><td style='padding:6px;color:#b0b0c0'>${d75}/15</td><td style='padding:6px;color:#b0b0c0'>${dj5}/15</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>10</td><td style='padding:6px;color:#b0b0c0'>${d310}/15</td><td style='padding:6px;color:#b0b0c0'>${d710}/15</td><td style='padding:6px;color:#b0b0c0'>${dj10}/15</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>15</td><td style='padding:6px;color:#b0b0c0'>${d315}/15</td><td style='padding:6px;color:#b0b0c0'>${d715}/15</td><td style='padding:6px;color:#b0b0c0'>${dj15}/15</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>20</td><td style='padding:6px;color:#b0b0c0'>${d320}/15</td><td style='padding:6px;color:#b0b0c0'>${d720}/15</td><td style='padding:6px;color:#b0b0c0'>${dj20}/15</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#888'>25</td><td style='padding:6px;color:#b0b0c0'>${d325}/15</td><td style='padding:6px;color:#b0b0c0'>${d725}/15</td><td style='padding:6px;color:#b0b0c0'>${dj25}/15</td></tr>" +
    "<tr><td style='padding:6px;color:#888'>30</td><td style='padding:6px;color:#b0b0c0'>${d330}/15</td><td style='padding:6px;color:#b0b0c0'>${d730}/15</td><td style='padding:6px;color:#b0b0c0'>${dj30}/15</td></tr></table>" +
    "<p style='color:#b0b0c0;margin:8px 0 4px;font-size:13px'>At strength 0 (noise), expect ~1/15 detection (~5%). As strength grows, the signal channel (mod-3) should rise toward 15/15 while the null channel (mod-7) stays near ~1/15. This S-curve is the power function.</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>CRT channel independence means the non-signal channel acts as a built-in negative control. No separate control group needed.</p>" +
    "</div>")
)

/* Run one trial: generate data, compute H, run permutation test, return 1 if p<threshold */
fn cs_trial(seed, mode, threshold) = (
  let data = alloc(21) in
  let perm = alloc(21) in
  mut s = cs_synth(data, seed, mode);
  let h3_obs = cs_hstat3(data) in
  let h7_obs = cs_hstat7(data) in
  /* 50 permutations — reduced from 200 for interactive speed (H2.11 S1232) */
  mut c3 = 0; mut c7 = 0; mut cb = 0;
  mut p = 0;
  while p < 50 do (
    mut s = cs_copy_shuffle(perm, data, s);
    let ph3 = cs_hstat3(perm) in
    let ph7 = cs_hstat7(perm) in
    if ph3 >= h3_obs then mut c3 = c3 + 1 else 0;
    if ph7 >= h7_obs then mut c7 = c7 + 1 else 0;
    if ph3 >= h3_obs then (if ph7 >= h7_obs then mut cb = cb + 1 else 0) else 0;
    mut p = p + 1
  );
  /* Return detection: which channels detected at threshold.
     Encode as: 1=mod3 detected, 2=mod7 detected, 4=joint detected */
  let d3 = if c3 < threshold then 1 else 0 in
  let d7 = if c7 < threshold then 2 else 0 in
  let dj = if cb < threshold then 4 else 0 in
  d3 + d7 + dj
)

/* Run one validation scenario (n_trials trials). Returns [det3, det7, detj] in out.
   Extracted as function to avoid H2.11 perf bug in cs_validate. */
fn cs_run_scenario(seed_base, mode, thr, n_trials, out) = (
  mut det3 = 0; mut det7 = 0; mut detj = 0;
  mut seed = seed_base;
  mut t = 0;
  while t < n_trials do (
    mut seed = cs_rng(seed);
    let r = cs_trial(seed, mode, thr) in
    if r % 2 == 1 then mut det3 = det3 + 1 else 0;
    if (r / 2) % 2 == 1 then mut det7 = det7 + 1 else 0;
    if (r / 4) % 2 == 1 then mut detj = detj + 1 else 0;
    mut t = t + 1
  );
  set(out, 0, det3); set(out, 1, det7); set(out, 2, detj);
  0
)

fn cs_validate() = (
  let seed_in = parse_int_from("#csval-input") in
  let rel = dom_query("#csval-result") in
  /* 20 trials × 50 perms = 1000 shuffles per scenario. Interactive-fast.
     Original: 100 × 200 = 60000 total — froze browser (H2.11 S1232). */
  let thr = 2 in
  let n_trials = 20 in
  let r = alloc(3) in
  /* Scenario 1: signal in mod 3 */
  cs_run_scenario(seed_in + 1, 3, thr, n_trials, r);
  let det3_m3 = r[0] in let det7_m3 = r[1] in let detj_m3 = r[2] in
  /* Scenario 2: signal in mod 7 */
  cs_run_scenario(seed_in + 1000, 7, thr, n_trials, r);
  let det3_m7 = r[0] in let det7_m7 = r[1] in let detj_m7 = r[2] in
  /* Scenario 3: pure noise */
  cs_run_scenario(seed_in + 2000, 0, thr, n_trials, r);
  let det3_n = r[0] in let det7_n = r[1] in let detj_n = r[2] in
  /* Display results */
  dom_inner(rel, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>" +
    "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>Synthetic Validation (20 trials x 50 perms)</p>" +
    "<table style='width:100%;border-collapse:collapse;margin:8px 0'>" +
    "<tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Scenario</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>mod-3 detects</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>mod-7 detects</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Joint detects</th></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#44cc44'>Signal in mod 3</td><td style='padding:6px;color:#44cc44;font-weight:bold'>${det3_m3}/20</td><td style='padding:6px;color:#b0b0c0'>${det7_m3}/20</td><td style='padding:6px;color:#b0b0c0'>${detj_m3}/20</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#4488ff'>Signal in mod 7</td><td style='padding:6px;color:#b0b0c0'>${det3_m7}/20</td><td style='padding:6px;color:#4488ff;font-weight:bold'>${det7_m7}/20</td><td style='padding:6px;color:#b0b0c0'>${detj_m7}/20</td></tr>" +
    "<tr><td style='padding:6px;color:#888'>Pure noise</td><td style='padding:6px;color:#888'>${det3_n}/20</td><td style='padding:6px;color:#888'>${det7_n}/20</td><td style='padding:6px;color:#888'>${detj_n}/20</td></tr></table>" +
    "<p style='color:#b0b0c0;margin:8px 0 4px;font-size:13px'>Expected under null: ~1/20 detections (~5% rate). Signal rows should be HIGH for the matching channel and ~1/20 for non-matching. Noise row should be ~1/20 across all.</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>If CRT works: diagonal is high, off-diagonal is low, noise is ~1/20. This validates the method.</p>" +
    "</div>")
)

/* === S1327: USER DATA INPUT ===
   Parse comma-separated integers from DOM input.
   Skips whitespace. Handles negatives. Returns integer array. */
fn cs_parse_csv_from(id:str) = (
  let inp = dom_query(id) in
  let s = dom_value(inp) in
  let n = len(s) in
  mut count = 0;
  mut i = 0;
  while i < n do (
    if charCode(s, i) == 44 then mut count = count + 1 else 0;
    mut i = i + 1
  );
  let result = alloc(count + 1) in
  mut ri = 0;
  mut val = 0;
  mut neg = 0;
  mut i = 0;
  while i < n do (
    let c = charCode(s, i) in
    if c == 44 then (
      set(result, ri, if neg == 1 then 0 - val else val);
      mut ri = ri + 1;
      mut val = 0;
      mut neg = 0
    ) else if c == 45 then mut neg = 1
    else if c > 47 then (if c < 58 then (mut val = val * 10 + c - 48; mut has_digit = 1) else 0)
    else 0;
    mut i = i + 1
  );
  set(result, ri, if neg == 1 then 0 - val else val);
  result
)

/* Display user data test results (separated for H2.11) */
fn cs_user_show(rel, arr, h3, h7, c3, c7, cb, r2_obs) = (
  let np = 500 in
  let g30 = arr[0]+arr[3]+arr[6]+arr[9]+arr[12]+arr[15]+arr[18] in
  let g31 = arr[1]+arr[4]+arr[7]+arr[10]+arr[13]+arr[16]+arr[19] in
  let g32 = arr[2]+arr[5]+arr[8]+arr[11]+arr[14]+arr[17]+arr[20] in
  let grand = g30 + g31 + g32 in
  dom_inner(rel, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>" +
    "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>Your Data: CRT Test in Z/21 = Z/3 x Z/7 (n=500 permutations)</p>" +
    "<table style='width:100%;border-collapse:collapse;margin:8px 0;table-layout:fixed;word-wrap:break-word'>" +
    "<tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Channel</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>H observed</th><th style='text-align:left;padding:6px;color:#ffd700;font-size:12px'>Exceedances</th></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#44cc44'>K (mod 3)</td><td style='padding:6px;color:#b0b0c0'>${h3}</td><td style='padding:6px;color:#b0b0c0'>${c3} / ${np}</td></tr>" +
    "<tr style='border-bottom:1px solid #222'><td style='padding:6px;color:#4488ff'>b (mod 7)</td><td style='padding:6px;color:#b0b0c0'>${h7}</td><td style='padding:6px;color:#b0b0c0'>${c7} / ${np}</td></tr>" +
    "<tr><td style='padding:6px;color:#ffd700;font-weight:bold'>JOINT</td><td style='padding:6px;color:#b0b0c0'>--</td><td style='padding:6px;color:#ffd700;font-weight:bold'>${cb} / ${np}</td></tr></table>" +
    "<p style='color:#ff8844;margin:12px 0 4px;font-size:14px;font-weight:bold'>R&sup2; reconstruction: ${r2_obs / 10}.${r2_obs % 10}% | null: 37.0% | excess: ${(r2_obs - 370) / 10}%</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>Grand sum: ${grand}. Group sums (mod 3): ${g30}, ${g31}, ${g32}.</p>" +
    "<p style='color:#b0b0c0;margin:4px 0;font-size:13px'>R&sup2; above 37% null baseline = genuine CRT channel structure in your data.</p>" +
    "</div>")
)

/* User data error display */
fn cs_user_err(rel, got) =
  dom_inner(rel, "<div style='background:#0a0a18;border:1px solid #ff4444;border-radius:8px;padding:16px;margin:8px 0'>" +
    "<p style='color:#ff4444;margin:0;font-size:14px'>Need exactly 21 comma-separated integers for Z/21 = Z/3 x Z/7. Got ${got} values.</p></div>")

/* User data test callback */
fn cs_user_test() = (
  let arr = cs_parse_csv_from("#csuser-input") in
  let rel = dom_query("#csuser-result") in
  if len(arr) != 21 then cs_user_err(rel, len(arr))
  else (
    let r = alloc(5) in
    cs_perm_loop(arr, 42, r);
    let r2 = cs_r2(arr) in
    cs_user_show(rel, arr, r[0], r[1], r[2], r[3], r[4], r2)
  )
)

/* ========== PAGE RENDERING ========== */
fn page_crt_stats() = (
  dom_head_meta("description", "CRT Significance Testing: evidence tuple (per-channel p-values + R-squared) with power curve. Test your own data in Z/21 = Z/3 x Z/7. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Significance Testing\",\"description\":\"Evidence tuple with power curve and user data input: per-channel p-values, R-squared reconstruction, and detection-vs-effect-size analysis via CRT decomposition. Z/21 prototype with custom data support.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/crt_stats\"}");

  /* === HERO === */
  let hero = make_hero("CRT Significance Testing") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/21 = Z/3 x Z/7");
  ct_mono(eq);
  dom_style(eq, "fontSize", "28px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Replace single p-values with the evidence tuple: per-channel p-values plus reconstruction R-squared. Decompose data into algebraically independent channels via CRT. The ring IS the test design. No parameters. No model fitting. R-squared measures how much the decomposition explains.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE DATA === */
  let sec1 = make_section("900px") in
  render_h2(sec1, "The Data: 21 Amino Acids in Z/21");
  render_p(sec1, "Kyte-Doolittle hydrophobicity scale for 20 amino acids + Stop, indexed 0-20 alphabetically. Z/21 = Z/3 x Z/7 gives each index two independent coordinates: K-channel (mod 3) and b-channel (mod 7). Groups are equal-sized: 7 per mod-3 group, 3 per mod-7 group.");
  let tbl = make_table(sec1) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Index");
  render_th(hdr, "AA");
  render_th(hdr, "Hydro");
  render_th(hdr, "mod 3");
  render_th(hdr, "mod 7");
  dom_append(tbl, hdr);
  mut i = 0;
  while i < 21 do (
    render_table_row_5(tbl, "${i}", cs_aa(i), cs_hs(i), "${i % 3}", "${i % 7}");
    mut i = i + 1
  );
  dom_append(dom_body(), sec1);

  /* === SEC 2: METHOD === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "CRT Channel Decomposition as Test Framework");
  render_theorem(sec2, "CRT Test Theorem", "Given n data points in Z/N = Z/p1 x Z/p2 x ... x Z/pk, each CRT channel defines an independent grouping. Test statistic H = sum of squared group sums (higher = more between-group separation). Permutation null: shuffle data across indices. Per-channel p-value: fraction of permutations with H >= observed. Joint p-value: fraction where ALL channels simultaneously exceed. CRT guarantees algebraic independence between channels.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Approach C", "Data chooses ring", "21 amino acids live in Z/21. No embedding parameter. The ring IS the test structure.", "");
  render_finding(g2, "Two channels", "K=3, b=7", "mod-3 sorts into 3 groups of 7. mod-7 sorts into 7 groups of 3. Independent by CRT.", "");
  render_finding(g2, "Joint power", "Multiplicative", "If channels are independent, p_joint approaches p_K * p_b. Two weak signals combine.", "");
  render_finding(g2, "Embedding", "Open question", "Alphabetical index = one possible mapping. Molecular weight, codon order = alternatives to test.", "");
  dom_append(dom_body(), sec2);

  /* === SEC 2B: EVIDENCE TUPLE === */
  let sec2b = make_section("800px") in
  render_h2(sec2b, "The Evidence Tuple");
  render_theorem(sec2b, "Evidence Tuple", "Given n data points with response values indexed 0..n-1 in ring Z/N = Z/m1 x ... x Z/mk, the evidence tuple is E(data, Z/N) = { p1, ..., pk, R-squared, E[R-squared|null] }. Each p_c is the permutation p-value for channel c. R-squared = reconstruction convergence: predict each value from its CRT channel group means. E[R-squared|null] = 1 - product(1 - (m_c - 1)/(n - 1)) = expected R-squared under random assignment.");
  let g2b = make_findings_grid(sec2b) in
  render_finding(g2b, "Per-channel p", "Which axis?", "A single p-value masks which channels carry the signal. Per-channel p-values reveal the algebraic structure of the effect.", "");
  render_finding(g2b, "R-squared", "How much?", "Predict each value from CRT group means: y_hat = mean(mod-3 group) + mean(mod-7 group) - grand mean. R-squared = 1 - SS_residual / SS_total.", "");
  render_finding(g2b, "Null baseline", "Overfitting guard", "With k channels of moduli m1..mk, random data gives R-squared around E[R-squared] = 1 - product(1 - (m_c-1)/(n-1)). For Z/21: 37%. Only excess above this is real signal.", "");
  render_finding(g2b, "Joint test", "CRT independence", "The joint p-value (fraction where ALL channels exceed simultaneously) handles multiplicity directly. CRT algebraic independence means Bonferroni correction is conservative for per-channel tests.", "");
  render_finding(g2b, "Power curve", "Built-in control", "Non-signal channels stay at ~5% (noise) while the signal channel rises. CRT channel independence gives a free negative control per channel -- no separate control group needed.", "");
  dom_append(dom_body(), sec2b);

  /* === SEC 3: INTERACTIVE TEST === */
  let sec3 = make_section("900px") in
  render_h2(sec3, "Run the Permutation Test");
  render_p(sec3, "500 random permutations. For each, shuffle hydrophobicity values across the 21 indices, compute H for mod-3 and mod-7 groupings. Count how many exceed the observed values. Try different seeds to verify stability.");
  make_interactive_widget(sec3, "Seed:", "cstats-input", "42", "Run CRT Test", "cs_perm_test", "cstats-result");
  dom_append(dom_body(), sec3);

  /* === SEC 4: SYNTHETIC VALIDATION === */
  let sec4 = make_section("900px") in
  render_h2(sec4, "Synthetic Validation: Does CRT Find Real Signals?");
  render_p(sec4, "The acid test: generate data WITH known channel structure, and WITHOUT. CRT should detect the first and miss the second. Three scenarios per run: (1) signal in mod-3 channel only, (2) signal in mod-7 channel only, (3) pure noise. 20 trials each, 50 permutations per trial.");
  make_interactive_widget(sec4, "Seed:", "csval-input", "7", "Run Validation", "cs_validate", "csval-result");
  dom_append(dom_body(), sec4);

  /* === SEC 5: POWER CURVE === */
  let sec5 = make_section("900px") in
  render_h2(sec5, "Power Curve: Detection vs Effect Size");
  render_p(sec5, "How strong must a signal be before CRT detects it? Sweep signal strength from 0 (noise) to 30 (strong). At each level, inject signal into the mod-3 channel only and run 15 trials. The S-shaped power curve shows the transition from chance (~5%) to reliable detection (~100%). The non-signal channel (mod-7) acts as a built-in negative control.");
  make_interactive_widget(sec5, "Seed:", "cspower-input", "42", "Run Power Curve", "cs_power_curve", "cspower-result");
  dom_append(dom_body(), sec5);

  /* === SEC 6: YOUR DATA === */
  let sec6 = make_section("900px") in
  render_h2(sec6, "Your Data: Test Any 21 Values");
  render_p(sec6, "Enter 21 comma-separated integers. The CRT test decomposes your data into Z/3 x Z/7 channels and runs the same permutation analysis. The default values are the amino acid hydrophobicity data above.");
  let ulbl = dom_create("p") in
  dom_text(ulbl, "21 values (comma-separated):");
  dom_style(ulbl, "color", "#b8b8c8");
  dom_style(ulbl, "marginTop", "24px");
  dom_style(ulbl, "marginBottom", "8px");
  dom_append(sec6, ulbl);
  let urow = dom_create("div") in
  dom_style(urow, "display", "flex");
  dom_style(urow, "gap", "8px");
  dom_style(urow, "alignItems", "center");
  dom_style(urow, "flexWrap", "wrap");
  dom_style(urow, "marginBottom", "12px");
  let uinp = dom_create("input") in
  dom_attr(uinp, "type", "text");
  dom_attr(uinp, "id", "csuser-input");
  dom_attr(uinp, "value", "68,75,15,15,78,46,18,95,11,88,69,15,34,15,5,42,43,92,41,37,50");
  dom_style(uinp, "background", "#111");
  dom_style(uinp, "color", "#ffd700");
  dom_style(uinp, "border", "1px solid #333");
  dom_style(uinp, "padding", "8px 12px");
  dom_style(uinp, "borderRadius", "6px");
  dom_style(uinp, "fontFamily", "'Courier New', monospace");
  dom_style(uinp, "fontSize", "14px");
  dom_style(uinp, "width", "clamp(200px, 80%, 600px)");
  dom_append(urow, uinp);
  make_action_btn(urow, "Analyze", "cs_user_test");
  dom_append(sec6, urow);
  make_result_box(sec6, "csuser-result");
  dom_append(dom_body(), sec6);

  /* === SEC 7: INTERPRETATION === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "What This Tests");
  render_p(sec7, "The traditional approach tests one correlation (fat-ring eigenvalue vs hydrophobicity, r=0.409, p=0.073 after S1208 investigation). The CRT approach produces a structured evidence tuple: per-channel p-values reveal WHICH algebraic axis carries the signal, and R-squared measures how much the decomposition explains.");
  render_p(sec7, "The evidence tuple replaces a single p-value with structured information. Per-channel p-values show which channels detect the signal. R-squared above the null baseline (37% for Z/21) shows genuine explanatory power beyond what grouping alone provides. The joint p-value handles multiplicity directly: it measures the fraction of permutations where ALL channels exceed simultaneously.");
  render_p(sec7, "CAVEAT: The amino acid indexing is alphabetical by 1-letter code. This is one possible ring embedding. Other orderings (molecular weight, codon position) give different channel assignments. The method works for ANY embedding -- the question is which reveals the most structure.");
  render_p(sec7, "The power curve shows CRT's minimum detectable effect size empirically. Channel independence means each non-signal channel is a free negative control -- no separate control group needed. This structural advantage grows with the number of CRT channels.");
  dom_append(dom_body(), sec7)
)
