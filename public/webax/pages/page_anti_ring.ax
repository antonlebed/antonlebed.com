/* page_anti_ring.ax -- Ring Necessity.
   Does modular arithmetic matter? Ring vs clamp vs flat vs monolithic. */

fn page_anti_ring() = (
  let hero = make_section("800px") in
  render_h2(hero, "Ring Necessity");
  render_p(hero, "We test whether modular arithmetic is necessary, or whether the PRINCIPLES (channel decomposition, Pareto sizing) work without it. Four architectures, same abstract task: context-dependent function selection with per-channel evolution.");
  render_p(hero, "The experiment: replace modular multiplication (a*b mod q) with clamped multiplication (min(a*b, q-1)). This removes the ring's cyclic wrapping while keeping the channel structure. If clamp matches ring, the ring is scaffolding. If not, the ring is essential.");
  dom_append(dom_body(), hero);

  -- Four configs
  let sec1 = make_section("800px") in
  render_h2(sec1, "Four Architectures");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "A: RING", "[8,9,25,49,11,13,17] mod", "Full CRT ring. Modular multiply. The standard.", "");
  render_finding(g1, "B: CLAMP", "[8,9,25,49,11,13,17] saturate", "Same sizes, clamped multiply. No ring. Just the shape.", "");
  render_finding(g1, "C: FLAT", "[19,19,19,19,19,19,19] saturate", "All channels same size 19. No Pareto.", "");
  render_finding(g1, "D: MONO", "[997] saturate", "One big channel. No decomposition.", "");
  dom_append(dom_body(), sec1);

  -- Results
  let sec2 = make_section("800px") in
  render_h2(sec2, "Results");
  render_p(sec2, "4 functions, 160 training examples, 200 generations of per-channel evolutionary search. Same task structure across all configs.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "A RING", "ch 762 (68%), exact 47/160", "Starts at 21%. Improves +523. Genuine learning.", "");
  render_finding(g2, "B CLAMP", "ch 1038 (92%), exact 89/160", "Starts at 63%. Improves +337. High but inflated.", "");
  render_finding(g2, "C FLAT", "ch 1085 (96%), exact 155/160", "Starts at 83%. Improves +156. Nearly trivial.", "");
  render_finding(g2, "D MONO", "ch 160 (100%), exact 160/160", "Starts at 100%. Improves +0. Fully degenerate.", "");
  dom_append(dom_body(), sec2);

  -- The finding
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Finding: Information Preservation");
  render_p(sec3, "Clamp BEATS ring on raw numbers. But the scores are artifacts of degeneracy. Clamped multiplication saturates to q-1 for most inputs when weights are large. The monolithic config gets 100% trivially -- every output is 996.");
  render_p(sec3, "The improvement metric reveals the truth. Ring: +523 points of genuine learning from a hard start (21%). Clamp: +337 from an inflated baseline (63%). Flat: +156 from near-trivial (83%). Mono: +0 from perfectly trivial (100%). Ring creates a task where the model must genuinely learn. Clamp creates a task where the answer is trivial.");
  render_p(sec3, "Why? Modular multiplication is BIJECTIVE (for coprime weight). Every input maps to a unique output. Wrong weights produce completely wrong outputs -- strong evolutionary signal. Clamped multiplication is LOSSY: many inputs map to q-1. Wrong weights still produce q-1 for most inputs -- weak signal, trivial matching.");
  render_p(sec3, "The ring is necessary not as algebraic scaffolding but as an information-preserving arithmetic substrate. The value of modular arithmetic is bijectivity: it preserves information through cyclic wrapping.");
  dom_append(dom_body(), sec3);

  -- Trial context
  let sec4 = make_section("800px") in
  render_h2(sec4, "Context: Three Experiments");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "Experiment 1", "Constraints don't help", "Inter-channel constraints (3^2-2=7, etc.) add no prediction advantage. Enforcing awareness hurts by -126 ch, -79 exact.", "");
  render_finding(g4, "Experiment 2", "Physics = coincidence", "Any 7 primes match physics targets (dense expression space). Template-specific p=0.002 but post-hoc.", "");
  render_finding(g4, "Experiment 3", "Ring = preservation", "Ring is necessary for non-degenerate computation. Its value is bijectivity, not algebraic constraints.", "");
  render_finding(g4, "Verdict", "Technique + substrate", "CRT = universal technique. Ring = necessary (bijectivity). Constraints = decoration. Physics = coincidence. ~2000 theorems = real algebra.", "");
  dom_append(dom_body(), sec4);

  0
)
