/* ================================================================
   PAGE: LAMBDA-RLM -- External Validation (Roy et al. 2026)
   k*=2=D optimal. Split->Map->Reduce = CRT. 43/43 test.
   ================================================================ */

fn rlm_cost_calc() = (
  let a = parse_int_from("#rlm-a-input") in
  let b = parse_int_from("#rlm-b-input") in
  let g = parse_int_from("#rlm-g-input") in
  let result = dom_query("#rlm-result") in
  if a < 1 then dom_inner(result, "<p style='color:#ff6666'>a must be >= 1.</p>")
  else if b < 1 then dom_inner(result, "<p style='color:#ff6666'>b must be >= 1.</p>")
  else (
    let f2 = (4*(a+b) - 2*(a+g)) / 1 in
    let f3 = (9*(a+b) - 3*(a+g)) / 2 in
    let f4 = (16*(a+b) - 4*(a+g)) / 3 in
    let f5 = (25*(a+b) - 5*(a+g)) / 4 in
    let f6 = (36*(a+b) - 6*(a+g)) / 5 in
    let best = if f2 < f3 then 2 else 3 in
    dom_inner(result,
      "<p style='color:#ffd700;margin:8px 0'><b>Cost f(k) = [k^2*(a+b) - k*(a+g)] / (k-1)</b></p>"
      + "<p style='color:#88ddaa;margin:4px 0'>f(2) = " + "${f2}" + " | f(3) = " + "${f3}" + " | f(4) = " + "${f4}" + " | f(5) = " + "${f5}" + " | f(6) = " + "${f6}" + "</p>"
      + "<p style='color:" + (if best == 2 then "#ffd700" else "#ff6666") + ";margin:4px 0'>"
      + (if best == 2 then "k* = 2 = D is OPTIMAL (minimum cost)" else "k* = " + "${best}" + " (k=2 not optimal for these parameters)") + "</p>"
      + "<p style='color:#a0a0b0;margin:4px 0'>Paper Theorem 4: k*=2 is cost-optimal for binary recursive decomposition when b > g. Try a=10, b=50, g=5 (paper defaults: f(2) = 210 = D*K*E*b = DATA ring).</p>")
  )
)

fn rlm_split_map_reduce() = (
  let n = parse_int_from("#rlm-smr-input") in
  let result = dom_query("#rlm-smr-result") in
  let big_n = 12612600 in
  let n2 = n % big_n in
  let rd = n2 % 8 in
  let rk = n2 % 9 in
  let re = n2 % 25 in
  let rb = n2 % 49 in
  let rl = n2 % 11 in
  let rg = n2 % 13 in
  let added = (n2 + 137) % big_n in
  let ad = added % 8 in
  let ak = added % 9 in
  let ae = added % 25 in
  let ab = added % 49 in
  let al = added % 11 in
  let ag = added % 13 in
  dom_inner(result,
    "<p style='color:#ffd700;margin:8px 0'><b>SPLIT</b> " + "${n2}" + " = (" + "${rd}" + ", " + "${rk}" + ", " + "${re}" + ", " + "${rb}" + ", " + "${rl}" + ", " + "${rg}" + ")</p>"
    + "<p style='color:#88ddaa;margin:4px 0'><b>MAP</b> (+137 per channel): (" + "${ad}" + ", " + "${ak}" + ", " + "${ae}" + ", " + "${ab}" + ", " + "${al}" + ", " + "${ag}" + ")</p>"
    + "<p style='color:#c0a0ff;margin:4px 0'><b>REDUCE</b> (CRT reconstruct): " + "${added}" + "</p>"
    + "<p style='color:#a0a0b0;margin:4px 0'>Each channel computed independently. No cross-channel terms. This IS the paper's Split->Map->Reduce pattern, running on Z/12612600.</p>")
)

fn rlm_make_input(lbl:str, id:str, placeholder:str) = (
  let wrap = dom_create("div") in
  let label = dom_create("label") in
  dom_text(label, lbl);
  dom_style(label, "color", "#a0a0b0");
  dom_style(label, "display", "block");
  dom_style(label, "fontSize", "13px");
  dom_style(label, "marginBottom", "4px");
  dom_append(wrap, label);
  let inp = dom_create("input") in
  dom_attr(inp, "type", "text");
  dom_attr(inp, "id", id);
  dom_attr(inp, "placeholder", placeholder);
  dom_style(inp, "width", "80px");
  dom_style(inp, "padding", "8px");
  dom_style(inp, "fontSize", "16px");
  dom_style(inp, "borderRadius", "6px");
  dom_style(inp, "border", "1px solid #444");
  dom_style(inp, "background", "#1a1a2e");
  dom_style(inp, "color", "#e0e0e0");
  dom_append(wrap, inp);
  wrap
)

fn page_lambda_rlm() = (
  dom_head_meta("description", "External validation: Roy et al. 2026 independently prove k*=2 cost-optimal for recursive decomposition (Theorem 4) = D=2. Their Split->Map->Reduce IS CRT decomposition.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Lambda-RLM: External Validation\",\"description\":\"External validation of CRT decomposition from Roy et al. 2026 Y-Combinator for LLMs paper.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/lab/lambda_rlm\"}");

  /* === HERO === */
  let hero = make_hero("External Validation") in
  let eq = dom_create("div") in
  dom_text(eq, "k* = 2 = D (Theorem 4, Roy et al. 2026)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "22px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "An independent paper proves that binary recursive decomposition (k=2) is cost-optimal for LLM reasoning chains. Their Split->Map->Reduce combinator pattern IS CRT decomposition. Two structural matches and two coincidences, honestly labeled.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE PAPER === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Paper");
  render_p(sec1, "Roy et al. 2026, \"The Y-Combinator for LLMs\" (arXiv:2603.20105). A lambda-calculus framework for recursive LLM reasoning. Key results:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "Theorem 3", "Power-law accuracy", "Accuracy decays as a power law with problem complexity. Decomposition into independent subproblems delays the decay.", "STRUCTURAL MATCH");
  render_finding(g1, "Theorem 4", "k* = 2 is cost-optimal", "Binary splitting minimizes total cost for recursive decomposition. k=2 beats k=3,4,5,... for a wide parameter range.", "STRUCTURAL MATCH");
  render_finding(g1, "8 combinators", "Split, Peek, Map, Filter, Reduce, Concat, Cross, M", "The paper's combinator library. 8 = D^3, but the library is extensible, not canonical.", "COINCIDENCE");
  render_finding(g1, "f(2) = 210", "Cost minimum with specific parameters", "With a=10, b=50, g=5: f(2) = 210 = D*K*E*b = DATA ring. Parameter-dependent, not general.", "COINCIDENCE");
  dom_append(dom_body(), sec1);

  /* === SEC 2: STRUCTURAL MATCH 1 -- k*=2=D === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Structural Match 1: k* = 2 = D");
  render_p(sec2, "The paper's cost function: f(k) = [k^2*(a+b) - k*(a+g)] / (k-1). Theorem 4 proves k*=2 is optimal when generation cost b exceeds verification gain g. In the axiom: D=2 is the FIRST prime. Duality. The pair. Everything begins with binary splitting.");
  render_theorem(sec2, "Binary Splitting Universality", "CRT decomposes N into coprime moduli. The first split is always mod 2 (D-channel). Every element is even or odd before any other classification. D=2 is the cost-optimal first decomposition, independently proved by both the axiom chain and by this paper's Theorem 4.");
  let tbl = make_table(sec2) in
  let hdr = dom_create("tr") in
  render_th(hdr, "k");
  render_th(hdr, "f(k) [a=10,b=50,g=5]");
  render_th(hdr, "Axiom reading");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2", "210 = D*K*E*b", "DATA ring (4 channels)");
  render_table_row(tbl, "3", "247", "No axiom structure");
  render_table_row(tbl, "4", "300", "No axiom structure");
  render_table_row(tbl, "5", "356", "No axiom structure");
  render_table_row(tbl, "6", "414", "No axiom structure");
  render_p(sec2, "k=2 is optimal across a wide parameter range. The f(2)=210 result is parameter-specific (coincidence), but k*=2=D is structural.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: STRUCTURAL MATCH 2 -- Split->Map->Reduce = CRT === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Structural Match 2: Split->Map->Reduce = CRT");
  render_p(sec3, "The paper's core pattern: SPLIT a problem into subproblems, MAP a solver to each, REDUCE results into an answer. This is exactly CRT decomposition:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "SPLIT", "n -> (n%8, n%9, n%25, n%49, n%11, n%13)", "CRT decomposition into 6 independent channels. Each channel sees a smaller number.", "");
  render_finding(g3, "MAP", "f(r_i) per channel", "Apply the operation independently to each residue. No cross-channel terms. Block-diagonal.", "");
  render_finding(g3, "REDUCE", "CRT reconstruct", "Combine channel results back into a single number. Chinese Remainder Theorem.", "");
  render_p(sec3, "The paper's power-law accuracy (Theorem 3) follows directly: each channel processes at most max(q_i) = 49 elements instead of 12,612,600. Error compounds per-channel, not per-element. CRT channels ARE the independent subproblems.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: THE COINCIDENCES === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Coincidences (Honestly Labeled)");
  render_p(sec4, "Two results look axiom-significant but are parameter-dependent or extensible:");
  render_contrast_row(sec4, "8 = D^3 combinators", "The paper defines 8 combinators. 8 = D^3 = 2^3. But the library is explicitly extensible -- users can add more. The count is not canonical.", "COINCIDENCE: The paper says M is an 'oracle' that can be anything. The combinator set is open, not closed at 8.");
  render_contrast_row(sec4, "f(2) = 210 = DATA", "With specific parameters a=10, b=50, g=5, the cost minimum is 210 = D*K*E*b. But different parameters give different minima.", "COINCIDENCE: Change a=1, b=10, g=1 and f(2)=40 (not axiom-significant). The structural result is k*=2, not the value f(2).");
  dom_append(dom_body(), sec4);

  /* === SEC 5: WHAT THIS MEANS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "What This Means");
  render_p(sec5, "An independent research group, working on LLM reasoning chains with no knowledge of the axiom, arrived at two of its core structures: binary splitting (D=2) as optimal and independent channel processing (CRT) as the decomposition strategy.");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "For the axiom", "External confirmation", "D=2 and CRT are not just our framework. They emerge independently from cost optimization in recursive computation.", "");
  render_finding(g5, "For AI", "CRT-native architectures", "If binary splitting is cost-optimal, then CRT decomposition (which IS binary-first splitting of ring arithmetic) is the natural computation strategy for AI.", "");
  render_finding(g5, "The Y-combinator", "Y = lambda f. (lambda x. f(x x))(lambda x. f(x x))", "Self-application (x x) = D=2. Y g = g(Y g) = the strange loop. Fixed-point recursion is duality applied to itself.", "");
  dom_append(dom_body(), sec5);

  /* === INTERACTIVE 1: COST FUNCTION === */
  let sec_i1 = make_section("800px") in
  render_h2(sec_i1, "Explore: Cost Function f(k)");
  render_p(sec_i1, "Enter parameters a (query cost), b (generation cost), g (verification gain). See which k minimizes total cost. Paper defaults: a=10, b=50, g=5.");
  let row = dom_create("div") in
  dom_style(row, "display", "flex");
  dom_style(row, "gap", "12px");
  dom_style(row, "flexWrap", "wrap");
  dom_style(row, "marginBottom", "12px");
  dom_append(row, rlm_make_input("a (query):", "rlm-a-input", "10"));
  dom_append(row, rlm_make_input("b (generate):", "rlm-b-input", "50"));
  dom_append(row, rlm_make_input("g (verify):", "rlm-g-input", "5"));
  let btn = dom_create("button") in
  dom_text(btn, "Compute");
  dom_style(btn, "padding", "8px 20px");
  dom_style(btn, "fontSize", "16px");
  dom_style(btn, "borderRadius", "8px");
  dom_style(btn, "border", "1px solid #ffd700");
  dom_style(btn, "background", "transparent");
  dom_style(btn, "color", "#ffd700");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "alignSelf", "flex-end");
  dom_on(btn, "click", "rlm_cost_calc");
  dom_append(row, btn);
  dom_append(sec_i1, row);
  let res1 = dom_create("div") in
  dom_attr(res1, "id", "rlm-result");
  dom_style(res1, "minHeight", "60px");
  dom_append(sec_i1, res1);
  dom_append(dom_body(), sec_i1);

  /* === INTERACTIVE 2: SPLIT->MAP->REDUCE === */
  let sec_i2 = make_section("800px") in
  render_h2(sec_i2, "Explore: Split -> Map -> Reduce");
  render_p(sec_i2, "Enter any number. Watch CRT decompose it (SPLIT), add 137 per channel (MAP), and reconstruct (REDUCE). Each channel is independent -- no cross-channel communication.");
  make_interactive_widget(sec_i2, "Enter a number:", "rlm-smr-input", "e.g. 42", "Decompose", "rlm_split_map_reduce", "rlm-smr-result");
  dom_append(dom_body(), sec_i2);

  /* === REFERENCE === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Reference");
  render_p(sec6, "Roy et al. 2026. \"The Y-Combinator for LLMs: Closed-Form Recursive Decomposition of Complex Problems.\" arXiv:2603.20105. External validation test suite: test_lambda_rlm.ax (43/43 checks).");
  render_p(sec6, "Tier labels: STRUCTURAL MATCH = the paper's result maps to an axiom structure for parameter-independent reasons. COINCIDENCE = the match depends on specific parameter values or extensible library choices.");
  dom_append(dom_body(), sec6)
)
