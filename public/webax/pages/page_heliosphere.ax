/* page_heliosphere.ax -- Heliosphere: The Solar Bubble (S1162).
   Sun moves through ISM at 25 km/s. CRT decompositions of velocities,
   wall of fire temperatures, supervoid sizes. 490 split = boundary prediction.
   Interactive CRT calculator with presets. */

/* Heliosphere CRT calculator handler -- uses ss_factor_str from page_solar_system.ax */
fn hl_crt_calc() = (
  let n = parse_int_from("#hl-input") in
  let result = dom_query("#hl-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter a positive integer.</p>")
  else if n > 1000000 then dom_inner(result, "<p style='color:#ff6666'>Maximum is 1000000.</p>")
  else (
    dom_inner(result, "");
    /* Factorization */
    let fstr = ss_factor_str(n) in
    let fdesc = dom_create("p") in
    dom_inner(fdesc, "<b style='color:#ffd700'>${n}</b> = <span style='color:#aaa'>${fstr}</span>");
    dom_style(fdesc, "color", "#d8d8e0");
    dom_style(fdesc, "marginBottom", "12px");
    dom_append(result, fdesc);
    /* CRT decomposition */
    let tbl = dom_create("table") in
    dom_style(tbl, "width", "100%");
    dom_style(tbl, "maxWidth", "600px");
    dom_style(tbl, "margin", "0 auto");
    dom_style(tbl, "borderCollapse", "collapse");
    let hdr = dom_create("tr") in
    render_th(hdr, "Channel");
    render_th(hdr, "Modulus");
    render_th(hdr, "Residue");
    render_th(hdr, "Void?");
    dom_append(tbl, hdr);
    render_table_row_4(tbl, "D", "8", "${n % 8}", if n % 8 == 0 then "VOID" else "");
    render_table_row_4(tbl, "K", "9", "${n % 9}", if n % 9 == 0 then "VOID" else "");
    render_table_row_4(tbl, "E", "25", "${n % 25}", if n % 25 == 0 then "VOID" else "");
    render_table_row_4(tbl, "b", "49", "${n % 49}", if n % 49 == 0 then "VOID" else "");
    render_table_row_4(tbl, "L", "11", "${n % 11}", if n % 11 == 0 then "VOID" else "");
    render_table_row_4(tbl, "GATE", "13", "${n % 13}", if n % 13 == 0 then "VOID" else "");
    render_table_row_4(tbl, "ESCAPE", "17", "${n % 17}", if n % 17 == 0 then "VOID" else "");
    dom_append(result, tbl);
    /* Smoothness verdict */
    let r2 = ss_strip(n, 2) in
    let rem = r2 % 100000 in
    let r3 = ss_strip(rem, 3) in
    let rem = r3 % 100000 in
    let r5 = ss_strip(rem, 5) in
    let rem = r5 % 100000 in
    let r7 = ss_strip(rem, 7) in
    let rem = r7 % 100000 in
    let r11 = ss_strip(rem, 11) in
    let rem = r11 % 100000 in
    let r13 = ss_strip(rem, 13) in
    let rem = r13 % 100000 in
    let r17 = ss_strip(rem, 17) in
    let rem = r17 % 100000 in
    let verd = dom_create("p") in
    dom_style(verd, "marginTop", "12px");
    dom_style(verd, "fontSize", "14px");
    if rem == 1 then (
      dom_inner(verd, "<span style='color:#33dd55'>Axiom-smooth:</span> ${n} factors entirely into axiom primes {2,3,5,7,11,13,17}.");
      dom_style(verd, "color", "#b8b8c8")
    ) else (
      dom_inner(verd, "<span style='color:#ff9900'>Not smooth:</span> remainder ${rem} after removing axiom primes.");
      dom_style(verd, "color", "#b8b8c8")
    );
    dom_append(result, verd)
  )
)

fn page_heliosphere() = (
  dom_head_meta("description", "Heliosphere CRT decompositions. Solar velocities, wall of fire temperatures, supervoid sizes decompose into axiom primes. 490 holographic split predicts boundary heating.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Heliosphere: The Solar Bubble\",\"description\":\"CRT decompositions of solar velocities, heliopause dimensions, wall of fire temperatures, and supervoid sizes.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/heliosphere\"}");

  /* === HERO === */
  let hero = make_hero("Heliosphere") in
  render_p(hero, "The Sun moves through interstellar space at 25 km/s, inflating a bubble of charged particles 120 AU across. Every velocity, temperature, and distance decomposes into axiom primes.");
  let stats = make_findings_grid(hero) in
  render_finding(stats, "Orbit", "E * K * ESCAPE", "255 km/s galactic velocity. All axiom.", "");
  render_finding(stats, "Wall of Fire", "D = 0, E = 0", "Bridge and observer channels die.", "");
  render_finding(stats, "Heliotail", "D^2 = 4", "Four lobes. Uniform across all channels.", "");
  dom_append(dom_body(), hero);

  /* === SOLAR VELOCITIES === */
  let s1 = make_section("800px") in
  render_h2(s1, "Solar Velocities");
  render_p(s1, "The Sun has three characteristic velocities. Each decomposes into axiom primes with structurally meaningful channel patterns.");
  let vtbl = dom_create("table") in
  dom_style(vtbl, "width", "100%");
  dom_style(vtbl, "maxWidth", "700px");
  dom_style(vtbl, "margin", "24px auto");
  dom_style(vtbl, "borderCollapse", "collapse");
  dom_style(vtbl, "tableLayout", "fixed");
  dom_style(vtbl, "wordWrap", "break-word");
  let vhdr = dom_create("tr") in
  render_th(vhdr, "Velocity");
  render_th(vhdr, "Value");
  render_th(vhdr, "Factorization");
  render_th(vhdr, "Void channels");
  dom_append(vtbl, vhdr);
  render_table_row_4(vtbl, "Galactic orbit", "255 km/s", "K * E * ESCAPE", "none");
  render_table_row_4(vtbl, "ISM motion", "~25 km/s", "E^2", "E (observer blind)");
  render_table_row_4(vtbl, "Peculiar", "18 km/s", "D * K^2", "K (closure blind)");
  dom_append(s1, vtbl);
  render_p(s1, "The galactic orbit velocity 255 = K * E * ESCAPE = 3 * 5 * 17 is fully axiom-smooth with no void channels -- every CRT residue is a clean axiom value. The ISM velocity E^2 = 25 is void in the E-channel: the observer cannot see its own motion. The peculiar velocity D * K^2 = 18 is void in the K-channel: closure is blind to the residual drift.");
  dom_append(dom_body(), s1);

  /* === VELOCITY RATIOS === */
  let s2 = make_section("800px") in
  render_h2(s2, "Velocity Ratios");
  render_p(s2, "The ratios between the three velocities approximate axiom values.");
  let rtbl = dom_create("table") in
  dom_style(rtbl, "width", "100%");
  dom_style(rtbl, "maxWidth", "600px");
  dom_style(rtbl, "margin", "24px auto");
  dom_style(rtbl, "borderCollapse", "collapse");
  let rhdr = dom_create("tr") in
  render_th(rhdr, "Ratio");
  render_th(rhdr, "Value");
  render_th(rhdr, "Nearest axiom");
  dom_append(rtbl, rhdr);
  render_table_row(rtbl, "Orbit / ISM", "255 / 25 = 10.2", "D * E = 10 (2%)");
  render_table_row(rtbl, "Orbit / Peculiar", "255 / 18 = 14.2", "D * b = 14 (1%)");
  render_table_row(rtbl, "ISM / Peculiar", "25 / 18 = 1.39", "not integer");
  dom_append(s2, rtbl);
  render_p(s2, "The orbital-to-ISM ratio is approximately D * E = 10 = Decality (2% off). The orbital-to-peculiar ratio is approximately D * b = 14 = bridge times depth (1% off). Both velocities are measured with uncertainties of several km/s, so the closeness to axiom values is suggestive but not exact.");
  dom_append(dom_body(), s2);

  /* === HELIOPAUSE AND TAIL === */
  let s3 = make_section("800px") in
  render_h2(s3, "Heliopause and Heliotail");
  render_p(s3, "The heliopause -- the boundary where solar wind meets interstellar medium -- sits at approximately 120 AU. The IBEX mission mapped four distinct lobes in the heliotail.");
  let htbl = dom_create("table") in
  dom_style(htbl, "width", "100%");
  dom_style(htbl, "maxWidth", "700px");
  dom_style(htbl, "margin", "24px auto");
  dom_style(htbl, "borderCollapse", "collapse");
  dom_style(htbl, "tableLayout", "fixed");
  dom_style(htbl, "wordWrap", "break-word");
  let hhdr = dom_create("tr") in
  render_th(hhdr, "Quantity");
  render_th(hhdr, "Value");
  render_th(hhdr, "Factorization");
  render_th(hhdr, "CRT pattern");
  dom_append(htbl, hhdr);
  render_table_row_4(htbl, "Heliopause", "120 AU", "D^3 * K * E", "D-channel VOID");
  render_table_row_4(htbl, "Heliotail lobes", "4", "D^2", "Uniform: (4,4,4,4,4,4)");
  dom_append(s3, htbl);
  render_p(s3, "120 = D^3 * K * E uses the first three axiom primes. D is at its full TRUE exponent (D^3 = 8); K and E appear at exponent 1. The D-channel is void: the bridge saturates at the membrane. The L-channel residue is D * E = 10 = Decality. The GATE-channel residue is K = 3.");
  render_p(s3, "The heliotail has exactly D^2 = 4 lobes, with CRT residue (4,4,4,4,4,4) -- uniform D^2 across all six channels. This is the IBEX 4-lobe structure: fast solar wind (D = 2) crossed with slow solar wind (D = 2) gives D^2 = 4.");
  dom_append(dom_body(), s3);

  /* === WALL OF FIRE === */
  let s4 = make_section("800px") in
  render_h2(s4, "The Wall of Fire");
  render_p(s4, "The heliopause is a transition region where temperatures spike from thousands to tens of thousands of kelvin. These wall-of-fire temperatures have a striking CRT pattern.");
  let wtbl = dom_create("table") in
  dom_style(wtbl, "width", "100%");
  dom_style(wtbl, "maxWidth", "700px");
  dom_style(wtbl, "margin", "24px auto");
  dom_style(wtbl, "borderCollapse", "collapse");
  dom_style(wtbl, "tableLayout", "fixed");
  dom_style(wtbl, "wordWrap", "break-word");
  let whdr = dom_create("tr") in
  render_th(whdr, "Temperature");
  render_th(whdr, "CRT (D,K,E,b,L,G)");
  render_th(whdr, "Dead channels");
  render_th(whdr, "Factorization");
  dom_append(wtbl, whdr);
  render_table_row_4(wtbl, "30,000 K", "(0,3,0,12,3,9)", "D, E", "D^4 * K * E^4");
  render_table_row_4(wtbl, "50,000 K", "(0,5,0,20,5,2)", "D, E", "D^4 * E^5");
  dom_append(s4, wtbl);
  render_p(s4, "Both temperatures are VOID in D and E -- the bridge and observer channels die at the wall. This is exactly the 490 holographic split: DEAD = {D, E, b} corresponds to the inner channels. The K^2 = 9 in the GATE channel of 30,000 K is the spider web at the wall of fire.");
  render_theorem(s4, "490 Split as Boundary Prediction", "The 490 holographic split cleaves channels into DEAD = {D, E, b} (inner) and ALIVE = {K, L, GATE} (boundary). 490^420 = (0, 1, 0, 0, 1, 1) in TRUE. Wall of fire temperatures are dead in D and E -- consistent with inner-channel death. The axiom predicts boundaries carry more structure than their interiors.");
  dom_append(dom_body(), s4);

  /* === SUPERVOIDS === */
  let s5 = make_section("800px") in
  render_h2(s5, "Supervoid Decompositions");
  render_p(s5, "The largest known cosmic voids have sizes that decompose into products of axiom primes.");
  let stbl = dom_create("table") in
  dom_style(stbl, "width", "100%");
  dom_style(stbl, "maxWidth", "700px");
  dom_style(stbl, "margin", "24px auto");
  dom_style(stbl, "borderCollapse", "collapse");
  dom_style(stbl, "tableLayout", "fixed");
  dom_style(stbl, "wordWrap", "break-word");
  let shdr = dom_create("tr") in
  render_th(shdr, "Void");
  render_th(shdr, "Size");
  render_th(shdr, "Factorization");
  render_th(shdr, "Dead channels");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "Eridanus", "1800 Mly", "D^3 * K^2 * E^2", "D, K, E all VOID");
  render_table_row_4(stbl, "Bootes", "330 Mly", "D * K * E * L", "L VOID");
  dom_append(s5, stbl);
  render_p(s5, "Eridanus at 1800 Mly = D^3 * K^2 * E^2 = 8 * 9 * 25: exactly the TRUE ring channel moduli for the first three primes. Three of six channels die -- the deepest void kills the data channels {D, K, E} while depth, protection, and gate survive.");
  render_p(s5, "Bootes at 330 Mly = D * K * E * L = 2 * 3 * 5 * 11 = thin ring value. Only the L-channel (protection) is void: the protector channel killed. Each supervoid kills different channels.");
  dom_append(dom_body(), s5);

  /* === SCALE MIRROR === */
  let s6 = make_section("800px") in
  render_h2(s6, "Scale Mirror");
  render_p(s6, "The mirror automorphism n -> N - n inverts topology across scales.");
  render_p(s6, "At the solar scale: matter forms a bubble (the heliosphere), void is the medium (interstellar space). At the supercluster scale: void forms bubbles (supervoids), matter is the boundary (filaments and walls). The n -> N - n mirror automorphism IS this scale inversion.");
  render_p(s6, "mirror(490) has CRT = (6, 5, 10, 0, 5, 4). The b-channel remains dead in the mirror -- the holographic split is self-dual in depth. The boundary structure persists regardless of which side you call inside.");
  dom_append(dom_body(), s6);

  /* === INTERACTIVE === */
  let si = make_section("800px") in
  render_h2(si, "Explore: CRT Decomposition");
  render_p(si, "Enter any number (a velocity, temperature, or distance) to see its CRT decomposition across the 7 axiom channels. Try: 255 (orbit), 25 (ISM), 120 (heliopause), 30000 (wall of fire), 1800 (Eridanus void).");
  make_interactive_widget(si, "Number:", "hl-input", "e.g. 255", "Decompose", "hl_crt_calc", "hl-result");
  dom_append(dom_body(), si);

  /* === HONEST ASSESSMENT === */
  let sh = make_section("800px") in
  render_h2(sh, "Honest Assessment");
  render_p(sh, "The velocity factorizations are arithmetic facts: 255 = K * E * ESCAPE, 25 = E^2, 18 = D * K^2. The heliopause 120 = D^3 * K * E is exact. The velocity ratios 10.2 and 14.2 approximate Decality and D*b within 2%, which is suggestive but not exact.");
  render_p(sh, "The void-channel patterns (E-channel dead for ISM velocity, D and E dead at wall-of-fire temperatures) are consistent with the 490 holographic split. The Eridanus supervoid factoring into TRUE ring channel sizes is striking.");
  render_p(sh, "But astrophysical velocities and temperatures are measured with uncertainties. The ISM velocity 25 km/s is approximate (various sources give 23-26 km/s). Supervoid sizes are estimated from survey data. No mechanism is claimed connecting ring structure to astrophysical observables. These are OBSERVED patterns, not proved causal connections.");
  dom_append(dom_body(), sh)
)
