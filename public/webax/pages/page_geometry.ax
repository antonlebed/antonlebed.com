  /* === INTERACTIVE: CRT DISTANCE EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Distance from Void");
  render_p(sec_i, "Enter n to see its CRT coordinates and distance from 0 in all three metrics. Widget computes on T^6 (TRUE, 6 CRT channels); ESCAPE extends this to T^7 (TRANS) as noted in Torus Keychain and Capped Horn above. Hamming counts active channels, L1 sums wrapped per-channel distances, Cayley is clock distance.");
  make_interactive_widget(sec_i, "Enter n:", "geo-input", "e.g. 137", "Measure", "geo_lookup", "geo-result");
  render_p(sec_i, "Try: 1 (sigma, L1=6), 1576576 (OMEGA, L1=1), 12612599 (mirror), 13 (GATE).");
