  render_table_row(tbl, "YM gap universality", "7^2 = 49 forced; q_max = 49 unconditional on the 108-lattice", "/theory/infinity (spectral plateau)");
  render_table_row(tbl, "NS horn analog", "CRT orthogonality forbids coupled blowup; ring = horn cap", "/theory/infinity (horn cap)");
  render_table_row(tbl, "Thm 113 (Spectral Torus)", "coupling = eigenvalue(a-b) + eigenvalue(a+b); channel democracy", "/proof Theorem 113");
  render_table_row(tbl, "Thm 122 (CRT Chirality)", "CR(N) = prod (m+1)/(m-1). D-achiral. Void breaks mirror", "/proof Theorem 122");
  render_table_row(tbl, "Thm 123 (Binocular Chain)", "Two genesis readings form binocular pair. Shared sum = ESCAPE", "/proof Theorem 123");
  render_table_row(tbl, "Thm 124 (Torus Betti)", "beta_k = C(7,k); total = 2^7 = 128 = |Idem(Z/214,414,200)|", "/proof Theorem 124");
  render_table_row(tbl, "Thm 144 (Free Sum PG)", "Lattice free sums = F_2 projective geometry; |GL(3,F_2)| = 168", "/proof Theorem 144");
  render_table_row(tbl, "Thm 151 (Leech Lattice)", "dim=24, kissing=196560; all chain-native; Mathieu staircase", "/proof Theorem 151");
  render_table_row(tbl, "Thm 225 (CMB Triangle)", "Angle excess > 0 on T^k, grows with ring level; Z/8 flat; K-exclusion", "/proof Theorem 225");
  render_table_row(tbl, "Thm 158 (Discrete Geometry)", "5 Platonic, 13 Archimedean; all V/E/F use only {2,3,5}", "/proof Theorem 158");
  render_table_row(tbl, "Thm 159 (Archimedean Anatomy)", "V/E {2,3,5}-confined; faces escalate; Ico/Oct = 5/2", "/proof Theorem 159");
  render_table_row(tbl, "Thm 160 (Catalan Dual)", "Duality reversal: Catalan V escalate, F {2,3,5}-only", "/proof Theorem 160");
  render_table_row(tbl, "Thm 161 (Exceptional Lie)", "dim=rank*c(h/2); same Cunningham mechanism as polyhedra", "/proof Theorem 161");
  render_table_row(tbl, "Thm 163 (Polyhedral Census)", "5+13+2^2*c(11) = 2*5*11 = 110 convex regular-faced", "/proof Theorem 163");
  render_table_row(tbl, "Thm 231 (Conformal Dim)", "conf(d) b-smooth d=1..7; physical->depth; K-void; HYDOR=conf(GATE)", "/proof Theorem 231");
  render_table_row(tbl, "Thm 232 (Trapped Surface)", "T(p,e)=p^{e-1}-1. Sum=K*E=conf(4). Four paths. Meadow boundary.", "/proof Theorem 232");
  render_table_row(tbl, "Thm 233 (Spinor Chain)", "Prime component counts = axiom chain. Valences axiom-smooth. EM=D, gravity=D^2.", "/proof Theorem 233");
  dom_append(dom_body(), sec)
)

