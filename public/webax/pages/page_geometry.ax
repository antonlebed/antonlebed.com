  render_table_row(tbl, "AXIOM_FORM NS", "CRT orthogonality forbids coupled blowup; ring = horn cap", "AXIOM_FORM.md NAVIER-STOKES HORN ANALOG");
  render_table_row(tbl, "Thm 113 (Spectral Torus)", "coupling = eigenvalue(a-b) + eigenvalue(a+b); channel democracy", "/proof Theorem 113 (S1660)");
  render_table_row(tbl, "Thm 124 (Torus Betti)", "beta_k = C(7,k); total = D^7 = 128 = |Idem(TRANS)|", "/proof Theorem 124 (S1672)");
  render_table_row(tbl, "Thm 144 (Free Sum PG)", "Lattice free sums = F_2 projective geometry; |GL(3,F_2)| = 168", "/proof Theorem 144 (S1693)");
  render_table_row(tbl, "Thm 151 (Leech Lattice)", "dim=24, kissing=196560; all axiom-native; Mathieu staircase", "/proof Theorem 151 (S1700)");
  render_table_row(tbl, "Thm 158 (Discrete Geometry)", "E=5 Platonic, GATE=13 Archimedean; all V/E/F DATA-prime", "/proof Theorem 158 (S1707)");
  render_table_row(tbl, "Thm 159 (Archimedean Anatomy)", "V/E DATA-confined; faces escalate; Ico/Oct = E/D", "/proof Theorem 159 (S1708)");
