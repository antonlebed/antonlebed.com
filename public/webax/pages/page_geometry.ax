  dom_append(dom_body(), sec)
)

fn geo_horn_cap() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Capped Horn");
  render_p(sec, "T^7 IS the Gabriel-Horn compactification of Z^7 (GEOMETRY.md section IX). Finite ring state space = the horn's finite-volume side; the continuum Z^7 Fourier spectrum = its infinite-surface side. The cap truncates modes at k <= N-1. Two Millennium-Prize STRUCTURAL analogs live on the same cap, sharing one controller: b^2 = 49.");
  let g = make_findings_grid(sec) in
  render_finding(g, "b^2-forced gap floor", "gap = 4*sin^2(pi/49) ~ 0.01644", "Identical across all 108 = D^2*K^3 lambda=420 rings (6-channel boundary, no ESCAPE). b^2=49 strictly dominates D^4=16, K^2=9, E^2=25, L=11, GATE=13. AXIOM_FORM.md YANG-MILLS GAP LATTICE UNIVERSALITY. STRUCTURAL YM analog, NOT a Clay-YM proof.", "S1436");
  render_finding(g, "CRT-decomposed Laplacian", "T^7 Laplacian = direct sum of 7 per-channel Laplacians", "Orthogonal Fourier subspaces forbid coupled blowup; seven micro-horns, not one coupled horn. Bounded-ring energy E(t) <= E(0). AXIOM_FORM.md NAVIER-STOKES HORN ANALOG. STRUCTURAL NS analog, NOT a Clay-NS proof.", "S1437");
  render_finding(g, "TRANS inherits the floor", "ESCAPE = 17 < 49 = b^2", "T^7 TRANS (lambda = 1680 = D^2 * 420) sits one ESCAPE-step above the 108 lambda=420 lattice and inherits its gap floor: adding a smaller channel width cannot lower q_max = 49. The capped-horn geometry extends cleanly from T^6 TRUE to T^7 TRANS.", "S1437");
  dom_append(dom_body(), sec)
)

