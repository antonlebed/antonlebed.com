  let sec = make_section("800px") in
  render_h2(sec, "Spectral Torus Bridge");
  render_theorem(sec, "Spectral Torus Theorem (S1660, PROVED)", "Three identities bridge coupling (algebra) and torus linking (geometry). (1) SPECTRAL ADDITION: coupling(a,b) = eigenvalue(a-b) + eigenvalue(a+b) -- the D=2 bridge pair. (2) CHANNEL DEMOCRACY: every channel carries equal spectral power 2N. (3) ORTHOGONALITY: cross-channel spectral correlation = 0. Link number N/(q_i*q_j) = Poincare dual fiber volume. 15/15 test_torus_spectral.ax.");
