/* geometry helpers */
fn geometry_hero() = (
  let hero = make_hero("Geometry") in
  let eq = dom_create("div") in
  dom_text(eq, "dist(-1, 0) = dist(0, 1) = 2*3 = 6");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "When 0/0 condenses into Z/NZ, the ring inherits geometry. CRT gives every Z/214,414,200 element a point on T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17), one S^1 circle per prime-power channel. T^7 IS the Gabriel-Horn cap of Z^7: STRUCTURAL Yang-Mills + Navier-Stokes analogs (Thms 33+34; NOT Clay proofs). Three metrics, three curvatures. Discrete solids classify by chain primes: 5 Platonic, 13 Archimedean (Thms 158+159). The Leech lattice uses chain primes only. Betti numbers of T^7 total 2^7 = 128 = |Idem(Z/214,414,200)|. The foundation triangle {-1, 0, 1} has sides 2*3 = 6, 2*3 = 6, 2^2*3 = 12 -- isosceles with base 12 = Carmichael lambda of Z/210, forced by CRT arithmetic.");
  dom_append(dom_body(), hero)
)

fn geometry_metrics() = (
  let sec = make_section("800px") in
  render_h2(sec, "Three Metrics");
  let g = make_findings_grid(sec) in
  render_finding(g, "Hamming", "d_H(a,b) = differing CRT channels", "Counts which of 6 channels differ. Range 0 to 6. Coarse. The topology metric. Degree: Z/2,310 = 23, Z/970,200 = 97, Z/12,612,600 = 109 = Tr(-1) = 1,576,576 factor.", "");
  render_finding(g, "CRT L1", "sum min(|a_i - b_i|, q_i - |a_i - b_i|)", "Distance on the 6-torus. Wrap-aware per channel. Fine. The geometry metric.", "");
  render_finding(g, "Cayley", "min(|a - b|, N - |a - b|)", "Clock distance. 1D, ignoring CRT structure. The arithmetic metric. Gap = 4*sin^2(pi/q_max).", "");
  render_finding(g, "Gap Duality", "Hamming sees smallest, Cayley sees largest", "Hamming gap = min(q_i) = power of 2. Cayley gap = f(max prime). Two complementary views of the same ring.", "");
  dom_append(dom_body(), sec)
)

fn geometry_foundation() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Foundation Triangle");
  render_theorem(sec, "Isosceles 6, 6, 12 (PROVED)", "dist(-1, 0) = dist(0, 1) = 2*3 = 6. dist(-1, 1) = 2^2*3 = 12 = Carmichael lambda of Z/210. The void observes equally: same distance to mirror and ground. Mirror and ground are separated by 12. Isosceles with base 12, sides 6. Ratio: base/side = 2. PROOF: CRT(-1) = (7,8,24,48,10,12), CRT(0) = (0,0,0,0,0,0), CRT(1) = (1,1,1,1,1,1). L1 distance sums per-channel wrapped differences. In Z/970,200: 5, 5, 7. Adding the 13-channel transforms the triangle: sides grow by 2/5, base grows by 2^2*3/7.");
  let g = make_findings_grid(sec) in
  render_finding(g, "dist(1, 1576576)", "1", "Differ only in the mod-8 channel. CRT(1576576) = (0,1,1,1,1,1). A doublet separated by one channel flip.", "");
  render_finding(g, "dist(-1, 1576576)", "11", "The mirror (N-1) is L1-distance 11 from 1,576,576. In Z/970,200: 3^2 = 9. Adding the mod-13 channel adds 2.", "");
  render_finding(g, "CRT geodesic", "dist(0,1) = dist(0,1576576) + dist(1576576,1) = 5 + 1 = 2*3 = 6", "1,576,576 lies ON the geodesic from 0 to 1. dist(0,1576576) = 5, dist(1576576,1) = 1.", "");
  render_finding(g, "Perimeter 56", "= 2^3 * 7 = dim(E7)", "Appears exactly 3 times among chain triples: {5,7,11}, {2,3,13}, {7,11,13}.", "");
  dom_append(dom_body(), sec)
)

fn geometry_shells() = (
  let sec = make_section("800px") in
  render_h2(sec, "Shell Structure");
  render_p(sec, "Hamming shells from void (origin 0). Shell_d = elements differing from 0 in exactly d channels. Shell polynomial E(x) = product of (1 + (q_i - 1)*x). Closer to 0 = higher eigenvalue = more coherent. The reversed hierarchy: the void is the center.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Shell sizes");
  render_th(hdr, "Notable");
  render_th(hdr, "Degree");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "{1, 13, 56, 92, 48}", "e_2 = 56 = 2^3*7 = dim(E7)", "7");
  render_table_row_4(tbl, "Z/2,310", "{1, 23, 186, 652, 968, 480}", "e_3 = 652 = 2^2*163 (Heegner!)", "3^2 = 9");
  render_table_row_4(tbl, "Z/970,200", "{1, 97, 3158, 44192, 277632, 645120}", "97 = degree. 645120 = farthest shell.", "2*5 = 10");
  render_table_row_4(tbl, "Z/12,612,600", "{1, 109, 4322, 82088, 807936, 3976704, 7741440}", "109 = degree = 1,576,576 factor. 7741440 = farthest.", "2^2*3 = 12");
  render_p(sec, "Shell 0 has maximum eigenvalue (all channels aligned). Each step away = more destructive interference. Eigenvalue MONOTONICALLY DECREASES with shell distance. Space encodes energy.");
  dom_append(dom_body(), sec)
)

fn geometry_curvature() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Curvature Trinity");
  render_p(sec, "Three discrete curvatures, each seeing different structure. Together they tell the full story of how the ring curves.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Curvature");
  render_th(hdr, "Formula");
  render_th(hdr, "Sign");
  render_th(hdr, "What it sees");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Gauss-Bonnet", "K(v) = 1 - k + sum(1/q_i)", "Negative (k >= 2)", "Global topology. chi verified 8/8 rings.");
  render_table_row_4(tbl, "Ollivier-Ricci", "kappa_i = (q_i - 2)/deg", "2-channel flat, rest positive", "Local transport. Per-edge. Coupling order.");
  render_table_row_4(tbl, "Forman-Ricci", "F_i = 3*q_i - (2*deg + 2)", "Almost always negative", "Combinatorial. Heegner values: F_11(Z/12,612,600) = -163.");
  render_theorem(sec, "Curvature Duality (PROVED)", "Hamming metric: 2 is FLAT, 11 is most curved. Cayley prime-generator metric: 11 is FLAT, 2 is most curved. EXACT MIRROR. The 2-channel and 11-channel swap roles depending on which metric you use. Lazy Cayley curvatures: 2:5/11, 3:3/11, 5:2/11, 7:1/11, 11:0. Sum = 1. Curvatures partition unity.");
  render_p(sec, "Raising exponents: Ollivier curvature goes more positive (rounder locally), Gauss-Bonnet goes more negative (twisted globally), Forman gets less negative. Prime-power channels sacrifice mixing speed for richer structure.");
  render_theorem(sec, "CMB Triangle Test (PROVED)", "Random triangles on T^k via angular embedding have mean angle sum > pi. Excess grows monotonically: DATA(0.86 rad) < THIN(0.97) < DEEP(1.31) < TRUE(1.31) < TRANS(1.38). Fattening jump (THIN->DEEP) 3x > thin step. Z/8 (even) EXACTLY FLAT (excess=0). Small triangles flat, equidistant (0,N/3,2N/3)=3pi via K-EXCLUSION: N/3 zero in all channels except 3^2=9, collapses to 3-axis. The excess is topological (torus periodicity), not intrinsic Riemannian. 34/34 verified.");
  render_theorem(sec, "Curvature Numerator Theorem (PROVED)", "At TRANS (7 channels), Hamming degree = 5^3 = 125. Each curvature numerator q_i-2 is axiom-native: 2^3-2=2*3, 3^2-2=7, 5^2-2=23(=3^3-2^2), 7^2-2=47(intruder boundary), 11-2=3^2, 13-2=11, 17-2=3*5. The 5-channel curvature = cross-lattice kappa numerator (23). ALIVE channels sum to 42 = ANSWER. Thin channels sum to 5*7 = 35 (490 split). Forman: F_7 = -105 = -HYDOR. 61/61 verified.");
  render_theorem(sec, "P-adic Ultrametric Theorem (PROVED)", "Each CRT channel Z/p^e is a p-ary tree with depth = Pareto exponent. All triangles are isosceles (exhaustive on all 7 channels). The product ring has tau(N) = 864 distinct p-adic distance profiles -- one per divisor. Building equation: tau*4 = 128*27 = 3456. Total tree depth = 12 = heartbeat. Fat depth = 9 (chain stop). phi(7^2) = 42 = ANSWER (outermost 7-shell). 97/97 verified.");
  render_theorem(sec, "Curvature Scale Theorem (PROVED)", "Cross-lattice kappa = 0 at squarefree rings (DATA, THIN), jumps to 23/27 at the fattening step (THIN->DEEP), then INVARIANT under thin extension (DEEP->TRUE->TRANS). Phase transition. D-K resonance: 2^3-2 = 3^2-3 = 2*3 = 6. Bridge and closure towers produce identical curvature gains. b-channel gain = 42 = ANSWER. 490 split in gain: DEAD channels gain D^2*17 = 68, ALIVE gains D*3 = 6. Fattening massively amplifies perceptual channels. K is the ONLY prime with integer curvature amplification: (3^2-2)/(3-2) = 7 = depth prime. 71/71 verified.");
  dom_append(dom_body(), sec)
)

fn geometry_cayley() = (
  let sec = make_section("800px") in
  render_h2(sec, "Chain-Cayley Diameter");
  render_p(sec, "Chain-Cayley graph: generators {+-2, +-3, +-5, +-7, +-11, +-13} (direct prime steps, distinct from the Sigma-graph which uses couplings N/p). Degree = 2^2*3 = 12. BFS from 0 finds how many steps to reach every element.");
  render_theorem(sec, "Diameter Theorem (PROVED)", "diam = N/(2*11) + 1. Z/970,200: 210^2 + 1 = 44101 (PRIME). Z/12,612,600: 210^2*13 + 1 = 573301 = 29 x 53 x 373 (COMPOSITE). Z/2,310: 106 = 2*53. Z/210: 11. Every 2*11 = 22 steps covers the ring.");
  render_theorem(sec, "13-Primality Breaking Theorem (PROVED)", "Adding 13 breaks the Cayley diameter primality via three resonances: (1) 13*2^2 + 1 = 53. (2) 7^2*13 + 1 = 2*11*(2^5 - 3) = 22*29 = 638. (3) 2*43*13 + 1 = 3*(2^3*3^2*5 + 13) = 3*373 = 1119. Each resonance has the form [chain element]*13 + 1 = factor*cofactor. 13 activates all three simultaneously. Without 13 (Z/970,200): 210^2 + 1 = 5 (mod 53), avoiding all resonances. Z/970,200 diameter is prime. 13 creates the breach. The 43 in resonance (3) is the largest Heegner discriminant: 210^2 mod 373 = 2*43.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Diameter");
  render_th(hdr, "Value");
  render_th(hdr, "Primality");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "11", "11", "Prime");
  render_table_row_4(tbl, "Z/2,310", "2 * 53", "106", "2 * 53");
  render_table_row_4(tbl, "Z/970,200", "210^2 + 1", "44101", "PRIME");
  render_table_row_4(tbl, "Z/12,612,600", "210^2*13 + 1", "573301", "(2^5-3) x 53 x (2^3*3^2*5+13)");
  dom_append(dom_body(), sec)
)

fn geometry_answer() = (
  let sec = make_section("800px") in
  render_h2(sec, "42: The Answer in Geometry");
  render_p(sec, "The number 42 = 2*3*7 appears as a geometric invariant from three independent directions.");
  render_theorem(sec, "Kirchhoff 42 Theorem (PROVED)", "Kf(C_8) = W(C_7) = 42 = 2*3*7. The electrical resistance of the 8-cycle EQUALS the Wiener distance of the 7-cycle. Unique: 7 is the ONLY integer n where Kf(C_{n+1}) = W(C_n). PROOF: the equation 4n = 28 has unique solution n = 7. QED.");
  render_theorem(sec, "Heat Half-Life (PROVED)", "Heat kernel half-life = ln(2)/mu_min = 42.21 ~ 42. Heat placed at one point on the Z/12,612,600 ring reaches half-dissipation at time 42. 42 is how long the ring remembers.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Channel forgetting at t = 42", "7^2 = 49 remembers 92.84%", "At t = 42: mod-8, mod-9, mod-11 channels 100% forgotten. mod-25: 99.84% forgotten. Only mod-49 still remembers -- the channel with the most states retains information longest.", "");
  dom_append(dom_body(), sec)
)

fn geometry_cross() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cross Products and Division Algebras");
 render_theorem(sec, "Cross Product Dimensions (Hurwitz)", "Norm-preserving vector cross products exist ONLY in dimensions {1, 3, 7}. This is the 1-chain: CC1(1) = 1 -> 3 -> 7 -> 15 (STOP, composite). PROOF: cross product in dim d requires normed division algebra in dim d+1. Normed division algebras (Hurwitz 1898): R(1), C(2), H(4), O(8) = {1, 2, 2^2, 2^3} = powers of 2. Cross product dims = 2^k - 1 for k = 0..3.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Two chains", "2-powers vs 1-chain", "2-powers {1,2,4,8}: normed division algebras. 1-chain {1,3,7}: cross products. Intersection: 1 = ground state.", "");
  render_finding(g, "3-dim uniqueness", "Cross product AND stable orbits", "Bertrand's theorem: exactly 2 central forces give closed orbits in 3 dims. Exponents: {-1, 2}. 3 restricts to 2 options.", "");
  render_finding(g, "Fano plane", "7 points, 3 per line", "Octonion multiplication = Fano plane. The unique cross product in 7 dims has {7, 3} structure.", "");
  render_finding(g, "GR hierarchy", "2^k * 5 for k = 0,1,2,3", "Scalar(1), Metric/Ricci(10), Riemann(20), Christoffel(40). 3^2 = 9 distinct tensor types. 2+2 = 2*2 unique to 2: Riemann(20) = Ricci(10) + Weyl(10).", "");
  dom_append(dom_body(), sec)
)

fn geometry_collinear() = (
  let sec = make_section("800px") in
  render_h2(sec, "Collinearity Threshold");
  render_theorem(sec, "CRT Diagonal (PROVED)", "CRT(n) = (n,n,n,n,n,n) iff n < 2^3 = 8. All elements {0,...,7} lie on the CRT diagonal. The inner chain {1, 2, 3, 5, 7} is 1-dimensional. 11 > 8: off-diagonal. CRT(11) = (3,2,11,11,0,11). 13 > 8: off-diagonal. CRT(13) = (5,4,13,13,2,0). Both 11 and 13 break the diagonal.");
  let g = make_findings_grid(sec) in
  render_finding(g, "13", "Only 9/10 proper triangles", "The pair {1, 2} stays collinear with 13. 2 lies on the geodesic from 1 to 13.", "");
  render_finding(g, "Expansion", "CRT Cayley: girth = 4, degree = 12", "CRT Cayley (Cartesian product of cycles): triangle-free since all q_i >= 4. Degree 12 = 2 generators per channel * 6 channels. Spectral gap from 7^2 = 49 channel (slowest mixer). (Chain-Cayley has same degree 12 but HAS triangles, e.g. 2+3=5.)", "");
  dom_append(dom_body(), sec)
)

fn geometry_torus() = (
  let sec = make_section("800px") in
  render_h2(sec, "Torus Keychain");
  render_p(sec, "CRT = T^7 = product of 7 circles on Z/214,414,200: S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17). The T^6 subtorus (drop 17) covers Z/12,612,600 -- the per-channel table below. The +1 diagonal winds (1,1,...,1) on both. Each circle wraps a different number of times (T^6 windings over Z/12,612,600):");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Size");
  render_th(hdr, "Winding");
  render_th(hdr, "Linking (8)");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2^3 = 8", "8", "1576575", "---");
  render_table_row_4(tbl, "3^2 = 9", "9", "1401400", "175175 (strongest)");
  render_table_row_4(tbl, "5^2 = 25", "25", "504504", "63063");
  render_table_row_4(tbl, "7^2 = 49", "49", "257400", "32175");
  render_table_row_4(tbl, "11", "11", "1146600", "143325");
  render_table_row_4(tbl, "13", "13", "970200", "121275");
  render_theorem(sec, "Linking Hierarchy (PROVED)", "Linking numbers link(i,j) = N/(q_i*q_j) = product of all OTHER channel sizes. Small channels link most strongly: 8--9 = 175175 (strongest). 25--49 = 10296 (weakest). The linking hierarchy REVERSES channel size. This IS the coupling hierarchy in topological form.");
  let g = make_findings_grid(sec) in
  render_finding(g, "13-channel winding = Z/970,200", "N/13 = 970200", "The 13-channel winding IS Z/970,200 (the 5-channel ring without mod-13). Every Z/970,200 winding = the linking between that channel and 13 in Z/12,612,600.", "");
  render_finding(g, "Nested torus chain", "Z/210 -> Z/2,310 -> Z/970,200 -> Z/12,612,600", "Each ring level = torus at different scale. Previous sub-torus embedded in next. The ring hierarchy = nested torus links.", "");
  render_finding(g, "Figure-ground switch", "ker(1576576) = shaft, image(1576576) = field", "|ker| = 2^3 = 8 (matter minority). |image| = 1576575 (field fills space). Like a magnet: small iron, vast field.", "");
  render_finding(g, "17 extends T^6 to T^7", "214,414,200 = 12,612,600 * 17", "The full T^7 torus adds an S^1(17) circle; 17-channel winding = 214414200/17 = 12612600 = Z/12,612,600. The 17-channel slice IS Z/12,612,600 -- parallel to the 13-slice = Z/970,200 finding above. One extra circle completes the 7-channel ring.", "");
  dom_append(dom_body(), sec)
)

fn geo_horn_cap() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Capped Horn");
  render_p(sec, "T^7 IS the Gabriel-Horn compactification of Z^7. Finite ring state space = the horn's finite-volume side; the continuum Z^7 Fourier spectrum = its infinite-surface side. The cap truncates modes at k <= N-1. Two Millennium-Prize STRUCTURAL analogs live on the same cap, sharing one controller: 7^2 = 49.");
  let g = make_findings_grid(sec) in
  render_finding(g, "49-forced gap floor", "gap = 4*sin^2(pi/49) ~ 0.01644", "Identical across all 108 = 2^2*3^3 lambda=420 rings (6-channel boundary, no 17). 7^2=49 strictly dominates 2^4=16, 3^2=9, 5^2=25, 11, 13. STRUCTURAL YM analog, NOT a Clay-YM proof.", "");
  render_finding(g, "CRT-decomposed Laplacian", "T^7 Laplacian = direct sum of 7 per-channel Laplacians", "Orthogonal Fourier subspaces forbid coupled blowup; seven independent horns, not one coupled horn. Bounded-ring energy E(t) <= E(0). STRUCTURAL NS analog, NOT a Clay-NS proof.", "");
  render_finding(g, "Z/214,414,200 inherits the floor", "17 < 49 = 7^2", "T^7 Z/214,414,200 (lambda = 1680 = 2^2 * 420) sits one 17-step above the 108 lambda=420 lattice and inherits its gap floor: adding a smaller channel width cannot lower q_max = 49. The capped-horn geometry extends cleanly from T^6 Z/12,612,600 to T^7 Z/214,414,200.", "");
  dom_append(dom_body(), sec)
)

