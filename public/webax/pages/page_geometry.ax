fn geo_discrete_solids() = (
  let sec = make_section("800px") in
  render_h2(sec, "Discrete Solids");
  render_p(sec, "Regular and semi-regular polyhedra classify by axiom primes. The classification COUNTS use extension primes (E, GATE), but the GEOMETRY of each solid (vertices, edges, faces) uses only the first three chain primes {D, K, E}. 490 split: taxonomy = outer, geometry = inner.");
  render_theorem(sec, "Discrete Geometry Axiom Taxonomy (S1707, PROVED)", "E=5 Platonic, GATE=13 Archimedean, D^2=4 Kepler-Poinsot, D^3=8 deltahedra. Platonic+Archimedean = D*K^2 = 18. ALL Platonic V/E/F use only {D,K,E}. Symmetry groups {D^3*K, D^4*K, D^3*K*E} = McKay subgroups. Rotation sum D^5*K = 96 = TRANS lattice count. Tilings: K+D^3 = L = 11 uniform. Polytope counts stabilize at K=3. Dod*Ico vertex product = P(b) = 240 = E8 roots. 140/140 test_regular_solids.ax.");
  render_theorem(sec, "Archimedean Axiom Anatomy (S1708, PROVED)", "ALL 13 Archimedean V and E are DATA-prime only {D,K,E}. Face counts escalate: D^2=4 DATA-only, K^2=9 non-DATA. D^2+K^2 = GATE = the count itself. Family V sums both contain GATE; E sums both contain c(L)=23. Ico/Oct ratio = E/D. Total Euler = D*GATE = 26. Vertex degrees = {K,D^2,E} with counts summing to GATE. 193/193 test_archimedean_anatomy.ax.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Platonic V = F", "Total V = Total F = D*E^2 = 50", "Self-duality sum. Total edges = D*K^2*E = 90. All factors = first K chain primes.", "S1707");
  render_finding(g, "Symmetry = McKay", "|Tet|=24, |Cube|=48, |Ico|=120", "D^3*K, D^4*K, D^3*K*E = Leech dim, phi(DATA), E!. All {D,K,E} only.", "S1707");
  render_finding(g, "Face escalation", "D^2 + K^2 = GATE = 13", "DATA-only faces + non-DATA faces = object count. Intruders {19,31,23} are all Cunningham.", "S1708");
  render_finding(g, "Johnson boundary", "92 = D^2*c(L)", "Intruder c(L)=23 at the Johnson solid boundary. DATA primes insufficient to count them.", "S1707");
  dom_append(dom_body(), sec)
)

