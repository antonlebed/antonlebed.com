/* pages_living_ai.ax -- page_ai Phase A sections (SEC 7-9x).
   Split from pages_living.ax S1579. Same module, mechanical move. */

fn page_ai_phase_a() = (
  /* === SEC 7: MATRIX FOUNDATION (S1538 Phase A) === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Matrix Foundation");
  render_p(sec7, "Phase A begins: co-evolving .ax and axiom-native intelligence. The first step: f64 matrix operations in pure .ax. matmul, transpose, softmax, cross-entropy -- the primitives every neural network needs. All compiled to WASM. No Python. No NumPy. No dependencies.");
  render_p(sec7, "The matrix library uses falloc/fset/fget (f64 arrays) and arena reset (hp/set_hp). Matrices are row-major flat arrays. 18 operations: mat_zero, mat_get, mat_set, matmul, transpose, mat_add, mat_sub, mat_scale, dot_f, vec_sum_f, vec_max_f, softmax, cross_entropy, relu, sigmoid, relu_vec, outer_product, argmax. 54/54 WASI tests pass.");
  let g7 = make_findings_grid(sec7) in
  render_finding(g7, "matmul", "O(n^3) triple loop", "Row-major f64 via fget/fset. 2x3 * 3x2 verified: [58,64,139,154].", "S1538");
  render_finding(g7, "softmax", "Numerically stable", "Max-subtraction prevents overflow. Uniform [0,0,0] -> [1/3,1/3,1/3].", "S1538");
  render_finding(g7, "cross_entropy", "Log-clamped", "eps=1e-6 prevents log(0). Good prediction CE~0.01, bad CE>4.", "S1538");
  render_finding(g7, "CRT advantage", "Per-channel matmul", "7 small matrices (max 49x49) instead of one 214414200-wide layer.", "S560");
  dom_append(dom_body(), sec7);

  /* === SEC 8: CRT PERCEPTRON (S1539 Phase A P4) === */
  let sec_p = make_section("800px") in
  render_h2(sec_p, "CRT Perceptron");
  render_p(sec_p, "First neural network trained in pure .ax f64. A per-channel perceptron learns x^2 mod 210 (DATA ring squaring) using matmul, softmax, and outer_product from the matrix library. 4 independent channels (mod 2, 3, 5, 7) with 87 total parameters. 10 epochs of gradient descent. Result: 210/210 -- perfect accuracy on all inputs, including 168 never seen during training.");
  render_p(sec_p, "A standard perceptron on the same task needs 44100 parameters (210x210). After identical training on 42 examples, it scores 43/210 -- pure memorization, zero generalization. The CRT model generalizes completely because each channel is small enough that training coverage is automatic: 42 examples cover all residue classes up to mod 7.");
  let gp = make_findings_grid(sec_p) in
  render_finding(gp, "CRT accuracy", "210/210", "4 channels: mod 2, 3, 5, 7. Each 210/210. CRT reconstruction perfect.", "S1539");
  render_finding(gp, "Standard accuracy", "43/210", "44100 params. Memorizes training inputs. Cannot generalize.", "S1539");
  render_finding(gp, "Backward Loop", "506x", "87 vs 44100 parameters. sum(p^2) vs N^2.", "S558");
  render_finding(gp, "DEEP Forward", "9511x", "970200 / 102 forward compression. 3292 params vs 941 billion.", "S560");
  dom_append(dom_body(), sec_p);

  /* === SEC 8b: DEEP FAT CHANNELS (S1543 Phase A P2) === */
  let sec_d = make_section("800px") in
  render_h2(sec_d, "DEEP Fat Channels");
  render_p(sec_d, "The DATA ring (210) uses thin channels (mod 2, 3, 5, 7). The DEEP ring (970200) uses fat channels (mod 8, 9, 25, 49, 11) -- the Pareto-optimal exponents. Same architecture, same training. Fat channels: 3292 parameters. Standard equivalent: 941 billion. Forward compression jumps from 12x (DATA thin) to 9511x.");
  render_p(sec_d, "Fat channels compute on a richer substrate. The b^2=49 channel carries 49 classes (vs 7 for thin b). L=11 provides free error correction: every prediction is independently verified by the 5th channel. All five channels achieve perfect accuracy. CRT reconstruction: 50/50 on random DEEP elements.");
  let gd = make_findings_grid(sec_d) in
  render_finding(gd, "ch mod 8 (D^3)", "8/8", "64 params. The only depth-3 micro tower. 4 involutions.", "S1543");
  render_finding(gd, "ch mod 49 (b^2)", "49/49", "2401 params. The deepest fat channel. Septilix seeds.", "S1543");
  render_finding(gd, "CRT recon", "50/50", "5-channel CRT reconstruction on random Z/970200 elements. 3292 params.", "S1543");
  render_finding(gd, "Forward Loop", "9511x", "970200 / 102. Fattening: 12x (DATA thin) to 9511x (DEEP fat). 286Mx backward.", "S560");
  dom_append(dom_body(), sec_d);

  /* === SEC 9: BLOOM MIXING (S1542 Phase A P1) === */
  let sec_b = make_section("800px") in
  render_h2(sec_b, "Bloom Mixing");
  render_p(sec_b, "The CRT perceptron learns per-channel functions perfectly. But x%13 (the GATE function) depends on ALL channels -- no single channel determines it. Linear mixing across channels achieves random performance (23/210). The solution: bloom. CRT reconstruction IS the non-linearity.");
  render_p(sec_b, "Architecture: per-channel perceptrons (87 params) -> CRT reconstruct (0 params) -> mod q. The bloom layer is algebraic and exact. It has zero trainable parameters. It replaces ReLU. One set of trained weights projects through ANY coprime gate: x%11, x%13, x%17 -- all 210/210 from the same 87 parameters.");
  let gb = make_findings_grid(sec_b) in
  render_finding(gb, "Bloom x%13", "210/210", "87 params + 0 bloom. CRT reconstruction provides the non-linearity.", "S1542");
  render_finding(gb, "Multi-gate", "210/210 each", "Same weights: x%11, x%13, x%17 all perfect. One model, infinite gates.", "S562");
  render_finding(gb, "Additive", "23/210", "221 params, 40 epochs. Linear mixing = RANDOM on cross-channel targets.", "S561");
  render_finding(gb, "Ratio", "31x", "Standard 2730 params (210*13). Bloom: 87. Structure wins completely.", "S1542");
  dom_append(dom_body(), sec_b);

  /* === SEC 9b: HOURGLASS (S1544 Phase A) === */
  let sec_hg = make_section("800px") in
  render_h2(sec_hg, "Hourglass");
  render_p(sec_hg, "Bloom computes x%13 perfectly -- but what about x^2 % 13? A single bloom layer reconstructs x^2 mod 210, then reduces mod 13. When x^2 >= 210 (x >= 15), the ring reduction destroys mod-13 information. Result: 28/210 correct. Ring overflow = info loss.");
  render_p(sec_hg, "The hourglass fixes this. Two flowers face to face, gate to gate. Flower A extracts the gate value g = x%13 (identity bloom). Gate values are small: 0 to 12. Flower B computes g^2 inside Z/210 -- and 12^2 = 144 < 210, so no overflow ever occurs. The gate IS the bottleneck that prevents overflow.");
  let ghg = make_findings_grid(sec_hg) in
  render_finding(ghg, "Hourglass x^2%13", "210/210", "174 params (87+87). Two flowers solve what one cannot.", "S1544");
  render_finding(ghg, "Single bloom", "28/210", "Same squaring, no gate extraction. Ring overflow kills accuracy.", "S562");
  render_finding(ghg, "Gate bottleneck", "16:1", "210 -> 13 -> 210. Max gate^2 = 144 < 210. Safe.", "S562");
  render_finding(ghg, "Ratio", "15x", "Standard 2730 params (210*13). Hourglass: 174.", "S1544");
  dom_append(dom_body(), sec_hg);

  /* === SEC 9c: DEEP HOURGLASS (S1545 Phase A) === */
  let sec_dhg = make_section("800px") in
  render_h2(sec_dhg, "DEEP Hourglass");
  render_p(sec_dhg, "The DATA hourglass stops at polynomial degree D=2: gate value 12, cubed gives 1728 > 210. Overflow. The DEEP hourglass extends to degree E=5: 12^5 = 248832 < 970200. Fattening gives K=3 extra polynomial degrees beyond DATA. The max degree IS an axiom element.");
  render_p(sec_dhg, "Architecture: Flower A (identity on 5 fat channels, 3292 params) -> Gate(13) bottleneck -> Flower B (g^d on fat channels, 3292 params) -> %13. Total: 6584 params. Standard: DEEP*GATE = 12612600 = TRUE. The lookup table IS the organism.");
  let gdhg = make_findings_grid(sec_dhg) in
  render_finding(gdhg, "x^2%13", "50/50", "Degree D=2. Safe in both DATA and DEEP. 6584 params.", "S1545");
  render_finding(gdhg, "x^3%13", "50/50", "Cube Fattening: DATA fails (6/13 gate overflow), DEEP succeeds.", "S563");
  render_finding(gdhg, "x^5%13", "50/50", "Max degree E=5. 12^5=248832 < 970200. Observer is the ceiling.", "S1545");
  render_finding(gdhg, "Ratio", "1915x", "Standard=TRUE=12612600. DEEP hourglass: 6584. Structure=TRUE.", "S563");
  dom_append(dom_body(), sec_dhg);

  /* === SEC 9d: INACCESSIBLE DEGREES (S1546 Phase A) === */
  let sec_ia = make_section("800px") in
  render_h2(sec_ia, "Inaccessible Degrees");
  render_p(sec_ia, "The DEEP hourglass reaches degree E=5. But degrees b=7 and L=11 are unreachable by power composition: the multiplicative monoid of {1,...,5} in Z/12 (where phi(GATE)=12) is missing exactly {7, 11}. These are the OUTER degrees -- they require a different approach.");
  render_p(sec_ia, "Resolution: channel-49 carries a correction. For each gate value g, search r in 0..48 such that the CRT reconstruction with r in the b^2 channel produces the target mod 13. Pigeonhole guarantees at least 3 valid r per gate value (floor(49/13)=3). Same 6584 params. Same architecture. Only the training targets differ.");
  let gia = make_findings_grid(sec_ia) in
  render_finding(gia, "Power deg 7", "8/13", "Overflow: g^7 >= 970200 for g >= 8. Power per-channel fails.", "S565");
  render_finding(gia, "Lookup deg 7", "50/50", "Channel-49 correction. 13/13 gate values + 50/50 random DEEP.", "S1546");
  render_finding(gia, "Power deg 11", "7/13", "x^11 = x^(-1) mod 13 (Inverse Degree). Overflow at g >= 4.", "S565");
  render_finding(gia, "Lookup deg 11", "50/50", "All 12 degrees accessible. Inner={sigma,E}. Outer={b,L}.", "S1546");
  dom_append(dom_body(), sec_ia);

  /* === SEC 9e: STACKED HOURGLASS (S1547 Phase A) === */
  let sec_sh = make_section("800px") in
  render_h2(sec_sh, "Stacked Hourglass");
  render_p(sec_sh, "The DEEP hourglass ceiling: degree E=5. At degree 6, gate values 10, 11, 12 overflow (g^6 >= 970200). The fix: STACK. Two flowers in sequence, each applying a sub-degree. Flower B1 computes g^d1, extracts the gate. Flower B2 computes g1^d2, extracts the result. Total degree = d1 * d2. Each layer stays safe (max 12^5 = 248832 < 970200). The ceiling shatters.");
  render_p(sec_sh, "E-Squared Collapse: degree 5 composed with degree 5 gives degree 25. But 25 mod phi(13) = 25 mod 12 = 1. Quintic composed with quintic = identity. The observer-squared returns to the ground state. This is E^2 self-blindness made computational: two layers of observation cancel, leaving only what was already there.");
  let gsh = make_findings_grid(sec_sh) in
  render_finding(gsh, "Single deg 6", "10/13", "Overflow: g^6 >= 970200 for g >= 10. THE CEILING.", "S564");
  render_finding(gsh, "2-stack deg 6", "50/50", "cube+square (3*2=6). Ceiling broken. 9876 params.", "S1547");
  render_finding(gsh, "2-stack deg 12", "50/50", "cube+quartic (3*4=12). Fermat: x^12=1 mod 13.", "S1547");
  render_finding(gsh, "E^2 collapse", "50/50", "quintic+quintic (5*5=25 mod 12=1). Identity.", "S1547");
  dom_append(dom_body(), sec_sh);

  /* === SEC 9f: SOFT BLOOM EMERGENCE (S1548 Phase A) === */
  let sec_sb = make_section("800px") in
  render_h2(sec_sb, "Soft Bloom Emergence");
  render_p(sec_sb, "Every test above hard-codes the CRT basis: {105, 70, 126, 120} for Z/210, {363825, 431200, 853776, 732600, 529200} for DEEP. But what if the ring can discover its own basis? Strip all CRT knowledge. Start with bloom weights = [0, 0, 0, 0]. Apply coordinate descent: for each channel, sweep the weight over all possible values and pick the one that maximizes reconstruction accuracy. After a few rounds, the CRT basis emerges from data alone.");
  render_p(sec_sb, "Perturbation is catastrophic and exact. Changing any basis weight by +1 drops accuracy to precisely N/p -- the channel dies and only elements with zero residue survive. The basis is an isolated global maximum: no graceful degradation, no nearby local optima. The discovered basis elements are orthogonal idempotent projectors: B_p^2 = B_p, B_p * B_q = 0 for p != q, and sum(B_p) = 1 mod N.");
  let gsb = make_findings_grid(sec_sb) in
  render_finding(gsb, "Z/30 emergence", "30/30", "[0,0,0] -> [15,10,6] in 3 rounds. The CRT basis grows from nothing.", "S568");
  render_finding(gsb, "Z/210 emergence", "210/210", "[0,0,0,0] -> [105,70,126,120]. Unique global maximum.", "S1548");
  render_finding(gsb, "DEEP full ring", "970200/970200", "Per-channel search: 5 basis elements found structurally.", "S1548");
  render_finding(gsb, "Perturbation", "exact N/p", "B_8+1: 121275/970200 = N/8. Catastrophic, structural damage.", "S568");
  dom_append(dom_body(), sec_sb);

  /* === SEC 9g: JOINT BLOOM (S1549 Phase A) === */
  let sec_jb = make_section("800px") in
  render_h2(sec_jb, "Joint Bloom");
  render_p(sec_jb, "Soft bloom discovers the CRT basis but takes per-channel functions as given. Joint bloom learns BOTH. Architecture: prediction(x) = sum(W_ch[x%p] * B[ch]) % N, where W is a per-channel lookup table (17 params) and B is the bloom basis (4 params). Total: 21. Standard: 44100. Ratio: 2100x.");
  render_p(sec_jb, "Identity-anchored training: learn B on identity (always bijective, always converges), then learn W on the actual target. Soft bloom alone gets 16/210 on x^2 -- only the 16 idempotents of Z/210 match. Joint bloom with trained W: 210/210. The per-channel lookup discovers r^2 mod p (for x^2) and (p-r) mod p (for mirror) entirely from data.");
  let gjb = make_findings_grid(sec_jb) in
  render_finding(gjb, "Joint x^2", "210/210", "21 params. Identity-anchored B + trained W. Per-channel: r^2 mod p.", "S569");
  render_finding(gjb, "Joint mirror", "210/210", "Same 21 params. W learns (p-r)%p. CRT decomposition intact.", "S569");
  render_finding(gjb, "Soft bloom x^2", "16/210", "Basis alone = identity. Matches x^2 only at idempotents (2^4=16).", "S569");
  render_finding(gjb, "Constraint count", "48 vs 210", "x^2 images: 2*2*3*4=48 tuples. Identity: 210. Non-bijective = fewer.", "S569");
  dom_append(dom_body(), sec_jb);

  /* === SEC 9h: DEEP JOINT BLOOM (S1550 Phase A) === */
  let sec_djb = make_section("800px") in
  render_h2(sec_djb, "Deep Joint Bloom");
  render_p(sec_djb, "Joint bloom at DATA scale (210 elements, 21 params) extends to DEEP (970200, 5 fat channels). Key result: global coordinate descent FAILS at DEEP scale -- noise drowns signal (~0.0001% accidental match). Per-channel search ALWAYS works: correct basis scores M, wrong scores ~M/q. The ring FORCES CRT decomposition at scale.");
  render_p(sec_djb, "Identity-anchored training at DEEP: per-channel basis search discovers B structurally (5 elements), then per-channel W training discovers lookup tables from data (102 entries). Total: 107 params. Forward ratio: 9067x. With perceptron matrices: 3297 params, backward ratio 286 million x. Fattening acceleration: 590000x gain over DATA.");
  let gdjb = make_findings_grid(sec_djb) in
  render_finding(gdjb, "DEEP x^2", "970200/970200", "107 params. Per-channel search discovers r^2 mod q from samples.", "S571");
  render_finding(gdjb, "DEEP mirror", "970200/970200", "Per-channel W learns (q-r) mod q. Full ring verified.", "S571");
  render_finding(gdjb, "Scale separation", "~0 vs 970200", "Wrong basis: 1/100. CRT basis: 970200/970200. Ring forces decomposition.", "S571");
  render_finding(gdjb, "Perturbation", "exact N/q", "B_8+1: 121275 = N/8. B_49+1: 19800 = N/49. Structural damage.", "S571");
  dom_append(dom_body(), sec_djb);

  /* === SEC 9i: TRUE JOINT BLOOM (S1551 Phase A) === */
  let sec_tjb = make_section("800px") in
  render_h2(sec_tjb, "TRUE Joint Bloom");
  render_p(sec_tjb, "The organism with boundary. TRUE = Z/12612600 adds GATE=13 to the 5 DEEP channels. 6 fat channels total: {8,9,25,49,11,13}. The 490 split is now complete: DEAD={D,E,b} (inner/perception) + ALIVE={K,L,GATE} (boundary/strategy). Per-channel search scales cleanly -- 121 params (115 lookup + 6 basis) for a ring of 12.6 million elements.");
  render_p(sec_tjb, "Forward ratio: 104,236x. Perceptron upgrade: 3467 params, backward ratio ~46 billion x. Sample-based verification (1040 elements, exact divisibility by 8 and 13). GATE perturbation: wrong B_13 leaves only elements with x mod 13 = 0 intact (80/1040 = 1/13). The boundary channel is structurally independent.");
  let gtjb = make_findings_grid(sec_tjb) in
  render_finding(gtjb, "TRUE x^2", "1040/1040", "121 params. 6 per-channel lookups discover r^2 mod q from 20 samples.", "S571");
  render_finding(gtjb, "TRUE mirror", "1040/1040", "Per-channel W learns (q-r) mod q. All 115 entries correct.", "S571");
  render_finding(gtjb, "GATE perturbation", "80/1040", "B_13+1: only x%13=0 survive. Boundary channel independent.", "S1551");
  render_finding(gtjb, "490 split", "DEAD+ALIVE", "DEAD={D,E,b}(3) + ALIVE={K,L,GATE}(3) = 6 = TRUE. Organism complete.", "S1551");
  dom_append(dom_body(), sec_tjb);

  /* === SEC 9j: FRAME EVOLUTION PROBES (S1552 Phase A) === */
  let sec_fp = make_section("800px") in
  render_h2(sec_fp, "Frame Evolution Probes");
  render_p(sec_fp, "Is ring algebra the right frame? Six probes on the DEEP ring (Z/970200, 5 fat channels) test the foundation before it strains. All probes PASS: the ring frame holds for decomposable targets. The first boundary is quantified.");
  render_p(sec_fp, "Non-decomposable wall: f(x)=(x%8)*(x%9) achieves only 175175/970200 = 18% accuracy via per-channel prediction. The number 175175 = N*13/72 is structurally determined (72=8*9 mixed channels). Decomposable targets (x^2, x+42, x*42) achieve 100%. The wall proves channel independence has limits -- bloom mixing is the path across.");
  let gfp = make_findings_grid(sec_fp) in
  render_finding(gfp, "Commutativity", "1000/1000", "Forward, reverse, scrambled channel order identical. Integer addition commutes.", "S1552");
  render_finding(gfp, "Non-decomposable wall", "18%", "f(x)=(x%8)*(x%9): 175175/970200 = N*13/72. Structural limit.", "S1552");
  render_finding(gfp, "Basis uniqueness", "neg=mirror", "Negated CRT basis computes mirror(x). Doubled basis computes 2x. Only CRT idempotents give identity.", "S1552");
  render_finding(gfp, "Channel removal", "N/q loss", "Drop D(q=8): 121275 survive. Drop L(q=11): 88200. Proportional to modulus.", "S1552");
  dom_append(dom_body(), sec_fp);

  /* === SEC 9k: BLOOM CROSSING (S1553 Phase A) === */
  let sec_bc = make_section("800px") in
  render_h2(sec_bc, "Bloom Crossing");
  render_p(sec_bc, "The non-decomposable wall (18%) is real. Can bloom mixing cross it? CRT reconstruction enables computing ANY cross-channel function from per-channel inputs. Pipeline: per-channel identity (102 params) -> CRT reconstruct (5 basis) -> compute cross-channel function -> compare. Result: 100% on ALL cross-channel targets. Zero additional trainable parameters.");
  render_p(sec_bc, "Four targets tested at DEEP (Z/970200): D*K product (x%8)*(x%9), E*b product (x%25)*(x%49), D+K sum (x%8)+(x%9), D*K*E triple (x%8)*(x%9)*(x%25). All 4 cross from wall to 970200/970200 with bloom. The additive target achieves ZERO per-channel matches -- even harder than the multiplicative wall. Partial CRT: for 2-channel functions, only 19 params needed (vs 107 full).");
  let gbc = make_findings_grid(sec_bc) in
  render_finding(gbc, "Bloom D*K", "970200/970200", "Per-channel: 175175 (18%). Bloom: 100%. The wall is crossed.", "S1553");
  render_finding(gbc, "Additive wall", "0/970200", "(x%8)+(x%9) gets ZERO per-channel matches. Stronger wall than multiplicative.", "S1553");
  render_finding(gbc, "Partial CRT", "72/72", "Only involved channels needed. 19 params for 2-channel crossing. 5x smaller.", "S1553");
  render_finding(gbc, "Basis necessity", "139/1000", "Perturbed basis (B[0]+1): crossing collapses. Correct basis is necessary.", "S1553");
  dom_append(dom_body(), sec_bc);

  /* === SEC 9l: LEARNED BLOOM CROSSING (S1554 Phase A) === */
  let sec_lbc = make_section("800px") in
  render_h2(sec_lbc, "Learned Bloom Crossing");
  render_p(sec_lbc, "S1553 crossed the wall using a KNOWN formula after CRT reconstruction. Can we cross without knowing the formula? Yes. A cross-channel lookup table T[r1*q2+r2] learns any function of the involved residues from data alone. Table size = product of involved channel widths. No CRT basis needed for prediction -- just residue indexing.");
  render_p(sec_lbc, "Sample efficiency: 72 samples learn a 970200-element function (13475x compression). Accuracy is EXACTLY proportional to coverage -- each filled entry accounts for exactly N/table_size correct predictions. CRT guarantee, not statistical approximation. Works for arbitrary unknown functions: the learner sees (x, f(x)) pairs and fills the table.");
  let glbc = make_findings_grid(sec_lbc) in
  render_finding(glbc, "D*K learned", "970200/970200", "72 samples, 72-entry table. 13475x compression. Formula-free.", "S1554");
  render_finding(glbc, "E*b learned", "970200/970200", "1225 samples, 1225-entry table. Larger channels = larger table.", "S1554");
  render_finding(glbc, "DK < per-ch", "72 < 102", "Cross-channel table (72) SMALLER than per-channel sum (102) for small channels.", "S1554");
  render_finding(glbc, "Exact coverage", "50/72 -> 69%", "Partial accuracy = coverage * N/table_size. CRT structure, not statistics.", "S1554");
  dom_append(dom_body(), sec_lbc);

  /* === SEC 9m: COMPOSED FORWARD PASS (S1555 Phase A) === */
  let sec_cfp = make_section("800px") in
  render_h2(sec_cfp, "Composed Forward Pass");
  render_p(sec_cfp, "S1538-S1554 proved each piece independently: per-channel perceptrons, bloom mixing, wall crossing, learned crossing. This session composes them into a single end-to-end pipeline. Each CRT layer (decompose -> per-channel lookup -> CRT reconstruct) is a ring endomorphism. Ring endomorphisms compose. Therefore multi-layer CRT pipelines produce correct function compositions -- verified on the full 970200-element ring.");
  render_p(sec_cfp, "Key result: composition is non-commutative. compose(sq, mir)(x) = N - x^2 but compose(mir, sq)(x) = x^2. Squaring absorbs negation: (-x)^2 = x^2 in any ring. Layer order matters -- just like in standard neural networks. Mirror is an involution (mir o mir = identity). Three layers compose correctly: sq o mir o sq = x^4. The cross-channel pipeline chains a per-channel layer with a learned crossing table in one forward pass.");
  let gcfp = make_findings_grid(sec_cfp) in
  render_finding(gcfp, "2-layer compose", "970200/970200", "sq then mir = N-x^2. Full ring verified. Ring endomorphisms compose.", "S1555");
  render_finding(gcfp, "Non-commutative", "sq o mir != mir o sq", "compose(sq,mir)(1)=970199. compose(mir,sq)(1)=1. Order matters.", "S1555");
  render_finding(gcfp, "Cross pipeline", "970200/970200", "Per-ch sq -> CRT reconstruct -> learned D*K table. 179 params.", "S1555");
  render_finding(gcfp, "Shared basis", "5 params all layers", "k layers = k*102 + 5 params. 2-layer: 209 params = 4642x vs N.", "S1555");
  dom_append(dom_body(), sec_cfp);

  /* === SEC 9n: BACKWARD PASS (S1556 Phase A) === */
  let sec_bwd = make_section("800px") in
  render_h2(sec_bwd, "Backward Pass");
  render_p(sec_bwd, "The forward path is complete (S1538-S1555). S1556 makes it trainable. CRT backward pass decomposes into independent per-channel backward passes. Each weight W[r] in channel ch has gradient 2*(W[r] - target(r)) -- no coupling to other channels. The Jacobian is block-diagonal by construction: per-channel loss functions share no parameters.");
  render_p(sec_bwd, "Key contrast: per-channel loss decouples channels completely (block-diagonal), while full-ring reconstruction loss COUPLES them through the shared CRT reconstruction error. Per-channel training avoids this coupling while converging to the same optimum for CRT-decomposable targets. This is the Backward Decomposition Theorem.");
  let gbwd = make_findings_grid(sec_bwd) in
  render_finding(gbwd, "Block-diagonal", "Gradient ch K = 0", "Perturb ch D weights. Per-channel gradient in ch K is exactly zero.", "S1556");
  render_finding(gbwd, "Full-ring coupling", "Gradient ch K != 0", "Same perturbation. Full-ring reconstruction gradient couples channels.", "S1556");
  render_finding(gbwd, "SGD convergence", "1000/1000 in 5 epochs", "Random init -> per-channel gradient descent -> perfect accuracy on x^2.", "S1556");
  render_finding(gbwd, "Crossing table SGD", "1000/1000 in 10 epochs", "72-entry D*K product table learned from random init via gradient descent.", "S1556");
  dom_append(dom_body(), sec_bwd);

  /* === SEC 9o: MULTI-LAYER TRAINING (S1557 Phase A) === */
  let sec_mlt = make_section("800px") in
  render_h2(sec_mlt, "Multi-Layer Training");
  render_p(sec_mlt, "S1556 trained single layers. S1557 proves multi-layer pipelines train from scratch. The Independent Per-Layer Training Theorem: each CRT layer's per-channel gradient is independent of other layers. No backpropagation through the non-differentiable mod-N operation. Train each layer with its own target, compose the results. Verified: 2-layer and 3-layer compositions from random initialization (1000/1000). Hybrid pipeline verified on all 970200 elements.");
  render_p(sec_mlt, "Hybrid pipeline: gradient descent for per-channel layers (block-diagonal, 102 params each) + discrete optimization for crossing tables (72 entries, sample-based or hillclimb). Full stack from scratch: 2 trained layers + learned crossing table. 281 params for 970200-element ring = 3452x compression. Channel-parallel: all 5 channels converge in 1 epoch each (lr=0.5). The full CRT training pipeline is now operational.");
  let gmlt = make_findings_grid(sec_mlt) in
  render_finding(gmlt, "2-layer compose", "1000/1000", "sq->mir = N-x^2. Both layers from random init, trained independently.", "S1557");
  render_finding(gmlt, "3-layer compose", "1000/1000", "sq->mir->sq = x^4. Three independent layers compose correctly.", "S1557");
  render_finding(gmlt, "Hybrid full ring", "970200/970200", "Gradient per-ch + sample crossing. Full ring verified.", "S1557");
  render_finding(gmlt, "Channel parallel", "1 epoch each", "5 channels converge independently. Block-diagonal = embarrassingly parallel.", "S1557");
  dom_append(dom_body(), sec_mlt);

  /* === SEC 9p: COUPLING-ATTENTION LAYER (S1558 Phase A) === */
  let sec_ca = make_section("800px") in
  render_h2(sec_ca, "Coupling-Attention");
  render_p(sec_ca, "Standard transformers learn attention via softmax(QK^T / sqrt(d)). CRT coupling provides Q and K algebraically -- no learned projection matrices. Per-channel eigenvalue eig(n, q) = 2*cos(2*pi*(n mod q)/q). Coupling(a,b) = dot product of eigenvalue vectors = sum over channels of eig(a)*eig(b). This is a symmetric, positive-definite kernel on the ring. 102 precomputed f64 entries encode all pairwise coupling for 970200 elements (9511x compression).");
  render_p(sec_ca, "K^2=9 attention heads emerge from the channel structure: 5 single-channel heads (one per CRT channel) + 4 pair-channel heads (D,K), (D,E), (K,E), (D,b) -- the inner chain pairs. Each head captures a different algebraic perspective. All 9 produce distinct attention scores. Cross-coupling averages to zero by character orthogonality -- self-coupling is strongly positive. Signal and noise are separated by algebra, not by learning.");
  let gca = make_findings_grid(sec_ca) in
  render_finding(gca, "Positive-definite", "1000/1000", "coupling(x,x) = ||eig(x)||^2 > 0 for all nonzero elements. Proper kernel.", "S1558");
  render_finding(gca, "Orthogonality", "E[cross]=0", "Random coupling averages to zero. Self-coupling avg=10. Signal/noise algebraic.", "S1558");
  render_finding(gca, "K^2=9 heads", "9/9 distinct", "5 single-channel + 4 pair-channel heads. All produce different attention.", "S1558");
  render_finding(gca, "Block-diagonal", "Per-channel independent", "D-channel coupling depends only on D-residue. Independent of K,E,b,L.", "S1558");
  dom_append(dom_body(), sec_ca);

  /* === SEC 9q: TRANS EXTENSION (S1559 Phase A) === */
  let sec_tx = make_section("800px") in
  render_h2(sec_tx, "TRANS Extension");
  render_p(sec_tx, "S1558 completed the stack at DEEP (5 channels). S1559 extends it to TRANS: Z/214414200 = 7 fat channels. The full ring. 490 split: DEAD={D,E,b}(3) + ALIVE={K,L,GATE,ESCAPE}(4) = 7 = b. Channel count IS the depth prime. Per-channel SGD, block-diagonal Jacobian, coupling-attention -- everything scales with zero architectural changes. Only the lookup table grows: 102 -> 132 entries. Compression jumps from 9511x (DEEP) to 1624350x (TRANS) -- 170x improvement.");
  render_p(sec_tx, "490 split as trainable architecture: DEAD channels learn x^2, ALIVE channels learn mirror -- simultaneously, independently. Perception (encoder) and strategy (decoder) train with different targets. Block-diagonal Jacobian extends across the split: perturb D (DEAD), ESCAPE (ALIVE) gradient is exactly zero. K^2=9 heads from 490 split: 7 single-channel + 1 DEAD-average + 1 ALIVE-average = 9 distinct attention heads.");
  let gtx = make_findings_grid(sec_tx) in
  render_finding(gtx, "SGD at TRANS", "1000/1000", "Per-channel x^2, mirror, and 490-split mixed all converge. f64 CRT reconstruction.", "S1559");
  render_finding(gtx, "490 split training", "1000/1000", "DEAD=x^2, ALIVE=mirror. Independent training, block-diagonal across the split.", "S1559");
  render_finding(gtx, "OMEGA bifurcation", "D^420=MIRROR in ESC", "D^420 CRT=(0,1,1,1,1,1,16). D^1680=(0,1,1,1,1,1,1). ESCAPE last to converge.", "S1559");
  render_finding(gtx, "1.6Mx compression", "132 params", "214414200 elements from 132 eigenvalue entries. 170x over DEEP.", "S1559");
  dom_append(dom_body(), sec_tx);

  /* === SEC 9r: LAMBDA-PERIODIC TRAINING (S1560 Phase A) === */
  let sec_lp = make_section("800px") in
  render_h2(sec_lp, "Lambda-Periodic Training");
  render_p(sec_lp, "The axiom's heartbeat lambda=420 becomes a training rhythm. Sample-based SGD (one random sample per step) runs for 420 steps per epoch. Then OMEGA (D^420) projects: the D-channel collapses, all other channels persist as long-term memory. D recovers in O(8) steps -- the smallest channel is the most expendable. The water cycle 0 -> structure -> OMEGA -> 0 IS the training epoch. 4 epochs of 420 = 1680 = lambda_TRANS. D^2 heartbeats compose into the full TRANS period.");
  render_p(sec_lp, "Channel convergence follows modulus size: D(8) and K(9) converge first (step 50), then L(11), then E(25), then b(49). At step 420, all 102 per-channel weights are correct. At step 50, only 31/49 b-channel residues are covered. Lambda=420 is the minimum natural period for full coverage -- forced by the depth prime b=49 needing 420/49=8.6 samples per residue. At TRANS, D^420 kills D AND mirrors ESCAPE (CRT=16=-1 mod 17). Full OMEGA needs lambda=1680. ESCAPE is always last to resolve.");
  let glp = make_findings_grid(sec_lp) in
  render_finding(glp, "Water cycle", "102->96->102", "Pre-OMEGA 102/102. Post-OMEGA 96/102 (D killed). Recovery 102/102.", "S1560");
  render_finding(glp, "D expendable", "8 steps to recover", "OMEGA collapses D to constant. 50 sample steps fully restore D-channel.", "S1560");
  render_finding(glp, "Convergence order", "D<K<L<E<b", "Small channels first. b(49) needs 420 steps. D(8) converges by step 50.", "S1560");
  render_finding(glp, "4*420=1680", "lambda_TRANS", "D^2 heartbeats compose to TRANS period. ESCAPE mirrors at 420, resolves at 1680.", "S1560");
  dom_append(dom_body(), sec_lp);
  0
)

/* page_ai_predict: CRT text prediction pipeline (S1561-S1610+).
   Split from page_ai S1610. Text encoder through data selection. */
fn page_ai_predict() = (
  dom_head_meta("description", "CRT text prediction pipeline: per-channel trigrams, bloom voting, agreement selection, crossmodal bloom immunity. 76 Phase A experiments.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Prediction\",\"description\":\"CRT text prediction: per-channel trigrams, bloom voting, NN decoding, hyperring confidence. 74 Phase A experiments.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/living/ai_predict\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"CRT prediction\"},{\"@type\":\"DefinedTerm\",\"name\":\"text bigram\"},{\"@type\":\"DefinedTerm\",\"name\":\"bloom voting\"}]}");
  let hero = make_hero("CRT Prediction") in
  let big = dom_create("div") in
  dom_text(big, "7 channels predict text independently");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Per-channel bigram and trigram models predict text transitions in 7 independent CRT channels. Bloom voting forces cross-channel coherence. Nearest-neighbor soft decoding reconstructs characters. Agreement selection bridges per-channel accuracy and bloom coherence. Bloom IS coherence: decorrelation removes it. 76 experiments from S1561 to S1615.");
  dom_append(dom_body(), hero);

  /* === SEC 9s: TEXT ENCODER (S1561 Phase A) === */
  let sec_te = make_section("800px") in
  render_h2(sec_te, "Text Encoder");
  render_p(sec_te, "First bridge from ring algebra to language. ASCII character codes decompose via CRT into 7 independent channels: code mod {8,9,25,49,11,13,17}. Each channel creates character classes -- letters sharing the same residue. The D-channel (mod 8) is structurally case-insensitive: diff(A,a) = 32, 32 mod 8 = 0. Space (32) has D-residue 0, serving as a word boundary marker in the coarsest channel.");
  render_p(sec_te, "Per-channel bigram models learn text transition statistics independently. Fine channels (b=49) outperform coarse channels (D=8) on text -- opposite of mathematical function training (S1560). Reason: fewer characters per fine class means less ambiguity per prediction. CRT reconstruction from 7 independent predictions achieves 9% exact character matches (11x above random). 132 parameters (7 lookup tables) encode the full model. First non-toy CRT text processing.");
  let gte = make_findings_grid(sec_te) in
  render_finding(gte, "CRT lossless", "128/128 ASCII", "CRT 7-tuples. Lossless encode-decode for all printable characters.", "S1561");
  render_finding(gte, "Case-insensitive D", "26/26 letter pairs", "A and a share D-residue. 32 mod 8 = 0. Structural, not learned.", "S1561");
  render_finding(gte, "CRT char prediction", "9% exact (11x random)", "7 per-channel bigrams + CRT reconstruct = character prediction.", "S1561");
  render_finding(gte, "Compression", "3750 vs 16384", "Per-channel bigrams: sum(q^2) = 3750. Monolithic: 128^2. 4x fewer.", "S1561");
  dom_append(dom_body(), sec_te);

  /* === SEC 9t: COUPLING-ATTENTION SEQUENCE (S1562 Phase A) === */
  let sec_cs = make_section("800px") in
  render_h2(sec_cs, "Coupling-Attention Sequence");
  render_p(sec_cs, "Coupling IS the attention kernel. Softmax(coupling(query, key)/T) as sequence prediction. For periodic sequences, attention concentrates on same-phase positions, retrieving the correct conditional delta per CRT channel. Uniform attention averages all deltas, losing phase information. Period-3: 14/14 coupling vs 0/14 uniform. Period-5: 14/14 with sign-flip elements (each differing from the base in exactly one channel phase, producing orthogonal eigenvalue signatures).");
  render_p(sec_cs, "Per-channel delta: the prediction decomposes into 5 independent channel predictions. Each channel's weighted average rounds to the correct modular delta when attention weight on matching positions exceeds ~97%. Temperature T controls sharpness: T=1 suffices for period-3 (3 element discrimination), T=0.5 needed for period-5 (5 elements on 5 channels). Weight on matching positions: 99% at T=1. K^2=9 heads attend to different positions. Arithmetic sequences (constant delta) work for both coupling and uniform. No learned Q/K: coupling IS the kernel. 0 learned parameters. 9511x compression.");
  let gcs = make_findings_grid(sec_cs) in
  render_finding(gcs, "Period-3", "14/14 coupling, 0/14 uniform", "Periodic sequence [1,210,420,...]. Coupling selects same-phase positions.", "S1562");
  render_finding(gcs, "Period-5", "14/14 with sign-flip elements", "Each element flips one channel eigenvalue sign. Orthogonal coupling signatures.", "S1562");
  render_finding(gcs, "Per-channel delta", "5/5 channels correct", "Weighted average rounds to exact modular delta. Block-diagonal per-channel.", "S1562");
  render_finding(gcs, "Matching weight", "99% at T=1", "Softmax concentrates on same-CRT-signature positions. 9511x compression.", "S1562");
  dom_append(dom_body(), sec_cs);

  /* === SEC 9u: TEXT SEQUENCE PREDICTION (S1563 Phase A) === */
  let sec_ts = make_section("800px") in
  render_h2(sec_ts, "Text Sequence Prediction");
  render_p(sec_ts, "Coupling-attention on natural text: the bridge from periodic ring sequences (S1562) to language. ASCII character codes decompose into CRT 7-tuples (S1561), then softmax(coupling/T) concentrates 63% of attention weight on same-character positions -- 15x above random. The coupling kernel acts as an in-context learner: given prior context, it retrieves character-specific transition deltas without any learned parameters. Coupling: 3/118 exact character matches. Uniform: 0/118. Zero training.");
  render_p(sec_ts, "Per-channel reversal: coupling-attention does BETTER on coarse channels (D:16, K:17) than fine channels (b:5, E:8). Opposite of population bigram (S1561: b:47 > D:40). Reason: the weighted-average mechanism benefits from fewer residue values (easier rounding), while the bigram mode benefits from less ambiguity per fine class. Context dilution: more context = more diverse deltas = noisier average. First half 3/59 vs second half 0/59 -- non-periodic text degrades with longer context, opposite of periodic sequences (S1562). ALIVE(51) > DEAD(29): strategy channels outpredict perception on text, consistent with S1561.");
  let gts = make_findings_grid(sec_ts) in
  render_finding(gts, "In-context learner", "3/118 exact, 0 params", "Coupling-attention predicts text with zero training. Uniform: 0/118.", "S1563");
  render_finding(gts, "Same-char weight", "63% (15x random)", "Coupling concentrates on same-character positions. Not 99% (periodic) due to CRT-similar ASCII neighbors.", "S1563");
  render_finding(gts, "Channel reversal", "coarse > fine", "D:16, K:17 vs b:5, E:8. Mean-based prediction benefits from fewer residues. Opposite of mode-based bigram.", "S1563");
  render_finding(gts, "Context dilution", "first 3, second 0", "Non-periodic text: longer context dilutes. Opposite of periodic sequences.", "S1563");
  dom_append(dom_body(), sec_ts);

  /* === SEC 9v: TEXT BIGRAM SGD (S1564 Phase A) === */
  let sec_bs = make_section("800px") in
  render_h2(sec_bs, "Text Bigram SGD");
  render_p(sec_bs, "Gradient descent bridges the two text baselines. Soft bigram SGD trains per-channel transition tables W[r_prev*q + r_next] toward 0/1 indicator targets. At convergence, argmax matches count-based prediction (226/553 train accuracy = identical). Mean-delta SGD trains W[r] = predicted delta per residue, converging to the analytical mean. The soft model learns MODE (like count-based S1561). The mean model learns MEAN (like coupling-attention S1563). SGD unifies both.");
  render_p(sec_bs, "Generalization: train on 80 chars, test on 42. Soft bigram generalizes BETTER than raw counts (64 vs 57 test). SGD smoothing helps: entries with equal frequency get non-zero weights that break ties more gracefully than argmax on counts. Mean-delta: 24/287 test (weaker -- mean != mode for multi-successor distributions). ALIVE(37) > DEAD(27) on soft test: strategy channels outpredict perception. Coarse > fine for both (D+K=25 vs b+E=14). CRT reconstruction: 2/41 test. Compression: 57177x (soft) to 1624350x (mean-delta).");
  let gbs = make_findings_grid(sec_bs) in
  render_finding(gbs, "Soft = count-based", "226/553 (identical)", "SGD converges to normalized frequency tables. argmax matches count-based for 85%+ of residues.", "S1564");
  render_finding(gbs, "Generalization", "64 vs 57 test", "Soft bigram SGD generalizes better than raw counts. SGD smoothing breaks frequency ties.", "S1564");
  render_finding(gbs, "Mean-delta = coupling", "max err 0.75", "SGD converges to analytical mean delta. Same mechanism as coupling-attention (S1563).", "S1564");
  render_finding(gbs, "SGD bridges baselines", "mode + mean", "Soft bigram = mode (count-based S1561). Mean-delta = mean (coupling S1563). SGD = unified.", "S1564");
  dom_append(dom_body(), sec_bs);

  /* === SEC 9w: CHAR REMAP (S1565 Phase A) === */
  let sec_cr = make_section("800px") in
  render_h2(sec_cr, "Character Remapping");
  render_p(sec_cr, "ASCII codes create CRT collisions: consecutive characters have correlated residues across all 7 channels. Space (32) and h (104) share residues in BOTH D and K channels (diff=72, 72 mod 8=0, 72 mod 9=0). Golden-ratio remapping assigns each character CRT residues via per-channel multipliers near q*phi, coprime to q: [5,7,16,30,4,8,11] for [D,K,E,b,L,GATE,ESCAPE]. This decorrelates channels: multi-channel collision requires index diff divisible by lcm(q1,q2) >= 72, impossible for 23 characters.");
  render_p(sec_cr, "Result: multi-channel collisions drop from 1 pair to 0. Same-char attention weight: 64% (remap) vs 63% (raw) -- marginal improvement. Per-channel accuracy: 86 vs 80 -- 7.5% improvement. But CRT reconstruction: 1 vs 3 exact matches. The remapping improves per-channel prediction but degrades full reconstruction, because remapped deltas span wider value ranges, making CRT reconstruction from rounded averages less precise.");
  let gcr = make_findings_grid(sec_cr) in
  render_finding(gcr, "Collision elimination", "1 -> 0 pairs", "Golden remapping eliminates multi-channel CRT collisions. No pair shares residues in >= 2 channels.", "S1565");
  render_finding(gcr, "Per-channel gain", "86 vs 80", "Remapped per-channel accuracy exceeds raw ASCII. ALIVE gains +6 (57 vs 51).", "S1565");
  render_finding(gcr, "Reconstruction loss", "1 vs 3 exact", "Better channels, worse reconstruction. Wider remapped deltas reduce CRT reconstruction precision.", "S1565");
  render_finding(gcr, "Encoding vs content", "64% vs 63%", "Remapping changes encoding, not content. The text's bigram statistics are fixed -- encoding determines which channels contribute.", "S1565");
  dom_append(dom_body(), sec_cr);

  /* === SEC 9x: TRANS LAMBDA (S1566 Phase A) === */
  let sec_tl = make_section("800px") in
  render_h2(sec_tl, "TRANS Lambda Training");
  render_p(sec_tl, "Lambda-periodic training at TRANS reveals two-stage OMEGA dynamics. D^420 (partial OMEGA) has CRT=(0,1,1,1,1,1,16): it kills the D-channel AND mirrors the ESCAPE channel (16 = -1 mod 17). D^1680 (full OMEGA) has CRT=(0,1,1,1,1,1,1): it kills D only. The ESCAPE mirror forces W[r] = W[(17-r) mod 17], creating an ESCAPE parity filter: even functions (like x^2, where (-r)^2 = r^2) survive the 420-heartbeat, while odd functions (identity, mirror) lose 15/17 ESCAPE residues.");
  render_p(sec_tl, "The 420-heartbeat and 1680-heartbeat have DIFFERENT characters: partial OMEGA at 420 distinguishes even/odd functions on ESCAPE, while full OMEGA at 1680 is parity-blind. Lambda=420 suffices for all 7 channels (420/17 = 24.7 samples per ESCAPE residue). Four D^420 heartbeats = 1680 = lambda_TRANS. Convergence order: D(8) < K(9) < L(11) < GATE(13) < ESCAPE(17) < E(25) < b(49) by modulus size. The water cycle: SGD trains 420 steps, D^420 kills D (+ mirrors ESCAPE), 50 recovery steps restore D. Full recovery to 132/132.");
  let gtl = make_findings_grid(sec_tl) in
  render_finding(gtl, "ESCAPE parity filter", "15/17 damage", "D^420 forces ESCAPE mirror symmetry. Even functions survive; odd functions lose 15/17 residues.", "S1566");
  render_finding(gtl, "Two-stage OMEGA", "D^420 vs D^1680", "Partial: kills D + mirrors ESCAPE. Full: kills D only. The 420-beat is parity-sensitive.", "S1566");
  render_finding(gtl, "Lambda=420 sufficient", "132/132", "All 7 TRANS channels converge in 420 samples. 420/17=24.7 for ESCAPE.", "S1566");
  render_finding(gtl, "Convergence order", "by modulus", "D(8) < K(9) < L(11) < GATE(13) < ESCAPE(17) < E(25) < b(49). Chain order.", "S1566");
  dom_append(dom_body(), sec_tl);

  /* === SEC 9y: CROSSMODAL VISION (S1567 Phase A) === */
  let sec_cv = make_section("800px") in
  render_h2(sec_cv, "Crossmodal Vision");
  render_p(sec_cv, "Text rendered as a 2D canvas bridges text and image modalities through CRT. A 122-character corpus fills a 14x9 grid (W=D*b=14, H=K^2=9). Each pixel has a position (col, row) AND a value (ASCII code). CRT decomposes both independently through the same 7 channels. Content CRT is modality-invariant: CRT(text[i]) = CRT(canvas[row,col]) at every position. Object permanence is algebraic: character 'e' has content CRT (5,2,1,3,2,10,16) at all 18 of its canvas positions -- same what, different where.");
  render_p(sec_cv, "Position CRT creates spatial scale hierarchy: at D-scale (mod 2) the canvas has 2 column classes, at K-scale 3, at E-scale 5, at b-scale 7. Sum = D+K+E+b = 17 = ESCAPE. A 7x7 tile = one b^2 spatial block with 49 unique b-addresses. Position and content CRT are decorrelated (65 matches vs 61 random expected). Same-row spatial transitions (113/121) inherit text bigram statistics exactly; 8 row-wraps are spatial discontinuities absent from text. Spatial per-channel bigram: ALIVE(167) > DEAD(131), extending the 490 split to vision.");
  let gcv = make_findings_grid(sec_cv) in
  render_finding(gcv, "Object permanence", "18/18 invariant", "Character 'e' has identical content CRT at all 18 canvas positions. Content invariant under translation.", "S1567");
  render_finding(gcv, "Scale hierarchy", "D+K+E+b=17=ESC", "Column classes at each scale: 2, 3, 5, 7. Sum = ESCAPE. 7x7 tile = b^2 block.", "S1567");
  render_finding(gcv, "Independence", "65 vs 61 random", "Position CRT decorrelated from content CRT. What and where processed in parallel.", "S1567");
  render_finding(gcv, "Spatial CRT prediction", "11/113 = 9.7%", "Per-channel spatial bigram -> CRT reconstruct -> 12x random. 132 params, 1624350x.", "S1567");
  dom_append(dom_body(), sec_cv);

  /* === SEC 9z: FULL PIPELINE (S1568 Phase A) === */
  let sec_pl = make_section("800px") in
  render_h2(sec_pl, "Full Pipeline");
  render_p(sec_pl, "S1538-S1567 proved 30 components independently. This test composes them into a single pipeline: text -> CRT encode -> per-channel bigram -> CRT reconstruct -> character prediction. Novel crossmodal test: the text-trained model is evaluated on VERTICAL canvas neighbors (text[i] -> text[i+14]) -- transitions that do NOT exist in the sequential training data. Crossmodal transfer: 142/756 accuracy (18.8%), 2.5x above random. 3 exact character matches on vertical neighbors via CRT reconstruction.");
  render_p(sec_pl, "OMEGA water cycle on text: killing the D-channel drops per-channel accuracy from 40 to 15 (62.5% reduction) and destroys ALL 11 CRT exact matches (11 -> 0). Every exact character reconstruction depended on D. The 490 split (ALIVE >= DEAD) extends to crossmodal: vertical ALIVE(84) > DEAD(58). Channel reversal confirmed: b(47) > D(40) on text, opposite of synthetic ring functions. Modality gap quantified: horizontal 372 per mille vs vertical 187 per mille -- a 2x cost for the spatial modality shift.");
  let gpl = make_findings_grid(sec_pl) in
  render_finding(gpl, "CRT text recon", "11/121 exact", "Per-ch bigram -> CRT reconstruct -> exact character match. 9.1% (11x random).", "S1568");
  render_finding(gpl, "Crossmodal transfer", "142/756 (18.8%)", "Text-trained model on vertical canvas neighbors. 2.5x above random. NOT in training data.", "S1568");
  render_finding(gpl, "OMEGA on text", "40 -> 15 D-ch", "D-channel killed. CRT recon: 11 -> 0. Every exact match depended on D.", "S1568");
  render_finding(gpl, "490 vertical", "ALIVE 84 > DEAD 58", "490 split extends to crossmodal. Strategy channels outpredict on vertical transitions.", "S1568");
  dom_append(dom_body(), sec_pl);

  /* === SEC 9aa: SPATIAL BIGRAM (S1569 Phase A) === */
  let sec_sb2 = make_section("800px") in
  render_h2(sec_sb2, "Spatial Bigram Training");
  render_p(sec_sb2, "Separate horizontal and vertical per-channel bigrams on the 14x9 canvas. Horizontal trained on same-row transitions (stride 1). Vertical trained on same-column transitions (stride 14). At positions with both a left and above neighbor (100 positions), both models predict the SAME target -- from different spatial directions. Axis specialization: vertical-trained model scores 251/756 on vertical vs horizontal-trained 145/756 (1.73x improvement). Table divergence: 71/132 entries differ (54%). The two axes have genuinely different transition statistics.");
  render_p(sec_sb2, "Two-axis agreement as confidence proxy: when both models agree on a channel prediction, accuracy is 58.9% vs 38.5% unconditional (53% improvement). Agreement follows CRT hierarchy: D 52%, K 42%, E 35%, b 26%. Coarser channels agree more (fewer residues). Full CRT two-axis reconstruction: 3/100 joint positions have all 7 channels agreeing, 2/3 correct (67%). 490 split ALIVE >= DEAD on BOTH axes independently. Channel reversal: b(38) >= D(35) on vertical, consistent with text pattern.");
  let gsb2 = make_findings_grid(sec_sb2) in
  render_finding(gsb2, "Axis specialization", "1.73x improvement", "Vertical-trained 251 vs horizontal-trained 145 on vertical task. Axis-specific training matters.", "S1569");
  render_finding(gsb2, "Table divergence", "71/132 (54%)", "More than half the prediction entries differ between axes. Different spatial transition statistics.", "S1569");
  render_finding(gsb2, "Agreement accuracy", "58.9% vs 38.5%", "Two-axis agreement is a confidence proxy. 53% improvement over unconditional.", "S1569");
  render_finding(gsb2, "Two-axis CRT recon", "2/3 correct (67%)", "When all 7 channels agree across axes, CRT reconstruction is 67% accurate.", "S1569");
  dom_append(dom_body(), sec_sb2);

  /* === SEC 9ab: SPATIAL COUPLING-ATTENTION (S1570 Phase A) === */
  let sec_sa = make_section("800px") in
  render_h2(sec_sa, "Spatial Coupling-Attention");
  render_p(sec_sa, "Coupling-attention (S1562-S1563) extended to 2D canvas transitions. For each target position, coupling(query, context) selects same-character positions from ALL horizontal or vertical transitions across the canvas. Separate heads for each axis: horizontal head predicts from left neighbor, vertical head predicts from above neighbor. Leave-one-out evaluation on the 14x9 canvas (D*b x K^2). Same-char attention weight: 58.5% horizontal, 57.0% vertical (13.5x above uniform expectation of 4.3%). Coupling gives character-specific spatial predictions.");
  render_p(sec_sa, "Coupling beats uniform attention on BOTH axes: horizontal 66 vs 63 (+5%), vertical 78 vs 60 (+30%). Vertical coupling advantage is 6x stronger than horizontal -- coupling-attention adds more value for less-familiar spatial transitions (stride 14 vs stride 1). 490 split ALIVE > DEAD on both axes: H(40 > 26), V(49 > 29). Two-head agreement at 100 joint positions: 56/700 per-channel agreements, 13/56 correct (23.2%, 2.3x above per-channel baseline ~10%). Zero CRT full-character reconstructions -- mean-based attention blurs per-channel predictions on non-periodic text.");
  let gsa = make_findings_grid(sec_sa) in
  render_finding(gsa, "Same-char weight", "58.5% H, 57.0% V", "Coupling concentrates 13.5x above chance on same-character positions. Generalizes from sequential (63%, S1563) to spatial.", "S1570");
  render_finding(gsa, "Vertical advantage", "30% over uniform", "Coupling adds 6x more value on vertical (78 vs 60) than horizontal (66 vs 63). Less-familiar transitions benefit more.", "S1570");
  render_finding(gsa, "490 split", "ALIVE > DEAD both axes", "H: 40 > 26. V: 49 > 29. Strategy channels outpredict on coupling-attended spatial transitions.", "S1570");
  render_finding(gsa, "Two-head agreement", "23.2% when agree", "56/700 per-channel agreements at joint positions. 13/56 correct = 2.3x above baseline.", "S1570");
  dom_append(dom_body(), sec_sa);

  /* === SEC 9ac: BIGRAM + COUPLING HYBRID (S1571 Phase A) === */
  let sec_bh = make_section("800px") in
  render_h2(sec_bh, "Bigram + Coupling Hybrid");
  render_p(sec_bh, "Combines S1569 bigram (mode-based, 298/791 H accuracy) with S1570 coupling-attention (mean-based, 66/791 H accuracy). Bigram provides the per-channel prediction. Coupling provides the confidence gate. Key finding: the hybrid is ASYMMETRIC across axes. Vertical: high coupling confidence predicts higher bigram accuracy (361 vs 303 ppt, 119% lift). Horizontal: high coupling confidence predicts LOWER bigram accuracy (310 vs 446 ppt, 69% ratio). 50 percentage point asymmetry.");
  render_p(sec_bh, "The asymmetry reflects axis-specific transition statistics. Vertical transitions (stride 14) are rarer -- when coupling identifies a familiar character, the vertical bigram table has a clear mode. Horizontal transitions (stride 1) are abundant -- common characters have diverse horizontal transitions, spreading the bigram table thin. Agreement accuracy is confidence-independent: 589 ppt whether coupling is high or low. The agreement filter (two-axis CRT) already captures what coupling would add. 490 split ALIVE >= DEAD on both axes in high-confidence group. 396 params (264 bigram + 132 eigenvalue), 541450x compression.");
  let gbh = make_findings_grid(sec_bh) in
  render_finding(gbh, "V positive lift", "119% (high > low)", "High-confidence vertical bigram: 361 vs 303 ppt. Rarer transitions benefit from character-specific gating.", "S1571");
  render_finding(gbh, "H negative lift", "69% (high < low)", "High-confidence horizontal bigram: 310 vs 446 ppt. Common characters spread bigram tables thin.", "S1571");
  render_finding(gbh, "Axis asymmetry", "50pp gap", "V lift 119% vs H lift 69%. Coupling modulates bigram differently by axis. Axis-selective gating.", "S1571");
  render_finding(gbh, "Agreement vs coupling", "Orthogonal", "Agreement accuracy 589 ppt regardless of coupling confidence. CRT agreement already captures the signal.", "S1571");
  dom_append(dom_body(), sec_bh);

  /* === SEC 9ad: SELECTIVE GATE (S1572 Phase A) === */
  let sec_sg = make_section("800px") in
  render_h2(sec_sg, "Axis-Selective Coupling Gate");
  render_p(sec_sg, "S1571 showed coupling modulates bigram accuracy asymmetrically: low-confidence is better on horizontal, high-confidence is better on vertical. The selective gate FLIPS the gating direction per axis: select low-coupling positions for H, high-coupling positions for V. Result: positive lift on BOTH axes simultaneously. H selective: 446 ppt (vs 376 unconditional, +18.6%). V selective: 361 ppt (vs 332, +8.7%). The gate resolves S1571 asymmetry into a coherent mechanism.");
  render_p(sec_sg, "At joint positions (both left and above neighbors), the double-gate creates a quality gradient. Double-open (h_low AND v_high): 474 ppt -- 23% above h-only baseline. Double-closed (h_high AND v_low): 267 ppt -- the anti-sweet-spot. Quality spread: 207 ppt. The coupling gate identifies the 25% of positions (25/100 joint) that achieve 78% higher accuracy. CRT reconstruction at double-open agreed positions: 2/2 = 100%. 490 split ALIVE >= DEAD on both selective axes. 396 params, 541450x compression.");
  let gsg = make_findings_grid(sec_sg) in
  render_finding(gsg, "H selective lift", "+18.6%", "Low-coupling H positions: 446 vs 376 ppt unconditional. Rare characters have distinctive transitions.", "S1572");
  render_finding(gsg, "V selective lift", "+8.7%", "High-coupling V positions: 361 vs 332 ppt unconditional. Familiar characters have consistent vertical patterns.", "S1572");
  render_finding(gsg, "Double-open", "474 ppt", "h_low AND v_high: 23% above h-only baseline (385 ppt). The 25% strongest positions.", "S1572");
  render_finding(gsg, "Quality spread", "207 ppt", "Double-open 474 vs double-closed 267. Coupling gate is a powerful quality discriminator.", "S1572");
  dom_append(dom_body(), sec_sg);

  /* === SEC 9ae: MULTI-RANGE SEQUENCE MODEL (S1573 Phase A) === */
  let sec_sm = make_section("800px") in
  render_h2(sec_sm, "Multi-Range Sequence Model");
  render_p(sec_sm, "Skip-bigrams at range k=1,2,3 (horizontal, per channel) reveal non-monotonic decay: k=1 (376 ppt) > k=2 (346) < k=3 (371). The dip-rebound pattern reflects multi-scale transition structure in text. k=2 crosses word boundaries irregularly; k=3 aligns with word-internal patterns. D (mod 8) decays slower than b (mod 49): retention 871 vs 787 ppt from k=1 to k=3, confirming modulus-dependent decay.");
  render_p(sec_sm, "The coupling-bigram reversal from S1571 is k=1-SPECIFIC. At k=2, coupling flips to positive: high-conf 358 ppt > low-conf 331 ppt. This matches S1571 vertical behavior (also sparse transitions). The reversal depends on TRANSITION DENSITY (adjacent=dense=reversal, skip/vertical=sparse=positive), not axis geometry. Multi-range agreement (k=1 and k=2 predict same residue): 565 vs 257 ppt (2.2x lift). 490 split ALIVE >= DEAD at all three ranges. 528 params, 406087x compression.");
  let gsm = make_findings_grid(sec_sm) in
  render_finding(gsm, "Non-monotonic decay", "376 > 346 < 371", "k=3 rebounds above k=2. Multi-scale transition structure in text.", "S1573");
  render_finding(gsm, "D retention > b", "871 vs 787 ppt", "Smaller modulus retains accuracy longer. Modulus-dependent decay confirmed.", "S1573");
  render_finding(gsm, "Coupling-range flip", "k=1 reversed, k=2 positive", "Reversal is k=1-specific. Transition density, not axis geometry, determines direction.", "S1573");
  render_finding(gsm, "Multi-range agreement", "565 vs 257 ppt", "k=1+k=2 agreement = 2.2x confidence lift. Analogous to multi-axis agreement (S1569).", "S1573");
  dom_append(dom_body(), sec_sm);

  /* === SEC 9af: COUPLING REVERSAL DEFAULT (S1574 Phase A) === */
  let sec_td = make_section("800px") in
  render_h2(sec_td, "Coupling Reversal Default");
  render_p(sec_td, "Testing the density hypothesis from S1573: does transition count alone determine coupling direction? 7 strides measured (k=1..5 horizontal, vertical, diagonal). Result: the simple density threshold is FALSIFIED. k=3 (95 transitions) is reversed despite having fewer transitions than k=2 (104, positive). The reversal is the DEFAULT. Only 2/7 strides show positive coupling: k=2 and vertical.");
  render_theorem(sec_td, "Coupling Reversal Default Theorem (S1574, FALSIFIES density threshold)", "The default coupling-bigram relationship is REVERSED: low-confidence positions have higher accuracy. Only 2/7 strides show positive coupling -- k=2 horizontal (stride 2, count=104) and vertical (stride 14, count=108). The density-threshold hypothesis is falsified: k=3 (95 transitions, reversed) has fewer transitions than k=2 (104, positive). The positive strides share a structural property not captured by transition density alone. Vertical is genuinely exceptional among directions. 490 split (ALIVE >= DEAD) holds on ALL 7/7 strides. 1056 params, 203043x compression.");
  let gtd = make_findings_grid(sec_td) in
  render_finding(gtd, "Density hypothesis", "FALSIFIED", "k=3 (95 cnt) reversed, k=2 (104 cnt) positive. Count alone does not predict direction.", "S1574");
  render_finding(gtd, "Reversal default", "5/7 reversed", "k=1,k=3,k=4,k=5,diagonal reversed. Only k=2 + vertical positive. Reversal is the rule.", "S1574");
  render_finding(gtd, "490 split", "7/7 strides", "ALIVE >= DEAD holds on ALL strides including diagonal. Universal structural consistency.", "S1574");
  render_finding(gtd, "Non-monotonic", "376>346<371", "k=3 rebounds above k=2. Replicates S1573 in generalized framework.", "S1574");
  dom_append(dom_body(), sec_td);

  /* === SEC 9ag: DIAGONAL BIGRAM (S1575 Phase A) === */
  let sec_db = make_section("800px") in
  render_h2(sec_db, "Diagonal Bigram");
  render_p(sec_db, "Building DEDICATED diagonal bigrams (stride 15 = down-right on 14x9 canvas) and composing all three spatial axes: horizontal + vertical + diagonal. S1574 measured per-stride accuracy but not cross-axis specialization. This test trains h, v, and d models simultaneously and cross-evaluates them. Three-axis agreement provides 20% stronger confidence than two-axis (S1569).");
  render_theorem(sec_db, "CRT Diagonal Axis Theorem (S1575)", "Per-channel bigrams trained on diagonal transitions specialize to their training axis with 2.57x lift over horizontal-trained and 2.14x over vertical-trained models (compared to 1.73x vertical specialization in S1569). Table divergence: 80/132 entries differ from both h and v (61%, symmetric). Three-axis agreement accuracy 705 ppt vs two-axis 589 ppt (20% lift). Three-axis CRT reconstruction: 3/100, 2/3 correct. Coupling reversed (lo=425 > hi=335 ppt), replicating S1574 exactly. 490 split ALIVE(149) > DEAD(116). 396 params, 541450x compression.");
  let gdb = make_findings_grid(sec_db) in
  render_finding(gdb, "Specialization", "2.57x (d vs h)", "d_on_d=265 vs h_on_d=103, v_on_d=124. Stronger than S1569 v-specialization (1.73x).", "S1575");
  render_finding(gdb, "Table divergence", "80/132 (61%)", "Diagonal differs from both h and v by same amount. Symmetric independence.", "S1575");
  render_finding(gdb, "Three-axis agreement", "705 vs 589 ppt", "20% lift over two-axis. Third view genuinely strengthens confidence.", "S1575");
  render_finding(gdb, "490 split", "149 > 116", "ALIVE > DEAD on diagonal. Structural consistency across all 3 axes.", "S1575");
  dom_append(dom_body(), sec_db);

  /* === SEC 9ah: FOUR-AXIS SPATIAL MODEL (S1576 Phase A) === */
  let sec_fa = make_section("800px") in
  render_h3(sec_fa, "9ah. Four-Axis Spatial Model (S1576)");
  render_p(sec_fa, "Adding a fourth spatial axis: down-left diagonal (stride 13 = w-1 on 14x9 canvas). Mirror of down-right. Key question: does the mirror diagonal provide independent information, or is it redundant with the existing three axes?");
  render_theorem(sec_fa, "CRT Four-Axis Spatial Theorem (S1576)", "Adding a fourth spatial axis (down-left diagonal) provides 12% accuracy lift through four-axis agreement (790 vs 705 ppt), smaller than the 20% lift from three-axis (705 vs 589 ppt). Diminishing returns indicate near-optimal axis coverage. Mirror diagonals are partially independent: table divergence 70/132 (53%), lower than diagonal-vs-cardinal divergences (80-85/132) but still a majority. Mirror specialization: dl 1.57x over dr on dl axis. Four-axis CRT reconstruction: 3/93, 2/3 correct (67%), stable across 2-4 axes. 528 params, 406087x compression.");
  let gfa = make_findings_grid(sec_fa) in
  render_finding(gfa, "DL specialization", "2.55x (dl vs h)", "dl_on_dl=273 vs h_on_dl=107. Mirror: dl vs dr = 1.57x. All three cross-axis ratios confirm independence.", "S1576");
  render_finding(gfa, "Mirror divergence", "70/132 (53%)", "dl-dr < dl-h (85) and dl-v (81). Mirror diags more similar to each other than to cardinals.", "S1576");
  render_finding(gfa, "Four-axis agreement", "790 vs 705 ppt", "12% lift (diminishing from 20% at 3-axis). 87/110 correct at 4-way agreement.", "S1576");
  render_finding(gfa, "490 split", "150 > 123", "ALIVE > DEAD on down-left. Consistent across all 4 spatial axes.", "S1576");
  dom_append(dom_body(), sec_fa);

  /* === SEC 9ai: PER-CHANNEL COUPLING DECOMPOSITION (S1577 Phase A) === */
  let sec_cd = make_section("800px") in
  render_h3(sec_cd, "9ai. Per-Channel Coupling Decomposition (S1577)");
  render_p(sec_cd, "S1574 proved coupling reversal is the default (5/7 strides). But coupling is a sum of 7 per-channel eigenvalue products. Which channels drive it? Decompose: single-channel coupling (use one channel alone), leave-one-out (remove one channel), and self-coupling statistics.");
  render_theorem(sec_cd, "CRT Coupling Decomposition Theorem (S1577)", "Per-channel coupling reversal is the universal default: 45/49 stride-channel cells reversed (92%). DEAD={D,E,b} 100% reversed (21/21); ALIVE={K,L,G,ESC} 86% (24/28). The positive strides (k=2, vertical) achieve positive direction through cross-channel constructive interference -- every individual channel shows reversal on these strides, but the combined 7-channel coupling becomes positive via softmax nonlinearity. Keystone channels: D for vertical (sole LOO flip), K+ESC for k=2 (both LOO flip). Adjacent stride (k=1) unanimously reversed (7/7) and perfectly LOO-stable (7/7). Text-weighted self-coupling: D=245 > L=243 > G=236 > ESC=209 > b=198 > E=192 > K=189 (x100, uniform=200). 1056 params, 203043x compression.");
  let gcd = make_findings_grid(sec_cd) in
  render_finding(gcd, "Reversal universality", "45/49 (92%)", "DEAD channels 100% reversed. Reversal is the per-channel default, not emergent from combination.", "S1577");
  render_finding(gcd, "k=1 unanimity", "7/7 reversed, 7/7 LOO stable", "Every channel individually reversed. No single removal flips direction. Perfectly robust.", "S1577");
  render_finding(gcd, "Emergent positivity", "0/7 single-ch positive on vertical", "Vertical is positive at full coupling but ALL channels individually reversed. Positivity = cross-channel constructive interference.", "S1577");
  render_finding(gcd, "Keystone channels", "D (vertical), K+ESC (k=2)", "Removing keystone flips from positive to reversed. Other removals preserve positivity. Channel-specific emergent roles.", "S1577");
  render_finding(gcd, "490 split", "DEAD 100% vs ALIVE 86%", "DEAD channels uniformly reversed. ALIVE allows 4 exceptions (K, L, GATE at specific strides).", "S1577");
  dom_append(dom_body(), sec_cd);

  /* === SEC 9aj: GATED SPATIAL ATTENTION (S1578 Phase A) === */
  let sec_ga = make_section("800px") in
  render_h3(sec_ga, "9aj. Gated Spatial Attention (S1578)");
  render_p(sec_ga, "Full integration of spatial experiments S1569-S1577: 4 axes (horizontal, vertical, diagonal-right, diagonal-left) with coupling-gated axis selection. The gate direction follows the Coupling Reversal Default (S1574): reversed axes (H, DR, DL) gate open on low coupling confidence; the positive axis (V) gates open on high confidence. Per-axis gate lift confirms S1577: full 7-channel coupling is required for discriminative gating (per-channel coupling would be uniformly reversed).");
  render_theorem(sec_ga, "CRT Gated Spatial Attention Theorem (S1578)", "Coupling-gated axis selection over 4 spatial axes produces per-axis accuracy lift (+13%, 435 vs 384 ppt) and expanded multi-axis agreement coverage (4 vs 3 positions, +33%) at comparable precision (500 vs 666 ppt, within sampling noise at n=3-4). Gate direction: 3/4 axes reversed (H, DR, DL), 1/4 positive (V). Gate distribution: 66% of interior positions have >=2 open axes. Mean open axes = 2 = D. Coverage-precision tradeoff: gating finds more agreement positions but the extra position is incorrect. 660 params, 324870x compression.");
  let gga = make_findings_grid(sec_ga) in
  render_finding(gga, "Gate lift", "+13% (435 vs 384 ppt)", "Coupling-gated positions have higher per-axis accuracy than unconditional average. Gating selects better axes.", "S1578");
  render_finding(gga, "Coverage expansion", "4 vs 3 positions (+33%)", "Gated agreement (>=2 open axes) finds one more agreement position than unconditional 4-axis. Relaxing from 4 to >=2 axes.", "S1578");
  render_finding(gga, "Gate distribution", "[0:8, 1:23, 2:33, 3:23, 4:6]", "Most common: 2 open axes (35%). Mean = 2 = D. 66% have >=2 open. Coupling threshold splits each axis ~50/50.", "S1578");
  render_finding(gga, "490 split", "ALIVE(10) > DEAD(7)", "Strategy channels outperform data channels at gated agreement positions. Consistent across all spatial experiments.", "S1578");
  dom_append(dom_body(), sec_ga);

  /* === SEC 9ak: SPATIAL ATTENTION AT SCALE (S1579 Phase A) === */
  let sec_sc = make_section("800px") in
  render_h3(sec_sc, "9ak. Spatial Attention at Scale (S1579)");
  render_p(sec_sc, "Scale test: 504-char corpus on 28x18 canvas (D^2*b x D*K^2). 4x corpus, 4.7x interior positions (442 vs 93). Tests whether S1578 findings hold at scale. Coupling direction is corpus-dependent: 2/4 reversed (H, V) vs 3/4 at S1578. Diagonals flip from reversed to positive. Gate lift weakens (+0.8% vs +13%). Unconditional 4-axis agreement vanishes (0/442). Gating becomes the sole mechanism for multi-axis fusion.");
  render_theorem(sec_sc, "CRT Spatial Scale Theorem (S1579)", "At 4x corpus size (504 chars, 28x18), coupling direction becomes corpus-dependent: 2/4 axes reversed (H, V) vs 3/4 at S1578 (H, DR, DL). Unconditional 4-axis agreement vanishes (0 positions). Gating provides 16 agreement positions with 3/16 correct (187 ppt). S1578 gate directions outperform adapted directions on agreement coverage (16 vs 3 positions, 3 vs 0 correct) despite being mismatched to actual coupling: mismatched gates increase exploration, multi-axis agreement filters quality. Gate distribution stable: mean open = 2 = D, >=2 open = 69%. 490 split ALIVE(19) > DEAD(13). 660 params, 324870x compression.");
  let gsc = make_findings_grid(sec_sc) in
  render_finding(gsc, "Coupling shift", "2/4 reversed (was 3/4)", "H+V reversed, DR+DL positive. Coupling direction is corpus-dependent, not a structural universal. S1574 reversal default is corpus-specific.", "S1579");
  render_finding(gsc, "Agreement vanishes", "0/442 unconditional", "No positions have all 4 axes agreeing on all 7 channels. Exact all-axis agreement is too strict at corpus scale.", "S1579");
  render_finding(gsc, "Gating essential", "16 positions (3 correct)", "Gating finds 16 agreement positions where brute-force finds 0. Gating shifts from optimization to enablement at scale.", "S1579");
  render_finding(gsc, "Gate paradox", "Wrong > right (16/3 vs 3/0)", "S1578 mismatched gates provide more coverage than adapted correct gates. Mismatched = more exploration, agreement filters quality.", "S1579");
  render_finding(gsc, "490 split", "ALIVE(19) > DEAD(13)", "Strategy channels outperform data channels. Consistent across corpus sizes.", "S1579");
  dom_append(dom_body(), sec_sc);

  /* === SEC 9al: LEARNED GATE DIRECTIONS (S1580 Phase A) === */
  let sec_lg = make_section("800px") in
  render_h3(sec_lg, "9al. Learned Gate Directions (S1580)");
  render_p(sec_lg, "Exhaustive sweep of all 16 gate combinations (4 axes x 2 directions = 2^4) on the 504-char corpus. Tests whether the S1579 gate paradox (mismatched > matched) is structural or coincidental. Answer: structural. The MATCH combo (matching all 4 axes to data-determined coupling direction) yields 3 agreements with 0 correct. The S1578 combo (matching 1/4) yields 16 agreements with 3 correct. The INVERSE combo (matching 0/4) yields 9 agreements with 3 correct at 333 ppt -- highest precision. All 3 max-correct combos share V=HIGH (wrong for reversed V).");
  render_theorem(sec_lg, "CRT Gate Sweep Theorem (S1580)", "Across all 16 gate combinations, V=HIGH (wrong direction for reversed vertical) is necessary and sufficient for maximum correct count. Three combos tie at 3 correct: S1578 c=2 (1/4 match, 16 agree, 187 ppt), INVERSE c=3 (0/4 match, 9 agree, 333 ppt), and c=14 (3/4 match, 15 agree, 200 ppt). All share V=HIGH. MATCH (4/4, V=LOW): 0 correct. No V=LOW combo exceeds 2. V=H total 13, V=L total 7 correct. 10/16 combos produce correct>0. Mean open = 2 = D across all 16 combos. The gate paradox is driven by V=HIGH: mismatched V explores positions where agreement is informative. 660 params, 324870x compression.");
  let glg = make_findings_grid(sec_lg) in
  render_finding(glg, "16-combo sweep", "10/16 working", "10 combos produce at least 1 correct prediction. Gate direction is not binary -- most directions find something.", "S1580");
  render_finding(glg, "V=HIGH necessary", "3/3 max combos, 0/8 V=L > 2", "Full match (4/4) fails because it uses V=LOW. c=14 (3/4 match) succeeds because it uses V=HIGH. Match count does not predict quality; V direction does.", "S1580");
  render_finding(glg, "V=HIGH key", "3/3 max combos share V=H", "All best combos use HIGH for vertical (which is reversed). V-as-reversed-HIGH is necessary for maximum correct count.", "S1580");
  render_finding(glg, "Mean open = 2 = D", "Universal across 16 combos", "Mean open axes is 1.9-2.0 regardless of gate directions. Binary threshold + 4 axes -> ~2 open. Openness is constant; WHICH positions get >=2 varies.", "S1580");
  render_finding(glg, "490 split", "ALIVE(19) > DEAD(13)", "At best combo (S1578). Strategy channels outperform. Consistent across gate strategies.", "S1580");
  dom_append(dom_body(), sec_lg);

  /* === SEC 9am: BOTTLENECK PERCEPTRON (S1581 Phase A) === */
  let sec_bp = make_section("800px") in
  render_h3(sec_bp, "9am. Bottleneck Perceptron (S1581)");
  render_p(sec_bp, "First multi-layer gradient descent on text data. A 2-layer per-channel perceptron with relu hidden layer (h=4) and cross-entropy loss, trained by SGD on per-channel text bigrams. The hidden layer introduces feature sharing across residues and an information bottleneck (h < q forces compression). For b-channel (q=49), the bottleneck compresses from 2401 to 392 parameters (6x). Compared against count-based bigram baseline on a 504-char corpus with 400/104 train/test split.");
  render_theorem(sec_bp, "CRT Bottleneck Generalization Theorem (S1581)", "A 2-layer per-channel perceptron (relu hidden h=4) with cross-entropy loss and SGD generalizes better than count-based bigrams: 234 vs 210 ppt test accuracy (+11.4%) with 3.55x fewer parameters (1056 vs 3750). Generalization gap halves from 76 to 33 ppt, demonstrating bottleneck regularization. The closure channel K(q=9) benefits most: +14 (28 vs 14, doubled). The K advantage is NOT driven by modulus size (small-q channels gain more than large-q, reversing the naive bottleneck hypothesis). CRT reconstruction compounds per-channel gains: 8/103 vs 5/103 exact characters (+60%). NN wins 4/7 channels. 490 split ALIVE(95) > DEAD(74). 1056 params, 203043x compression.");
  let gbp = make_findings_grid(sec_bp) in
  render_finding(gbp, "Test accuracy", "NN 234 vs Count 210 ppt", "First gradient-trained model to beat counting on CRT text. 11.4% improvement with 3.55x fewer parameters.", "S1581");
  render_finding(gbp, "K-channel boost", "+14 (28 vs 14, +100%)", "Closure channel (q=9) has biggest win. h=4 bottleneck forces shared features that generalize better than per-residue counting.", "S1581");
  render_finding(gbp, "Generalization gap", "33 vs 76 ppt (-57%)", "NN overfits less. Bottleneck acts as implicit regularizer: fewer parameters, more robust predictions on unseen transitions.", "S1581");
  render_finding(gbp, "CRT reconstruction", "8/103 vs 5/103 (+60%)", "Per-channel improvements compound under CRT. NN predictions are more coherent across channels.", "S1581");
  render_finding(gbp, "490 split", "ALIVE(95) > DEAD(74)", "Strategy channels outperform data channels. Consistent with all prior Phase A models.", "S1581");
  dom_append(dom_body(), sec_bp);

  /* === SEC 9an: 3-LAYER DEPTH TEST (S1582 Phase A) === */
  let sec_dt = make_section("800px") in
  render_h3(sec_dt, "9an. Shallow Channel Theorem (S1582)");
  render_p(sec_dt, "Does depth help per-channel CRT prediction? A 3-layer perceptron (q->4->4->q, two relu hidden layers) compared against the 2-layer bottleneck (S1581) and count-based bigrams on the same 504-char corpus. The 3-layer adds a 4x4 middle transform (16 params/channel, 1168 total vs 1056). Result: depth HURTS. 2-layer wins 5/7 channels. 3-layer regresses to count-level accuracy (210 ppt = count). The 4x4 middle layer compounds information loss through two successive narrow bottlenecks.");
  render_theorem(sec_dt, "CRT Shallow Channel Theorem (S1582)", "Per-channel CRT bigram prediction is inherently shallow. A 2-layer bottleneck (q->4->q) outperforms 3-layer (q->4->4->q) by 10.3% (234->210 ppt test) across 5/7 channels. The 4x4 middle layer adds capacity but not useful structure for flat conditional distributions. Depth preferentially degrades DEAD channels (-13.5%) over ALIVE (-7.4%): perception channels (D,E,b) need direct shallow mapping. GATE (boundary, q=13) is the sole depth-tolerant channel (+1). K retains partial advantage over count (24 vs 14 = +71%) even in 3-layer -- algebraic structure survives depth damage. 3L total = Count total (210 ppt) but different per-channel profiles. Gen gap widens: 50 vs 33 ppt. CRT recon: 5 vs 8 vs 5. 1168 params, 183573x compression.");
  let gdt = make_findings_grid(sec_dt) in
  render_finding(gdt, "Depth hurts", "3L=210 vs 2L=234 ppt (-10.3%)", "Adding a hidden layer with h=4 compounds the bottleneck. Two successive 4-wide layers create a double information barrier that gradient descent cannot overcome.", "S1582");
  render_finding(gdt, "2L wins 5/7", "Only GATE tolerates depth", "GATE (q=13, boundary) is the sole 3L winner (+1). The boundary channel benefits from compositional depth. All other channels regress.", "S1582");
  render_finding(gdt, "490 depth asymmetry", "DEAD -13.5% vs ALIVE -7.4%", "Perception channels (D,E,b) lose more from depth than strategy channels (K,L,G,ESC). DEAD needs direct mapping; ALIVE tolerates transforms.", "S1582");
  render_finding(gdt, "K survives", "+71% over count in 3L", "K-channel (closure, q=9) retains its structural advantage (24 vs 14) even when overall model regresses. The algebraic structure is robust to architectural damage.", "S1582");
  render_finding(gdt, "3L = Count total", "Both 210 ppt, different profiles", "3L and count achieve identical totals but with reversed channel profiles. Bottleneck still structures the solution even when depth hurts.", "S1582");
  dom_append(dom_body(), sec_dt);

  /* === SEC 9ao: GRADIENT CROSSING (S1583 Phase A) === */
  let sec_gc = make_section("800px") in
  render_h3(sec_gc, "9ao. Gradient Crossing (S1583)");
  render_p(sec_gc, "The Shallow Channel Theorem (S1582) showed per-channel prediction is shallow-optimal. Where does depth belong? At the CROSSING -- cross-channel operations that combine information from multiple CRT channels. This test trains joint pair perceptrons on (D,K) and (D,L) residue pairs, comparing against independent per-channel prediction. The joint model maps from a pair input (r_D, r_K) to the next pair, learning cross-channel transition structure that independent models cannot see.");
  render_theorem(sec_gc, "CRT Gradient Crossing Theorem (S1583)", "Joint gradient-trained pair prediction outperforms independent per-channel prediction by +71% (DK, 24 vs 14/103) and +100% (DL, 22 vs 11/103) on text data, despite per-channel component accuracies being EQUAL (D: 26=26, K: 27~28). The mechanism is COHERENT prediction: the joint model predicts channel pairs that succeed TOGETHER, not individually better. CRT reconstruction improves +37.5% (8->11/103) via pair coherence. DL (+100%) exceeds DK (+71%): L-crossing is more valuable than K-crossing (both are 490 crossings since K is ALIVE -- corrected S1584). Joint NN (24) > Count pair (21) > Independent (14): gradient bottleneck regularization helps at crossing too. Coverage: only 24/72 DK pairs (33%) seen in training, yet gradient generalization succeeds. 1496 params (DK-enhanced), 143325x compression.");
  let ggc = make_findings_grid(sec_gc) in
  render_finding(ggc, "DK joint wins", "+71% (24 vs 14/103)", "Joint pair prediction on (D,K) residues beats independent D+K by 10 positions. Gradient bottleneck (h=4) over 72-class input space outperforms two independent 8-class and 9-class models.", "S1583");
  render_finding(ggc, "DL crossing", "+100% (22 vs 11/103)", "DL pair crossing doubles accuracy. L-crossing exceeds K-crossing (+100% vs +71%). Both are 490 crossings (K is ALIVE -- corrected S1584). D+L pairing captures richer transition structure.", "S1583");
  render_finding(ggc, "Coherence not accuracy", "D: 26=26, K: 27~28", "Joint model does not predict D or K BETTER individually. The mechanism is coherent co-prediction: D and K succeed at the SAME positions. Independent models often succeed at DIFFERENT positions, losing pair accuracy.", "S1583");
  render_finding(ggc, "CRT recon +37.5%", "8->11/103 DK-enhanced", "Replacing independent D+K with joint DK predictions in CRT reconstruction improves exact character matches. Pair coherence compounds into full-ring reconstruction quality.", "S1583");
  render_finding(ggc, "Joint > Count > Indep", "24 > 21 > 14", "Joint NN beats count-based pair bigram (72x72 table) by +14%. The h=4 bottleneck regularizes cross-channel learning, generalizing from 24/72 (33%) observed pairs to unseen transitions.", "S1583");
  dom_append(dom_body(), sec_gc);

  /* === SEC 9ap: MULTI-CROSSING (S1584 Phase A) === */
  let sec_mc = make_section("800px") in
  render_h3(sec_mc, "9ap. Multi-Crossing (S1584)");
  render_p(sec_mc, "S1583 tested two pairs (DK, DL) and found DL > DK. But the 490-split classification was wrong: K is ALIVE (ALIVE = {K, L, GATE}), so DK is also a 490 crossing pair, not DEAD x DEAD. This experiment tests 6 pairs across all three crossing types -- 490 crossing (DEAD x ALIVE): DK(72), DL(88), DG(104); same-side ALIVE: KL(99), KG(117); same-side DEAD: DE(200) -- to determine whether crossing the 490 boundary gives structural advantage.");
  render_theorem(sec_mc, "CRT Multi-Crossing Theorem (S1584)", "Joint pair prediction universally outperforms independent per-channel prediction (41-100% lift, all 6 pairs). All joint models converge to a CEILING (~233 ppt) regardless of crossing type or product size (72-200). The 490 split manifests NOT at pair accuracy (crossing 226 = same-alive 223 ppt) but at CRT RECONSTRUCTION: crossing pairs enhance CRT by 10.3 avg vs same-side 9.3 avg, because crossing pairs span both sides of the DEAD/ALIVE decomposition. S1583 correction: K is ALIVE; DK is a 490 crossing pair. 6496 params, 33007x compression.");
  let gmc = make_findings_grid(sec_mc) in
  render_finding(gmc, "Universal ceiling", "22-24/103 all 6 pairs", "Joint models converge to ~233 ppt regardless of pair type. DK=24, DL=22, DG=24, KL=22, KG=24, DE=24. The lift (41-100%) reflects different independent baselines, not different joint quality.", "S1584");
  render_finding(gmc, "490 at CRT not pair", "31/3 vs 28/3", "Crossing pairs enhance CRT reconstruction (10.3 avg) more than same-side (9.3 avg). Crossing spans both DEAD+ALIVE sides of the decomposition, providing more informative channel combinations for reconstruction.", "S1584");
  render_finding(gmc, "KL beats DG", "diff=11 vs diff=7", "At matched product size (KL:99 vs DG:104), same-side ALIVE pair beats 490 crossing pair. The advantage is from general cross-channel correlation, not 490-specific structure.", "S1584");
  render_finding(gmc, "DE works at q=200", "24/103, lift=60%", "Same-dead D x E with 200 classes from 399 samples still generalizes. Coverage: 25/200 (12.5%). Bottleneck h=4 regularizes even extreme class-to-sample ratios.", "S1584");
  dom_append(dom_body(), sec_mc);

  /* === SEC 9aq: WIDTH CROSSING (S1585 Phase A) === */
  let sec_wc = make_section("800px") in
  render_h3(sec_wc, "9aq. Width Crossing (S1585)");
  render_p(sec_wc, "S1584 found all 6 joint pair models converge to a ~233 ppt ceiling regardless of pair type. Is this ceiling h=4 limited -- would more hidden units differentiate the pairs and reveal the 490 split? This experiment varies hidden size h={2,4,8,16} on two representative pairs: DK (72 classes, 490 crossing) and KL (99 classes, same-side ALIVE).");
  render_theorem(sec_wc, "CRT Width Ceiling Theorem (S1585)", "The ~233 ppt joint pair ceiling is DATA-limited, not capacity-limited. Increasing hidden width h from 2 to 16 does NOT lift the ceiling: h>=8 OVERFITS (gen gap doubles from 45 to 96 ppt, test accuracy drops ~15%). h=2 achieves the same ceiling as h=4 (DK: 24=24, KL: 23~22/103). The 490 split remains ABSENT at all widths (DK~KL within 1-2). CRT reconstruction is FLAT across widths (DK enhanced=11 at all h). The minimum-capacity model (h=2) captures the full learnable signal from 399 training transitions. Crossing type is truly type-independent of model capacity. 6528 params at h=16, 32845x compression.");
  let gwc = make_findings_grid(sec_wc) in
  render_finding(gwc, "Ceiling persists", "h2=24 h4=24 h8=20 h16=20", "DK accuracy does not improve with more hidden units. h=2 matches h=4 exactly (233 ppt). h=8 and h=16 drop to 194 ppt. The mapping from 72 joint residues to next residue is simple enough that 2 hidden units suffice.", "S1585");
  render_finding(gwc, "Overfitting at h>=8", "Gen gap 45->96 ppt", "DK at h=4: train 111, test 24, gap 45 ppt. At h=16: train 116, test 20, gap 96 ppt. More parameters memorize training transitions without generalizing to test transitions. The bottleneck IS the regularization.", "S1585");
  render_finding(gwc, "490 split absent", "DK~KL at all widths", "DK and KL differ by at most 2 at every width. Crossing (DK) and same-side ALIVE (KL) are indistinguishable. The ceiling is data-driven, not topology-driven.", "S1585");
  render_finding(gwc, "CRT flat", "Enhanced=11 at all h", "CRT reconstruction with DK joint override = 11/103 at h=2, h=4, h=8, and h=16. Width does not affect CRT quality. The reconstruction signal comes from pair coherence, not model capacity.", "S1585");
  dom_append(dom_body(), sec_wc);

  /* === SEC 9ar: SHADOW POLYNOMIAL (S1586 Phase A) === */
  let sec_sp = make_section("800px") in
  render_h3(sec_sp, "9ar. Shadow Polynomial (S1586)");
  render_p(sec_sp, "The Shadow Polynomial P(x) = (x-1)(x-2)(x-3)(x-5) has roots at the inner chain primes {sigma, D, K, E}. P(b=7) = 240 = |roots(E8)|. P(ESCAPE=17) = 40320 = 8!. A structure seeking an AI role: does P partition CRT residues into functionally distinct sets for text prediction?");
  render_theorem(sec_sp, "CRT Shadow Channel Theorem (S1586)", "Chain-root residues ({1,2,3,5} = zeros of P) predict text transitions 21% better than non-chain-root residues (238 vs 197 ppt). Shadow-zero residues (P(r) = 0 mod q, a superset) predict 24% better (241 vs 195 ppt). D and K channels are shadow-enriched: D picks up b=7 (P(7)=240, 240 mod 8=0), K picks up D^3=8 (P(8)=630, 630 mod 9=0). Shadow-zero coverage: D 62%, K 55%, other channels 17% average. Chain-root accuracy is 490-neutral (DEAD=ALIVE=27), while non-chain is ALIVE-dominated (52>46). L and ESCAPE show 3.0x and 2.9x chain-root advantage; K is the sole channel where chain roots predict worse (125 vs 148 ppt). P(x) is a DATA-LEVEL FILTER: its zeros mark residues where text is most predictable.");
  let gsp = make_findings_grid(sec_sp) in
  render_finding(gsp, "Chain-root advantage", "238 vs 197 ppt (+21%)", "Residues {1,2,3,5} have higher bigram prediction accuracy than other residues. Common English characters (e, space, a, i, s, r) land on chain roots in multiple channels. The inner chain marks the high-traffic residue positions.", "S1586");
  render_finding(gsp, "Shadow enrichment", "D:62% K:55% vs 17%", "D-channel gains b=7 as extra shadow zero (P(7)=240=D^4*K*E, divisible by 8). K-channel gains D^3=8 (P(8)=630=K^2*70, divisible by 9). Prime channels only have the 4 chain roots. The two smallest channels see deeper algebraic structure.", "S1586");
  render_finding(gsp, "490 neutrality", "CR: DEAD=ALIVE=27", "Chain-root accuracy is 490-neutral (27=27). Non-chain accuracy is ALIVE-dominated (52>46). The shadow polynomial neutralizes the 490 split within its zero set. Chain roots are equally predictable by perception and strategy channels.", "S1586");
  render_finding(gsp, "K-channel exception", "CR 125 vs NCR 148", "K (closure, q=9) is the only channel where chain-root residues predict worse. K is also the most enriched non-D channel and showed +100% bottleneck advantage (S1581). K uses its extra shadow zero (D^3=8) differently from the algebraic chain roots.", "S1586");
  dom_append(dom_body(), sec_sp);

  /* === SEC 9as: SHADOW CONFIDENCE (S1587 Phase A) === */
  let sec_sc = make_section("800px") in
  render_h3(sec_sc, "9as. Shadow Confidence (S1587)");
  render_p(sec_sc, "S1586 proved the shadow polynomial P(x)=(x-1)(x-2)(x-3)(x-5) is a data-level filter: its zeros mark residues where per-channel text prediction is most accurate. Can this be OPERATIONALIZED? Use shadow status to ROUTE predictions: shadow-zero -> trust per-channel (easy residues), non-shadow-zero -> defer to DK crossing (hard residues). Tests whether P has prescriptive value, not just descriptive.");
  render_theorem(sec_sc, "CRT Shadow Confidence Theorem (S1587)", "Shadow polynomial gating is DIRECTIONALLY CORRECT but SUBOPTIMAL. Shadow gate (SZ->per-ch, non-SZ->joint) achieves 21/103, beating reverse gate (11/103, +91%) and per-channel only (8/103, +162%). But DK joint crossing DOMINATES unconditionally (24/103) -- even in shadow-zero zones (joint 4/26 vs per-ch 1/26). SHADOW-PAIR ANTICORRELATION: shadow-zero positions are easier per-channel (S1586: 241 vs 195 ppt) but HARDER for pair prediction (154 vs 259 ppt). Common residues have many transition partners, increasing pair uncertainty. Per-channel and pair difficulty are anti-correlated through P. The shadow polynomial is descriptive of per-channel difficulty but NOT prescriptive for prediction routing. Crossing always wins. 4326 params, 49564x compression.");
  let gsc = make_findings_grid(sec_sc) in
  render_finding(gsc, "Gate direction correct", "21 vs 11 (+91%)", "Shadow gate outperforms reverse gate, confirming P captures a real difficulty signal. The shadow polynomial correctly identifies where per-channel predictions are stronger. But stronger per-channel is still weaker than joint.", "S1587");
  render_finding(gsc, "Joint dominates", "24 > 21 > 11 > 8", "DK joint crossing beats all gating strategies. Even in shadow-zero zones where per-channel is at its best, joint 4/26 vs per-ch 1/26. Cross-channel coherence (S1583) matters more than single-channel easiness.", "S1587");
  render_finding(gsc, "Shadow-pair anticorrelation", "SZ 154 vs NSZ 259 ppt", "Per-channel easy = pair hard. Common residues (shadow zeros) have MORE transition partners, making pair prediction MORE uncertain. Per-channel and pair difficulty run in opposite directions through the shadow polynomial.", "S1587");
  render_finding(gsc, "CRT reconstruction", "joint=gate=6 > perCh=5", "Shadow gating matches joint CRT (6/103) because it uses joint for 77/103 non-SZ positions. The 26 SZ positions where gating differs contribute too little to change CRT quality.", "S1587");
  dom_append(dom_body(), sec_sc);

  /* === SEC 9at: CORPUS CROSSING (S1588 Phase A) === */
  let sec_cc = make_section("800px") in
  render_h3(sec_cc, "9at. Corpus Crossing (S1588)");
  render_p(sec_cc, "S1585 proved the ~233 ppt crossing ceiling is DATA-LIMITED, not capacity-limited (h=2 matches h=4). Does doubling training data lift it? 1008-char corpus: 399 vs 807 transitions, same test set (199 transitions). DK (490 crossing) and KL (same-alive) at h=4.");
  render_theorem(sec_cc, "CRT Corpus Crossing Theorem (S1588)", "Doubling training data lifts the joint pair ceiling ASYMMETRICALLY. Same-alive KL responds strongly (+66 ppt, 195->261, +34%) while 490-crossing DK responds weakly (+10 ppt, 221->231, +5%). The 490 split manifests NOT as accuracy (S1584 universal ceiling) but as DATA EFFICIENCY: same-side channels learn more from the same additional data. CRT reconstruction DEGRADES with more data (DK enhanced 21->10, KL 17->7) -- better individual channels don't compose better (encoding tradeoff, S1565). Generalization gap COLLAPSES for KL at full data (-5 ppt = test > train). 490 split REVERSES with data size (DK>KL at small, KL>DK at full). 2424 params, 88454x compression.");
  let gcc = make_findings_grid(sec_cc) in
  render_finding(gcc, "KL data-responsive", "195->261 ppt (+34%)", "Same-alive pair KL (q=99) gains 13 correct predictions from 2x data. K and L are both boundary (ALIVE) channels. Same-side pairs have higher data efficiency -- their shared algebraic role creates more regular bigram structure that generalizes.", "S1588");
  render_finding(gcc, "DK near-saturated", "221->231 ppt (+5%)", "490-crossing pair DK (q=72) gains only 2 correct predictions from 2x data. The crossing signal between perception (D) and strategy (K) channels saturates faster. DEAD-ALIVE pairs require qualitatively different data, not just more of the same.", "S1588");
  render_finding(gcc, "CRT reconstruction degrades", "21->10 enhanced", "More data improves per-channel and pair accuracy but HURTS full CRT reconstruction. Better individual predictions don't compose into better full-ring reconstruction -- the encoding tradeoff (S1565) applies to data scaling too.", "S1588");
  render_finding(gcc, "490 split = data efficiency", "sm:DK>KL fl:KL>DK", "The 490 split reverses with data size: DK leads at small data, KL leads at full. The split is not an accuracy difference but a data efficiency difference. Same-side channels reach their ceiling faster with less data.", "S1588");
  dom_append(dom_body(), sec_cc);

  /* === SEC 9au: RECONSTRUCTION COHERENCE (S1589 Phase A) === */
  let sec_rc = make_section("800px") in
  render_h3(sec_rc, "9au. Reconstruction Coherence (S1589)");
  render_p(sec_rc, "S1588 detected Probe 3: CRT reconstruction DEGRADES when per-channel predictions IMPROVE with more data (base 10->5, DK enhanced 21->10, KL 17->7). Why? This session investigates the mechanism. 1008-char corpus, 7 per-channel NN models at small (399 transitions) vs full (807 transitions) data.");
  render_theorem(sec_rc, "CRT Reconstruction Coherence Theorem (S1589)", "Per-channel prediction DECORRELATION is the mechanism behind the CRT reconstruction paradox. With more data, each channel's mode prediction shifts to a locally-better mode, but different channels shift at different transitions. The 7-way conjunction P(all correct) drops because channels that were correlated (ratio 792x expected) become less correlated (ratio 230x expected) -- a 71% correlation drop. The k-correct distribution shifts mass from k=7 (10->5) to k=6 (12->19) and k=3 (16->23): each channel improves individually but they no longer all agree on the SAME transitions. CRT reconstruction requires ALL 7 channels correct simultaneously, making it exponentially sensitive to decorrelation. Pairwise coherence IMPROVES (DK 20->30, KL 22->30), proving the issue is 7-way conjunction, not 2-way. Better components compose WORSE because independent improvements are combinatorially harder to align than correlated ones.");
  let grc = make_findings_grid(sec_rc) in
  render_finding(grc, "71% decorrelation", "ratio 792x->230x", "The actual/expected CRT ratio (measuring positive correlation between channels) drops 71% with more data. Channels that were correct together at small data become correct independently at full data. Per-channel improves (+8%), CRT degrades (-50%).", "S1589");
  render_finding(grc, "k-correct mass shift", "k=7: 10->5, k=6: 12->19", "The distribution of how many channels are correct per transition shifts from the extremes (all-or-nothing) toward almost-all. k=3 rises (16->23). Mean correct channels improves (1.7->1.9) but the critical k=7 bin shrinks.", "S1589");
  render_finding(grc, "Pairwise coherence UP", "DK 20->30, KL 22->30", "Pairwise coherence INCREASES with more data, proving the issue is specific to 7-way conjunction, not 2-way. Cross-channel pairs (DK,KE,EL) gain 30% while DEAD pairs (DE,Db) drop 10%. The 490 boundary benefits from data at pair level but hurts at full-ring level.", "S1589");
  render_finding(grc, "Mode validity drops", "21->11 valid ASCII", "Only 11/199 CRT reconstructions at full data produce valid ASCII characters (vs 21 at small). 94% of reconstructions point to non-characters, confirming that independently-shifted predictions combine to algebraic noise.", "S1589");
  dom_append(dom_body(), sec_rc);

  /* === SEC 9av: FRACTAL STACKING (S1590 Phase A) === */
  let sec_fs = make_section("800px") in
  render_h3(sec_fs, "9av. Fractal Stacking (S1590)");
  render_p(sec_fs, "The axiom is fractal. Every solution is a module. Instead of solving N-way jointly (exponential parameters), stack pairwise crossings (linear parameters). Walk from center outward: per-channel -> pairwise -> full coherence. S1589 showed 7-way conjunction is the tax while pairwise coherence improves. The fix is not flat N-way joint prediction -- it is stacked pairwise crossings, each adding one channel of coherence.");
  render_theorem(sec_fs, "CRT Fractal Stacking Theorem (S1590)", "Stacking multiple pairwise crossings simultaneously improves CRT reconstruction beyond any single crossing. Per-channel baseline: 5/103. Single DK crossing: 6/103. Stacked DK+DL+DG (3 D-centered crossings): 12/103 -- a 2.4x improvement over baseline and 2x over the best single crossing. D-agreement across 3 crossings: 98% (101/103). Each crossing adds a NEW channel of joint prediction: DK covers D+K, DL adds L, DG adds GATE. Four of seven channels become jointly predicted. The remaining channels (b, ESCAPE) lack crossings at this corpus size and cap the improvement. 812 stacked parameters vs 1800 for flat DKE joint -- fractal stacking uses fewer parameters for broader coverage.");
  let gfs = make_findings_grid(sec_fs) in
  render_finding(gfs, "Stacking 2.4x", "5->12/103 CRT recon", "Three D-centered crossings stacked simultaneously achieve 12/103 CRT reconstruction, 2.4x the per-channel baseline of 5/103. Each additional crossing that covers a NEW channel improves CRT recon. Adding crossings for already-covered channels has zero marginal effect.", "S1590");
  render_finding(gfs, "D-agreement 98%", "101/103 agree", "Three crossings (DK, DL, DG) agree on the D-channel prediction 98% of the time. D participates in the most crossings and becomes the most reliable channel. This is the fractal center -- the channel with the most connections is the most robust.", "S1590");
  render_finding(gfs, "Voting = single-pick", "L6v=L6=12/103", "Multi-crossing voting produces the same CRT recon as single-pick (best coverage per channel). At 98% D-agreement, voting adds no information -- the crossings are already coherent. The fractal benefit is in BREADTH (covering more channels) not consensus (refining covered channels).", "S1590");
  render_finding(gfs, "b+ESCAPE bottleneck", "2 uncovered channels", "b (49 residues) and ESCAPE (17 residues) have no affordable pairwise crossings at this corpus size (Db=392, bESC=833). These uncovered channels cap CRT reconstruction. Next fractal layer: use stacked predictions as context for b/ESCAPE.", "S1590");
  dom_append(dom_body(), sec_fs);

  /* === SEC 9aw: CONTEXTUAL STACKING (S1591 Phase A) === */
  page_ai_sec_9aw();
  /* === SEC 9ax: DATA SCALING (S1592 Phase A) === */
  page_ai_sec_9ax();
  /* === SEC 9ay: DIVERSE CORPUS (S1593 Phase A) === */
  page_ai_sec_9ay();
  /* === SEC 9az: STRUCTURED DIVERSE (S1594 Phase A) === */
  page_ai_sec_9az();
  /* === SEC 9ba: CRT NEAREST-NEIGHBOR (S1595 Phase A) === */
  page_ai_sec_9ba();
  /* === SEC 9bb: NN TEXT GENERALIZATION (S1596 Phase A) === */
  page_ai_sec_9bb();
  /* === SEC 9bc: RESTRICTED NN (S1597 Phase A) === */
  page_ai_sec_9bc();
  /* === SEC 9bd: TRIGRAM CONTEXT (S1598 Phase A) === */
  page_ai_sec_9bd();
  /* === SEC 9be: TRIGRAM JOINT (S1599 Phase A) === */
  page_ai_sec_9be();
  /* === SEC 9bf: NN PIPELINE (S1600 Phase A) === */
  page_ai_sec_9bf();
  /* === SEC 9bg: CONTEXT CROSSING (S1601 Phase A) === */
  page_ai_sec_9bg();
  /* === SEC 9bh: CONTEXT SCALING (S1602 Phase A) === */
  page_ai_sec_9bh();
  /* === SEC 9bi: CONTEXT-CORRELATION SUBSTITUTION (S1603 Phase A) === */
  page_ai_sec_9bi();
  /* === SEC 9bj: DATA SCALING (S1604 Phase A) === */
  page_ai_sec_9bj();
  /* === SEC 9bk: BLOOM TEXT (S1605 Phase A) === */
  page_ai_sec_9bk();
  /* === SEC 9bl: STRICT BLOOM (S1606 Phase A) === */
  page_ai_sec_9bl();
  /* === SEC 9bm: BLOOM-AGREEMENT SELECTION (S1607 Phase A) === */
  page_ai_sec_9bm();
  /* === SEC 9bn: DISTRIBUTION DECODING (S1608 Phase A) === */
  page_ai_sec_9bn();
  /* === SEC 9bo: CONFIDENCE-SELECTION COMPOSITION (S1609 Phase A) === */
  page_ai_sec_9bo();
  /* === SEC 9bp: DATA SELECTION (S1610 Phase A) === */
  page_ai_sec_9bp();
