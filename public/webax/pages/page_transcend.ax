/* ================================================================
   PAGE: TRANSCEND -- L=11, The Protector, ECC (TRANSCEND.md)
   ================================================================ */
/* transcend widget: L-channel ECC check */
fn ecc_check() = (
  let n = parse_int_from("#ecc-input") in
  let result = dom_query("#ecc-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    let r2 = n % 8 in
    let r3 = n % 9 in
    let r5 = n % 25 in
    let r7 = n % 49 in
    let r11 = n % 11 in
    let r13 = n % 13 in
    let crt_line = "<p style='color:#d8d8e0;margin:4px 0'>CRT(" + "${n}" + ") = (" + "${r2}" + ", " + "${r3}" + ", " + "${r5}" + ", " + "${r7}" + ", <span style='color:#ffd700'>" + "${r11}" + "</span>, " + "${r13}" + ")</p>" in
    let chan_line = "<p style='color:#b0b0c0;margin:4px 0'>Channels: mod 8, mod 9, mod 25, mod 49, <span style='color:#ffd700'>mod 11</span>, mod 13</p>" in
    /* Check if corrupting one channel would be detected by L */
    let det = if n < 12612600 then (
      "<p style='color:#88ddaa;margin:4px 0'>mod-11 value: " + "${r11}" + ". For bytes [0, 255]: 100% unique recovery (CRT spacing >> byte range).</p>"
    ) else "" in
    let prot = "<p style='color:#aaccff;margin:4px 0'>11 = 1+2+3+5. The mod-11 channel detects corruption in any other channel.</p>" in
    dom_inner(result, crt_line + chan_line + det + prot)
  )
)

/* transcend helpers */
fn transcend_hero() = (
  let hero = make_hero("Transcendence") in
  let eq = dom_create("div") in
  dom_text(eq, "1 + 2 + 3 + 5 = 11");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The chain generates primes by the rule 2n+1: starting from 1, we get 3, then 7. It stops at 3^2 = 9 = 7 + 2 (composite). But the sum 1 + 2 + 3 + 5 = 11 is prime -- built FROM the chain, not BY it. This page shows what 11 does: error correction for free, and how 17 closes the ring.");
  dom_append(dom_body(), hero)
)

/* transcend_selfless CUT S1980: mythology (spider's legs, kingdoms, SEES). L=1+2+3+5 identity moved to hero. */

fn transcend_ecc() = (
  let sec = make_section("800px") in
  render_h2(sec, "Error Correction");
  render_theorem(sec, "Protection Theorem", "The mod-11 channel detects single-channel corruption whenever the corrupted modulus is less than 11. In Z/210, all four channels {2, 3, 5, 7} qualify -- detection is 100%. In Z/12,612,600, channels mod 8 and mod 9 are covered (< 11), but mod 25 and mod 49 need a dual check with mod 13. Since lcm(11, 13) = 143 > 48 (the maximum error in any channel), the dual check catches everything.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Channels");
  render_th(hdr, "Detection");
  render_th(hdr, "What mod 11 adds");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "4: {2, 3, 5, 7}", "0%", "No redundancy. Corruption silent.");
  render_table_row_4(tbl, "Z/2,310", "5: + mod 11", "100%", "Any single-channel error caught.");
  render_table_row_4(tbl, "Z/970,200", "5: {8, 9, 25, 49, 11}", "~92%", "Mod 11 alone: 11/12 for mod 25 and mod 49.");
  render_table_row_4(tbl, "Z/12,612,600", "6: + mod 13", "100%", "Dual mod 11 + mod 13. Max error 48 < lcm = 143.");
  render_p(sec, "Dual check: mod 11 + mod 13. An error is invisible only if divisible by lcm(11, 13) = 143. The largest possible single-channel error is 48 (in mod 49), which is less than 143. Detection and known-location correction: both 100%.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Cost", "1/11 = 9.1%", "Adding mod 11 reduces unit density by 9.1%. A bargain for full detection.", "");
  render_finding(g, "Mixing trade-off", "64x slower", "Z/210: 256 mixing steps. Z/2,310: 16,384. Speed for reliability.", "");
  render_finding(g, "Byte recovery", "100% unique", "For bytes [0, 255]: single-channel corruption has unique CRT recovery.", "");
  render_finding(g, "Two-channel errors", "7 of 10 pairs", "7 of 10 channel pairs have surviving product > 256, giving unique recovery.", "");
  dom_append(dom_body(), sec)
)

fn transcend_axle() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Fixed Channel");
  render_theorem(sec, "11 is the only unchanged channel", "Going from Z/2,310 to Z/12,612,600, every channel except mod 11 gains resolution by raising its prime to a higher power. Mod 2 becomes mod 8 (x4). Mod 3 becomes mod 9 (x3). Mod 5 becomes mod 25 (x5). Mod 7 becomes mod 49 (x7). Mod 11 stays mod 11 (x1). It is the only channel whose exponent remains 1.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Resolution gain");
  render_th(hdr, "Exponent");
  dom_append(tbl, hdr);
  render_table_row(tbl, "mod 2 -> mod 8", "x4", "3");
  render_table_row(tbl, "mod 3 -> mod 9", "x3", "2");
  render_table_row(tbl, "mod 5 -> mod 25", "x5", "2");
  render_table_row(tbl, "mod 7 -> mod 49", "x7", "2");
  render_table_row(tbl, "mod 11 -> mod 11", "x1 (unchanged)", "1");
  render_p(sec, "The first four primes measure: they distinguish values at increasing resolution. 11 does not add measurement resolution -- it adds error detection. That is why its exponent stays at 1: a check digit does not need depth.");
  dom_append(dom_body(), sec)
)

