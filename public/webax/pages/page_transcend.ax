fn transcend_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard View");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Error correction origin", "Engineered redundancy (parity bits, checksums)", "1 + 2 + 3 + 5 = 11. The check channel is algebraically forced by the ring.");
  render_contrast_row(tbl, "Error detection", "Added after the fact", "CRT channels are natural ECC. The mod-11 channel detects any single error in Z/2,310.");
  render_contrast_row(tbl, "Why 7 primes?", "No reason -- just the first few primes", "5 * 7 = 1 mod 17. The ring closes at exactly 7 primes because 17 is the only prime where this identity holds.");
  render_contrast_row(tbl, "Z/17 closes the ring", "One of infinitely many prime fields", "All 3 check channels (11, 13, 17) are fields. Only 17 satisfies 5 * 7 = 1 mod p. 3 generates all 16 nonzero elements.");
  dom_append(dom_body(), sec)
)

fn transcend_generation() = (
  let sec = make_section("800px") in
  render_h2(sec, "11 in Z/210");
  render_theorem(sec, "Order-6 Orbit", "11 has multiplicative order 6 in Z/210: the orbit is 11, 121, 71, 151, 191, 1. This is the shortest cycle among the chain primes. The midpoint 11^3 = 71 is self-inverse: 71 * 71 = 5041 = 1 mod 210.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Order 6", "11^6 = 1 mod 210", "The shortest cycle among chain primes. Returns to 1 in 6 steps.", "");
  render_finding(g, "Self-inverse at midpoint", "71 * 71 = 1 mod 210", "11^3 = 71. The orbit's midpoint is its own inverse.", "");
  render_finding(g, "Residue pattern", "(1, 2, 1, 4) mod {2, 3, 5, 7}", "The per-channel residues of 11 alternate: 1, 2, 1, 4. An alternating pattern.", "");
  dom_append(dom_body(), sec)
)

fn transcend_escape() = (
  let sec = make_section("800px") in
  render_h2(sec, "17 Closes the Ring");
  render_p(sec, "1 + 2 + 3 + 5 = 11 (without 7). 2 + 3 + 5 + 7 = 17 (without 1). The two sums are complementary: 11 skips the largest data prime, 17 includes it. Where 11 detects errors, 17 completes the structure.");
  render_theorem(sec, "Finality (PROVED)", "5 * 7 = 35 = 1 mod 17. For primes p > 13: 5 * 7 = 1 mod p has a solution only at p = 17. No prime beyond 17 satisfies this identity. The ring closes at exactly 7 primes.");
  render_theorem(sec, "Finality and Field Structure (PROVED)", "The 4 data channels (mod 8, 9, 25, 49) all have zero divisors. The 3 check channels (mod 11, 13, 17) are all prime fields. What distinguishes mod 17 is finality: 5 * 7 = 1 mod 17, and no larger prime satisfies this identity.");
  let g = make_findings_grid(sec) in
  render_finding(g, "phi(17) = 16 = 2^4", "Pure power of 2", "The totient of 17 is a power of the first chain prime.", "");
  render_finding(g, "5 * 7 = 1 mod 17", "Product equals identity", "The product of the two middle primes is the identity in mod 17.", "");
  render_finding(g, "7 channels = 7", "Self-referential", "Z/214,414,200 has 7 channels. 7 is the fourth chain prime. The channel count equals the depth modulus.", "");
  render_finding(g, "3 generates Z/17*", "Primitive root", "3 generates all 16 nonzero elements of Z/17. The same prime that stops the chain at 3^2 = 9 generates the entire mod-17 field.", "");
  render_finding(g, "Triple-parity ECC", "mod 11 + mod 13 + mod 17", "Rate 4/7. 100% known-location correction across all 7 channels.", "");
  dom_append(dom_body(), sec)
)

/* === CRT STEGANOGRAPHY -- absorbed from stego_demo.html === */
fn stego_run() = (
  let n = parse_int_from("#stego-input") in
  let result = dom_query("#stego-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r2 = n % 8 in
    let r3 = n % 9 in
    let r5 = n % 25 in
    let r7 = n % 49 in
    let r11 = n % 11 in
    let r13 = n % 13 in
    let hidden = 5 in
    let m_l = 3439800 in
    let diff = (hidden + 11 - r11) % 11 in
    let stego_n = n + diff * m_l in
    let s11 = stego_n % 11 in
    dom_inner(result, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT STEGANOGRAPHY</p><p style='color:#88ddaa;margin:4px 0'>Original: CRT(" + "${n}" + ") = (" + "${r2}" + ", " + "${r3}" + ", " + "${r5}" + ", " + "${r7}" + ", <span style='color:#ffd700'>" + "${r11}" + "</span>, " + "${r13}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Hiding value 5 in mod-11 channel...</p><p style='color:#88ddaa;margin:4px 0'>Stego: CRT(" + "${stego_n}" + ") = (" + "${r2}" + ", " + "${r3}" + ", " + "${r5}" + ", " + "${r7}" + ", <span style='color:#ff8800'>" + "${s11}" + "</span>, " + "${r13}" + ")</p><p style='color:#b0b0c0;margin:8px 0 4px'>mod 8, mod 9, mod 25, mod 49, mod 13 = <span style='color:#44ff88'>IDENTICAL</span>. Only mod 11 changed.</p><p style='color:#b0b0c0;margin:4px 0'>Carrier " + "${n}" + " becomes " + "${stego_n}" + ". Extract: " + "${stego_n}" + " mod 11 = <span style='color:#ff8800'>" + "${s11}" + "</span>.</p><p style='color:#a0a0b0;margin:8px 0 0;font-size:12px'>Idempotent 3,439,800 = CRT(0,0,0,0,1,0). Adding diff * 3,439,800 changes only mod 11. 3.46 bits/number. CC0.</p></div>")
  )
)

fn transcend_stego() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Steganography");
  render_p(sec, "The mod-11 channel is invisible to anyone who does not know the ring. Hide data in it. The other 5 channels stay untouched -- their statistical profile is preserved. Without knowing the ring is Z/12,612,600, the mod-11 data looks like noise.");
  render_theorem(sec, "CRT Steganography (CC0)", "Decompose carrier numbers into 6 CRT channels. Replace the mod-11 channel with secret data (0-10 per symbol, 3.46 bits). Reconstruct via CRT. The other 5 channels are unchanged. If a stego number is tampered with, the CRT cross-check across channels fails. Capacity: 2 base-11 symbols per ASCII character (11^2 = 121 > 96 printable).");
  render_p(sec, "Enter a carrier number. The mod-11 channel is replaced with hidden value 5:");
  make_interactive_widget(sec, "Carrier number:", "stego-input", "e.g. 42", "Hide in mod 11", "stego_run", "stego-result");
  let g = make_findings_grid(sec) in
  render_finding(g, "Capacity", "3.46 bits/number", "log2(11) per carrier. 2 symbols per ASCII char (11^2 = 121 > 96 printable).", "");
  render_finding(g, "Invisibility", "5 of 6 channels identical", "Only the mod-11 channel carries the payload. All others unchanged.", "");
  render_finding(g, "Tamper detection", "CRT cross-check", "Tampering changes multiple channels. Cross-channel consistency fails.", "");
  render_finding(g, "License", "CC0", "Public domain. No rights reserved.", "");
  dom_append(dom_body(), sec)
)

fn page_transcend() = (
  dom_head_meta("description", "11 = 1+2+3+5. The sum of the first four chain primes. Error correction: mod 11 detects any single-channel corruption. 17 closes the ring: 5*7 = 1 mod 17, Z/17 is the only field. CRT steganography hides data in the mod-11 channel.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Transcendence: 11 and 17\",\"description\":\"11 = 1+2+3+5. Not the next chain step but the sum built from the chain. Error correction: mod 11 detects single-channel corruption in Z/2310. Dual mod-11 + mod-13: 100% detection in Z/12612600. 17 closes the ring: 5*7=1 mod 17, Z/17 is the only field among 7 channels. CRT steganography.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/ideas/transcend\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"error correction\"},{\"@type\":\"DefinedTerm\",\"name\":\"steganography\"}]}");
  transcend_hero();
  transcend_ecc();
  transcend_axle();
  transcend_generation();
  transcend_escape();
  transcend_stego();
  transcend_contrast();
  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Mod-11 Channel");
  render_p(sec_i, "Enter a number to see its CRT decomposition with the mod-11 channel highlighted.");
  make_interactive_widget(sec_i, "Check mod-11 for n:", "ecc-input", "e.g. 137", "Check", "ecc_check", "ecc-result");
  render_p(sec_i, "Try: 42, 137, 420 (Carmichael period), 2310, 1576576 (= 2^420 mod 12612600).");
  dom_append(dom_body(), sec_i)
)
