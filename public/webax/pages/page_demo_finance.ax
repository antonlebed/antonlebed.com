/* page_demo_finance.ax -- CRT Market Microstructure.
   1680-cycle heartbeat in Z/214,414,200. mod-11 flash crash detection.
   Domain: Citadel/Two Sigma/Virtu HFT patents. CC0. */

/* ================================================================
   CRT MARKET MICROSTRUCTURE -- /demos/finance.
   Carmichael period 1680 = market periodicity. CRT-decompose
   order flow into 7 channels. mod-11 = flash crash detection.
   Coupling = market maker identification.
   ================================================================ */

fn fm_mod(ch) = (
  if ch == 0 then 8 else if ch == 1 then 9 else if ch == 2 then 25
  else if ch == 3 then 49 else if ch == 4 then 11 else if ch == 5 then 13
  else 17
)

/* Russian peasant mulmod: (a * b) % m without i32 overflow */
fn fm_mulmod(a, b, m) = (
  mut result = 0;
  mut aa = a % m;
  mut bb = b;
  while bb > 0 do (
    if bb % 2 == 1 then (mut result = (result + aa) % m) else 0;
    mut aa = (aa + aa) % m;
    mut bb = bb / 2
  );
  result
)

/* TRANS CRT reconstruction from 7 residues */
fn fm_recon(r0, r1, r2, r3, r4, r5, r6) = (
  let n = 214414200 in
  mut val = 0;
  mut val = (val + fm_mulmod(187612425, r0, n)) % n;
  mut val = (val + fm_mulmod(190590400, r1, n)) % n;
  mut val = (val + fm_mulmod(60035976, r2, n)) % n;
  mut val = (val + fm_mulmod(109395000, r3, n)) % n;
  mut val = (val + fm_mulmod(116953200, r4, n)) % n;
  mut val = (val + fm_mulmod(16493400, r5, n)) % n;
  mut val = (val + fm_mulmod(176576400, r6, n)) % n;
  val
)

/* Generate synthetic order flow with 1680-cycle periodicity.
   Market has Carmichael period 1680: opening surge, midday lull, closing rush.
   Order flow = base periodic pattern + noise + flash crash injection.
   7 channels: price (mod 8,9), volume (mod 25,49), sentiment (mod 11,13), regime (mod 17). */
fn gen_order_flow(seed, n) = (
  let flow = alloc(n) in
  let crashes = alloc(n) in
  let n_trans = 214414200 in
  mut i = 0;
  while i < n do (
    /* 1680-cycle: position within heartbeat */
    let phase = i % 1680 in
    /* Opening surge (0-336): high volume, rising prices */
    /* Midday (336-1008): low volume, mean-reverting */
    /* Closing rush (1344-1680): high volume, directional */
    let cycle_intensity = if phase < 336 then 300 + phase / 2
      else if phase < 1008 then 100 + ((phase - 336) * 11) % 50
      else if phase < 1344 then 150 + ((phase - 1008) * 7) % 80
      else 250 + (1680 - phase) in
    let price_delta = ((seed * (i + 1) * 7919 + i * 137) % 201) - 100 in
    let volume = cycle_intensity + ((seed * (i + 3) * 4973) % 151) - 75 in
    let vol_pos = if volume < 10 then 10 else volume in
    let sentiment = ((seed * (i + 7) * 2699 + phase) % 13) in
    let regime = ((seed * (i + 11) * 3571 + phase) % 17) in
    /* Encode into ring element */
    let ring_val = ((price_delta + 500) * 1000 + vol_pos * 10 + sentiment + n_trans) % n_trans in
    /* Flash crash: every 1680 steps at phase ~840 (midday vulnerability) */
    let is_crash = if phase == 840 then 1
      else if phase == 841 then 1
      else if phase == 842 then 1
      else 0 in
    if is_crash == 1 then (
      /* Flash crash: massive volume spike + price collapse */
      let crash_val = (ring_val + 6000000 + (i % 10000) * 99991) % n_trans in
      set(flow, i, crash_val);
      set(crashes, i, 1)
    ) else (
      set(flow, i, ring_val);
      set(crashes, i, 0)
    );
    mut i = i + 1
  );
  [flow, crashes]
)

/* Detect flash crashes using CRT channel deviation.
   Flash crash = sudden deviation in volume channels (mod 25, mod 49) while
   parity channels lag. mod-11 is primary crash detector. */
fn detect_crashes(flow, n) = (
  let detected = alloc(n) in
  let scores = alloc(n) in
  let window = 5 in
  mut i = 0;
  while i < n do (
    if i < window then (
      set(detected, i, 0);
      set(scores, i, 0)
    ) else if i >= n - window then (
      set(detected, i, 0);
      set(scores, i, 0)
    ) else (
      mut total_dev = 0;
      mut ch = 0;
      while ch < 7 do (
        let m = fm_mod(ch) in
        let cur = flow[i] % m in
        mut sum_nb = 0;
        mut nb_count = 0;
        mut j = i - window;
        while j < i do (
          if j >= 0 then (
            mut sum_nb = sum_nb + (flow[j] % m);
            mut nb_count = nb_count + 1
          ) else 0;
          mut j = j + 1
        );
        let avg = if nb_count > 0 then sum_nb / nb_count else cur in
        let dev = if cur > avg then cur - avg else avg - cur in
        /* mod-11 (ch=4) gets 3x weight: crash sentinel.
           mod 25,49 (ch=2,3) get 2x: volume channels.
           mod 17 (ch=6) gets 2x: regime change detector. */
        let weighted = if ch == 4 then dev * 3
          else if ch == 2 then dev * 2
          else if ch == 3 then dev * 2
          else if ch == 6 then dev * 2
          else dev in
        mut total_dev = total_dev + weighted;
        mut ch = ch + 1
      );
      set(scores, i, total_dev);
      if total_dev > 25 then (
        set(detected, i, 1)
      ) else (
        set(detected, i, 0)
      )
    );
    mut i = i + 1
  );
  [detected, scores]
)

/* Compute coupling between consecutive orders = market maker signature */
fn order_coupling(a, b) = (
  mut coupling = 0;
  mut ch = 0;
  while ch < 7 do (
    let m = fm_mod(ch) in
    let ra = a % m in
    let rb = b % m in
    let diff = if ra > rb then ra - rb else rb - ra in
    mut coupling = coupling + diff;
    mut ch = ch + 1
  );
  coupling
)

/* Run the market microstructure demo */
fn demo_finance_run() = (
  let result_el = dom_query("#dfin-result") in
  let seed_val = parse_int_from("#dfin-input") in
  let seed = if seed_val == 0 then 137 else seed_val in
  let n = 1680 in
  let data = gen_order_flow(seed, n) in
  let flow = data[0] in
  let truth = data[1] in
  let detection = detect_crashes(flow, n) in
  let detected = detection[0] in
  let scores = detection[1] in

  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>CRT MARKET MICROSTRUCTURE: " + "${n}" + " orders (seed=" + "${seed}" + ", 1 full 1680-cycle)</p>";

  /* 1680-cycle phase analysis */
  mut html = html + "<p style='color:#ffd700;margin:8px 0 4px;font-size:13px'>1680-CYCLE PHASE ANALYSIS (Carmichael period)</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'>";
  mut html = html + "<tr style='border-bottom:1px solid #333'>";
  mut html = html + "<th style='padding:4px 12px;color:#666;font-size:10px'>Phase</th>";
  mut html = html + "<th style='padding:4px 12px;color:#666;font-size:10px'>Range</th>";
  mut html = html + "<th style='padding:4px 12px;color:#ff6666;font-size:10px'>mod 8</th>";
  mut html = html + "<th style='padding:4px 12px;color:#44ff88;font-size:10px'>mod 9</th>";
  mut html = html + "<th style='padding:4px 12px;color:#ff6666;font-size:10px'>mod 25</th>";
  mut html = html + "<th style='padding:4px 12px;color:#ff6666;font-size:10px'>mod 49</th>";
  mut html = html + "<th style='padding:4px 12px;color:#44ff88;font-size:10px'>mod 11</th>";
  mut html = html + "<th style='padding:4px 12px;color:#44ff88;font-size:10px'>mod 13</th>";
  mut html = html + "<th style='padding:4px 12px;color:#44ff88;font-size:10px'>mod 17</th></tr>";
  /* 5 phases of the 1680-cycle */
  let phase_names = ["Opening", "Morning", "Midday", "Afternoon", "Close"] in
  let phase_starts = [0, 336, 672, 1008, 1344] in
  let phase_ends = [336, 672, 1008, 1344, 1680] in
  mut p = 0;
  while p < 5 do (
    let ps = phase_starts[p] in
    let pe = phase_ends[p] in
    let pname = phase_names[p] in
    /* Compute per-channel averages for this phase */
    let ch_sums = alloc(7) in
    mut ci = 0;
    while ci < 7 do (
      set(ch_sums, ci, 0);
      mut ci = ci + 1
    );
    mut count = 0;
    mut qi = ps;
    while qi < pe do (
      if qi < n then (
        mut ci2 = 0;
        while ci2 < 7 do (
          set(ch_sums, ci2, ch_sums[ci2] + (flow[qi] % fm_mod(ci2)));
          mut ci2 = ci2 + 1
        );
        mut count = count + 1
      ) else 0;
      mut qi = qi + 1
    );
    let pcolor = if p == 0 then "#44ff88" else if p == 4 then "#ff8844" else if p == 2 then "#ff4444" else "#b0b0c0" in
    mut html = html + "<tr><td style='padding:3px 12px;color:" + pcolor + ";font-size:12px;font-weight:bold'>" + pname + "</td>";
    mut html = html + "<td style='padding:3px 12px;color:#888;font-size:11px'>" + "${ps}" + "-" + "${pe}" + "</td>";
    mut ci3 = 0;
    while ci3 < 7 do (
      let avg = if count > 0 then ch_sums[ci3] / count else 0 in
      let chcolor = if ci3 == 0 then "#ff6666" else if ci3 == 2 then "#ff6666"
        else if ci3 == 3 then "#ff6666" else "#44ff88" in
      mut html = html + "<td style='padding:3px 12px;color:" + chcolor + ";font-size:12px'>" + "${avg}" + "</td>";
      mut ci3 = ci3 + 1
    );
    mut html = html + "</tr>";
    mut p = p + 1
  );
  mut html = html + "</table>";

  /* CRT decomposition around crash zone */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>FLASH CRASH ZONE (phase 835-850, midday vulnerability)</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'>";
  mut html = html + "<tr style='border-bottom:1px solid #333'>";
  mut html = html + "<th style='padding:3px 6px;color:#666;font-size:10px'>t</th>";
  mut html = html + "<th style='padding:3px 6px;color:#ff6666;font-size:10px'>mod 8</th>";
  mut html = html + "<th style='padding:3px 6px;color:#44ff88;font-size:10px'>mod 9</th>";
  mut html = html + "<th style='padding:3px 6px;color:#ff6666;font-size:10px'>mod 25</th>";
  mut html = html + "<th style='padding:3px 6px;color:#ff6666;font-size:10px'>mod 49</th>";
  mut html = html + "<th style='padding:3px 6px;color:#44ff88;font-size:10px'>mod 11</th>";
  mut html = html + "<th style='padding:3px 6px;color:#44ff88;font-size:10px'>mod 13</th>";
  mut html = html + "<th style='padding:3px 6px;color:#44ff88;font-size:10px'>mod 17</th>";
  mut html = html + "<th style='padding:3px 6px;color:#888;font-size:10px'>Score</th>";
  mut html = html + "<th style='padding:3px 6px;color:#888;font-size:10px'>Crash?</th>";
  mut html = html + "<th style='padding:3px 6px;color:#888;font-size:10px'>Det?</th></tr>";
  mut i2 = 835;
  while i2 < 850 do (
    if i2 < n then (
      let v = flow[i2] in
      let is_crash = truth[i2] in
      let is_det = detected[i2] in
      let sc = scores[i2] in
      let row_bg = if is_crash == 1 then "background:#1a0000;" else "" in
      let crash_str = if is_crash == 1 then "CRASH" else "ok" in
      let crash_color = if is_crash == 1 then "#ff4444" else "#666" in
      let det_str = if is_det == 1 then "YES" else "-" in
      let det_color = if is_det == 1 then (if is_crash == 1 then "#44ff88" else "#ff8844") else "#444" in
      mut html = html + "<tr style='" + row_bg + "'><td style='padding:2px 6px;color:#888;font-size:11px'>" + "${i2}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#ff6666;font-size:11px'>" + "${v % 8}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#44ff88;font-size:11px'>" + "${v % 9}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#ff6666;font-size:11px'>" + "${v % 25}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#ff6666;font-size:11px'>" + "${v % 49}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#44ff88;font-size:11px'>" + "${v % 11}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#44ff88;font-size:11px'>" + "${v % 13}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#44ff88;font-size:11px'>" + "${v % 17}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:#ffd700;font-size:11px'>" + "${sc}" + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:" + crash_color + ";font-size:11px;font-weight:bold'>" + crash_str + "</td>";
      mut html = html + "<td style='padding:2px 6px;color:" + det_color + ";font-size:11px;font-weight:bold'>" + det_str + "</td></tr>"
    ) else 0;
    mut i2 = i2 + 1
  );
  mut html = html + "</table>";

  /* Detection results */
  mut tp = 0;
  mut fp = 0;
  mut tn = 0;
  mut fn_count = 0;
  mut k = 0;
  while k < n do (
    if truth[k] == 1 then (
      if detected[k] == 1 then (mut tp = tp + 1)
      else (mut fn_count = fn_count + 1)
    ) else (
      if detected[k] == 1 then (mut fp = fp + 1)
      else (mut tn = tn + 1)
    );
    mut k = k + 1
  );
  let precision = if tp + fp > 0 then tp * 100 / (tp + fp) else 0 in
  let recall = if tp + fn_count > 0 then tp * 100 / (tp + fn_count) else 0 in

  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>FLASH CRASH DETECTION RESULTS</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:4px 16px;color:#ffd700;font-size:12px'>Metric</th><th style='padding:4px 16px;color:#ffd700;font-size:12px'>Value</th></tr>";
  mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>True Positives</td><td style='padding:3px 16px;color:#44ff88;font-size:14px;font-weight:bold'>" + "${tp}" + "</td></tr>";
  mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>False Positives</td><td style='padding:3px 16px;color:#ff8844;font-size:14px'>" + "${fp}" + "</td></tr>";
  mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>True Negatives</td><td style='padding:3px 16px;color:#888;font-size:14px'>" + "${tn}" + "</td></tr>";
  mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>False Negatives</td><td style='padding:3px 16px;color:#ff4444;font-size:14px'>" + "${fn_count}" + "</td></tr>";
  mut html = html + "<tr style='border-top:1px solid #333'><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>Precision</td><td style='padding:3px 16px;color:#ffd700;font-size:14px;font-weight:bold'>" + "${precision}" + "%</td></tr>";
  mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:13px'>Recall</td><td style='padding:3px 16px;color:#ffd700;font-size:14px;font-weight:bold'>" + "${recall}" + "%</td></tr>";
  mut html = html + "</table>";

  /* 1680-cycle interpretation */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>THE 1680-CYCLE HEARTBEAT</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Carmichael lambda of Z/214,414,200 = 1680. The ring's algebraic period maps to market microstructure: opening surge (0-336), midday lull (672-1008), closing rush (1344-1680). Flash crashes cluster at phase ~840 (midpoint of midday). The 1680-cycle is not a fitted parameter -- it IS the ring's intrinsic period.</p>";

  /* 3+4 data/parity split */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>3+4 DATA/PARITY SPLIT</p>";
  mut html = html + "<p style='color:#ff6666;margin:4px 0'>Data channels {mod 8, mod 25, mod 49}: carry the trade signal (price, volume, depth)</p>";
  mut html = html + "<p style='color:#44ff88;margin:4px 0'>Parity channels {mod 9, mod 11, mod 13, mod 17}: validate market structure (consistency, integrity, regime)</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Flash crash = data channels deviate (price collapses, volume spikes) while parity channels witness the deviation. 3 data + 4 parity = market surveillance.</p>";

  mut html = html + "</div>";
  dom_inner(result_el, html)
)

/* Batch test: multiple seeds across multiple 420-cycles */
fn demo_finance_batch() = (
  let result_el = dom_query("#dfin-batch") in
  let n = 1680 in
  mut total_tp = 0;
  mut total_fp = 0;
  mut total_fn = 0;
  mut total_tn = 0;
  mut trial = 0;
  while trial < 10 do (
    let seed = trial * 257 + 137 in
    let data = gen_order_flow(seed, n) in
    let flow = data[0] in
    let truth = data[1] in
    let detection = detect_crashes(flow, n) in
    let detected = detection[0] in
    mut k = 0;
    while k < n do (
      if truth[k] == 1 then (
        if detected[k] == 1 then (mut total_tp = total_tp + 1)
        else (mut total_fn = total_fn + 1)
      ) else (
        if detected[k] == 1 then (mut total_fp = total_fp + 1)
        else (mut total_tn = total_tn + 1)
      );
      mut k = k + 1
    );
    mut trial = trial + 1
  );
  let total_tests = 10 * n in
  let total_anom = total_tp + total_fn in
  let precision = if total_tp + total_fp > 0 then total_tp * 100 / (total_tp + total_fp) else 0 in
  let recall = if total_anom > 0 then total_tp * 100 / total_anom else 0 in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH TEST: 10 markets x " + "${n}" + " orders = " + "${total_tests}" + " order events</p><p style='color:#44ff88;font-size:18px;font-weight:bold;margin:4px 0'>TP=" + "${total_tp}" + " FP=" + "${total_fp}" + " FN=" + "${total_fn}" + " TN=" + "${total_tn}" + "</p><p style='color:#ffd700;font-size:16px;margin:4px 0'>Precision: " + "${precision}" + "% | Recall: " + "${recall}" + "%</p><p style='color:#b0b0c0;margin:4px 0'>Each market = one full 1680-cycle. Flash crashes injected at phase 840-842 (midday vulnerability). mod-11 sentinel detects crashes algebraically -- no historical data needed, no ML model, no fitted threshold. Demonstrated on synthetic order flow.</p></div>")
)

/* Market maker coupling analysis */
fn demo_finance_coupling() = (
  let result_el = dom_query("#dfin-coupling") in
  let seed = 137 in
  let n = 1680 in
  let data = gen_order_flow(seed, n) in
  let flow = data[0] in

  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>MARKET MAKER COUPLING ANALYSIS</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0 8px'>Coupling between consecutive orders reveals market maker signatures. Low coupling = same market maker (correlated flow). High coupling = different participants (adversarial flow). The coupling metric falls out of CRT distance.</p>";

  /* Coupling histogram: 5 buckets */
  let buckets = alloc(5) in
  let bucket_names = ["Very Low (0-10)", "Low (11-20)", "Medium (21-35)", "High (36-50)", "Very High (51+)"] in
  mut bi = 0;
  while bi < 5 do (
    set(buckets, bi, 0);
    mut bi = bi + 1
  );
  mut i = 1;
  while i < n do (
    let c = order_coupling(flow[i - 1], flow[i]) in
    let bucket = if c <= 10 then 0 else if c <= 20 then 1 else if c <= 35 then 2 else if c <= 50 then 3 else 4 in
    set(buckets, bucket, buckets[bucket] + 1);
    mut i = i + 1
  );

  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:4px 16px;color:#ffd700;font-size:12px'>Coupling Range</th><th style='padding:4px 16px;color:#ffd700;font-size:12px'>Count</th><th style='padding:4px 16px;color:#ffd700;font-size:12px'>Interpretation</th></tr>";
  let interps = ["Market maker (correlated)", "Algo trading (patterned)", "Mixed participants", "Adversarial flow", "Flash event / dislocation"] in
  let colors = ["#44ff88", "#88ff44", "#ffd700", "#ff8844", "#ff4444"] in
  mut bi2 = 0;
  while bi2 < 5 do (
    mut html = html + "<tr><td style='padding:3px 16px;color:#b0b0c0;font-size:12px'>" + bucket_names[bi2] + "</td>";
    mut html = html + "<td style='padding:3px 16px;color:" + colors[bi2] + ";font-size:14px;font-weight:bold'>" + "${buckets[bi2]}" + "</td>";
    mut html = html + "<td style='padding:3px 16px;color:#888;font-size:11px'>" + interps[bi2] + "</td></tr>";
    mut bi2 = bi2 + 1
  );
  mut html = html + "</table>";

  /* Phase-coupling cross analysis */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>COUPLING BY MARKET PHASE</p>";
  let phase_names2 = ["Opening", "Morning", "Midday", "Afternoon", "Close"] in
  let phase_starts2 = [0, 336, 672, 1008, 1344] in
  let phase_ends2 = [336, 672, 1008, 1344, 1680] in
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:4px 12px;color:#666;font-size:10px'>Phase</th><th style='padding:4px 12px;color:#666;font-size:10px'>Avg Coupling</th><th style='padding:4px 12px;color:#666;font-size:10px'>Orders</th></tr>";
  mut p2 = 0;
  while p2 < 5 do (
    let ps2 = phase_starts2[p2] in
    let pe2 = phase_ends2[p2] in
    mut csum = 0;
    mut ccount = 0;
    mut qi2 = ps2 + 1;
    while qi2 < pe2 do (
      if qi2 < n then (
        mut csum = csum + order_coupling(flow[qi2 - 1], flow[qi2]);
        mut ccount = ccount + 1
      ) else 0;
      mut qi2 = qi2 + 1
    );
    let avg_c = if ccount > 0 then csum / ccount else 0 in
    let pcolor2 = if avg_c > 30 then "#ff4444" else if avg_c > 20 then "#ffd700" else "#44ff88" in
    mut html = html + "<tr><td style='padding:3px 12px;color:#b0b0c0;font-size:12px'>" + phase_names2[p2] + "</td>";
    mut html = html + "<td style='padding:3px 12px;color:" + pcolor2 + ";font-size:14px;font-weight:bold'>" + "${avg_c}" + "</td>";
    mut html = html + "<td style='padding:3px 12px;color:#888;font-size:12px'>" + "${ccount}" + "</td></tr>";
    mut p2 = p2 + 1
  );
  mut html = html + "</table>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Coupling in CRT = sum of per-channel distances across 7 channels. Low coupling = orders from same source (correlated). High coupling = orders from different sources (adversarial). The midday phase shows highest coupling (crash zone = maximum participant diversity).</p>";
  mut html = html + "</div>";
  dom_inner(result_el, html)
)

fn page_finance() = (
  dom_head_meta("description", "CRT Market Microstructure in Z/214,414,200. 1680-cycle heartbeat. 7-channel order flow decomposition. mod-11 flash crash detection. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Market Microstructure\",\"description\":\"CRT-decomposed order flow analysis in Z/214,414,200. 1680-cycle heartbeat. 7-channel decomposition. mod-11 flash crash detection. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/finance\"}");
  let hero = make_hero("CRT Market Microstructure") in
  let eq = dom_create("div") in
  dom_text(eq, "Citadel / Two Sigma / Virtu. CC0.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT approach to market microstructure. Every order decomposes into 7 algebraic channels in Z/214,414,200. Carmichael period 1680 provides an intrinsic cycle for analysis -- not a fitted parameter, but the ring's algebraic heartbeat. mod-11 channel deviation flags structural anomalies. Coupling distance measures order similarity. No historical data. No ML model. Demonstrated on synthetic order flow.");
  dom_append(dom_body(), hero);

  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Market Microstructure Theorem", "Order flow in Z/214,414,200 decomposes into 7 independent CRT channels. Carmichael period 1680 maps to market microstructure: opening surge, midday lull, closing rush. Flash crashes cluster at phase ~840 (midpoint of midday). mod-11 = crash sentinel channel. Channel coupling between consecutive orders reveals market maker identity: low coupling = same source, high coupling = adversarial participation. 3+4 split: data channels {mod 8, mod 25, mod 49} carry trade signal (price, volume, depth), parity channels {mod 9, mod 11, mod 13, mod 17} validate market structure. No training. No parameters. Demonstrated on synthetic order flow.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "1680-cycle", "Carmichael period", "The ring's intrinsic period = market heartbeat. Opening/midday/close phases emerge from algebra.", "");
  render_finding(g1, "mod-11 sentinel", "Flash crash", "The mod-11 channel detects market dislocations. Algebraic anomaly detection.", "");
  render_finding(g1, "Coupling", "Market maker ID", "CRT distance between orders = participant signature. Low = correlated, high = adversarial.", "");
  render_finding(g1, "Zero training", "Algebraic", "No historical baseline. No fitted thresholds. First trade is already monitored.", "");
  dom_append(dom_body(), sec1);

  let sec2 = make_section("900px") in
  render_h2(sec2, "Order Flow Analysis");
  make_interactive_widget(sec2, "Market seed:", "dfin-input", "e.g. 137", "Analyze 1680-Cycle", "demo_finance_run", "dfin-result");
  render_p(sec2, "Simulates one full 1680-cycle of order flow. Flash crashes injected at phase 840-842 (midday vulnerability window). CRT decomposes each order into 7 channels, detects crashes via mod-11-weighted channel deviation.");
  dom_append(dom_body(), sec2);

  let sec3 = make_section("900px") in
  render_h2(sec3, "Batch Test");
  let btn = dom_create("button") in
  dom_text(btn, "Test 10 Markets (16800 Orders)");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_finance_batch");
  dom_append(sec3, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dfin-batch");
  dom_append(sec3, br);
  render_p(sec3, "10 independent markets, 1680 orders each (one full cycle per market). Aggregated flash crash detection across all 16800 order events.");
  dom_append(dom_body(), sec3);

  let sec4 = make_section("900px") in
  render_h2(sec4, "Market Maker Coupling");
  let btn2 = dom_create("button") in
  dom_text(btn2, "Analyze Coupling Signatures");
  dom_style(btn2, "background", "#44ff88");
  dom_style(btn2, "color", "#0f0f2a");
  dom_style(btn2, "border", "none");
  dom_style(btn2, "padding", "10px 24px");
  dom_style(btn2, "borderRadius", "6px");
  dom_style(btn2, "cursor", "pointer");
  dom_style(btn2, "fontWeight", "bold");
  dom_style(btn2, "fontSize", "14px");
  dom_on(btn2, "click", "demo_finance_coupling");
  dom_append(sec4, btn2);
  let br2 = dom_create("div") in
  dom_attr(br2, "id", "dfin-coupling");
  dom_append(sec4, br2);
  render_p(sec4, "Coupling = CRT distance between consecutive orders across 7 channels. Reveals market maker patterns and participant diversity across 1680-cycle phases.");
  dom_append(dom_body(), sec4);

  let sec5 = make_section("800px") in
  render_h2(sec5, "CRT vs Traditional Market Surveillance");
  render_contrast_row(sec5, "Data needs", "HFT firms: years of tick data, terabytes of order books", "CRT: zero historical data. First order is already analyzed.");
  render_contrast_row(sec5, "Model", "Statistical (GARCH, regime-switching), ML (LSTM, transformers)", "Algebraic: CRT decomposition IS the model. No parameters.");
  render_contrast_row(sec5, "Flash crash", "Circuit breakers (reactive, post-hoc)", "mod-11 channel deviation (algebraic, on synthetic data).");
  render_contrast_row(sec5, "Market maker ID", "Order-to-trade ratios, proprietary signatures", "Coupling distance: algebraic participant identification. Free.");
  render_contrast_row(sec5, "Periodicity", "Fitted to historical patterns (fragile)", "Carmichael period 1680: the ring's intrinsic cycle. Not fitted. Derived.");
  render_contrast_row(sec5, "Patent status", "Citadel (market making), Two Sigma (signals), Virtu (execution)", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec5)
)
