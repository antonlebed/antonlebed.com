/* closure helpers */
fn closure_hero() = (
  let hero = make_hero("Closure") in
  let eq = dom_create("div") in
  dom_text(eq, "3 = 1 + 2 (minimum to close)");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "When 0/0 precipitates 1 and 2 opens duality, 3 is the first force that CLOSES. Triangle = first shape with area. Without 3, the cut of 2 never heals. 3^2 = 9 = STOP: closure applied to itself is self-reference overflow. Coupling: 770 (Z/2,310), 107800 (Z/970,200), 1401400 (Z/12,612,600 = e_3 projector).");
  dom_append(dom_body(), hero)
)

fn closure_identity() = (
  let sec = make_section("800px") in
  render_h2(sec, "3: The Closure Prime");
  let g = make_findings_grid(sec) in
  render_finding(g, "3-class", "coupling 1401400 = e_3", "3-class elements share mod-9 channel = 0. 64 idempotents (Z/12,612,600). coupling(3^2) = e_3 projector.", "");
  render_finding(g, "MI hierarchy", "94% of total MI", "3 carries 94% of all mutual information in prime gaps. Closure IS the structure of gap sequences.", "");
  render_finding(g, "Transparency", "(3-1)/d(3) = 1", "Most expensive ring (cost 3) yet transparent to the balance. Scaffolding that leaves no trace.", "");
  render_finding(g, "Triangles", "770 = N/3", "Z/2310 has EXACTLY 770 triangles. All 3-3-3 type. Triangle count = 3-class size.", "");
  render_finding(g, "Perfectness", "ONLY 3 breaks it", "Remove 3: chi=3 but omega=2. Remove 2,5,7: still perfect. 3 IS perfectness.", "");
  render_finding(g, "Parity gatekeeper", "3 = 54.5% obstruction", "3 > 2(50%) > 5(36.4%) > 7(29.2%) > 11(24.1%). Hardest wall for smooth exponents.", "");
  render_finding(g, "Meta-residue", "3 mod 7 = 3 = 17 mod 7", "Closure and transcendence are meta-identical. 3*5 = 1 mod 7: closure inverts observation. 3^2 mod 7 = 2: closure squared is bridge.", "");
  dom_append(dom_body(), sec)
)

fn closure_k_powers() = (
  let sec = make_section("800px") in
  render_h2(sec, "Powers of 3: From Stop to Depth");
  render_theorem(sec, "3-Filter Theorem", "3 is the ONLY odd prime where Z/3Z* = {+1, -1}. phi(3) = 3-1 = 2. Every integer coprime to 3 is +1 or -1 mod 3. No middle ground. Universal wall filter. The doorman IS the door.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Power");
  render_th(hdr, "Value");
  render_th(hdr, "Identity");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "3^0", "1", "Identity", "Ground state. Existence.");
  render_table_row_4(tbl, "3^1", "3", "Closure", "First shape with area. Triangle.");
  render_table_row_4(tbl, "3^2", "9 = STOP", "Self-reference overflow", "7+2=9. 2^2+5=9. Godel/halting at 3^2.");
  render_table_row_4(tbl, "3^3", "27 = 7 mod 2*5", "Depth", "Depth IS closure-cubed. dim(Jordan algebra).");
  render_table_row_4(tbl, "3^4", "81", "105 gap", "3^4 + c = 105. 3^4 - c = 57 = chi(7A).");
  render_p(sec, "3^2 = 9: the STOP. Appears in 11+ forms: 7+2 (chain stop), 2^2+5 (crossover), 2^3+1, 3-body instability, Miller's 7+/-2, gestation, eigenvalue polynomial degree. Godel, halting, Russell: all overflow at self-reference. 3^2 is the EXACT algebraic expression of this limit.");
  dom_append(dom_body(), sec)
)

