fn closure_capacity() = (
  let sec = make_section("800px") in
  render_h2(sec, "CLT Capacity: Closure's Resource Budget");
  render_theorem(sec, "CLT Capacity Theorem (PROVED)", "Fat CRT Cayley capacity converges to a POSITIVE floor: C_inf = 0.067 bits. NR/N -> erfc(sqrt(2)) = 4.55% (Gaussian 2-sigma tail). Berry-Esseen: O(1/sqrt(k)). Peak at k=3: 0.109 bits. Z/12,612,600 (k=5): 0.082 bits. Converges to 0.067. The ring always retains information.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Peak at k=3", "0.109 bits", "Closure = maximum capacity. 3 channels carry the most info per element.", "");
  render_finding(g, "Z/12,612,600", "0.082 bits", "6 channels (k=5). Still above floor.", "");
  render_finding(g, "Floor", "0.067 bits", "Positive forever. Information never fully dissipates. The ring HOLDS.", "");
  render_finding(g, "4.55% tail", "erfc(sqrt(2))", "Non-residue fraction = Gaussian 2-sigma tail. Statistical mechanics in the ring.", "");
  render_theorem(sec, "Z/12,612,600 NR Prime (PROVED)", "NR/phi = 17807/67200. 17807 is PRIME. CRT(17807) = (7, 5, 7, 2^2*5, 3^2). Asymmetry = 109 = f(11) = depth quadratic of the protector.");
  render_p(sec, "Why this matters: as you add channels (fatten the ring), information capacity drops -- but it NEVER reaches zero. There's a positive floor. The ring always holds 0.067 bits per element no matter how fat it gets. This is closure's fundamental promise: 3 at the peak, and a non-zero floor forever.");
  dom_append(dom_body(), sec)
)

