/* router_connections.ax -- Module router for CONNECTIONS (data tier + deep physics). */

fn page_404(hash) = (
  let sec = make_section("600px") in
  render_h2(sec, "Page Not Found");
  render_p(sec, "No page matches this route.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Home", "/", "Start here.", "");
  dom_append(dom_body(), sec)
)

fn route_page(hash) = page_404(hash)

/* S2002: redirect stub for pages moved to other sections */
fn page_moved(url, name) = (
  let sec = make_section("600px") in
  render_h2(sec, "Page Moved");
  render_p(sec, "This page has moved. Visit <a href='" + url + "' style='color:#ffd700'>" + name + "</a> in its new section.");
  dom_append(dom_body(), sec)
)

fn route() = (
  let hash = get_hash() in
  if streq(hash, "connections") == 1 then page_connections_index()
  else if streq(hash, "turbulence") == 1 then page_turbulence()
  else if streq(hash, "sleep") == 1 then page_sleep()
  else if streq(hash, "kingdoms") == 1 then page_kingdoms()
  else if streq(hash, "ecc") == 1 then page_ecc()
  else if streq(hash, "dark_energy") == 1 then page_dark_energy()
  else if streq(hash, "chemistry") == 1 then page_chemistry()
  else if streq(hash, "dna") == 1 then page_dna()
  else if streq(hash, "dimension") == 1 then page_dimension()
  else if streq(hash, "braid") == 1 then page_braid()
  else if streq(hash, "ouroboros") == 1 then page_ouroboros()
  else if streq(hash, "modular_forms") == 1 then page_modular_forms()
  else if streq(hash, "lie_algebra") == 1 then page_lie_algebra()
  else if streq(hash, "eta_bridge") == 1 then page_eta_bridge()
  else if streq(hash, "monster_moonshine") == 1 then page_monster_moonshine()
  /* S2004: lambda_rlm moved from Lab */
  else if streq(hash, "lambda_rlm") == 1 then page_lambda_rlm()
  /* noxan cut S1978 */
  else if streq(hash, "crt_stats") == 1 then page_crt_stats()
  /* S2002: proof pages moved to Lab, freewill+infinity moved to Theory. Redirects: */
  else if streq(hash, "proof") == 1 then page_moved("/lab/proof_core", "Proof Assistant")
  else if streq(hash, "proof_core") == 1 then page_moved("/lab/proof_core", "Proof Assistant")
  else if streq(hash, "proof_structure") == 1 then page_moved("/lab/proof_structure", "Proof: Ring Structure")
  else if streq(hash, "proof_ai") == 1 then page_moved("/lab/proof_ai", "Proof: AI & Coding")
  else if streq(hash, "proof_frontier") == 1 then page_moved("/lab/proof_frontier", "Proof: Geometry")
  else if streq(hash, "freewill") == 1 then page_moved("/theory/freewill", "The Catalan Gap")
  else if streq(hash, "infinity") == 1 then page_moved("/theory/infinity", "Infinity from Finite")
  else page_404(hash)
)

let arena_mark = [0]
fn get_hp() = hp()
fn reset_hp(v) = set_hp(v)
fn route_only() = (
  dom_inner(dom_body(), "");
  ct_moon(dom_body());
  route();
  highlight_nav();
  render_vow(dom_body());
  render_footer()
)

fn on_navigate() = (
  set_hp(arena_mark[0]);
  close_nav_dd();
  route_only()
)
ct_body(dom_body());
ct_starfield(dom_body());
ct_clouds(dom_body());
ct_wave(dom_body());
render_nav();
let spa_root = dom_create("div") in
dom_style(spa_root, "position", "relative");
dom_style(spa_root, "zIndex", "1");
dom_style(spa_root, "paddingTop", "52px");
dom_append(dom_body(), spa_root);
dom_set_root(spa_root);
set(arena_mark, 0, hp());
ct_moon(dom_body());
route();
highlight_nav();
render_vow(dom_body());
render_footer();
dom_spa_init("on_navigate")
