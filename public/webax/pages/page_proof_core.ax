  pf_result(sec30, "Parity product = L*GATE*ESCAPE", "11*13*17 = ${11*13*17}", if 11*13*17 == 2431 then 1 else 0);
  pf_result(sec30, "Lambda/b = D^4*K*E", "1680/7 = ${1680/7} = ${16*3*5}", if 1680/7 == 16*3*5 then 1 else 0);
  let p30 = (if 8*9*25*49*11*13*17==N_TRANS then 1 else 0) + (if pe_inv8==4 then 1 else 0) + (if pe_inv8>pe_inv4 then 1 else 0) + (if pe_total==256 then 1 else 0) + (if pe_sum==12 then 1 else 0) + (if 11*13*17==2431 then 1 else 0) + (if 1680/7==16*3*5 then 1 else 0) in
  pf_theorem(sec30, "PARETO EXPONENTS",
    "{3,2,2,2,1,1,1} uniquely maximizes involutions + lambda gap. D-channel at depth 3: Klein four-group (4 involutions vs 2). Total 256 = D^8 in TRANS. Exponent sum 12 = D^2*K. Three thin towers = K = ECC parity layer. Marginal lambda step: b^2 gives ratio b = 7..", p30, 7);
  dom_append(dom_body(), sec30);

  /* Thm 31 (Thin Primorial) cut: trivial arithmetic. */

  /* ============================================================
     THEOREM 32: PRIMORIAL(47) THIN EXTENSION (S1435 Phase OMEGA)
     Past rad(TRANS)=510510, Tower B extends to primorial(47) -- the
     thin-primorial summit at the Universal Boundary. 15 primes in
     layer partition {7, 6, 2} = {b, D*K, D}; sum=K*E, product=HB84.
     Idempotent count D^(K*E); lambda ratio K*L*c(L) over TRANS.
     FALSIFIES "primorial(47) is a deeper fat summit": TRANS stays
     fat/Pareto summit (exponent K), primorial(47) is the thin extreme.
     ============================================================ */
  let sec32 = make_section("700px") in
  render_h2(sec32, "32. Primorial(47) Thin Extension (primorial)");
  render_p(sec32, "Tower B extends past rad(TRANS)=510510 to primorial(47) at the Universal Boundary. 15 primes partition as 7 axiom + 6 pure intruders + 2 composite-self-map loopholes. All three layer-counts are axiom-named. TRANS remains the fat/Pareto summit; primorial(47) is the thin extreme.");
  let pr32_p15 = 7 + 6 + 2 in
  let pr32_part = 7 * 6 * 2 in
  let pr32_rad = 2*3*5*7*11*13*17 in
  let pr32_idem = 32768 in
  let pr32_lam = 1275120 in
