  pf_result(s100, "Bloom accuracy 68/399 (17%) << DL 112/399 (28%)", "${bl_acc}", if bl_acc < dl_acc then 1 else 0);
  pf_result(s100, "Bloom score > DL score at 332/399 (83%) positions", "${bl_gt_dl}", if bl_gt_dl > 199 then 1 else 0);
  pf_result(s100, "Oracle(DL,bloom) = 133 (gap = 21)", "${orc_db}", if orc_db > dl_acc then 1 else 0);
  pf_result(s100, "Best routing S1(agree<3) = 71 < DL(112): routing HURTS", "${s1_v}", if s1_v < dl_acc then 1 else 0);
