  pf_result(sec98, "C0 DL still wins: 112 > 111", "${c0d_c98}", if c0d_c98 > c1s_c then 1 else 0);
  pf_result(sec98, "Bloom immune to C1: C1 bloom = C0 bloom = 68", "${blm_c98}", if blm_c98 == 68 then 1 else 0);
  pf_result(sec98, "Sub-additive: sel lift +3, +1, +1 (1x, 2x, 4x)", "${c1s_c - c1p_c98}", if c1s_c - c1p_c98 < 5 then 1 else 0);
