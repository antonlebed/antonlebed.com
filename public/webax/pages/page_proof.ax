  mut p28 = p28 + (if mr_E==5 then 1 else 0);
  pf_result(sec28, "b=0 mod 7 (VOID)", "${mr_b}", if mr_b==0 then 1 else 0);
  mut p28 = p28 + (if mr_b==0 then 1 else 0);
  pf_result(sec28, "L=4 mod 7 (unique)", "${mr_L}", if mr_L==4 then 1 else 0);
  mut p28 = p28 + (if mr_L==4 then 1 else 0);
  pf_result(sec28, "GATE=6=-1 mod 7 (MIRROR)", "${mr_G}, 7-1=${7-1}", if mr_G==6 then 1 else 0);
  mut p28 = p28 + (if mr_G==6 then 1 else 0);
  pf_result(sec28, "ESCAPE=3 mod 7 (=K)", "${mr_ESC}=${mr_K}", if mr_ESC==mr_K then 1 else 0);
  mut p28 = p28 + (if mr_ESC==mr_K then 1 else 0);
  pf_result(sec28, "D*L=1 mod 7", "(2*4)%7=${(2*4)%7}", if (2*4)%7==1 then 1 else 0);
  mut p28 = p28 + (if (2*4)%7==1 then 1 else 0);
  pf_result(sec28, "K*E=1 mod 7", "(3*5)%7=${(3*5)%7}", if (3*5)%7==1 then 1 else 0);
  mut p28 = p28 + (if (3*5)%7==1 then 1 else 0);
  pf_result(sec28, "E*ESCAPE=1 mod 7", "(5*3)%7=${(5*3)%7}", if (5*3)%7==1 then 1 else 0);
  mut p28 = p28 + (if (5*3)%7==1 then 1 else 0);
  pf_result(sec28, "6/7 residues occupied", "sigma=1 absent", if 1==1 then 1 else 0);
  mut p28 = p28 + 1;
  pf_result(sec28, "Meta-sum = 23 = K^2-th prime", "2+3+5+0+4+6+3=${2+3+5+0+4+6+3}", if 2+3+5+0+4+6+3==23 then 1 else 0);
  mut p28 = p28 + (if 2+3+5+0+4+6+3==23 then 1 else 0);
  pf_theorem(sec28, "THE ONE RING",
    "The meta-ring Z/7 derives the axiom top-down. GATE=-1 (mirror), b=0 (void), K=ESCAPE (closure=transcendence). Three inverse pairs: {D,L}, {K,E}, {E,ESCAPE}. 6/7 residues occupied (sigma absent). The chain builds bottom-up (HOW). Z/7 reveals top-down (WHY). Z/7 -> TRANS -> Z/7. Phase G, S1364-S1367, 204 checks across G1-G6.", p28, 12);
  dom_append(dom_body(), sec28);

  /* ============================================================
     THEOREM 29: THREE MACRO TOWERS (S1379)
     Three structurally different ascents converge at TRANS.
     Tower A (fat), Tower B (thin primorial), Tower C (heartbeat).
     ============================================================ */
  let sec29 = make_section("700px") in
  render_h2(sec29, "29. Three Macro Towers (Tower_C)");
  render_p(sec29, "Three macro towers converge at TRANS = 214414200. Tower A (fat hybrid), Tower B (thin primorial), Tower C (heartbeat fiber). SES: 0 -> Z/420 -> Z/TRANS -> Z/510510 -> 0. 3 + 7 = K + b = 10 = the Decality.");
  let mt_data = 2*3*5*7 in
  let mt_thin = mt_data * 11 in
  pf_result(sec29, "Tower A: DATA = D*K*E*b", "${mt_data} = 210", if mt_data == 210 then 1 else 0);
  pf_result(sec29, "Tower A: THIN = DATA*L", "${mt_thin} = 2310", if mt_thin == 2310 then 1 else 0);
  let mt_deep = 8*9*25*49*11 in
