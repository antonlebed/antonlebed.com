  pf_result(sec31, "L | 510510", "${tp7/11}", if tp7%11==0 then 1 else 0);
  pf_result(sec31, "GATE | 510510", "${tp7/13}", if tp7%13==0 then 1 else 0);
  pf_result(sec31, "ESCAPE | 510510", "${tp7/17}", if tp7%17==0 then 1 else 0);
