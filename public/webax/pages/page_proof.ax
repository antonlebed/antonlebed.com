  let p100 = (if bl_all7 == 399 then 1 else 0) + (if bl_acc < dl_acc then 1 else 0) + (if bl_gt_dl > 199 then 1 else 0) + (if orc_db > dl_acc then 1 else 0) + (if s1_v < dl_acc then 1 else 0) + 1 in
  pf_theorem(s100, "BLOOM PHANTOM COHERENCE",
    "Bloom voting ALWAYS produces perfectly self-consistent CRT tuples (NN score = 7/7 at all 399 positions). But bloom accuracy (68/399 = 17%) is far below DL (112/399 = 28%). Bloom's coherence is STRUCTURAL: majority voting of 7 correlated sources naturally produces valid CRT tuples ('phantom coherence'). NN-score comparison cannot distinguish correct from incorrect bloom predictions. All 5 routing strategies (agreement-gated, score-gated, global score, strict threshold) produce WORSE accuracy than DL alone (71-83 vs 112). The 21-position oracle gap between DL and bloom IS real but UNEXPLOITABLE by score-based routing. ROUTING HYPOTHESIS FALSIFIED. Implication: the pipeline ceiling requires a new prediction mechanism, not better routing between existing methods. 14/14 test_smart_bloom.ax.", p100, 6);
  dom_append(dom_body(), s100);

  /* Theorem 101: Two-Pass Coherence (S1621) */
  let s101 = make_section("700px") in
  render_h3(s101, "Theorem 101: Two-Pass Coherence");
