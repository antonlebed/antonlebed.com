  dom_append(dom_body(), sec29);

  /* ============================================================
     THEOREM 30: PARETO EXPONENTS (S1331)
     {3,2,2,2,1,1,1} uniquely maximizes involutions + lambda gap.
     Tower_D at depth 3 (unique). b^2 = marginal lambda step.
     ============================================================ */
