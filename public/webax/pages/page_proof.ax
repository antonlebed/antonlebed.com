  pf_result(sec29, "Decality: 3+7 = K+b = 10", "3 macro + 7 micro", if 3+7 == 10 then 1 else 0);
  let p29 = (if mt_data==210 then 1 else 0) + (if mt_thin==2310 then 1 else 0) + (if mt_deep==970200 then 1 else 0) + (if mt_deep*13==N_TRUE then 1 else 0) + (if N_TRUE*17==N_TRANS then 1 else 0) + (if mt_b7==510510 then 1 else 0) + (if 4*3*5*7==420 then 1 else 0) + (if mt_c7==N_TRANS then 1 else 0) + (if N_TRUE*17==mt_c7 then 1 else 0) + (if mt_ses==420 then 1 else 0) + (if 3+7==10 then 1 else 0) in
  pf_theorem(sec29, "THREE MACRO TOWERS",
