  /* ============ Theorem 103: Coupling Pipeline ============ */
  let s103 = make_section("700px") in
  render_h3(s103, "Theorem 103: Coupling-Attention Pipeline");
  render_p(s103, "Coupling-attention (eigenvalue inner product) is zero-parameter but noise-dominated at text scale.");
  let coup_nn = 6 in
  let tri_nn_v = 105 in
  let oracle_v = 108 in
  let coup_ppt = 70 in
  let rand_ppt = 75 in
  let same_wt = 484 in
  let diverg = 384 in
