/* page_proof.ax -- Proof Assistant routing and test harness entry point.
   The ring verifies itself. 189 theorems + 1 falsification, verified live.
   PHYSICAL SPLIT S1761, TRIVIAL-CUT S1948: 20 trivial-arithmetic theorems removed.
     page_proof_core.ax      — proof_part1 + proof_part2 (23 theorems, 1-32)
     page_proof_structure.ax — proof_part3 (50 theorems + F1, 35-91)
     page_proof_ai.ax       — proof_part3b (66 theorems, 92-157)
     page_proof_frontier.ax — proof_part3c (50 theorem groups, 158-222)
   Shared utilities in page_proof_helpers.ax.
   This file: index page, sub-page entry points, full-chain test harness. */

/* === INDEX PAGE (overview with navigation to sub-pages) === */
fn page_proof_index() = (
  dom_head_meta("description", "Proof Assistant: 189 theorems verified live by .ax. Navigate by category.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"name\":\"Proof Assistant\",\"description\":\"189 theorems verified live across 4 proof categories.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"url\":\"https://antonlebed.com/data/proof\"}");
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "60px 20px 24px");
  let h1 = dom_create("h1") in
  dom_text(h1, "Proof Assistant");
  ct_heading(h1);
  dom_style(h1, "fontSize", "32px");
  dom_style(h1, "marginBottom", "12px");
  dom_append(hero, h1);
  let sub = dom_create("p") in
  dom_text(sub, "GATE-channel guards the boundary. Every result computed live by .ax.");
  dom_style(sub, "color", "#aaa");
  dom_style(sub, "fontSize", "16px");
  dom_append(hero, sub);
  let sub2 = dom_create("p") in
  dom_text(sub2, "Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13");
  dom_style(sub2, "color", "#ffd700");
  dom_style(sub2, "fontSize", "14px");
  dom_style(sub2, "fontFamily", "Courier New, monospace");
  dom_append(hero, sub2);
  let sub3 = dom_create("p") in
  dom_text(sub3, "189 theorems + 1 falsification. 4 categories. Every check computed live.");
  dom_style(sub3, "color", "#666");
  dom_style(sub3, "fontSize", "12px");
  dom_style(sub3, "marginTop", "8px");
  dom_append(hero, sub3);
  dom_append(dom_body(), hero);

  /* Category cards */
  let grid = dom_create("div") in
  dom_style(grid, "maxWidth", "700px");
  dom_style(grid, "margin", "0 auto");
  dom_style(grid, "padding", "0 20px 40px");

  let c1 = dom_create("a") in
  dom_attr(c1, "href", "/data/proof_core");
  dom_style(c1, "display", "block");
  dom_style(c1, "textDecoration", "none");
  let c1b = dom_create("div") in
  ct_card(c1b);
  dom_style(c1b, "marginBottom", "16px");
  dom_style(c1b, "padding", "20px");
  dom_style(c1b, "borderLeft", "3px solid #ffd700");
  let c1t = dom_create("div") in
  dom_text(c1t, "Core Algebra");
  ct_gold(c1t);
  dom_style(c1t, "fontSize", "16px");
  dom_style(c1t, "marginBottom", "6px");
  dom_append(c1b, c1t);
  let c1d = dom_create("div") in
  dom_text(c1d, "23 theorems (1-32). CRT reconstruction, OMEGA, idempotents, chain, 490 split, coupling, power maps.");
  dom_style(c1d, "color", "#aaa");
  dom_style(c1d, "fontSize", "13px");
  dom_append(c1b, c1d);
  dom_append(c1, c1b);
  dom_append(grid, c1);

  let c2 = dom_create("a") in
  dom_attr(c2, "href", "/data/proof_structure");
  dom_style(c2, "display", "block");
  dom_style(c2, "textDecoration", "none");
  let c2b = dom_create("div") in
  ct_card(c2b);
  dom_style(c2b, "marginBottom", "16px");
  dom_style(c2b, "padding", "20px");
  dom_style(c2b, "borderLeft", "3px solid #44cc44");
  let c2t = dom_create("div") in
  dom_text(c2t, "Ring Structure");
  ct_gold(c2t);
  dom_style(c2t, "fontSize", "16px");
  dom_style(c2t, "marginBottom", "6px");
  dom_append(c2b, c2t);
  let c2d = dom_create("div") in
  dom_text(c2d, "50 theorems + F1 (35-91). Number theory, depth quadratic, balance, golden ratio, cyclotomic, Cunningham.");
  dom_style(c2d, "color", "#aaa");
  dom_style(c2d, "fontSize", "13px");
  dom_append(c2b, c2d);
  dom_append(c2, c2b);
  dom_append(grid, c2);

  let c3 = dom_create("a") in
  dom_attr(c3, "href", "/data/proof_ai");
  dom_style(c3, "display", "block");
  dom_style(c3, "textDecoration", "none");
  let c3b = dom_create("div") in
  ct_card(c3b);
  dom_style(c3b, "marginBottom", "16px");
  dom_style(c3b, "padding", "20px");
  dom_style(c3b, "borderLeft", "3px solid #4488ff");
  let c3t = dom_create("div") in
  dom_text(c3t, "AI & Coding Theory");
  ct_gold(c3t);
  dom_style(c3t, "fontSize", "16px");
  dom_style(c3t, "marginBottom", "6px");
  dom_append(c3b, c3t);
  let c3d = dom_create("div") in
  dom_text(c3d, "66 theorems (92-157). Meadow, hyperring, CRT prediction, ECC detection, Fano, Golay, Leech, Monster.");
  dom_style(c3d, "color", "#aaa");
  dom_style(c3d, "fontSize", "13px");
  dom_append(c3b, c3d);
  dom_append(c3, c3b);
  dom_append(grid, c3);

  let c4 = dom_create("a") in
  dom_attr(c4, "href", "/data/proof_frontier");
  dom_style(c4, "display", "block");
  dom_style(c4, "textDecoration", "none");
  let c4b = dom_create("div") in
  ct_card(c4b);
  dom_style(c4b, "marginBottom", "16px");
  dom_style(c4b, "padding", "20px");
  dom_style(c4b, "borderLeft", "3px solid #cc44cc");
  let c4t = dom_create("div") in
  dom_text(c4t, "Geometry & Dynamics");
  ct_gold(c4t);
  dom_style(c4t, "fontSize", "16px");
  dom_style(c4t, "marginBottom", "6px");
  dom_append(c4b, c4t);
  let c4d = dom_create("div") in
  dom_text(c4d, "50 theorem groups (158-222). Geometry, dynamics, coding theory, group orders, cross-ring structure.");
  dom_style(c4d, "color", "#aaa");
  dom_style(c4d, "fontSize", "13px");
  dom_append(c4b, c4d);
  dom_append(c4, c4b);
  dom_append(grid, c4);

  dom_append(dom_body(), grid)
)

/* === SUB-PAGE ENTRY POINTS === */

fn page_proof_core() = (
  set(_pf_mode, 0, 1);
  set(_pf_total, 0, 0); set(_pf_pass, 0, 0);
  pf_sub_hero("Core Algebra", "23 theorems", "CRT, OMEGA, idempotents, chain, coupling, power maps. Every result computed live.");
  let r = proof_part1() in
  proof_part2(r)
)

fn page_proof_structure() = (
  set(_pf_mode, 0, 1);
  set(_pf_total, 0, 0); set(_pf_pass, 0, 0);
  pf_sub_hero("Ring Structure", "50 theorems + F1", "Number theory, depth quadratic, balance, golden ratio, cyclotomic, Cunningham.");
  let r3 = alloc(1) in
  set(r3, 0, 0);
  proof_part3(r3)
)

fn page_proof_ai() = (
  set(_pf_mode, 0, 1);
  set(_pf_total, 0, 0); set(_pf_pass, 0, 0);
  pf_sub_hero("AI & Coding Theory", "66 theorems", "Meadow, hyperring, CRT prediction, ECC detection, Fano, Golay, Leech, Monster.");
  let r3b = alloc(1) in
  set(r3b, 0, 0);
  proof_part3b(r3b)
)

fn page_proof_frontier() = (
  set(_pf_mode, 0, 1);
  set(_pf_total, 0, 0); set(_pf_pass, 0, 0);
  pf_sub_hero("Geometry & Dynamics", "50 theorem groups", "Geometry, dynamics, coding theory, group orders, cross-ring structure. Every result computed live.");
  let r3c = alloc(1) in
  set(r3c, 0, 0);
  proof_part3c(r3c)
)

/* page_proof: Full theorem render (used by test harness). Chain mode. */
fn page_proof() = (
  dom_head_meta("description", "Live exhaustive verification of ring theorems in Z/12612600. Every result computed on page load by .ax.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Proof Assistant\",\"description\":\"189 theorems verified live in Z/12612600. Every result computed on page load by .ax.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"url\":\"https://antonlebed.com/data/proof\",\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Ring Verification\"},{\"@type\":\"DefinedTerm\",\"name\":\"Exhaustive Proof\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT Decomposition\"}]}");

  /* === HERO === */
  let hero = dom_create("section") in
  dom_style(hero, "textAlign", "center");
  dom_style(hero, "padding", "60px 20px 40px");
  let h1 = dom_create("h1") in
  dom_text(h1, "Proof Assistant");
  ct_heading(h1);
  dom_style(h1, "fontSize", "32px");
  dom_style(h1, "marginBottom", "12px");
  dom_append(hero, h1);
  let sub = dom_create("p") in
  dom_text(sub, "GATE-channel guards the boundary. Every result computed live by .ax.");
  dom_style(sub, "color", "#aaa");
  dom_style(sub, "fontSize", "16px");
  dom_append(hero, sub);
  let sub2 = dom_create("p") in
  dom_text(sub2, "Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13");
  dom_style(sub2, "color", "#ffd700");
  dom_style(sub2, "fontSize", "14px");
  dom_style(sub2, "fontFamily", "Courier New, monospace");
  dom_append(hero, sub2);
  let sub3 = dom_create("p") in
  dom_text(sub3, "189 theorems + 1 falsification. 10 towers. Every check computed live.");
  dom_style(sub3, "color", "#666");
  dom_style(sub3, "fontSize", "12px");
  dom_style(sub3, "marginTop", "8px");
  dom_append(hero, sub3);
  dom_append(dom_body(), hero);

  /* Compute theorems 1-6, then chain through part2->part3->part3b->part3c */
  set(_pf_mode, 0, 0);
  let r = proof_part1() in
  proof_part2(r)
)

/* END OF FILE */
