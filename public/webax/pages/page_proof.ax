  let mp33_d4 = 16 in
  let mp33_k2 = 9 in
  let mp33_e2 = 25 in
  let mp33_l = 11 in
  let mp33_g = 13 in
  let mp33_lat = 108 in
  let mp33_lambda = 420 in
  let mp33_min = 1225 in
  let mp33_max = 25225200 in
