  pf_result(sec25, "TRANS = 214414200", "8*9*25*49*11*13*17=${8*9*25*49*11*13*17}", if 8*9*25*49*11*13*17==214414200 then 1 else 0);

  let p25 = 1 + 1 + (if k_chain==1 then 1 else 0) + 1 + (if 17%7==3%7 then 1 else 0) + 1 + (if lam_trans/lam_thin==7 then 1 else 0) + 1 + 1 + (if 8*9*25*49*11*13*17==214414200 then 1 else 0) in
  pf_theorem(sec25, "EXPONENT CLASSIFICATION",
    "Z/7 GATE-cosets classify DEAD primes as fat (data carriers). Chain ordering resolves K (ALIVE but fat, chain member) and ESCAPE (thin, extension despite meta-residue = K). Lambda optimization gives specific exponents: D^3 (involutions), {K,E,b}^2 (resolution), {L,GATE,ESCAPE}^1 (ECC fields). Three-layer derivation: Z/7 + chain -> which fatten, lambda -> how much. Z/7 alone: 6/7 correct. K is the exact boundary. Proved S1366, 56/56 test_g3_exponents.ax.", p25, 10);
  dom_append(dom_body(), sec25);

