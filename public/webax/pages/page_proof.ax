  pf_result(sec32, "32768 = (D^K)^E = 8^5", "8*8*8*8*8 = ${8*8*8*8*8}", if 8*8*8*8*8 == 32768 then 1 else 0);
  pf_result(sec32, "TRANS has D^3 factor (fat); rad(TRANS) has D^1 (thin)", "214414200 mod 8 = ${214414200 % 8}", if 214414200 % 8 == 0 then 1 else 0);
  pf_result(sec32, "lambda(primorial(47)) = 1275120", "= 2^4*3^2*5*7*11*23", if pr32_lam == 16*9*5*7*11*23 then 1 else 0);
  pf_result(sec32, "lambda ratio p47/TRANS = 759 = K*L*23", "${pr32_ratio}", if pr32_ratio == 3*11*23 then 1 else 0);
  pf_result(sec32, "23 = c(L) = Cunningham bridge into summit", "2*11+1 = ${2*11+1}", if 2*11 + 1 == 23 then 1 else 0);
  let p32 = (if pr32_p15==15 then 1 else 0) + (if pr32_rad==510510 then 1 else 0) + (if 6==2*3 then 1 else 0) + (if 29+43==72 then 1 else 0) + (if 7-2==5 then 1 else 0) + (if pr32_part==4*3*7 then 1 else 0) + (if 6*6-6-1==29 then 1 else 0) + (if 2*21+1==43 then 1 else 0) + (if 2*23+1==47 then 1 else 0) + (if pr32_idem==32768 then 1 else 0) + (if 8*8*8*8*8==32768 then 1 else 0) + (if 214414200%8==0 then 1 else 0) + (if pr32_lam==16*9*5*7*11*23 then 1 else 0) + (if pr32_ratio==3*11*23 then 1 else 0) + (if 2*11+1==23 then 1 else 0) in
