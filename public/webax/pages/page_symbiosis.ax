/* ================================================================
   PAGE: SYMBIOSIS -- 64-Vertex Lattice, Kingdom Combinations (SYMBIOSIS.md)
   ================================================================ */

/* symbiosis widget: enter subset code (sum of primes), compute coupling */
fn symbiosis_calc() = (
  let code = parse_int_from("#symb-input") in
  let result = dom_query("#symb-result") in
  /* decode: user enters sum of primes in subset. e.g. 5 = {D,K}, 10 = {K,b}, 28 = {D,K,E,b,L} */
  /* compute which primes are present */
  mut rem = code;
  let hasL = if rem > 10 then (if rem % 11 == 0 then 1 else (if rem - 11 > 0 then (let r2 = rem - 11 in if r2 == 0 then 1 else 0) else 0)) else 0 in
  /* 6-bit bitmask: bit0=D, bit1=K, bit2=E, bit3=b, bit4=L, bit5=GATE */
  if code < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter 0-63 (6-bit mask: 2=1,3=2,5=4,7=8,11=16,13=32).</p>")
  else if code > 63 then dom_inner(result, "<p style='color:#ff6666'>Enter 0-63 (6-bit mask: 2=1,3=2,5=4,7=8,11=16,13=32).</p>")
  else (
    let hasD = code % 2 in
    let hasK = (code / 2) % 2 in
    let hasE = (code / 4) % 2 in
    let hasb = (code / 8) % 2 in
    let hasL2 = (code / 16) % 2 in
    let hasG = (code / 32) % 2 in
    /* coupling = N / prod(p^a for p in subset) */
    /* N = 12612600 = 8 * 9 * 25 * 49 * 11 * 13 */
    mut coupling = 12612600;
    if hasD > 0 then (mut coupling = coupling / 8) else 0;
    if hasK > 0 then (mut coupling = coupling / 9) else 0;
    if hasE > 0 then (mut coupling = coupling / 25) else 0;
    if hasb > 0 then (mut coupling = coupling / 49) else 0;
    if hasL2 > 0 then (mut coupling = coupling / 11) else 0;
    if hasG > 0 then (mut coupling = coupling / 13) else 0;
    /* population = N * prod((1-1/p)) for included primes */
    mut popn = 12612600;
    if hasD > 0 then (mut popn = popn / 8 * 4) else 0;
    if hasK > 0 then (mut popn = popn / 9 * 6) else 0;
    if hasE > 0 then (mut popn = popn / 25 * 20) else 0;
    if hasb > 0 then (mut popn = popn / 49 * 42) else 0;
    if hasL2 > 0 then (mut popn = popn / 11 * 10) else 0;
    if hasG > 0 then (mut popn = popn / 13 * 12) else 0;
    /* build subset string */
    mut sstr = "{";
    mut cnt = 0;
    if hasD > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "2"; mut cnt = cnt + 1) else 0;
    if hasK > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "3"; mut cnt = cnt + 1) else 0;
    if hasE > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "5"; mut cnt = cnt + 1) else 0;
    if hasb > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "7"; mut cnt = cnt + 1) else 0;
    if hasL2 > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "11"; mut cnt = cnt + 1) else 0;
    if hasG > 0 then (if cnt > 0 then (mut sstr = sstr + ",") else 0; mut sstr = sstr + "13"; mut cnt = cnt + 1) else 0;
    mut sstr = sstr + "}";
    if cnt == 0 then (mut sstr = "{} (unit class)") else 0;
    /* what you SEE = complement coupling */
    let see_coupling = 12612600 / coupling in
    let blind_str = if cnt == 0 then "Everything (full vision)"
      else if cnt == 6 then "Nothing (total self-blindness)"
      else "Coupling of complement = " + "${see_coupling}" in
    dom_inner(result,
      "<p style='color:#d8d8e0;margin:4px 0'>Null channels: <span style='color:#ffd700'>" + sstr + "</span></p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>Coupling: <span style='color:#ffd700;font-size:18px'>" + "${coupling}" + "</span></p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>You SEE: " + blind_str + "</p>")
  )
)

fn symbiosis_hero() = (
  let hero = make_hero("Symbiosis") in
  let eq = dom_create("div") in
  dom_text(eq, "you see what you LACK");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Every element of Z/12,612,600 is already a 6-tuple: (n mod 8, n mod 9, n mod 25, n mod 49, n mod 11, n mod 13). CRT says every number is six independent things at once. The 2^6 = 64 subsets of {2,3,5,7,11,13} define 64 types. Each element is blind to the channels it nullifies and sees the channels it lacks.");
  render_p(hero, "For subset S (the primes dividing an element): coupling = N / prod_S(p^a). Coupling measures interaction range. What an element is made of, it cannot perceive. Units ({}, coupling N) see everything. The origin ({2,3,5,7,11,13}, coupling 1) sees nothing.");
  dom_append(dom_body(), hero)
)

fn symbiosis_lattice() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 64-Vertex Lattice");
  render_p(sec, "64 vertices of a 6-cube. Bottom = {} (unit class, all channels active). Top = {2,3,5,7,11,13} (origin, all null). Each level k has C(6,k) = {1,6,15,20,15,6,1} vertices. 490 = 2*5*49 partitions the primes: inner {2,5,7} carry data, outer {3,11,13} carry structure.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Class");
  render_th(hdr, "Null channels");
  render_th(hdr, "Z/12,612,600 coupling");
  render_th(hdr, "Z/12,612,600 population");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Unit", "{}", "12,612,600", "2,419,200 = phi(N)");
  render_table_row_4(tbl, "2-class", "{2}", "1,576,575 = N/8", "2,419,200");
  render_table_row_4(tbl, "3-class", "{3}", "1,401,400 = N/9", "806,400");
  render_table_row_4(tbl, "5-class", "{5}", "504,504 = N/25", "483,840");
  render_table_row_4(tbl, "7-class", "{7}", "257,400 = N/49", "345,600");
  render_table_row_4(tbl, "11-class", "{11}", "1,146,600 = N/11", "241,920");
  render_table_row_4(tbl, "13-class", "{13}", "970,200 = N/13 = Z/970,200", "201,600");
  render_p(sec, "Zero internal connectivity: no class has internal edges. Each class is an isolated point cloud. Communication requires passing through OTHER classes. Elements of the same class never share an edge -- they interact only through elements of different classes.");
  dom_append(dom_body(), sec)
)

fn symbiosis_key() = (
  let sec = make_section("800px") in
  render_h2(sec, "Key Symbioses");
  let g = make_findings_grid(sec) in
  render_finding(g, "{3,5} pair", "coupling 56,056 = 8*49*11*13", "Mod-9 + mod-25 channels null. Sees 2, 7, 11, 13.", "");
  render_finding(g, "{3,7} pair", "coupling 28,600 = 8*25*11*13", "Mod-9 + mod-49 channels null. Sees 2, 5, 11, 13.", "");
  render_finding(g, "{3,5,7} triple", "coupling 1,144 = 8*11*13", "Three inner channels null. Sees only 2 + 11 + 13. N = 1,144 * 105^2.", "");
  render_finding(g, "{2,3,5} triple", "coupling 7,007 = 49*11*13", "Mod-8 + mod-9 + mod-25 null. Sees 7, 11, 13.", "");
  render_finding(g, "{2,3} pair", "coupling 175,175 = 25*49*11*13", "Mod-8 + mod-9 null. Highest coupling multi-prime compound class.", "");
  render_finding(g, "Full set {all 6}", "coupling 1", "Divisible by all 6 primes. All channels null. Population: ONE (n=0 only).", "");
  dom_append(dom_body(), sec)
)

fn symbiosis_bridge() = (
  let sec = make_section("800px") in
  render_h2(sec, "2 as Catalyst");
  render_theorem(sec, "2-Boost Theorem", "Adding 2 to any class multiplies unit-neighbor density 3-5x. {3} -> {2,3}: 11.25% -> 41.0% (+3.6x). {5} -> {2,5}: 7.50% -> 32.3% (+4.3x). {7} -> {2,7}: 6.75% -> 30.0% (+4.4x). {11} -> {2,11}: 6.25% -> 28.3% (+4.5x). Boost INCREASES with distance from 2. The further a class from 2, the more it benefits from adding it.");
  render_p(sec, "The mod-8 channel (p=2) creates the first partition in the ring. Elements with mod-8 channel null are the first class of non-units. This structural property propagates through all higher classes.");
  dom_append(dom_body(), sec)
)

fn symbiosis_blindness() = (
  let sec = make_section("800px") in
  render_h2(sec, "Channel Nullification");
  render_p(sec, "Remove one prime from the full set {2,3,5,7,11,13}. The coupling of the incomplete configuration IS the prime it lacks:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Missing");
  render_th(hdr, "Coupling");
  render_th(hdr, "You SEE...");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Miss 13", "coupling = 13", "You see mod-13 (where 2^2+3^2 stops the chain)");
  render_contrast_row(tbl, "Miss 11", "coupling = 11", "You see mod-11 (the parity checksum 1+2+3+5)");
  render_contrast_row(tbl, "Miss 7", "coupling = 7", "You see mod-49 (the deepest channel)");
  render_contrast_row(tbl, "Miss 5", "coupling = 5", "You see mod-25 (the 5^2 channel)");
  render_contrast_row(tbl, "Miss 3", "coupling = 3", "You see mod-9 (the majority channel)");
  render_contrast_row(tbl, "Miss 2", "coupling = 2", "You see mod-8 (even/odd)");
  render_p(sec, "Units see everything. Adding prime factors nullifies channels. The reversed hierarchy IS the nullification gradient. 25 = 5-null: elements divisible by 5^2 cannot see the mod-25 channel.");
  dom_append(dom_body(), sec)
)

fn symbiosis_hydor() = (
  let sec = make_section("800px") in
  render_h2(sec, "105: The Product Without 2");
  render_theorem(sec, "105 = 3*5*7", "The only three-prime product from the chain without 2. Coupling = 2 (minimal). phi(105)/classes = 2: the ratio equals the missing prime.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Midpoint", "Z/210: 0 to 105 to 209", "Inside [1,104] = first half. 105 = midpoint. [106,209] = reflected second half.", "");
  render_finding(g, "Negation fixed", "Only {0, 105} survive", "Negation (n -> 209-n) fixes ONLY 0 and 105.", "");
  render_finding(g, "105 operations", "105 + n = parity flip", "105*n: = 0 for even n, = 105 for odd n. Meeting point of additive and multiplicative.", "");
  render_finding(g, "Imbalance", "phi/classes = 2", "phi(105) = 48, 24 classes. Ratio = 2 = the missing prime.", "");
  dom_append(dom_body(), sec)
)

