  let sec = make_section("800px") in
  render_h2(sec, "Channel Properties");
  render_p(sec, "The 6 primes have distinct algebraic properties. 490 = 2*5*49 partitions them into inner (data) and outer (structure) channels:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "Modulus");
  render_th(hdr, "Position");
  render_th(hdr, "Property");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "8", "Inner", "Even/odd. Only even prime. mod 8 = fastest channel.");
  render_table_row_4(tbl, "3", "9", "Outer", "Majority threshold. Minimum for decomposition.");
  render_table_row_4(tbl, "5", "25", "Inner", "5^2 divides ring, 5 doesn't divide 24.");
  render_table_row_4(tbl, "7", "49", "Inner", "Deepest channel. 49 states = finest resolution.");
  render_table_row_4(tbl, "11", "11", "Outer", "Error detection. 1+2+3+5 = 11, parity checksum.");
  render_table_row_4(tbl, "13", "13", "Outer", "Chain stops here. 2^2+3^2 = 13.");
  render_p(sec, "105 = 3*5*7. The inner channels {2,5,7} carry data. The outer channels {3,11,13} carry structure. 490 = 2*5*49 cleaves the 6 channels into exactly 2 halves.");
  dom_append(dom_body(), sec)
)

fn symbiosis_sponge() = (
  let sec = make_section("800px") in
  render_h2(sec, "Sponge Topology");
  render_theorem(sec, "Sponge Decomposition", "Z/12,612,600: 420 components, 480 units each. 420 = 4*3*5*7 = 2*210. Each component isomorphic to the prime-modulus sponge. Raising exponents tiles, not breaks.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Diameter", "18 = 1+2+3+5+7", "Distance from identity to mirror = 18 steps. INVARIANT under raising exponents (21/21 rings verified).", "");
  render_finding(g, "Betti numbers", "ALL PRIME", "Level 3: beta_1 = 3. Level 4: beta_1 = 53 (prime). Level 5: beta_1 = 953 (prime). Cycle rank at Z/210 = totality.", "");
  render_finding(g, "Meta-ring", "Z/420 = 2 * 210", "420 components indexed by Z/4 x Z/3 x Z/5 x Z/7. 11 absent: the parity-check prime doesn't fragment. Only data primes create components.", "");
  render_finding(g, "Identity-mirror", "Separated by raising exponents", "In Z/2,310: identity and mirror touch (distance 18). ANY prime-power upgrade separates them into different components.", "");
  render_finding(g, "Descent depth", "3 levels", "Z/12,612,600 -> 420 components -> 2 -> 1. Three steps to decompose the ring completely.", "");
  dom_append(dom_body(), sec)
)

