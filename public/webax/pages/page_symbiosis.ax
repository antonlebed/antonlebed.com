  let sec = make_section("800px") in
  render_h2(sec, "Key Symbioses");
  let g = make_findings_grid(sec) in
  render_finding(g, "{3,5} pair", "coupling 56,056 = 8*49*11*13", "Closure + observation channels null. Sees 2 + 7 + 11 + 13. Second-level compound class.", "");
  render_finding(g, "{3,7} pair", "coupling 28,600 = 8*25*11*13", "Closure + depth channels null. Sees 2 + 5 + 11 + 13. Third-level compound class.", "");
  render_finding(g, "{3,5,7} triple", "coupling 1,144 = 8*11*13", "Three inner channels null. Sees only 2 + 11 + 13. N = 1,144 * 105^2.", "");
  render_finding(g, "{2,3,5} triple", "coupling 7,007 = 49*11*13", "Bridge + closure + observation null. Sees 7 + 11 + 13.", "");
  render_finding(g, "{2,3} pair", "coupling 175,175 = 25*49*11*13", "Bridge + closure null. Highest coupling multi-prime compound class.", "");
  render_finding(g, "Full set {all 6}", "coupling 1", "IS everything. SEES nothing. Total self-reference = total blindness. Population: ONE (n=0 only). Always.", "");
  dom_append(dom_body(), sec)
)

fn symbiosis_bridge() = (
  let sec = make_section("800px") in
  render_h2(sec, "2 as Bridge: The Symbiosis Catalyst");
  render_theorem(sec, "2-Boost Theorem", "Adding 2 to any kingdom multiplies unit-neighbor density 3-5x. {3} -> {2,3}: 11.25% -> 41.0% (+3.6x). {5} -> {2,5}: 7.50% -> 32.3% (+4.3x). {7} -> {2,7}: 6.75% -> 30.0% (+4.4x). {11} -> {2,11}: 6.25% -> 28.3% (+4.5x). Boost INCREASES with distance from 2. The further a kingdom from duality, the more it benefits from adding it.");
  render_p(sec, "The mod-8 channel (p=2) creates the first boundary in the ring. Elements with mod-8 channel null are the first class of non-units. This boundary property propagates through all higher classes.");
  dom_append(dom_body(), sec)
)

