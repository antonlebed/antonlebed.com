  let sec = make_section("800px") in
  render_h2(sec, "105: The Medium Without Duality");
  render_theorem(sec, "105 = 3*5*7", "The only major product without 2. Where 2 vanishes = pure figure, no ground = the vacuum axis. 105 IS the boundary between emission and return. Coupling = 2 (minimal encoding, holographic). phi(105)/classes = 2: the ratio IS the missing prime.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Solar sink", "ORIGIN(0) to 105 to Z/210(209)", "Inside [1,104] = emission. 105 = boundary. Outside [106,209] = reflected return. Coupling asymmetry: inside - outside = 1.", "");
  render_finding(g, "Negation fixed", "Only {0, 105} survive", "Negation (209) fixes ONLY origin and medium. They survive everything.", "");
  render_finding(g, "105 operations", "105 + n = parity flip", "105*n: = 0 for even n, = 105 for odd n. Meeting point of additive and multiplicative.", "");
  render_finding(g, "Imbalance", "phi/classes = 2", "Without membrane to organize perception, action overflows observation. Acts without reflection.", "");
  dom_append(dom_body(), sec)
)

