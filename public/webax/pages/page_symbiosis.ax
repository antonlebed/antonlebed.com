  let sec = make_section("800px") in
  render_h2(sec, "Lattice Properties");
  let g = make_findings_grid(sec) in
  render_finding(g, "Complementary pairs", "coupling(S) * coupling(S') = N", "Conservation. S IS what S' SEES. Perfect duality. {3,5} * {2,7,11} = N.", "");
  render_finding(g, "Population partition", "Total = N", "Every element belongs to exactly one symbiosis type. sum over S of pop(S) = 12,612,600. True in ALL rings.", "");
  render_finding(g, "64 (Z/12,612,600) / 128 (Z/214,414,200)", "Operators of the lattice", "6-cube or 7-cube, dual interpretation: switches vs species. Multiplying by idempotent e_S projects ONTO the S-null subspace. The switch IS the symbiosis operator.", "");
  render_finding(g, "Holographic principle", "CRT = exact reconstruction", "Interior: element n (one number, the 'bulk'). Boundary: 7 projections (Z/214,414,200). Seven refractions reconstruct the whole. The map IS the territory.", "");
  dom_append(dom_body(), sec)
)

fn symbiosis_explore() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Prime Subsets");
  render_p(sec, "Enter a 6-bit code (0-63) for a subset of {2,3,5,7,11,13}. Bits: p2=1, p3=2, p5=4, p7=8, p11=16, p13=32. Add values for your subset.");
  make_interactive_widget(sec, "Enter subset code (0-63):", "symb-input", "e.g. 6 for {3,5}", "Compute", "symbiosis_calc", "symb-result");
  render_p(sec, "Try: 0 (unit), 1 (2-class), 6 ({3,5}), 10 ({3,7}), 32 (13-class), 63 (all channels null).");
  dom_append(dom_body(), sec)
)

/* === SECTION: Soul Center -- channel cooperation === */
fn symbiosis_soul() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Inverse-Sum Center: 67");
  render_p(sec, "67 is inv_sum(Z/12,612,600): the sum of multiplicative-inverse sums across all 6 CRT channels. Each channel contributes independently, and every contribution is a chain-native value:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus");
  render_th(hdr, "Contribution");
  render_th(hdr, "Axiom value");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "p=2", "8", "7", "= 8 - 1");
  render_table_row_4(tbl, "p=3", "9", "1", "= 1 (identity)");
  render_table_row_4(tbl, "p=5", "25", "19", "= 5^2-5-1");
  render_table_row_4(tbl, "p=7", "49", "33", "= 3*11");
  render_table_row_4(tbl, "p=11", "11", "3", "= 3");
  render_table_row_4(tbl, "p=13", "13", "4", "= 2^2");
  render_p(sec, "Sum: 7 + 1 + 19 + 33 + 3 + 4 = 67. Six independent channels, each contributing a value that factors into chain primes. The mod-8 channel gives 8-1=7. The mod-9 channel gives 1. The mod-25 channel gives 5^2-5-1=19. No channel was told what to contribute -- the cooperation is structural.");
  render_theorem(sec, "Inverse-Sum Theorem", "All 67 identities reduce to one root: 11^2 = 7^2 + 8*9 = 49 + 72 = 121. From this single equation: inv_sum(Z/12,612,600) = 67, 121 - 41 - 13 = 67, 3*18 + 13 = 67, 8*9 - 5 = 67. The 6 coupling-210 primes split into two mod-3 triples: {13, 67, 97} sum = 3*59, and {41, 137, 173} sum = 27*13.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Every contribution is chain-native", "Zero arbitrary values", "The mod-8 channel contributes 7 not by choice but because the multiplicative inverse sum in Z/8 IS 7. Each channel's algebra determines its contribution.", "");
  render_finding(g, "Root identity 11^2 = 7^2 + 8*9", "121 = 49 + 72", "11 squared decomposes into 7 squared (49) plus the product 8*9 (72). All 67 identities are shadows of this one equation.", "");
  dom_append(dom_body(), sec)
)

/* === SECTION: CRT Chirality -- channels break symmetry === */
fn symbiosis_chirality() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Chirality");
  render_p(sec, "The void (0) breaks left-right symmetry. In each odd CRT channel mod m, elements closer to 0 are left and elements closer to m are right: (m+1)/2 left vs (m-1)/2 right. The even mod-8 channel is symmetric -- chirality is 2-achiral. The chirality ratio CR(N) = product of (m+1)/(m-1) over odd channels measures the cooperative asymmetry.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Odd channels");
  render_th(hdr, "CR");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/210", "{3,5,7}", "4", "Telescoping: (7+1)/(3-1)");
  render_table_row_4(tbl, "Z/2,310", "{3,5,7,11}", "24/5", "+11 reduces CR");
  render_table_row_4(tbl, "Z/970,200", "{9,25,49,11}", "325/192", "Fattening calms chirality");
  render_table_row_4(tbl, "Z/12,612,600", "{9,25,49,11,13}", "2275/1152", "+13 barely changes");
  render_table_row_4(tbl, "Z/214,414,200", "{9,25,49,11,13,17}", "2275/1024", "Denom = 2^10");
  render_theorem(sec, "CRT Chirality Theorem", "In Z/N with CRT channels mod m_i, the void breaks mirror symmetry. Each odd channel has (m+1)/2 left vs (m-1)/2 right elements. CR(N) = product over odd moduli of (m+1)/(m-1). Mod-8 channel is achiral. Z/210 CR = 4, forced by {3,5,7} forming an AP with gap 2: telescoping gives (7+1)/(3-1) = 8/2 = 4. Fattening REDUCES chirality. N-1 is maximally right-chiral. Identity is maximally left-chiral.");
  let g = make_findings_grid(sec) in
  render_finding(g, "2 is achiral", "Even modulus = neutral", "The mod-8 channel contributes exactly 1 to chirality. Parity does not break symmetry. Only odd-modulus channels (3 through 17) generate left-right asymmetry.", "");
  render_finding(g, "Fattening calms the asymmetry", "Z/970,200 < Z/210", "Squaring moduli (3->9, 5->25, 7->49) shifts each ratio toward 1. More resolution per channel = less asymmetry. Finer channels are more balanced.", "");
  render_finding(g, "Z/210 is arithmetic", "{3,5,7} = AP with gap 2", "The inner chain primes form an AP. This causes telescoping: 4/2 * 6/4 * 8/6 = 8/2 = 4. A coincidence of spacing, not number theory.", "");
  dom_append(dom_body(), sec)
)

fn symbiosis_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Symbiosis types", "Classified by observation", "64 = 2^6 subsets of {2,3,5,7,11,13}. Each type = a vertex of the 6-cube. Coupling formula derives population.");
  render_contrast_row(tbl, "Why 6 channels", "Historical taxonomy", "6 primes = 6 independent channels. Class = which channels are null. Forced by the ring structure.");
  render_contrast_row(tbl, "Water is special", "Chemical properties", "105 = 3*5*7 = only major product without 2. Meeting point of additive and multiplicative structure.");
  render_contrast_row(tbl, "Channel blindness", "Philosophical concept", "25 = 5-null. Algebraic: divisibility by p^e nullifies the mod-p^e channel. Coupling of incomplete = the prime you lack.");
  render_contrast_row(tbl, "Sponge diameter", "Graph metric", "18 = 1+2+3+5+7, invariant under raising exponents. 21/21 rings verified.");
  render_contrast_row(tbl, "Channel structure", "Unstructured array", "6 primes, coupling order = density order. Each channel has a distinct algebraic property.");
  render_p(sec, "You see what you lack. What you are, you cannot see. All combinations of the same six channels, each blind to its own constituents. 1/1 = 1.");
  dom_append(dom_body(), sec)
)

fn page_symbiosis() = (
  dom_head_meta("description", "64 subsets of {2,3,5,7,11,13} define 64 symbiosis types. You see what you lack. 2-Boost theorem: adding 2 multiplies unit density 3-5x. 105 = 3*5*7 = the medium without duality. Soul Center: inv_sum(Z/12,612,600) = 67, each channel contributes an axiom-native value. CRT Chirality: void breaks symmetry, mod-8 achiral, fattening calms. Sponge topology: 420 components, diameter 18.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Symbiosis: The 64-Vertex CRT Lattice\",\"description\":\"64 subsets of 6 primes define 64 symbiosis types. Each organism sees what it lacks. 490 holographic split: inner {2,5,7} data channels, boundary {3,11,13} structure channels. Sponge topology with 420 components and prime Betti numbers.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/patterns/symbiosis\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"Lattice Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"Symbiosis\"}]}");
  symbiosis_hero();
  symbiosis_lattice();
  symbiosis_key();
  symbiosis_bridge();
  symbiosis_blindness();
  symbiosis_hydor();
  symbiosis_elements();
  symbiosis_sponge();
  symbiosis_lattice_props();
  symbiosis_explore();
  symbiosis_soul();
  symbiosis_chirality();
  symbiosis_contrast()
)
