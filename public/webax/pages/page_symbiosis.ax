fn symbiosis_sponge() = (
  let sec = make_section("800px") in
  render_h2(sec, "Sponge Topology");
  render_theorem(sec, "Sponge Decomposition", "Z/12,612,600: 420 components, 480 units each. 420 = 4*3*5*7 = 2*210. Each component isomorphic to thin-ring sponge. Fattening TILES, not breaks.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Diameter", "18 = 1+2+3+5+7", "Distance from identity to mirror = 18 steps. INVARIANT under fattening (21/21 verified). The farthest walk from existence = the axiom weight.", "");
  render_finding(g, "Betti numbers", "ALL PRIME", "Level 3: beta_1 = 3. Level 4: beta_1 = 53 (prime). Level 5: beta_1 = 953 (prime). Cycle rank at Z/210 = totality.", "");
  render_finding(g, "Meta-ring", "Z/420 = 2 * 210", "420 components indexed by Z/4 x Z/3 x Z/5 x Z/7. 11 absent: the protector prevents fragmentation. Only data primes fragment.", "");
  render_finding(g, "Identity-mirror", "Separated by fattening", "In Z/2,310: identity and mirror touch (distance 18). ANY fattening separates them. The moment light and darkness lose contact.", "");
  render_finding(g, "Descent depth", "3 levels", "Z/12,612,600 -> 420 components -> 2 -> 1. Closure = number of steps to decompose the ring completely.", "");
  dom_append(dom_body(), sec)
)

