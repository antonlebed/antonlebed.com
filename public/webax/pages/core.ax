)

fn page_basics_index() = (
  dom_head_meta("description", "Start here. Modular arithmetic, the Chinese Remainder Theorem, and how 214,414,200 splits into 7 independent channels. Eight pages from first principles.");
  idx_hero("Basics", "Z/6", "The foundation. What modular arithmetic is, how CRT works, and why 214,414,200 splits into seven independent channels.");
  idx_intro("New here? Start with Numbers & Clocks -- it introduces modular arithmetic from scratch. Then What is CRT? shows the decomposition that everything else builds on.");
  let g = idx_grid() in
  reg_render_section_grouped(g, "basics")
)

fn page_connections_index() = (
  dom_head_meta("description", "Where the ring meets the world. Turbulence, sleep cycles, error correction, DNA codons, chemistry, dark energy, braid theory, modular forms, and more.");
  idx_hero("Connections", "Z/210", "Where the ring meets other fields. Each page applies CRT decomposition to a different domain and asks what structure survives.");
  idx_intro("ECC shows error correction emerging from the ring for free. Turbulence shows the 5/3 law appearing in prime balance factors. Both are short and self-contained.");
  let g = idx_grid() in
  reg_render_section_grouped(g, "connections")
)

fn page_theory_index() = (
  dom_head_meta("description", "Number theory proofs. Cunningham chains, Heegner numbers, golden ratio, lambda periodicity, Catalan gap, and 19 more. All proved, all verifiable.");
  idx_hero("Theory", "Z/2,310", "Formal number theory. Every theorem proved, every claim testable. 24 results from Cunningham chains to cyclotomic-Fibonacci.");
  idx_intro("Cunningham Chains derives the six primes from one. The Catalan Gap explains why the chain stops at 3^2 - 2^3 = 1. Both are short and self-contained.");
  let g = idx_grid() in
  reg_render_section_grouped(g, "theory")
)

fn page_ideas_index() = (
  dom_head_meta("description", "What the ring means. The bootstrap, the septum, the mirror, sacrifice, duality, depth, transcendence. 12 pages on the ring's deeper structure.");
  idx_hero("Ideas", "Z/970,200", "What the ring means. Its self-referential structure, the role of each prime, and where the structure leads.");
  idx_intro("The Bootstrap explains why the ring's structure is self-generating. Duality explains why 2 -- the only even prime -- drives the chain.");
  let g = idx_grid() in
  reg_render_section_grouped(g, "ideas")
)

fn page_lab_index() = (
  dom_head_meta("description", "Build and experiment. Self-hosting .ax compiler, CRT training neural net, error correction, games, proof assistant, 8 AI experiments. All interactive.");
  idx_hero("Lab", "Z/12,612,600", "Build and experiment. The compiler, the training ground, the proof assistant, the games. Everything here runs live in your browser.");
  idx_intro("Try Ouroboros to compile .ax code in your browser. CRT Anatomy lets you decompose any number into seven channels interactively.");
