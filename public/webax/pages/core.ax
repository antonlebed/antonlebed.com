fn render_theorem(parent, title:str, body_text:str) = (
  let card = dom_create("div") in
  ct_card(card);
  dom_style(card, "marginBottom", "16px");
  let t = dom_create("div") in
  dom_text(t, title);
  dom_style(t, "fontSize", "14px");
  ct_gold(t);
  dom_style(t, "textTransform", "uppercase");
  dom_style(t, "letterSpacing", "2px");
  dom_style(t, "marginBottom", "12px");
  dom_append(card, t);
  let bd = dom_create("div") in
  dom_text(bd, body_text);
  dom_style(bd, "fontSize", "15px");
  dom_style(bd, "color", "#aaa");
  dom_style(bd, "lineHeight", "1.8");
  dom_append(card, bd);
  dom_append(parent, card)
)

