/* core.ax -- K-channel: the closure engine.
   Shared infrastructure for all 141 pages. K=3 pipeline: register -> render -> output.
   Celestial theatre (starfield, moon, clouds, wave), nav, page registry,
   search, render components, index pages, footer. Every page includes this. */

/* S1239: raw_mode dissolves ring_mod bug. All site arithmetic is plain i32.
   Ring operations use explicit % N_TRUE (already done in all CRT code).
   Without this: compiler wraps ALL mul/add/sub with % 12612600,
   breaking general-purpose arithmetic (25740*490 -> 0). */
raw_mode(1)

/* js_alloc: exported wrapper for alloc(). Lets the JS host allocate WASM memory
   for get_hash/dom_value/get_category buffers at init time. */
fn js_alloc(n) = alloc(n)

/* ===== DECALITY CONSTANTS ===== */
let D = 2
let K = 3
let E = 5
let b = 7
let L = 11
let GATE = 13
let ESCAPE = 17
let N_TRUE = 12612600
let N_TRANS = 214414200
let N_DEEP = 970200
let OMEGA_VAL = 1576576
let OMEGA_TRANS = 26801776
let LAMBDA_VAL = 420
let LAMBDA_TRANS = 1680
/* CRT moduli: Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 (x Z/17 for TRANS) */
let CRT_Q0 = 8
let CRT_Q1 = 9
let CRT_Q2 = 25
let CRT_Q3 = 49
let CRT_Q4 = 11
let CRT_Q5 = 13
let CRT_Q6 = 17
/* CRT moduli arrays: SSOT for decomposition loops (S2011).
   CRT_MODS = 6-channel TRUE [8,9,25,49,11,13]. CRT_MODS_TRANS = 7-channel TRANS [+17]. */
let CRT_MODS = [8, 9, 25, 49, 11, 13]
let CRT_MODS_TRANS = [8, 9, 25, 49, 11, 13, 17]
/* CRT lifting idempotents for Z/12612600 (TRUE ring, canonical S1180).
   e_p * n mod N_TRUE extracts the p-channel contribution of n. */
let CRT_ED = 11036025
let CRT_EK = 1401400
let CRT_EE = 9585576
let CRT_EB = 8494200
let CRT_EL = 3439800
let CRT_EG = 3880800
/* Channel colors: D=gold, K=orange, E=green, b=blue, L=purple, GATE=red, ESCAPE=cyan */
let CLR_D = "#ffd700"
let CLR_K = "#ff9900"
let CLR_E = "#33dd55"
let CLR_b = "#4488ff"
let CLR_L = "#aa44ff"
let CLR_G = "#ff4466"
let CLR_17 = "#00dddd"
let CLR_GOLD = "#ffd700"
let CLR_DIM = "#aaa"

/* CRT RECONSTRUCTION — SSOT (S2010). All CRT reconstruction goes through these functions.
   ring_recon: 6 residues -> TRUE ring element. The ONE place where idempotent formula lives.
   ring_recon_data: 4 data-channel residues -> partial TRUE element (for ECC checks).
   ring_recon_trans: 7 residues -> TRANS ring element (two-level: TRUE + ESCAPE lift).
   Max per-term: 48*8494200=407M. Sum of 6 < 808M < i32 max (2147M). Safe. */
fn ring_recon(rd, rk, re, rb, rl, rg) =
  (rd * CRT_ED + rk * CRT_EK + re * CRT_EE + rb * CRT_EB + rl * CRT_EL + rg * CRT_EG) % N_TRUE

/* Reconstruct from 4 data channels only (D,K,E,b). For ECC: compare result % 11 vs L, % 13 vs GATE.
   Returns value mod N_TRUE. Max raw sum ~440M < i32 max. */
fn ring_recon_data(rd, rk, re, rb) =
  (rd * CRT_ED + rk * CRT_EK + re * CRT_EE + rb * CRT_EB) % N_TRUE

/* TRANS ring two-level CRT reconstruction: 7 channel residues -> element of Z/214414200.
   Step 1: reconstruct TRUE value from channels 0-5.
   Step 2: lift to TRANS via ESCAPE channel (inv(12612600 mod 17, 17) = inv(11,17) = 14).
   Max intermediate: 12612599 + 12612600*16 = 214414199 < 2^31. Safe i32. */
fn ring_recon_trans(rd, rk, re, rb, rl, rg, r17) = (
  let xt = ring_recon(rd, rk, re, rb, rl, rg) in
  xt + N_TRUE * ((r17 + 17 - xt % 17) % 17 * 14 % 17)
)

/* Ring multiply via CRT: safe for any a,b (no i32 overflow).
   Per-channel max: 48*48=2304. Reconstruction via ring_recon. */
fn ring_mul(a, b) = (
  let d = (a%8)*(b%8)%8 in
  let k = (a%9)*(b%9)%9 in
  let e = (a%25)*(b%25)%25 in
  let bb = (a%49)*(b%49)%49 in
  let l = (a%11)*(b%11)%11 in
  let g = (a%13)*(b%13)%13 in
  ring_recon(d, k, e, bb, l, g)
)

/* TRANS ring multiply: 7-channel CRT multiply in Z/214414200. */
fn ring_mul_trans(a, b) = (
  let d = (a%8)*(b%8)%8 in
  let k = (a%9)*(b%9)%9 in
  let e = (a%25)*(b%25)%25 in
  let bb = (a%49)*(b%49)%49 in
  let l = (a%11)*(b%11)%11 in
  let g = (a%13)*(b%13)%13 in
  let r17 = (a%17)*(b%17)%17 in
  ring_recon_trans(d, k, e, bb, l, g, r17)
)

/* ================================================================
   RING MATH — .ax SSOT (U2.4 split-brain dissolution, S1822)
   coupling, kingdom, mirror, crt_r, eigenvalue as pure .ax.
   Replaces game imports from JS. Stdlib = sole API.
   All use N_TRANS = 214414200, 7 channels.
   ================================================================ */

fn _gcd(a, b) = if b == 0 then a else _gcd(b, a % b)

fn coupling(n) = (
  let nn = ((n % N_TRANS) + N_TRANS) % N_TRANS in
  if nn == 0 then 1
  else N_TRANS / _gcd(nn, N_TRANS)
)

fn kingdom(n) = (
  let nn = ((n % N_TRANS) + N_TRANS) % N_TRANS in
  if nn == 0 then 0
  else if nn % 2 == 0 then 2
  else if nn % 3 == 0 then 3
  else if nn % 5 == 0 then 5
  else if nn % 7 == 0 then 7
  else if nn % 11 == 0 then 11
  else if nn % 13 == 0 then 13
  else if nn % 17 == 0 then 17
  else 1
)

fn mirror(n) = (
  let nn = ((n % N_TRANS) + N_TRANS) % N_TRANS in
  (N_TRANS - nn) % N_TRANS
)

fn crt_r(n, c) = (
  let nn = ((n % N_TRANS) + N_TRANS) % N_TRANS in
  if c == 0 then nn % 8
  else if c == 1 then nn % 9
  else if c == 2 then nn % 25
  else if c == 3 then nn % 49
  else if c == 4 then nn % 11
  else if c == 5 then nn % 13
  else nn % 17
)

/* Eigenvalue: sum of 2*cos(2*pi*(n%q)/q) over 7 channels, x1000.
   Precomputed cos tables at x2000000 precision, symmetry-folded.
   Final sum /1000 with rounding matches JS Math.round(t*1000). */
fn _evc8(k) = (
  let k2 = if k > 4 then 8 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1414214
  else if k2 == 2 then 0 else if k2 == 3 then -1414214 else -2000000
)
fn _evc9(k) = (
  let k2 = if k > 4 then 9 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1532089
  else if k2 == 2 then 347296 else if k2 == 3 then -1000000 else -1879385
)
fn _evc25(k) = (
  let k2 = if k > 12 then 25 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1937166
  else if k2 == 2 then 1752613 else if k2 == 3 then 1457937
  else if k2 == 4 then 1071654 else if k2 == 5 then 618034
  else if k2 == 6 then 125581 else if k2 == 7 then -374763
  else if k2 == 8 then -851559 else if k2 == 9 then -1274848
  else if k2 == 10 then -1618034 else if k2 == 11 then -1859553 else -1984229
)
fn _evc49(k) = (
  let k2 = if k > 24 then 49 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1983580
  else if k2 == 2 then 1934590 else if k2 == 3 then 1853834
  else if k2 == 4 then 1742637 else if k2 == 5 then 1602827
  else if k2 == 6 then 1436699 else if k2 == 7 then 1246980
  else if k2 == 8 then 1036785 else if k2 == 9 then 809567
  else if k2 == 10 then 569055 else if k2 == 11 then 319200
  else if k2 == 12 then 64103 else if k2 == 13 then -192046
  else if k2 == 14 then -445042 else if k2 == 15 then -690730
  else if k2 == 16 then -925077 else if k2 == 17 then -1144233
  else if k2 == 18 then -1344602 else if k2 == 19 then -1522892
  else if k2 == 20 then -1676176 else if k2 == 21 then -1801938
  else if k2 == 22 then -1898111 else if k2 == 23 then -1963118 else -1995891
)
fn _evc11(k) = (
  let k2 = if k > 5 then 11 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1682507
  else if k2 == 2 then 830830 else if k2 == 3 then -284630
  else if k2 == 4 then -1309721 else -1918986
)
fn _evc13(k) = (
  let k2 = if k > 6 then 13 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1770912
  else if k2 == 2 then 1136129 else if k2 == 3 then 241073
  else if k2 == 4 then -709210 else if k2 == 5 then -1497021 else -1941884
)
fn _evc17(k) = (
  let k2 = if k > 8 then 17 - k else k in
  if k2 == 0 then 2000000 else if k2 == 1 then 1864944
  else if k2 == 2 then 1478018 else if k2 == 3 then 891477
  else if k2 == 4 then 184537 else if k2 == 5 then -547326
  else if k2 == 6 then -1205269 else if k2 == 7 then -1700434 else -1965946
)

fn eigenvalue(n) = (
  let nn = ((n % N_TRANS) + N_TRANS) % N_TRANS in
  let ev_sum = _evc8(nn%8) + _evc9(nn%9) + _evc25(nn%25) + _evc49(nn%49) + _evc11(nn%11) + _evc13(nn%13) + _evc17(nn%17) in
  (ev_sum + (if ev_sum >= 0 then 500 else 0 - 500)) / 1000
)

/* ================================================================
   CELESTIAL THEATRE -- CSS Keyframe Generation
   Generate all CSS from structured .ax data. No opaque string blobs.
   Cloud drifts: E=5 per side, 10 independent trajectories.
   Scale*100 encoding: 140=1.4, 85=0.85, 100=1. Axiom-derived constants.
   ================================================================ */

/* scale formatter: v = value * 100. 140->"1.4", 85->"0.85", 100->"1" */
fn ct_fmt_s(v) = (
  let w = v / 100 in
  let f = v - w * 100 in
  if f == 0 then "${w}"
  else (
    let f10 = f / 10 in
    let f1 = f - f10 * 10 in
    if f1 == 0 then "${w}.${f10}"
    else "${w}.${f10}${f1}"
  )
)

/* one keyframe stop: pct=percent, ty=translateY string, sx/sy=scale*100, blur=px */
fn ct_kf_stop(pct, ty:str, sx, sy, blur) = (
  let sx_s = ct_fmt_s(sx) in
  let sy_s = ct_fmt_s(sy) in
  "${pct}%{transform:translateY(${ty}) scaleX(${sx_s}) scaleY(${sy_s});filter:blur(${blur}px)}"
)

/* identity stop: no transform, base blur */
fn ct_kf_id(pct, blur) = ct_kf_stop(pct, "0", 100, 100, blur)

/* cloud keyframe: wrap stops with identity bookends */
fn ct_kf_cloud(i, base, stops:str) = "@keyframes cd${i}{" + ct_kf_id(0, base) + stops + ct_kf_id(100, base) + "}"

/* all 10 cloud drift keyframes -- E=5 per side, each with unique trajectory */
fn ct_kf_clouds() = (
  let c0 = ct_kf_cloud(0, 30, ct_kf_stop(30,"180px",140,85,45) + ct_kf_stop(60,"280px",85,130,25)) in
  let c1 = ct_kf_cloud(1, 35, ct_kf_stop(40,"-250px",130,110,50) + ct_kf_stop(70,"-80px",85,130,25)) in
  let c2 = ct_kf_cloud(2, 28, ct_kf_stop(25,"300px",140,85,50) + ct_kf_stop(55,"120px",90,140,22) + ct_kf_stop(80,"-100px",120,90,40)) in
  let c3 = ct_kf_cloud(3, 32, ct_kf_stop(50,"-300px",150,85,55)) in
  let c4 = ct_kf_cloud(4, 30, ct_kf_stop(35,"200px",85,140,22) + ct_kf_stop(65,"-180px",140,85,48)) in
  let c5 = ct_kf_cloud(5, 35, ct_kf_stop(45,"-260px",130,120,50) + ct_kf_stop(75,"-100px",85,85,25)) in
  let c6 = ct_kf_cloud(6, 28, ct_kf_stop(50,"320px",130,85,52)) in
  let c7 = ct_kf_cloud(7, 33, ct_kf_stop(30,"-200px",85,140,22) + ct_kf_stop(60,"220px",140,85,48)) in
  let c8 = ct_kf_cloud(8, 30, ct_kf_stop(40,"180px",120,130,42) + ct_kf_stop(80,"-70px",85,90,24)) in
  let c9 = ct_kf_cloud(9, 32, ct_kf_stop(35,"-280px",150,85,55) + ct_kf_stop(70,"140px",85,130,22)) in
  c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9
)

/* base styles: reset, scrollbar, body, links */
fn ct_css_base() = "*{box-sizing:border-box}html{scroll-behavior:smooth;scrollbar-color:#1a1a3f #08080e;scrollbar-width:thin;background:#08080e;margin:0;padding:0;overflow-x:hidden;position:relative;z-index:0}html::before{content:'';position:fixed;top:-100px;left:-100px;right:-100px;bottom:-100px;background:radial-gradient(ellipse at 50% 40%,#12101e 0%,#0c0a16 30%,#08080e 70%);z-index:-1;pointer-events:none}body{color:#e0ddd5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;margin:0;padding:0}a{color:#88aaff}table{margin:0 auto;border-collapse:collapse}canvas{max-width:100%;height:auto}img{max-width:100%;height:auto}::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:#08080e}::-webkit-scrollbar-thumb{background:#1a1a3f;border-radius:4px}::-webkit-scrollbar-thumb:hover{background:#2a2a5f}"

/* star animation keyframes: fall + K=3 depth glow.
   glow0=far(dim), glow1=mid, glow2=near(vivid). Ship of Theseus parallax. */
fn ct_css_stars() = "@keyframes starfall{from{transform:translateY(0)}to{transform:translateY(calc(100vh + 300px))}}" + "@keyframes glow0{0%,100%{opacity:0.15}50%{opacity:0.45}}" + "@keyframes glow1{0%,100%{opacity:0.3}50%{opacity:0.75}}" + "@keyframes glow2{0%,100%{opacity:0.5}50%{opacity:1}}"

/* moon pulse keyframe -- b*K=21s cycle. Pink glow: Rher's gaze. */
fn ct_css_moon() = "@keyframes moonpulse{0%,100%{opacity:0.7;box-shadow:0 0 40px 15px rgba(255,182,193,0.2),0 0 100px 40px rgba(255,105,180,0.08)}50%{opacity:1;box-shadow:0 0 60px 25px rgba(255,182,193,0.35),0 0 140px 60px rgba(255,105,180,0.12)}}"

/* responsive: mobile grid + nav */
fn ct_css_responsive() = "@media(max-width:600px){.idx-grid{grid-template-columns:1fr!important}#nav-dropdown{grid-template-columns:1fr 1fr!important}#ct-wave{display:none!important}#ct-clouds{display:none!important}*{max-width:100vw!important;box-sizing:border-box}h1{font-size:1.6em!important;letter-spacing:1px!important}h2{font-size:1.3em!important}h3{font-size:1.1em!important}pre,code{overflow-x:hidden!important;white-space:pre-wrap!important;word-break:break-word!important;font-size:12px!important}table{width:100%!important;table-layout:fixed!important}section{padding-left:12px!important;padding-right:12px!important}p{overflow-wrap:break-word;word-wrap:break-word}input[type='text']{width:auto!important;max-width:200px}section button{min-height:44px;min-width:44px}canvas{max-width:100%!important;height:auto!important;display:block;margin-left:auto!important;margin-right:auto!important}}"

/* ================================================================
   CELESTIAL THEATRE -- Style System
   Layer 0: VOID (dark gradient, #08080e)
   Layer 1: LIGHT THROUGH LETTERS (warm text glow on headings)
   Shared across ALL pages. The visual IS the math.
   ================================================================ */

fn ct_body(body) = (
  dom_style(body, "margin", "0");
  dom_style(body, "padding", "0");
  dom_style(body, "background", "transparent");
  dom_style(body, "color", "#e0ddd5");
  dom_style(body, "fontFamily", "Georgia, 'Times New Roman', serif");
  dom_style(body, "lineHeight", "1.8");
  dom_style(body, "overflowX", "hidden");
  dom_style(body, "scrollBehavior", "smooth");
  dom_style(body, "webkitFontSmoothing", "antialiased");
  dom_style(body, "webkitOverflowScrolling", "touch");
  let s = dom_create("style") in
  dom_text(s, ct_css_base() + ct_css_stars() + ct_kf_clouds() + ct_css_moon() + ct_css_responsive());
  dom_append(body, s)
)

fn ct_heading(el) = (
  dom_style(el, "color", "#f0e6d3");
  dom_style(el, "textShadow", "none")
)

fn ct_gold(el) = (
  dom_style(el, "color", "#ffd700");
  dom_style(el, "fontWeight", "bold")
)

fn ct_link(el) = (
  dom_style(el, "color", "#88aaff");
  dom_style(el, "textDecoration", "none")
)

fn ct_mono(el) = (
  dom_style(el, "fontFamily", "'Courier New', monospace")
)

fn ct_code_block(el) = (
  ct_mono(el);
  dom_style(el, "background", "#0f0f18");
  dom_style(el, "padding", "clamp(10px, 2.5vw, 16px) clamp(10px, 3vw, 20px)");
  dom_style(el, "borderRadius", "8px");
  dom_style(el, "border", "1px solid #1a1a3f");
  dom_style(el, "lineHeight", "1.6");
  dom_style(el, "overflowWrap", "break-word");
  dom_style(el, "wordBreak", "break-word")
)

fn ct_card(el) = (
  dom_style(el, "padding", "clamp(14px, 3vw, 24px) clamp(12px, 3vw, 20px)");
  dom_style(el, "border", "1px solid #1a1a2a");
  dom_style(el, "borderRadius", "10px");
  dom_style(el, "background", "#0f0f18");
  dom_style(el, "overflowWrap", "break-word")
)

/* ================================================================
   CELESTIAL THEATRE -- 84 eigenvalue-positioned stars.
   84 = D^2*K*b = TRUE-divisor lambda-420 rings (subset of the 108
   = D^2*K^3 lambda-420 lattice; 24 = D^4 extensions reach 2*TRUE
   are excluded since they don't fit inside TRUE = the organism).
   Each star IS a TRUE-divisor lambda-420 ring. Every constant is
   axiom-derived. The sky IS the math.
   ================================================================ */

fn ct_star(c, i) = (
  let star = dom_create("div") in
  dom_style(star, "position", "absolute");
  /* x: (i*GATE + E) mod K^2*L -- position from 6 primes */
  let rx = i * 13 + 5 in
  let x = rx - (rx / 99) * 99 in
  dom_style(star, "left", "${x}%");
  /* spawn: (i*KEY + K) mod b*GATE -- KEY=41 sum of Decality */
  let ry = i * 41 + 3 in
  let spawn = ry - (ry / 91) * 91 in
  let spawn_px = spawn * 3 + 20 in
  dom_style(star, "top", "-${spawn_px}px");
  /* K=3 depth layers: 0=far(cool,dim,slow), 1=mid, 2=near(warm,bright,fast)
     Ship of Theseus parallax: fly through the mathematical cosmos.
     Near stars zip past. Far stars crawl. Depth IS K=3 closure. */
  let layer = i - (i / 3) * 3 in
  let sz = layer + 1 in
  dom_style(star, "width", "${sz}px");
  dom_style(star, "height", "${sz}px");
  dom_style(star, "borderRadius", "50%");
  /* Green Hue: bioluminescent eldritch mint. Far=deep water, near=full aquamarine.
     Fear & Hunger primordial energy. The void's own color. */
  let col = if layer == 0 then "#1A4D3E" else if layer == 1 then "#2D8B6F" else "#7FFFD4" in
  dom_style(star, "background", col);
  let gr = sz * 4 in
  /* glow intensity: far=barely there, near=bioluminescent bloom */
  let glow_a = if layer == 0 then "0.2" else if layer == 1 then "0.4" else "0.65" in
  dom_style(star, "boxShadow", "0 0 ${gr}px ${sz}px rgba(74,255,160,${glow_a})");
  /* glow: (i*b) mod L + K = 3-13s */
  let d7 = i * 7 in
  let gd = d7 - (d7 / 11) * 11 in
  let glow_dur = gd + 3 in
  /* fall: depth parallax -- K=3 speed bands.
     Layer 0(far): 50-84s. Layer 1(mid): 35-69s. Layer 2(near): 20-54s.
     (2-layer)*15 = axiom-derived depth offset. */
  let fd = i * 2 in
  let fm = fd - (fd / 35) * 35 in
  let depth_slow = (2 - layer) * 15 in
  let fall_dur = 20 + fm + depth_slow in
  let fall_delay = spawn / 6 in
  dom_style(star, "animation", "glow${layer} ${glow_dur}s ease-in-out 0s infinite, starfall ${fall_dur}s linear ${fall_delay}s infinite");
  dom_append(c, star)
)

/* K=3 parallax layer: absolute-fill div with willChange for GPU compositing */
fn ct_layer(c, id:str) = (
  let l = dom_create("div") in
  dom_attr(l, "id", id);
  dom_style(l, "position", "absolute");
  dom_style(l, "top", "0"); dom_style(l, "left", "0");
  dom_style(l, "width", "100%"); dom_style(l, "height", "100%");
  dom_style(l, "willChange", "transform");
  dom_append(c, l);
  l
)

fn ct_starfield(body) = (
  let c = dom_create("div") in
  dom_style(c, "position", "fixed");
  dom_style(c, "top", "0");
  dom_style(c, "left", "0");
  dom_style(c, "width", "100%");
  dom_style(c, "height", "100%");
  dom_style(c, "overflow", "hidden");
  dom_style(c, "pointerEvents", "none");
  dom_append(body, c);
  /* K=3 depth layers for scroll parallax.
     Near stars zip past, far stars crawl. Depth IS K=3 closure. */
  let l0 = ct_layer(c, "ct-l0") in
  let l1 = ct_layer(c, "ct-l1") in
  let l2 = ct_layer(c, "ct-l2") in
  /* 84 = D^2*K*b = TRUE-divisor lambda-420 rings (subset of 108 lambda-420
     lattice). Stars routed to depth layer. */
  for i in range(84) do (
    let layer = i - (i / 3) * 3 in
    let target = if layer == 0 then l0 else if layer == 1 then l1 else l2 in
    ct_star(target, i)
  )
)

/* Stars are position:fixed -- no scroll parallax. They stay pinned.
   (S1206: removed translateY parallax that made stars drift with scroll.) */

/* ================================================================
   CELESTIAL THEATRE -- K^3 Moon. K^3=27. Closure cubed.
   Position: left 30px, top 20px. Size: 80px (D^3*E*D=80). Pulse: b*K=21s.
   The moon IS closure made visible. Pale warm glow.
   ================================================================ */

fn ct_crater(m, top:str, left:str, sz:str, opac:str) = (
  let c = dom_create("div") in
  dom_style(c, "position", "absolute");
  dom_style(c, "top", top);
  dom_style(c, "left", left);
  dom_style(c, "width", sz);
  dom_style(c, "height", sz);
  dom_style(c, "borderRadius", "50%");
  dom_style(c, "background", "radial-gradient(circle at 60% 40%, transparent 30%, rgba(120,60,80,${opac}) 60%, transparent 80%)");
  dom_style(c, "boxShadow", "inset 1px 1px 2px rgba(60,20,40,0.25), inset -1px -1px 1px rgba(255,220,230,0.1)");
  dom_append(m, c)
)

fn ct_moon(body) = (
  let m = dom_create("div") in
  dom_style(m, "position", "absolute");
  dom_style(m, "top", "20px");
  dom_style(m, "left", "30px");
  dom_style(m, "width", "80px");
  dom_style(m, "height", "80px");
  dom_style(m, "borderRadius", "50%");
  /* Pink moon: warm white core, rose glow. Rher's gaze -- slightly too bright, slightly too warm. */
  dom_style(m, "background", "radial-gradient(circle at 35% 30%, #FFF5F0 0%, #FFE8E0 25%, #F0D0C8 50%, #D4A8B0 75%, #B08090 100%)");
  dom_style(m, "boxShadow", "0 0 50px 18px rgba(255,182,193,0.18), 0 0 100px 40px rgba(255,105,180,0.08), 0 0 180px 70px rgba(255,105,180,0.04), inset -8px -4px 12px rgba(80,20,40,0.12)");
  dom_style(m, "pointerEvents", "none");
  dom_style(m, "animation", "moonpulse 21s ease-in-out infinite");
  dom_style(m, "zIndex", "1");
  dom_style(m, "overflow", "hidden");
  /* K^2=9 craters -- the spider web on the moon's face */
  ct_crater(m, "15%", "20%", "14px", "0.4");
  ct_crater(m, "35%", "55%", "18px", "0.35");
  ct_crater(m, "60%", "25%", "11px", "0.45");
  ct_crater(m, "20%", "65%", "8px", "0.3");
  ct_crater(m, "50%", "45%", "13px", "0.4");
  ct_crater(m, "72%", "60%", "9px", "0.35");
  ct_crater(m, "40%", "15%", "7px", "0.3");
  ct_crater(m, "65%", "75%", "10px", "0.4");
  ct_crater(m, "25%", "40%", "6px", "0.25");
  dom_append(body, m)
)

/* ================================================================
   CELESTIAL THEATRE -- Edge Clouds along vertical edges.
   E=5 per side. Bright fog, narrow, hugging edges. Independent paths.
   ================================================================ */

fn ct_edge_cloud(c, i, side:str) = (
  let cl = dom_create("div") in
  dom_style(cl, "position", "absolute");
  let vy = i * 7 + 3 in
  let ymod = vy - (vy / 10) * 10 in
  let ypos = ymod * 10 in
  dom_style(cl, "top", "${ypos}%");
  /* tight to edge */
  if side == "L" then dom_style(cl, "left", "-20px")
  else dom_style(cl, "right", "-20px");
  let layer = i - (i / 3) * 3 in
  let hpx = layer * 120 + 300 in
  dom_style(cl, "height", "${hpx}px");
  let wpx = layer * 20 + 80 in
  dom_style(cl, "width", "${wpx}px");
  /* White fog -- soft cloud mist at edges */
  if side == "L" then
    dom_style(cl, "background", "radial-gradient(ellipse at 0% 50%, rgba(235,240,255,0.18) 0%, rgba(210,220,240,0.08) 50%, transparent 85%)")
  else
    dom_style(cl, "background", "radial-gradient(ellipse at 100% 50%, rgba(235,240,255,0.18) 0%, rgba(210,220,240,0.08) 50%, transparent 85%)");
  dom_style(cl, "borderRadius", "50%");
  dom_style(cl, "filter", "blur(30px)");
  dom_style(cl, "pointerEvents", "none");
  /* each cloud gets its own keyframe for independent trajectories */
  let side_off = if side == "L" then 0 else 5 in
  let ci = i + side_off in
  let drift_dur = 30 + ci * 4 in
  let drift_delay = ci * 3 in
  dom_style(cl, "animation", "cd${ci} ${drift_dur}s ease-in-out ${drift_delay}s infinite");
  dom_append(c, cl)
)

fn ct_clouds(body) = (
  let c = dom_create("div") in
  dom_attr(c, "id", "ct-clouds");
  dom_style(c, "position", "fixed");
  dom_style(c, "top", "0");
  dom_style(c, "left", "0");
  dom_style(c, "width", "100%");
  dom_style(c, "height", "100%");
  dom_style(c, "overflow", "hidden");
  dom_style(c, "pointerEvents", "none");
  dom_style(c, "zIndex", "3");
  dom_append(body, c);
  for i in range(5) do ct_edge_cloud(c, i, "L");
  for i in range(5) do ct_edge_cloud(c, i, "R")
)

/* ================================================================
   CELESTIAL THEATRE -- CRT Wave. 7 channels, 7 colors.
   Subtle gradient at bottom showing the CRT decomposition.
   D=warm, K=cool, E=gold, b=deep, L=bright, G=rose, 17=cyan. The spectrum IS the axiom.
   ================================================================ */

fn ct_wave(body) = (
  let w = dom_create("div") in
  dom_attr(w, "id", "ct-wave");
  dom_style(w, "position", "fixed");
  dom_style(w, "bottom", "0");
  dom_style(w, "left", "0");
  dom_style(w, "width", "100%");
  dom_style(w, "height", "2px");
  dom_style(w, "background", "linear-gradient(90deg, #ff6b4a 0%, #4a9eff 14%, #ffd700 28%, #6b3fa0 43%, #00ff88 57%, #ff4466 71%, #00dddd 86%, #ff6b4a 100%)");
  dom_style(w, "opacity", "0.8");
  dom_style(w, "pointerEvents", "none");
  dom_style(w, "zIndex", "2");
  dom_append(body, w)
)

/* ================================================================
   SHARED RENDER COMPONENTS -- reusable across all page types
   ================================================================ */

fn highlight_tier(cat:str) = (
  /* highlight the card in dropdown by ID */
  let sel = "#nt-" + cat in
  let el = dom_query(sel) in
  if el then (
    dom_style(el, "border", "1px solid #ffd700")
  ) else 0;
  /* highlight Explore button when any tier is active */
  let btn = dom_query("#nav-explore-btn") in
  if btn then (
    dom_style(btn, "borderBottom", "2px solid #ffd700")
  ) else 0
)

/* Reset all nav tier highlights (SPA: old highlights persist across navigations) */
fn unhighlight_tier(cat:str) = (
  let sel = "#nt-" + cat in
  let el = dom_query(sel) in
  if el then (
    dom_style(el, "border", "1px solid #1a1a3f")
  ) else 0
)

/* Reset gold-by-default nav buttons */
fn unhighlight_gold(tid:str) = (
  let sel = "#nt-" + tid in
  let el = dom_query(sel) in
  if el then (
    dom_style(el, "borderBottom", "none")
  ) else 0
)

fn reset_nav_highlights() = (
  unhighlight_gold("home");
  mut i = 0;
  while i < SEC_N[0] - 1 do (
    unhighlight_tier(SEC_SLUGS[i]);
    mut i = i + 1
  );
  unhighlight_tier("demos-card");
  unhighlight_gold("repl");
  /* reset Explore button */
  let btn = dom_query("#nav-explore-btn") in
  if btn then (
    dom_style(btn, "borderBottom", "none")
  ) else 0
)

/* highlight_nav: derive tier from URL category (SSOT: URL is truth).
   get_category() returns first path segment: /basics/page -> "basics".
   Single-segment paths: /repl -> "repl", / -> "home".
   Loops over SEC_SLUGS (populated from page_list.ax). */
fn highlight_nav() = (
  reset_nav_highlights();
  let cat = get_category() in
  mut found = 0;
  mut i = 0;
  while i < SEC_N[0] - 1 do (
    if streq(cat, SEC_SLUGS[i]) == 1 then (
      highlight_tier(SEC_SLUGS[i]);
      mut found = 1
    ) else 0;
    mut i = i + 1
  );
  if found == 0 then (
    if streq(cat, "demos") == 1 then highlight_tier("demos-card")
    else if streq(cat, "repl") == 1 then (
      let rb = dom_query("#nt-repl") in
      if rb then dom_style(rb, "borderBottom", "2px solid #ffd700") else 0
    )
    else (
      let hb = dom_query("#nt-home") in
      if hb then dom_style(hb, "borderBottom", "2px solid #ffd700") else 0
    )
  ) else 0
)

/* ================================================================
   NAV DROPDOWN -- 7 tiers in a single Explore button
   Hidden input #nav-dd-state tracks open/close. Toggle on click.
   Each tier card: name (gold if current) + ring + description.
   ================================================================ */

fn nav_dd_card(dd, href:str, tid:str, name:str, ring:str, desc:str) = (
  let card = dom_create("a") in
  dom_attr(card, "href", href);
  dom_attr(card, "id", tid);
  dom_style(card, "display", "block");
  dom_style(card, "padding", "14px 16px");
  dom_style(card, "background", "#0f0f1e");
  dom_style(card, "borderRadius", "8px");
  dom_style(card, "border", "1px solid #1a1a3f");
  dom_style(card, "textDecoration", "none");
  dom_style(card, "cursor", "pointer");
  dom_style(card, "minWidth", "0");
  dom_style(card, "overflow", "hidden");
  let nm = dom_create("div") in
  dom_text(nm, name);
  dom_style(nm, "color", "#c8d8ff");
  dom_style(nm, "fontSize", "15px");
  dom_style(nm, "fontWeight", "bold");
  dom_style(nm, "fontFamily", "'Courier New', monospace");
  dom_append(card, nm);
  let rn = dom_create("div") in
  dom_text(rn, ring);
  dom_style(rn, "color", "#ffd700");
  dom_style(rn, "fontSize", "12px");
  dom_style(rn, "fontFamily", "'Courier New', monospace");
  dom_style(rn, "marginTop", "2px");
  dom_append(card, rn);
  let ds = dom_create("div") in
  dom_text(ds, desc);
  dom_style(ds, "color", "#8888a0");
  dom_style(ds, "fontSize", "12px");
  dom_style(ds, "marginTop", "4px");
  dom_style(ds, "lineHeight", "1.4");
  dom_append(card, ds);
  dom_on(card, "click", "close_nav_dd");
  dom_append(dd, card)
)

fn toggle_nav_dd() = (
  close_search();
  let state = dom_query("#nav-dd-state") in
  let dd = dom_query("#nav-dropdown") in
  let arrow = dom_query("#nav-dd-arrow") in
  let v = dom_value(state) in
  if streq(v, "1") == 1 then (
    dom_style(dd, "display", "none");
    dom_text(state, "0");
    if arrow then dom_text(arrow, " \u25BE") else 0
  ) else (
    dom_style(dd, "display", "grid");
    dom_text(state, "1");
    if arrow then dom_text(arrow, " \u25B4") else 0
  )
)

fn close_nav_dd() = (
  let state = dom_query("#nav-dd-state") in
  let dd = dom_query("#nav-dropdown") in
  let arrow = dom_query("#nav-dd-arrow") in
  dom_style(dd, "display", "none");
  dom_text(state, "0");
  if arrow then dom_text(arrow, " \u25BE") else 0
)

/* ===== PAGE REGISTRY -- SSOT for search + section indices ===== */
/* Adding a page? Add _rp() call in page_list.ax + page fn + router entry.
   Sitemap + route map + index grid auto-derive from page_list.ax.
   W2 DISSOLVED S1724: _group() in page_list.ax drives index card grouping.
   One _rp() call = route + search + sitemap + index card. Zero manual steps. */
let _pg_sec = alloc(200)
let _pg_slug = alloc(200)
let _pg_title = alloc(200)
let _pg_desc = alloc(200)
let _pg_group = alloc(200)
let _pg_n = [0]
let _cur_group = alloc(1)

fn _section(_m:str) = 0
fn _file(_p:str) = 0

/* SECTION METADATA SSOT (S2017). Populated by _sec_meta() calls in page_list.ax.
   Nav cards, highlight_nav, reset_nav_highlights all derive from these arrays.
   Adding/renaming a section = 1 edit in page_list.ax. */
let SEC_SLUGS = alloc(10)
let SEC_NAMES = alloc(10)
let SEC_RINGS = alloc(10)
let SEC_DESCS = alloc(10)
let SEC_N = [0]

fn _sec_meta(slug:str, name:str, ring:str, desc:str) = (
  let i = SEC_N[0] in
  set(SEC_SLUGS, i, slug);
  set(SEC_NAMES, i, name);
  set(SEC_RINGS, i, ring);
  set(SEC_DESCS, i, desc);
  set(SEC_N, 0, i + 1)
)

fn _group(name:str) = set(_cur_group, 0, name)

/* S1893: _s() workaround REMOVED. C1 gotcha dissolved: inlining now skips ALL
   :str fns, so _nstr's annotation is preserved and compute_str_arr_globals
   produces correct variable-name markers (not heap-pointer numbers). */

fn _rp(sec:str, slug:str, title:str, desc:str) = (
  let i = _pg_n[0] in
  set(_pg_sec, i, sec);
  set(_pg_slug, i, slug);
  set(_pg_title, i, title);
  set(_pg_desc, i, desc);
  set(_pg_group, i, _cur_group[0]);
  set(_pg_n, 0, i + 1)
)

fn init_page_registry() = (
/* _rp() calls are in page_list.ax, concatenated by build entries after core.ax.
   They execute at top-level during module init, filling _pg_* arrays.
   This function is a no-op -- arrays are already populated.
   Sitemap build still includes page_list.ax via ouroboros CLI (has _expand_includes). */
0
)

/* Render all pages in a section as explore cards */
fn reg_render_section(g, section:str) = (
  mut i = 0;
  while i < _pg_n[0] do (
    if streq(_pg_sec[i], section) == 1 then
      render_explore_link(g, "/" + _pg_sec[i] + "/" + _pg_slug[i], _pg_title[i], _pg_desc[i])
    else 0;
    mut i = i + 1
  )
)

/* Render all pages in a section as explore cards WITH group headers.
   Group names come from _group() calls in page_list.ax.
   Auto-generates index grids: one _rp() = one card. W2 dissolved. */
fn reg_render_section_grouped(g, section:str) = (
  let pg = alloc(1) in
  mut i = 0;
  while i < _pg_n[0] do (
    if streq(_pg_sec[i], section) == 1 then (
      if _pg_group[i] != pg[0] then (
        if _pg_group[i] != 0 then idx_group(g, _pg_group[i]) else 0;
        set(pg, 0, _pg_group[i])
      ) else 0;
      render_explore_link(g, "/" + _pg_sec[i] + "/" + _pg_slug[i], _pg_title[i], _pg_desc[i])
    ) else 0;
    mut i = i + 1
  )
)

/* ===== SEARCH ===== */
let g_srch_t = [0]
let g_srch_h = [0]
let g_srch_n = [0]
let g_srch_panel = [0]
let g_srch_inp = [0]
let g_srch_la = [0]
let g_srch_ta = [0]
let g_srch_sa = [0]

fn _to_lower(c) = if c > 64 then (if c < 91 then c + 32 else c) else c

fn search_ci_match(hay:str, need:str):int = (
  let hl = len(hay) in
  let nl = len(need) in
  if nl == 0 then 1
  else if nl > hl then 0
  else (
    mut found = 0;
    mut i = 0;
    while i <= hl - nl do (
      mut j = 0;
      mut ok = 1;
      while j < nl do (
        if _to_lower(charCode(hay, i + j)) != _to_lower(charCode(need, j)) then
          mut ok = 0
        else 0;
        mut j = j + 1
      );
      if ok == 1 then (mut found = 1; mut i = hl) else 0;
      mut i = i + 1
    );
    found
  )
)

fn _si(t, h, i, title:str, href:str) = (set(t, i, title); set(h, i, href); i + 1)

fn search_build_index() = (
  init_page_registry();
  let t = alloc(200) in
  let h = alloc(200) in
  set(g_srch_t, 0, t);
  set(g_srch_h, 0, h);
  mut i = 0;
  /* Section-level entries (not in registry -- no slug) */
  mut i = _si(t, h, i, "Home", "/");
  mut i = _si(t, h, i, "Basics", "/basics");
  mut i = _si(t, h, i, "Patterns", "/patterns");
  mut i = _si(t, h, i, "Connections", "/connections");
  mut i = _si(t, h, i, "Theory", "/theory");
  mut i = _si(t, h, i, "Ideas", "/ideas");
  mut i = _si(t, h, i, "Lab", "/lab");
  mut i = _si(t, h, i, "REPL", "/repl");
  mut i = _si(t, h, i, "Demos", "/demos");
  /* All pages from registry -- SSOT, never drifts */
  mut j = 0;
  while j < _pg_n[0] do (
    mut i = _si(t, h, i, _pg_title[j], "/" + _pg_sec[j] + "/" + _pg_slug[j]);
    mut j = j + 1
  );
  set(g_srch_n, 0, i)
)

fn search_build_ui() = (
  let panel = dom_create("div") in
  dom_attr(panel, "id", "search-panel");
  dom_style(panel, "display", "none");
  dom_style(panel, "position", "fixed");
  dom_style(panel, "top", "48px");
  dom_style(panel, "left", "50%");
  dom_style(panel, "transform", "translateX(-50%)");
  dom_style(panel, "width", "min(480px, 90vw)");
  dom_style(panel, "maxHeight", "60vh");
  dom_style(panel, "overflowY", "auto");
  dom_style(panel, "background", "rgba(8,8,14,0.97)");
  dom_style(panel, "border", "1px solid #2a2a5f");
  dom_style(panel, "borderRadius", "10px");
  dom_style(panel, "padding", "12px");
  dom_style(panel, "zIndex", "300");
  dom_style(panel, "backdropFilter", "blur(12px)");
  dom_style(panel, "boxSizing", "border-box");
  set(g_srch_panel, 0, panel);
  let inp = dom_create("input") in
  dom_attr(inp, "type", "text");
  dom_attr(inp, "id", "search-input");
  dom_attr(inp, "placeholder", "Search pages...");
  dom_style(inp, "width", "100%");
  dom_style(inp, "boxSizing", "border-box");
  dom_style(inp, "background", "#0a0a1a");
  dom_style(inp, "color", "#ffd700");
  dom_style(inp, "border", "1px solid #333");
  dom_style(inp, "borderRadius", "6px");
  dom_style(inp, "padding", "10px 12px");
  dom_style(inp, "fontSize", "16px");
  dom_style(inp, "fontFamily", "'Courier New', monospace");
  dom_style(inp, "outline", "none");
  dom_style(inp, "marginBottom", "8px");
  dom_on(inp, "input", "search_update");
  dom_on1(inp, "keydown", "search_keydown");
  dom_append(panel, inp);
  set(g_srch_inp, 0, inp);
  let box = dom_create("div") in
  set(g_srch_la, 0, alloc(12));
  set(g_srch_ta, 0, alloc(12));
  set(g_srch_sa, 0, alloc(12));
  mut ri = 0;
  while ri < 12 do (
    let a = dom_create("a") in
    dom_style(a, "display", "none");
    dom_style(a, "padding", "8px 12px");
    dom_style(a, "borderBottom", "1px solid #1a1a3f");
    dom_style(a, "textDecoration", "none");
    dom_style(a, "cursor", "pointer");
    let tt = dom_create("div") in
    dom_style(tt, "color", "#ffd700");
    dom_style(tt, "fontSize", "14px");
    dom_append(a, tt);
    let ss = dom_create("div") in
    dom_style(ss, "color", "#555");
    dom_style(ss, "fontSize", "11px");
    dom_style(ss, "marginTop", "2px");
    dom_append(a, ss);
    dom_append(box, a);
    let la = g_srch_la[0] in
    let ta = g_srch_ta[0] in
    let sa = g_srch_sa[0] in
    set(la, ri, a);
    set(ta, ri, tt);
    set(sa, ri, ss);
    mut ri = ri + 1
  );
  dom_append(panel, box);
  dom_append(dom_body(), panel)
)

fn search_update() = (
  let q = dom_value(g_srch_inp[0]) in
  let ql = len(q) in
  let n = g_srch_n[0] in
  let t = g_srch_t[0] in
  let h = g_srch_h[0] in
  let la = g_srch_la[0] in
  let ta = g_srch_ta[0] in
  let sa = g_srch_sa[0] in
  mut shown = 0;
  if ql > 0 then (
    mut idx = 0;
    while idx < n do (
      if shown < 12 then (
        let title = t[idx] in
        let href = h[idx] in
        if search_ci_match(title, q) == 1 then (
          dom_attr(la[shown], "href", href);
          dom_style(la[shown], "display", "block");
          dom_text(ta[shown], title);
          dom_text(sa[shown], href);
          mut shown = shown + 1
        ) else if search_ci_match(href, q) == 1 then (
          dom_attr(la[shown], "href", href);
          dom_style(la[shown], "display", "block");
          dom_text(ta[shown], title);
          dom_text(sa[shown], href);
          mut shown = shown + 1
        ) else 0
      ) else 0;
      mut idx = idx + 1
    )
  ) else 0;
  mut hi = shown;
  while hi < 12 do (
    dom_style(la[hi], "display", "none");
    mut hi = hi + 1
  )
)

fn toggle_search() = (
  close_nav_dd();
  let panel = g_srch_panel[0] in
  let st = dom_query("#search-state") in
  let sv = dom_value(st) in
  if streq(sv, "1") == 1 then (
    dom_style(panel, "display", "none");
    dom_text(st, "0")
  ) else (
    dom_style(panel, "display", "block");
    dom_text(st, "1");
    dom_focus(g_srch_inp[0])
  )
)

fn close_search() = (
  let panel = g_srch_panel[0] in
  dom_style(panel, "display", "none");
  let st = dom_query("#search-state") in
  dom_text(st, "0")
)

fn search_keydown(key) = if key == 27 then close_search() else 0

fn render_nav() = (
  let nav = dom_create("nav") in
  dom_style(nav, "background", "transparent");
  dom_style(nav, "padding", "12px 8px");
  dom_style(nav, "display", "flex");
  dom_style(nav, "alignItems", "center");
  dom_style(nav, "gap", "clamp(2px, 1vw, 8px)");
  dom_style(nav, "justifyContent", "center");
  dom_style(nav, "flexWrap", "nowrap");
  dom_style(nav, "position", "fixed");
  dom_style(nav, "top", "0");
  dom_style(nav, "left", "0");
  dom_style(nav, "right", "0");
  dom_style(nav, "zIndex", "100");
  ct_mono(nav);
  dom_style(nav, "fontSize", "14px");
  /* brand */
  let brand = dom_create("a") in
  dom_attr(brand, "href", "/");
  dom_attr(brand, "id", "nt-home");
  dom_text(brand, "0/0");
  ct_gold(brand);
  dom_style(brand, "fontSize", "clamp(12px, 3.5vw, 18px)");
  dom_style(brand, "textDecoration", "none");
  dom_style(brand, "background", "#1a1a3f");
  dom_style(brand, "padding", "4px clamp(6px, 2vw, 12px)");
  dom_style(brand, "borderRadius", "6px");
  dom_style(brand, "lineHeight", "1.2");
  dom_style(brand, "whiteSpace", "nowrap");
  dom_style(brand, "marginRight", "4px");
  dom_append(nav, brand);
  /* explore dropdown trigger */
  let explore_wrap = dom_create("div") in
  dom_style(explore_wrap, "position", "relative");
  let explore_btn = dom_create("button") in
  dom_attr(explore_btn, "id", "nav-explore-btn");
  dom_style(explore_btn, "color", "#ffd700");
  dom_style(explore_btn, "fontWeight", "bold");
  dom_style(explore_btn, "background", "#1a1a3f");
  dom_style(explore_btn, "borderTop", "none");
  dom_style(explore_btn, "borderLeft", "none");
  dom_style(explore_btn, "borderRight", "none");
  dom_style(explore_btn, "borderBottom", "2px solid transparent");
  dom_style(explore_btn, "padding", "4px clamp(6px, 2vw, 12px)");
  dom_style(explore_btn, "borderRadius", "6px");
  dom_style(explore_btn, "cursor", "pointer");
  dom_style(explore_btn, "fontSize", "clamp(12px, 3.5vw, 18px)");
  dom_style(explore_btn, "fontFamily", "'Courier New', monospace");
  dom_style(explore_btn, "lineHeight", "1.2");
  dom_style(explore_btn, "verticalAlign", "middle");
  dom_style(explore_btn, "boxSizing", "border-box");
  dom_style(explore_btn, "whiteSpace", "nowrap");
  dom_style(explore_btn, "textDecoration", "none");
  let btn_text = dom_create("span") in
  dom_text(btn_text, "Explore");
  dom_append(explore_btn, btn_text);
  let arrow = dom_create("span") in
  dom_attr(arrow, "id", "nav-dd-arrow");
  dom_text(arrow, " \u25BE");
  dom_style(arrow, "fontSize", "14px");
  dom_append(explore_btn, arrow);
  dom_on(explore_btn, "click", "toggle_nav_dd");
  dom_append(explore_wrap, explore_btn);
  /* hidden state input */
  let state_input = dom_create("input") in
  dom_attr(state_input, "id", "nav-dd-state");
  dom_attr(state_input, "type", "hidden");
  dom_attr(state_input, "value", "0");
  dom_append(explore_wrap, state_input);
  /* dropdown panel */
  let dd = dom_create("div") in
  dom_attr(dd, "id", "nav-dropdown");
  dom_style(dd, "display", "none");
  dom_style(dd, "position", "fixed");
  dom_style(dd, "top", "48px");
  dom_style(dd, "left", "50%");
  dom_style(dd, "transform", "translateX(-50%)");
  dom_style(dd, "gridTemplateColumns", "1fr 1fr 1fr");
  dom_style(dd, "gap", "8px");
  dom_style(dd, "padding", "12px");
  dom_style(dd, "background", "rgba(8,8,14,0.97)");
  dom_style(dd, "border", "1px solid #2a2a5f");
  dom_style(dd, "borderRadius", "10px");
  dom_style(dd, "width", "min(480px, 90vw)");
  dom_style(dd, "boxSizing", "border-box");
  dom_style(dd, "zIndex", "200");
  dom_style(dd, "backdropFilter", "blur(12px)");
  /* First 6 sections: regular nav cards (from SEC_* arrays, page_list.ax SSOT) */
  mut nci = 0;
  while nci < SEC_N[0] - 1 do (
    nav_dd_card(dd, "/" + SEC_SLUGS[nci], "nt-" + SEC_SLUGS[nci], SEC_NAMES[nci], SEC_RINGS[nci], SEC_DESCS[nci]);
    mut nci = nci + 1
  );
  /* 7th section: Demos. Full-width bar (special styling, draws text from SEC_* arrays). */
  let di = SEC_N[0] - 1 in
  let dcard = dom_create("a") in
  dom_attr(dcard, "href", "/" + SEC_SLUGS[di]);
  dom_attr(dcard, "id", "nt-demos-card");
  dom_style(dcard, "gridColumn", "1 / -1");
  dom_style(dcard, "display", "block");
  dom_style(dcard, "padding", "10px 14px");
  dom_style(dcard, "borderRadius", "8px");
  dom_style(dcard, "textDecoration", "none");
  dom_style(dcard, "textAlign", "center");
  dom_style(dcard, "background", "linear-gradient(90deg, #1a0a2f 0%, #2a1a4f 50%, #1a0a2f 100%)");
  dom_style(dcard, "border", "1px solid #6633aa");
  let vt = dom_create("div") in
  dom_text(vt, SEC_NAMES[di]);
  dom_style(vt, "color", "#cc88ff");
  dom_style(vt, "fontWeight", "bold");
  dom_style(vt, "fontSize", "13px");
  dom_append(dcard, vt);
  let vr = dom_create("div") in
  dom_text(vr, SEC_RINGS[di]);
  dom_style(vr, "color", "#8866bb");
  dom_style(vr, "fontSize", "10px");
  dom_append(dcard, vr);
  let vd = dom_create("div") in
  dom_text(vd, SEC_DESCS[di]);
  dom_style(vd, "color", "#777");
  dom_style(vd, "fontSize", "10px");
  dom_style(vd, "marginTop", "2px");
  dom_append(dcard, vd);
  dom_append(dd, dcard);
  dom_append(explore_wrap, dd);
  dom_append(nav, explore_wrap);
  /* REPL */
  let repl = dom_create("a") in
  dom_attr(repl, "href", "/repl");
  dom_attr(repl, "id", "nt-repl");
  dom_text(repl, "REPL");
  ct_gold(repl);
  dom_style(repl, "fontSize", "clamp(12px, 3.5vw, 18px)");
  dom_style(repl, "textDecoration", "none");
  dom_style(repl, "background", "#1a1a3f");
  dom_style(repl, "padding", "4px clamp(6px, 2vw, 12px)");
  dom_style(repl, "borderRadius", "6px");
  dom_style(repl, "lineHeight", "1.2");
  dom_style(repl, "whiteSpace", "nowrap");
  dom_style(repl, "marginLeft", "4px");
  dom_append(nav, repl);
  /* Search */
  let srch = dom_create("button") in
  dom_attr(srch, "id", "nav-search-btn");
  dom_style(srch, "color", "#ffd700");
  dom_style(srch, "fontWeight", "bold");
  dom_style(srch, "background", "#1a1a3f");
  dom_style(srch, "border", "none");
  dom_style(srch, "padding", "4px clamp(6px, 2vw, 12px)");
  dom_style(srch, "borderRadius", "6px");
  dom_style(srch, "cursor", "pointer");
  dom_style(srch, "fontSize", "clamp(12px, 3.5vw, 18px)");
  dom_style(srch, "fontFamily", "'Courier New', monospace");
  dom_style(srch, "lineHeight", "1.2");
  dom_style(srch, "whiteSpace", "nowrap");
  dom_style(srch, "marginLeft", "4px");
  dom_inner(srch, "&#128269; Find");
  dom_on(srch, "click", "toggle_search");
  dom_append(nav, srch);
  /* Search hidden state */
  let srch_state = dom_create("input") in
  dom_attr(srch_state, "id", "search-state");
  dom_attr(srch_state, "type", "hidden");
  dom_attr(srch_state, "value", "0");
  dom_append(nav, srch_state);
  dom_append(dom_body(), nav);
  /* Build search panel + index (permanent, survives SPA navigation) */
  search_build_ui();
  search_build_index()
)

