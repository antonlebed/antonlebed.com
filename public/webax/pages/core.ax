  dom_append(parent, item)
)

/* Extract slug from href and append .ax. "/connections/thermo" -> "thermo.ax".
   Returns "" for section-level hrefs like "/basics" (no .ax file). */
fn _href_to_ax(href:str):str = (
  let n = len(href) in
  mut last = 0;
  mut cnt = 0;
  mut i = 0;
  while i < n do (
    if charCode(href, i) == 47 then (mut last = i; mut cnt = cnt + 1) else 0;
    mut i = i + 1
  );
  if cnt < 2 then ""
  else substr(href, last + 1, n - last - 1) + ".ax"
)

/* Explore link card */
fn render_explore_link(parent, href:str, title:str, hook:str) = (
  let a = dom_create("a") in
  dom_attr(a, "href", href);
  dom_style(a, "display", "block");
  dom_style(a, "padding", "16px");
  dom_style(a, "border", "1px solid #1a1a2a");
  dom_style(a, "borderRadius", "8px");
  dom_style(a, "background", "#0f0f18");
  dom_style(a, "textDecoration", "none");
  dom_style(a, "minWidth", "0");
  dom_style(a, "overflow", "hidden");
  dom_style(a, "wordBreak", "break-word");
  let t = dom_create("div") in
  dom_text(t, title);
  dom_style(t, "fontSize", "15px");
  dom_style(t, "color", "#d8d8e0");
  dom_append(a, t);
  let h = dom_create("div") in
  dom_text(h, hook);
  dom_style(h, "fontSize", "12px");
  dom_style(h, "color", "#a0a0b0");
  dom_style(h, "fontStyle", "italic");
  dom_style(h, "marginTop", "4px");
  dom_append(a, h);
  let fname = _href_to_ax(href) in
  if len(fname) > 0 then (
    let f = dom_create("div") in
    dom_text(f, fname);
    dom_style(f, "fontSize", "11px");
    dom_style(f, "color", "#555");
    dom_style(f, "marginTop", "2px");
    ct_mono(f);
    dom_append(a, f)
  ) else 0;
  dom_append(parent, a)
)

/* page_home() lives in pages_core.ax (home-module only) so the axiom
   summary helpers don't tax the other 6 modules. */

/* ================================================================
   TIER INDEX PAGES -- 6 rings, one per nav tier
   Click tier -> see all pages in that ring
   ================================================================ */

fn idx_hero(title:str, ring:str, desc:str) = (
  let sec = dom_create("section") in
  dom_style(sec, "textAlign", "center");
  dom_style(sec, "padding", "clamp(56px, 10vw, 80px) clamp(12px, 4vw, 24px) 20px");
  let h1 = dom_create("h1") in
  dom_text(h1, title);
  ct_heading(h1);
  dom_style(h1, "fontSize", "clamp(1.4em, 5vw, 2.2em)");
  dom_style(h1, "fontWeight", "normal");
  dom_append(sec, h1);
  let r = dom_create("div") in
  dom_text(r, ring);
  ct_mono(r);
  ct_gold(r);
  dom_style(r, "fontSize", "16px");
  dom_style(r, "marginBottom", "16px");
  dom_append(sec, r);
  render_p(sec, desc);
  dom_append(dom_body(), sec);
  0
)

fn idx_intro(text:str) = (
  let s = dom_create("section") in
  dom_style(s, "maxWidth", "680px");
  dom_style(s, "margin", "0 auto");
  dom_style(s, "padding", "0 16px 16px");
  render_p(s, text);
  dom_append(dom_body(), s)
)

fn idx_grid() = (
  let sec = make_section("900px") in
  let g = dom_create("div") in
  dom_attr(g, "class", "idx-grid");
  dom_style(g, "display", "grid");
  dom_style(g, "gridTemplateColumns", "1fr 1fr");
  dom_style(g, "gap", "12px");
  dom_style(g, "margin", "0 0 32px");
  dom_style(g, "width", "100%");
  dom_append(sec, g);
  dom_append(dom_body(), sec);
  g
)

