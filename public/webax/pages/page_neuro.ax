/* ================================================================
   PAGE: NEURO -- EEG = CRT, Cortical Layers, Hormones (MIND_NEURO.md)
   ================================================================ */

/* neuro helpers */

/* Dead functions neuro_hero through neuro_contrast deleted S1944.
   Page rewritten to minimal EEG band classifier + honest disclaimer. */

/* EEG band classifier: enter Hz, get band + axiom boundary */
fn neuro_band_calc() = (
  let hz = parse_int_from("#neuro-input") in
  let result = dom_query("#neuro-result") in
  if hz < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter frequency >= 1 Hz.</p>")
  else (
    let band = if hz < 4 then "Delta"
      else if hz < 8 then "Theta"
      else if hz < 13 then "Alpha"
      else if hz < 30 then "Beta"
      else "Gamma" in
    let boundary = if hz < 4 then "upper = D^2 = 4 Hz"
      else if hz < 8 then "upper = D^3 = 8 Hz"
      else if hz < 13 then "upper = GATE = 13 Hz"
      else if hz < 30 then "upper = D*K*E = 30 Hz"
      else "above 30 Hz (D*K*E)" in
    let meaning = if hz < 4 then "Deep sleep. Boundary = D^2 = 4 Hz."
      else if hz < 8 then "Drowsiness/meditation. Boundary = D^3 = 8 Hz."
      else if hz < 13 then "Relaxed awareness. Peak ~10 Hz = D*E."
      else if hz < 30 then "Active thinking. Boundary = D*K*E = 30 Hz."
      else "High-frequency oscillation. Above D*K*E = 30 Hz." in
    let dpower = if hz == 2 then " = D" else if hz == 4 then " = D^2" else if hz == 8 then " = D^3" else if hz == 16 then " = D^4" else if hz == 32 then " = D^5" else if hz == 10 then " = D*E (degree)" else if hz == 30 then " = D*K*E" else if hz == 40 then " = D^3*E" else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>${hz} Hz${dpower}</p><p style='margin:4px 0'>Band: <b style='color:#ffd700'>${band}</b></p><p style='margin:4px 0;color:#b8b8c8'>Boundary: ${boundary}</p><p style='margin:4px 0;color:#b0b0c0'>${meaning}</p>")
  )
)

fn page_neuro() = (
  dom_head_meta("description", "EEG frequency band boundaries and D-powers of 2. Interactive band classifier. Correspondences are numerically interesting but have no known causal mechanism.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"EEG and D-Powers\",\"description\":\"EEG frequency band boundaries and powers of 2. Interactive band classifier.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/ideas/neuro\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"EEG frequency bands\"}]}");
  let hero = make_hero("EEG and D-Powers") in
  let eq = dom_create("div") in
  dom_text(eq, "D^2 = 4, D^3 = 8, GATE = 13, D*K*E = 30");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Standard EEG frequency band boundaries (IFCN) coincide with powers of D=2 and axiom products: delta < 4(D^2), theta < 8(D^3), alpha < 13(GATE), beta < 30(D*K*E). The alpha peak at 10 Hz = D*E. These numerical matches are OBSERVED -- no causal mechanism connects ring arithmetic to neural oscillation frequencies.");
  dom_append(dom_body(), hero);
  let note = make_section("800px") in
  render_p(note, "NOTE: An earlier version of this page presented correspondences between ring structure and neuroscience (cortical layers, hemispheric coding, disease classification, myelination order, binding problem). Those are numerically interesting but have no known causal mechanism. Null model testing showed the expression space of prime-power products is dense -- numerical matches alone are not discriminating.");
  dom_append(dom_body(), note);
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: EEG Band Classifier");
  render_p(sec_i, "Enter a frequency in Hz. See which EEG band it falls in. Standard IFCN boundaries.");
  make_interactive_widget(sec_i, "Frequency (Hz):", "neuro-input", "e.g. 10", "Classify", "neuro_band_calc", "neuro-result");
  dom_append(dom_body(), sec_i)
)

