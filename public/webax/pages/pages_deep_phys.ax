/* pages_deep_phys.ax -- Deep physics: modular_forms, lie_algebra.
   blackhole, gravastar, neutron_star, force_hierarchy, boson_fermion cut S1934 (COINCIDENCE). */
/* Legendre symbol (p/23) -- tau(p) mod 23 classifier */
fn modform_legendre_calc() = (
  let p = parse_int_from("#mf-input") in
  let result = dom_query("#mf-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter a prime p >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else if p == 23 then dom_inner(result, "<p style='color:#d8d8e0'>p = 23 is the modulus itself (Ramanujan congruence prime). tau(23) mod 23 = 0 trivially.</p>")
  else (
    /* Compute p^11 mod 23 via Euler criterion: (p/23) = p^11 mod 23 */
    let r = p % 23 in
    mut acc = 1;
    mut i = 0;
    while i < 11 do (
      mut acc = acc * r % 23;
      mut i = i + 1
    );
    let leg = if acc == 1 then 1 else 0 in
    let chain = if leg > 0 then "<b style='color:#88ddaa'>INNER</b> (quadratic residue mod 23)" else "<b style='color:#ffd700'>OUTER</b> (non-residue mod 23)" in
    let tau_mod = if leg > 0 then "-1 (non-principal form 2x^2+xy+3y^2) or 2 (principal form x^2+xy+6y^2)" else "0" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>p = ${p}</p><p style='margin:4px 0'>Legendre (${p}/23): ${chain}</p><p style='margin:4px 0;color:#b8b8c8'>tau(${p}) mod 23 = ${tau_mod}</p><p style='margin:4px 0;color:#a0a0b0'>Inner (QR): {2, 3, 13, ...}. Outer (NR): {5, 7, 11, ...}.</p>")
  )
)

fn page_modular_forms() = (
  dom_head_meta("description", "Ramanujan tau function classifies all primes into 3 classes via h(-23)=3. The form 2x^2+xy+3y^2 represents the inner chain. 1728 = 12^3, 691, and the j-invariant share the same structure.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Modular Forms\",\"description\":\"Ramanujan tau classifies primes into 3 classes via h(-23)=3. Form 2x^2+xy+3y^2 represents the inner chain. 1728, 691, j-invariant share the same structure.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/modular_forms\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"modular forms\"},{\"@type\":\"DefinedTerm\",\"name\":\"Ramanujan tau\"},{\"@type\":\"DefinedTerm\",\"name\":\"number theory\"}]}");
  /* === HERO === */
  let hero = make_hero("Modular Forms") in
  let big = dom_create("div") in
  dom_text(big, "Delta = eta^24");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Modular forms are functions on the upper half-plane with extraordinary symmetry. The most famous is the discriminant Delta(tau), whose coefficients define the Ramanujan tau function. Reducing tau(p) modulo 23 classifies all primes into 3 classes, one per ideal class of Q(sqrt(-23)) where h(-23) = 3. The primes {2, 3, 5, 7, 11, 13} all sit in either the mirror class (-1) or the void class (0).");
  dom_append(dom_body(), hero);

  /* === SEC 1: TAU CLASSIFICATION === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Tau Classification");
  render_p(sec1, "For any prime p (except 23), Ramanujan's tau function satisfies: 23 divides tau(p) if and only if p is a quadratic non-residue mod 23. The Legendre symbol sorts the axiom chain:");
  let t1 = dom_create("table") in
  dom_style(t1, "width", "100%");
  dom_style(t1, "maxWidth", "700px");
  dom_style(t1, "margin", "24px auto");
  dom_style(t1, "borderCollapse", "collapse");
  let t1h = dom_create("tr") in
  render_th(t1h, "Prime p");
  render_th(t1h, "tau(p)");
  render_th(t1h, "tau(p) mod 23");
  render_th(t1h, "Class");
  dom_append(t1, t1h);
  render_table_row_4(t1, "2", "-24", "-1", "QR (inner)");
  render_table_row_4(t1, "3", "252", "-1", "QR (inner)");
  render_table_row_4(t1, "5", "4830", "0", "NR (outer)");
  render_table_row_4(t1, "7", "-16744", "0", "NR (outer)");
  render_table_row_4(t1, "11", "534612", "0", "NR (outer)");
  render_table_row_4(t1, "13", "-577738", "-1", "QR (inner)");
  dom_append(sec1, t1);
  render_p(sec1, "Inner primes {2, 3, 13} are quadratic residues mod 23. Outer primes {5, 7, 11} are non-residues. The Ramanujan congruence primes -- tau(n) has famous congruences at 5, 7, and 11 -- are exactly the outer class. All three hit tau mod 23 = 0.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: THREE-VALUE THEOREM === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Three-Value Theorem");
  render_theorem(sec2, "Three-Value Classification", "For primes p (not 23), tau(p) mod 23 takes exactly 3 values: {0, 2, -1}. The class number h(-23) = 3. Three classes: (1) Non-residue primes: tau = 0. (2) Residue primes on non-principal form 2x^2+xy+3y^2: tau = -1. (3) Residue primes on principal form x^2+xy+6y^2: tau = 2. All six primes {2,3,5,7,11,13} sit in class 1 or 2. The form 2x^2+xy+3y^2 represents 2 at (1,0), 3 at (0,1), 13 at (2,1). The first principal-form prime is 59. For all n: tau(n) mod 23 takes 4 values {0, 1, 2, -1}; 1 appears only at composites (tau(1) = 1).");
  dom_append(dom_body(), sec2);

  /* === SEC 2B: CLASS FIELD STRUCTURE === */
  let sec2b = make_section("800px") in
  render_h2(sec2b, "The (2, 1, 3) Form");
  render_p(sec2b, "Why 3 values? The imaginary quadratic field Q(sqrt(-23)) has class number h(-23) = 3. Its two quadratic forms of discriminant -23:");
  let g2b = make_findings_grid(sec2b) in
  render_finding(g2b, "Non-principal", "2x^2 + xy + 3y^2", "Coefficients (2, 1, 3). Represents 2 at (1,0), 3 at (0,1), 13 at (2,1).", "");
  render_finding(g2b, "Principal", "x^2 + xy + 6y^2", "Coefficients (1, 1, 6). First prime: 59, then 101, 167, 173...", "");
  render_finding(g2b, "23", "2*11 + 1", "Cunningham image of 11: c(11) = 23.", "");
  render_finding(g2b, "h(-23) = 3", "Class group = Z/3Z", "3 controls the splitting of primes in this field.", "");
  render_p(sec2b, "The Galois representation of Delta mod 23 is dihedral, induced from a Hecke character of Q(sqrt(-23)). For inert primes (NR): trace = 0. For split primes: trace depends on which of 3 ideal classes the prime above p falls into. Non-principal class: trace = -1. Principal class: trace = 2. The primes {2, 3, 13} all land in the non-principal class.");
  dom_append(dom_body(), sec2b);

  /* === SEC 3: THE NUMBER 1728 === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Number 1728");
  render_p(sec3, "The j-invariant normalization uses 1728 = 12^3. Delta = (E4^3 - E6^2) / 1728.");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "1728", "12^3 = (4 * 3)^3", "j-invariant normalization.", "");
  render_finding(g3, "12", "lcm(1, 2, 3, 4) = 12", "Weight of Delta. Carmichael lambda of Z/210.", "");
  render_finding(g3, "24", "2 * 12", "Leech lattice dimension. Exponent of eta in Delta = eta^24.", "");
  dom_append(dom_body(), sec3);

  /* === SEC 4: THE NUMBER 691 === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Number 691");
  render_p(sec4, "Ramanujan proved: tau(n) = sigma_11(n) mod 691. This is the deepest congruence of the discriminant modular form.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "691 mod 210", "61", "691 = 3 * 210 + 61.", "");
  render_finding(g4, "691 mod 23", "1", "Identity in the Cunningham field.", "");
  render_finding(g4, "Prime index", "691 = 125th prime", "125 = 5^3.", "");
  dom_append(dom_body(), sec4);

  /* === SEC 5: RING OF MODULAR FORMS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Ring of Modular Forms");
  render_p(sec5, "ALL modular forms are polynomials in just two generators: E4 (weight 4) and E6 (weight 6). Every Eisenstein weight is a D-multiple of a chain element:");
  let t5 = dom_create("table") in
  dom_style(t5, "width", "100%");
  dom_style(t5, "maxWidth", "700px");
  dom_style(t5, "margin", "24px auto");
  dom_style(t5, "borderCollapse", "collapse");
  let t5h = dom_create("tr") in
  render_th(t5h, "Form");
  render_th(t5h, "Weight");
  render_th(t5h, "Factorization");
  render_th(t5h, "Note");
  dom_append(t5, t5h);
  render_table_row_4(t5, "E4", "4", "2^2", "Generator 1");
  render_table_row_4(t5, "E6", "6", "2 * 3", "Generator 2");
  render_table_row_4(t5, "E8", "8", "2^3", "E8 Lie algebra rank");
  render_table_row_4(t5, "E10", "10", "2 * 5", "");
  render_table_row_4(t5, "E12", "12", "2^2 * 3", "Weight of Delta");
  render_table_row_4(t5, "E14", "14", "2 * 7", "");
  dom_append(sec5, t5);
  dom_append(dom_body(), sec5);

  /* === SEC 6: CUSP FORM DUALITY === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Cusp Form Duality");
  render_p(sec6, "Cusp forms = modular forms that vanish at the cusps. The space S_k has dimension:");
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "k = 12", "dim = 1", "Unique cusp form: Delta.", "");
  render_finding(g6, "k = 24", "dim = 2", "Two cusp forms at Leech lattice dimension.", "");
  render_finding(g6, "k < 12", "dim = 0", "No cusp forms below weight 12.", "");
  render_p(sec6, "The first cusp form appears at weight 12 = Carmichael lambda of Z/210. The same number 12 that bounds the partition smooth zone (see Eta Bridge page).");
  dom_append(dom_body(), sec6);

  /* === SEC 7: PARTITION-ETA THREAD === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "The Partition-Eta Thread");
  render_p(sec7, "The generating function for partitions is 1/eta(tau). The eta function's 24th power = Delta. 24 = 8 * 3 links three structures: the Cunningham chain c(n) = 2n+1, the Leech lattice (24 dimensions), and the modular form (eta^24 = Delta). The partition function p(n) is {2,3,5,7,11}-smooth for n <= 12. The unique cusp form has weight 12. Same number, same threshold.");
  dom_append(dom_body(), sec7);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Tau Classification");
  render_p(sec_i, "Enter a prime p. See its class: QR inner (tau = -1 or 2) or NR outer (tau = 0). The primes {2, 3, 13} are inner. {5, 7, 11} are outer. 59 is the first principal-form prime.");
  make_interactive_widget(sec_i, "Prime p:", "mf-input", "e.g. 7", "Classify", "modform_legendre_calc", "mf-result");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "Modular forms", "Abstract automorphic functions. 1728 and 691 appear from internal logic", "1728 = 12^3. 691 mod 210 = 61. Both factor through the ring's primes.");
  render_contrast_row(sec8, "Tau classification", "Coefficients of a q-series, studied for analytic properties", "tau(p) mod 23 sorts all primes into 3 classes (h(-23) = 3). Form coefficients = (2, 1, 3).");
  render_contrast_row(sec8, "Ramanujan congruences", "tau(n) has congruences at primes 5, 7, 11 (discovered empirically)", "Exactly {5, 7, 11} = the outer class mod 23 (non-residues).");
  render_contrast_row(sec8, "Why 1728?", "Normalization constant for j-invariant", "12^3. Weight 12 = Carmichael lambda of Z/210.");
  render_contrast_row(sec8, "Cusp form threshold", "First cusp form at weight 12", "12 = Carmichael lambda of Z/210 = partition smooth zone boundary.");
  dom_append(dom_body(), sec8)
)

/* Lie algebra tier lookup: input h, show tier info */
fn lie_tier_calc() = (
  let h = parse_int_from("#lie-input") in
  let result = dom_query("#lie-result") in
  if h < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter h >= 2 (even Coxeter number).</p>")
  else (
    let hp1 = h + 1 in
    let prime = is_prime_trial(hp1) in
    let ktier = if h % 6 == 0 then 1 else 0 in
    let pr_tag = if prime > 0 then "<span style='color:#88ddaa'>PRIME</span>" else "<span style='color:#ff6666'>composite</span>" in
    let kt_tag = if ktier > 0 then "<span style='color:#ffd700'>YES (h/2 = ${h / 2} divisible by 3)</span>" else "<span style='color:#b8b8c8'>No</span>" in
    let algebras = if h == 2 then "A1 (= SU(2), rank 1)"
      else if h == 4 then "A3, B2 (rank 2-3)"
      else if h == 6 then "A5, B3, C3, D4, <b style='color:#ffd700'>G2</b> (rank 2-4)"
      else if h == 10 then "A9, B5, C5, D6 (rank 5-9)"
      else if h == 12 then "B6, C6, D7, <b style='color:#ffd700'>E6</b>, <b style='color:#ffd700'>F4</b> (rank 4-7)"
      else if h == 16 then "B8, C8, D9 (rank 8-9)"
      else if h == 18 then "A17, B9, C9, <b style='color:#ffd700'>E7</b> (rank 7-17)"
      else if h == 30 then "<b style='color:#ffd700'>E8</b> alone (rank 8). Terminal tier."
      else "No axiom-complete algebras at this Coxeter number." in
    let boundary = if hp1 == 7 then " (G2 boundary)" else if hp1 == 13 then " (F4, E6 boundary)" else if hp1 == 19 then " (E7 boundary)" else if hp1 == 31 then " (E8 boundary)" else "" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Coxeter number h = ${h}</p><p style='margin:4px 0'>h+1 = <b>${hp1}</b>${boundary} &mdash; ${pr_tag}</p><p style='margin:4px 0'>K-tier: ${kt_tag}</p><p style='margin:4px 0'>Algebras: ${algebras}</p>")
  )
)

fn page_lie_algebra() = (
  dom_head_meta("description", "All five exceptional Lie algebras have 7-smooth root counts. E8 terminates at rank 8. Coxeter numbers relate to primes {7, 13, 19, 31}. Root systems through the ring.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Lie Algebras\",\"description\":\"Five exceptional Lie algebras have 7-smooth root counts. E8 terminates at rank 8. Coxeter boundary primes from the ring.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/lie_algebra\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Lie algebras\"},{\"@type\":\"DefinedTerm\",\"name\":\"root systems\"},{\"@type\":\"DefinedTerm\",\"name\":\"E8\"}]}");
  /* === HERO === */
  let hero = make_hero("Lie Algebra Census") in
  let big = dom_create("div") in
  dom_text(big, "rank(E8) = 8. All root counts are 7-smooth.");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "In 1894, Killing and Cartan classified all simple Lie algebras. Four infinite families (A, B, C, D) and five exceptions: G2, F4, E6, E7, E8. Every exceptional root count factors into {2, 3, 5, 7} only -- no prime above 7 appears. Their Coxeter numbers h are all divisible by 6, and h+1 is always prime. These patterns connect them to the ring Z/214,414,200.");
  dom_append(dom_body(), hero);

  /* === SEC 1: ROOT COUNT THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Root Count Theorem");
  render_p(sec1, "Every exceptional Lie algebra has a 7-smooth root count: factors entirely into {2, 3, 5, 7}. The prime 11 is absent from every root count.");
  let t1 = dom_create("table") in
  dom_style(t1, "width", "100%");
  dom_style(t1, "maxWidth", "700px");
  dom_style(t1, "margin", "24px auto");
  dom_style(t1, "borderCollapse", "collapse");
  let t1h = dom_create("tr") in
  render_th(t1h, "Algebra");
  render_th(t1h, "Rank");
  render_th(t1h, "Roots");
  render_th(t1h, "Factorization");
  render_th(t1h, "h+1");
  dom_append(t1, t1h);
  render_table_row_4(t1, "G2", "2", "12 = 2^2 * 3", "h+1 = 7 (prime)");
  render_table_row_4(t1, "F4", "4", "48 = 2^4 * 3", "h+1 = 13 (prime)");
  render_table_row_4(t1, "E6", "6", "72 = 2^3 * 3^2", "h+1 = 13 (prime)");
  render_table_row_4(t1, "E7", "7", "126 = 2 * 3^2 * 7", "h+1 = 19 (prime)");
  render_table_row_4(t1, "E8", "8", "240 = 2^4 * 3 * 5", "h+1 = 31 (prime)");
  dom_append(sec1, t1);
  render_p(sec1, "The factor 7 appears only in E7 (rank 7). The factor 5 appears only in E8 (rank 8). Coxeter h+1 is prime for all five, and all five have h divisible by 6.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: COXETER K-BOUNDARY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Coxeter Divisibility");
  render_theorem(sec2, "6-Divisibility", "For all five exceptional Lie algebras, h is divisible by 6: h/6 = {1, 2, 2, 3, 5}. The half-Coxeter numbers h/2 = {3, 6, 6, 9, 15} are all multiples of 3. And h+1 is always prime: {7, 13, 13, 19, 31}. These boundary primes are Cunningham images: 7=2*3+1, 13=2*6+1, 19=2*9+1, 31=2*15+1. At the non-6-divisible Coxeter numbers (h = 2, 4, 10, 16), no exceptional algebra appears.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: EIGHT TIERS === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Eight Tiers");
  render_p(sec3, "Group the simple Lie algebras by Coxeter number h where h+1 is prime. Eight tiers emerge:");
  let t3 = dom_create("table") in
  dom_style(t3, "width", "100%");
  dom_style(t3, "maxWidth", "700px");
  dom_style(t3, "margin", "24px auto");
  dom_style(t3, "borderCollapse", "collapse");
  let t3h = dom_create("tr") in
  render_th(t3h, "h");
  render_th(t3h, "h+1");
  render_th(t3h, "6 | h?");
  render_th(t3h, "Algebras");
  dom_append(t3, t3h);
  render_table_row_4(t3, "2", "3", "No", "A1");
  render_table_row_4(t3, "4", "5", "No", "A3, B2");
  render_table_row_4(t3, "6", "7", "Yes", "A5, B3, C3, D4, G2");
  render_table_row_4(t3, "10", "11", "No", "A9, B5, C5, D6");
  render_table_row_4(t3, "12", "13", "Yes", "B6, C6, D7, E6, F4");
  render_table_row_4(t3, "16", "17", "No", "B8, C8, D9");
  render_table_row_4(t3, "18", "19", "Yes", "A17, B9, C9, E7");
  render_table_row_4(t3, "30", "31", "Yes", "E8 (alone)");
  dom_append(sec3, t3);
  dom_append(dom_body(), sec3);

  /* === SEC 4: WHY E8 IS TERMINAL === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Why E8 Is Terminal");
  render_p(sec4, "E8 has rank 8 and Coxeter number h = 30. Here is why it is the last exceptional algebra.");
  let g4 = make_findings_grid(sec4) in
  render_finding(g4, "E8 rank", "8", "phi(30) = 8: the rank equals Euler's totient of the Coxeter number.", "");
  render_finding(g4, "E8 Coxeter", "h = 30 = 2 * 3 * 5", "Exponents = totatives of 30: {1, 7, 11, 13, 17, 19, 23, 29}.", "");
  render_finding(g4, "E8 roots", "240 = 2^4 * 3 * 5", "Only primes 2, 3, 5 appear. Primes 7, 11, 13 absent.", "");
  render_finding(g4, "E8 dim", "248 = 8 * 31", "rank * (h+1).", "");
  render_p(sec4, "Coxeter exponents of E8: {1, 7, 11, 13, 17, 19, 23, 29} = totatives of 30. Sum = 120 = half the roots. phi(30) = 8 = rank. The number of exponents IS the rank.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: DIMENSION LADDER === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Dimension Ladder");
  render_p(sec5, "dim = rank * (h+1). Every dimension factors through the boundary prime:");
  let t5 = dom_create("table") in
  dom_style(t5, "width", "100%");
  dom_style(t5, "maxWidth", "700px");
  dom_style(t5, "margin", "24px auto");
  dom_style(t5, "borderCollapse", "collapse");
  let t5h = dom_create("tr") in
  render_th(t5h, "Algebra");
  render_th(t5h, "rank * (h+1)");
  render_th(t5h, "dim");
  render_th(t5h, "Factorization");
  dom_append(t5, t5h);
  render_table_row_4(t5, "G2", "2 * 7", "14", "2 * 7");
  render_table_row_4(t5, "F4", "4 * 13", "52", "4 * 13");
  render_table_row_4(t5, "E6", "6 * 13", "78", "6 * 13");
  render_table_row_4(t5, "E7", "7 * 19", "133", "7 * 19");
  render_table_row_4(t5, "E8", "8 * 31", "248", "8 * 31");
  dom_append(sec5, t5);
  render_p(sec5, "Dimension differences: F4-G2 = 38 = 2*19. E6-F4 = 26 = 2*13. E7-E6 = 55 = 5*11. E8-E7 = 115 = 5*23.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: HYPOTHETICAL E9 === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Hypothetical E9");
  render_p(sec6, "If the E-series continued, E9 would have h = 42 = 2*3*7. Then h+1 = 43, a Heegner number and Cunningham image c(21) = 2*21+1. But E9 is infinite-dimensional (Kac-Moody). The boundary h+1 = 43 marks where finite exceptional Lie algebras end.");
  dom_append(dom_body(), sec6);

  /* === SEC 7: BETTI-LIE CORRESPONDENCE === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "b1-Lie Correspondence");
  render_theorem(sec7, "Betti-Lie Correspondence", "First Betti number b1(Z/p x Z/q) = (p-1)(q-1). For products of ring moduli: b1(8, 9) = 7*8 = 56 = dim(fund E7). b1(25, 11) = 24*10 = 240 = |roots(E8)|. PSL ladder: b1(3,7) = 12. b1(7,11) = 60 = icosahedron. b1(8,25) = 168 = |PSL(2,7)|. These are exactly the products of adjacent CRT moduli Z/8, Z/9, Z/25, Z/49, Z/11, Z/13.");
  dom_append(dom_body(), sec7);

  /* === INTERACTIVE: COXETER TIER EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Coxeter Tier Lookup");
  render_p(sec_i, "Enter a Coxeter number h (even). See h+1, 6-divisibility, and which algebras live on that tier. The eight tiers where h+1 is prime: h = {2, 4, 6, 10, 12, 16, 18, 30}.");
  make_interactive_widget(sec_i, "Coxeter number h:", "lie-input", "e.g. 6", "Look up", "lie_tier_calc", "lie-result");
  render_p(sec_i, "Try: 6 (G2 + 4 classical), 12 (F4 + E6 + 3 classical), 30 (E8 alone).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "Five exceptions", "G2, F4, E6, E7, E8 are sporadic anomalies", "All five have h divisible by 6 and h+1 prime. Not sporadic -- structurally linked.");
  render_contrast_row(sec8, "Why rank 8?", "E8 rank is 8. No structural reason usually given", "phi(30) = 8. The rank equals Euler's totient of the Coxeter number.");
  render_contrast_row(sec8, "Root counts", "Computed case by case from Dynkin diagrams", "All five exceptionals are 7-smooth. Prime 11 absent from every root count.");
  render_contrast_row(sec8, "Betti numbers", "Topological invariants of CW complexes", "b1(Z/p x Z/q) = (p-1)(q-1). Products of ring moduli give Lie dimensions.");
  dom_append(dom_body(), sec8)
)

