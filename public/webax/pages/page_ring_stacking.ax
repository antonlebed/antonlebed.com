/* ================================================================
   PAGE: RING STACKING -- Z/17 bridges bounded regions (BROSANO leads)
   ================================================================ */

fn rs_hero() = (
  let hero = make_hero("Ring Stacking") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/214414200 = Z/12612600 x Z/17");
  ct_mono(eq);
  dom_style(eq, "fontSize", "22px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The TRANS ring is not one ring -- it is two. The TRUE ring (Z/12612600) holds six channels of computation. The escape field (Z/17) holds the seventh. L, GATE, and ESCAPE are all fields (prime moduli), but only Z/17 dissolves suffering: E*b = 1 mod 17. The escape channel IS the bridge between bounded regions.");
  dom_append(dom_body(), hero)
)

fn rs_field_bridge() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Field Bridge");
  render_p(sec, "The seven channels of TRANS have different algebraic properties. Most have zero divisors -- information can be lost. Z/17 is unique:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus");
  render_th(hdr, "Zero Divisors");
  render_th(hdr, "Property");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D", "8", "2*4 = 0", "Ring (lossy)");
  render_table_row_4(tbl, "K", "9", "3*3 = 0", "Ring (lossy)");
  render_table_row_4(tbl, "E", "25", "5*5 = 0", "Ring (lossy)");
  render_table_row_4(tbl, "b", "49", "7*7 = 0", "Ring (lossy)");
  render_table_row_4(tbl, "L", "11", "none", "Field (lossless)");
  render_table_row_4(tbl, "GATE", "13", "none", "Field (lossless)");
  render_table_row_4(tbl, "ESCAPE", "17", "none", "Field (lossless)");
  render_p(sec, "L, GATE, and ESCAPE are all fields (prime moduli). But ESCAPE is special: E*b = 1 mod 17. Suffering dissolves to unity ONLY in the escape channel. No other prime has this property.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Unitarity", "Every Z/17 operation is invertible", "In quantum mechanics, unitarity means evolution preserves information. Z/17 has this algebraically: no zero divisors = no information lost.", "S1247");
  render_finding(g, "Coset selector", "N_TRANS / 17 = N_TRUE", "Each Z/17 residue class contains exactly 12612600 elements -- a complete copy of the TRUE ring. The escape channel selects WHICH copy.", "S1251");
  render_finding(g, "Finality", "E*b = 1 mod 17 is UNIQUE", "E*b mod 13 = 9. E*b mod 11 = 2. E*b mod 19 = 16. Only mod 17 does observer times depth equal identity.", "S1247");
  dom_append(dom_body(), sec)
)

fn rs_fingerprint() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Escape Fingerprint");
  render_p(sec, "Adding 17 (one escape step) to any TRANS element shifts each channel by a fixed amount. The fingerprint reveals structure:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Shift");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row(tbl, "D (mod 8)", "+1 = sigma", "Identity step");
  render_table_row(tbl, "K (mod 9)", "+8 = -1 (mirror)", "Mirror step");
  render_table_row(tbl, "E (mod 25)", "+17 = ESCAPE", "Self-reference");
  render_table_row(tbl, "b (mod 49)", "+17 = ESCAPE", "Self-reference");
  render_table_row(tbl, "L (mod 11)", "+6 = D*K", "Membrane");
  render_table_row(tbl, "GATE (mod 13)", "+4 = D^2", "Duality squared");
  render_table_row(tbl, "ESCAPE (mod 17)", "+0 (identity)", "Fixed point");
  render_p(sec, "D sees +sigma. K sees -sigma (mirror). The first two channels receive the axiom's bookends. The escape step IS the axiom written into channel shifts.");
  render_p(sec, "N_TRUE mod 17 = 11 = L. The TRUE ring leaves the protector's fingerprint on the escape channel.");
  dom_append(dom_body(), sec)
)

fn rs_inverse_scaling() = (
  let sec = make_section("800px") in
  render_h2(sec, "Inverse Scaling Law");
  render_p(sec, "The lambda-1680 lattice has 96 sub-rings sharing the maximal heartbeat. Each additional ring in a mesh multiplies cross-references exponentially, while cost grows linearly:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Rings");
  render_th(hdr, "Lattice Connections");
  render_th(hdr, "CRT Cost (ops)");
  render_th(hdr, "Value / Cost");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "96", "7", "13");
  render_table_row_4(tbl, "2", "9,216", "14", "658");
  render_table_row_4(tbl, "3", "884,736", "21", "42,130");
  render_table_row_4(tbl, "4", "84,934,656", "28", "3,033,380");
  render_p(sec, "Each new ring multiplies connections by 96 = D^5*K but costs only +7 ops (one CRT decomposition). The value/cost ratio EXPLODES. This is the mathematical basis for polyglot acceleration: each new domain costs the same but delivers exponentially more cross-references.");
  let g = make_findings_grid(sec) in
  render_finding(g, "96 = D^5 * K", "Lattice multiplier", "96 lambda-1680 sub-rings of TRANS. Density: 1/K^2 of all 864 divisors. Every 9th divisor shares the maximal heartbeat.", "S1248");
  render_finding(g, "Cost = 7 = b = depth", "CRT decomposition", "7 modular reductions per element, regardless of ring count. The cost of understanding IS the depth prime.", "");
  render_finding(g, "Polyglot acceleration", "Each domain more valuable", "Marginal value of the k-th ring = 96^k * 95 / 7. Grows exponentially. The 3rd language is harder to NOT learn than to learn.", "S1251");
  dom_append(dom_body(), sec)
)

fn rs_narrowing() = (
  let sec = make_section("800px") in
  render_h2(sec, "Channel Narrowing");
  render_p(sec, "Each CRT channel multiplicatively narrows the search space. Partial retrieval is already powerful:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channels Known");
  render_th(hdr, "Candidates Remaining");
  render_th(hdr, "Reduction");
  dom_append(tbl, hdr);
  render_table_row(tbl, "0 (none)", "214,414,200", "1x");
  render_table_row(tbl, "1 (D)", "26,801,775", "8x");
  render_table_row(tbl, "2 (D, K)", "2,977,975", "72x");
  render_table_row(tbl, "3 (D, K, E)", "119,119", "1,800x");
  render_table_row(tbl, "4 (D, K, E, b)", "2,431", "88,200x");
  render_table_row(tbl, "5 (D, K, E, b, L)", "221", "970,200x");
  render_table_row(tbl, "6 (+GATE)", "17", "12,612,600x");
  render_table_row(tbl, "7 (+ESCAPE)", "1", "214,414,200x");
  render_p(sec, "After 3 channels you have narrowed by 1,800x. After 6, only 17 candidates remain -- one per Z/17 coset. The escape channel resolves the final ambiguity.");
  render_p(sec, "Sharing 3 outer channels (L + GATE + ESCAPE) between two systems gives N / (11*13*17) = 88,200 = D^3*K^2*E^2*b^2 = exactly the DEEP ring without L. The outer channels recover the inner data channels. This IS the 490 holographic split.");
  dom_append(dom_body(), sec)
)

fn rs_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Inter-system bridge", "Shared API, protocol negotiation", "Z/17 field -- algebraically lossless. Every operation invertible. No protocol needed.");
  render_contrast_row(tbl, "Cross-reference scaling", "Linear (each new source = additive)", "Exponential. k rings = 96^k lattice connections. Polyglot acceleration is structural.");
  render_contrast_row(tbl, "Partial information", "Lossy compression, approximation", "CRT channels are independent projections. 3 channels = 1800x narrowing. Exact, not approximate.");
  render_contrast_row(tbl, "Error detection", "Checksums added externally", "L + GATE + ESCAPE = triple-parity ECC built into the ring. Rate 4/7, 100% single-channel correction.");
  render_contrast_row(tbl, "Information preservation", "Unitarity assumed (physics) or enforced (crypto)", "Z/17 is a field. Invertibility is algebraic, not assumed. E*b = 1 mod 17: suffering dissolves to identity.");
  dom_append(dom_body(), sec)
)

/* === INTERACTIVE: CRT Bridge Explorer === */
fn rs_bridge_explore() = (
  let n = parse_int_from("#rs-input") in
  let nn = n % 214414200 in
  let result = dom_query("#rs-result") in
  let rd = nn % 8 in let rk = nn % 9 in let re = nn % 25 in
  let rb = nn % 49 in let rl = nn % 11 in let rg = nn % 13 in let r17 = nn % 17 in
  /* After adding 17 (one escape step) */
  let nn2 = (nn + 17) % 214414200 in
  let rd2 = nn2 % 8 in let rk2 = nn2 % 9 in let re2 = nn2 % 25 in
  let rb2 = nn2 % 49 in let rl2 = nn2 % 11 in let rg2 = nn2 % 13 in let r172 = nn2 % 17 in
  dom_inner(result,
    "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>"
    + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>CRT BRIDGE: " + "${nn}" + " in Z/214414200</p>"
    + "<table style='width:100%;border-collapse:collapse'>"
    + "<tr style='border-bottom:1px solid #444'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Value</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>+ 17</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Shift</th></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>D (mod 8)</td><td style='padding:3px;color:#88ddaa'>" + "${rd}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${rd2}" + "</td><td style='padding:3px;color:#b0b0c0'>+1 (sigma)</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>K (mod 9)</td><td style='padding:3px;color:#88ddaa'>" + "${rk}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${rk2}" + "</td><td style='padding:3px;color:#b0b0c0'>+8 (mirror)</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>E (mod 25)</td><td style='padding:3px;color:#88ddaa'>" + "${re}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${re2}" + "</td><td style='padding:3px;color:#b0b0c0'>+17 (escape)</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>b (mod 49)</td><td style='padding:3px;color:#88ddaa'>" + "${rb}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${rb2}" + "</td><td style='padding:3px;color:#b0b0c0'>+17 (escape)</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>L (mod 11)</td><td style='padding:3px;color:#88ddaa'>" + "${rl}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${rl2}" + "</td><td style='padding:3px;color:#b0b0c0'>+6 (D*K)</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>GATE (mod 13)</td><td style='padding:3px;color:#88ddaa'>" + "${rg}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${rg2}" + "</td><td style='padding:3px;color:#b0b0c0'>+4 (D^2)</td></tr>"
    + "<tr style='border-top:1px solid #444'><td style='padding:3px;color:#88aaff;font-size:12px'>ESCAPE (mod 17)</td><td style='padding:3px;color:#88ddaa'>" + "${r17}" + "</td><td style='padding:3px;color:#aaddcc'>" + "${r172}" + "</td><td style='padding:3px;color:#b0b0c0'>+0 (fixed)</td></tr>"
    + "</table>"
    + "<p style='color:#b0b0c0;margin:12px 0 4px;font-size:12px'><span style='color:#88aaff'>ESCAPE coset " + "${r17}" + "</span> of 17: this element lives in TRUE-ring copy #" + "${r17}" + ". Adding 17 changes the TRUE channels but preserves the escape address.</p>"
    + "<p style='color:#b0b0c0;margin:4px 0 0;font-size:12px'>Channels narrowed: 1ch=" + "${rd}" + "->26.8M | 2ch->3.0M | 3ch->119K | 6ch->17 | 7ch-><span style='color:#ffd700'>1 (unique)</span></p>"
    + "</div>")
)

/* === INTERACTIVE: Scaling Calculator === */
fn rs_scaling_calc() = (
  let k = parse_int_from("#rs-scale-input") in
  let kk = if k < 1 then 1 else if k > 4 then 4 else k in
  let result = dom_query("#rs-scale-result") in
  /* Compute 96^k iteratively (cap at 4: 96^5 overflows i32) */
  mut pv = 1;
  mut ci = 0;
  while ci < kk do (
    mut pv = pv * 96;
    mut ci = ci + 1
  );
  let connections = pv in
  let cost = kk * 7 in
  let ratio = connections / cost in
  /* Marginal value for ring k vs k-1 */
  mut pv_prev = 1;
  mut ci2 = 0;
  while ci2 < kk - 1 do (
    mut pv_prev = pv_prev * 96;
    mut ci2 = ci2 + 1
  );
  let marginal = (connections - pv_prev) / 7 in
  dom_inner(result,
    "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>"
    + "<p style='color:#ffd700;margin:0 0 12px;font-size:16px'>RING MESH: " + "${kk}" + " rings</p>"
    + "<table style='width:100%;border-collapse:collapse'>"
    + "<tr style='border-bottom:1px solid #444'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Metric</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Value</th></tr>"
    + "<tr><td style='padding:3px;color:#b0b0c0;font-size:12px'>Lattice connections (96^k)</td><td style='padding:3px;color:#88ddaa'>" + "${connections}" + "</td></tr>"
    + "<tr><td style='padding:3px;color:#b0b0c0;font-size:12px'>CRT cost (7k ops)</td><td style='padding:3px;color:#88ddaa'>" + "${cost}" + "</td></tr>"
    + "<tr><td style='padding:3px;color:#b0b0c0;font-size:12px'>Value / Cost ratio</td><td style='padding:3px;color:#ffd700;font-size:14px'>" + "${ratio}" + "</td></tr>"
    + "<tr><td style='padding:3px;color:#b0b0c0;font-size:12px'>Marginal value of ring " + "${kk}" + "</td><td style='padding:3px;color:#88ddaa'>" + "${marginal}" + "</td></tr>"
    + "</table>"
    + "<p style='color:#b0b0c0;margin:12px 0 0;font-size:12px'>Growth: ~96x per ring. Each new domain delivers exponentially more cross-references at constant cost. The polyglot advantage is structural, not cultural.</p>"
    + "</div>")
)

fn page_ring_stacking() = (
  dom_head_meta("description", "Z/17 bridges bounded regions. The escape channel is a field: zero information loss. 96^k lattice connections vs 7k CRT cost. Ring stacking = polyglot acceleration. Interactive CRT bridge explorer and scaling calculator.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Ring Stacking\",\"description\":\"Z/17 as algebraic bridge between bounded regions. Field property = unitarity. Inverse scaling law: 96^k connections at 7k cost. CRT channel narrowing. Interactive demos.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/structure/ring_stacking\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"ring stacking\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT bridge\"},{\"@type\":\"DefinedTerm\",\"name\":\"inverse scaling\"}]}");
  rs_hero();
  rs_field_bridge();
  rs_fingerprint();
  rs_inverse_scaling();
  rs_narrowing();
  rs_contrast();

  /* === INTERACTIVE: CRT Bridge Explorer === */
  let sec_b = make_section("800px") in
  render_h2(sec_b, "Explore: CRT Bridge");
  render_p(sec_b, "Enter any number to see its 7-channel CRT decomposition and what happens when you add 17 (one escape step). The escape channel stays fixed while all TRUE channels shift.");
  make_interactive_widget(sec_b, "Value:", "rs-input", "e.g. 42", "Analyze", "rs_bridge_explore", "rs-result");
  render_p(sec_b, "Try: 42 (ANSWER), 1576576 (OMEGA), 420 (lambda), 137 (ADDRESS), 214414199 (mirror).");
  dom_append(dom_body(), sec_b);

  /* === INTERACTIVE: Scaling Calculator === */
  let sec_s = make_section("800px") in
  render_h2(sec_s, "Explore: Inverse Scaling");
  render_p(sec_s, "Enter the number of rings in a mesh to see how cross-references explode while cost grows linearly.");
  make_interactive_widget(sec_s, "Number of rings (1-4):", "rs-scale-input", "e.g. 3", "Calculate", "rs_scaling_calc", "rs-scale-result");
  render_p(sec_s, "At k=3, the value/cost ratio is 42,130. At k=4, it reaches 3,033,380. Each ring multiplies connections by 96.");
  dom_append(dom_body(), sec_s)
)
