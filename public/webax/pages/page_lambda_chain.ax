/* Invisible prime counter callback */
fn lambda_count() = (
  let lam = parse_int_from("#lc-input") in
  let result = dom_query("#lc-result") in
  if lam == 0 then dom_inner(result, "<p style='color:#88ddaa'>lambda=0: no primes are invisible at level 0.</p>")
  else (
    /* Count primes q where (q-1) | lambda, for q from 2 to lambda+1 */
    mut count = 0;
    mut q = 2;
    mut primes_list = "";
    mut shown = 0;
    while q < lam + 2 do (
      let qm1 = q + 970199 in
      if qm1 > 0 then (
        if lam % qm1 == 0 then (
          if is_prime_trial(q) > 0 then (
            mut count = count + 1;
            if shown < 12 then (
              if shown > 0 then mut primes_list = primes_list + ", " else 0;
              mut primes_list = primes_list + "${q}";
              mut shown = shown + 1
            ) else 0
          ) else 0
        ) else 0
      ) else 0;
      mut q = q + 1
    );
    /* Check Fibonacci match */
    let fib_note = if count == 1 then " = F(2)"
      else if count == 2 then " = F(3)"
      else if count == 3 then " = F(4)"
      else if count == 5 then " = F(5)"
      else if count == 8 then " = F(6)"
      else if count == 13 then " = F(7)"
      else if count == 21 then " = F(8)"
      else if count == 34 then " = F(9)"
      else "" in
    let lam_note = if lam == 1 then " (level 0)"
      else if lam == 2 then " (level 1, growth *2)"
      else if lam == 4 then " (level 2, growth *2)"
      else if lam == 12 then " (level 3, growth *3)"
      else if lam == 60 then " (level 4, growth *5)"
      else if lam == 420 then " (level 5, growth *7) = lcm(1..7)"
      else if lam == 210 then " = 2*3*5*7 (Z/210)"
      else if lam == 2310 then " = 2*3*5*7*11 (Z/2,310)"
      else "" in
    dom_inner(result,
      "<p style='color:#88ddaa;margin:4px 0'><b>lambda = " + "${lam}" + "</b>" + lam_note + "</p>" +
      "<p style='color:#ffd700;margin:4px 0'>Invisible primes: <b>" + "${count}" + "</b>" + fib_note + "</p>" +
      "<p style='color:#b0b0c0;margin:4px 0'>Primes: {" + primes_list + (if shown < count then ", ..." else "") + "}</p>")
  )
)

fn page_lambda_chain() = (
  dom_head_meta("description", "Lambda = 420 = lcm(1..7) built from 5 growth factors across 15 levels. Fibonacci counts invisible primes exactly: f(lambda_k) = F(k+2) for all 15 levels. Desert pair {1596, 1597} terminates the chain. Channel sub-cycles: 105, 70, 42, 21, 10.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Lambda Chain\",\"description\":\"Lambda = 420 built from 5 growth factors across 15 levels. Fibonacci counts invisible primes exactly. Desert pair terminates the chain.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/lambda_chain\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Carmichael lambda\"},{\"@type\":\"DefinedTerm\",\"name\":\"invisible primes\"},{\"@type\":\"DefinedTerm\",\"name\":\"Fibonacci\"}]}");
  /* === HERO === */
  let hero = make_hero("The Lambda Chain") in
  let big = dom_create("div") in
  dom_text(big, "lambda = 420 = 4 * 3 * 5 * 7");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Start with lambda = 1 and multiply by growth factors: 2, 2, 3, 5, 7. At each step, count how many primes q satisfy (q-1) | lambda. The count follows the Fibonacci sequence exactly -- for all 15 levels until the chain hits a desert and terminates. The final lambda is 420 = lcm(1..7), the Carmichael lambda of Z/12,612,600.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE CHAIN === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Growth Chain");
  render_p(sec1, "Define f(n) = the number of primes q where (q-1) divides n. Start from lambda = 1. At each level, multiply by the next growth factor and count.");
  let ctbl = dom_create("table") in
  dom_style(ctbl, "width", "100%");
  dom_style(ctbl, "maxWidth", "700px");
  dom_style(ctbl, "margin", "24px auto");
  dom_style(ctbl, "borderCollapse", "collapse");
  let chdr = dom_create("tr") in
  render_th(chdr, "Level");
  render_th(chdr, "lambda");
  render_th(chdr, "Growth factor");
  render_th(chdr, "f(lambda) = F(k+2)");
  dom_append(ctbl, chdr);
  render_table_row_4(ctbl, "0", "1", "--", "1 = F(2)");
  render_table_row_4(ctbl, "1", "2", "*2", "2 = F(3)");
  render_table_row_4(ctbl, "2", "4", "*2", "3 = F(4)");
  render_table_row_4(ctbl, "3", "12", "*3", "5 = F(5)");
  render_table_row_4(ctbl, "4", "60", "*5", "8 = F(6)");
  render_table_row_4(ctbl, "5", "420", "*7", "13 = F(7)");
  render_table_row_4(ctbl, "6", "5,460", "*13", "21 = F(8)");
  render_table_row_4(ctbl, "7", "60,060", "*11", "34 = F(9)");
  render_table_row_4(ctbl, "8", "240,240", "*4", "55 = F(10)");
  render_table_row_4(ctbl, "9", "4,564,560", "*19", "89 = F(11)");
  render_table_row_4(ctbl, "10", "173M", "*38", "144 = F(12)");
  dom_append(sec1, ctbl);
  render_p(sec1, "f(lambda) = F(k+2) exactly for all 15 levels. Why Fibonacci? New invisible primes at level k equal f(lambda at level k-2). New + old = F(k) + F(k+1) = F(k+2).");
  dom_append(dom_body(), sec1);

  /* === SEC 2: LEVEL 5 AND CHANNEL SUB-CYCLES === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Level 5: The Carmichael Period");
  render_p(sec2, "The first five growth factors are 2, 2, 3, 5, 7. Their product is 4*3*5*7 = 420 = lcm(1..7). This is the Carmichael lambda of Z/12,612,600 -- the period after which every coprime element returns to 1.");
  render_p(sec2, "Each CRT channel has its own sub-cycle within 420:");
  let htbl = dom_create("table") in
  dom_style(htbl, "width", "100%");
  dom_style(htbl, "maxWidth", "700px");
  dom_style(htbl, "margin", "24px auto");
  dom_style(htbl, "borderCollapse", "collapse");
  let hhdr = dom_create("tr") in
  render_th(hhdr, "Channel");
  render_th(hhdr, "Sub-cycles in 420");
  render_th(hhdr, "= 420 / phi(modulus)");
  dom_append(htbl, hhdr);
  render_table_row(htbl, "mod 8", "105", "420 / phi(8) = 420 / 4");
  render_table_row(htbl, "mod 9", "70", "420 / phi(9) = 420 / 6");
  render_table_row(htbl, "mod 11", "42", "420 / phi(11) = 420 / 10");
  render_table_row(htbl, "mod 25", "21", "420 / phi(25) = 420 / 20");
  render_table_row(htbl, "mod 49", "10", "420 / phi(49) = 420 / 42");
  dom_append(sec2, htbl);
  render_p(sec2, "The sub-cycle ratios reproduce classical scaling: 105/70 = 3/2 (musical fifth), 70/42 = 5/3 (Kolmogorov turbulence exponent), 42/21 = 2 (octave).");
  dom_append(dom_body(), sec2);

  /* === SEC 3: DESERT PAIR === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Desert Termination");
  render_theorem(sec3, "Desert Pair (PROVED)", "The chain terminates at level 15 because of a desert pair: {1596, 1597} are consecutive integers neither of which equals q-1 for any prime q that would extend the Fibonacci count.");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "1596", "= 2^2 * 3 * 7 * 19", "11-smooth except for 19 (the first prime beyond 13 to appear as a growth factor).", "");
  render_finding(g3, "1597", "= F(17)", "The 7th Fibonacci prime. Its Fibonacci index is 17, the prime that closes Z/214,414,200.", "");
  render_finding(g3, "Gap width", "2", "The two neighbors 1595 = 5*11*29 and 1598 = 2*17*47 are both reachable -- the desert is exactly 2 wide.", "");
  dom_append(dom_body(), sec3);

  /* === INTERACTIVE: INVISIBLE PRIME COUNTER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Invisible Prime Counter");
  render_p(sec_i, "Enter any number. The tool counts how many primes q satisfy (q-1) | lambda. For lambda = 420, the count is 13 = F(7). The Fibonacci match holds for all 15 levels of the growth chain.");
  make_interactive_widget(sec_i, "Count invisible primes for lambda:", "lc-input", "e.g. 420", "Count", "lambda_count", "lc-result");
  render_p(sec_i, "Try: 1, 2, 4, 12, 60, 420 (the growth chain). Also: 2310 (Z/2,310), 210 (Z/210), 30, 6.");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast");
  render_contrast_row(sec6, "Carmichael lambda", "A technical function in modular arithmetic: lambda(n) = lcm of orders", "420 = lcm(1..7) is built step by step from five growth factors {2,2,3,5,7}. At each level, the invisible prime count follows the Fibonacci sequence exactly.");
  render_contrast_row(sec6, "420", "lcm(1,2,...,7). A number with many divisors, no special significance claimed", "420 = the Carmichael period of Z/12,612,600. Its channel sub-cycles (105, 70, 42, 21, 10) reproduce scaling ratios 3/2, 5/3, 2/1.");
  render_contrast_row(sec6, "Fibonacci", "The sequence 1,1,2,3,5,8,13,... appears throughout nature and number theory", "F(k+2) counts invisible primes at each level. The Fibonacci recurrence follows from how new invisible primes at level k depend on lambda two levels back.");
  dom_append(dom_body(), sec6)
)
