/* Gaussian norm widget: |D^n + Ki|^2 = 4^n + 9 */
fn gauss_norm_calc() = (
  let n = parse_int_from("#gauss-input") in
  let result = dom_query("#gauss-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    /* compute 4^n + 9 via repeated squaring */
    mut pow4 = 1;
    mut i = 0;
    while i < n do (
      mut pow4 = pow4 * 4;
      mut i = i + 1
    );
    let norm = pow4 + 9 in
    let even = n % 2 == 0 in
    let e_filter = if even then "<span style='color:#ff6666'>BLOCKED: even n makes 4^n + 9 divisible by 5</span>"
      else "<span style='color:#88ddaa'>Passes: odd n, not divisible by 5</span>" in
    /* trial division for small primes */
    mut is_prime = 1;
    mut d = 2;
    while d * d < norm + 1 do (
      if norm % d == 0 then (mut is_prime = 0) else 0;
      mut d = d + 1
    );
    let prime_str = if norm < 4 then "PRIME"
      else if is_prime > 0 then "<span style='color:#ffd700'>PRIME</span>"
      else "<span style='color:#b0b0c0'>composite</span>" in
    dom_inner(result,
      "<p style='color:#d8d8e0;margin:4px 0'>|2^" + "${n}" + " + 3i|^2 = 4^" + "${n}" + " + 9 = <span style='color:#ffd700;font-size:18px'>" + "${norm}" + "</span></p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>" + e_filter + "</p>"
      + "<p style='color:#d8d8e0;margin:4px 0'>Primality: " + prime_str + "</p>")
  )
)

fn page_d_power_gaussian() = (
  dom_head_meta("description", "Gaussian norms |2^n + 3i|^2 = 4^n + 9. First value 13 (prime). Prime at n = 1, 3, 5, 9, 15. Mod-5 filter blocks even n. Mod-24 covering classification. Covering sum 462 = 2*3*7*11.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Powers of 2 in Z[i]\",\"description\":\"Gaussian norms |2^n+3i|^2=4^n+9. First value 13. Prime at n=1,3,5,9,15. Mod-5 filter, mod-24 covering classification.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/d_power_gaussian\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Gaussian integers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gaussian norm\"},{\"@type\":\"DefinedTerm\",\"name\":\"covering primes\"}]}");
  /* === HERO === */
  let hero = make_hero("Powers of 2 in Z[i]") in
  let big = dom_create("div") in
  dom_text(big, "|2^n + 3i|^2 = 4^n + 9");
  ct_mono(big);
  dom_style(big, "fontSize", "28px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Take the Gaussian integer 2^n + 3i in Z[i]. Its squared norm is |2^n + 3i|^2 = 4^n + 9. The first value: |2 + 3i|^2 = 4 + 9 = 13, which is prime. This family of norms connects powers of 2, the prime 3, and Gaussian arithmetic. Every prime factor of any value must be congruent to 1 mod 4 (Fermat's theorem on sums of coprime squares).");
  dom_append(dom_body(), hero);

  /* === SEC 1: PRIME VALUES === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Prime Values");
  render_p(sec1, "|2^n + 3i|^2 is prime at exactly these positions:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "n = 1", "13", "Prime. The first value of the family.", "");
  render_finding(g1, "n = 3", "73", "Prime. 4^3 + 9 = 73.", "");
  render_finding(g1, "n = 5", "1033", "Prime. 4^5 + 9 = 1033.", "");
  render_finding(g1, "n = 9", "262153", "Prime. 4^9 + 9 = 262153.", "");
  render_finding(g1, "n = 15", "1073741833", "Prime. 4^15 + 9.", "");
  render_p(sec1, "Prime positions: {1, 3, 5, 9, 15}. Gaps between positions: {2, 2, 4, 6}. All prime positions are odd -- even n always gives a multiple of 5.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: E-FILTER === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Mod-5 Filter");
  render_theorem(sec2, "Mod-5 Filter (PROVED)", "5 divides |2^n + 3i|^2 if and only if n is even. Proof: 4^n mod 5 has period 2: {4, 1, 4, 1, ...}. Even n: 4^n + 9 = 1 + 4 = 0 mod 5. Odd n: 4 + 4 = 3 mod 5 (nonzero). QED.");
  render_p(sec2, "5 systematically blocks even indices. Only odd n can produce primes.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: COVERING VOCABULARY === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Covering Primes");
  render_p(sec3, "Each covering prime q divides 4^n + 9 for some n. Restricted to odd n, the first 6 covering primes and their periods:");
  let ctbl = make_table(sec3) in
  let chdr = dom_create("tr") in
  render_th(chdr, "Prime q");
  render_th(chdr, "Period");
  render_th(chdr, "First odd n");
  dom_append(ctbl, chdr);
  render_table_row(ctbl, "13", "6", "1");
  render_table_row(ctbl, "37", "18", "17");
  render_table_row(ctbl, "61", "30", "21");
  render_table_row(ctbl, "73", "9", "3");
  render_table_row(ctbl, "97", "24", "7");
  render_table_row(ctbl, "181", "90", "11");
  render_p(sec3, "All six periods factor into {2, 3, 5} only. The first odd residues {1, 3, 7, 11, 17, 21} all factor into chain primes (21 = 3*7).");
  dom_append(dom_body(), sec3);

  /* === SEC 4: COVERING SUM + SELF-BLINDNESS === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The Covering Sum");
  render_theorem(sec4, "Covering Sum (PROVED)", "13 + 37 + 61 + 73 + 97 + 181 = 462 = 2 * 3 * 7 * 11. The sum factors entirely into chain primes, with 5 absent. The same prime that blocks even indices (the mod-5 filter) is missing from the covering sum.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: DEPTH AND GATE === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "Periodicity of 13");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "|2^7 + 3i|^2", "= 16393 = 169 * 97", "At n = 7: the norm is 13^2 times 97.", "");
  render_finding(g5, "13 divides", "iff n = 1 mod 6", "ord_13(4) = 6. The first value (n=1) gives 13, and it recurs every 6 steps.", "");
  render_finding(g5, "169 divides", "iff n = 7 mod 78", "ord_169(4) = 78 = 6 * 13. The squared divisibility has period 78.", "");
  render_finding(g5, "Non-covering primes", "{17, 41, 109, 137}", "These primes never divide any 4^n + 9.", "");
  dom_append(dom_body(), sec5);

  /* === SEC 6: MOD-24 THEOREM === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Mod-24 Classification");
  render_theorem(sec6, "Mod-24 Classification (PROVED)", "Among index-2 primes (2 is a primitive root, q = 5 mod 8): ODD-covering (divides 4^n+9 for some odd n) iff q = 13 mod 24. EVEN-covering (divides only for even n) iff q = 5 mod 24. Verified: 55/55 odd-covering, 74/74 even-covering.");
  render_p(sec6, "Three-way classification: ODD-covering 25%, EVEN-covering 28%, NON-covering 47%. Densities stable across all bounds tested.");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE: GAUSSIAN NORM EXPLORER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Gaussian Norms");
  render_p(sec_i, "Enter n to compute |2^n + 3i|^2 = 4^n + 9. Check primality and the mod-5 filter.");
  make_interactive_widget(sec_i, "Enter n (1-25):", "gauss-input", "e.g. 5", "Compute", "gauss_norm_calc", "gauss-result");
  render_p(sec_i, "Try: n=1 (13, prime), n=3 (73, prime), n=5 (1033, prime), n=9 (prime), n=2 (even, blocked by 5).");
  dom_append(dom_body(), sec_i);

  /* === SEC 7: CONTRAST === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "Contrast");
  let ctbl7 = make_table(sec7) in
  let ch7 = dom_create("tr") in
  render_th(ch7, "Aspect");
  render_th(ch7, "Standard view");
  render_th(ch7, "Ring structure");
  dom_append(ctbl7, ch7);
  render_contrast_row(ctbl7, "Gaussian norms", "Z[i] norms factor into primes 1 mod 4", "The family 4^n + 9 has prime values at n = 1, 3, 5, 9, 15 -- all odd");
  render_contrast_row(ctbl7, "First value", "4 + 9 = 13, the sixth prime", "|2 + 3i|^2 = 13, a chain prime of Z/214,414,200");
  render_contrast_row(ctbl7, "Covering sum", "462 is a sum of six primes", "462 = 2 * 3 * 7 * 11. Factors into chain primes; 5 is absent");
  render_contrast_row(ctbl7, "Mod-24", "Quadratic residue classification", "13 mod 24 selects odd-covering primes, 5 mod 24 selects even-covering");
  dom_append(dom_body(), sec7)
)
