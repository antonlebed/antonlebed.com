/* page_bridge_het.ax -- Bridge 2: Heterogeneous channel encoding (S1914).
   Tests whether encoding DIFFERENT text features per channel (structural,
   phonemic, identity, bigram transition) improves prediction over
   homogeneous char%q encoding. Result: +16% per-channel, -1.3% reconstruction.
   490 split confirmed: DEAD channels +48% in het, ALIVE channels -4%. */

fn page_bridge_het() = (
  let hero = make_section("800px") in
  render_h2(hero, "Bridge 2: Heterogeneous Channels");
  render_p(hero, "F1 and Bridge 1 encoded text as char mod q in every channel -- 7 projections of the SAME signal. Bridge 2 makes each channel encode a DIFFERENT feature: structural type, phonemic class, character identity, and bigram transition class.");
  render_p(hero, "If channels specialize, the 490 split (DEAD=perception, ALIVE=strategy) becomes real structure, not just algebra.");
  dom_append(dom_body(), hero);

  -- Encoding design
  let sec1 = make_section("800px") in
  render_h2(sec1, "Het Encoding Design");
  render_p(sec1, "Each channel encodes a different LEVEL of text structure. D5 lesson: both input AND target must be het (het input + homo target fails).");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "D (mod 8)", "Structural type", "space=0, lower vowel=1, lower cons=2, upper vowel=3, upper cons=4, digit=5, punct=6, other=7", "");
  render_finding(g1, "K (mod 9)", "Phonemic class", "space=0, plosive=1, fricative=2, nasal=3, liquid=4, glide=5, affricate=6, vowel=7, other=8", "");
  render_finding(g1, "E (mod 25)", "Character identity", "Top 25 chars by English frequency (case-insensitive). space=0, e=1, t=2, ..., j=23, other=24", "");
  render_finding(g1, "b (mod 49)", "Bigram transition", "coarse(prev)*7 + coarse(cur). 7 coarse types crossed. Encodes the TRANSITION, not the character.", "");
  render_finding(g1, "L/GATE/ESC", "ECC channels", "Weighted sums of D,K,E,b: L=(d+k+e+b)%11, GATE=(2d+3k+5e+7b)%13, ESC=(d+2k+4e+8b)%17", "");
  dom_append(dom_body(), sec1);

  -- Results
  let sec2 = make_section("800px") in
  render_h2(sec2, "Results");
  render_p(sec2, "Per-channel bigram tallies on the same 471-character corpus. Given prev char's encoding, predict next char's encoding. Reconstruct via majority vote over 128 candidates.");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "Het ch_score", "1205/3290 (36.6%)", "Per-channel prediction. +170 over homo (+16.4%). Channels SPECIALIZE.", "");
  render_finding(g2, "Homo ch_score", "1035/3290 (31.5%)", "Homogeneous char%q. All channels see same signal.", "");
  render_finding(g2, "Het accuracy", "124/470 (26.4%)", "Reconstruction from het features. -6 vs homo.", "");
  render_finding(g2, "Homo accuracy", "130/470 (27.7%)", "CRT algebraic uniqueness beats feature voting.", "");
  dom_append(dom_body(), sec2);

  -- 490 split
  let sec3 = make_section("800px") in
  render_h2(sec3, "The 490 Split Is Real");
  render_p(sec3, "DEAD={D,E,b} = perception channels. ALIVE={K,L,GATE} = strategy channels. Het encoding makes the split dramatic:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "Het DEAD", "684 ch_score", "Perception channels +48% over homo (463). D(+134) and b(+83) drive the gain.", "");
  render_finding(g3, "Het ALIVE", "405 ch_score", "Strategy channels -4% vs homo (424). ECC independently predicted = harder.", "");
  render_finding(g3, "D (structural)", "+134 het advantage", "58.5% raw accuracy. Structural type is the most predictable feature.", "");
  render_finding(g3, "b (bigram)", "+83 het advantage", "53.4% raw accuracy. Transition patterns carry strong signal.", "");
  render_finding(g3, "L,G,X (ECC)", "-20/-23/-32", "ECC channels LOSE in het. They depend on data channels, not vice versa.", "");
  dom_append(dom_body(), sec3);

  -- Implications
  let sec4 = make_section("800px") in
  render_h2(sec4, "What This Means");
  render_p(sec4, "Het channels DO specialize -- D and b carry structural/transition info far better than char%q. The 490 split IS meaningful: perception channels gain +48%, strategy channels lose -4%. But reconstruction from qualitatively different features is harder than CRT algebraic reconstruction.");
  render_p(sec4, "The reconstruction gap (-6 accuracy) reveals the key insight: channel specialization helps PERCEPTION but hurts RECONSTRUCTION. CRT's power is algebraic uniqueness (one number mod coprime moduli has exactly one solution). Het features lack this guarantee.");
  render_p(sec4, "Bridge 3 (Ring Substrate): instead of encoding text INTO the ring, make the ring the computation SUBSTRATE. Text goes in, text comes out. Between them: ring arithmetic IS the machinery. Ring multiplication for feed-forward, coupling for attention, OMEGA for regularization. The ring's algebra provides the reconstruction that het channels need.");
  dom_append(dom_body(), sec4);

  0
)
