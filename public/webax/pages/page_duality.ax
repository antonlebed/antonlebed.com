/* ================================================================
   PAGE: DUALITY -- D=2, The Pair Prime, Drive (BRIDGE.md)
   ================================================================ */

/* duality helpers */
fn duality_hero() = (
  let hero = make_hero("Duality") in
  let eq = dom_create("div") in
  dom_text(eq, "2 -- the only even prime");
  ct_mono(eq);
  dom_style(eq, "fontSize", "28px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Every prime in the chain is built from 2 via the Cunningham map c(n) = 2n+1. c(1) = 3. c(2) = 5. c(3) = 7. The entire structure rests on the pair -- and then 2 self-destructs. 2^3 = 8, and 8 = 0 in the mod-8 channel. Three steps from engine to annihilation.");
  render_p(hero, "This page explores what makes 2 unique: how it generates the chain, how it splits the ring into even and odd, how it creates the number 42, and why its self-destruction leaves every other channel untouched.");
  dom_append(dom_body(), hero)
)

fn duality_drive() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Chain Engine");
  render_p(sec, "2 is the only even prime. Every other prime in the chain is built from it using the Cunningham map c(n) = 2n + 1:");
  let g = make_findings_grid(sec) in
  render_finding(g, "3 = 2*1 + 1", "c(1) = 3", "The first Cunningham step. 3 is the minimum for majority vote, triangles, closure.", "");
  render_finding(g, "5 = 2*2 + 1", "c(2) = 5", "5^2 divides the ring but 5 does not divide phi(210) = 48. Self-blind.", "");
  render_finding(g, "7 = 2*3 + 1", "c(3) = 7", "Deepest channel: mod-49 has 49 states. Controls the spectral gap.", "");
  render_finding(g, "2 mod 2 = 0", "Self-annihilation", "2 vanishes in its own channel. The engine cannot see itself running.", "");
  render_finding(g, "Channel sum", "N/2 = 6,306,300", "The mod-8 channel is the ONLY one with nonzero element sum. All odd channels sum to 0.", "");
  render_finding(g, "3*5*7 = 105", "The odd product", "The only product of consecutive chain primes that excludes 2. All odd, all coprime to 2.", "");
  dom_append(dom_body(), sec)
)

fn duality_self_destruct() = (
  let sec = make_section("800px") in
  render_h2(sec, "Self-Destruction at Step 3");
  render_theorem(sec, "Mod-8 Annihilation (PROVED)", "2^3 = 8 = 0 mod 8. The mod-8 channel dies in 3 steps. But gcd(2, 3*5*7*11*13) = 1, so 2 cannot kill any odd channel. Multiplying by 2 cycles odd channels indefinitely. After 420 steps: 2^420 = 1,576,576 = (0, 1, 1, 1, 1, 1) in CRT -- the mod-8 channel is zero, all five others are 1.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Step k");
  render_th(hdr, "2^k");
  render_th(hdr, "mod 8");
  render_th(hdr, "Status");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "1", "1", "All 6 channels alive");
  render_table_row_4(tbl, "1", "2", "2", "First departure");
  render_table_row_4(tbl, "2", "4", "4", "Deepening");
  render_table_row_4(tbl, "3", "8", "0", "Mod-8 channel dead");
  render_table_row_4(tbl, "420", "1,576,576", "0", "Terminal projector: CRT = (0,1,1,1,1,1)");
  render_p(sec, "Odd channel periods: ord(2, 9)=6, ord(2, 25)=20, ord(2, 49)=21, ord(2, 11)=10. The mod-8 channel is the most fragile and the most essential. Without 2, no chain. With 2, eventual death in that channel.");
  dom_append(dom_body(), sec)
)

fn duality_answer() = (
  let sec = make_section("800px") in
  render_h2(sec, "Why 42");
  render_theorem(sec, "Channel Order Theorem (PROVED)", "ord(2, 49) = 21 because 2 is a quadratic residue mod 7 (Legendre symbol (2/7) = +1), so ord(2, 7) = 3. Hensel lifting: ord(2, 49) = 7*3 = 21. Meanwhile ord(2, 9) = 6. The Carmichael lambda across these two channels is lcm(6, 21) = 42 = 2*3*7. The three smallest chain primes multiplied.");
  render_theorem(sec, "42 Theorem (PROVED)", "In any lambda-420 ring: the projector doubled equals 2 if and only if the 2-exponent is at most 1 (thin mod-2 channel). Of the 84 such rings dividing Z/12,612,600: exactly 42 satisfy this, exactly 42 do not. Perfect half-and-half. In Z/12,612,600 itself (2-exponent 3), it does NOT hold: 2 * 1,576,576 = (0,2,2,2,2,2) not (2,2,2,2,2,2).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Mod-9 period", "ord(2, 9) = 6", "3 appears in both 6 and 21. It is the common factor linking the mod-9 and mod-49 channels.", "");
  render_finding(g, "Mod-25 period", "ord(2, 25) = 20", "20 = 4*5. This channel alone forces lcm(6, 20, 21) = 420 -- doubling the naive lcm(6, 21) = 42.", "");
  render_finding(g, "Mod-49 period", "ord(2, 49) = 21", "21 is odd. The mod-49 channel never mirrors (no element at half-period). It spirals.", "");
  render_finding(g, "Full lambda", "lcm(2, 6, 20, 21, 10) = 420", "All five odd-channel periods combine to give 420 = 2^2 * 3 * 5 * 7.", "");
  dom_append(dom_body(), sec)
)

fn duality_parity() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Parity Mechanism");
  render_theorem(sec, "Even/Odd Split (7 sub-theorems, ALL VERIFIED)", "T1: Removing 2-edges from the Cayley graph of Z/210 splits it into 2 components (even/odd). T2: Each component has exactly 105 vertices. T3: The 2-edges form a perfect matching. T4: The other generators {30, 42, 70} are all even (parity-preserving). Only the generator 105 is odd. T5: Spectral gap = 4*sin^2(pi/7) = 0.753. T6: No 2-edge pair shares an eigenvalue class (0/105). T7: Hamiltonian cycles use an even number of 2-edges, minimum 2.");
  render_p(sec, "2 splits the ring into even and odd. It is the only parity-flipping generator. The smallest possible membrane between two halves.");
  dom_append(dom_body(), sec)
)

fn duality_qr_matrix() = (
  let sec = make_section("800px") in
  render_h2(sec, "Quadratic Residue Matrix");
  render_p(sec, "The 7x7 Legendre symbol matrix reveals which of the seven primes are squares modulo which others. 2 has unique behavior: it classifies primes by their residue mod 8.");
  render_theorem(sec, "QR Matrix Theorem (PROVED, 90/90)", "The 7x7 Legendre matrix has 42 off-diagonal entries: 17 QR, 25 NR. Among 30 odd-prime pairs: 9 QR, 21 NR (ratio 3:7). Per-row QR count: {3, 11, 13} have 3 each (balanced); {2, 5, 7, 17} have 2 each (deficit). Total = 3*3 + 4*2 = 9 + 8 = 17. The triad {3, 7, 11} (all 3 mod 4) forms a directed QR 3-cycle: 3 is QR mod 11, 11 is QR mod 7, 7 is QR mod 3, but not the reverse.");
  let g = make_findings_grid(sec) in
  render_finding(g, "2 is QR mod p", "Only {7, 17}", "2 is a quadratic residue mod p iff p = +-1 mod 8. Among the seven primes: 7 = -1 mod 8 and 17 = +1 mod 8.", "");
  render_finding(g, "Directed 3-cycle", "3 -> 11 -> 7 -> 3", "{3, 7, 11} form an asymmetric QR cycle. 3 anti-symmetric pairs.", "");
  render_finding(g, "5 has minimum QR", "Only 11 is QR mod 5", "5 has minimal quadratic receptivity among odd primes. 1 of 5 possible.", "");
  render_finding(g, "42 = 17 + 25", "QR count + NR count", "The total off-diagonal count decomposes into the 7th prime (17) and 5^2 (25).", "");
  dom_append(dom_body(), sec)
)

fn duality_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Even/odd split", "2 is the only even prime", "2 mod 2 = 0. The engine vanishes in its own channel. Perfect matching on the Cayley graph.");
  render_contrast_row(tbl, "42", "Just a number", "lcm(ord(2,9), ord(2,49)) = lcm(6, 21) = 42 = 2*3*7. Theorem: exactly half of the 84 lambda-420 rings satisfy the double-projector identity.");
  render_contrast_row(tbl, "Mirror", "Additive inverse on Z/N", "n -> N-n flips each CRT residue independently. Preserves eigenvalues (cosine is even). Channel sums equal the modulus.");
  render_contrast_row(tbl, "Self-destruction", "2^3 = 8", "8 = 0 mod 8: the mod-8 channel dies in 3 steps. All odd channels survive. 2^420 = projector (0,1,1,1,1,1).");
  render_contrast_row(tbl, "QR structure", "Quadratic reciprocity", "7x7 Legendre matrix: 17 QR + 25 NR = 42 entries. Directed 3-cycle on {3,7,11}. 2 is QR only mod {7,17}.");
  dom_append(dom_body(), sec)
)

/* ================================================================
   INTERACTIVE: MIRROR EXPLORER
   Enter n -> see n and N-n (mirror). CRT of both.
   Each channel pair sums to modulus. Duality = the pair.
   ================================================================ */

fn duality_mirror_compute() = (
  let n = parse_int_from("#mir-input") in
  let m = 12612600 - n in
  let result = dom_query("#mir-result") in
  let nd = n % 8 in let nk = n % 9 in let ne = n % 25 in let nb = n % 49 in let nl = n % 11 in let ng = n % 13 in
  let md = m % 8 in let mk = m % 9 in let me_ch = m % 25 in let mb = m % 49 in let ml = m % 11 in let mg = m % 13 in
  /* Verify channel sums = modulus */
  let sd = nd + md in let sk = nk + mk in let se = ne + me_ch in let sb = nb + mb in let sl = nl + ml in let sg_ch = ng + mg in
  /* Is n a unit? gcd(n, N) = 1 */
  let is_self_mirror = if n == m then "YES -- fixed point of mirror!" else "no" in
  dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'><b>n = " + "${n}" + "</b> | CRT = (" + "${nd}" + "," + "${nk}" + "," + "${ne}" + "," + "${nb}" + "," + "${nl}" + "," + "${ng}" + ")</p><p style='color:#ff8844;margin:4px 0'><b>mirror = " + "${m}" + "</b> | CRT = (" + "${md}" + "," + "${mk}" + "," + "${me_ch}" + "," + "${mb}" + "," + "${ml}" + "," + "${mg}" + ")</p><p style='color:#ffd700;margin:4px 0'>Channel sums: (" + "${sd}" + "," + "${sk}" + "," + "${se}" + "," + "${sb}" + "," + "${sl}" + "," + "${sg_ch}" + ") = (8, 9, 25, 49, 11, 13)</p><p style='color:#b0b0c0;margin:4px 0'>Self-mirror? " + is_self_mirror + " | n + mirror = " + "${n + m}" + " = 12,612,600 = 0</p>")
)

fn duality_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: The Mirror");
  render_p(sec, "Every element n has a twin: N-n. Their CRT residues sum to the channel modulus in each channel: (8,9,25,49,11,13). The mirror swaps without loss -- addition is ALWAYS reversible. The mirror IS the additive inverse.");
  make_interactive_widget(sec, "Enter n to see its mirror:", "mir-input", "e.g. 137", "Mirror", "duality_mirror_compute", "mir-result");
  render_p(sec, "Try: 1 (identity, mirror = 12,612,599), 6,306,300 (midpoint, self-mirror), 1,576,576 (the projector 2^420), 42 (mirror = 12,612,558).");
  dom_append(dom_body(), sec)
)

/* CRT Key Exchange -- absorbed from crt_keyexchange_demo.html */
fn dh_modpow(base, exp, m) = (
  /* Square-and-multiply modular exponentiation */
  mut result = 1;
  mut bx = base % m;
  mut ex = exp;
  while ex > 0 do (
    if ex % 2 == 1 then mut result = (result * bx) % m else 0;
    mut ex = ex / 2;
    mut bx = (bx * bx) % m
  );
  result
)

fn dh_ring_pow(base, exp) = (
  /* Exponentiation via CRT: decompose, per-channel modpow, reconstruct */
  let mods = [8, 9, 25, 49, 11, 13] in
  let idem = [11036025, 1401400, 9585576, 8494200, 3439800, 3880800] in
  let ch0 = dh_modpow(base % 8, exp, 8) in
  let ch1 = dh_modpow(base % 9, exp, 9) in
  let ch2 = dh_modpow(base % 25, exp, 25) in
  let ch3 = dh_modpow(base % 49, exp, 49) in
  let ch4 = dh_modpow(base % 11, exp, 11) in
  let ch5 = dh_modpow(base % 13, exp, 13) in
  (ch0 * idem[0] + ch1 * idem[1] + ch2 * idem[2] + ch3 * idem[3] + ch4 * idem[4] + ch5 * idem[5]) % N_TRUE
)

fn keyex_run() = (
  let asec = parse_int_from("#dh-alice") in
  let bsec = parse_int_from("#dh-bob") in
  let result_el = dom_query("#dh-result") in
  if asec < 1 then dom_inner(result_el, "<p style='color:#ff6666'>Alice needs a secret (1-419).</p>")
  else if bsec < 1 then dom_inner(result_el, "<p style='color:#ff6666'>Bob needs a secret (1-419).</p>")
  else (
    let gen = 137 in
    /* Public keys: A = g^a, B = g^b */
    let pub_a = dh_ring_pow(gen, asec) in
    let pub_b = dh_ring_pow(gen, bsec) in
    /* Shared secrets (should match) */
    let s_alice = dh_ring_pow(pub_b, asec) in
    let s_bob = dh_ring_pow(pub_a, bsec) in
    let ok = if s_alice == s_bob then 1 else 0 in
    /* CRT of shared secret */
    let sd = s_alice % 8 in let sk = s_alice % 9 in let se = s_alice % 25 in let sb = s_alice % 49 in let sl = s_alice % 11 in let sg_s = s_alice % 13 in
    /* CRT of public keys */
    let ad = pub_a % 8 in let ak = pub_a % 9 in let ae = pub_a % 25 in let ab_ch = pub_a % 49 in let al = pub_a % 11 in let ag = pub_a % 13 in
    let pd = pub_b % 8 in let pk = pub_b % 9 in let pe = pub_b % 25 in let pb = pub_b % 49 in let pl = pub_b % 11 in let pg = pub_b % 13 in
    dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>DIFFIE-HELLMAN OVER Z/12,612,600 (g = 137, order = 420)</p><p style='margin:4px 0;color:#88ddaa'><b>Alice:</b> secret a = " + "${asec}" + " | public A = g^a = " + "${pub_a}" + " | CRT = (" + "${ad}" + "," + "${ak}" + "," + "${ae}" + "," + "${ab_ch}" + "," + "${al}" + "," + "${ag}" + ")</p><p style='margin:4px 0;color:#ff8844'><b>Bob:</b> secret b = " + "${bsec}" + " | public B = g^b = " + "${pub_b}" + " | CRT = (" + "${pd}" + "," + "${pk}" + "," + "${pe}" + "," + "${pb}" + "," + "${pl}" + "," + "${pg}" + ")</p><p style='margin:8px 0 4px;color:" + (if ok == 1 then "#44ff88" else "#ff4444") + ";font-size:16px'>" + (if ok == 1 then "SHARED SECRET ESTABLISHED" else "MISMATCH (bug)") + ": S = " + "${s_alice}" + "</p><p style='margin:4px 0;color:#b0b0c0'>CRT(S) = (" + "${sd}" + "," + "${sk}" + "," + "${se}" + "," + "${sb}" + "," + "${sl}" + "," + "${sg_s}" + ")</p><p style='margin:4px 0;color:#b0b0c0'>Alice: B^a = " + "${s_alice}" + " | Bob: A^b = " + "${s_bob}" + "</p><p style='color:#a0a0b0;margin:8px 0 0;font-size:12px'>g^a decomposes into 6 independent exponentiations. Each channel = independent DH. Mod-11 + mod-13 channels = dual authentication (1/143 false positive rate).</p></div>")
  )
)

fn duality_keyexchange() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Key Exchange");
  render_p(sec, "Diffie-Hellman naturally decomposes via CRT. Generator g = 137 (order 420 in Z/12,612,600). g^a splits into 6 independent exponentiations, one per channel. The shared secret is the CRT reconstruction of 6 independent exchanges.");
  render_theorem(sec, "CRT-DH Decomposition", "g^a mod N = CRT(g^a mod 8, g^a mod 9, g^a mod 25, g^a mod 49, g^a mod 11, g^a mod 13). Each channel computes Diffie-Hellman independently. The 6-channel structure is not a security improvement (Pohlig-Hellman already exploits this) -- it is a structural insight: key exchange IS CRT decomposition.");
  /* Alice + Bob inputs on same row */
  let klbl = dom_create("p") in
  dom_text(klbl, "Enter secrets (1-419):");
  dom_style(klbl, "color", "#b8b8c8");
  dom_style(klbl, "marginTop", "24px");
  dom_style(klbl, "marginBottom", "8px");
  dom_append(sec, klbl);
  let krow = dom_create("div") in
  dom_style(krow, "display", "flex");
  dom_style(krow, "gap", "8px");
  dom_style(krow, "alignItems", "center");
  dom_style(krow, "flexWrap", "wrap");
  dom_style(krow, "marginBottom", "12px");
  let albl = dom_create("span") in
  dom_text(albl, "Alice:");
  dom_style(albl, "color", "#b0b0c0");
  dom_append(krow, albl);
  make_input_field(krow, "dh-alice", "137");
  let blbl = dom_create("span") in
  dom_text(blbl, "Bob:");
  dom_style(blbl, "color", "#b0b0c0");
  dom_append(krow, blbl);
  make_input_field(krow, "dh-bob", "42");
  make_action_btn(krow, "Exchange Keys", "keyex_run");
  dom_append(sec, krow);
  make_result_box(sec, "dh-result");
  render_p(sec, "Try: Alice=137 Bob=42 | Alice=210 Bob=210 | Alice=1 Bob=419 (boundary).");
  render_contrast_row(sec, "Key structure", "Single opaque integer", "6 independent CRT channel keys");
  render_contrast_row(sec, "Authentication", "Separate MAC required", "Mod-11 channel = free auth tag (1/11 false positive)");
  render_contrast_row(sec, "Per-channel key", "Not possible", "Each channel yields independent sub-key for different purposes");
  render_contrast_row(sec, "Exponentiation", "Monolithic modpow", "6 small modpows via CRT (parallelizable)");
  render_contrast_row(sec, "Dependencies", "OpenSSL / libsodium", "CC0. 20 lines. No imports.");
  dom_append(dom_body(), sec)
)

fn page_duality() = (
  dom_head_meta("description", "2 is the only even prime. It generates the chain via the Cunningham map: 3, 5, 7. Self-destructs at step 3 (2^3 = 0 mod 8). Channel orders give lcm(6,21) = 42. Even/odd parity split. 7x7 quadratic residue matrix. CRT key exchange.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Duality: 2\",\"description\":\"2 is the only even prime. Generates the Cunningham chain: 3, 5, 7. Self-destructs at step 3 (2^3 = 0 mod 8). Channel order lcm gives 42. Even/odd parity split with perfect matching. 7x7 Legendre symbol matrix. CRT-decomposed Diffie-Hellman key exchange.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/ideas/duality\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"even prime\"},{\"@type\":\"DefinedTerm\",\"name\":\"Cunningham chain\"},{\"@type\":\"DefinedTerm\",\"name\":\"quadratic residue\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT key exchange\"}]}");
  duality_hero();
  duality_drive();
  duality_self_destruct();
  duality_interactive();
  duality_answer();
  duality_parity();
  duality_qr_matrix();
  duality_keyexchange();
  duality_contrast()
)
