/* page_carousel.ax -- CRT Braid, Torus Knots, Chirality (CAROUSEL.md).
   Helpers from pages_kingdom.ax + page fn from pages_kingdom_2.ax.

   TT42 K-channel PRIMARY LENS: the carousel IS closure in motion.
   K = 3 = closure. Six of the seven micro towers (ESCAPE reserved for
   TRANS) spin on TRUE at prime-power rates 8, 9, 25, 49, 11, 13 and
   CLOSE into one discrete 6-torus via CRT. Addition advances every ring
   simultaneously; after N = 12612600 steps, all six return home.
   K-specific moves:
     * 64 = 2^6 idempotents = the K^2 control panel (each projector CLOSES
       the ring onto a CRT subset; |Image|*|Kernel| = N by conservation).
     * Cubing-squaring equality: max cycle for k=D and k=K both = 12 =
       D^2*K = lambda(DATA). Squaring and cubing close on the same orbit.
     * Chromatic depth chi = max(q_i): Hamming chromatic number CLOSES
       at the deepest channel. Hamming graphs are perfect (chi = omega).
     * Seed-flower polynomials P1/P2/P3 have D=2 as UNIQUE positive
       integer root: closure forces the axiom's own generator.
     * K^2 = 9 Nonility (CAROUSEL.md X): {sigma, OMEGA, -1, 0} core + {D,K,E,b}
       prime bulb, L = neck. K^2 organizes the nine key elements as hourglass.
   Secondary lenses: b-channel (depth rises highest on the braid, +457;
   SEEDS = 49 = b^2 sub-petals per petal; phyllotaxis packs WITHIN b-petals)
   and D-channel (D = 2 forced by three closure polynomials; duality sinks
   deepest, -886, and controls the Hamming gap at every level: gap = D-power).
   108 vs 84 (TT47, S1428 R5 per stdlib/lattice.ax SSOT): 108 = D^2*K^3
   is the LAMBDA-420 LATTICE -- ALL 108 hit lambda = 420 EXACTLY (b^2 forced).
   84 = D^2*K*b is the TRUE-DIVISOR subset (D-range 0..3); 24 = D^4 extensions
   reach 2*TRUE (D=4). The carousel's heartbeat is shared by all 108; the
   84-subset is the slice that fits inside the TRUE organism. */

/* ================================================================
   PAGE: CAROUSEL -- CRT Braid, Torus Knots, Chirality (CAROUSEL.md)
   ================================================================ */

fn carousel_hero() = (
  let hero = make_hero("The Carousel") in
  let eq = dom_create("div") in
  dom_text(eq, "Z/12612600 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 = T^6");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Think of a merry-go-round with six rings, each spinning at a different speed. The inner ring completes a full turn in 2 clicks. The next in 3. Then 5, 7, 11, 13. They all start aligned. How long until they align again? Exactly 30030 clicks -- the thin ring.");
  render_p(hero, "Now give each ring its full prime-power depth: 8, 9, 25, 49, 11, 13 positions. It takes 12,612,600 clicks to realign. Adding 1 to any number advances every ring by one click. This is the carousel -- addition as rotation through a six-dimensional torus.");
  render_p(hero, "Six of the seven prime-power channels (the mod-17 channel extends to Z/214,414,200) close into this 6-torus via CRT. 64 = 2^6 idempotent switches. Max squaring cycle = 12 = Carmichael lambda of Z/210. Chromatic number chi = max(q_i) -- the deepest channel decides coloring. The mod-49 channel rises highest on the braid (+457); the mod-8 channel is forced by three polynomials.");
  render_p(hero, "The 7 circles of T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17) form the Gabriel-Horn cap of Z^7 -- finite volume over unbounded surface. The spectral gap 4*sin^2(pi/49) is locked at 49 across all 108 lambda-420 rings: Theorem 33 STRUCTURAL Yang-Mills analog, Theorem 34 STRUCTURAL Navier-Stokes horn analog (both are structural analogies, not proofs of the Clay problems). The Z/12,612,600 carousel = T^6 (six rings); Z/214,414,200 extends to T^7 (adds the mod-17 channel).");
  dom_append(dom_body(), hero)
)

fn carousel_frozen() = (
  let sec = make_section("800px") in
  render_h2(sec, "Frozen Ring Theorem");
  render_p(sec, "When n is divisible by a prime p, the corresponding ring is FROZEN at position 0. It cannot spin. Divisibility is constraint: the primes that compose n are exactly the channels it cannot move in.");
  let g = make_findings_grid(sec) in
  render_finding(g, "H(n)", "6 - omega(gcd(n, N))", "Hamming weight = spinning rings. H(0) = 0 (axis, all frozen). H(units) = 6 (all spinning). N = 12612600.", "");
  render_finding(g, "Reaching Theorem", "n spins what it lacks", "105 = 3*5*7 has channels 2, 11, 13 spinning. 210 = 2*3*5*7 spins only 11 and 13. Elements activate exactly the channels they are not divisible by.", "");
  render_finding(g, "Mode", "H = 5 (typical)", "In Z/12,612,600, each prime factor freezes one of 6 rings. phi(N) = 2,419,200 units at H = 6 (all spinning). The element 490 = 2*5*7^2 freezes the inner channels {2,5,7}, leaving boundary channels {3,11,13} spinning.", "");
  render_finding(g, "Axis duality", "0 vs 1", "Void: (0,0,0,0,0,0) = perfectly still. The identity: (1,1,1,1,1,1) = maximum motion. These two extremes anchor the carousel.", "");
  dom_append(dom_body(), sec)
)

fn carousel_cost() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Cost of Spinning");
  render_p(sec, "Each ring you activate costs 4*sin^2(pi/p) in phase coherence. The void (all off) has eigenvalue 10 -- maximum coherence. Every spinning ring reduces it. The hierarchy activates expensive rings first and cheap rings last.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Cost 4*sin^2(pi/p)");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "p = 2", "4.000 (maximum)", "Most expensive channel. 4*sin^2(pi/2) = 4.");
  render_contrast_row(tbl, "p = 3", "3.000", "Second highest cost.");
  render_contrast_row(tbl, "p = 5", "1.382", "Mid-range. phi^2 = (golden ratio)^2.");
  render_contrast_row(tbl, "p = 7", "0.753", "Mod-49 channel costs little to activate.");
  render_contrast_row(tbl, "p = 11", "0.317", "Cheapest to activate among the first five.");
  render_contrast_row(tbl, "p = 13", "0.229", "Cheapest overall. The boundary channel costs almost nothing to maintain.");
  render_p(sec, "Total cost (all 6 on): 9.681. The hierarchy builds in OPPOSITE order of cost: 2 > 3 > 5 > 7 > 11 > 13. The sequence activates expensive rings first. The mod-13 channel is cheapest -- the boundary channel costs almost nothing to maintain.");
  dom_append(dom_body(), sec)
)

fn carousel_braid() = (
  let sec = make_section("800px") in
  render_h2(sec, "The CRT Braid");
  render_p(sec, "Six CRT channels = 6 strands cycling at rates 2, 3, 5, 7, 11, 13. Walking n = 0 to N-1 makes each strand wrap at its prime period. The interleaving of these six rhythms IS a braid -- not metaphorically, but literally in the mathematical sense.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Crossings", "11,822 per Z/2,310 walk", "EXACT BEAT FORMULA: net per beat = -gcd(p_i - 1, p_j - 1). Total signed chirality: -gcd(p_i-1, p_j-1) * N/(p_i*p_j). All 10 pairs verified. The 11,822 count is on Z/2,310; Z/12,612,600 crossings scale proportionally.", "");
  render_finding(g, "Density", "[143, 151] per 30-step window", "Uniform. No clustering. The braid has no preferred location -- crossings spread evenly through the walk.", "");
  render_finding(g, "CRT Neighbors", "109 = Hamming degree in Z/12,612,600", "Every element shares 5 of 6 channels with exactly 109 others. Degree = sum(q_i - 1) = 7+8+24+48+10+12 = 109. The Z/970,200 subring (without mod-13) has degree 97. The topology IS the algebra.", "");
  render_finding(g, "Chirality", "LEFT-HANDED at all levels", "Larger primes dominate smaller. Verified at Z/6, Z/30, Z/210, Z/2310. Nature's handedness.", "");
  render_p(sec, "Twist ratios between strands: 3/2 (the musical fifth), 5/3 (Kolmogorov turbulence ratio), 7/5, 11/7, 13/11. The braid's internal rhythm encodes these ratios.");
  dom_append(dom_body(), sec)
)

fn carousel_strand_height() = (
  let sec = make_section("800px") in
  render_h2(sec, "Strand Height Order");
  render_theorem(sec, "Strand Height Theorem", "Row sums of the interleaving matrix: 7(+457) > 11(+389) > 5(+323) > 3(-283) > 2(-886). Sum = 0 (conservation).");
  render_p(sec, "The mod-2 strand sinks deepest (-886); the mod-7 strand rises highest (+457). Conservation: the total signed displacement is exactly zero -- what one strand gains, the others lose.");
  dom_append(dom_body(), sec)
)

fn carousel_torus_knots() = (
  let sec = make_section("800px") in
  render_h2(sec, "10 Torus Knots");
  render_p(sec, "C(5,2) = 10 pairs from {2,3,5,7,11} give 10 torus knots T(p_i, p_j). Seifert matrix eigenvalues = grid Laplacian on (p-1) x (q-1). ALL 10 have NEGATIVE signature (left-handed, consistent with chirality).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Level");
  render_th(hdr, "Total Signature");
  render_th(hdr, "Factorization");
  render_th(hdr, "Note");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/6 (2*3)", "-2", "2", "Trefoil. Simplest nontrivial knot.");
  render_table_row_4(tbl, "Z/30 (2*3*5)", "-12", "4*3 = 12", "");
  render_table_row_4(tbl, "Z/210 (2*3*5*7)", "-42", "2*3*7 = 42", "");
  render_table_row_4(tbl, "Z/2,310 (2*3*5*7*11)", "-132", "4*3*11 = 132", "Full thin ring.");
  render_p(sec, "Crossing number ladder: level 2 has 3 crossings, level 3 has 18, level 4 has 67, level 5 has 210. Torus knot complexity at each level tracks the ring hierarchy.");
  dom_append(dom_body(), sec)
)

fn carousel_hamming_graph() = (
  let sec = make_section("800px") in
  render_h2(sec, "CRT Hamming Graph");
  render_p(sec, "The CRT neighbor graph -- elements sharing k-1 of k channels -- IS the Hamming graph H = K_q1 [] K_q2 [] ... [] K_qk (Cartesian product of complete graphs). This is provably the topology of the product.");
  render_theorem(sec, "Hamming Spectrum Theorem", "Eigenvalues: lambda_S = sum_{i in S} q_i - k, for each subset S of factors. Multiplicity: prod_{i not in S}(q_i - 1). Max eigenvalue = degree = sum(q_i - 1). Min eigenvalue = -k. 2^k subset signatures per ring: Z/970,200 (k=5) gives 32 subsets, Z/12,612,600 (k=6) gives 64, Z/214,414,200 (k=7) gives 128. Whether the corresponding eigenvalue VALUES are all distinct depends on superlacunarity (Z/970,200 has 32 distinct; Z/12,612,600 has collisions at adding 13).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Z/2,310 degree", "23", "Number of distinct eigenvalues = max eigenvalue = degree = 23.", "");
  render_finding(g, "Z/12,612,600 degree", "109", "7+8+24+48+10+12 = 109. Each channel Z/q_i has Lie algebra A_{q_i-1}. The Z/970,200 subring (without mod-13) has degree 97. Adding mod-13: degree increases by 12.", "");
  render_finding(g, "Z/970,200 separation", "All 32 subset sums distinct", "Factors {8, 9, 25, 49, 11} are superlacunary (25 > 8+9; 49 > 8+9+25). Adding 11 creates no pair whose subset-sum difference = 11. Perfect 1:1 switch-to-eigenvalue map.", "");
  render_finding(g, "Gap Theorem", "gap = min(q_i) = power of 2", "Z/2,310: 23-21 = 2. Z/970,200: 97-89 = 8. Z/12,612,600: 109-101 = 8. The Hamming gap is always a power of 2 -- the mod-8 channel controls topology at every level.", "");
  dom_append(dom_body(), sec)
)

fn carousel_shell_polynomial() = (
  let sec = make_section("800px") in
  render_h2(sec, "Shell Polynomial and Chromatic Depth");
  render_p(sec, "The shell polynomial E(x) = prod(1 + (q_i-1)*x) counts elements at each CRT distance. Coefficient e_d = number at distance d from any fixed point.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Z/210 shells", "e_2 = 56 = dim(E7)", "e_0=1, e_1=13, e_2=56 (E7 fundamental rep), e_3=92, e_4=48 = phi(210). Distance-2 shell IS the Lie dimension.", "");
  render_finding(g, "Z/2,310 shells", "e_3 = 652 = 4*163", "163 = Heegner prime. e_4 = 968 = 8*121. Shell sizes factor into ring constants.", "");
  render_finding(g, "Chromatic number", "chi = max(q_i)", "Z/210: chi = 7. Z/2,310: chi = 11. Z/12,612,600: chi = 49. Hamming graphs are perfect: chi = omega. The deepest channel decides coloring.", "");
  render_finding(g, "Z/2,310 independence", "alpha = 210", "Largest non-conflicting set in the Z/2,310 Hamming IS the Z/210 subring. Independence number alpha = N/max(q_i).", "");
  render_finding(g, "Kleiber null", "360/480 = 3/4", "Null eigenvalue exists because 5 = 2+3. Two subsets: {5} and {2+3}. Merged multiplicity 360. Kleiber's 3/4 ratio from the fact that the third prime equals the sum of the first two.", "");
  dom_append(dom_body(), sec)
)

fn carousel_lambda() = (
  let sec = make_section("800px") in
  render_h2(sec, "Multiplicative Dynamics");
  render_p(sec, "The Carmichael lambda = smallest e such that a^e = 1 (mod N) for ALL coprime a. It measures how long multiplicative orbits can last. The Carmichael lambda ladder:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "lambda");
  render_th(hdr, "Ratio to Previous");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Z/6", "2", "--");
  render_table_row(tbl, "Z/30", "4", "x2");
  render_table_row(tbl, "Z/210", "12", "x3");
  render_table_row(tbl, "Z/2,310", "60", "x5");
  render_table_row(tbl, "Z/12,612,600", "420", "x7");
  render_p(sec, "Each new level multiplies the Carmichael lambda by the next prime in sequence: 2, 3, 5, 7. The ratios ARE the chain. lambda(Z/12,612,600) = 420 = 4*3*5*7 = 2*210. The meta-ring Z/420 has phi(420)/classes(420) = 96/72 = 4/3 = 1/Kleiber.");
  render_p(sec, "N/lambda = 12,612,600/420 = 30,030 = primorial(13). Multiplying is 30,030x faster than adding. And 11 is invisible: lambda(11) = 10 divides 420, contributing nothing new to the lcm.");
  dom_append(dom_body(), sec)
)

fn carousel_squaring() = (
  let sec = make_section("800px") in
  render_h2(sec, "Squaring Map Dynamics");
  render_p(sec, "The simplest nonlinear dynamics: x -> x^2 mod N. Fixed points = idempotents = the 64 switches (2^6, one per ON/OFF configuration of the 6-torus). Units cycle directly; non-units must purify through the void first.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Cycle lengths", "{1, 2, 3, 4, 6, 12}", "ONLY divisors of 12 appear. On Z/970,200 (full scan of all 970,200 elements), period 12 dominates at 642,816/970,200 = 66.3%. The vocabulary is complete.", "");
  render_finding(g, "Two-levels-down", "max cycle(level k) = lambda(level k-2)", "Z/12,612,600 max = 12 = lambda(Z/210). Z/2,310 max = 4 = lambda(Z/30). The squaring map remembers two levels back. This property is specific to the chain {2,3,5,7,11,13}.", "");
  render_finding(g, "Class collapse", "Z/210 -> e_11 in 2 steps", "The mod-210 channels self-annihilate under squaring; only the mod-11 channel preserves. Z/2,310 -> void in 2 steps (complete annihilation). Sum of class cycles: 2 + 3 + 4 = 9.", "");
  render_finding(g, "Kleiber in dynamics", "P1/P2 = 3/4", "Period-1 count / Period-2 count = 270/360 = 3/4 (on Z/2,310). Purely algebraic. Fattening breaks it: Z/970,200 ratio = 9,720/15,552 = 5/8.", "");
  render_p(sec, "Per-channel structure: mod-8 is all period-1. mod-9 is awakened by fattening (was trivial in thin). mod-25 has only period 4. mod-49 is richest (periods 1,2,3,6). mod-11 is invariant under fattening. The mod-25 channel kills all dynamics because 5-1 = 4 is a pure 2-group.");
  dom_append(dom_body(), sec)
)

fn carousel_seed_flower() = (
  let sec = make_section("800px") in
  render_h2(sec, "Topological Encoding");
  render_theorem(sec, "Partial Ring Encoding Theorem", "The topology of a partial ring encodes primes it has never met. Z/30 = {2,3,5} has Euler characteristic chi = -29 = -(1+2+3+5+7+11) = the sum of the first six terms in the chain.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Fat level 2", "Z/72 = Z/8 x Z/9", "chi = -55 = 5*11. Only 2 and 3 present, yet topology produces 5*11. And b1 = 56 = dim(E7). The fat seed encodes three primes it has never met.", "");
  render_finding(g, "Three polynomials", "P1, P2, P3 all have root x=2", "P1 = x^3 - 3x - 2. P2 = 4x^3 + x^2 - 14x - 8. P3 = x^5 + 2x^4 - 9x^2 - 12x - 4. x = 2 is the unique positive integer root of all three.", "");
  render_finding(g, "Missing prime theorem", "{2,5,7}: chi = -81 = 3^4", "When 3 is absent, topology raises it to the 4th power. {3,5,7}: b1 = 140 = 4*5*7, which contains the factor 2 even though 2 is absent. Topology names what is missing.", "");
  render_finding(g, "13 forced", "13 | chi(Z/12,612,600)", "Algebraically forced by the identity 3*5 - 2 = 13. The factor 13 in the Euler characteristic is the same 13 from this convergence relation.", "");
  dom_append(dom_body(), sec)
)

fn carousel_betti() = (
  let sec = make_section("800px") in
  render_h2(sec, "Betti Numbers and Lie Algebras");
  render_theorem(sec, "CRT Betti Number Theorem", "The Hamming clique complex has b0 = 1, b1 = 1 - chi, and b_s = 0 for all s >= 2. Homotopy type: wedge of b1 circles. All topology concentrates in dimension 1.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair Z/p x Z/q");
  render_th(hdr, "b1 = (p-1)(q-1)");
  render_th(hdr, "Lie Algebra");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Z/8 x Z/9", "56", "dim(E7 fundamental)");
  render_table_row(tbl, "Z/25 x Z/11", "240", "|roots(E8)|");
  render_table_row(tbl, "Z/3 x Z/5", "8", "dim(SU(3))");
  render_table_row(tbl, "Z/5 x Z/7", "24", "dim(SU(5))");
  render_table_row(tbl, "Z/49 x Z/11", "480", "phi(Z/2,310)");
  render_table_row(tbl, "Z/9 x Z/49", "384", "b1(Z/210) = 128*3");
  render_p(sec, "b1-SU Theorem: b1(Z/p x Z/(p+2)) = p^2 - 1 = dim(SU(p)). Trivially forced by the gap being 2 (difference of squares). PSL Ladder: b1(3,7) = 12 = |PSL(2,3)|, b1(7,11) = 60 = |PSL(2,5)|, b1(8,25) = 168 = |PSL(2,7)|.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Silence Theorem", "b1 mod q_j = 0 iff condition", "b1 vanishes in channel j iff prod of OTHER factors = 1 mod q_j. Z/30 is the unique all-silent triple. The mod-2 channel is always silent in the squarefree chain (product of odds = 1 mod 2). 5,888/5,888 verified.", "");
  render_finding(g, "Z/210 b1/phi", "384/48 = 8", "The Z/210 ring's Betti-to-totient ratio is 8. Protected by 383 = 384 - 1 (prime).", "");
  dom_append(dom_body(), sec)
)

fn carousel_mandelbrot() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mandelbrot on the Ring");
  render_p(sec, "x -> x^2 + c on the ring. CRT-decomposable per channel. Fattening from Z/2,310 to Z/970,200 reveals which channels drive dynamics. (NOTE: specific max values in the table below are canonical on Z/970,200, where the Mandelbrot fattening theorem was proved; Z/12,612,600 extends these but exact max cycles at that level require full re-scan.)");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "c");
  render_th(hdr, "Z/2,310 max");
  render_th(hdr, "Z/970,200 max");
  render_th(hdr, "Ratio");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "c = 0", "4", "12", "3x");
  render_table_row_4(tbl, "c = 2", "2", "56", "28x EXPLOSION");
  render_table_row_4(tbl, "c = 3", "6", "12", "2x");
  render_table_row_4(tbl, "c = 5", "2", "12", "6x");
  render_table_row_4(tbl, "c = 7", "6", "24", "4x");
  render_table_row_4(tbl, "c = 11", "12", "12", "1x INVARIANT");
  render_table_row_4(tbl, "c = 105", "10", "60", "6x OPTIMAL");
  let g = make_findings_grid(sec) in
  render_finding(g, "11-invariance", "11 stays at 12 under fattening", "The mod-11 channel has exponent 1 (Z/11 identical in thin and full ring). Its dynamics do not change when fattening.", "");
  render_finding(g, "c=2 explosion", "c=2: 28x amplification", "c = 2 excites ALL fat channels to maximum. mod-49 gets 7-cycle, mod-25 gets 8-cycle. The first prime unleashes the most dynamics.", "");
  render_finding(g, "Full Carmichael lambda", "1,344 values achieve max = 420", "1,344 = 64*3*7. First such c: 688 = 16*43 (43 is Heegner). Only 0.14% of c values on Z/970,200 achieve maximum dynamics.", "");
  render_finding(g, "All-smooth", "Every max cycle divides 420", "Full scan of all N values: ALL max cycles are {2,3,5,7}-smooth. 29 distinct values. 11 and 13 are absent from all Mandelbrot cycles. The Mandelbrot ceiling = Carmichael lambda, not N.", "");
  dom_append(dom_body(), sec)
)

fn carousel_switches() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 64 Switches");
  render_p(sec, "Z/12,612,600: 64 idempotents = 2^6 (6-cube). Z/214,414,200: 128 = 2^7 (7-cube, adding the mod-17 channel). Each switch e_S has CRT coordinates: 1 in the channels belonging to S, 0 elsewhere. The control panel of the carousel.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Conservation", "|IMAGE| * |KERNEL| = N = 12,612,600", "For every idempotent e: what it keeps times what it destroys equals the full ring. Image = product of ON-channel factors; Kernel = product of OFF-channel factors; CRT forces |Image|*|Kernel| = N. Conservation law of projection, holds at every level.", "");
  render_finding(g, "Class switches", "One channel OFF = one class", "Unit [******], mod-2 off [.*****], mod-3 off [*.****], mod-5 off [**.***], mod-7 off [***.**], mod-11 off [****.*], mod-13 off [*****.]. Six positions = six channels. Progression = turning channels ON. e + complement(e) = 1.", "");
  render_finding(g, "Key values", "e_2 = 11,036,025", "Mod-2 projection: 1 in the mod-8 channel, 0 in all five others. In Z/2,310, e_2 = 1,155 (halving); fattening breaks the simple halving but preserves the projection. The 490 split: inner {2,5,7} frozen, boundary {3,11,13} spinning. One idempotent per switch.", "");
  render_finding(g, "Phase alignment", "0 = +9 (on Z/2,310)", "Z/2,310 Cayley-graph eigenvalues at key points: 0 = +9 (all constructive). 1 = +1.548 (mixed). 41 = -0.420 (nearly canceled). 137 = -7.339 (all destructive). Z/12,612,600 eigenvalues scale (Hamming max = 109).", "");
  dom_append(dom_body(), sec)
)


fn carousel_horn_cap() = (
  let sec = make_section("800px") in
  render_h2(sec, "Seven Circles: The Gabriel-Horn Cap");
  render_p(sec, "7 circles of T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17). Each circle spins at its channel's Pareto top. T^7 IS the Gabriel-Horn cap of Z^7 -- the carousel compactifies the infinite lattice into a finite torus:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Spectral gap floor", "4*sin^2(pi/49) ~ 0.01644", "Identical across all 108 lambda-420 rings. The carousel's relaxation rate is universal -- 49 strictly dominates 16, 9, 25, 11, 13. This is a structural analogy, not a proof of the Clay problems (Theorem 33 STRUCTURAL Yang-Mills gap analog).", "");
  render_finding(g, "CRT-decomposed Laplacian", "T^6 = 6 independent channels", "On Z/12,612,600 the Laplacian is a direct sum of 6 per-channel Laplacians. On Z/214,414,200: 7 channels (adds mod-17). Blowup requires simultaneous singularity across orthogonal channels -- CRT orthogonality forbids it. This is a structural analogy, not a proof of the Clay problems (Theorem 34 STRUCTURAL Navier-Stokes horn analog).", "");
  render_finding(g, "Carousel = cap", "Finite volume, unbounded surface", "The ring's N-element state space has finite volume; the ambient Z^7 has infinite surface. Adding 1 on the carousel = walking one step on the compactified horn. 420-step Carmichael lambda orbit = the horn's Cayley circulation.", "");
  dom_append(dom_body(), sec)
)

fn carousel_power_maps() = (
  let sec = make_section("800px") in
  render_h2(sec, "k-th Power Map Dynamics");
  render_p(sec, "Beyond squaring: x -> x^k mod N for each prime k in the chain. The power map reveals the carousel's internal clock.");
  render_theorem(sec, "Cubing-Squaring Cycle Equality", "Max cycle for k=2 AND k=3 both = 12 = lambda(Z/210). Two different rotations, same orbit ceiling. Peak at d = 35 = 5*7.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Power k");
  render_th(hdr, "Max cycle");
  render_th(hdr, "Factor");
  render_th(hdr, "Pairing");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "k=2, k=3", "12", "lambda(Z/210)", "");
  render_table_row_4(tbl, "k=5, k=11", "6", "lambda(Z/210)/2", "");
  render_table_row_4(tbl, "k=7, k=13", "4", "lambda(Z/210)/3", "");
  let g = make_findings_grid(sec) in
  render_finding(g, "Universal Divisor", "ALL k >= 2 divide 12", "Achievable max cycles = {1,2,3,4,6,12} = divisors of 12. lambda(Z/210) is the ceiling. Verified k=2..30.", "");
  render_finding(g, "Cubing blocked at period 3", "Cubing has NO period-3 orbits", "3^3-1 = 26 = 2*13. Since 13 does not divide 420 = lambda(Z/12,612,600), cubing period 3 is impossible.", "");
  render_finding(g, "Self-recognition", "p-th power has p fixed points in Z/p^e", "|{x : x^p = x mod p^e}| = p. Each prime recognizes itself in its own channel.", "");
  render_finding(g, "k=21 identity", "k = 3*7 = 21 is identity on all unit cycles", "21 = 1 mod lcm(4,5) = 20.", "");
  render_finding(g, "Mersenne smoothness", "Smooth M(n) exist for n in {1,2,3,4,6} only", "= proper divisors of 12. M(1)=1, M(2)=3, M(3)=7, M(4)=15, M(6)=63. Smooth Mersenne exponents = squaring cycle lengths. M(12)=4095=9*5*7*13.", "");
  render_p(sec, "k-th power collapse by class: Z/210 elements collapse to e_11 for k >= 3 in 1 step (cubing beats squaring). Z/2,310 collapses to void for k >= 3. Self-order: Z/210 = 1, Z/6 = 2, Z/2,310 = 7.");
  dom_append(dom_body(), sec)
)

fn carousel_identity_lattice() = (
  let sec = make_section("800px") in
  render_h2(sec, "Identity Power Lattice");
  render_p(sec, "Which elements are preserved by exponentiation? The identity power lattice reveals the stiffness of each channel.");
  render_theorem(sec, "Mod-49 Stiffness Theorem", "lambda(49) = 7*6 = 42. Without mod-49: lambda = 60. With: lcm(60,42) = 420. The mod-49 channel multiplies stiffness by 7. The number 42 is the mod-49 channel's Carmichael lambda.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "lambda");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Z/8", "2", "Rigid. Flips once.");
  render_table_row(tbl, "Z/9", "6", "Period 6 cycle.");
  render_table_row(tbl, "Z/11", "10", "Period 10 cycle.");
  render_table_row(tbl, "Z/25", "20", "Period 20 cycle.");
  render_table_row(tbl, "Z/49", "42", "Controls the ceiling. lcm(2,6,10,20,42) = 420.");
  let g = make_findings_grid(sec) in
  render_finding(g, "11 self-preservation", "11 is the ONLY prime with x^p = x for ALL x in its own channel", "Exponent 1. Unique among the six. Fat channels break self-preservation: lambda(p^e) > p. 11 preserves because its exponent is 1.", "");
  render_finding(g, "Pair preservation", "Min k > 1 preserving 2 channels", "{Z/8,Z/9}: 7. {Z/9,Z/49}: 43 = Heegner. {Z/25,Z/49}: 421 = 420+1. {Z/49,Z/11}: 211 = 210+1. All ring-meaningful.", "");
  render_finding(g, "Cross-chain resonance", "Cunningham chains in channel pairs", "max(p^e) = p^(e-1). Self-similar scaling. {2,5,11}: chain resonance -- each channel resonates with the previous Cunningham member.", "");
  dom_append(dom_body(), sec)
)

/* Carousel spinning cost: enter n, show frozen/spinning rings */
fn carousel_spin_calc() = (
  let n = parse_int_from("#car-input") in
  let result = dom_query("#car-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r2 = n % 8 in
    let r3 = n % 9 in
    let r5 = n % 25 in
    let r7 = n % 49 in
    let r11 = n % 11 in
    let r13 = n % 13 in
    let f2 = if n % 2 == 0 then 1 else 0 in
    let f3 = if n % 3 == 0 then 1 else 0 in
    let f5 = if n % 5 == 0 then 1 else 0 in
    let f7 = if n % 7 == 0 then 1 else 0 in
    let f11 = if n % 11 == 0 then 1 else 0 in
    let f13 = if n % 13 == 0 then 1 else 0 in
    let spinning = 6 - f2 - f3 - f5 - f7 - f11 - f13 in
    let s2 = if f2 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r2}</span>" in
    let s3 = if f3 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r3}</span>" in
    let s5 = if f5 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r5}</span>" in
    let s7 = if f7 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r7}</span>" in
    let s11 = if f11 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r11}</span>" in
    let s13 = if f13 > 0 then "<span style='color:#ff6666'>FROZEN</span>" else "<span style='color:#88ddaa'>${r13}</span>" in
    let hclass = if spinning == 6 then "H=6 (unit, all spinning)" else if spinning == 0 then "H=0 (axis, all frozen)" else "H=${spinning}" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>n = ${n} on the carousel</p><p style='margin:4px 0'>CRT = (${s2}, ${s3}, ${s5}, ${s7}, ${s11}, ${s13})</p><p style='margin:4px 0;color:#b8b8c8'>Hamming weight: ${hclass}</p><p style='margin:4px 0;color:#b0b0c0'>Frozen = divisible by that prime. ${spinning}/6 rings spinning.</p>")
  )
)

fn carousel_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Modular arithmetic", "Wraps around a single clock", "Six clocks at different speeds. Z/12,612,600 = discrete 6-torus. CRT is the mechanism, not a tool.");
  render_contrast_row(tbl, "Element order", "How many additions to return to 0", "Cost of spinning. High coupling = more rings active = higher cost. Frozen rings = idempotent rest.");
  render_contrast_row(tbl, "Carmichael lambda = 420", "Carmichael function value", "All power maps cycle in 420 steps. 108 = 4*27 rings share this Carmichael lambda exactly (mod-49 forced). 84 of those divide 12,612,600; 24 extensions reach 2*12,612,600. Lattice invariant, not coincidence.");
  render_contrast_row(tbl, "Kleiber's 3/4 law", "Empirical scaling observation", "Hamming null eigenvalue ratio 360/480 = 3/4. Emerges from 5 = 2+3 (convergence theorem).");
  render_contrast_row(tbl, "Braid chirality", "Topological curiosity", "LEFT-HANDED at all levels. Beat formula: net = -gcd(p_i-1, p_j-1). Algebraically forced.");
  render_contrast_row(tbl, "Carmichael lambda ladder", "Arbitrary Carmichael values", "Level-to-level ratios = 2, 3, 5, 7 in exact chain order. The multiplicative dynamics IS the chain.");
  render_contrast_row(tbl, "Squaring cycles", "Number-theoretic curiosity", "Lengths divide 12. Max cycle = Carmichael lambda(two levels back). Class collapse sum = 9.");
  render_contrast_row(tbl, "b1-Lie", "Coincidental dimensions", "b1(Z/8 x Z/9) = 56 = E7. b1(Z/25 x Z/11) = 240 = E8 roots. Forced by (p-1)(q-1) = dim(SU(p)) when q = p+2.");
  render_contrast_row(tbl, "Mandelbrot fattening", "Same dynamics at any scale", "mod-11 invariant (exponent 1). c=2 explodes 28x. The first prime unleashes the most dynamics.");
  render_contrast_row(tbl, "64 switches", "Abstract idempotents", "6-cube control panel. |Image|*|Kernel| = N (conservation). Class switches: progression = turning rings ON.");
  render_contrast_row(tbl, "k-th power maps", "Just exponentiation", "Max cycles pair: {2,3}->12, {5,11}->6, {7,13}->4. All divide 12. Cubing blocked at period 3. Self-recognition: p has p fixed points.");
  render_contrast_row(tbl, "Channel stiffness", "Carmichael lambda, a number", "lambda(49) = 42. The mod-49 channel controls the ceiling. 11 self-preserves (exponent 1). Pair preservation values: 7, 43, 421, 211.");
  render_contrast_row(tbl, "Horn-cap geometry", "Torus as abstract product", "T^7 = Gabriel-Horn cap of Z^7. 7 circles of the torus. Gap 4*sin^2(pi/49) locked at mod-49. Theorem 33 + Theorem 34 STRUCTURAL, NOT Clay proofs.");
  render_p(sec, "Seven rings, one motion, zero choices. Everything forced by the CRT decomposition and the seven primes it requires.");
  dom_append(dom_body(), sec)
)



fn page_carousel() = (
  dom_head_meta("description", "The CRT carousel on T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17), the Gabriel-Horn cap of Z^7. Spectral gap 4*sin^2(pi/49) locked across all 108 lambda-420 rings. Theorem 33 + Theorem 34 STRUCTURAL analogs (NOT Clay proofs). 64 = 2^6 idempotent switches. Betti-Lie (56=E7, 240=E8). Mod-49 stiffness: lambda(49) = 42.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The CRT Carousel: Seven Channels on T^7\",\"description\":\"Seven CRT channels as circles of T^7 = S^1(8) x S^1(9) x S^1(25) x S^1(49) x S^1(11) x S^1(13) x S^1(17), the Gabriel-Horn cap of Z^7. Spectral gap 4*sin^2(pi/49) locked across 108 lambda-420 rings. Theorem 33 + Theorem 34 STRUCTURAL analogs (NOT Clay proofs). Braid topology, torus knots, Betti-Lie (56=E7, 240=E8).\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/patterns/carousel\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"},{\"@type\":\"DefinedTerm\",\"name\":\"Braid Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"Torus Knots\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gabriel-Horn Cap\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT-Decomposed Laplacian\"}]}");
  carousel_hero();
  carousel_frozen();
  carousel_cost();
  carousel_braid();
  carousel_strand_height();
  carousel_torus_knots();
  carousel_hamming_graph();
  carousel_shell_polynomial();
  carousel_lambda();
  carousel_squaring();
  carousel_seed_flower();
  carousel_betti();
  carousel_mandelbrot();
  carousel_switches();
  carousel_horn_cap();
  carousel_power_maps();
  carousel_identity_lattice();
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Carousel Position");
  render_p(sec_i, "Enter any number to see its position on the 6-ring carousel. Shows CRT coordinates and which rings are frozen (divisible by that prime). Try 210 (only mod-11 and mod-13 spin), 105 (mod-2, mod-11, and mod-13 spin), 1 (all 6 spin).");
  make_interactive_widget(sec_i, "Enter n:", "car-input", "e.g. 42", "Spin", "carousel_spin_calc", "car-result");
  dom_append(dom_body(), sec_i);
  carousel_contrast()
)

