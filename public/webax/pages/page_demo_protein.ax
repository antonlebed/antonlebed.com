/* page_demo_protein.ax -- CRT Protein Folding Proxy.
   7-channel TRANS (Z/214,414,200). Amino acid contacts via CRT coupling.
   7 channels = 7 interaction types. CC0. */

/* ================================================================
   CRT PROTEIN FOLDING PROXY -- /demos/protein.
   20 amino acids -> Z/214,414,200 residues. Contact prediction via
   CRT channel coupling. 7 channels = hydrophobic, charge, size,
   H-bond, aromatic, backbone, secondary structure propensity.
   ================================================================ */

/* Amino acid properties encoded as ring elements.
   Each AA gets a value in Z/214,414,200 based on its physical properties.
   The 7 CRT channels naturally separate into 7 interaction types:
     mod 8:  hydrophobicity (0=polar, 7=hydrophobic)
     mod 9:  charge class (0=neg, 4=neutral, 8=pos)
     mod 25: size/volume (small=low, large=high)
     mod 49: H-bond capacity (donor+acceptor count mapped)
     mod 11: aromaticity (0=none, 5=aromatic, 10=strong)
     mod 13: backbone flexibility (0=rigid, 12=flexible)
     mod 17: secondary structure propensity (0=coil, 8=helix, 16=sheet)
*/

/* Russian peasant mulmod for TRANS idempotents. */
fn prot_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb % m;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

fn prot_red(x) = (let m = 214414200 in if x >= m then x - m else x)

/* CRT reconstruct from 7 protein property channels.
   h=hydro, c=charge, s=size, hb=H-bond, ar=aromatic, fl=flex, ss=SS propensity */
fn crt7_prot(h, c, s, hb, ar, fl, ss) = (
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let r0 = prot_mulmod(h, idem[0]) in
  let r1 = prot_red(r0 + prot_mulmod(c, idem[1])) in
  let r2 = prot_red(r1 + prot_mulmod(s, idem[2])) in
  let r3 = prot_red(r2 + prot_mulmod(hb, idem[3])) in
  let r4 = prot_red(r3 + prot_mulmod(ar, idem[4])) in
  let r5 = prot_red(r4 + prot_mulmod(fl, idem[5])) in
  prot_red(r5 + prot_mulmod(ss, idem[6]))
)

/* Map amino acid single-letter code to ring element.
   20 standard amino acids. Returns ring value encoding 7 properties.
   7th param = secondary structure propensity (0=coil, ~8=helix, ~16=sheet) */
fn aa_to_ring(code) = (
  /* Hydro, Charge, Size, Hbond, Arom, Flex, SS -> CRT reconstruct */
  /* G=Gly  */ if code == 71 then crt7_prot(1, 4, 1, 2, 0, 12, 2)
  /* A=Ala  */ else if code == 65 then crt7_prot(4, 4, 3, 1, 0, 10, 14)
  /* V=Val  */ else if code == 86 then crt7_prot(6, 4, 10, 1, 0, 6, 15)
  /* L=Leu  */ else if code == 76 then crt7_prot(6, 4, 12, 1, 0, 7, 12)
  /* I=Ile  */ else if code == 73 then crt7_prot(7, 4, 12, 1, 0, 5, 15)
  /* P=Pro  */ else if code == 80 then crt7_prot(5, 4, 8, 0, 0, 1, 1)
  /* F=Phe  */ else if code == 70 then crt7_prot(7, 4, 16, 1, 8, 4, 13)
  /* W=Trp  */ else if code == 87 then crt7_prot(7, 4, 20, 3, 10, 3, 12)
  /* M=Met  */ else if code == 77 then crt7_prot(6, 4, 14, 1, 0, 7, 11)
  /* S=Ser  */ else if code == 83 then crt7_prot(1, 4, 4, 4, 0, 9, 5)
  /* T=Thr  */ else if code == 84 then crt7_prot(2, 4, 6, 4, 0, 8, 12)
  /* C=Cys  */ else if code == 67 then crt7_prot(5, 4, 5, 3, 0, 7, 9)
  /* Y=Tyr  */ else if code == 89 then crt7_prot(3, 4, 17, 5, 7, 4, 13)
  /* H=His  */ else if code == 72 then crt7_prot(1, 6, 13, 5, 5, 5, 8)
  /* D=Asp  */ else if code == 68 then crt7_prot(0, 1, 7, 6, 0, 8, 5)
  /* E=Glu  */ else if code == 69 then crt7_prot(0, 1, 10, 6, 0, 9, 13)
  /* N=Asn  */ else if code == 78 then crt7_prot(0, 4, 8, 6, 0, 8, 4)
  /* Q=Gln  */ else if code == 81 then crt7_prot(0, 4, 11, 6, 0, 9, 11)
  /* K=Lys  */ else if code == 75 then crt7_prot(0, 8, 13, 5, 0, 10, 10)
  /* R=Arg  */ else if code == 82 then crt7_prot(0, 8, 16, 8, 0, 9, 10)
  else 0
)

/* Compute contact score between two amino acids.
   Higher = more likely to be in contact. Uses per-channel coupling. */
fn contact_score(ring_a, ring_b) = (
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  /* Channel weights: hydrophobic contact (mod 8) is strongest driver */
  let weights = [4, 2, 1, 2, 3, 1, 2] in
  mut score = 0;
  mut ch = 0;
  while ch < 7 do (
    let m = mods[ch] in
    let ra = ring_a % m in
    let rb = ring_b % m in
    /* Coupling metric: how close are the residues in this channel */
    let diff = if ra > rb then ra - rb else rb - ra in
    let circ_diff = if diff > m / 2 then m - diff else diff in
    /* High hydrophobicity in both = attraction (low diff in D channel) */
    /* High charge opposite = attraction (diff near max in K channel) */
    let channel_score = if ch == 0 then (
      /* mod-8 channel: hydrophobic pairing. Both high = contact */
      let min_h = if ra < rb then ra else rb in
      min_h * weights[ch]
    ) else if ch == 1 then (
      /* mod-9 channel: charge complementarity. Opposite charges attract */
      circ_diff * weights[ch]
    ) else if ch == 4 then (
      /* mod-11 channel: aromatic stacking. Both aromatic = contact */
      let min_ar = if ra < rb then ra else rb in
      min_ar * weights[ch]
    ) else if ch == 6 then (
      /* mod-17 channel: SS propensity similarity. Same class = contact */
      (m - circ_diff) * weights[ch] / m
    ) else (
      /* Other channels: proximity contributes */
      (m - circ_diff) * weights[ch] / m
    ) in
    mut score = score + channel_score;
    mut ch = ch + 1
  );
  score
)

/* Predict contact map for a protein sequence.
   Returns flat array: n*n contact scores. */
fn predict_contacts(seq, n) = (
  /* Convert sequence to ring values */
  let rings = alloc(n) in
  mut i = 0;
  while i < n do (
    set(rings, i, aa_to_ring(charCode(seq, i)));
    mut i = i + 1
  );
  /* Compute contact map */
  let contacts = alloc(n * n) in
  mut r = 0;
  while r < n do (
    mut c = 0;
    while c < n do (
      /* Skip nearby residues (|i-j| < 4 = trivially in contact) */
      let sep = if r > c then r - c else c - r in
      if sep < 4 then (
        set(contacts, r * n + c, 0)
      ) else (
        set(contacts, r * n + c, contact_score(rings[r], rings[c]))
      );
      mut c = c + 1
    );
    mut r = r + 1
  );
  contacts
)

/* Classify fold type based on channel composition */
fn classify_fold(seq, n) = (
  let rings = alloc(n) in
  mut i = 0;
  while i < n do (
    set(rings, i, aa_to_ring(charCode(seq, i)));
    mut i = i + 1
  );
  /* Average channel values */
  mut sum_hydro = 0;
  mut sum_charge = 0;
  mut sum_arom = 0;
  mut j = 0;
  while j < n do (
    mut sum_hydro = sum_hydro + (rings[j] % 8);
    mut sum_charge = sum_charge + (rings[j] % 9);
    mut sum_arom = sum_arom + (rings[j] % 11);
    mut j = j + 1
  );
  let avg_h = sum_hydro / n in
  let avg_c = sum_charge / n in
  let avg_a = sum_arom / n in
  /* Fold class from channel averages */
  if avg_h > 4 then (
    if avg_a > 3 then "beta-barrel (membrane)" else "alpha-helix bundle (globular)"
  ) else if avg_c > 5 then "alpha+beta (mixed)"
  else if avg_c < 3 then "alpha/beta (alternating)"
  else "beta-sheet (structural)"
)

/* Example sequences */
fn get_example_seq(idx) = (
  /* Short representative sequences for demo */
  if idx == 0 then "MVLSPADKTNVKAAWGKVGAHAGEYGAEALERMFLSFPTTK"  /* hemoglobin-like alpha helix */
  else if idx == 1 then "KVFGRCELAAAMKRHGLDNYRGYSLGNWVCAAKFESNFNTQ" /* lysozyme-like alpha+beta */
  else if idx == 2 then "MFVFLVLLPLVSSQCVNLTTRTQLPPAYTNSFTRGVYYPDKVFR" /* spike-like beta sheet */
  else "GFPIGDGVMELRESEAIIHVLHSRHPGQLEQPDSQHSFL"  /* GFP-like beta barrel */
)

fn get_example_name(idx) = (
  if idx == 0 then "Hemoglobin-like (alpha helix)"
  else if idx == 1 then "Lysozyme-like (alpha+beta)"
  else if idx == 2 then "Spike-like (beta sheet)"
  else "GFP-like (beta barrel)"
)

/* Run the protein folding demo */
fn demo_protein_run() = (
  let result_el = dom_query("#dprot-result") in
  let seq_idx = parse_int_from("#dprot-input") in
  let idx = if seq_idx < 0 then 0 else if seq_idx > 3 then 3 else seq_idx in
  let seq = get_example_seq(idx) in
  let name = get_example_name(idx) in
  let n = len(seq) in

  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>CRT PROTEIN ANALYSIS: " + name + "</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0;font-size:12px'>Sequence (" + "${n}" + " residues): <span style='font-family:monospace;color:#88ddaa;word-break:break-all'>" + seq + "</span></p>";

  /* CRT decomposition of first 10 residues */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>CRT CHANNEL DECOMPOSITION (first 10 residues)</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:3px 6px;color:#666;font-size:10px'>Pos</th><th style='padding:3px 6px;color:#666;font-size:10px'>AA</th><th style='padding:3px 5px;color:#ff6666;font-size:9px'>mod 8</th><th style='padding:3px 5px;color:#44ff88;font-size:9px'>mod 9</th><th style='padding:3px 5px;color:#ff6666;font-size:9px'>mod 25</th><th style='padding:3px 5px;color:#ff6666;font-size:9px'>mod 49</th><th style='padding:3px 5px;color:#44ff88;font-size:9px'>mod 11</th><th style='padding:3px 5px;color:#44ff88;font-size:9px'>mod 13</th><th style='padding:3px 5px;color:#44ff88;font-size:9px'>mod 17</th></tr>";
  let show_n = if n < 10 then n else 10 in
  mut i = 0;
  while i < show_n do (
    let code = charCode(seq, i) in
    let rv = aa_to_ring(code) in
    let ch_str = charAt(seq, i) in
    mut html = html + "<tr><td style='padding:2px 6px;color:#888;font-size:12px'>" + "${i}" + "</td><td style='padding:2px 6px;color:#ffd700;font-size:14px;font-weight:bold'>" + ch_str + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#ff6666;font-size:12px'>" + "${rv % 8}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#44ff88;font-size:12px'>" + "${rv % 9}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#ff6666;font-size:12px'>" + "${rv % 25}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#ff6666;font-size:12px'>" + "${rv % 49}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#44ff88;font-size:12px'>" + "${rv % 11}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#44ff88;font-size:12px'>" + "${rv % 13}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#44ff88;font-size:12px'>" + "${rv % 17}" + "</td></tr>";
    mut i = i + 1
  );
  mut html = html + "</table>";

  /* Contact map (top 10 predicted contacts) */
  let contacts = predict_contacts(seq, n) in
  /* Find top contacts by scanning */
  let top_i = alloc(10) in
  let top_j = alloc(10) in
  let top_s = alloc(10) in
  mut found = 0;
  /* Simple: scan and keep top 10 */
  mut pass = 0;
  while pass < 10 do (
    mut best_r = 0;
    mut best_c2 = 0;
    mut best_score = 0;
    mut r = 0;
    while r < n do (
      mut c3 = r + 4;
      while c3 < n do (
        let s = contacts[r * n + c3] in
        if s > best_score then (
          /* Check not already picked */
          mut dup = 0;
          mut k = 0;
          while k < found do (
            if top_i[k] == r then (if top_j[k] == c3 then (mut dup = 1) else 0) else 0;
            mut k = k + 1
          );
          if dup == 0 then (
            mut best_r = r;
            mut best_c2 = c3;
            mut best_score = s
          ) else 0
        ) else 0;
        mut c3 = c3 + 1
      );
      mut r = r + 1
    );
    if best_score > 0 then (
      set(top_i, found, best_r);
      set(top_j, found, best_c2);
      set(top_s, found, best_score);
      mut found = found + 1
    ) else 0;
    mut pass = pass + 1
  );

  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>TOP " + "${found}" + " PREDICTED CONTACTS</p>";
  mut html = html + "<table style='border-collapse:collapse;margin-bottom:12px'><tr style='border-bottom:1px solid #333'><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Rank</th><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Res i</th><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Res j</th><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Sep</th><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Score</th><th style='padding:3px 10px;color:#ffd700;font-size:11px'>Type</th></tr>";
  mut t = 0;
  while t < found do (
    let ri = top_i[t] in
    let rj = top_j[t] in
    let sc = top_s[t] in
    let sep2 = rj - ri in
    let aa_i = charAt(seq, ri) in
    let aa_j = charAt(seq, rj) in
    let ring_i = aa_to_ring(charCode(seq, ri)) in
    let ring_j = aa_to_ring(charCode(seq, rj)) in
    /* Determine contact type from dominant channel */
    let h_i = ring_i % 8 in
    let h_j = ring_j % 8 in
    let a_i = ring_i % 11 in
    let a_j = ring_j % 11 in
    let c_i = ring_i % 9 in
    let c_j = ring_j % 9 in
    let min_h = if h_i < h_j then h_i else h_j in
    let min_a = if a_i < a_j then a_i else a_j in
    let c_diff = if c_i > c_j then c_i - c_j else c_j - c_i in
    let ctype = if min_h > 3 then "hydrophobic" else if c_diff > 4 then "salt bridge" else if min_a > 3 then "aromatic" else "H-bond" in
    let tc = if min_h > 3 then "#ff8844" else if c_diff > 4 then "#4488ff" else if min_a > 3 then "#ff44ff" else "#44ffaa" in
    mut html = html + "<tr><td style='padding:2px 10px;color:#888;font-size:12px'>" + "${t}" + "</td><td style='padding:2px 10px;color:#ffd700;font-size:12px'>" + aa_i + "${ri}" + "</td><td style='padding:2px 10px;color:#ffd700;font-size:12px'>" + aa_j + "${rj}" + "</td><td style='padding:2px 10px;color:#888;font-size:12px'>" + "${sep2}" + "</td><td style='padding:2px 10px;color:#88ddaa;font-size:14px;font-weight:bold'>" + "${sc}" + "</td><td style='padding:2px 10px;color:" + tc + ";font-size:12px;font-weight:bold'>" + ctype + "</td></tr>";
    mut t = t + 1
  );
  mut html = html + "</table>";

  /* Fold classification */
  let fold_class = classify_fold(seq, n) in
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>FOLD CLASSIFICATION</p>";
  mut html = html + "<p style='color:#44ff88;font-size:18px;font-weight:bold;margin:4px 0'>" + fold_class + "</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Channel averages map to structural class. mod-8 (hydrophobicity) and mod-11 (aromaticity) dominate fold determination.</p>";

  /* 3+4 split */
  mut html = html + "<p style='color:#ffd700;margin:12px 0 4px;font-size:13px'>3+4 DATA/PARITY SPLIT</p>";
  mut html = html + "<p style='color:#ff6666;margin:4px 0'>3 data channels {mod 8, mod 25, mod 49}: physical properties (hydrophobicity, size, H-bonds) -- FOLD DRIVERS</p>";
  mut html = html + "<p style='color:#44ff88;margin:4px 0'>4 parity channels {mod 9, mod 11, mod 13, mod 17}: interaction quality (charge, aromaticity, flexibility, SS propensity) -- FOLD VALIDATORS</p>";
  mut html = html + "<p style='color:#b0b0c0;margin:4px 0'>Data channels determine the fold. Parity channels verify it.</p>";

  mut html = html + "</div>";
  dom_inner(result_el, html)
)

/* Channel analysis across all 20 amino acids */
fn demo_protein_channels() = (
  let result_el = dom_query("#dprot-channels") in
  let aa_codes = [71, 65, 86, 76, 73, 80, 70, 87, 77, 83, 84, 67, 89, 72, 68, 69, 78, 81, 75, 82] in
  let aa_names = ["Gly", "Ala", "Val", "Leu", "Ile", "Pro", "Phe", "Trp", "Met", "Ser", "Thr", "Cys", "Tyr", "His", "Asp", "Glu", "Asn", "Gln", "Lys", "Arg"] in
  let aa_letters = ["G", "A", "V", "L", "I", "P", "F", "W", "M", "S", "T", "C", "Y", "H", "D", "E", "N", "Q", "K", "R"] in

  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'>";
  mut html = html + "<p style='color:#ffd700;margin:0 0 8px;font-size:16px'>ALL 20 AMINO ACIDS: CRT CHANNEL DECOMPOSITION</p>";
  mut html = html + "<table style='border-collapse:collapse'><tr style='border-bottom:1px solid #333'><th style='padding:3px 5px;color:#666;font-size:9px'>AA</th><th style='padding:3px 5px;color:#666;font-size:9px'>Name</th><th style='padding:3px 4px;color:#ff6666;font-size:9px'>m8</th><th style='padding:3px 4px;color:#44ff88;font-size:9px'>m9</th><th style='padding:3px 4px;color:#ff6666;font-size:9px'>m25</th><th style='padding:3px 4px;color:#ff6666;font-size:9px'>m49</th><th style='padding:3px 4px;color:#44ff88;font-size:9px'>m11</th><th style='padding:3px 4px;color:#44ff88;font-size:9px'>m13</th><th style='padding:3px 4px;color:#44ff88;font-size:9px'>m17</th><th style='padding:3px 5px;color:#888;font-size:9px'>Ring</th></tr>";
  mut a = 0;
  while a < 20 do (
    let code = aa_codes[a] in
    let rv = aa_to_ring(code) in
    let letter = aa_letters[a] in
    let nm = aa_names[a] in
    let h_val = rv % 8 in
    let h_color = if h_val > 4 then "#ff8844" else if h_val > 2 then "#888" else "#4488ff" in
    mut html = html + "<tr><td style='padding:2px 6px;color:#ffd700;font-size:13px;font-weight:bold'>" + letter + "</td><td style='padding:2px 6px;color:#b0b0c0;font-size:11px'>" + nm + "</td>";
    mut html = html + "<td style='padding:2px 6px;color:" + h_color + ";font-size:12px;font-weight:bold'>" + "${h_val}" + "</td>";
    mut html = html + "<td style='padding:2px 6px;color:#44ff88;font-size:12px'>" + "${rv % 9}" + "</td>";
    mut html = html + "<td style='padding:2px 6px;color:#ff6666;font-size:12px'>" + "${rv % 25}" + "</td>";
    mut html = html + "<td style='padding:2px 6px;color:#ff6666;font-size:12px'>" + "${rv % 49}" + "</td>";
    mut html = html + "<td style='padding:2px 4px;color:#44ff88;font-size:12px'>" + "${rv % 11}" + "</td>";
    mut html = html + "<td style='padding:2px 4px;color:#44ff88;font-size:12px'>" + "${rv % 13}" + "</td>";
    mut html = html + "<td style='padding:2px 4px;color:#44ff88;font-size:12px'>" + "${rv % 17}" + "</td>";
    mut html = html + "<td style='padding:2px 5px;color:#666;font-size:10px'>" + "${rv}" + "</td></tr>";
    mut a = a + 1
  );
  mut html = html + "</table>";
  mut html = html + "<p style='color:#b0b0c0;margin:8px 0 0;font-size:11px'>mod-8 channel: orange=hydrophobic, blue=polar. Each amino acid's physical properties decompose naturally into 7 CRT channels. No training needed -- the ring structure is the encoding.</p>";
  mut html = html + "</div>";
  dom_inner(result_el, html)
)

fn page_protein() = (
  dom_head_meta("description", "CRT Protein Folding Proxy over Z/214,414,200. 20 amino acids as CRT ring elements. 7 channels = 7 interaction types. Contact prediction without neural networks. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Protein Folding Proxy\",\"description\":\"CRT-decomposed protein contact prediction. 20 amino acids in Z/214,414,200. 7 channels = 7 interaction types. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/protein\"}");
  let hero = make_hero("CRT Protein Folding Proxy") in
  let eq = dom_create("div") in
  dom_text(eq, "CRT approach to protein contact prediction over Z/214,414,200. CC0.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "Protein structure prediction is dominated by neural networks with billions of parameters (AlphaFold, ESMFold). CRT approach: encode each amino acid's 7 physical properties into 7 CRT channels of Z/214,414,200. Contact prediction = channel coupling. Fold classification from channel averages. No training data. No GPU. No neural network. Just ring arithmetic on 20 amino acids.");
  dom_append(dom_body(), hero);

  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Protein Contact Theorem", "Each of the 20 amino acids maps to an element of Z/214,414,200 encoding 7 physical properties in 7 CRT channels: mod 8 = hydrophobicity, mod 9 = charge, mod 25 = size, mod 49 = H-bond capacity, mod 11 = aromaticity, mod 13 = backbone flexibility, mod 17 = secondary structure propensity. Contact between residues i and j is predicted by channel coupling: high hydrophobicity in both (mod-8 channel), opposite charges (mod-9 channel), or mutual aromaticity (mod-11 channel). 3+4 split: data channels (mod 8, 25, 49) = fold drivers. Parity channels (mod 9, 11, 13, 17) = fold validators.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "20 amino acids", "Ring elements", "Each AA = one number in Z/214,414,200. Physical properties split across 7 channels.", "");
  render_finding(g1, "7 interaction types", "7 CRT channels", "Hydrophobic, charge, size, H-bond, aromatic, flexibility, SS propensity. Independent.", "");
  render_finding(g1, "Contact prediction", "Channel coupling", "High coupling in mod-8 + mod-11 channels = predicted contact. No neural network.", "");
  render_finding(g1, "Fold classification", "Channel averages", "Channel averages determine structural class. mod-8 + mod-11 dominate.", "");
  dom_append(dom_body(), sec1);

  let sec2 = make_section("900px") in
  render_h2(sec2, "Analyze Protein");
  make_interactive_widget(sec2, "Example (0-3):", "dprot-input", "0=hemoglobin, 1=lysozyme, 2=spike, 3=GFP", "Analyze", "demo_protein_run", "dprot-result");
  render_p(sec2, "Select example protein. CRT decomposes each residue into 7 channels, predicts contacts, classifies fold type.");
  dom_append(dom_body(), sec2);

  let sec2b = make_section("900px") in
  render_h2(sec2b, "All 20 Amino Acids");
  let btn = dom_create("button") in
  dom_text(btn, "Show Channel Map");
  dom_style(btn, "background", "#ffd700");
  dom_style(btn, "color", "#0f0f2a");
  dom_style(btn, "border", "none");
  dom_style(btn, "padding", "10px 24px");
  dom_style(btn, "borderRadius", "6px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontWeight", "bold");
  dom_style(btn, "fontSize", "14px");
  dom_on(btn, "click", "demo_protein_channels");
  dom_append(sec2b, btn);
  let br = dom_create("div") in
  dom_attr(br, "id", "dprot-channels");
  dom_append(sec2b, br);
  render_p(sec2b, "All 20 standard amino acids decomposed into 7 CRT channels. Physical properties are the channel values.");
  dom_append(dom_body(), sec2b);

  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT vs Neural Network Folding");
  render_contrast_row(sec3, "Parameters", "AlphaFold: 93M parameters, trained on 170K structures", "CRT: 20 ring values. Zero training.");
  render_contrast_row(sec3, "Compute", "GPU cluster, hours per prediction", "Ring arithmetic, microseconds");
  render_contrast_row(sec3, "Channels", "Attention heads (opaque learned features)", "7 CRT channels = 7 named physical properties");
  render_contrast_row(sec3, "Interpretability", "Black box: cannot explain WHY residues contact", "Transparent: mod 8=hydrophobic, mod 9=charge, mod 11=aromatic");
  render_contrast_row(sec3, "Error detection", "Separate confidence scores", "mod-11 channel gives free integrity check");
  render_contrast_row(sec3, "Patent status", "DeepMind/Google (AlphaFold), Meta (ESMFold)", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)
