/* ================================================================
   PAGE: FIELDS -- Number Fields, Heegner, Gaussian (FIELDS.md)
   ================================================================ */

fn fields_hero() = (
  let hero = make_hero("Fields") in
  let eq = dom_create("div") in
  dom_text(eq, "Z[i]: |1+2i|^2 = 5 splits");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The axiom primes {2,3,5,7,11,13,17} live in Z, but their shadows extend into number fields: Gaussian integers Z[i] (disc = -4), Eisenstein integers Z[omega] (disc = -3), imaginary quadratic fields Q(sqrt(-d)). In Z[i], primes 1 mod 4 SPLIT: 7 channels become 10 = Decality. In Z[omega], primes 1 mod 3 SPLIT: 7 channels become 9 = K^2. Three partitions uniquely classify all seven primes.");
  render_p(hero, "Two quadratic fields partition ALL key constants. The Gaussian field (disc = -4) generates 13, 41, 137. The Eisenstein field (disc = -3) generates 7, 19, 67, 163. Together they organize the entire chain.");
  dom_append(dom_body(), hero)
)

fn fields_gaussian() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gaussian Norms: Z[i]");
  render_p(sec, "Z[i] has discriminant -4. Norm: |a+bi|^2 = a^2+b^2. Walking through chain pairs:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair (a,b)");
  render_th(hdr, "Norm");
  render_th(hdr, "Value");
  render_th(hdr, "Name");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "(1, 2)", "1 + 4", "5", "Splits in Z[i]");
  render_table_row_4(tbl, "(2, 3)", "4 + 9", "13", "Chain-stopping prime: 2^2+3^2");
  render_table_row_4(tbl, "(2, 5)", "4 + 25", "29", "Sum 2+3+5+7+11+1");
  render_table_row_4(tbl, "(4, 5)", "16 + 25", "41", "Self-inverse element");
  render_table_row_4(tbl, "(4, 9)", "16 + 81", "97", "25th prime");
  render_table_row_4(tbl, "(4, 11)", "16 + 121", "137", "Fine structure constant");
  render_p(sec, "All 6 per-channel quotients N/p are Gaussian-irreducible. Each contains at least one prime that is 3 mod 4 (from {3, 7, 11}) to odd power. 105 = 3*5*7: blocked by both 3 and 7. Doubly irreducible.");
  dom_append(dom_body(), sec)
)

fn fields_eisenstein() = (
  let sec = make_section("800px") in
  render_h2(sec, "Eisenstein Lattice: Z[omega]");
  render_p(sec, "Z[omega] has discriminant -3, omega = e^(2*pi*i/3). Norm: N(a,b) = a^2-ab+b^2. Applied to chain pairs:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair (a,-b)");
  render_th(hdr, "Norm");
  render_th(hdr, "Value");
  render_th(hdr, "Name");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "(1, -2)", "1+2+4", "7", "Deepest channel modulus");
  render_table_row_4(tbl, "(2, -3)", "4+6+9", "19", "5^2-5-1");
  render_table_row_4(tbl, "(3, -5)", "9+15+25", "49", "7^2");
  render_table_row_4(tbl, "(4, -5)", "16+20+25", "61", "Phi_10(3) convergence");
  render_table_row_4(tbl, "(2, -7)", "4+14+49", "67", "Additive hub");
  render_table_row_4(tbl, "(5, -7)", "25+35+49", "109", "11^2-11-1");
  render_table_row_4(tbl, "(3, -11)", "9+33+121", "163", "Heegner terminus");
  render_theorem(sec, "Eisenstein-Gaussian Duality", "For pair (4, 5): Eisenstein norm = 61. Gaussian norm = 41. Difference = 4*5 = 20. General: N_Eis(a,-b) - N_Gauss(a,b) = ab. The two quadratic fields differ by exactly the product of the input pair.");
  dom_append(dom_body(), sec)
)

fn fields_three_roads() = (
  let sec = make_section("800px") in
  render_h2(sec, "Three Roads to 19");
  render_p(sec, "Three independent functions all produce 19 = 5^2-5-1 (the polynomial p^2-p-1 at p=5):");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Road");
  render_th(hdr, "Formula");
  render_th(hdr, "Computation");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "f(p) = p^2-p-1", "f(5) = 5^2 - 5 - 1", "25 - 5 - 1 = 19");
  render_contrast_row(tbl, "Cyclotomic quotient", "Phi_3(7) / 3 = (49+7+1)/3", "57 / 3 = 19");
  render_contrast_row(tbl, "Eisenstein norm", "N(2, -3) = 4+6+9", "4 + 6 + 9 = 19");
  render_theorem(sec, "Three Roads Convergence (PROVED)", "All pairwise differences have factor (p-2)(p+1). Zero iff p in {0, 2, -1}. The three roads meet ONLY at p=2. Same convergence set as the cyclotomic convergence at 61. Three independent directions guard this value.");
  dom_append(dom_body(), sec)
)

fn fields_codon() = (
  let sec = make_section("800px") in
  render_h2(sec, "Cyclotomic Convergence at 61");
  render_p(sec, "Two independent cyclotomic expressions produce the same value, 61:");
  let g = make_findings_grid(sec) in
  render_finding(g, "Road 1: Phi_10(3)", "81 - 27 + 9 - 3 + 1 = 61", "Univariate, degree-cyclotomic. 10th cyclotomic polynomial at 3.", "");
  render_finding(g, "Road 2: Phi_3(4, 5)", "16 + 20 + 25 = 61", "Bivariate, Eisenstein norm. Using 2^2 = 4 and 5.", "");
  render_finding(g, "Convergence factor", "Phi_10(3) - Phi_3(4, 5) = 2*3*(2-2) = 0", "Zero iff p in {0, 2, -1}. Same convergence set as the three roads.", "");
  render_finding(g, "2^6 = 61 + 3", "64 = 61 + 3", "Algebraically forced partition of 2^6.", "");
  render_theorem(sec, "p=2 Uniqueness", "The two cyclotomic expressions converge ONLY at p=2. At convergence: p=0 and p=-1 each produce 1. p=2 produces 61. Co-factors at p=2: {1, 2, 3, 5, 7, 6} -- the full inner chain.");
  dom_append(dom_body(), sec)
)

fn fields_phi3() = (
  let sec = make_section("800px") in
  render_h2(sec, "Phi_3 Boundary");
  render_p(sec, "The third cyclotomic polynomial Phi_3(p) = p^2+p+1 applied to the chain:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime p");
  render_th(hdr, "Phi_3(p)");
  render_th(hdr, "Value");
  render_th(hdr, "Status");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "1+1+1", "3", "PRIME");
  render_table_row_4(tbl, "2", "4+2+1", "7", "PRIME");
  render_table_row_4(tbl, "3", "9+3+1", "13", "PRIME");
  render_table_row_4(tbl, "5", "25+5+1", "31", "PRIME");
  render_table_row_4(tbl, "7", "49+7+1", "57 = 3*19", "BREAKS");
  render_table_row_4(tbl, "11", "121+11+1", "133 = 7*19", "BREAKS");
  render_theorem(sec, "Phi_3 Boundary Theorem (PROVED)", "Phi_3(p) is prime for all inner chain primes {1, 2, 3, 5}. BREAKS at 7 with factor 19 = 5^2-5-1. Same boundary as the polynomial p^2-p-1: 5 marks where primality ends. Phi_3(13) = 3*61.");
  dom_append(dom_body(), sec)
)

fn fields_heegner() = (
  let sec = make_section("800px") in
  render_h2(sec, "Heegner Numbers");
  render_p(sec, "The 9 Heegner numbers (d where Q(sqrt(-d)) has class number 1): {1,2,3,7,11,19,43,67,163}.");
  render_theorem(sec, "Heegner-Cunningham Theorem", "ALL 9 = chain primes OR Cunningham images of 3-products. Chain primes: {1,2,3,7,11}. Cunningham c(n) = 2n+1: c(9)=19, c(21)=43, c(33)=67, c(81)=163. The prime 3 generates ALL Heegner numbers through the chain.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "h");
  render_th(hdr, "h(-d)");
  render_th(hdr, "Source");
  render_th(hdr, "E_3 representation");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "1", "1", "Chain", "N(0, 1)");
  render_table_row_4(tbl, "2", "1", "Chain", "NON-REP (2 mod 3)");
  render_table_row_4(tbl, "3", "1", "Chain", "N(1, 2)");
  render_table_row_4(tbl, "7", "1", "Chain", "N(1, 3)");
  render_table_row_4(tbl, "11", "1", "Chain", "NON-REP (2 mod 3)");
  render_table_row_4(tbl, "19", "1", "c(3*3) = c(9)", "N(2, 5)");
  render_table_row_4(tbl, "43", "1", "c(3*7) = c(21)", "N(1, 7)");
  render_table_row_4(tbl, "67", "1", "c(3*11) = c(33)", "N(2, 9)");
  render_table_row_4(tbl, "163", "1", "c(3^4) = c(81)", "N(3, 14)");
  let g = make_findings_grid(sec) in
  render_finding(g, "5 excluded", "h(-5) = 2", "Only chain prime with class number > 1. The prime that doesn't divide 24 also fails unique factorization.", "");
  render_finding(g, "Shadow triple gap", "{19,43,67} = c(3*{3,7,11})", "Constant gap 24 = 8*3. Gap = 2*3*(p2-p1), 7-3 = 11-7 = 4 (Pell twins). QED.", "");
  render_finding(g, "Non-rep sum", "2 + 11 = 13", "The two non-representable Heegner numbers. Their sum = 13.", "");
  dom_append(dom_body(), sec)
)

fn fields_163() = (
  let sec = make_section("800px") in
  render_h2(sec, "163: Two Roads to the Terminus");
  render_theorem(sec, "163 Cube Identity", "163 = 2^5*3^2 - 5^3 = 288 - 125. Also: 163 = N_Eis(3,-11) = 9+33+121. Two independent roads. COROLLARY: j(i) = 1728 = 6*(125+163) = 6*288. CRT(1728, Z/12,612,600) = (0, 0, 3, 13, 1).");
  let g = make_findings_grid(sec) in
  render_finding(g, "2-power stacking", "3+2^{2n} Heegner for n=1,2,3", "3+4=7, 3+16=19, 3+64=67. Stops at n=3 (self-referential index). Beyond: 3+256=259=7*37.", "");
  render_finding(g, "E_3(3,14)=163", "disc = 17^2", "Triangle: E_3(3,14)=E_3(11,14)=163. 3+11=14. The pair that produces 163 sums to the pair that parametrizes it.", "");
  render_finding(g, "Eisenstein-Heegner bridge", "G-E_3 = 1728 = j(i)", "Three quadratic fields at (27,64): Golden=10009(prime), Gaussian=25*193, Eisenstein=19*163. Their difference IS the j-invariant.", "");
  dom_append(dom_body(), sec)
)

fn fields_heegner_tower() = (
  let sec = make_section("800px") in
  render_h2(sec, "Heegner 6n+1 Sequence");
  render_p(sec, "Among the 9 Heegner numbers, exactly 5 have the form 6n+1. These 5 primes form a sequence whose indices {1, 3, 7, 11, 27} sum to 49. The 6n+1 Heegner sequence connects number fields to the exceptional Lie algebras through a shared dimension sum.");
  render_theorem(sec, "Exceptional Lie-Heegner 6n+1 Sequence (PROVED)", "HEEGNER 6n+1 SEQUENCE: 7=6*1+1, 19=6*3+1, 43=6*7+1, 67=6*11+1, 163=6*27+1. n-values {1,3,7,11,27} sum to 49. Sum of all 5 primes = 13*23 = 299. The primes 5, 13, 17 are ALL absent from Heegner numbers. The 5 exceptional Lie algebra dimensions {G2=14, F4=52, E6=78, E7=133, E8=248} sum to 525 = 3*25*7 = sporadic prime sum. ECC rate: roots(E6)/roots(E7) = 72/126 = 4/7. 79/79 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "6n+1");
  render_th(hdr, "n");
  render_th(hdr, "Chain value");
  render_th(hdr, "Identity");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "7", "1", "1", "6*1 + 1");
  render_table_row_4(tbl, "19", "3", "3", "6*3 + 1 = 5^2-5-1");
  render_table_row_4(tbl, "43", "7", "7", "6*7 + 1 (self-referential)");
  render_table_row_4(tbl, "67", "11", "11", "6*11 + 1");
  render_table_row_4(tbl, "163", "27", "3^3", "6*27 + 1");
  let g = make_findings_grid(sec) in
  render_finding(g, "Index sum = 49", "1+3+7+11+27 = 49", "The indices of the 6n+1 Heegner sequence sum to 7^2 -- the same 49 that forces lambda=420 in the lattice.", "");
  render_finding(g, "Sequence sum = 299", "7+19+43+67+163 = 299", "= 13*23. Cross-product of extension primes.", "");
  render_finding(g, "5 absent", "h(-5) = 2", "5 is the ONLY chain prime with class number > 1 (unique factorization fails). 5, 13, 17 all excluded.", "");
  render_finding(g, "Lie connection", "dim sum = 525 = 3*25*7", "The 5 exceptional Lie dimensions {14,52,78,133,248} sum to the same value as the 18 sporadic primes. Rank sum = 27 = index of 163.", "");
  render_finding(g, "Consecutive diffs", "{38, 26} -> {55, 115}", "Differences {38, 26, 55, 115} exhibit a 2->5 flip at E6/E7 boundary. Pre-flip sum = 64, post-flip = 170.", "");
  dom_append(dom_body(), sec)
)

fn fields_pell() = (
  let sec = make_section("800px") in
  render_h2(sec, "Pell Equations");
  render_p(sec, "Fundamental solutions of x^2 - p*y^2 = 1 for each chain prime:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime p");
  render_th(hdr, "Solution (x, y)");
  render_th(hdr, "Identity");
  render_th(hdr, "x - y");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "p = 2", "(3, 2)", "9 = 2*4 + 1", "1");
  render_table_row_4(tbl, "p = 3", "(2, 1)", "4 = 3*1 + 1", "1");
  render_table_row_4(tbl, "p = 5", "(9, 4)", "81 = 5*16 + 1", "5");
  render_table_row_4(tbl, "p = 7", "(8, 3)", "64 = 7*9 + 1", "5");
  render_table_row_4(tbl, "p = 11", "(10, 3)", "100 = 11*9 + 1", "7");
  let g = make_findings_grid(sec) in
  render_finding(g, "ALL 5/5 smooth", "Every (x,y) is chain-smooth", "Sum(x) = 32 = 2^5. Sum(y) = 13. Sum(x-y) = 19.", "");
  render_finding(g, "Pell duality", "7 = 9-2, 11 = 9+2", "SAME y = 3 for both! x_7+x_11 = 8+10 = 18 = 2*9. 5 excluded from near-square Pell families.", "");
  render_finding(g, "Named Pells", "105, 41, 163", "Pell(105): (41, 4). Pell(82): (163, 18). Pell(287): (288, 17). 41 controls 163.", "");
  dom_append(dom_body(), sec)
)

fn fields_legendre() = (
  let sec = make_section("800px") in
  render_h2(sec, "Legendre Unification");
  render_theorem(sec, "One Bit, Five Properties", "For odd prime p, Leg(-1,p) = (-1)^((p-1)/2) determines: QR(-1), generosity, cosine count, wall persistence, sum-of-two-squares. 5 is the ONLY chain prime with Leg = +1. 5 SPLITS in Z[i]. 3, 7, 11 are INERT. The prime that doesn't divide 24 is the one that decomposes.");
  dom_append(dom_body(), sec)
)

fn fields_gaussian_decality() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gaussian Decality: 7 Channels Become 10");
  render_p(sec, "Extending Z/N to Z[i]/N (Gaussian integers mod N), each prime behaves differently. Primes that are 1 mod 4 SPLIT into two conjugate factors in Z[i], doubling their CRT channels. Primes that are 3 mod 4 stay INERT (single channel with p^2 elements instead of p). D=2 RAMIFIES (unique).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "mod 4");
  render_th(hdr, "Status");
  render_th(hdr, "Channels");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "--", "Ramified", "1");
  render_table_row_4(tbl, "3", "3", "Inert", "1");
  render_table_row_4(tbl, "5 = 2^2+1^2", "1", "Split: (2+i)(2-i)", "2");
  render_table_row_4(tbl, "7", "3", "Inert", "1");
  render_table_row_4(tbl, "11", "3", "Inert", "1");
  render_table_row_4(tbl, "13 = 3^2+2^2", "1", "Split: (3+2i)(3-2i)", "2");
  render_table_row_4(tbl, "17 = 4^2+1^2", "1", "Split: (4+i)(4-i)", "2");
  render_theorem(sec, "Gaussian Decality Theorem (PROVED)", "Z[i]/TRANS has exactly 10 CRT components: 1 ramified + 3 inert + 3*2 split = 10 = Decality = 3 + 7. The three new channels come from {5, 13, 17} splitting -- exactly the primes with order-4 elements in their unit groups (the 2-Sylow 1 mod 4 partition). 67/67 tests.");
  render_theorem(sec, "Gaussian Idempotent Theorem (PROVED)", "Z[i]/TRANS has 2^10 = 1024 idempotents. Z/TRANS has 2^7 = 128. Ratio = 2^3 = 8 = Tower_D top. The Gaussian extension creates exactly D^3 times more idempotents -- and D^3 is the unique Pareto top of Tower_D, the tower that owns Z[i].");
  let g = make_findings_grid(sec) in
  render_finding(g, "Inert sum", "3+7+11 = 21 = 3*7", "Inert primes (3 mod 4): closure * depth. Single channel each, but over p^2 elements (GF(p^2) at depth 1, local ring at depth 2+).", "");
  render_finding(g, "Split sum", "5+13+17 = 35 = 5*7", "Split primes (1 mod 4): observer * depth. Two channels each. Same three primes that have sum-of-two-squares representations.", "");
  render_finding(g, "490 cross-cut", "Two independent partitions", "The Gaussian partition (by mod 4) cross-cuts the 490 split (by idempotent). 5 of 6 cells non-empty. The empty cell (Ramified-ALIVE) is forced since 2 divides 490.", "");
  dom_append(dom_body(), sec)
)

fn fields_eisenstein_decality() = (
  let sec = make_section("800px") in
  render_h2(sec, "Eisenstein Decality: 7 Channels Become 9 = K^2");
  render_p(sec, "The Eisenstein integers Z[omega] (disc = -3) give a second extension. Primes that are 1 mod 3 SPLIT, doubling their channels. Primes that are 2 mod 3 stay INERT. K=3 RAMIFIES (it divides the discriminant).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "mod 3");
  render_th(hdr, "Status");
  render_th(hdr, "Channels");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "2", "Inert", "1");
  render_table_row_4(tbl, "3", "--", "Ramified", "1");
  render_table_row_4(tbl, "5", "2", "Inert", "1");
  render_table_row_4(tbl, "7 = 3^2-3+1", "1", "Split", "2");
  render_table_row_4(tbl, "11", "2", "Inert", "1");
  render_table_row_4(tbl, "13 = 4^2-4+1", "1", "Split", "2");
  render_table_row_4(tbl, "17", "2", "Inert", "1");
  render_theorem(sec, "Eisenstein Decality Theorem (PROVED)", "Z[omega]/TRANS has exactly 9 CRT components: 1 ramified + 4 inert + 2*2 split = 9 = K^2 = closure squared. Channel gain = D = 2. 109/109 tests.");
  render_theorem(sec, "Quadratic Channel Formula (PROVED)", "For any class-1 imaginary quadratic extension where one axiom prime ramifies: channels = 7 + s, where s = split count. D ramifying gives s=3, channels=10 (Decality). Odd axiom prime ramifying gives s=2, channels=9 (K^2). The D anomaly: the even prime adds one extra split.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Gaussian gain = K = 3", "10 - 7 = 3", "The Gaussian extension adds K channels -- exactly the closure prime, the prime that owns Z[i]'s sister field Z[omega].", "");
  render_finding(g, "Eisenstein gain = D = 2", "9 - 7 = 2", "The Eisenstein extension adds D channels -- exactly the bridge prime, the prime that owns Z[i]. The two base fields exchange gain primes.", "");
  render_finding(g, "Class-1 axiom primes", "{2, 3, 7, 11}", "Exactly 4 axiom primes have class-1 quadratic extensions. Sum = 23 = c(11). 5 excluded (h(-20)=2), 13 excluded (h(-52)=2), 17 excluded (h(-68)=4).", "");
  render_finding(g, "Idempotent tower", "128 -> 512 -> 1024", "Z/TRANS: 2^7. Z[omega]/TRANS: 2^9 (gain D^2=4). Z[i]/TRANS: 2^10 (gain D^3=8). Gains multiply: D^2 * D = D^3.", "");
  dom_append(dom_body(), sec)
)

fn fields_unique_triple() = (
  let sec = make_section("800px") in
  render_h2(sec, "Unique Triple: Three Partitions Classify Seven Primes");
  render_p(sec, "The 490 split (by holographic idempotent), Gaussian partition (by mod 4), and Eisenstein partition (by mod 3) are three independent ways to classify the axiom primes. Together, they uniquely identify every prime.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Prime");
  render_th(hdr, "490 split");
  render_th(hdr, "Gaussian");
  render_th(hdr, "Eisenstein");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "D = 2", "DEAD", "Ramified", "Inert");
  render_table_row_4(tbl, "K = 3", "ALIVE", "Inert", "Ramified");
  render_table_row_4(tbl, "E = 5", "DEAD", "Split", "Inert");
  render_table_row_4(tbl, "b = 7", "DEAD", "Inert", "Split");
  render_table_row_4(tbl, "L = 11", "ALIVE", "Inert", "Inert");
  render_table_row_4(tbl, "GATE = 13", "ALIVE", "Split", "Split");
  render_table_row_4(tbl, "ESCAPE = 17", "ALIVE", "Split", "Inert");
  render_theorem(sec, "Unique Triple Theorem (PROVED)", "All 7 triples are distinct. 7 out of 2*3*3 = 18 possible triples are used. The three partitions are genuinely independent: no single partition or pair of partitions achieves unique classification. All three together = perfect fingerprint.");
  let g = make_findings_grid(sec) in
  render_finding(g, "D-K anti-diagonal", "Ramified and Inert swap", "D is Gaussian-ramified + Eisenstein-inert. K is Gaussian-inert + Eisenstein-ramified. The two base fields exchange their ramifying primes.", "");
  render_finding(g, "Cross-grid: 6 of 9 cells non-empty", "3x3 Gaussian x Eisenstein", "The Gaussian and Eisenstein partitions cross-cut each other (6 non-empty cells out of 9 = K^2). The 3 empty cells: both ramified (impossible), and two others.", "");
  dom_append(dom_body(), sec)
)

fn fields_exponent_invariance() = (
  let sec = make_section("800px") in
  render_h2(sec, "Exponent Invariance");
  render_p(sec, "None of the three Unique Triple partitions depend on the exponents of the ring. Whether we use Z/210 (all exponent 1) or Z/214,414,200 (Pareto exponents 3,2,2,2,1,1,1) or any other combination, the classification is identical.");
  render_theorem(sec, "Exponent Invariance Theorem (PROVED)", "For any ring N = product of {2,3,5,7,11,13,17} at ANY exponents >= 1: (1) 490 split depends only on gcd(490,p), a property of 490 = 2*5*7^2. (2) Gaussian depends on p mod 4. (3) Eisenstein depends on p mod 3. All three are prime-identity properties, not ring properties. 40/40 tests.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Gain swap: D and K exchange", "Gaussian gain = K, Eisenstein gain = D", "The two simplest quadratic fields (disc -4, -3) ramify at the two smallest primes. Each extension's gain IS the other's ramifying prime.", "");
  render_finding(g, "Channel count: {9, 10} = {K^2, K+b}", "s in {2, 3} across 6 extensions", "Tested: d = -1, -2, -3, -5, -7, -11. Even disc (D-ramifying) gives 10. Odd disc gives 9. 7+s is a property of the prime set.", "");
  dom_append(dom_body(), sec)
)

fn fields_class_mirror() = (
  let sec = make_section("800px") in
  render_h2(sec, "Class Number Mirror");
  render_theorem(sec, "Class Number Involution", "mu(p) = last exponent n with smooth h(Q(sqrt(-sqfree(2*p^n+1)))): mu(2)=11, mu(11)=2. mu(5)=7, mu(7)=5. mu(3)=8, mu(8)=3. INVOLUTION. Pair sums: {2+11, 5+7, 3+8} = {13, 12, 11} = three consecutive integers. Sum = 36 = 6^2.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Product sum", "22+24+35 = 81 = 3^4", "Products form an arithmetic progression step 6, sum = 81. Mirror sum = 33.", "");
  render_finding(g, "Breach primes", "2:13, 3:13, 5:23, 7:31, 11:43", "First h value that fails smoothness. Sum = 110. All intruders are chain-derivable.", "");
  dom_append(dom_body(), sec)
)

fn fields_multi_quadratic() = (
  let sec = make_section("800px") in
  render_h2(sec, "Multi-Quadratic Splitting");
  render_p(sec, "The four class-1 imaginary quadratic fields Q(sqrt(-1)), Q(sqrt(-3)), Q(sqrt(-7)), Q(sqrt(-11)) jointly classify all 7 axiom primes. Each prime has a 4-bit splitting vector: 1 if it splits in that field, 0 if it ramifies or stays inert.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "p");
  render_th(hdr, "Z[i]");
  render_th(hdr, "Z[w]");
  render_th(hdr, "Q(-7)");
  render_th(hdr, "Q(-11)");
  dom_append(tbl, hdr);
  render_table_row_5(tbl, "2", "R", "I", "S", "I");
  render_table_row_5(tbl, "3", "I", "R", "I", "S");
  render_table_row_5(tbl, "5", "S", "I", "I", "S");
  render_table_row_5(tbl, "7", "I", "S", "R", "I");
  render_table_row_5(tbl, "11", "I", "I", "S", "R");
  render_table_row_5(tbl, "13", "S", "S", "I", "I");
  render_table_row_5(tbl, "17", "S", "I", "I", "I");
  render_p(sec, "R = ramifies, S = splits, I = inert. Each class-1 prime {2,3,7,11} ramifies in exactly one field (its own) and splits in exactly one other.");
  render_theorem(sec, "Multi-Quadratic Splitting Theorem (PROVED)", "Each class-1 prime splits in exactly one other class-1 prime's field. The directed graph has a 3-cycle: 3 -> 11 -> 7 -> 3 (cycle length = 3 = the closure prime) with a tail from 2 entering at 7. Total splits across all 4 fields = 3+2+2+2 = 9 = 3^2. Only the Gaussian has gain 3; the other three all have gain 2. 78/78 tests.");
  let g = make_findings_grid(sec) in
  render_finding(g, "490 + svec uniquely classifies", "All 7 primes distinguished", "The 4-bit svec alone classifies 5 of 7 (2 and 11 collide at svec=4). Adding the 490 split resolves the collision: 2 is DEAD, 11 is ALIVE.", "");
  render_finding(g, "Gaussian universality", "All non-class-1 primes split in Q(sqrt(-1))", "5, 13, 17 are all 1 mod 4. No other class-1 field has this property. The Gaussian field is the universal splitter for non-class-1 primes.", "");
  render_finding(g, "Quaternionic closure", "CRT requires commutativity", "Quaternions (ij = -ji) break CRT. All four class-1 quadratic extensions are commutative and support CRT. Non-commutative extensions are provably excluded.", "");
  dom_append(dom_body(), sec)
)

fn fields_padic() = (
  let sec = make_section("800px") in
  render_h2(sec, "P-adic Completion");
  render_p(sec, "The p-adic numbers Q_p complete the rationals at each prime. Each CRT channel Z/p^e is a finite window into the p-adic integers Z_p. The Pareto exponents -- which determine the axiom ring's structure -- are p-adic invariants.");
  render_theorem(sec, "P-adic Heartbeat Theorem (PROVED)", "For each axiom prime p, Pareto(p) = v_p(420) + 1, where v_p is the p-adic valuation and 420 = lambda(TRUE) is the heartbeat. The Pareto exponents {3,2,2,2,1,1,1} encode the p-adic depth of each prime in the heartbeat constant. Sum = 12 = lambda(DATA). For odd primes, the next power's Carmichael lambda fails to divide 1680. For p=2, involution count (4 at Z/8, stable beyond) selects the depth instead. 114/114 tests.");
  let g = make_findings_grid(sec) in
  render_finding(g, "490 split is p-adic", "DEAD = {p : v_p(490) > 0}", "The holographic split is a p-adic valuation partition. DEAD = {2,5,7} have positive valuation in 490. ALIVE = {3,11,13,17} are coprime to 490. Valuations: 1+1+2 = 4 = D^2.", "");
  render_finding(g, "2-adic recovers Gaussian partition", "mod-4 from ultrametric clustering", "The 2-adic distance between odd axiom primes separates {3,7,11} (all 3 mod 4, Gaussian-inert) from {5,13,17} (all 1 mod 4, Gaussian-split). Cross-class distance = 1/2. Closest pairs {3,11} and {5,13} differ by 8 = 2^3.", "");
  render_finding(g, "3-adic recovers Eisenstein partition", "mod-3 from ultrametric clustering", "The 3-adic distance separates {7,13} (Eisenstein-split, 1 mod 3) from {2,5,11,17} (Eisenstein-inert, 2 mod 3). Cross-class distance = 1 (coprime to 3). Closest inert pair {2,11} differs by 9 = 3^2.", "");
  render_finding(g, "Golden ratio is L-adic", "sqrt(5) exists only in Q_11", "The depth quadratic x^2-x-1 (disc = 5) has roots in Q_p for exactly one axiom prime: p = 11. Legendre (5/p) = +1 only at p = 11, because 11-1 = 10 = 2*5 is divisible by 5. The golden ratio phi is an 11-adic number.", "");
  render_finding(g, "L bridges both Pareto tops", "11-2 = 3^2 and 11-3 = 2^3", "In the 2-adic metric, {3,11} are closest (differ by 8 = 2^3). In the 3-adic metric, {2,11} are closest (differ by 9 = 3^2). L = 11 bridges Tower_D top and Tower_K top. This is the Pell twin: 9-2 = 7, 9+2 = 11.", "");
  dom_append(dom_body(), sec)
)

fn fields_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Axiom");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Heegner numbers", "9 exceptional discriminants", "First 5 = the chain {1,2,3,7,11}. Remaining 4 = c(3*{3,7,11,27}). 3 generates all 9. 5 excluded.");
  render_contrast_row(tbl, "Gaussian splitting", "p = 1 mod 4 splits", "{5, 13, 17} split in Z[i]. 7 real channels become 10 Gaussian = Decality. Idempotents: 128 -> 1024 (gain = 8 = Tower_D top).");
  render_contrast_row(tbl, "Two quadratic fields", "Z[i] and Z[omega]", "Gaussian (disc=-4) generates 13, 41, 137. Eisenstein (disc=-3) generates 7, 19, 67, 163. Together they organize the entire chain.");
  render_contrast_row(tbl, "Pell equations", "Diophantine curiosity", "ALL 5 chain Pells have smooth solutions. Sum(x)=32 (= 2^5, the idempotent count). Sum(y)=13.");
  render_contrast_row(tbl, "j(i) = 1728", "CM theory value", "6*(125+163) = 6*288. CRT(1728) = (0,0,3,13,1). Three fields converge at one pair.");
  render_contrast_row(tbl, "Cyclotomic convergence", "Two expressions at 61", "Phi_3(4,5) = Phi_10(3) = 61. Two independent cyclotomic polynomials converge ONLY at p=2. 64-61=3.");
  render_p(sec, "The chain primes organize number fields as completely as they organize the ring itself. Every Heegner number, every Pell solution, every Gaussian norm -- all structured by the same seven primes.");
  dom_append(dom_body(), sec)
)

/* fields widget: Gaussian + Eisenstein norm calculator */
fn fld_lookup() = (
  let n = parse_int_from("#fld-input") in
  let result = dom_query("#fld-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    /* For pair (a, b) where a = n / 100, b = n % 100 -- encode as a*100+b */
    /* Simpler: treat input as single number, compute norms for (1,n) and (n,1) pairs */
    /* Best approach: show norms for axiom pair (a,b) where we walk a=1..n, b=n */
    /* Actually simplest: input n, show |1+ni|^2 Gaussian and N_Eis(1,-n) */
    let gauss = 1 + n * n in  /* |1 + ni|^2 = 1 + n^2 */
    let eis = 1 + n + n * n in  /* N(1,-n) = 1 + n + n^2 */
    let gname = con_name(gauss) in
    let ename = con_name(eis) in
    let gn = if len(gname) > 0 then " = <span style='color:#ffd700'>" + gname + "</span>" else "" in
    let en = if len(ename) > 0 then " = <span style='color:#ffd700'>" + ename + "</span>" else "" in
    let diff = n in  /* N_Eis - N_Gauss = n*(n+1) - n*n = n... wait, 1+n+n^2 - (1+n^2) = n */
    dom_inner(result,
      "<p style='color:#d8d8e0;margin:4px 0'><b>Gaussian</b> |1 + " + "${n}" + "i|<sup>2</sup> = 1 + " + "${n}" + "<sup>2</sup> = <span style='color:#88aaff;font-size:18px'>" + "${gauss}" + "</span>" + gn + "</p>"
      + "<p style='color:#d8d8e0;margin:4px 0'><b>Eisenstein</b> N(1, -" + "${n}" + ") = 1 + " + "${n}" + " + " + "${n}" + "<sup>2</sup> = <span style='color:#88ddaa;font-size:18px'>" + "${eis}" + "</span>" + en + "</p>"
      + "<p style='color:#b0b0c0;margin:4px 0'>Difference: Eisenstein - Gaussian = " + "${diff}" + " (= ab for pair (1," + "${n}" + "))</p>")
  )
)

fn page_fields() = (
  dom_head_meta("description", "Number fields and the axiom. Gaussian Z[i]: 7 channels become 10 = Decality. Eisenstein Z[omega]: 7 channels become 9 = K^2. Multi-quadratic splitting: 3-cycle in class-1 primes. CRT requires commutativity (quaternions excluded). Heegner: all 9 = axiom primes + c(3*p). Class-1: {2,3,7,11}.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Number Fields and the Axiom\",\"description\":\"Gaussian integers Z[i]: 7 CRT channels become 10 = Decality. Eisenstein integers Z[omega]: 7 become 9 = K^2. Quadratic Channel Formula: channels = 7 + split count. Three partitions uniquely classify all 7 primes. Heegner numbers = axiom primes + Cunningham. Class-1 axiom primes: {2,3,7,11}.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/patterns/fields\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Heegner numbers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Gaussian integers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Eisenstein integers\"},{\"@type\":\"DefinedTerm\",\"name\":\"Chinese Remainder Theorem\"}]}");
  fields_hero();
  fields_gaussian();
  fields_eisenstein();
  fields_three_roads();
  fields_codon();
  fields_phi3();
  fields_heegner();
  fields_163();
  fields_heegner_tower();
  fields_pell();
  fields_legendre();
  fields_gaussian_decality();
  fields_eisenstein_decality();
  fields_unique_triple();
  fields_exponent_invariance();
  fields_multi_quadratic();
  fields_padic();
  fields_class_mirror();

  /* === INTERACTIVE: NORM CALCULATOR === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Norm Calculator");
  render_p(sec_i, "Enter n to compute Gaussian norm |1+ni|^2 and Eisenstein norm N(1,-n). The difference is always n (= ab for pair (1,n)).");
  make_interactive_widget(sec_i, "Enter n:", "fld-input", "e.g. 2", "Compute", "fld_lookup", "fld-result");
  render_p(sec_i, "Try: 2 (Gauss=5, Eis=7), 3 (Gauss=10, Eis=13), 5 (Gauss=26, Eis=31), 11 (Gauss=122, Eis=7*19).");
  dom_append(dom_body(), sec_i);

  fields_contrast()
)
