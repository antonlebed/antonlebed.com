/* ================================================================
   PAGE: SPECTRUM -- Eigenvalue Landscape (SPECTRUM.md)
   Tower lens (TT39): b-channel primary -- b^2=49 controls every spectral
   gap across the 84 lambda-420 rings. K-channel (K^2=9 false summit).
   E-channel (E=5 observer constancy). Cross-tower page; depth rules.
   ================================================================ */

/* spectrum helpers */
fn spectrum_hero() = (
  let hero = make_hero("The Spectrum") in
  let eq = dom_create("div") in
  dom_text(eq, "eigenvalue(n) = sum of 7 cosines");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Hold seven tuning forks together and strike them. Some combinations make your chest hum -- the vibrations lock in, amplify each other, become one voice. Others grate. Every number in the ring carries seven oscillations -- one per prime channel. The eigenvalue asks: do they sing together, or fight each other? eigenvalue(0) = 2*7 = 14 (all in phase). The mod-49 channel controls the landscape: 4sin^2(pi/49) = 0.016 is the universal spectral gap across all lambda-420 rings. Z/12,612,600 has 341,250 distinct classes; Z/214,414,200 has 3,071,250.");
  dom_append(dom_body(), hero)
)

fn spectrum_formula() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Seven Voices");
  render_p(sec, "Z/2,310: eigenvalue(n) = cos(pi*n) + 2cos(2pi*n/3) + 2cos(2pi*n/5) + 2cos(2pi*n/7) + 2cos(2pi*n/11). Z/12,612,600: sum of 2cos(2pi*n_i/m_i) for m_i in {8,9,25,49,11,13}. Z/214,414,200: add 2cos(2pi*n/17). Seven cosines. One per prime. Their sum is what the number sounds like.");
  render_theorem(sec, "Spectral Fingerprint Theorem", "All eigenvalue classes are DISTINCT. Zero collisions. 341,250 at Z/12,612,600; 3,071,250 at Z/214,414,200. Proof: cyclotomic linear disjointness for coprime moduli. Universal for all CRT rings. Within-class blur = 2^k sign ambiguity. Eigenvalue = energy, sign = phase.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Max / Classes");
  render_th(hdr, "Gap");
  render_th(hdr, "Kolmogorov");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/2,310", "3^2 = 9 / 288", "0.317 = 4sin^2(pi/11)", "phi/classes = 480/288 = 5/3.");
  render_table_row_4(tbl, "Z/970,200", "2*5 = 10 / 48,750", "0.016 = 4sin^2(pi/7^2)", "phi/classes = 1344/325.");
  render_table_row_4(tbl, "Z/12,612,600", "2^2*3 = 12 / 341,250", "0.016 = 4sin^2(pi/7^2)", "phi/classes = 2304/325 = 2^8*3^2/(5^2*13).");
  render_table_row_4(tbl, "Z/214,414,200", "2*7 = 14 / 3,071,250", "0.016 = 4sin^2(pi/7^2)", "Adding mod-17 extends degree by +2. Gap unchanged.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Maximum", "eigenvalue(0) = 14 = 2*7", "All 7 channels in phase (12 = 2^2*3 at TRUE level). Zero is most coherent.", "");
  render_finding(g, "Minimum", "eigenvalue_min = -13.686", "All 7 midpoints (floor(m/2) per channel). CRT midpoint sum = 63 = 7*9. TRUE: -11.720, sum = 55 = 5*11.", "");
  render_finding(g, "Mirror theorem", "eigenvalue(n) = eigenvalue(N-n)", "cos(2pi(m-r)/m) = cos(2pi*r/m). Every class has even multiplicity.", "");
  render_finding(g, "Zero-crossing", "ONLY 2^3=8 has zeros", "cos = 0 requires 4|m. Only 2^3 qualifies. The 2-channel is the only channel with silence capability.", "");
  render_finding(g, "Meta-ring skeleton", "E[eigenvalue | n mod 7 = r] = 2cos(2pi*r/7)", "Conditional mean of the full eigenvalue given meta-ring residue = one cosine on Z/7. CRT independence zeros other channels. The meta-ring IS the eigenvalue landscape's skeleton. PROVED.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_swim() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Eigenvalue Swim");
  render_p(sec, "Walk the chain. Start at zero (maximum coherence), step through each prime, and watch the eigenvalue change. The landscape has warm spots at composites, a false summit where you think you have arrived, and a twist at the end that changes everything.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "n");
  render_th(hdr, "Name");
  render_th(hdr, "lambda");
  render_th(hdr, "Feel");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "zero", "+9 (Z/2,310) / +10 (Z/970,200) / +12 (Z/12,612,600) / +14 (Z/214,414,200)", "Maximum harmony. All channels in phase.");
  render_table_row_4(tbl, "1", "identity", "+1.548", "Ground state. Already a fall from zero.");
  render_table_row_4(tbl, "2", "even prime", "-1.232", "Negative. Even/odd split creates discord.");
  render_table_row_4(tbl, "3", "odd prime", "-2.705", "Deeper discord. The third channel costs coherence.");
  render_table_row_4(tbl, "5", "prime", "-2.364", "Slightly less negative than 3.");
  render_table_row_4(tbl, "6", "2*3", "+2.946", "Composite = warm spot. Surprise positive.");
  render_table_row_4(tbl, "7", "prime", "-2.928", "Near-minimum discord.");
  render_table_row_4(tbl, "9", "3^2", "+2.004", "Looks like a peak. It is not.");
  render_table_row_4(tbl, "11", "prime", "-1.184", "Negative. The 5th chain prime.");
  render_p(sec, "Three discoveries: (1) Composites can be warm -- 2*3=6 is positive (+2.95), not negative. (2) False summit at 3^2=9 -- looks like a peak but is not the real one. (3) eigenvalue(11) = eigenvalue(4) = -1.184. The 5th chain prime and 2^2 have the same eigenvalue. Exactly the same.");
  dom_append(dom_body(), sec)
)

/* Shared spectral display: renders CRT decomposition into a DOM element */
fn spectrum_display(n, result_el) = (
  let d = n % 8 in
  let k = n % 9 in
  let e = n % 25 in
  let b_ch = n % 49 in
  let l = n % 11 in
  let g = n % 13 in
  let esc = n % 17 in
  let fd = if d > 4 then 8 - d else d in
  let fk = if k > 4 then 9 - k else k in
  let fe = if e > 12 then 25 - e else e in
  let fb = if b_ch > 24 then 49 - b_ch else b_ch in
  let fl = if l > 5 then 11 - l else l in
  let fg = if g > 6 then 13 - g else g in
  let fesc = if esc > 8 then 17 - esc else esc in
  let div_d = if d % 2 == 0 then 1 else 0 in
  let div_k = if k % 3 == 0 then 1 else 0 in
  let div_e = if e % 5 == 0 then 1 else 0 in
  let div_b = if b_ch % 7 == 0 then 1 else 0 in
  let div_l = if l == 0 then 1 else 0 in
  let div_g = if g == 0 then 1 else 0 in
  let div_esc = if esc == 0 then 1 else 0 in
  let dead = div_d + div_k + div_e + div_b + div_l + div_g + div_esc in
  let active = 7 - dead in
  let kingdom = if dead == 7 then "zero (all channels frozen)"
    else if dead == 0 then "identity (all spinning)"
    else if dead == 1 then (
      if div_d == 1 then "mod-8 zero (mod-8 channel frozen)"
      else if div_k == 1 then "mod-9 zero (mod-9 channel frozen)"
      else if div_e == 1 then "mod-25 zero (mod-25 channel frozen)"
      else if div_b == 1 then "mod-49 zero (mod-49 channel frozen)"
      else if div_l == 1 then "mod-11 zero (mod-11 channel frozen)"
      else if div_g == 1 then "mod-13 zero (mod-13 channel frozen)"
      else "mod-17 zero (mod-17 channel frozen)"
    ) else "compound (multiple frozen)" in
  let shell_avg = if active == 0 then "+14.00 = 2*7"
    else if active == 1 then "+11.89"
    else if active == 2 then "+9.75"
    else if active == 3 then "+7.60"
    else if active == 4 then "+5.43"
    else if active == 5 then "+3.25"
    else if active == 6 then "+1.05"
    else "-1.15" in
  let md = if d > 0 then 8 - d else 0 in
  let mk = if k > 0 then 9 - k else 0 in
  let me_ch = if e > 0 then 25 - e else 0 in
  let mb = if b_ch > 0 then 49 - b_ch else 0 in
  let ml = if l > 0 then 11 - l else 0 in
  let mg = if g > 0 then 13 - g else 0 in
  let mesc = if esc > 0 then 17 - esc else 0 in
  let name = if n == 0 then " = zero"
    else if n == 1 then " (identity)"
    else if n == 2 then " (even prime)"
    else if n == 3 then " (smallest odd prime)"
    else if n == 5 then " (prime)"
    else if n == 6 then " = 2*3"
    else if n == 7 then " (prime)"
    else if n == 9 then " = 3^2"
    else if n == 11 then " (prime)"
    else if n == 13 then " (prime)"
    else if n == 17 then " (prime, ring closure)"
    else if n == 30 then " = 2*3*5"
    else if n == 41 then " (self-inverse)"
    else if n == 42 then " = 2*3*7"
    else if n == 61 then ""
    else if n == 67 then ""
    else if n == 105 then " = 3*5*7"
    else if n == 137 then " (spectral minimum)"
    else if n == 210 then " = 2*3*5*7"
    else if n == 420 then " (Carmichael period)"
    else if n == OMEGA_VAL then " (projector 2^420 mod 12,612,600)"
    else if n == OMEGA_TRANS then " (projector 2^1680 mod 214,414,200)"
    else "" in
  dom_inner(result_el, "<p style='color:#ffd700;margin:4px 0'><b>n = " + "${n}" + name + "</b></p>" +
    "<p style='color:#88ddaa;margin:4px 0'>CRT: (" + "${d}" + ", " + "${k}" + ", " + "${e}" + ", " + "${b_ch}" + ", " + "${l}" + ", " + "${g}" + ", " + "${esc}" + ") mod (8, 9, 25, 49, 11, 13, 17)</p>" +
    "<p style='color:#b0b0c0;margin:4px 0'>Eigenvalue class: [" + "${fd}" + ", " + "${fk}" + ", " + "${fe}" + ", " + "${fb}" + ", " + "${fl}" + ", " + "${fg}" + ", " + "${fesc}" + "] -- cosine-folded</p>" +
    "<p style='color:#ff8844;margin:4px 0'>Shell H=" + "${active}" + " -- avg lambda ~ " + shell_avg + "</p>" +
    "<p style='color:#d8d8e0;margin:4px 0'>" + kingdom + "</p>" +
    "<p style='color:#a0a0b0;margin:4px 0'>Mirror: (" + "${md}" + ", " + "${mk}" + ", " + "${me_ch}" + ", " + "${mb}" + ", " + "${ml}" + ", " + "${mg}" + ", " + "${mesc}" + ")</p>")
)

/* [DEAD] SCAFFOLDING -- interactive widget (dies when .ax computes eigenvalues natively) */
fn spectrum_explore() = (
  let n = parse_int_from("#spec-input") in
  spectrum_display(n, dom_query("#spec-result"))
)

fn spectrum_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Feel Any Number");
  render_p(sec, "Every number has 7 oscillations -- one per prime channel. The eigenvalue is how they agree or fight. Enter any number to decompose its spectrum across all seven channels. Try the elements from the swim above, then try your own.");
  make_interactive_widget(sec, "Enter a number (0 to 214414199):", "spec-input", "e.g. 137", "Explore", "spectrum_explore", "spec-result");
  dom_append(dom_body(), sec)
)

/* Mouse-driven spectrum bar: sweep across Z/214414200.
   dom_on2 passes (clientX, clientY) to callback. */
fn spectrum_mouse_move(mx, my) = (
  let n = mx * 111674 in
  spectrum_display(n, dom_query("#mouse-result"))
)

fn spectrum_mouse_bar() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mouse Explorer: Sweep the Ring");
  render_p(sec, "Move your mouse across the bar below. Your horizontal position maps to a ring element. The full ring (214,414,200 elements) unfolds under your cursor.");
  let bar = dom_create("div") in
  dom_attr(bar, "id", "mouse-bar");
  dom_style(bar, "height", "48px");
  dom_style(bar, "background", "linear-gradient(to right, #1a1a2e, #ffd700, #1a1a2e)");
  dom_style(bar, "borderRadius", "6px");
  dom_style(bar, "cursor", "crosshair");
  dom_style(bar, "marginBottom", "12px");
  dom_style(bar, "position", "relative");
  let hint = dom_create("div") in
  dom_text(hint, "Move mouse here to explore");
  dom_style(hint, "color", "#b8b8c8");
  dom_style(hint, "textAlign", "center");
  dom_style(hint, "lineHeight", "48px");
  dom_style(hint, "pointerEvents", "none");
  dom_append(bar, hint);
  dom_on2(bar, "mousemove", "spectrum_mouse_move");
  dom_append(sec, bar);
  let res = dom_create("div") in
  dom_attr(res, "id", "mouse-result");
  dom_append(sec, res);
  dom_append(dom_body(), sec)
)

/* Keyboard walk: arrow keys navigate the ring. dom_on1 passes keyCode to callback. */
fn spectrum_walk_key(code) = (
  let cur = parse_int_from("#walk-n") in
  /* S1239: real subtraction (raw_mode). Wrap via % N_TRANS for ring walk. */
  let n = (if code == 39 then cur + 1
    else if code == 37 then cur + N_TRANS - 1
    else if code == 38 then cur + 10
    else if code == 40 then cur + N_TRANS - 10
    else cur) % N_TRANS in
  let state_el = dom_query("#walk-n") in
  dom_text(state_el, "${n}");
  spectrum_display(n, dom_query("#walk-display"))
)

fn spectrum_walk() = (
  let sec = make_section("800px") in
  render_h2(sec, "Walk: Navigate the Ring");
  render_p(sec, "Click the box below, then use arrow keys to walk through all 214,414,200 elements. Each step decomposes the spectrum live.");
  let state = dom_create("span") in
  dom_attr(state, "id", "walk-n");
  dom_style(state, "display", "none");
  dom_text(state, "0");
  dom_append(sec, state);
  let box = dom_create("div") in
  dom_attr(box, "tabindex", "0");
  dom_style(box, "border", "1px solid #ffd700");
  dom_style(box, "padding", "12px");
  dom_style(box, "cursor", "pointer");
  dom_style(box, "textAlign", "center");
  dom_style(box, "color", "#ffd700");
  dom_style(box, "outline", "none");
  dom_style(box, "marginBottom", "8px");
  dom_text(box, "Click here, then: \u2190 \u2192 step by 1 \u00A0 \u2191 \u2193 step by 10");
  dom_on1(box, "keydown", "spectrum_walk_key");
  dom_append(sec, box);
  let res = dom_create("div") in
  dom_attr(res, "id", "walk-display");
  dom_append(sec, res);
  dom_append(dom_body(), sec);
  spectrum_display(0, res)
)

fn spectrum_variance() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Variance Theorem");
  render_theorem(sec, "Variance = Maximum Eigenvalue", "At level k (with k primes), variance of all eigenvalues = maximum eigenvalue. Z/2,310 (simple): degree = 2k-1 = 3^2. Z/12,612,600 (multi): degree = 2k = 2^2*3 = 12. Standard deviation at k=6: sqrt(12) = 2*sqrt(3). The spectral SPREAD equals the maximum eigenvalue.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Level");
  render_th(hdr, "Variance = Max");
  render_th(hdr, "Std Dev");
  render_th(hdr, "Identity");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "k=1 (Z/2Z)", "1", "1", "1");
  render_table_row_4(tbl, "k=2 (Z/6Z)", "3", "sqrt(3)", "3");
  render_table_row_4(tbl, "k=3 (Z/30Z)", "5", "sqrt(5)", "5");
  render_table_row_4(tbl, "k=4 (Z/210Z)", "7", "sqrt(7)", "7");
  render_table_row_4(tbl, "k=5 (Z/2,310Z)", "9", "3", "3^2");
  render_table_row_4(tbl, "k=6 (Z/12,612,600)", "12", "2*sqrt(3)", "2^2*3");
  render_table_row_4(tbl, "k=7 (Z/214,414,200)", "14", "sqrt(14)", "2*7");
  render_p(sec, "Z/2,310 (thin): degree = 2k-1 = 9 at k=5. Z/12,612,600 (fat): degree = 2k = 12 at k=6. Z/214,414,200 (TRANS): degree = 14 = 2*7 at k=7. Adding mod-17 completes the staircase. The maximum eigenvalue IS the spectral spread.");
  dom_append(dom_body(), sec)
)

fn spectrum_shells() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Reversed Hierarchy: Shell Averages");
  render_p(sec, "In Z/12,612,600 (six channels): group every element by how many channels are spinning (not frozen by shared factors). Average the eigenvalue within each group. What emerges is a perfectly monotonic staircase:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Shell H");
  render_th(hdr, "Active channels");
  render_th(hdr, "Average lambda");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "H=0", "0 (all frozen)", "+12.00 = 2^2*3", "Zero. Maximum coherence.");
  render_table_row_4(tbl, "H=1", "1 spinning", "+9.89", "One active. Still highly coherent.");
  render_table_row_4(tbl, "H=2", "2 spinning", "+7.75", "Two active. Declining harmony.");
  render_table_row_4(tbl, "H=3", "3 spinning", "+5.58", "Three active. 490 split: 3 inner or 3 outer.");
  render_table_row_4(tbl, "H=4", "4 spinning", "+3.39", "Four active. Still positive.");
  render_table_row_4(tbl, "H=5", "5 spinning", "+1.19", "Five active. Barely positive.");
  render_table_row_4(tbl, "H=6", "6 (all spinning)", "-1.03", "Full activity. Least coherent average.");
  render_p(sec, "More activity means less harmony. Zero (H=0, all frozen) has the highest coherence. The identity (H=6, all spinning) has the lowest. The 490 split cleaves at H=3: inner channels {2,5,7} frozen, outer channels {3,11,13} active.");
  render_p(sec, "In Z/214,414,200 the staircase extends to H=7. The mod-17 channel adds one more step:");
  let tbl_t = make_table(sec) in
  let hdr_t = dom_create("tr") in
  render_th(hdr_t, "Shell H");
  render_th(hdr_t, "Active");
  render_th(hdr_t, "Avg (TRANS)");
  render_th(hdr_t, "Avg (TRUE)");
  dom_append(tbl_t, hdr_t);
  render_table_row_4(tbl_t, "H=0", "0", "+14.00 = 2*7", "+12.00 = 2^2*3");
  render_table_row_4(tbl_t, "H=1", "1", "+11.89", "+9.89");
  render_table_row_4(tbl_t, "H=2", "2", "+9.75", "+7.75");
  render_table_row_4(tbl_t, "H=3", "3", "+7.60", "+5.58");
  render_table_row_4(tbl_t, "H=4", "4", "+5.43", "+3.39");
  render_table_row_4(tbl_t, "H=5", "5", "+3.25", "+1.19");
  render_table_row_4(tbl_t, "H=6", "6", "+1.05", "-1.03");
  render_table_row_4(tbl_t, "H=7", "7", "-1.15", "--");
  render_p(sec, "Each TRUE shell average shifts up by +2 in TRANS (the 17-channel's frozen contribution). The all-active shell (H=7) has average -1.15 -- slightly more negative than TRUE's -1.03 because the mod-17 channel's active average (-0.125) adds to the discord.");
  dom_append(dom_body(), sec)
)

fn spectrum_freezing() = (
  let sec = make_section("800px") in
  render_h2(sec, "Channel Freezing and Spectral Descent");
  render_theorem(sec, "Channel Freezing Theorem", "For multiples of m: avg_eigenvalue(mk) = [2|m]+2*Omega_odd(m). Frozen channel p (p|m) contributes +1 (if p=2) or +2 (odd p). Unfrozen: average 0. Verified machine precision for all 32 divisor classes.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Multiples of");
  render_th(hdr, "Frozen");
  render_th(hdr, "Average lambda");
  render_th(hdr, "Value");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "mod-8 at +1", "1", "1");
  render_table_row_4(tbl, "3", "mod-9 at +2", "2", "2");
  render_table_row_4(tbl, "2*3 = 6", "2+3 at 1+2", "3", "3");
  render_table_row_4(tbl, "2*3*5 = 30", "3 frozen: 1+2+2", "5", "5");
  render_table_row_4(tbl, "3*5*7 = 105", "3 frozen: 2+2+2", "6", "2*3");
  render_table_row_4(tbl, "2*3*5*7 = 210", "4 frozen: 1+2+2+2", "7", "7");
  render_table_row_4(tbl, "2,310", "5 frozen: 1+2+2+2+2", "9", "3^2");
  render_table_row_4(tbl, "12,612,600", "all 6 frozen: 2+2+2+2+2+2", "12", "2^2*3");
  render_table_row_4(tbl, "214,414,200", "all 7 frozen: 1+2+2+2+2+2+2", "14", "2*7");
  render_p(sec, "Each composite projects spectrally to the next chain value. Multiples of 2*3 average to 3. Multiples of 3*5*7 average to 2*3. Z/12,612,600 equalization: in the prime-power ring, ALL channels contribute +2 equally. Raising exponents erases the 2-channel asymmetry. The 17-channel (the 7th prime) adds +2 to reach 14.");
  dom_append(dom_body(), sec)
)

fn spectrum_observer() = (
  let sec = make_section("800px") in
  render_h2(sec, "The 5-Channel Constant");
  render_theorem(sec, "5-Channel Negativity Theorem", "5 is NEGATIVE in ALL 6 shadow worlds (removing each prime in turn). The 2+3 cosine sum of -3.293 exceeds the max positive (5+7 cosines = +2.222). Tightest margin: 1.073 (without 11). This requires 3 as the smallest odd prime in the chain.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sign reversal", "FLIPPED: {2,3,6,7}", "STABLE: {0,1,5,9,11,13}. The {2,3} neighborhood flips sign when removing primes. The invariant set stays.", "");
  render_finding(g, "11 anti-correlates 5", "5 and 11 near anti-podal", "mod-11 channel at n=5: 2cos(2pi*5/11) = -1.919. 5+6=11. The 11-channel maximally opposes 5.", "");
  render_finding(g, "CRT midpoints", "Sum of midpoints", "Prime-power midpoints sum = 7^2 = gap controller. Squarefree midpoints = shadow chain.", "");
  render_finding(g, "Mod-8 boundary", "2^3 gap = 2*3 in non-neg sector", "n=3 barely positive (0.613). The mod-49 channel keeps it positive. Mod-8 channel = 0 at the boundary.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_gap() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gap Theory");
  render_theorem(sec, "Gap Dominance Theorem", "gap = 4*sin^2(pi/p_max) where p_max = largest modulus. Removing any prime EXCEPT p_max: gap UNCHANGED. Removing p_max: gap JUMPS. At k=5: removing 11 -> gap = 0.753 (7 takes over as bottleneck).");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Gap");
  render_th(hdr, "Controller");
  render_th(hdr, "Significance");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/2Z", "4.000", "p = 2", "Binary. Maximum gap.");
  render_table_row_4(tbl, "Z/6Z", "3.000", "p = 3", "The 2nd prime enters.");
  render_table_row_4(tbl, "Z/30Z", "2.382", "p = 5", "The 3rd prime narrows further.");
  render_table_row_4(tbl, "Z/210Z", "0.753", "p = 7", "The 4th prime narrows the gap sharply.");
  render_table_row_4(tbl, "Z/2,310Z", "0.317", "p = 11", "11 controls the squarefree gap.");
  render_table_row_4(tbl, "Z/12,612,600", "0.016", "7^2 = 49", "7^2 rules. 13 does NOT narrow the gap.");
  render_table_row_4(tbl, "Z/214,414,200", "0.016", "7^2 = 49", "17 does NOT narrow it either. 4sin^2(pi/17) = 0.135 >> 0.016.");
  render_p(sec, "Each new prime shrinks the gap but never to zero. LATTICE INVARIANCE: ALL 84 lambda-420 rings share gap = 0.016 (7^2=49 forced in every such ring). 7^2 rules universally. Neither 13 nor 17 narrows the gap -- 4sin^2(pi/13) = 0.229 and 4sin^2(pi/17) = 0.135 are both wider than the 7^2 bottleneck. Only adding 7^3=343 or 13^2=169 would narrow it further.");
  dom_append(dom_body(), sec)
)

fn spectrum_degree() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Degree Ladder");
  render_theorem(sec, "Degree Ladder Theorem", "Squarefree ring: 2 contributes 1 (cos), odd-prime channels contribute 2 (2cos). Full k=5: degree 3^2=9. 2-removed: 2^3=8. Odd-removed: 7. EVERY STEP IS A PRIME PRODUCT. Algebraic proof: 3^2=2k-1 requires 2*(2-2)=0. 2^3=2(k-1) requires (2-2)(2+2)=0. 7=2k-3 requires p=2. All three force p=2.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Exponent equalization", "Prime-power degree = 2k", "Mod-8 channel upgraded to 2cos. At k=6: degree = 2^2*3 = 12. Any channel removed: 2*5 = 10.", "");
  render_finding(g, "Growth progression", "7 -> 9 -> 10 -> 12 -> 14", "Z/210=7, Z/2,310=9, Z/970,200=10, Z/12,612,600=12, Z/214,414,200=14. Each new prime adds 2.", "");
  render_finding(g, "Ratio without 7", "ratio(7=0) = 5/3", "Removing 7 from the degree formula gives 5/3. Requires 3 as the smallest odd prime.", "");
  render_finding(g, "3/4 coincidence", "3/2^2 = 3/4", "At the prime-power level. COINCIDENCE: expression space of prime ratios is dense. Numerical match, not mechanism.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_shadow() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Shadow Polynomial");
  render_p(sec, "P(x) = (x-1)(x-2)(x-3)(x-5) = x^4 - 11*x^3 + 41*x^2 - 61*x + 30. Coefficients: {11, 41, 61, 30}. The spectral architect.");
  let g = make_findings_grid(sec) in
  render_finding(g, "P(11) = 4320", "2^5*3^3*5", "11 feeds back ALL chain primes. P(11)/P(0) = (2^2*3)^2 = eigenvalue(210)^2.", "");
  render_finding(g, "P(13) = 10560", "2^6*3*5*11", "At the 6th prime. All 5 chain primes present in factorization.", "");
  render_finding(g, "P(2^4=16) = 30030", "primorial(13) = 2310*13", "Shadow polynomial at 2^4 extends Z/2,310 by exactly the 13th prime.", "");
  render_finding(g, "C(x) inversion", "C(1)=288, C(2)=2310", "C(x) = 2*x^4*P(-1/x). Classes at x=1, ring size at x=2.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_invariants() = (
  let sec = make_section("800px") in
  render_h2(sec, "Lattice Invariants");
  render_p(sec, "ALL 108 = 2^2*3^3 lambda-420 rings share the same spectral architecture (7^2 forced; 84 = 2^2*3*7 divide Z/12,612,600, 24 = 2^4 extensions reach 2*12,612,600):");
  let g = make_findings_grid(sec) in
