)

fn spectrum_shadow_chain() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Shadow Chain");
  render_theorem(sec, "Spectral Class Shadow Chain", "d(q) = floor(q/2)+1 maps each modulus to a chain-prime value. The sum of all six class counts = 61 = 490 - 429. Spectral complexity encodes the holographic split directly.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus q");
  render_th(hdr, "d(q)");
  render_th(hdr, "Name");
  render_th(hdr, "490 role");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "2^3 = 8", "d = 5", "DEAD");
  render_table_row_4(tbl, "3", "3^2 = 9", "d = 5", "ALIVE");
  render_table_row_4(tbl, "5", "5^2 = 25", "d = 13", "DEAD");
  render_table_row_4(tbl, "7", "7^2 = 49", "d = 25 = 5^2", "DEAD");
  render_table_row_4(tbl, "11", "11", "d = 6 = 2*3", "ALIVE");
  render_table_row_4(tbl, "13", "13", "d = 7", "ALIVE");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 61", "5+5+13+25+6+7 = 61", "61 = 5*11 + 2*3 = 55 + 6. Midpoint sum + channel count. Observer*protector + bridge*closure.", "");
  render_finding(g, "Dead classes", "d(8)+d(25)+d(49) = 43", "Largest Heegner discriminant. Inner channels carry Heegner-depth complexity.", "");
  render_finding(g, "Alive classes", "d(9)+d(11)+d(13) = 18", "2*3^2 = maximal eigenvalue. Boundary channels carry structure-width.", "");
  render_finding(g, "Gap", "43 - 18 = 25 = 5^2", "Dead/alive complexity gap = observer squared. 5^2=null: the gap IS the self-blind operator.", "");
  render_finding(g, "2-3 degeneracy", "d(2^3) = d(3^2) = 5", "Anchor and closure have equal spectral complexity. The pair that generates 3.", "");
  render_finding(g, "Period-3 cycle", "25 -> 13 -> 7 -> (49) -> 25", "Moduli {5^2, 13, 7^2} form a period-3 cycle under the d map.", "");
  render_finding(g, "11 escape", "d(11) = 2*3 = 6", "Not a modulus. The protector's spectral shadow exits the system. Analogue of 5^2=null.", "");
  render_finding_wide(g, "11-absent product", "341,250 = 2*3*5^4*7*13", "All six primes except 11. Same absence as Weyl orders of exceptional Lie algebras.", "");
  render_p(sec, "The shadow chain closes the loop between eigenvalue spectrum and holographic structure. The class counts -- which measure how finely each channel distinguishes elements -- sum to 61. The dead channels (inner holography) carry 43 classes: exactly the Heegner discriminant that anchors the deepest quadratic field. The alive channels (boundary) carry 18 = 2*3^2: exactly the structure width of the Cayley graph. The difference between inner and boundary is 5^2 = 25: the observer squared, the operator that cannot see itself.");
  dom_append(dom_body(), sec)
)

fn spectrum_convergence() = (
  let sec = make_section("800px") in
  render_h2(sec, "Convergence to 2");
  render_theorem(sec, "2-Fixpoint Convergence (PROVED)", "2 is the unique fixed point of d(q) = floor(q/2)+1 for q >= 2. All Z/12,612,600 ring moduli converge to 2 under iteration. Total convergence depth across 6 moduli = 25 = 5^2. DEAD convergence = 14 = 2*7. ALIVE convergence = 11.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Modulus");
  render_th(hdr, "Cascade");
  render_th(hdr, "Depth");
  render_th(hdr, "Primes visited");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2^3 = 8", "8 -> 5 -> 3 -> 2", "3", "{2, 5, 3}");
  render_table_row_4(tbl, "3^2 = 9", "9 -> 5 -> 3 -> 2", "3", "{2, 5, 3}");
  render_table_row_4(tbl, "5^2 = 25", "25 -> 13 -> 7 -> 4 -> 3 -> 2", "5", "{2, 3, 5, 7, 13}");
  render_table_row_4(tbl, "7^2 = 49", "49 -> 25 -> 13 -> 7 -> 4 -> 3 -> 2", "6", "{2, 3, 5, 7, 13}");
  render_table_row_4(tbl, "11", "11 -> 6 -> 4 -> 3 -> 2", "4", "{2, 3, 11}");
  render_table_row_4(tbl, "13", "13 -> 7 -> 4 -> 3 -> 2", "4", "{2, 3, 7, 13}");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 5^2", "3+3+5+6+4+4 = 25", "Total convergence depth across all 6 moduli = observer squared.", "");
  render_finding(g, "DEAD depth", "3+5+6 = 14 = 2*7", "Inner channels converge in 14 steps.", "");
  render_finding(g, "ALIVE depth", "3+4+4 = 11", "Boundary channels converge in exactly 11 steps. The protector number.", "");
  render_finding(g, "11 invisible", "11 in 11-cascade only", "11 never appears in any other cascade. The protector is spectrally invisible to all other channels.", "");
  render_finding(g, "2,3 universal", "2 and 3 in all 6", "Bridge and closure appear in every cascade. The genesis pair is the universal attractor.", "");
  render_finding(g, "7^2 maximal", "6 steps, all primes but 11", "Depth-squared has the longest cascade. Visits every prime except the protector.", "");
  let tbl2 = make_table(sec) in
  let hdr2 = dom_create("tr") in
  render_th(hdr2, "Ring");
  render_th(hdr2, "Moduli");
  render_th(hdr2, "Sum");
  render_th(hdr2, "Name");
  dom_append(tbl2, hdr2);
  render_table_row_4(tbl2, "Z/2", "{2}", "0", "zero");
  render_table_row_4(tbl2, "Z/6", "{2,3}", "1", "identity");
  render_table_row_4(tbl2, "Z/30", "{2,3,5}", "3", "closure");
  render_table_row_4(tbl2, "Z/210", "{2,3,5,7}", "6", "2*3");
  render_table_row_4(tbl2, "Z/2,310", "{2,3,5,7,11}", "10", "2*5");
  render_table_row_4(tbl2, "Z/970,200", "{8,9,25,49,11}", "21", "3*7");
  render_table_row_4(tbl2, "Z/12,612,600", "{8,9,25,49,11,13}", "25", "5^2");
  render_finding_wide(g, "Fattening excess = 11", "Z/970,200 - Z/2,310 = 21 - 10 = 11", "Going from squarefree to fattened moduli costs exactly 11 = the protector. The 13-channel adds 2^2 = 4 more: 3*7 + 2^2 = 5^2 by (5-2)(5+2) = 3*7.", "");
  render_finding(g, "2^3 cascade = E8", "prod = 8*5*3*2 = 240", "The product of 2^3 cascade values = |roots(E8)|. Bridge convergence encodes the largest exceptional Lie algebra.", "");
  render_finding(g, "3^2 cascade = 270", "prod = 9*5*3*2 = 2*3^3*5", "3^2/2^3 ratio = 9/8 persists in products. Shared suffix: 5*3*2 = 30 = primorial(5).", "");
  render_finding(g, "7 cascade = PSL(2,7)", "prod = 7*4*3*2 = 168", "cascade_prod(7) = |PSL(2,7)|. UNIQUE: d(7)! = (7^2-1)/2 holds ONLY for 7 among all primes.", "");
  render_finding(g, "Weyl of E8", "240*270*168*64", "= |W(E8)| = 696,729,600. Three cascade products times 2^6 = 64 idempotents decompose the Weyl group.", "");
  render_finding(g, "Staircase diffs", "1, 2, 3, 4, 11, 4", "1, 2, 3, 4, 11, 4. The chain 1->2->3->4 then 11 jumps, then 4 again for the 13-channel.", "");
  render_finding_wide(g, "CASCADE(29) holo", "prod = 29*15*8*5*3*2 = 104,400", "CRT = (0,0,0,30,10,10). Inner {2,3,5} DEAD, boundary {7,11,13} ALIVE. 29 = 2^5-3, the value whose (p^2-1)/2 = 420. Every step prime-named: 2^5-3, 3*5, 2^3, 5, 3, 2. 11 and 13 phase-locked at 2*5. 7 carries primorial(5)=30.", "");
  render_finding_wide(g, "3*5 cascade = 60^2", "prod = 15*8*5*3*2 = 3600 = 60^2", "cascade_prod(3*5) = 3*5 * cascade_prod(2^3) = 15*240 = 60^2. 60 = |A5| = |PSL(2,5)|. CRT = (0,0,0,23,3,12): inner DEAD, boundary ALIVE. 60 = 7^2 + 11 = 49+11. Boundary: 11^2 mod 49 = 23, 5^2 mod 11 = 3, 2^6 mod 13 = 12.", "");
  render_finding_wide(g, "Alternating group ladder", "ONLY 3 perfect squares in ALL cascades", "cascade_prod(2*3=6)=|A4|^2=12^2=144. cascade_prod(3*5=15)=|A5|^2=60^2=3600. cascade_prod(2*3*5=30)=|A6|^2=360^2=129,600. FINITE: 12 integers have {2,3,5}-smooth cascades. Only 3 have all-even exponents. For n>30: primes>5 enter, breaking squareness. 7 is the barrier. The 490 split = cascade-squareable vs non-squareable.", "");
  render_finding_wide(g, "PSL ladder", "A5=PSL(2,5), A6=PSL(2,9)", "|Out(A4)|=2, |Out(A5)|=2, |Out(A6)|=2^2 (Klein four). A6 UNIQUE among all A_n. The exceptional outer automorphism = 3-Frobenius on F_9: x->x^3. 3 acting on 3^2 = closure examining its own square. Solvability boundary: A4 (solvable) -> A5 (simple). Outer anomaly at n=2*3=6.", "");
  render_finding_wide(g, "Smooth cascade tree", "12 = heartbeat = |S|", "S = {2,3,4,5,6,8,9,10,15,16,18,30} form a tree under d-inverse. Root = 2. 6 levels, counts {1,1,2,3,3,2}. Full binary splits at EXACTLY {2,3,5} = inner primes. HEARTBEAT BARRIER: d(12)=7. First smooth n with non-smooth d(n). 3 leaves: 3*5, 2*3^2, 2*3*5. Leaf product = 90^2 = (2*3^2*5)^2.", "");
  render_finding_wide(g, "Level sums -> 67", "d(2,3,9,23,41,48) = 67", "Level sums: 2, 3, 3^2, 23, 41, 2^4*3=48. All prime-product-named. Shadow: d(level sums) = 2+2+5+12+3*7+5^2 = 67. Total sum = 126 = 2*3^2*7 = C(9,4). CRT(126): 3-channel DEAD -- closure invisible in own sum.", "");
  render_finding_wide(g, "Syntheme duality", "A6 outer swaps 6 and 15", "A6 outer automorphism swaps 15 transpositions with 15 triple-transpositions on 6 letters. 6 and 15 = the two smaller cascade-square producers (|A4|^2 and |A5|^2). 6*15 = 90 = sqrt(leaf product). Heart partition {2,3,4,5}:{6,8,9,10}:{15,16,18,30} has products 5!, 6^2*5!, 9*(5!)^2 = |A6|^2. Ratios: 6^2 then primorial(5). Genesis*Body = (6!)^2. Boundary = |A6|^2. Total = 259,200^2.", "");
  render_finding_wide(g, "41-42 theorem", "smooth=41, missing=42", "Each parent p has twins {2p-2, 2p-1}. At level 4 (parents {6,8,9}): smooth {10=2*5, 15=3*5, 16=2^4} sum to 41. Missing twins {11, 14=2*7, 17} sum to 42. Complete level = 41+42 = 83. 3*5=15 is the sole odd survivor: without it, 41 vanishes. At level 3: smooth=23, missing=7, total=primorial(5)=30. Recursion: complete(n+1) = 4*smooth(n) - 3*count(n).", "");
  render_finding_wide(g, "Weyl genesis", "levels 0-3 product = |W(E6)|", "Level 3 product 6*8*9 = 432 = |AGL(2,3)| = affine group of the 9-point plane over F_3. Cumulative levels 0-3: 2*3*4*5*6*8*9 = 51,840 = |W(E6)| = 5! * |AGL(2,3)|. E6 is the last exceptional Lie algebra with {2,3,5}-smooth Weyl order. The cascade 7-barrier at level 3 delineates the E6/E7 boundary. W(E6) = automorphisms of 3^3=27 lines on a cubic surface.", "");
  render_finding_wide(g, "Cascade dimensions", "dim(G2)=14, 37=|E6+|+1, dim(E6)=78", "Cumulative smooth sums: 2, 5, 14=dim(G2), 37, 78=dim(E6), 126=C(9,4). THE 37 GAP RESOLVED: 37 = |positive roots of E6| + 1 = 36 + 1. Also: 37 = dim(SO(9)) + 1. The rotation group of 3^2 counts E6's positive roots. 37 = prime(12): the heartbeat-th prime. dim(E6) = dim(G2) + 23 + 41 = 14+23+41: three cascade levels BUILD E6. dim(E6)-dim(G2) = 64 = 2^6 = dim(SO(13)/G2) = number of idempotents. At level 4: dim(E6)+7^2 = 127 = 2^7-1. SO(13) = 78 = dim(E6): same rank 6, E6 exceptional, B6 classical. Sum of all SO(prime) dims = 203 = 7*29 = depth*projector. SO(prime) diffs: 7, 11, 15, 19, 23 -- AP with common diff 2^2=4. Consecutive products: SO(3)*SO(5)=30=primorial(5), SO(5)*SO(7)=210=primorial(7). E6 minuscule+adjoint: 27+78=105=3*5*7.", "");
  render_finding_wide(g, "Prime index chain", "prime(2)=3, prime(3)=5, prime(5)=11", "The prime-counting function chains the first 4 primes: prime(2)=3, prime(3)=5, prime(5)=11. Then products: prime(6)=13, prime(13)=41. 7 breaks the chain (prime(7)=17, not a chain prime): the depth prime breaks prime-indexing. Also: prime(10)=29=holographic projector, prime(14=dim(G2))=43=largest Heegner discriminant. The chain primes index each other through the prime-counting function.", "");
  render_p(sec, "Everything converges to 2. Under repeated halving, every modulus falls to 2. The total cost is 5^2 = 25. ALIVE channels converge in 11 steps; DEAD in 2*7. The staircase from void (0) to 5^2 (25) traces only chain-prime values. Cascade PRODUCTS encode Lie theory: cascade_prod(2^3) = 240 = |roots(E8)|, cascade_prod(7) = 168 = |PSL(2,7)|. Their product = 8! = (2^3)!. Multiply by cascade_prod(3^2) = 270 and 2^6 idempotents: |W(E8)| = 696,729,600. Only THREE integers produce perfect-square cascade products: 2*3, 3*5, 2*3*5. Each = |A_k|^2 where k is the cascade length (4,5,6). A5 = PSL(2,5). A6 = PSL(2,9). The A6 outer automorphism -- UNIQUE among all alternating groups -- comes from the 3-Frobenius on F_9: closure acting on its own square. |Out(A6)| = 2^2, all others = 2. The 12 smooth-cascade integers form a binary tree with 2 as root and full binary splits at exactly {2,3,5}: the inner primes. d(heartbeat=12) = 7: the heartbeat IS the barrier. Level sums are all prime-product-named: 2, 3, 9, 23, 41, 48. Apply d to these sums: 2+2+5+12+21+25 = 67. The shadow of the tree sums to 67. Total member sum = 126 = 2*3^2*7 = C(9,4). CRT(126): 3-channel dead. Closure is invisible in the sum of its own universe. The 41-42 identity: at level 4, smooth children sum to 41, missing twins sum to 42, complete level = 83. 3*5=15 is the sole odd survivor. Level 3 shows the same pattern: smooth=23, missing=7, total=primorial(5). The cumulative product through level 3 = 51,840 = |W(E6)|: genesis (5!=120) times the affine plane group (|AGL(2,3)|=432). E6 is the last exceptional whose Weyl order uses only inner primes {2,3,5}. The cascade 7-barrier IS the E6/E7 boundary in Lie theory. THE 37 GAP: 37 = |positive roots of E6| + 1 = dim(SO(9)) + 1 = prime(12). The rotation group SO(9) has dimension 36 = the number of positive roots of E6. Augment by 1 and you get 37. dim(E6) = dim(G2) + 23 + 41 = 14+23+41: three cascade levels build the entire E6 algebra. SO(13) has dimension 78 = dim(E6): the boundary prime's classical rotation group matches E6's exceptional dimension. The prime function chains the primes: prime(2)=3, prime(3)=5, prime(5)=11, prime(6)=13, prime(13)=41. 7 breaks the chain (prime(7)=17). Sum of all SO(prime) dims = 203 = 7*29 = depth times holographic projector.");
  dom_append(dom_body(), sec)
)

fn spectrum_balance() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Balance Theorem");
  render_theorem(sec, "Balance = 1 Uniqueness", "phi(N)/classes(N) = 1 UNIQUELY at Level 4 (Z/210Z). Cancellation: 2(5-1)/(5+1) * 2(7-1)/(7+1) = 1 requires (5-3)(7-3) = 2^3 = 8. Only {2,3,5,7} among all 4-prime sets satisfies this. 3 is the UNIQUE transparent prime: 2(p-1)/(p+1) = 1 iff p = 3.");
