  render_table_row_4(tbl, "3^2 = 9", "9 -> 5 -> 3 -> 2", "3", "{2, 5, 3}");
  render_table_row_4(tbl, "5^2 = 25", "25 -> 13 -> 7 -> 4 -> 3 -> 2", "5", "{2, 3, 5, 7, 13}");
  render_table_row_4(tbl, "7^2 = 49", "49 -> 25 -> 13 -> 7 -> 4 -> 3 -> 2", "6", "{2, 3, 5, 7, 13}");
  render_table_row_4(tbl, "11", "11 -> 6 -> 4 -> 3 -> 2", "4", "{2, 3, 11}");
  render_table_row_4(tbl, "13", "13 -> 7 -> 4 -> 3 -> 2", "4", "{2, 3, 7, 13}");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 5^2", "3+3+5+6+4+4 = 25", "Total convergence depth across all 6 moduli.", "");
  render_finding(g, "Inner depth", "3+5+6 = 14 = 2*7", "Inner channels ({2,5,7}) converge in 14 steps.", "");
  render_finding(g, "Outer depth", "3+4+4 = 11", "Outer channels ({3,11,13}) converge in exactly 11 steps.", "");
  render_finding(g, "11 invisible", "11 in 11-cascade only", "11 never appears in any other cascade. Spectrally invisible to all other channels.", "");
  render_finding(g, "2,3 universal", "2 and 3 in all 6", "2 and 3 appear in every cascade. The first two primes are the universal attractor.", "");
  render_finding(g, "7^2 maximal", "6 steps, all primes but 11", "7^2 has the longest cascade. Visits every prime except 11.", "");
  render_finding(g, "7 cascade = PSL(2,7)", "prod = 7*4*3*2 = 168", "cascade_prod(7) = |PSL(2,7)| = 168. UNIQUE: d(7)! = (7^2-1)/2 holds ONLY for 7 among all primes.", "");
  render_p(sec, "Everything converges to 2. Under repeated halving, every modulus falls to 2. The total cost is 5^2 = 25. Outer channels converge in 11 steps; inner in 2*7 = 14. The cumulative convergence depth at each ring level traces only chain-prime values: 0, 1, 3, 6, 10, 21, 25. Raising exponents from squarefree to prime-power costs 11 additional steps; adding the 13-channel costs 4 more.");
  dom_append(dom_body(), sec)
)

fn spectrum_balance() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Balance Theorem");
  render_theorem(sec, "Balance = 1 Uniqueness", "phi(N)/classes(N) = 1 UNIQUELY at Level 4 (Z/210Z). Cancellation: 2(5-1)/(5+1) * 2(7-1)/(7+1) = 1 requires (5-3)(7-3) = 2^3 = 8. Only {2,3,5,7} among all 4-prime sets satisfies this. 3 is the UNIQUE transparent prime: 2(p-1)/(p+1) = 1 iff p = 3.");
