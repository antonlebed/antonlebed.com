)

fn spectrum_gap() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gap Theory");
  render_theorem(sec, "Gap Dominance Theorem", "gap = 4*sin^2(pi/p_max) where p_max = largest modulus. Removing any prime EXCEPT p_max: gap UNCHANGED. Removing p_max: gap JUMPS. At k=5: removing 11 -> gap = 0.753 = Kleiber's 3/4 (7 takes over). Protection loss = metabolic transition.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Gap");
  render_th(hdr, "Controller");
  render_th(hdr, "Significance");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/2Z", "4.000", "p = 2", "Binary. Maximum gap.");
  render_table_row_4(tbl, "Z/6Z", "3.000", "p = 3", "Closure enters.");
  render_table_row_4(tbl, "Z/30Z", "2.382", "p = 5", "Observer narrows.");
  render_table_row_4(tbl, "Z/210Z", "0.753 = Kleiber's 3/4", "p = 7", "Depth. Metabolic scaling.");
  render_table_row_4(tbl, "Z/2,310Z", "0.317", "p = 11", "Protector controls thin gap.");
  render_table_row_4(tbl, "Z/12,612,600", "0.016", "7^2 = 49", "Depth squared. 7^2 rules. 13 does NOT narrow gap.");
  render_p(sec, "Each new prime slows the carousel. The gap shrinks but never to zero. LATTICE INVARIANCE: ALL 84 lambda-420 rings share gap = 0.016 (7^2=49 forced in every such ring). 7^2 rules universally. 13 adds a channel but 4sin^2(pi/13) = 0.229 >> 0.016 -- the 13-channel is spectrally wider than the bottleneck. Only adding 13^2=169 would narrow it further.");
  dom_append(dom_body(), sec)
)

fn spectrum_degree() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Degree Ladder");
  render_theorem(sec, "Degree Ladder Theorem", "Thin ring: 2 contributes 1 (cos), odd-prime channels contribute 2 (2cos). Full k=5: degree 3^2=9. 2-removed: 2^3=8. Odd-removed: 7. EVERY STEP IS A PRIME PRODUCT. Algebraic proof: 3^2=2k-1 requires 2*(2-2)=0. 2^3=2(k-1) requires (2-2)(2+2)=0. 7=2k-3 requires p=2. All three force p=2.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Fattening equalization", "Fat degree = 2k", "2-channel upgraded to 2cos. At k=6: degree = 2^2*3 = 12 = heartbeat. Any channel removed: 2*5 = 10.", "");
  render_finding(g, "Growth progression", "7 -> 9 -> 10 -> 12", "Z/210=7, Z/2,310=9, Z/970,200=10, Z/12,612,600=12. The 13-channel adds 2. Each new prime adds its weight.", "");
  render_finding(g, "Depthless Kolmogorov", "ratio(7=0) = 5/3", "When depth vanishes, protection echoes turbulence. Both = 2-1/3. Requires 3 as closure prime.", "");
  render_finding(g, "Depthless Kleiber", "3/2^2 = 3/4", "At fattening shadow. COINCIDENCE: expression space of prime ratios is dense. Numerical match, not mechanism.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_shadow() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Shadow Polynomial");
  render_p(sec, "P(x) = (x-1)(x-2)(x-3)(x-5) = x^4 - 11*x^3 + 41*x^2 - 61*x + 30. Coefficients: {11, 41, 61, 30}. The spectral architect.");
  let g = make_findings_grid(sec) in
  render_finding(g, "P(11) = 4320", "2^5*3^3*5", "11 feeds back ALL chain primes. P(11)/P(0) = (2^2*3)^2 = eigenvalue(210)^2.", "");
  render_finding(g, "P(13) = 10560", "2^6*3*5*11", "Boundary evaluation. All 5 primes present in factorization.", "");
  render_finding(g, "P(2^4=16) = 30030", "primorial(13) = 2310*13", "Shadow polynomial at 2^4 extends Z/2,310 by exactly the 13th prime.", "");
  render_finding(g, "C(x) inversion", "C(1)=288, C(2)=2310", "C(x) = 2*x^4*P(-1/x). Classes at x=1, ring size at x=2.", "");
  dom_append(dom_body(), sec)
)

