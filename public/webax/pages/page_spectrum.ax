  let g = make_findings_grid(sec) in
  render_finding(g, "Depth = Protector", "Both rows sum to 3*7 = 21", "7 and 11 share the same totient-GCD profile. The depth prime and its guardian see each other through identical totient lenses.", "");
  render_finding(g, "Guard pair symmetry", "13 = 17 row sum = 31", "The two guard primes (13 and 17) also share identical totient-GCD row sums. The boundary and the 17-channel are totient-twins.", "");
  render_finding(g, "490 ALIVE = 96", "2^5*3 = lambda-1680 count", "The ALIVE half of the 490 split sums to the count of lambda-1680 sub-rings in Z/214,414,200. The totient GCD matrix knows the Z/214,414,200 lattice size.", "");
  dom_append(dom_body(), sec)
)

