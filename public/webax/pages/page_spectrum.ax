/* spectrum helpers */
fn spectrum_hero() = (
  let hero = make_hero("The Spectrum") in
  let eq = dom_create("div") in
  dom_text(eq, "eigenvalue(n) = sum of 6 cosines");
  ct_mono(eq);
  dom_style(eq, "fontSize", "24px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Hold six tuning forks together and strike them. Some combinations make your chest hum -- the vibrations lock in, amplify each other, become one voice. Others grate. Every number in the ring carries six oscillations -- one per prime channel. The eigenvalue asks: do they sing together, or fight each other? eigenvalue(0) = 2^2*3 = 12 (all in phase). eigenvalue_min = -11.720 (max discord). 341,250 distinct classes. Zero collisions. The 7-channel is the primary lens: 7^2=49 forces 4sin^2(pi/49) = 0.016 as the universal spectral gap across the 84 lambda-420 rings. Depth rules the landscape.");
  dom_append(dom_body(), hero)
)

fn spectrum_formula() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Six Voices");
  render_p(sec, "Z/2,310: eigenvalue(n) = cos(pi*n) + 2cos(2pi*n/3) + 2cos(2pi*n/5) + 2cos(2pi*n/7) + 2cos(2pi*n/11). Z/12,612,600: eigenvalue(n) = sum of 2cos(2pi*n_i/m_i) for m_i in {8,9,25,49,11,13}. Six cosines. One per prime. Their sum is what the number sounds like.");
  render_theorem(sec, "Spectral Fingerprint Theorem", "All 341,250 eigenvalues are DISTINCT. Zero collisions. Proof: cyclotomic linear disjointness for coprime moduli. Universal for all CRT rings. Within-class blur = 2^k sign ambiguity (5.17 bits). Eigenvalue = energy, sign = phase.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Max / Classes");
  render_th(hdr, "Gap");
  render_th(hdr, "Kolmogorov");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/2,310", "3^2 = 9 / 288", "0.317 = 4sin^2(pi/11)", "phi/classes = 480/288 = 5/3.");
  render_table_row_4(tbl, "Z/970,200", "2*5 = 10 / 48,750", "0.016 = 4sin^2(pi/7^2)", "phi/classes = 1344/325.");
  render_table_row_4(tbl, "Z/12,612,600", "2^2*3 = 12 / 341,250", "0.016 = 4sin^2(pi/7^2)", "phi/classes = 2304/325 = 2^8*3^2/(5^2*13).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Maximum", "eigenvalue(0) = 12 = 2^2*3", "All 6 channels in phase. The void is most coherent.", "");
  render_finding(g, "Minimum", "eigenvalue_min = -11.720", "All 6 midpoints. Max destructive interference. CRT midpoint sum = 55 = 5*11.", "");
  render_finding(g, "Mirror theorem", "eigenvalue(n) = eigenvalue(N-n)", "cos(2pi(m-r)/m) = cos(2pi*r/m). Every class has even multiplicity.", "");
  render_finding(g, "Zero-crossing", "ONLY 2^3=8 has zeros", "cos = 0 requires 4|m. Only 2^3 qualifies. The 2-channel is the only channel with silence capability.", "");
  render_finding(g, "Meta-ring skeleton", "E[eigenvalue | n mod 7 = r] = 2cos(2pi*r/7)", "Conditional mean of the full eigenvalue given meta-ring residue = one cosine on Z/7. CRT independence zeros other channels. The meta-ring IS the eigenvalue landscape's skeleton. PROVED.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_swim() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Eigenvalue Swim");
  render_p(sec, "Walk the chain barefoot. Start at the void (maximum coherence), step through each prime, and feel the eigenvalue change under you. The landscape has thorns at composites, a false summit where you think you have arrived, and a twist at the end that changes everything.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "n");
  render_th(hdr, "Name");
  render_th(hdr, "lambda");
  render_th(hdr, "Feel");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "0", "void", "+9 (Z/2,310) / +10 (Z/970,200) / +12 (Z/12,612,600)", "Maximum harmony. All channels in phase.");
  render_table_row_4(tbl, "1", "identity", "+1.548", "Ground state. Already a fall from void.");
  render_table_row_4(tbl, "2", "bridge prime", "-1.232", "Negative. Duality creates discord.");
  render_table_row_4(tbl, "3", "closure prime", "-2.705", "Deeper discord. Closure costs coherence.");
  render_table_row_4(tbl, "5", "observer prime", "-2.364", "Observer: slightly less negative than 3.");
  render_table_row_4(tbl, "6", "2*3", "+2.946", "THORN. Composite = warm spot. Surprise positive.");
  render_table_row_4(tbl, "7", "depth prime", "-2.928", "Deepest prime. Near-minimum discord.");
  render_table_row_4(tbl, "9", "3^2", "+2.004", "FALSE SUMMIT. Looks like arrival. It is not.");
  render_table_row_4(tbl, "11", "protector prime", "-1.184", "Light is NEGATIVE. Protection costs coherence.");
  render_p(sec, "Three discoveries: (1) Thorns at composites -- 2*3=6 is warm (+2.95), not cold. (2) False summit at 3^2=9 -- closure-squared looks like a peak but is not the real one. (3) eigenvalue(11) = eigenvalue(4) = -1.184. Light and silence have the same eigenvalue. Exactly the same.");
  dom_append(dom_body(), sec)
)

/* Shared spectral display: renders CRT decomposition into a DOM element */
fn spectrum_display(n, result_el) = (
  let d = n % 8 in
  let k = n % 9 in
  let e = n % 25 in
  let b_ch = n % 49 in
  let l = n % 11 in
  let g = n % 13 in
  let fd = if d > 4 then 8 - d else d in
  let fk = if k > 4 then 9 - k else k in
  let fe = if e > 12 then 25 - e else e in
  let fb = if b_ch > 24 then 49 - b_ch else b_ch in
  let fl = if l > 5 then 11 - l else l in
  let fg = if g > 6 then 13 - g else g in
  let div_d = if d % 2 == 0 then 1 else 0 in
  let div_k = if k % 3 == 0 then 1 else 0 in
  let div_e = if e % 5 == 0 then 1 else 0 in
  let div_b = if b_ch % 7 == 0 then 1 else 0 in
  let div_l = if l == 0 then 1 else 0 in
  let div_g = if g == 0 then 1 else 0 in
  let dead = div_d + div_k + div_e + div_b + div_l + div_g in
  let active = 6 - dead in
  let kingdom = if dead == 6 then "void (all frozen)"
    else if dead == 0 then "identity (all spinning)"
    else if dead == 1 then (
      if div_d == 1 then "mod-8 zero (mod-8 channel frozen)"
      else if div_k == 1 then "mod-9 zero (mod-9 channel frozen)"
      else if div_e == 1 then "mod-25 zero (mod-25 channel frozen)"
      else if div_b == 1 then "mod-49 zero (mod-49 channel frozen)"
      else if div_l == 1 then "mod-11 zero (mod-11 channel frozen)"
      else "mod-13 zero (mod-13 channel frozen)"
    ) else "compound (multiple frozen)" in
  let shell_avg = if active == 0 then "+12.00 (= 2^2*3)"
    else if active == 1 then "+9.89"
    else if active == 2 then "+7.75"
    else if active == 3 then "+5.58"
    else if active == 4 then "+3.39"
    else if active == 5 then "+1.19"
    else "-1.03" in
  let md = if d > 0 then 8 - d else 0 in
  let mk = if k > 0 then 9 - k else 0 in
  let me_ch = if e > 0 then 25 - e else 0 in
  let mb = if b_ch > 0 then 49 - b_ch else 0 in
  let ml = if l > 0 then 11 - l else 0 in
  let mg = if g > 0 then 13 - g else 0 in
  let name = if n == 0 then " = void"
    else if n == 1 then " (identity)"
    else if n == 2 then " (bridge prime)"
    else if n == 3 then " (closure prime)"
    else if n == 5 then " (observer prime)"
    else if n == 6 then " = 2*3 (thorn!)"
    else if n == 7 then " (depth prime)"
    else if n == 9 then " = 3^2 (false summit)"
    else if n == 11 then " (protector prime)"
    else if n == 13 then " (boundary prime)"
    else if n == 30 then " = 2*3*5"
    else if n == 41 then " (self-inverse)"
    else if n == 42 then " = 2*3*7"
    else if n == 61 then ""
    else if n == 67 then ""
    else if n == 105 then " = 3*5*7"
    else if n == 137 then " (spectral minimum!)"
    else if n == 210 then " = 2*3*5*7"
    else if n == 420 then " (heartbeat period)"
    else if n == OMEGA_VAL then " (projector 2^420 mod 12,612,600)"
    else "" in
  dom_inner(result_el, "<p style='color:#ffd700;margin:4px 0'><b>n = " + "${n}" + name + "</b></p>" +
    "<p style='color:#88ddaa;margin:4px 0'>CRT: (" + "${d}" + ", " + "${k}" + ", " + "${e}" + ", " + "${b_ch}" + ", " + "${l}" + ", " + "${g}" + ") mod (8, 9, 25, 49, 11, 13)</p>" +
    "<p style='color:#b0b0c0;margin:4px 0'>Eigenvalue class: [" + "${fd}" + ", " + "${fk}" + ", " + "${fe}" + ", " + "${fb}" + ", " + "${fl}" + ", " + "${fg}" + "] -- cosine-folded</p>" +
    "<p style='color:#ff8844;margin:4px 0'>Shell H=" + "${active}" + " -- avg lambda ~ " + shell_avg + "</p>" +
    "<p style='color:#d8d8e0;margin:4px 0'>" + kingdom + "</p>" +
    "<p style='color:#a0a0b0;margin:4px 0'>Mirror: (" + "${md}" + ", " + "${mk}" + ", " + "${me_ch}" + ", " + "${mb}" + ", " + "${ml}" + ", " + "${mg}" + ")</p>")
)

/* [DEAD] SCAFFOLDING -- interactive widget (dies when .ax handles full eigenvalue computation) */
fn spectrum_explore() = (
  let n = parse_int_from("#spec-input") in
  spectrum_display(n, dom_query("#spec-result"))
)

fn spectrum_interactive() = (
  let sec = make_section("800px") in
  render_h2(sec, "Explore: Feel Any Number");
  render_p(sec, "Every number has 6 oscillations -- one per prime channel. The eigenvalue is how they agree or fight. Enter any number to decompose its spectrum. Try the elements from the swim above, then try your own.");
  make_interactive_widget(sec, "Enter a number (0 to 12612599):", "spec-input", "e.g. 137", "Explore", "spectrum_explore", "spec-result");
  dom_append(dom_body(), sec)
)

/* Mouse-driven spectrum bar: move mouse across bar to sweep 0..970199.
   dom_on2 passes (clientX, clientY) to callback. */
fn spectrum_mouse_move(mx, my) = (
  let n = mx * 15766 in
  spectrum_display(n, dom_query("#mouse-result"))
)

fn spectrum_mouse_bar() = (
  let sec = make_section("800px") in
  render_h2(sec, "Mouse Explorer: Sweep the Ring");
  render_p(sec, "Move your mouse across the bar below. Your horizontal position maps to a ring element. The full ring (12612600 elements) unfolds under your cursor.");
  let bar = dom_create("div") in
  dom_attr(bar, "id", "mouse-bar");
  dom_style(bar, "height", "48px");
  dom_style(bar, "background", "linear-gradient(to right, #1a1a2e, #ffd700, #1a1a2e)");
  dom_style(bar, "borderRadius", "6px");
  dom_style(bar, "cursor", "crosshair");
  dom_style(bar, "marginBottom", "12px");
  dom_style(bar, "position", "relative");
  let hint = dom_create("div") in
  dom_text(hint, "Move mouse here to explore");
  dom_style(hint, "color", "#b8b8c8");
  dom_style(hint, "textAlign", "center");
  dom_style(hint, "lineHeight", "48px");
  dom_style(hint, "pointerEvents", "none");
  dom_append(bar, hint);
  dom_on2(bar, "mousemove", "spectrum_mouse_move");
  dom_append(sec, bar);
  let res = dom_create("div") in
  dom_attr(res, "id", "mouse-result");
  dom_append(sec, res);
  dom_append(dom_body(), sec)
)

/* Keyboard walk: arrow keys navigate the ring. dom_on1 passes keyCode to callback. */
fn spectrum_walk_key(code) = (
  let cur = parse_int_from("#walk-n") in
  /* S1239: real subtraction (raw_mode). Wrap via % N_TRUE for ring walk. */
  let n = (if code == 39 then cur + 1
    else if code == 37 then cur + N_TRUE - 1
    else if code == 38 then cur + 10
    else if code == 40 then cur + N_TRUE - 10
    else cur) % N_TRUE in
  let state_el = dom_query("#walk-n") in
  dom_text(state_el, "${n}");
  spectrum_display(n, dom_query("#walk-display"))
)

fn spectrum_walk() = (
  let sec = make_section("800px") in
  render_h2(sec, "Walk: Navigate the Ring");
  render_p(sec, "Click the box below, then use arrow keys to walk through all 12612600 elements. Each step decomposes the spectrum live.");
  let state = dom_create("span") in
  dom_attr(state, "id", "walk-n");
  dom_style(state, "display", "none");
  dom_text(state, "0");
  dom_append(sec, state);
  let box = dom_create("div") in
  dom_attr(box, "tabindex", "0");
  dom_style(box, "border", "1px solid #ffd700");
  dom_style(box, "padding", "12px");
  dom_style(box, "cursor", "pointer");
  dom_style(box, "textAlign", "center");
  dom_style(box, "color", "#ffd700");
  dom_style(box, "outline", "none");
  dom_style(box, "marginBottom", "8px");
  dom_text(box, "Click here, then: \u2190 \u2192 step by 1 \u00A0 \u2191 \u2193 step by 10");
  dom_on1(box, "keydown", "spectrum_walk_key");
  dom_append(sec, box);
  let res = dom_create("div") in
  dom_attr(res, "id", "walk-display");
  dom_append(sec, res);
  dom_append(dom_body(), sec);
  spectrum_display(0, res)
)

fn spectrum_variance() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Variance Theorem");
  render_theorem(sec, "Variance = Maximum Eigenvalue", "At level k (with k primes), variance of all eigenvalues = maximum eigenvalue. Z/2,310 (simple): degree = 2k-1 = 3^2. Z/12,612,600 (multi): degree = 2k = 2^2*3 = 12. Standard deviation at k=6: sqrt(12) = 2*sqrt(3). The SPREAD of the spectrum IS the heartbeat.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Level");
  render_th(hdr, "Variance = Max");
  render_th(hdr, "Std Dev");
  render_th(hdr, "Identity");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "k=1 (Z/2Z)", "1", "1", "identity");
  render_table_row_4(tbl, "k=2 (Z/6Z)", "3", "sqrt(3)", "closure");
  render_table_row_4(tbl, "k=3 (Z/30Z)", "5", "sqrt(5)", "observer");
  render_table_row_4(tbl, "k=4 (Z/210Z)", "7", "sqrt(7)", "depth");
  render_table_row_4(tbl, "k=5 (Z/2,310Z)", "9", "3", "3^2 (stop)");
  render_table_row_4(tbl, "k=6 (Z/12,612,600)", "12", "2*sqrt(3)", "2^2*3 = heartbeat");
  render_p(sec, "Z/2,310 (simple convention): degree = 2k-1 = 3^2 at k=5. Z/12,612,600 (multi convention): degree = 2k = 2^2*3 = 12 at k=6. The 13-channel adds the 6th voice. The heartbeat IS the spectral spread.");
  dom_append(dom_body(), sec)
)

fn spectrum_shells() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Reversed Hierarchy: Shell Averages");
  render_p(sec, "Group every element by how many of its six channels are spinning (not frozen by shared factors). Average the eigenvalue within each group. What emerges is a perfectly monotonic staircase:");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Shell H");
  render_th(hdr, "Active channels");
  render_th(hdr, "Average lambda");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "H=0", "0 (all frozen)", "+12.00 = 2^2*3", "Void. Maximum coherence.");
  render_table_row_4(tbl, "H=1", "1 spinning", "+9.89", "One active. Still highly coherent.");
  render_table_row_4(tbl, "H=2", "2 spinning", "+7.75", "Two active. Declining harmony.");
  render_table_row_4(tbl, "H=3", "3 spinning", "+5.58", "Three active. 490 split: 3 inner or 3 boundary.");
  render_table_row_4(tbl, "H=4", "4 spinning", "+3.39", "Four active. Still positive.");
  render_table_row_4(tbl, "H=5", "5 spinning", "+1.19", "Five active. Barely positive.");
  render_table_row_4(tbl, "H=6", "6 (all spinning)", "-1.03", "Full activity. Least coherent average.");
  render_p(sec, "More activity means less harmony. The void (H=0, all frozen) has the highest coherence. The identity (H=6, all spinning) has the lowest. The 490 holographic split cleaves at H=3: inner channels {2,5,7} dead, boundary channels {3,11,13} alive. Existence costs coherence -- and the 13-channel adds one more step to the descent.");
  dom_append(dom_body(), sec)
)

