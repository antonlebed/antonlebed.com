  let sec = make_section("800px") in
  render_h2(sec, "Channel Freezing and Spectral Descent");
  render_theorem(sec, "Channel Freezing Theorem", "For multiples of m: avg_eigenvalue(mk) = [2|m]+2*Omega_odd(m). Frozen channel p (p|m) contributes +1 (if p=2) or +2 (odd p). Unfrozen: average 0. Verified machine precision for all 32 divisor classes.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Multiples of");
  render_th(hdr, "Frozen");
  render_th(hdr, "Average lambda");
  render_th(hdr, "Value");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "2-channel at +1", "1", "identity");
  render_table_row_4(tbl, "3", "3-channel at +2", "2", "bridge");
  render_table_row_4(tbl, "2*3 = 6", "2+3 at 1+2", "3", "closure (membrane!)");
  render_table_row_4(tbl, "2*3*5 = 30", "3 frozen: 1+2+2", "5", "observer");
  render_table_row_4(tbl, "3*5*7 = 105", "3 frozen: 2+2+2", "6", "2*3");
  render_table_row_4(tbl, "2*3*5*7 = 210", "4 frozen: 1+2+2+2", "7", "depth");
  render_table_row_4(tbl, "2,310", "5 frozen: 1+2+2+2+2", "9", "3^2");
  render_table_row_4(tbl, "12,612,600", "all 6 frozen: 2+2+2+2+2+2", "12", "2^2*3 = heartbeat");
  render_p(sec, "Each composite PROJECTS spectrally to the next chain value. The membrane 2*3 averages to 3. 3*5*7 averages to 2*3. Z/12,612,600 EQUALIZATION: in the fat ring, ALL channels contribute +2 equally. Fattening erases the 2-channel asymmetry. The 13-channel (the 6th prime) adds +2 to reach 12 = heartbeat.");
