fn spectrum_bessel() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Bessel-Cumulant Theorem");
  render_theorem(sec, "Bessel-Cumulant Theorem", "MGF of channel Z/m = I_0(2t) + 2*sum I_{jm}(2t), where I_n is the modified Bessel function. Proof: Jacobi-Anger expansion averaged over Z/m. Character orthogonality kills all terms except multiples of m. First term = arcsine (continuous limit). Second = departure.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Departure formula", "dep_m = 2 (universal)", "dep_{m+2} = -2*m*(m+2). Sign = (-1)^r from g-coefficient alternation.", "");
  render_finding(g, "g-coefficients", "sign(g_k) = (-1)^k", "J_0 has only real zeros (Watson). Laguerre theorem gives alternation. Governs ALL departure signs.", "");
  render_finding(g, "Arcsine cumulants", "kap_8 = -2310", "8th arcsine cumulant IS the Z/2,310 ring size. kap_4=-2*3. kap_6=2^4*5. All prime products.", "");
  render_finding(g, "3-11 Ratio", "74.2414...", "|Z/9 departure| / |Z/11 departure| converges to J_9(j_{0,1})/J_11(j_{0,1}). Bessel zeros rule.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_resonance() = (
  let sec = make_section("800px") in
  render_h2(sec, "Self-Resonance: The Ring Hears Itself");
  render_theorem(sec, "Self-Resonance Theorem", "Z/mZ eigenvalues match arcsine for ALL moments k < m. At k = m: departure = +2. UNIVERSAL for any m >= 2. Proof: (2cos(theta))^m contains 2cos(m*theta). Averaged over Z/m: 2cos(2*pi*n) = 2 for all n.");
  let g = make_findings_grid(sec) in
