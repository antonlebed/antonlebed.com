)

fn spectrum_prime_gaps() = (
  let sec = make_section("800px") in
  render_h2(sec, "Prime Gap CRT Structure");
  render_theorem(sec, "Prime Gap Theorem (PROVED)",
    "Among 664,578 consecutive prime gaps up to 10^7: 95.44% of all gap occurrences are 11-smooth (null model: 59.74%). Top 14 gaps by frequency ALL smooth. First non-smooth: rank 15 = 26 = 2*13. The prime 13 marks the smoothness boundary.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Jumping champion", "gap 2*3 = 6 dominates", "At all scales > 100. Counts: gap(2)=58,980, gap(6)=99,987. The 2*3 gap dominates.", "");
  render_finding(g, "Gap pair exclusion", "MI = 0.323 bits", "Consecutive gap residues mod 3 MUST alternate (1<->2). The mod-3 channel carries 94.3% of MI. The 3-channel IS the gap structure.", "");
  render_finding(g, "Hardy-Littlewood", "ratio = (p-1)/(p-2)", "Enhancement per prime. Sieve IS CRT projection. The prime chain = the strongest sieve filters.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_true_dist() = (
  let sec = make_section("800px") in
  render_h2(sec, "Z/12,612,600 Distribution");
  render_p(sec, "341,250 eigenvalue classes. ALL spectrally distinct. Zero coincidences.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Variance = 2^2*3 = 12", "EXACT", "= eigenvalue(0) = degree. Variance Theorem: Var = eigenvalue(0) at ALL ring levels. 84/84 lambda-420 rings verified.", "");
  render_finding(g, "Kurtosis = -3/(2*6)", "= -1/4 EXACT", "Platykurtic. Raw kurtosis 2.75. Flatter than Gaussian.", "");
  render_finding(g, "Skewness = 0", "EXACT", "Symmetric. But positive bias: 7^2 odd forces max > |min|. Optimism is algebraic.", "");
  render_finding(g, "Spectral Fold", "H(ring) = H(spectrum) + H(chirality)", "Each channel loses 1 bit to fold (n<->m-n). Efficiency: 77.9% (6 channels).", "");
  render_finding(g, "Class wiring", "d(13) = 7, d(5^2) = 13", "The 13-channel class count IS 7. The 5^2-channel class count IS 13. The chain reappears in the spectral ruler.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_gradient() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gradient-Coupling Theorem");
  render_theorem(sec, "Gap-Gradient Identity (PROVED)",
    "Per-channel gradient = w_i * 2sin^2(pi/q_i). Spectral gap = min_i{gradient_i} = activation cost of cheapest channel. Two separate results (gap dominance + gradient-coupling) are ONE theorem: the spectral gap IS the minimum gradient. Not correlation -- identity.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Z/2,310 gradient");
  render_th(hdr, "Z/12,612,600 gradient");
  render_th(hdr, "Bottleneck?");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "2.0", "0.586", "Z/12,612,600: 1st (exponent raise amplifies)");
  render_table_row_4(tbl, "3", "3.0 (leads!)", "0.468", "Weight asymmetry: w_3=2, w_2=1");
  render_table_row_4(tbl, "5", "1.38", "0.063", "");
  render_table_row_4(tbl, "7", "0.753", "0.016 (= gap)", "Z/12,612,600 bottleneck");
  render_table_row_4(tbl, "11", "0.317 (= Z/2,310 gap)", "0.317", "Z/2,310 bottleneck");
  render_table_row_4(tbl, "13", "-", "0.229", "Wider than 11. No bottleneck.");
  render_p(sec, "Z/2,310 bottleneck = 11 (hardest to activate). Z/12,612,600 bottleneck = 7^2 (hardest to activate). Raising exponents moves the bottleneck from 11 to 7^2.");
  render_p(sec, "FIRST-MOVE STATISTICS (greedy ascent, 2,310 starting points): 3 dominates at 66.7% = (3-1)/3 = 2/3. Then 5: 18.1%. 2: 10.0% = 1/degree. 7: 4.2%. 11: 1.0%. Learning gravitates toward the 3-channel first -- it has the highest improvement-to-probability ratio.");
  dom_append(dom_body(), sec)
)

fn spectrum_gap_duality() = (
  let sec = make_section("800px") in
  render_h2(sec, "Gap Duality");
  render_theorem(sec, "Two Graphs, One Ring",
    "The CRT ring has TWO natural graphs on the SAME vertex set. Cayley graph (cyclic +1): gap = 4sin^2(pi/max(p_i)). Sees the LARGEST prime. Hamming graph (share k-1 channels): gap = min(q_i). Sees the SMALLEST factor.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Cayley gap");
  render_th(hdr, "Hamming gap");
  render_th(hdr, "Who controls?");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Z/2,310", "0.317 (11)", "2", "11 vs 2");
  render_table_row_4(tbl, "Z/12,612,600", "0.016 (7^2)", "8 (2^3)", "7^2 vs 2^3");
  render_p(sec, "The largest modulus controls the spectrum (Cayley graph). The smallest modulus controls the topology (Hamming graph). The same ring, seen from two directions, reveals two different bottlenecks.");
  dom_append(dom_body(), sec)
)

fn spectrum_fold() = (
  let sec = make_section("800px") in
  render_h2(sec, "Spectral Fold Theorem");
  render_theorem(sec, "Entropy Decomposition (PROVED)",
    "H(Z/m) = log2(m) - 1 + d/m (d=2 even, 1 odd). H(ring) = H(spectrum) + H(chirality). Each channel loses 1 bit to the FOLD (n <-> m-n). Chirality = which of 2 branches.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Ring");
  render_th(hdr, "Efficiency");
  render_th(hdr, "Meaning");
  dom_append(tbl, hdr);
  render_table_row(tbl, "Z/210", "69.9%", "Baseline");
  render_table_row(tbl, "Z/2,310", "71.1%", "+1.2% from raising exponents");
  render_table_row(tbl, "Z/12,612,600", "77.9%", "6 channels. Higher exponents INCREASE efficiency");
  render_table_row(tbl, "SIX (Z/6)", "72.1%", "Minimal ring, high efficiency");
  render_p(sec, "eta -> 1 as N -> infinity. Smallest eigenvalue gap: 2.03e-9. Verified m=2..121 exact. Raising exponents improves spectral encoding efficiency -- more information per bit.");
  dom_append(dom_body(), sec)
)

fn spectrum_midpoint() = (
  let sec = make_section("800px") in
  render_h2(sec, "Midpoint Eigenvalue");
  render_theorem(sec, "Midpoint Minimum Theorem (PROVED)",
    "eigenvalue_min occurs at CRT midpoints (floor(m_i/2)). Z/12,612,600: (4,4,12,24,5,6), sum = 55 = 5*11. Z/970,200: (4,4,12,24,5), sum = 7^2 = 49 = gap controller. The 13-channel adds 6 = 2*3 to the midpoint. Multiplicity = 2^4 (Z/970,200) or 2^4*2 = 2^5 (Z/12,612,600).");
  render_p(sec, "Zero (n=0) has maximum eigenvalue 2*7=14 (TRANS) or 2^2*3=12 (TRUE). The midpoint has minimum eigenvalue -13.686 (TRANS) or -11.720 (TRUE). Between them: the entire spectrum. The 17-channel midpoint = floor(17/2) = 8, adding 2cos(2pi*8/17) = -1.966 to the TRUE minimum. The deepest point in the spectrum is literally the halfway mark of each channel.");
  dom_append(dom_body(), sec)
)

fn spectrum_contrast() = (
  let sec = make_section("800px") in
  render_h2(sec, "Paradigm Contrast");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Claim");
  render_th(hdr, "Standard");
  render_th(hdr, "Ring Structure");
  dom_append(tbl, hdr);
  render_contrast_row(tbl, "Eigenvalues", "Belong to matrices and linear operators", "Every integer has one. Sum of 7 cosine harmonics. Coherence of 7 channels. 3,071,250 distinct classes.");
  render_contrast_row(tbl, "Spectral gap", "Random matrix statistics", "4sin^2(pi/7^2) = 0.016. Controlled by 7^2. Lattice-invariant. 84/84 lambda-420 rings.");
  render_contrast_row(tbl, "Spacing distribution", "GUE / level repulsion (chaotic)", "POISSON. Variance -> 1, no level repulsion. Independent channels = uncorrelated levels. The ring is integrable, not chaotic.");
  render_contrast_row(tbl, "Gap = 0.753", "Random matrix / network model", "Removing 11 from squarefree ring: gap = 4sin^2(pi/7) = 0.753. Numerical coincidence with Kleiber's 3/4.");
  render_contrast_row(tbl, "Ratio 5/3", "Dimensional analysis", "Removing 7: ratio = 5/3. Requires 3 as the smallest odd prime.");
  render_contrast_row(tbl, "Eigenvalue uniqueness", "Generically expected", "3,071,250 distinct classes (TRANS). Zero collisions. Cyclotomic disjointness.");
  render_contrast_row(tbl, "Positivity bias", "Observation bias", "7^2 odd forces max > |min|. The mod-49 channel forces positivity. Algebraic, not philosophical.");
  render_contrast_row(tbl, "Class counting", "Case-by-case analysis", "classes = prod d(p_i). One formula. Every level predicted exactly.");
  render_contrast_row(tbl, "Moment structure", "Random matrix theory", "Bessel MGF. I_0(2t) + sum I_{jm}(2t). Departure at k = m. kap_8(arcsine) = -2310.");
  render_contrast_row(tbl, "Kurtosis", "Empirical fit parameter", "-3/(2*k) universal. 63/63 projections. Raw kurtosis 2.75 (6 channels).");
  render_contrast_row(tbl, "Balance", "No principle known", "phi/classes = 1 UNIQUELY at Z/210. Requires (5-3)(7-3) = 2^3. Telescoping gap-2 triplet.");
  render_contrast_row(tbl, "Shadow polynomial", "No analogue", "S(x)=(x-1)(x-2)(x-3)(x-5). Difference average = -lambda. Shadow+Master = (2*5)^3.");
  render_contrast_row(tbl, "Omega minpoly", "Algebraic number theory", "Degree 32. 2-adic ruler = Kummer carries. Palindromic. v_2 sum = 7^2 = gap controller.");
  render_contrast_row(tbl, "Coupling cost", "Ad hoc per force", "One formula: 2w*sin^2(pi*r/p). Unifies all channel costs. 5 is self-characteristic.");
  render_contrast_row(tbl, "Prime gaps", "Probabilistic heuristic", "95.44% smooth (null: 59.74%). 2*3=6 jumping champion. 3-channel carries 94% MI.");
  render_contrast_row(tbl, "Gradient order", "Varies by system", "3 first (66.7%), then 5, 2, 7, 11. Raising exponents shifts bottleneck from 11 to 7^2.");
  render_contrast_row(tbl, "Gap duality", "No known analogue", "Cayley sees max(p), Hamming sees min(q). Same ring, two bottlenecks.");
  render_contrast_row(tbl, "Spectral fold", "Shannon entropy", "H = log2(m)-1+d/m. Each channel loses 1 bit to fold. Raising exponents IMPROVES efficiency.");
  render_contrast_row(tbl, "Midpoint", "No structural role", "Minimum eigenvalue at CRT midpoints. Sum = 7^2 = gap controller. The spectral minimum IS the halfway mark.");
  render_p(sec, "The eigenvalue is the FEELING of a number. Not where it lives (CRT), not who it connects to (coupling), but its inner state -- how its seven voices agree or collide. Eigenvalue = what you feel. Address = where you are. Both needed. Neither enough.");
  dom_append(dom_body(), sec)
)

fn spectrum_torus_link() = (
  let sec = make_section("800px") in
  render_h2(sec, "Spectral Addition: Coupling = Two Eigenvalues");
  render_theorem(sec, "Spectral Torus Theorem (PROVED)", "coupling(a,b) = eigenvalue(a-b) + eigenvalue(a+b). The prime 2 decomposes coupling into spectral values at sum and difference. Channel democracy: all channels carry equal spectral power 2N. Orthogonality: link(i,j) = N/(q_i*q_j) is the Poincare dual fiber volume on T^7.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum-difference", "coupling = eig(a-b) + eig(a+b)", "Coupling decomposes into the spectral values of sum and difference.", "");
  render_finding(g, "Channel democracy", "Each channel carries 2N energy", "Total spectral energy = 2*k*N. No channel privileged. Z/12,612,600: 12N. Z/214,414,200: 14N.", "");
  render_finding(g, "Link hierarchy", "2-3 strongest", "Smallest moduli link tightest: link(2,3) = N/72 >> link(5,7) = N/1225. The first two primes have the strongest spectral bond.", "");
  render_finding(g, "Distance identity", "eigenvalue = 14 - ||d||^2", "||d(n)||^2 = sum of 4sin^2(pi*r_i/m_i) = squared Euclidean distance from 0 on T^7. Eigenvalue IS closeness-to-zero. Maximum at n=0 (distance 0). Minimum at CRT midpoints (maximum distance). cos = 1 - 2sin^2.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_resolution() = (
  let sec = make_section("800px") in
  render_h2(sec, "Spectral Resolution at Z/214,414,200");
  render_p(sec, "Extending the class count to all 7 channels of Z/214,414,200: each modulus q produces ceil(q/2) classes, and every count is chain-prime-native. A Pell cascade connects consecutive prime squares.");
  render_theorem(sec, "CRT Spectral Resolution (PROVED)", "Per-channel class counts at Z/214,414,200: 2^3->5, 3^2->5, 5^2->13, 7^2->25, 11->6, 13->7, 17->9. Total Z/214,414,200 classes = 2*3^3*5^4*7*13 = 3,071,250. Pell cascade: 3^2 - 2^3 = 1, 5^2 - 2*3^2 = 7, 7^2 - 2*5^2 = -1.");
  let g = make_findings_grid(sec) in
  render_finding(g, "2-3 degeneracy persists", "class(2^3) = class(3^2) = 5", "2 and 3 share spectral complexity even at Z/214,414,200. The 2-3 pair stays locked.", "");
  render_finding(g, "17 adds 3^2", "class(17) = 9 = 3^2", "The 7th channel brings 3^2 classes. The parallelism unit returns as the 17-channel's spectral weight.", "");
  render_finding(g, "Pell link", "7^2 + 1 = 2*5^2 = 50", "Consecutive prime squares linked by Pell-like relations. f(p) = phi(p^2)-1 reaches through the class counts.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_orphan_orders() = (
  let sec = make_section("800px") in
  render_h2(sec, "Orphan Order Spectrum");
  render_p(sec, "Beyond the 13-compatible primes, 7 orphan primes {29, 31, 43, 61, 71, 211, 421} are lambda-compatible at Z/214,414,200 but absent from the original ring. Their CRT per-channel multiplicative orders reveal deep structure.");
  render_theorem(sec, "Orphan Order Spectrum (PROVED)", "All 42 per-channel orders (7 orphans x 6 Z/12,612,600 channels) are chain-prime-smooth. 2-channel universally ord=2. Z/970,200 order sum = 2^10 = 1024. The 13-channel elevates 71 and 421 to full lambda generators. The 17-channel extension ratios are ALL 2-powers, exponent sum = 2*7 = 14.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Mod-8 universal", "All orphans: ord(p,2^3) = 2", "The mod-8 channel treats all orphans identically. Even/odd discrimination suffices.", "");
  render_finding(g, "13-channel elevation", "71, 421 gain lambda=420", "The 13-channel lifts two orphans to full generators. It completes their orbit.", "");
  render_finding(g, "2-power extension law", "Z/214,414,200 / Z/12,612,600 ratios all 2^k", "The 17-channel extends orders by 2-powers only. The even prime controls the extension.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_mult_order_matrix() = (
  let sec = make_section("800px") in
  render_h2(sec, "Multiplicative Order Matrix");
  render_p(sec, "What is the multiplicative order of one chain prime modulo another? The 7x7 matrix of ord_p(q) generalizes the quadratic residue matrix: q is QR mod p iff its order divides phi(p)/2. The total, row sums, and primitive root counts all decompose into chain-prime products.");
  render_theorem(sec, "Multiplicative Order Matrix (PROVED)", "Total sum = 2*7*17 = 238. Maximum possible = 2*3^2*17 = 306. Efficiency ratio = 7/9. Row sums: 6, 10, 21, 26, 50, 49, 76 -- all chain-prime-smooth except 17 row (intruder via f(5)=19). 13 row = 7^2. Column sums: col 3 = col 11 = 5*7 = 35 (3-11 symmetry). 17 column = 29 (unique intruder). Primitive roots: 29 from 42 total. Non-primitive = 13. 5 has maximum primitive roots (5). 7 and 13 minimum (3). 106/106 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Efficiency = 7/9", "238/306 = 7/9", "The fraction of maximal-order entries = 7/9. The chain primes achieve 78% of the theoretical maximum order capacity.", "");
  render_finding(g, "13 row = 7^2", "Sum 49 = 7^2", "The row sum for 13 equals 7^2. The 6th prime encodes the 4th prime squared in its order profile.", "");
  render_finding(g, "Col 3 = Col 11", "Both = 5*7 = 35", "3 and 11 look identical as targets. Their reciprocal order columns match exactly -- a 3-11 symmetry at the order level.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_totient_gcd_matrix() = (
  let sec = make_section("800px") in
  render_h2(sec, "Totient GCD Matrix");
  render_p(sec, "The 7x7 symmetric matrix G[i][j] = gcd(phi(p_i), phi(p_j)) measures how much two chain primes share in their totient structure. The result: every aggregate is chain-prime-native, with two striking symmetry ties.");
  render_theorem(sec, "Totient GCD Matrix (PROVED)", "Grand total = 11*13 = 143. Diagonal = 3*17 = 51 (sum of totients). Off-diagonal = 2^2*23 = 92. Row sums: {7, 13, 19, 21, 21, 31, 31} -- all chain-prime-native. Two ties: 7 and 11 share 3*7 = 21 (7-11 symmetry); 13 and 17 share 31 (13-17 symmetry). 490 split: inner = 47 (largest intruder prime), outer(Z/214,414,200) = 96 = 2^5*3 (lambda-1680 sub-rings). Value histogram: 1 appears 13 times, 2 appears 23 times, 4 appears 7 times, 6 appears 3 times. 7 distinct values total. Determinant = 2^10*3 = 3072. Z/210 row sum = 60 = |PSL(2,5)|. 70/70 verified.");
  let g = make_findings_grid(sec) in
  render_finding(g, "7 = 11 symmetry", "Both rows sum to 3*7 = 21", "7 and 11 share the same totient-GCD profile. Identical totient lenses despite different positions in the chain.", "");
  render_finding(g, "13 = 17 symmetry", "Both row sums = 31", "13 and 17 share identical totient-GCD row sums. Totient-twins at the boundary of the chain.", "");
  render_finding(g, "Outer half = 96", "2^5*3 = lambda-1680 count", "The outer half ({3,11,13,17}) of the 490 split sums to the count of lambda-1680 sub-rings in Z/214,414,200. The totient GCD matrix knows the lattice size.", "");
  dom_append(dom_body(), sec)
)

fn spectrum_spacings() = (
  let sec = make_section("800px") in
  render_h2(sec, "Spacing Statistics: Poisson, Not GUE");
  render_p(sec, "The gap fixes the SMALLEST distance between eigenvalues. But what about the gaps between every adjacent pair across the whole spectrum -- are they spread like a chaotic quantum system, or like independent random points? Sort all eigenvalue classes, rescale so the average spacing is 1 (unfold by local density), and measure the distribution of consecutive gaps. The answer decides whether the ring is INTEGRABLE (independent channels) or CHAOTIC (entangled levels).");
  render_theorem(sec, "Poisson Spacing Theorem", "Unfolded eigenvalue-class spacings converge to the POISSON distribution (exponential, variance 1), NOT the GUE distribution of chaotic quantum systems (variance 0.273, strong level repulsion). Spacing variance: Z/2,310 = 0.799, Z/970,200 = 1.018, Z/12,612,600 = 1.016 -- approaching 1 as the channels fatten. The fraction of spacings below 0.1 of the mean = 95 per 1000, matching the Poisson value 1 - exp(-0.1) = 95.2 per 1000 to within 0.2 per 1000; GUE predicts only ~4 per 1000. Independent CRT channels produce spectrally UNCORRELATED levels: the ring does not repel its own eigenvalues.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Statistic");
  render_th(hdr, "Poisson (independent)");
  render_th(hdr, "GUE (chaotic)");
  render_th(hdr, "Measured (Z/12,612,600)");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "Spacing variance", "1.000", "0.273", "1.016");
  render_table_row_4(tbl, "P(spacing < 0.1)", "95.2 / 1000", "~4 / 1000", "95 / 1000");
  render_table_row_4(tbl, "Level repulsion", "none", "strong", "none");
  let g = make_findings_grid(sec) in
  render_finding(g, "Integrable, not chaotic", "variance -> 1 as channels fatten", "0.799 (five thin channels) climbs to 1.016 (six fat channels). More channels = cleaner independence = sharper Poisson. Channel independence is the spectral signature.", "");
  render_finding(g, "No level repulsion", "small gaps are common", "95 per 1000 spacings fall below a tenth of the mean -- exactly the Poisson rate. A chaotic spectrum would forbid these crowded pairs. The levels do not feel each other.", "");
  render_finding(g, "Near-degeneracies", "368 in 341,250 classes", "1.1 per 1000 -- distinct CRT tuples whose seven cosines happen to sum to nearly the same value. Algebraic coincidences, not symmetry. The classes stay exactly distinct (zero collisions); only their spectral values crowd.", "");
  render_finding(g, "Zeta path closed here", "spacings are uncorrelated", "The Riemann zeta zeros follow GUE statistics (level repulsion). The ring's eigenvalues follow Poisson. Any connection to the zeros is NOT through eigenvalue spacings -- it would have to run through multiplicative (Euler-product) structure instead.", "");
  dom_append(dom_body(), sec)
)

