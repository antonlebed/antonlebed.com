  let sec = make_section("800px") in
  render_h2(sec, "Observer Constancy and Shadow Worlds");
  render_theorem(sec, "Observer Constancy Theorem", "5 is NEGATIVE in ALL 6 shadow worlds (removing each prime in turn). 2+3 sum -3.293 exceeds max positive (5+7=+2.222). Tightest margin: 1.073 (no 11). Observer constancy requires 3 as closure prime.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Thorn reversal", "FLIPPED: {2,3,6,7}", "STABLE: {void,1,5,9,11,13}. Closure neighborhood flips sign. Invariant set stays.", "");
  render_finding(g, "11 imprisons 5", "5 and 11 near anti-podal", "11-channel at n=5: 2cos(2pi*5/11) = -1.919. 5+6=11. 11 IS 5's prison guard.", "");
  render_finding(g, "Anti-void", "CRT midpoints", "Fat midpoints sum = 7^2 = GAP CONTROLLER. Thin midpoints = shadow chain.", "");
  render_finding(g, "Dissolved membrane", "2^3 gap = 2*3 in non-neg sector", "n=3 barely positive (0.613). 7^2 is life support. 2^3-channel = 0 (boundary).", "");
