  render_table_row_4(tbl, "Z/6Z (k=2)", "4", "2", "2^2");
  render_table_row_4(tbl, "Z/30Z (k=3)", "12", "3", "2^2*3");
  render_table_row_4(tbl, "Z/210Z (k=4)", "48 = phi(210)", "4", "phi = classes (coincidence)");
  render_table_row_4(tbl, "Z/2,310Z (k=5)", "288", "6", "e_2(primes)");
  render_table_row_4(tbl, "Z/30,030Z (k=6)", "2016 = 7*288", "7", "d(13) = 7. Chain reappears.");
  render_table_row_4(tbl, "Z/12,612,600", "341,250 = 7*48,750", "7", "13-channel class count = (13+1)/2 = 7.");
  render_p(sec, "Level 4 is special: classes = phi = 48. The class count equals the totient. The 13-channel class contribution: (13+1)/2 = 7. The number 7 IS the mod-13 spectral weight. Per-channel: d(2^3)=5, d(3^2)=5, d(5^2)=13, d(7^2)=25, d(11)=6, d(13)=7. Product for Z/12,612,600: 5*5*13*25*6*7 = 341,250.");
  dom_append(dom_body(), sec)
)

fn spectrum_shadow_chain() = (
  let sec = make_section("800px") in
  render_h2(sec, "The Shadow Chain");
  render_theorem(sec, "Spectral Class Shadow Chain", "d(q) = floor(q/2)+1 maps each modulus to a chain-prime value. The sum of all six class counts = 61. Spectral complexity encodes the 490 split directly.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Modulus q");
  render_th(hdr, "d(q)");
  render_th(hdr, "Name");
  render_th(hdr, "490 half");
  dom_append(tbl, hdr);
  render_table_row_4(tbl, "2", "2^3 = 8", "d = 5", "Inner");
  render_table_row_4(tbl, "3", "3^2 = 9", "d = 5", "Outer");
  render_table_row_4(tbl, "5", "5^2 = 25", "d = 13", "Inner");
  render_table_row_4(tbl, "7", "7^2 = 49", "d = 25 = 5^2", "Inner");
  render_table_row_4(tbl, "11", "11", "d = 6 = 2*3", "Outer");
  render_table_row_4(tbl, "13", "13", "d = 7", "Outer");
  let g = make_findings_grid(sec) in
  render_finding(g, "Sum = 61", "5+5+13+25+6+7 = 61", "61 = 5*11 + 2*3 = 55 + 6. Midpoint sum + channel count.", "");
  render_finding(g, "Inner classes", "d(8)+d(25)+d(49) = 43", "Largest Heegner discriminant. Inner channels ({2,5,7}) carry 43 spectral classes.", "");
  render_finding(g, "Outer classes", "d(9)+d(11)+d(13) = 18", "2*3^2. Outer channels ({3,11,13}) carry 18 spectral classes.", "");
  render_finding(g, "Gap = 5^2", "43 - 18 = 25 = 5^2", "Inner/outer class gap = 5^2. The channel whose square divides the ring but which does not divide phi(ring).", "");
  render_finding(g, "2-3 degeneracy", "d(2^3) = d(3^2) = 5", "The first two channels have equal spectral complexity.", "");
  render_finding(g, "Period-3 cycle", "25 -> 13 -> 7 -> (49) -> 25", "Moduli {5^2, 13, 7^2} form a period-3 cycle under the d map.", "");
  render_finding(g, "11 exit", "d(11) = 2*3 = 6", "Not a modulus. The 11-channel's class count exits the ring. Analogue of 5^2 = 25 dividing the ring.", "");
  render_finding_wide(g, "11-absent product", "341,250 = 2*3*5^4*7*13", "All six primes except 11. Same absence pattern as Weyl orders of exceptional Lie algebras.", "");
  render_p(sec, "The shadow chain connects the eigenvalue spectrum to the 490 split. The class counts -- which measure how finely each channel distinguishes elements -- sum to 61. The inner channels ({2,5,7}) carry 43 classes: the largest Heegner discriminant. The outer channels ({3,11,13}) carry 18 = 2*3^2. The gap between inner and outer is 5^2 = 25: the prime whose square divides the ring but which does not divide 24 = phi(Z/2,310)/phi(Z/210).");
  dom_append(dom_body(), sec)
)

fn spectrum_convergence() = (
  let sec = make_section("800px") in
  render_h2(sec, "Convergence to 2");
  render_theorem(sec, "2-Fixpoint Convergence (PROVED)", "2 is the unique fixed point of d(q) = floor(q/2)+1 for q >= 2. All Z/12,612,600 ring moduli converge to 2 under iteration. Total convergence depth across 6 moduli = 25 = 5^2. Inner {2,5,7} convergence = 14 = 2*7. Outer {3,11,13} convergence = 11.");
  let tbl = make_table(sec) in
