/* router_lab.ax -- Module router for LAB (compiler, REPL, games, experiments). S2068 split. */

fn page_404(hash) = (
  let sec = make_section("600px") in
  render_h2(sec, "Page Not Found");
  render_p(sec, "No page matches this route.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Home", "/", "Start here.", "");
  dom_append(dom_body(), sec)
)

fn route_page(hash) = page_404(hash)

fn route() = (
  let hash = get_hash() in
  if streq(hash, "lab") == 1 then page_lab_index()
  else if streq(hash, "chain") == 1 then page_chain()
  else if streq(hash, "ai") == 1 then page_ai()
  else if streq(hash, "curriculum") == 1 then page_curriculum()
  else if streq(hash, "scaling") == 1 then page_scaling()
  else if streq(hash, "repl") == 1 then page_repl()
  else if streq(hash, "tutorial") == 1 then page_tutorial()
  else if streq(hash, "ouroboros_compiler") == 1 then page_ouroboros_compiler()
  else if streq(hash, "compiler") == 1 then page_compiler()
  else if streq(hash, "ax_games") == 1 then page_ax_games()
  else if streq(hash, "sensor") == 1 then page_sensor()
  else if streq(hash, "hdc") == 1 then page_hdc()
  else if streq(hash, "evolve") == 1 then page_evolve()
  else if streq(hash, "nca") == 1 then page_nca()
  else if streq(hash, "chain_ai") == 1 then page_chain_ai()
  else if streq(hash, "bridge_het") == 1 then page_bridge_het()
  else if streq(hash, "ring_substrate") == 1 then page_ring_substrate()
  else if streq(hash, "ring_sweep") == 1 then page_ring_sweep()
  else if streq(hash, "anti_ring") == 1 then page_anti_ring()
  else page_404(hash)
)

let arena_mark = [0]
fn get_hp() = hp()
fn reset_hp(v) = set_hp(v)
fn route_only() = (
  dom_inner(dom_body(), "");
  route();
  highlight_nav();
  render_vow(dom_body());
  render_footer()
)

fn on_navigate() = (
  set_hp(arena_mark[0]);
  close_nav_dd();
  route_only()
)
ct_body(dom_body());
ct_starfield(dom_body());
ct_wave(dom_body());
ct_moon(dom_body());
render_nav();
let spa_root = dom_create("div") in
dom_style(spa_root, "position", "relative");
dom_style(spa_root, "zIndex", "1");
dom_style(spa_root, "paddingTop", "52px");
dom_append(dom_body(), spa_root);
dom_set_root(spa_root);
set(arena_mark, 0, hp());
route();
highlight_nav();
render_vow(dom_body());
render_footer();
dom_spa_init("on_navigate")
