  dom_style(btn, "background", "#1a1a2e");
  dom_style(btn, "color", "#88ddaa");
  dom_style(btn, "border", "1px solid #555");
  dom_style(btn, "padding", "8px 14px");
  dom_style(btn, "cursor", "pointer");
  dom_style(btn, "fontFamily", "'Courier New', monospace");
  dom_style(btn, "borderRadius", "4px")
)

fn ct_ch_color(c) = if c == 0 then "#4488ff" else if c == 1 then "#33dd55" else if c == 2 then "#ff9900" else if c == 3 then "#cc44ff" else if c == 4 then "#44dddd" else "#ff4466"

/* GPU benchmark handlers for CRT training operations */
fn ct_gpu_add() = gpu_bench(0, 100000, dom_query("#ct-gpu-add"))
fn ct_gpu_mul() = gpu_bench(1, 100000, dom_query("#ct-gpu-mul"))
fn ct_gpu_eig() = gpu_bench(2, 100000, dom_query("#ct-gpu-eig"))

/* D-Ratio Bridge: per-channel nil/sq0/idem/invol exhaustive count.
   Arena reset between compute and display to bound memory. */
fn ct_ch_sq0(q) = (mut c = 0; mut x = 0; while x < q do (if x*x%q == 0 then mut c = c+1 else 0; mut x = x+1); c)
fn ct_ch_idem(q) = (mut c = 0; mut x = 0; while x < q do (if x*x%q == x then mut c = c+1 else 0; mut x = x+1); c)
fn ct_ch_invol(q) = (mut c = 0; mut x = 0; while x < q do (if x*x%q == 1 then mut c = c+1 else 0; mut x = x+1); c)
fn ct_ch_nil(q) = (
  /* nilpotent in Z/p^a: p | x. Count = q/p. For prime powers: just count x where x^q=0. */
  mut c = 0; mut x = 0;
  while x < q do (
    mut v = 1; mut e = 0;
    while e < q do (mut v = v * x % q; mut e = e + 1);
    if v == 0 then mut c = c + 1 else 0;
    mut x = x + 1
  );
  c
)

fn ct_d_ratio() = (
  let result_el = dom_query("#ct-dratio-result") in
  /* Phase 1: compute all counts into a flat array, then arena-reset */
  let mark = hp() in
  let dat = alloc(28) in
  let mods = CRT_MODS_TRANS in
  mut i = 0;
  while i < 7 do (
    let m = mods[i] in
    dat[i*4] = ct_ch_nil(m);
    dat[i*4+1] = ct_ch_sq0(m);
    dat[i*4+2] = ct_ch_idem(m);
    dat[i*4+3] = ct_ch_invol(m);
    mut i = i + 1
  );
  /* CRT products */
  mut np = 1; mut sp = 1; mut dp = 1; mut vp = 1;
  mut i = 0;
  while i < 7 do (
    mut np = np * dat[i*4]; mut sp = sp * dat[i*4+1];
    mut dp = dp * dat[i*4+2]; mut vp = vp * dat[i*4+3];
    mut i = i + 1
  );
  /* Save products before reset (dat survives since allocated before mark... wait,
     dat is allocated AFTER mark. Need to save to globals or pre-mark array.) */
  /* Actually: just save the 4 products + 28 channel values as locals (scalars survive reset). */
  let n0=dat[0] in let s0=dat[1] in let d0=dat[2] in let v0=dat[3] in
  let n1=dat[4] in let s1=dat[5] in let d1=dat[6] in let v1=dat[7] in
  let n2=dat[8] in let s2=dat[9] in let d2=dat[10] in let v2=dat[11] in
  let n3=dat[12] in let s3=dat[13] in let d3=dat[14] in let v3=dat[15] in
  let n4=dat[16] in let s4=dat[17] in let d4=dat[18] in let v4=dat[19] in
  let n5=dat[20] in let s5=dat[21] in let d5=dat[22] in let v5=dat[23] in
  let n6=dat[24] in let s6=dat[25] in let d6=dat[26] in let v6=dat[27] in
  let r1 = np / sp in let r2 = vp / dp in
  set_hp(mark);
  /* Phase 2: build HTML from saved scalars */
  let h = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>2-RATIO BRIDGE: per-channel exhaustive counts (Z/214,414,200)</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Ch</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Nil</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Sq0</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Idem</th><th style='text-align:left;padding:3px;color:#ffd700;font-size:11px'>Invol</th></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>Z/8</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n0}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s0}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d0}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v0}</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>Z/9</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n1}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s1}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d1}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v1}</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>Z/25</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n2}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s2}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d2}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v2}</td></tr>"
    + "<tr><td style='padding:3px;color:#ff6666;font-size:12px'>Z/49</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n3}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s3}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d3}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v3}</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>Z/11</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n4}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s4}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d4}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v4}</td></tr>"
    + "<tr><td style='padding:3px;color:#44ff88;font-size:12px'>Z/13</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n5}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s5}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d5}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v5}</td></tr>"
    + "<tr><td style='padding:3px;color:#7FFFD4;font-size:12px'>Z/17</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${n6}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${s6}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${d6}</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>${v6}</td></tr>"
    + "</table><p style='color:#ffd700;margin:12px 0 4px'>CRT PRODUCTS (Z/214,414,200)</p>"
    + "<p style='color:#b0b0c0;margin:4px 0'>|Nil| = ${np} = Carmichael lambda.  |Sq0| = ${sp} = primorial.  |Idem| = ${dp} = 2^7.  |Invol| = ${vp} = 2^8.</p>"
    + "<p style='color:#ffd700;margin:12px 0 4px'>2-RATIO BRIDGE</p>"
    + "<p style='color:#44ff88;margin:4px 0;font-size:16px'>Nil / Sq0 = ${np} / ${sp} = ${r1} = 2</p>"
    + "<p style='color:#44ff88;margin:4px 0;font-size:16px'>Invol / Idem = ${vp} / ${dp} = ${r2} = 2</p>"
    + "<p style='color:#b0b0c0;margin:4px 0;font-size:12px'>Both ratios = 2 because Z/8 is the ONLY channel with exponent depth 3. Z/8 has 4 involutions (Klein four-group) while all odd Z/p^k have exactly 2.</p></div>"
  in
  dom_inner(result_el, h)
)

