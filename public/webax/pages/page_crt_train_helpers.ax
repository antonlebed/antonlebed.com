/* page_crt_train_helpers.ax -- CRT training helper functions.
   Split from page_crt_train.ax. Included before page_crt_train.ax
   in build_lab_entry.ax. Contains: training data generators (XOR, Circle,
   Spiral, Moons, Blobs), neural network forward/backward pass, i32 fixed-point
   and f64 native float modes, GPU compute helpers, D-Ratio Bridge handler.
   135 params = 33 standard (nh=8) + 6x17 CRT (nh=4). */

/* ===== FIXED-POINT CONSTANTS =====
   S=1000 scale. 1.0 = 1000, 0.5 = 500, -1.0 = -1000.
   mul: (a * b) / 1000. Division order matters for overflow avoidance.
   i32 max = 2.1B. delta clipped +/-1000, weights clamped +/-5000.
   Mini-batch SGD: ~5 batches/epoch. Leaky ReLU 25% (raw/4). */

/* ===== XOR TRAINING DATA (4 cases) ===== */
fn xor_x0(i) = if i >= 2 then 1000 else 0
fn xor_x1(i) = if i == 1 then 1000 else if i == 2 then 1000 else 0
fn xor_y(i) = if i == 1 then 1000 else if i == 3 then 1000 else 0

/* ===== CIRCLE TRAINING DATA (50 cases) =====
   Deterministic pseudo-random points. Inside circle (r<0.35) = 1, outside = 0. */
fn circle_x0(i) = ((i * 137 + 41) % 100) * 10
fn circle_x1(i) = ((i * 213 + 67) % 100) * 10
fn circle_y(i) = (
  let dx = circle_x0(i) - 500 in
  let dy = circle_x1(i) - 500 in
  if dx * dx + dy * dy < 122500 then 1000 else 0
)

/* ===== INTEGER SIN/COS (32-step full circle, quarter-wave lookup) =====
   isin32(k) returns sin(2*pi*k/32) * 1000. icos32(k) = cos. */
fn isin_q(k) = (
  if k == 0 then 0 else if k == 1 then 195 else if k == 2 then 383
  else if k == 3 then 556 else if k == 4 then 707 else if k == 5 then 831
  else if k == 6 then 924 else if k == 7 then 981 else 1000
)
fn isin32(a) = (
  let raw = a % 32 in
  let k = if raw < 0 then raw + 32 else raw in
  if k <= 8 then isin_q(k)
  else if k <= 16 then isin_q(16 - k)
  else if k <= 24 then 0 - isin_q(k - 16)
  else 0 - isin_q(32 - k)
)
fn icos32(a) = isin32(a + 8)

/* ===== SPIRAL TRAINING DATA (200 cases) =====
   Two interleaving Archimedean spirals, 100 pts each. ~3 full turns.
   Class 0: angle = idx, class 1: angle = idx + 16 (pi offset). */
fn spiral_x0(i) = (
  let cls = i / 100 in let idx = i % 100 in
  let angle = idx + cls * 16 in
  let r = 40 + idx * 4 in
  500 + r * icos32(angle) / 1000
)
fn spiral_x1(i) = (
  let cls = i / 100 in let idx = i % 100 in
  let angle = idx + cls * 16 in
  let r = 40 + idx * 4 in
  500 + r * isin32(angle) / 1000
)
fn spiral_y(i) = if i < 100 then 0 else 1000

/* ===== MOONS TRAINING DATA (100 cases) =====
   Two interleaving half-circles (classic make_moons benchmark).
   Moon 1 (class 0): upper arc at (350, 300). Moon 2 (class 1): lower arc at (650, 600).
   Pseudo-random noise +/-40 per coordinate for boundary challenge. */
fn moons_x0(i) = (
  let idx = i % 50 in
  let step = idx * 16 / 50 in
  let noise = ((i * 137 + 41) % 80) - 40 in
  if i < 50 then 350 + 250 * icos32(step) / 1000 + noise
  else 650 - 250 * icos32(step) / 1000 + noise
)
fn moons_x1(i) = (
  let idx = i % 50 in
  let step = idx * 16 / 50 in
  let noise = ((i * 213 + 67) % 80) - 40 in
  if i < 50 then 300 + 250 * isin32(step) / 1000 + noise
  else 600 - 250 * isin32(step) / 1000 + noise
)
fn moons_y(i) = if i < 50 then 0 else 1000

/* ===== BLOBS TRAINING DATA (500 cases) =====
   Two overlapping Gaussian-ish clusters. 250 pts each.
   Cluster 0 center: (350, 400). Cluster 1 center: (650, 600).
   Pseudo-random scatter +/-200 per coordinate. Significant overlap zone (~20%).
   Largest dataset: makes GPU training advantage visible (CPU slow, GPU parallel). */
fn blobs_x0(i) = (
  let cls = i / 250 in let idx = i % 250 in
  let cx = if cls == 0 then 350 else 650 in
  let n1 = ((idx * 137 + i * 41 + 7) % 400) - 200 in
  cx + n1
)
fn blobs_x1(i) = (
  let cls = i / 250 in let idx = i % 250 in
  let cy = if cls == 0 then 400 else 600 in
  let n2 = ((idx * 199 + i * 43 + 13) % 400) - 200 in
  cy + n2
)
fn blobs_y(i) = if i < 250 then 0 else 1000

/* ===== TASK DISPATCH ===== */
fn ct_task() = (
  let v = ct_parse_csv(dom_value(dom_query("#ct-task"))) in
  if len(v) > 0 then v[0] else 0
)
fn ct_task_label() = if ct_task() == 0 then "XOR (4 pts)" else if ct_task() == 1 then "Circle (50 pts)" else if ct_task() == 2 then "Spiral (200 pts)" else if ct_task() == 3 then "Moons (100 pts)" else "Blobs (500 pts)"
fn ct_update_task_indicators() = (
  let el = dom_query("#ct-gpu-task") in
  (if el > 0 then dom_text(el, "Dataset: ${ct_task_label()}") else 0);
  let t = ct_task() in
  dom_style(dom_query("#ct-task-xor"),     "background",  if t == 0 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task-xor"),     "borderColor", if t == 0 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task-circle"),  "background",  if t == 1 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task-circle"),  "borderColor", if t == 1 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task-spiral"),  "background",  if t == 2 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task-spiral"),  "borderColor", if t == 2 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task-moons"),   "background",  if t == 3 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task-moons"),   "borderColor", if t == 3 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task-blobs"),   "background",  if t == 4 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task-blobs"),   "borderColor", if t == 4 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task2-xor"),    "background",  if t == 0 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task2-xor"),    "borderColor", if t == 0 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task2-circle"), "background",  if t == 1 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task2-circle"), "borderColor", if t == 1 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task2-spiral"), "background",  if t == 2 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task2-spiral"), "borderColor", if t == 2 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task2-moons"),  "background",  if t == 3 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task2-moons"),  "borderColor", if t == 3 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-task2-blobs"),  "background",  if t == 4 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-task2-blobs"),  "borderColor", if t == 4 then "#88ddaa" else "#555")
)
fn ct_data_n() = if ct_task() == 0 then 4 else if ct_task() == 1 then 50 else if ct_task() == 2 then 200 else if ct_task() == 3 then 100 else 500
fn ct_data_x0(i) = if ct_task() == 0 then xor_x0(i) else if ct_task() == 1 then circle_x0(i) else if ct_task() == 2 then spiral_x0(i) else if ct_task() == 3 then moons_x0(i) else blobs_x0(i)
fn ct_data_x1(i) = if ct_task() == 0 then xor_x1(i) else if ct_task() == 1 then circle_x1(i) else if ct_task() == 2 then spiral_x1(i) else if ct_task() == 3 then moons_x1(i) else blobs_x1(i)
fn ct_data_y(i) = if ct_task() == 0 then xor_y(i) else if ct_task() == 1 then circle_y(i) else if ct_task() == 2 then spiral_y(i) else if ct_task() == 3 then moons_y(i) else blobs_y(i)

/* ===== STATE: weights as comma-separated i32s in hidden textarea =====
   135 values total:
     [0..32]:    Standard network (nh=8, 33 params)
     [33..49]:   CRT channel D (nh=4, 17 params)
     [50..66]:   CRT channel K
     [67..83]:   CRT channel E
     [84..100]:  CRT channel b
     [101..117]: CRT channel L
     [118..134]: CRT channel GATE
   Layout per network (nh hidden units): w1[nh*2] + b1[nh] + w2[nh] + b2[1] = nh*4+1 */

fn ct_parse_csv(s) = (
  if len(s) == 0 then []
  else (
    mut arr = [];
    mut cur = 0;
    mut neg = 0;
    mut i = 0;
    while i < len(s) do (
      let ch = charCode(s, i) in
      if ch == 44 then (
        mut arr = push(arr, if neg == 1 then 0 - cur else cur);
        mut cur = 0;
        mut neg = 0
      ) else if ch == 45 then (mut neg = 1)
      else (mut cur = cur * 10 + (ch - 48));
      mut i = i + 1
    );
    push(arr, if neg == 1 then 0 - cur else cur)
  )
)

fn ct_to_csv(arr) = (
  mut s = "";
  mut i = 0;
  while i < len(arr) do (
    if i > 0 then mut s = s + ",${arr[i]}"
    else mut s = "${arr[i]}";
    mut i = i + 1
  );
  s
)

fn ct_read_w() = ct_parse_csv(dom_value(dom_query("#ct-w")))
/* S1233: dom_text (not dom_attr) for textarea -- setAttribute("value") doesn't set .value */
fn ct_write_w(w) = dom_text(dom_query("#ct-w"), ct_to_csv(w))
fn ct_read_kills() = ct_parse_csv(dom_value(dom_query("#ct-kills")))

/* ===== EPOCH SELECTOR ===== */
fn ct_get_epc() = (
  let v = ct_parse_csv(dom_value(dom_query("#ct-epc"))) in
  if len(v) > 0 then v[0] else 200
)

fn ct_highlight_ep(n) = (
  dom_style(dom_query("#ct-ep200"), "background", if n == 200 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-ep200"), "borderColor", if n == 200 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-ep400"), "background", if n == 400 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-ep400"), "borderColor", if n == 400 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-ep1000"), "background", if n == 1000 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-ep1000"), "borderColor", if n == 1000 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-ep2000"), "background", if n == 2000 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-ep2000"), "borderColor", if n == 2000 then "#88ddaa" else "#555")
)

/* ===== LEARNING RATE SELECTOR ===== */
fn ct_get_lr() = (
  let v = ct_parse_csv(dom_value(dom_query("#ct-lr"))) in
  if len(v) > 0 then v[0] else 150
)

fn ct_highlight_lr(n) = (
  dom_style(dom_query("#ct-lr50"), "background", if n == 50 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-lr50"), "borderColor", if n == 50 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-lr100"), "background", if n == 100 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-lr100"), "borderColor", if n == 100 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-lr150"), "background", if n == 150 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-lr150"), "borderColor", if n == 150 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-lr300"), "background", if n == 300 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-lr300"), "borderColor", if n == 300 then "#88ddaa" else "#555");
  dom_style(dom_query("#ct-lr500"), "background", if n == 500 then "#2a3a4e" else "#1a1a2e");
  dom_style(dom_query("#ct-lr500"), "borderColor", if n == 500 then "#88ddaa" else "#555")
)

/* ===== NEURAL NETWORK: GENERALIZED =====
   Forward pass for network with nh hidden units starting at w[base].
   Inputs: x0, x1 (fixed-point, scale 1000). Returns: output (scale 1000). */
fn nn_fwd(w, base, nh, x0, x1) = (
  mut out = w[base + nh * 4];
  mut j = 0;
  while j < nh do (
    let raw = w[base + j * 2] * x0 / 1000 + w[base + j * 2 + 1] * x1 / 1000 + w[base + nh * 2 + j] in
    let h = if raw > 0 then raw else raw / 4 in
    mut out = out + w[base + nh * 3 + j] * h / 1000;
    mut j = j + 1
  );
  out
)

/* ===== GRADIENT ACCUMULATOR (mini-batch SGD) =====
   Accumulates raw gradients in dw, applied per mini-batch in ct_train_epochs. (S1361->S1363) */
fn nn_grad(w, dw, base, nh, x0, x1, target, tmp_hr, tmp_h, tmp_dh) = (
  mut j = 0;
  while j < nh do (
    let raw = w[base + j * 2] * x0 / 1000 + w[base + j * 2 + 1] * x1 / 1000 + w[base + nh * 2 + j] in
    set(tmp_hr, j, raw);
    set(tmp_h, j, if raw > 0 then raw else raw / 4);
    mut j = j + 1
  );
  mut out = w[base + nh * 4];
  mut j = 0;
  while j < nh do (
    mut out = out + w[base + nh * 3 + j] * tmp_h[j] / 1000;
    mut j = j + 1
  );
  let raw_delta = out - target in
  let delta = if raw_delta > 1000 then 1000 else if raw_delta < 0 - 1000 then 0 - 1000 else raw_delta in
  mut j = 0;
  while j < nh do (
    let grad = w[base + nh * 3 + j] * delta / 1000 in
    set(tmp_dh, j, if tmp_hr[j] > 0 then grad else grad / 4);
    mut j = j + 1
  );
  /* Accumulate output layer gradients */
  mut j = 0;
  while j < nh do (
    set(dw, base + nh * 3 + j, dw[base + nh * 3 + j] + delta * tmp_h[j] / 1000);
    mut j = j + 1
  );
  set(dw, base + nh * 4, dw[base + nh * 4] + delta);
  /* Accumulate hidden layer gradients */
  mut j = 0;
  while j < nh do (
    set(dw, base + j * 2, dw[base + j * 2] + tmp_dh[j] * x0 / 1000);
    set(dw, base + j * 2 + 1, dw[base + j * 2 + 1] + tmp_dh[j] * x1 / 1000);
    set(dw, base + nh * 2 + j, dw[base + nh * 2 + j] + tmp_dh[j]);
    mut j = j + 1
  );
  0
)

/* ===== F64 NEURAL NETWORK ===== */
fn toF(n) = toFloat(n)
fn neg_f64(x) = toF(0) - x
fn sigmoid_f64(x) = toF(1) / (toF(1) + exp_f(neg_f64(x)))

/* leaky ReLU: f64 if-then-else. Compiler emits (result f64) correctly. */
fn leaky_f64(x) = if x > toF(0) then x else x / toF(100)

fn nn_fwd_f64(w, base, nh, x0, x1) = (
  mut out_z = fget(w, base + nh * 4);
  mut j = 0;
  while j < nh do (
    let z = fget(w, base + j * 2) * x0 + fget(w, base + j * 2 + 1) * x1 + fget(w, base + nh * 2 + j) in
    let h = leaky_f64(z) in
    mut out_z = out_z + fget(w, base + nh * 3 + j) * h;
    mut j = j + 1
  );
  sigmoid_f64(out_z)
)

fn nn_grad_f64(w, dw, base, nh, x0, x1, target, tmp_h) = (
  mut out_z = fget(w, base + nh * 4);
  mut j = 0;
  while j < nh do (
    let z = fget(w, base + j * 2) * x0 + fget(w, base + j * 2 + 1) * x1 + fget(w, base + nh * 2 + j) in
    let h = leaky_f64(z) in
    fset(tmp_h, j, z);
    fset(tmp_h, nh + j, h);
    mut out_z = out_z + fget(w, base + nh * 3 + j) * h;
    mut j = j + 1
  );
  let out = sigmoid_f64(out_z) in
  let delta = out - target in
  mut j = 0;
  while j < nh do (
    fset(dw, base + nh * 3 + j, fget(dw, base + nh * 3 + j) + delta * fget(tmp_h, nh + j));
    mut j = j + 1
  );
  fset(dw, base + nh * 4, fget(dw, base + nh * 4) + delta);
  mut j = 0;
  while j < nh do (
    let z_j = fget(tmp_h, j) in
    let drelu = if z_j > toF(0) then toF(1) else toF(1) / toF(100) in
    let dh = delta * fget(w, base + nh * 3 + j) * drelu in
    fset(dw, base + j * 2, fget(dw, base + j * 2) + dh * x0);
    fset(dw, base + j * 2 + 1, fget(dw, base + j * 2 + 1) + dh * x1);
    fset(dw, base + nh * 2 + j, fget(dw, base + nh * 2 + j) + dh);
    mut j = j + 1
  );
  0
)

fn ct_crt_fwd_f64(w, x0, x1) = (
  mut sum = toF(0);
  mut c = 0;
  while c < 6 do (
    mut sum = sum + nn_fwd_f64(w, 33 + c * 17, 4, x0, x1);
    mut c = c + 1
  );
  sum / toF(6)
)

fn ct_init_f64_w(w) = (
  let a_w1 = sqrt_f(toF(3)) in
  let a_w2s = sqrt_f(toF(6) / toF(8)) in
  mut i = 0;
  while i < 16 do (
    fset(w, i, (toF(rand(10000)) / toF(5000) - toF(1)) * a_w1);
    mut i = i + 1
  );
  mut i = 16;
  while i < 24 do (fset(w, i, toF(0)); mut i = i + 1);
  mut i = 24;
  while i < 32 do (
    fset(w, i, (toF(rand(10000)) / toF(5000) - toF(1)) * a_w2s);
    mut i = i + 1
  );
  fset(w, 32, toF(0));
  let a_w2c = sqrt_f(toF(6) / toF(4)) in
  mut c = 0;
  while c < 6 do (
    let base = 33 + c * 17 in
    mut j = 0;
    while j < 8 do (
      fset(w, base + j, (toF(rand(10000)) / toF(5000) - toF(1)) * a_w1);
      mut j = j + 1
    );
    mut j = 8;
    while j < 12 do (fset(w, base + j, toF(0)); mut j = j + 1);
    mut j = 12;
    while j < 16 do (
      fset(w, base + j, (toF(rand(10000)) / toF(5000) - toF(1)) * a_w2c);
      mut j = j + 1
    );
    fset(w, base + 16, toF(0));
    mut c = c + 1
  );
  0
)

fn ct_train_f64(w, epochs, lr, nd, dx0, dx1, dy) = (
  let tmp_h = falloc(16) in
  let dw = falloc(135) in
  let batch_sz = if nd <= 10 then nd else nd / 5 in
  let perm = alloc(nd) in
  mut si = 0;
  while si < nd do (set(perm, si, (si * 137) % nd); mut si = si + 1);
  mut e = 0;
  while e < epochs do (
    mut b_start = 0;
    while b_start < nd do (
      let b_end = if b_start + batch_sz < nd then b_start + batch_sz else nd in
      let b_n_f = toF(b_end - b_start) in
      mut j = 0;
      while j < 135 do (fset(dw, j, toF(0)); mut j = j + 1);
      mut i = b_start;
      while i < b_end do (
        let pi = perm[i] in
        let x0 = fget(dx0, pi) in
        let x1 = fget(dx1, pi) in
        let tgt = fget(dy, pi) in
        nn_grad_f64(w, dw, 0, 8, x0, x1, tgt, tmp_h);
        mut c = 0;
        while c < 6 do (
          nn_grad_f64(w, dw, 33 + c * 17, 4, x0, x1, tgt, tmp_h);
          mut c = c + 1
        );
        mut i = i + 1
      );
      mut j = 0;
      while j < 135 do (
        fset(w, j, fget(w, j) - lr * fget(dw, j) / b_n_f);
        mut j = j + 1
      );
      mut b_start = b_end
    );
    mut e = e + 1
  );
  0
)

fn ct_write_wf(w) = (
  mut s = "";
  mut i = 0;
  while i < 135 do (
    let v = toInt(fget(w, i) * toF(10000)) in
    if i > 0 then mut s = s + ",${v}"
    else mut s = "${v}";
    mut i = i + 1
  );
  dom_text(dom_query("#ct-wf"), s)
)

fn ct_read_wf(w) = (
  let csv = ct_parse_csv(dom_value(dom_query("#ct-wf"))) in
  if len(csv) >= 135 then (
    mut i = 0;
    while i < 135 do (
      fset(w, i, toF(csv[i]) / toF(10000));
      mut i = i + 1
    );
    1
  ) else 0
)

fn ct_load_f64_data(dx0, dx1, dy, nd) = (
  mut i = 0;
  while i < nd do (
    fset(dx0, i, toF(ct_data_x0(i)) / toF(1000));
    fset(dx1, i, toF(ct_data_x1(i)) / toF(1000));
    fset(dy, i, toF(ct_data_y(i)) / toF(1000));
    mut i = i + 1
  );
  0
)

/* ===== CRT FORWARD: AVERAGE OF ACTIVE CHANNELS ===== */
fn ct_crt_fwd(w, x0, x1, kills) = (
  mut sum = 0;
  mut n = 0;
  mut c = 0;
  while c < 6 do (
    if kills[c] == 0 then (
      mut sum = sum + nn_fwd(w, 33 + c * 17, 4, x0, x1);
      mut n = n + 1
    ) else 0;
    mut c = c + 1
  );
  if n > 0 then sum / n else 0
)

/* ===== TRAINING (MINI-BATCH SGD) =====
   ~5 mini-batches per epoch: preserves per-sample gradient diversity.
   Full-batch SGD collapses to majority-class prediction on imbalanced datasets.
   Mini-batch: accumulate gradients over batch_sz samples, apply, repeat. (S1362 fix) */
fn ct_train_epochs(w, epochs) = (
  let lr = ct_get_lr() in
  let nd = ct_data_n() in
  let dx0 = alloc(nd) in
  let dx1 = alloc(nd) in
  let dy = alloc(nd) in
  mut i = 0;
  while i < nd do (
    set(dx0, i, ct_data_x0(i));
    set(dx1, i, ct_data_x1(i));
    set(dy, i, ct_data_y(i));
    mut i = i + 1
  );
  let tmp_hr = alloc(8) in
  let tmp_h = alloc(8) in
  let tmp_dh = alloc(8) in
  let dw = alloc(135) in
  let batch_sz = if nd <= 10 then nd else nd / 5 in
  /* Deterministic interleave: breaks class-ordered data (Spiral, Moons, Blobs).
     perm[i] = (i * 137) % nd visits all indices in class-mixed order.
     Without this, pure-class batches cancel gradients -> Spiral stuck at 50%. */
  let perm = alloc(nd) in
  mut si = 0;
  while si < nd do (set(perm, si, (si * 137) % nd); mut si = si + 1);
  mut e = 0;
  while e < epochs do (
    mut b_start = 0;
    while b_start < nd do (
      let b_end = if b_start + batch_sz < nd then b_start + batch_sz else nd in
      let b_n = b_end - b_start in
      /* Zero gradient accumulator */
      mut j = 0;
      while j < 135 do (set(dw, j, 0); mut j = j + 1);
      /* Accumulate gradients over mini-batch (interleaved indices) */
      mut i = b_start;
      while i < b_end do (
        let pi = perm[i] in
        nn_grad(w, dw, 0, 8, dx0[pi], dx1[pi], dy[pi], tmp_hr, tmp_h, tmp_dh);
        mut c = 0;
        while c < 6 do (
          nn_grad(w, dw, 33 + c * 17, 4, dx0[pi], dx1[pi], dy[pi], tmp_hr, tmp_h, tmp_dh);
          mut c = c + 1
        );
        mut i = i + 1
      );
      /* Apply averaged gradients: w -= lr * (dw/b_n) / 1000 + weight clamp */
      mut j = 0;
      while j < 135 do (
        let avg_g = dw[j] / b_n in
        let update = lr * avg_g / 1000 in
        let nw = w[j] - update in
        set(w, j, if nw > 5000 then 5000 else if nw < 0 - 5000 then 0 - 5000 else nw);
        mut j = j + 1
      );
      mut b_start = b_end
    );
    mut e = e + 1
  );
  0
)

/* ===== ACCURACY + LOSS ===== */
fn ct_accuracy(w, base, nh) = (
  let nd = ct_data_n() in
  mut correct = 0;
  mut i = 0;
  while i < nd do (
    let out = nn_fwd(w, base, nh, ct_data_x0(i), ct_data_x1(i)) in
    if (out > 500) == (ct_data_y(i) > 500) then mut correct = correct + 1 else 0;
    mut i = i + 1
  );
  correct
)

fn ct_loss(w, base, nh) = (
  let nd = ct_data_n() in
  mut total = 0;
  mut i = 0;
  while i < nd do (
    let out = nn_fwd(w, base, nh, ct_data_x0(i), ct_data_x1(i)) in
    let d_raw = out - ct_data_y(i) in
    /* Clamp delta for loss display: d*d overflow at |d|>46340 (sqrt i32_max). (S1361 R7) */
    let d = if d_raw > 2000 then 2000 else if d_raw < 0 - 2000 then 0 - 2000 else d_raw in
    mut total = total + d * d / 1000;
    mut i = i + 1
  );
  total / nd
)

/* ===== CRT COMBINED LOSS (average of channel losses) ===== */
fn ct_crt_loss(w) = (
  let kills = ct_parse_csv(dom_value(dom_query("#ct-kills"))) in
  let nd = ct_data_n() in
  mut total = 0;
  mut i = 0;
  while i < nd do (
    let out = ct_crt_fwd(w, ct_data_x0(i), ct_data_x1(i), kills) in
    let d_raw = out - ct_data_y(i) in
    let d = if d_raw > 2000 then 2000 else if d_raw < 0 - 2000 then 0 - 2000 else d_raw in
    mut total = total + d * d / 1000;
    mut i = i + 1
  );
  total / nd
)

/* ===== CRT COMBINED ACCURACY ===== */
fn ct_crt_accuracy(w) = (
  let nd = ct_data_n() in
  let kills = ct_read_kills() in
  mut correct = 0;
  mut i = 0;
  while i < nd do (
    let out = ct_crt_fwd(w, ct_data_x0(i), ct_data_x1(i), kills) in
    if (out > 500) == (ct_data_y(i) > 500) then mut correct = correct + 1 else 0;
    mut i = i + 1
  );
  correct
)

/* ===== LOSS CURVE ===== */
fn ct_draw_loss_curve() = (
  let data = ct_parse_csv(dom_value(dom_query("#ct-loss-hist"))) in
  let n = len(data) / 2 in
  let ctx = cvs_getctx(dom_query("#ct-loss-cvs")) in
  let cw = 320 in let ch = 120 in
  let _c = cvs_clearrect(ctx, 0, 0, cw, ch) in
  let _bg = cvs_fillstyle(ctx, "#0a0a18") in
  cvs_fillrect(ctx, 0, 0, cw, ch);
  if n == 0 then (
    let _fs = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "Train to see loss curve", 80, 65);
    0
  ) else (
    /* Find max loss for scaling */
    mut mx = 1;
    mut i = 0;
    while i < n * 2 do (
      if data[i] > mx then mut mx = data[i] else 0;
      mut i = i + 1
    );
    /* Axes */
    let _fa = cvs_fillstyle(ctx, "#333") in
    cvs_fillrect(ctx, 24, 5, 1, ch - 10);
    cvs_fillrect(ctx, 24, ch - 6, cw - 30, 1);
    /* Y-axis label */
    let _fy = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "${mx}", 0, 14);
    cvs_filltext(ctx, "0", 8, ch - 8);
    /* Standard loss (red dots) */
    let _fs = cvs_fillstyle(ctx, "#ff6666") in
    mut i = 0;
    while i < n do (
      let x = 28 + i * (cw - 36) / (if n > 1 then n - 1 else 1) in
      let y = ch - 8 - data[i * 2] * (ch - 18) / mx in
      cvs_fillrect(ctx, x, if y < 5 then 5 else y, 3, 3);
      mut i = i + 1
    );
    /* CRT loss (green dots) */
    let _fs2 = cvs_fillstyle(ctx, "#44ff88") in
    mut i = 0;
    while i < n do (
      let x = 28 + i * (cw - 36) / (if n > 1 then n - 1 else 1) in
      let y = ch - 8 - data[i * 2 + 1] * (ch - 18) / mx in
      cvs_fillrect(ctx, x, if y < 5 then 5 else y, 3, 3);
      mut i = i + 1
    );
    /* Legend */
    let _fl1 = cvs_fillstyle(ctx, "#ff6666") in
    cvs_fillrect(ctx, cw - 110, 8, 8, 8);
    cvs_filltext(ctx, "Std", cw - 98, 16);
    let _fl2 = cvs_fillstyle(ctx, "#44ff88") in
    cvs_fillrect(ctx, cw - 60, 8, 8, 8);
    cvs_filltext(ctx, "CRT", cw - 48, 16);
    0
  )
)

/* ===== PER-CHANNEL LOSS CURVE ===== */
fn ct_draw_ch_loss_curve() = (
  let data = ct_parse_csv(dom_value(dom_query("#ct-ch-loss-hist"))) in
  let n = len(data) / 6 in
  let ctx = cvs_getctx(dom_query("#ct-ch-loss-cvs")) in
  let cw = 320 in let ch = 120 in
  let _c = cvs_clearrect(ctx, 0, 0, cw, ch) in
  let _bg = cvs_fillstyle(ctx, "#0a0a18") in
  cvs_fillrect(ctx, 0, 0, cw, ch);
  if n == 0 then (
    let _fs = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "Train to see channel convergence", 60, 65);
    0
  ) else (
    /* Find max loss across all channels for scaling */
    mut mx = 1;
    mut i = 0;
    while i < n * 6 do (
      if data[i] > mx then mut mx = data[i] else 0;
      mut i = i + 1
    );
    /* Axes */
    let _fa = cvs_fillstyle(ctx, "#333") in
    cvs_fillrect(ctx, 24, 5, 1, ch - 10);
    cvs_fillrect(ctx, 24, ch - 6, cw - 30, 1);
    /* Y-axis labels */
    let _fy = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "${mx}", 0, 14);
    cvs_filltext(ctx, "0", 8, ch - 8);
    /* 6 channel traces */
    mut c = 0;
    while c < 6 do (
      let _fs = cvs_fillstyle(ctx, ct_ch_color(c)) in
      mut i = 0;
      while i < n do (
        let x = 28 + i * (cw - 36) / (if n > 1 then n - 1 else 1) in
        let y = ch - 8 - data[i * 6 + c] * (ch - 18) / mx in
        cvs_fillrect(ctx, x, if y < 5 then 5 else y, 3, 3);
        mut i = i + 1
      );
      mut c = c + 1
    );
    /* Legend: mod N labels (top, like other curves) */
    let names = ["m8", "m9", "m25", "m49", "m11", "m13"] in
    mut c = 0;
    while c < 6 do (
      let _fl = cvs_fillstyle(ctx, ct_ch_color(c)) in
      let lx = 28 + c * 48 in
      cvs_fillrect(ctx, lx, 8, 6, 6);
      cvs_filltext(ctx, names[c], lx + 9, 16);
      mut c = c + 1
    );
    0
  )
)

/* ===== ACCURACY CURVE ===== */
fn ct_draw_acc_curve() = (
  let data = ct_parse_csv(dom_value(dom_query("#ct-acc-hist"))) in
  let n = len(data) / 2 in
  let ctx = cvs_getctx(dom_query("#ct-acc-cvs")) in
  let cw = 320 in let ch = 120 in
  let _c = cvs_clearrect(ctx, 0, 0, cw, ch) in
  let _bg = cvs_fillstyle(ctx, "#0a0a18") in
  cvs_fillrect(ctx, 0, 0, cw, ch);
  if n == 0 then (
    let _fs = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "Train to see accuracy curve", 70, 65);
    0
  ) else (
    let nd = ct_data_n() in
    /* Axes */
    let _fa = cvs_fillstyle(ctx, "#333") in
    cvs_fillrect(ctx, 30, 5, 1, ch - 10);
    cvs_fillrect(ctx, 30, ch - 6, cw - 36, 1);
    /* Y-axis labels (0% to 100%) */
    let _fy = cvs_fillstyle(ctx, "#555") in
    cvs_filltext(ctx, "100%", 0, 14);
    cvs_filltext(ctx, "50%", 4, ch / 2);
    cvs_filltext(ctx, "0%", 8, ch - 8);
    /* 50% gridline */
    cvs_fillrect(ctx, 30, ch / 2 - 1, cw - 36, 1);
    /* Standard accuracy (red dots) */
    let _fs = cvs_fillstyle(ctx, "#ff6666") in
    mut i = 0;
    while i < n do (
      let x = 34 + i * (cw - 42) / (if n > 1 then n - 1 else 1) in
      let pct = if nd > 0 then data[i * 2] * 100 / nd else 0 in
      let y = ch - 8 - pct * (ch - 18) / 100 in
      cvs_fillrect(ctx, x, if y < 5 then 5 else y, 3, 3);
      mut i = i + 1
    );
    /* CRT accuracy (green dots) */
    let _fs2 = cvs_fillstyle(ctx, "#44ff88") in
    mut i = 0;
    while i < n do (
      let x = 34 + i * (cw - 42) / (if n > 1 then n - 1 else 1) in
      let pct = if nd > 0 then data[i * 2 + 1] * 100 / nd else 0 in
      let y = ch - 8 - pct * (ch - 18) / 100 in
      cvs_fillrect(ctx, x, if y < 5 then 5 else y, 3, 3);
      mut i = i + 1
    );
    /* Legend */
    let _fl1 = cvs_fillstyle(ctx, "#ff6666") in
    cvs_fillrect(ctx, cw - 110, 8, 8, 8);
    cvs_filltext(ctx, "Std", cw - 98, 16);
    let _fl2 = cvs_fillstyle(ctx, "#44ff88") in
    cvs_fillrect(ctx, cw - 60, 8, 8, 8);
    cvs_filltext(ctx, "CRT", cw - 48, 16);
    0
  )
)

/* ===== COLOR PALETTES (11 levels each) ===== */
fn ct_green(lv) = (
  if lv <= 0 then "#0a0a2a"
  else if lv <= 1 then "#0a1a2e"
  else if lv <= 2 then "#0a2a38"
  else if lv <= 3 then "#0a3a42"
  else if lv <= 4 then "#104a4e"
  else if lv <= 5 then "#1a5a5a"
  else if lv <= 6 then "#2a6a66"
  else if lv <= 7 then "#3a8a72"
  else if lv <= 8 then "#4aaa80"
  else if lv <= 9 then "#5aca90"
  else "#6aeaa0"
)

fn ct_red(lv) = (
  if lv <= 0 then "#2a0a0a"
  else if lv <= 1 then "#350a0a"
  else if lv <= 2 then "#401515"
  else if lv <= 3 then "#4a2020"
  else if lv <= 4 then "#552a2a"
  else if lv <= 5 then "#603535"
  else if lv <= 6 then "#704040"
  else if lv <= 7 then "#885050"
  else if lv <= 8 then "#aa6666"
  else if lv <= 9 then "#cc8080"
  else "#ee9a9a"
)

fn ct_clamp_level(v) = if v < 0 then 0 else if v > 1000 then 10 else v / 100

/* ===== HEATMAP DRAWING =====
   Canvas 320x200, 4px resolution = 80x50 = 4000 cells.
   Two-pass: compute levels, then batch by color (11 fillstyle calls). */
fn ct_draw_std_heatmap(w) = (
  let ctx = cvs_getctx(dom_query("#ct-std-cvs")) in
  let _c = cvs_clearrect(ctx, 0, 0, 320, 200) in
  mut levels = alloc(4000);
  mut idx = 0;
  mut py = 0;
  while py < 50 do (
    mut px = 0;
    while px < 80 do (
      let x0 = px * 1000 / 80 in
      let x1 = py * 1000 / 50 in
      set(levels, idx, ct_clamp_level(nn_fwd(w, 0, 8, x0, x1)));
      mut idx = idx + 1;
      mut px = px + 1
    );
    mut py = py + 1
  );
  mut lv = 0;
  while lv <= 10 do (
    let _fs = cvs_fillstyle(ctx, ct_red(lv)) in
    mut idx = 0;
    mut py = 0;
    while py < 50 do (
      mut px = 0;
      while px < 80 do (
        if levels[idx] == lv then cvs_fillrect(ctx, px * 4, py * 4, 4, 4) else 0;
        mut idx = idx + 1;
        mut px = px + 1
      );
      mut py = py + 1
    );
    mut lv = lv + 1
  );
  0
)

fn ct_draw_crt_heatmap(w, kills) = (
  let ctx = cvs_getctx(dom_query("#ct-crt-cvs")) in
  let _c = cvs_clearrect(ctx, 0, 0, 320, 200) in
  mut levels = alloc(4000);
  mut idx = 0;
  mut py = 0;
  while py < 50 do (
    mut px = 0;
    while px < 80 do (
      let x0 = px * 1000 / 80 in
      let x1 = py * 1000 / 50 in
      set(levels, idx, ct_clamp_level(ct_crt_fwd(w, x0, x1, kills)));
      mut idx = idx + 1;
      mut px = px + 1
    );
    mut py = py + 1
  );
  mut lv = 0;
  while lv <= 10 do (
    let _fs = cvs_fillstyle(ctx, ct_green(lv)) in
    mut idx = 0;
    mut py = 0;
    while py < 50 do (
      mut px = 0;
      while px < 80 do (
        if levels[idx] == lv then cvs_fillrect(ctx, px * 4, py * 4, 4, 4) else 0;
        mut idx = idx + 1;
        mut px = px + 1
      );
      mut py = py + 1
    );
    mut lv = lv + 1
  );
  0
)

/* ===== DATA POINTS ON HEATMAP ===== */
fn ct_draw_points(cvs_id) = (
  let ctx = cvs_getctx(dom_query(cvs_id)) in
  let nd = ct_data_n() in
  let _fs = cvs_fillstyle(ctx, "#ffffff") in
  mut i = 0;
  while i < nd do (
    let px = ct_data_x0(i) * 300 / 1000 + 10 in
    let py = ct_data_x1(i) * 180 / 1000 + 10 in
    let sz = if ct_data_y(i) > 500 then 6 else 4 in
    cvs_fillrect(ctx, px - sz / 2, py - sz / 2, sz, sz);
    mut i = i + 1
  );
  /* Labels only for small datasets */
  if nd <= 8 then (
    let _fs2 = cvs_fillstyle(ctx, "#ffff00") in
    mut i = 0;
    while i < nd do (
      let px = ct_data_x0(i) * 300 / 1000 + 16 in
      let py = ct_data_x1(i) * 180 / 1000 + 14 in
      cvs_filltext(ctx, if ct_data_y(i) > 500 then "1" else "0", px, py);
      mut i = i + 1
    );
    0
  ) else 0
)

/* ===== STATS DISPLAY ===== */
fn ct_show_stats(w) = (
  let nd = ct_data_n() in
  let std_acc = ct_accuracy(w, 0, 8) in
  let std_l = ct_loss(w, 0, 8) in
  dom_text(dom_query("#ct-std-stats"), "Accuracy: ${std_acc}/${nd} | Loss: ${std_l}");
  let kills = ct_read_kills() in
  mut crt_correct = 0;
  mut i = 0;
  while i < nd do (
    let out = ct_crt_fwd(w, ct_data_x0(i), ct_data_x1(i), kills) in
    if (out > 500) == (ct_data_y(i) > 500) then mut crt_correct = crt_correct + 1 else 0;
    mut i = i + 1
  );
  let active = 6 - kills[0] - kills[1] - kills[2] - kills[3] - kills[4] - kills[5] in
  dom_text(dom_query("#ct-crt-stats"), "Accuracy: ${crt_correct}/${nd} | Active: ${active}/6");
  mut c = 0;
  while c < 6 do (
    let acc = ct_accuracy(w, 33 + c * 17, 4) in
    let name = if c == 0 then "mod 8" else if c == 1 then "mod 9" else if c == 2 then "mod 25" else if c == 3 then "mod 49" else if c == 4 then "mod 11" else "mod 13" in
    let dead = kills[c] in
    dom_text(dom_query("#ct-ch${c}"), "${name}: ${if dead == 1 then "OFF" else "${acc}/${nd}"}");
    dom_style(dom_query("#ct-ch${c}"), "color", if dead == 1 then "#ff4444" else if acc == nd then "#44ff44" else "#ffbb00");
    mut c = c + 1
  );
  0
)

/* ===== F64 HEATMAP + STATS ===== */
fn ct_f64_level(out_f) = (
  let v = toInt(out_f * toF(10)) in
  if v < 0 then 0 else if v > 10 then 10 else v
)

fn ct_draw_std_heatmap_f64(w) = (
  let ctx = cvs_getctx(dom_query("#ct-std-cvs")) in
  let _c = cvs_clearrect(ctx, 0, 0, 320, 200) in
  mut levels = alloc(4000);
  mut idx = 0;
  mut py = 0;
  while py < 50 do (
    mut px = 0;
    while px < 80 do (
      let x0 = toF(px) / toF(80) in
      let x1 = toF(py) / toF(50) in
      set(levels, idx, ct_f64_level(nn_fwd_f64(w, 0, 8, x0, x1)));
      mut idx = idx + 1;
      mut px = px + 1
    );
    mut py = py + 1
  );
  mut lv = 0;
  while lv <= 10 do (
    let _fs = cvs_fillstyle(ctx, ct_red(lv)) in
    mut idx = 0;
    mut py = 0;
    while py < 50 do (
      mut px = 0;
      while px < 80 do (
        if levels[idx] == lv then cvs_fillrect(ctx, px * 4, py * 4, 4, 4) else 0;
        mut idx = idx + 1;
        mut px = px + 1
      );
      mut py = py + 1
    );
    mut lv = lv + 1
  );
  0
)

fn ct_draw_crt_heatmap_f64(w) = (
  let ctx = cvs_getctx(dom_query("#ct-crt-cvs")) in
  let _c = cvs_clearrect(ctx, 0, 0, 320, 200) in
  mut levels = alloc(4000);
  mut idx = 0;
  mut py = 0;
  while py < 50 do (
    mut px = 0;
    while px < 80 do (
      let x0 = toF(px) / toF(80) in
      let x1 = toF(py) / toF(50) in
      set(levels, idx, ct_f64_level(ct_crt_fwd_f64(w, x0, x1)));
      mut idx = idx + 1;
      mut px = px + 1
    );
    mut py = py + 1
  );
  mut lv = 0;
  while lv <= 10 do (
    let _fs = cvs_fillstyle(ctx, ct_green(lv)) in
    mut idx = 0;
    mut py = 0;
    while py < 50 do (
      mut px = 0;
      while px < 80 do (
        if levels[idx] == lv then cvs_fillrect(ctx, px * 4, py * 4, 4, 4) else 0;
        mut idx = idx + 1;
        mut px = px + 1
      );
      mut py = py + 1
    );
    mut lv = lv + 1
  );
  0
)

fn ct_f64_accuracy(w, base, nh, nd, dx0, dx1, dy) = (
  mut correct = 0;
  mut i = 0;
  while i < nd do (
    let out = nn_fwd_f64(w, base, nh, fget(dx0, i), fget(dx1, i)) in
    let tgt = fget(dy, i) in
    if (toInt(out * toF(1000)) > 500) == (toInt(tgt * toF(1000)) > 500)
      then mut correct = correct + 1 else 0;
    mut i = i + 1
  );
  correct
)

fn ct_f64_crt_accuracy(w, nd, dx0, dx1, dy) = (
  mut correct = 0;
  mut i = 0;
  while i < nd do (
    let out = ct_crt_fwd_f64(w, fget(dx0, i), fget(dx1, i)) in
    let tgt = fget(dy, i) in
    if (toInt(out * toF(1000)) > 500) == (toInt(tgt * toF(1000)) > 500)
      then mut correct = correct + 1 else 0;
    mut i = i + 1
  );
  correct
)

fn ct_f64_loss(w, base, nh, nd, dx0, dx1, dy) = (
  mut total_i = 0;
  mut i = 0;
  while i < nd do (
    let out = nn_fwd_f64(w, base, nh, fget(dx0, i), fget(dx1, i)) in
    let d = out - fget(dy, i) in
    mut total_i = total_i + toInt(d * d * toF(1000));
    mut i = i + 1
  );
  total_i / nd
)

fn ct_f64_crt_loss(w, nd, dx0, dx1, dy) = (
  mut total_i = 0;
  mut i = 0;
  while i < nd do (
    let out = ct_crt_fwd_f64(w, fget(dx0, i), fget(dx1, i)) in
    let d = out - fget(dy, i) in
    mut total_i = total_i + toInt(d * d * toF(1000));
    mut i = i + 1
  );
  total_i / nd
)

fn ct_f64_show_stats(w, nd, dx0, dx1, dy) = (
  let std_acc = ct_f64_accuracy(w, 0, 8, nd, dx0, dx1, dy) in
  let std_l = ct_f64_loss(w, 0, 8, nd, dx0, dx1, dy) in
  dom_text(dom_query("#ct-std-stats"), "f64 | Acc: ${std_acc}/${nd} | Loss: ${std_l}");
  let crt_acc = ct_f64_crt_accuracy(w, nd, dx0, dx1, dy) in
  dom_text(dom_query("#ct-crt-stats"), "f64 | Acc: ${crt_acc}/${nd} | Active: 6/6");
  mut c = 0;
  while c < 6 do (
    let acc = ct_f64_accuracy(w, 33 + c * 17, 4, nd, dx0, dx1, dy) in
    let name = if c == 0 then "mod 8" else if c == 1 then "mod 9" else if c == 2 then "mod 25" else if c == 3 then "mod 49" else if c == 4 then "mod 11" else "mod 13" in
    dom_text(dom_query("#ct-ch${c}"), "${name}: ${acc}/${nd}");
    dom_style(dom_query("#ct-ch${c}"), "color", if acc == nd then "#44ff44" else "#ffbb00");
    mut c = c + 1
  );
  0
)

/* ===== DRAW ALL ===== */
fn ct_draw_all(w) = (
  let kills = ct_read_kills() in
  ct_draw_std_heatmap(w);
  ct_draw_points("#ct-std-cvs");
  ct_draw_crt_heatmap(w, kills);
  ct_draw_points("#ct-crt-cvs");
  ct_show_stats(w)
)

/* ===== CALLBACKS ===== */
fn on_ct_init() = (
  mut w = alloc(135);
  /* Standard: nh=8, 33 params. He init: w2 = U(-500,500) ~ sqrt(6/8)*1000. (S1362 fix) */
  mut i = 0;
  while i < 33 do (
    let v = if i < 16 then rand(1414) - 707
            else if i < 24 then 0
            else if i < 32 then rand(1000) - 500
            else 0 in
    set(w, i, v);
    mut i = i + 1
  );
  /* CRT: 6 channels x 17 params. He init: w2 = U(-500,500) ~ sqrt(6/4)*1000. (S1362 fix) */
  mut c = 0;
  while c < 6 do (
    let base = 33 + c * 17 in
    mut j = 0;
    while j < 17 do (
      let v = if j < 8 then rand(1414) - 707
              else if j < 12 then 0
              else if j < 16 then rand(1000) - 500
              else 0 in
      set(w, base + j, v);
      mut j = j + 1
    );
    mut c = c + 1
  );
  dom_text(dom_query("#ct-kills"), "0,0,0,0,0,0");
  dom_text(dom_query("#ct-epoch-n"), "0");
  dom_text(dom_query("#ct-wf"), "");
  ct_write_w(w);
  ct_draw_all(w);
  dom_text(dom_query("#ct-epoch"), "Epoch: 0");
  /* Record initial loss + accuracy */
  let std_l = ct_loss(w, 0, 8) in
  let crt_l = ct_crt_loss(w) in
  dom_text(dom_query("#ct-loss-hist"), "${std_l},${crt_l}");
  let std_a = ct_accuracy(w, 0, 8) in
  let crt_a = ct_crt_accuracy(w) in
  dom_text(dom_query("#ct-acc-hist"), "${std_a},${crt_a}");
  /* Record initial per-channel losses */
  let cl0 = ct_loss(w, 33, 4) in
  let cl1 = ct_loss(w, 50, 4) in
  let cl2 = ct_loss(w, 67, 4) in
  let cl3 = ct_loss(w, 84, 4) in
  let cl4 = ct_loss(w, 101, 4) in
  let cl5 = ct_loss(w, 118, 4) in
  dom_text(dom_query("#ct-ch-loss-hist"), "${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}");
  ct_draw_loss_curve();
  ct_draw_acc_curve();
  ct_draw_ch_loss_curve()
)

fn on_ct_train() = (
  let check = ct_read_w() in
  if len(check) < 135 then on_ct_init() else 0;
  let w = ct_read_w() in
  let epc = ct_get_epc() in
  let chunks = epc / 200 in
  let t0 = time_ms() in
  /* Train in 200-epoch chunks, recording loss after each for curve resolution.
     Arena reset per chunk: ct_loss/ct_accuracy call ct_task() per data point,
     each allocating a parse array. 500pts * 3 * 10 metrics * 10 chunks = 150K dead arrays.
     hp()/set_hp() reclaims these. w lives below mark, survives. (S1361 fix) */
  let mark = hp() in
  mut chunk = 0;
  while chunk < chunks do (
    ct_train_epochs(w, 200);
    let std_l = ct_loss(w, 0, 8) in
    let crt_l = ct_crt_loss(w) in
    let hist_str = dom_value(dom_query("#ct-loss-hist")) in
    let new_hist = if len(hist_str) == 0 then "${std_l},${crt_l}"
                   else "${hist_str},${std_l},${crt_l}" in
    dom_text(dom_query("#ct-loss-hist"), new_hist);
    let std_a = ct_accuracy(w, 0, 8) in
    let crt_a = ct_crt_accuracy(w) in
    let acc_str = dom_value(dom_query("#ct-acc-hist")) in
    let new_acc = if len(acc_str) == 0 then "${std_a},${crt_a}"
                  else "${acc_str},${std_a},${crt_a}" in
    dom_text(dom_query("#ct-acc-hist"), new_acc);
    /* Per-channel losses */
    let cl0 = ct_loss(w, 33, 4) in
    let cl1 = ct_loss(w, 50, 4) in
    let cl2 = ct_loss(w, 67, 4) in
    let cl3 = ct_loss(w, 84, 4) in
    let cl4 = ct_loss(w, 101, 4) in
    let cl5 = ct_loss(w, 118, 4) in
    let ch_str = dom_value(dom_query("#ct-ch-loss-hist")) in
    let new_ch = if len(ch_str) == 0 then "${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}"
                 else "${ch_str},${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}" in
    dom_text(dom_query("#ct-ch-loss-hist"), new_ch);
    set_hp(mark);
    mut chunk = chunk + 1
  );
  let dt = time_ms() - t0 in
  ct_write_w(w);
  let old_e = ct_parse_csv(dom_value(dom_query("#ct-epoch-n"))) in
  let new_e = if len(old_e) > 0 then old_e[0] + epc else epc in
  dom_text(dom_query("#ct-epoch-n"), "${new_e}");
  dom_text(dom_query("#ct-epoch"), "Epoch: ${new_e}");
  ct_draw_all(w);
  ct_draw_loss_curve();
  ct_draw_acc_curve();
  ct_draw_ch_loss_curve();
  let nd = ct_data_n() in
  let std_l = ct_loss(w, 0, 8) in
  let crt_l = ct_crt_loss(w) in
  let std_a = ct_accuracy(w, 0, 8) in
  let crt_a = ct_crt_accuracy(w) in
  let lr_v = ct_get_lr() in
  dom_text(dom_query("#ct-cpu-result"),
    "CPU: ${dt}ms | ${epc} ep, lr=${lr_v/1000}.${(lr_v%1000)/100}${(lr_v%100)/10} on ${nd} pts | Std: ${std_a}/${nd} loss=${std_l} | CRT: ${crt_a}/${nd} loss=${crt_l}")
)

fn ct_toggle_kill(ch) = (
  let kills = ct_read_kills() in
  if len(kills) < 6 then 0
  else (
    set(kills, ch, if kills[ch] == 0 then 1 else 0);
    dom_text(dom_query("#ct-kills"), ct_to_csv(kills));
    let w = ct_read_w() in
    if len(w) >= 135 then (
      ct_draw_crt_heatmap(w, kills);
      ct_draw_points("#ct-crt-cvs");
      ct_show_stats(w)
    ) else 0
  )
)

/* ===== F64 TRAINING CALLBACK ===== */
fn on_ct_train_f64() = (
  let nd = ct_data_n() in
  let epc = ct_get_epc() in
  let lr_i = ct_get_lr() in
  let lr = toF(lr_i) / toF(1000) in
  let w = falloc(135) in
  let loaded = ct_read_wf(w) in
  if loaded == 0 then ct_init_f64_w(w) else 0;
  let dx0 = falloc(nd) in
  let dx1 = falloc(nd) in
  let dy = falloc(nd) in
  ct_load_f64_data(dx0, dx1, dy, nd);
  let t0 = time_ms() in
  let chunks = epc / 200 in
  let mark = hp() in
  mut chunk = 0;
  while chunk < chunks do (
    ct_train_f64(w, 200, lr, nd, dx0, dx1, dy);
    let std_l = ct_f64_loss(w, 0, 8, nd, dx0, dx1, dy) in
    let crt_l = ct_f64_crt_loss(w, nd, dx0, dx1, dy) in
    let lh = dom_value(dom_query("#ct-loss-hist")) in
    dom_text(dom_query("#ct-loss-hist"),
      if len(lh) == 0 then "${std_l},${crt_l}" else "${lh},${std_l},${crt_l}");
    let std_a = ct_f64_accuracy(w, 0, 8, nd, dx0, dx1, dy) in
    let crt_a = ct_f64_crt_accuracy(w, nd, dx0, dx1, dy) in
    let ah = dom_value(dom_query("#ct-acc-hist")) in
    dom_text(dom_query("#ct-acc-hist"),
      if len(ah) == 0 then "${std_a},${crt_a}" else "${ah},${std_a},${crt_a}");
    let cl0 = ct_f64_loss(w, 33, 4, nd, dx0, dx1, dy) in
    let cl1 = ct_f64_loss(w, 50, 4, nd, dx0, dx1, dy) in
    let cl2 = ct_f64_loss(w, 67, 4, nd, dx0, dx1, dy) in
    let cl3 = ct_f64_loss(w, 84, 4, nd, dx0, dx1, dy) in
    let cl4 = ct_f64_loss(w, 101, 4, nd, dx0, dx1, dy) in
    let cl5 = ct_f64_loss(w, 118, 4, nd, dx0, dx1, dy) in
    let ch_s = dom_value(dom_query("#ct-ch-loss-hist")) in
    dom_text(dom_query("#ct-ch-loss-hist"),
      if len(ch_s) == 0 then "${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}"
      else "${ch_s},${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}");
    set_hp(mark);
    mut chunk = chunk + 1
  );
  let dt = time_ms() - t0 in
  ct_write_wf(w);
  let old_e = ct_parse_csv(dom_value(dom_query("#ct-epoch-n"))) in
  let new_e = if len(old_e) > 0 then old_e[0] + epc else epc in
  dom_text(dom_query("#ct-epoch-n"), "${new_e}");
  dom_text(dom_query("#ct-epoch"), "Epoch: ${new_e}");
  let dx0b = falloc(nd) in
  let dx1b = falloc(nd) in
  let dyb = falloc(nd) in
  ct_load_f64_data(dx0b, dx1b, dyb, nd);
  let w2 = falloc(135) in
  ct_read_wf(w2);
  ct_draw_std_heatmap_f64(w2);
  ct_draw_points("#ct-std-cvs");
  ct_draw_crt_heatmap_f64(w2);
  ct_draw_points("#ct-crt-cvs");
  ct_f64_show_stats(w2, nd, dx0b, dx1b, dyb);
  ct_draw_loss_curve();
  ct_draw_acc_curve();
  ct_draw_ch_loss_curve();
  let std_l = ct_f64_loss(w2, 0, 8, nd, dx0b, dx1b, dyb) in
  let crt_l = ct_f64_crt_loss(w2, nd, dx0b, dx1b, dyb) in
  let std_a = ct_f64_accuracy(w2, 0, 8, nd, dx0b, dx1b, dyb) in
  let crt_a = ct_f64_crt_accuracy(w2, nd, dx0b, dx1b, dyb) in
  dom_text(dom_query("#ct-cpu-result"),
    "f64 CPU: ${dt}ms | ${epc} ep, lr=${lr_i/1000}.${(lr_i%1000)/100}${(lr_i%100)/10} on ${nd} pts | Std: ${std_a}/${nd} loss=${std_l} | CRT: ${crt_a}/${nd} loss=${crt_l}")
)

