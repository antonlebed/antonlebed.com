fn on_ct_ep400() = (dom_text(dom_query("#ct-epc"), "400"); ct_highlight_ep(400))
fn on_ct_ep1000() = (dom_text(dom_query("#ct-epc"), "1000"); ct_highlight_ep(1000))
fn on_ct_ep2000() = (dom_text(dom_query("#ct-epc"), "2000"); ct_highlight_ep(2000))

fn on_ct_lr50() = (dom_text(dom_query("#ct-lr"), "50"); ct_highlight_lr(50))
fn on_ct_lr100() = (dom_text(dom_query("#ct-lr"), "100"); ct_highlight_lr(100))
fn on_ct_lr150() = (dom_text(dom_query("#ct-lr"), "150"); ct_highlight_lr(150))
