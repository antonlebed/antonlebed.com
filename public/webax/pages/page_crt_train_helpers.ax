fn on_ct_corrupt() = (
  let w = ct_read_w() in
  if len(w) < 135 then dom_text(dom_query("#ct-corrupt-out"), "Train a model first.")
  else (
    /* Save b-channel weights (ch=3) */
    let b_base = 33 + 3 * 17 in
    mut saved = alloc(17);
    mut j = 0;
    while j < 17 do (set(saved, j, w[b_base + j]); mut j = j + 1);
    /* Corrupt b-channel with heavy noise */
    mut j = 0;
    while j < 17 do (
      set(w, b_base + j, w[b_base + j] + rand(2000) - 1000);
      mut j = j + 1
    );
    /* Check: L detects corruption */
    let nd = ct_data_n() in
    mut detected = 0;
    mut i = 0;
    while i < nd do (
      let l_out = nn_fwd(w, 33 + 4 * 17, 4, ct_data_x0(i), ct_data_x1(i)) in
      mut non_l = 0;
      mut c = 0;
      while c < 6 do (
        if c == 4 then 0
        else (mut non_l = non_l + nn_fwd(w, 33 + c * 17, 4, ct_data_x0(i), ct_data_x1(i)));
        mut c = c + 1
      );
      let avg = non_l / 5 in
      let diff = if l_out > avg then l_out - avg else avg - l_out in
      if diff > 200 then mut detected = detected + 1 else 0;
      mut i = i + 1
    );
    /* Restore b-channel */
    mut j = 0;
    while j < 17 do (set(w, b_base + j, saved[j]); mut j = j + 1);
    ct_write_w(w);
    dom_text(dom_query("#ct-corrupt-out"),
      "mod-49 channel corrupted (+/-1.0 random noise on all 17 weights). mod-11 detected anomaly in ${detected}/${nd} test cases. ${if detected > 0 then "Corruption found!" else "Train more epochs for stronger channel separation."}")
  )
)

/* ===== MODEL EXPORT ===== */
fn on_ct_export() = (
  let w = ct_read_w() in
  if len(w) < 135 then dom_text(dom_query("#ct-export-out"), "No model. Train first.")
  else (
    let nd = ct_data_n() in
    let std_acc = ct_accuracy(w, 0, 8) in
    let kills = ct_read_kills() in
    mut crt_correct = 0;
    mut i = 0;
    while i < nd do (
      let out = ct_crt_fwd(w, ct_data_x0(i), ct_data_x1(i), kills) in
      if (out > 500) == (ct_data_y(i) > 500) then mut crt_correct = crt_correct + 1 else 0;
      mut i = i + 1
    );
    let old_e = ct_parse_csv(dom_value(dom_query("#ct-epoch-n"))) in
    let ep = if len(old_e) > 0 then old_e[0] else 0 in
    let task = ct_task() in
    let task_name = if task == 0 then "XOR" else if task == 1 then "Circle" else if task == 2 then "Spiral" else if task == 3 then "Moons" else "Blobs" in
    dom_text(dom_query("#ct-export-out"),
      "Task: ${task_name} (${nd} pts) | Epoch: ${ep} | Std: ${std_acc}/${nd} | CRT: ${crt_correct}/${nd}\nScale: 1000 (1.0=1000). Layout: std[0..32] (nh=8) + 6xCRT[33..134] (nh=4 each).\n${ct_to_csv(w)}")
  )
)

/* ===== GPU TRAINING ===== */
fn on_ct_gpu_train() = (
  let check = ct_read_w() in
  if len(check) < 135 then on_ct_init() else 0;
  let w = ct_read_w() in
  let nd = ct_data_n() in
  let buf = alloc(135 + nd * 3) in
  mut i = 0;
  while i < 135 do (set(buf, i, w[i]); mut i = i + 1);
  mut i = 0;
  while i < nd do (
    set(buf, 135 + i * 3, ct_data_x0(i));
    set(buf, 135 + i * 3 + 1, ct_data_x1(i));
    set(buf, 135 + i * 3 + 2, ct_data_y(i));
    mut i = i + 1
  );
  gpu_train(buf, nd, ct_get_epc(), ct_get_lr(), dom_query("#ct-gpu-result"))
)

fn on_ct_gpu_done() = (
  let w = ct_read_w() in
  if len(w) >= 135 then (
    let old_e = ct_parse_csv(dom_value(dom_query("#ct-epoch-n"))) in
    let e_n = if len(old_e) > 0 then old_e[0] else 0 in
    dom_text(dom_query("#ct-epoch"), "Epoch: ${e_n}");
    /* Record post-GPU loss + accuracy so curves reflect GPU training */
    let std_l = ct_loss(w, 0, 8) in
    let crt_l = ct_crt_loss(w) in
    let lh = dom_value(dom_query("#ct-loss-hist")) in
    dom_text(dom_query("#ct-loss-hist"),
      if len(lh) == 0 then "${std_l},${crt_l}" else "${lh},${std_l},${crt_l}");
    let std_a = ct_accuracy(w, 0, 8) in
    let crt_a = ct_crt_accuracy(w) in
    let ah = dom_value(dom_query("#ct-acc-hist")) in
    dom_text(dom_query("#ct-acc-hist"),
      if len(ah) == 0 then "${std_a},${crt_a}" else "${ah},${std_a},${crt_a}");
    /* Per-channel losses after GPU training */
    let cl0 = ct_loss(w, 33, 4) in
    let cl1 = ct_loss(w, 50, 4) in
    let cl2 = ct_loss(w, 67, 4) in
    let cl3 = ct_loss(w, 84, 4) in
    let cl4 = ct_loss(w, 101, 4) in
    let cl5 = ct_loss(w, 118, 4) in
    let ch_str = dom_value(dom_query("#ct-ch-loss-hist")) in
    dom_text(dom_query("#ct-ch-loss-hist"),
      if len(ch_str) == 0 then "${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}"
      else "${ch_str},${cl0},${cl1},${cl2},${cl3},${cl4},${cl5}");
    ct_draw_all(w);
    ct_draw_loss_curve();
    ct_draw_acc_curve();
    ct_draw_ch_loss_curve()
  ) else 0
)

/* ===== STYLE HELPERS ===== */
