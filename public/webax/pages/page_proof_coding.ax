  pf_result(s145, "|Aut(Fano)|/84 = D", "${168/84}", if 168/84 == 2 then 1 else 0);

  let p145 = (if 2+3+5==10 then 1 else 0) + (if 2+13+17==32 then 1 else 0) + 1 + (if 3+5+11==19 then 1 else 0) + (if 11+13+17==41 then 1 else 0) + (if 20-11==9 then 1 else 0) + (if 3+5+7==15 then 1 else 0) + (if 3*5*7==105 then 1 else 0) + (if 3+11+13==27 then 1 else 0) + (if 17+5+13==35 then 1 else 0) + (if 17+11+7==35 then 1 else 0) + (if 2+3+17==22 then 1 else 0) + (if 2+5+11==18 then 1 else 0) + (if 2+7+13==22 then 1 else 0) + (if (11+13)/(5+7)==2 then 1 else 0) + (if 5+13==11+7 then 1 else 0) + (if 7*2*6==84 then 1 else 0) + (if 4*3*7==84 then 1 else 0) + (if 168/84==2 then 1 else 0) in
