  pf_result(s146, "lambda = 10*42 = Decality*ANSWER", "${10*42}", if 10*42 == 420 then 1 else 0);

  let p146 = (if 7==7 then 1 else 0) + (if 2*2==4 then 1 else 0) + (if 3==3 then 1 else 0) + (if 4+3==7 then 1 else 0) + (if 2*2*2*2==17-1 then 1 else 0) + (if 2*2*2==8 then 1 else 0) + (if 7*4==4*7 then 1 else 0) + (if 2*3*5==30 then 1 else 0) + (if 2+3+5==10 then 1 else 0) + (if 7+11+13+17==48 then 1 else 0) + (if 2*3*7==42 then 1 else 0) + (if 2+3+7==12 then 1 else 0) + (if 30*17017==510510 then 1 else 0) + (if 42*12155==510510 then 1 else 0) + (if 3==3 then 1 else 0) + (if 42-30==12 then 1 else 0) + (if 42*30==3*420 then 1 else 0) + (if 10*42==420 then 1 else 0) in
