  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT Fountain vs Traditional");
  render_contrast_row(sec3, "Code design", "Raptor: random bipartite graph + LT transform", "CRT: ring structure IS the code. No design.");
  render_contrast_row(sec3, "Overhead", "5-10% encoding overhead", "0% overhead. 7 drops = 7 channels.");
  render_contrast_row(sec3, "Recovery", "Probabilistic (BP decoding)", "Deterministic. CRT guarantees unique solution.");
  render_contrast_row(sec3, "Complexity", "O(k log k) encoding", "O(1) per channel (modular arithmetic)");
  render_contrast_row(sec3, "Patent status", "Qualcomm Raptor/RaptorQ patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   CRT-OFDM -- /demos/ofdm.
   7 CRT channels as orthogonal subcarriers. Phase-shift keying per channel.
   ================================================================ */

fn demo_ofdm_run() = (
  let data = parse_int_from("#dofdm-input") in
  let result_el = dom_query("#dofdm-result") in
  let nn = 214414200 in
  let d = data % nn in
  let c = sig_decompose(d) in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  let total_bits = 27 in /* floor(log2(214414200)) */
  /* Simulate noise: deterministic pseudo-noise per channel.
     d % 10M keeps seed < 1.37B (avoids i32 overflow on d*137). */
  let ns = (d % 10000000) * 137 + 41 in
  let n0 = ns % 3 in let n1 = (ns / 3) % 3 in let n2 = (ns / 9) % 5 in
  let n3 = (ns / 45) % 7 in let n4 = (ns / 315) % 3 in let n5 = (ns / 945) % 3 in
  let n6 = (ns / 2835) % 5 in
  /* Received = (residue + noise) % mod = demodulated constellation point */
  let rx0 = (c[0] + n0) % 8 in let rx1 = (c[1] + n1) % 9 in
  let rx2 = (c[2] + n2) % 25 in let rx3 = (c[3] + n3) % 49 in
  let rx4 = (c[4] + n4) % 11 in let rx5 = (c[5] + n5) % 13 in
  let rx6 = (c[6] + n6) % 17 in
  let recon = sig_recon([rx0, rx1, rx2, rx3, rx4, rx5, rx6]) in
  let e0 = if rx0 == c[0] then 0 else 1 in let e1 = if rx1 == c[1] then 0 else 1 in
  let e2 = if rx2 == c[2] then 0 else 1 in let e3 = if rx3 == c[3] then 0 else 1 in
  let e4 = if rx4 == c[4] then 0 else 1 in let e5 = if rx5 == c[5] then 0 else 1 in
  let e6 = if rx6 == c[6] then 0 else 1 in
  let total_err = e0 + e1 + e2 + e3 + e4 + e5 + e6 in
  let ok = if recon == d then 1 else 0 in
  let rx = [rx0, rx1, rx2, rx3, rx4, rx5, rx6] in
  let errs = [e0, e1, e2, e3, e4, e5, e6] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT-OFDM MODULATION (Z/214,414,200)</p><p style='color:#88ddaa;margin:4px 0'>Data symbol: " + "${d}" + " (" + "${total_bits}" + " bits)</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Tx</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Rx</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Status</th></tr>";
  mut r = 0;
  while r < 7 do (
    let is_data = if r == 0 then 1 else if r == 2 then 1 else if r == 3 then 1 else 0 in
    let ch_color = if is_data == 1 then "#ff6666" else "#88ddaa" in
    let st_color = if errs[r] == 0 then "#44ff88" else "#ff4444" in
    mut html = html + "<tr><td style='padding:3px;color:" + ch_color + ";font-size:12px'>mod " + "${mods[r]}" + "</td><td style='padding:3px;color:#88ddaa;font-size:12px'>" + "${c[r]}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${rx[r]}" + "</td><td style='padding:3px;color:" + st_color + ";font-size:12px'>" + (if errs[r] == 0 then "OK" else "ERR") + "</td></tr>";
    mut r = r + 1
  );
  dom_inner(result_el, html + "</table><p style='color:#ffd700;margin:12px 0 4px'>SPECTRAL EFFICIENCY</p><p style='color:#88ddaa;margin:4px 0'>CRT-OFDM: 27 bits / 7 subcarriers = 3.86 bits/subcarrier</p><p style='color:#b0b0c0;margin:4px 0'>WiFi 802.11a BPSK rate-1/2: 0.50 bits/subcarrier</p><p style='color:#ffd700;margin:4px 0'>Ratio: <b>7.71x</b> spectral efficiency (7-channel TRANS ring vs BPSK)</p><p style='color:" + (if ok == 1 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>Reconstructed: " + "${recon}" + (if ok == 1 then " -- PERFECT" else " -- " + "${total_err}" + " channel error(s)") + "</p></div>")
)

fn page_ofdm() = (
  dom_head_meta("description", "CRT-OFDM Modulation. 7 CRT channels as orthogonal subcarriers. 7.71x spectral efficiency vs WiFi BPSK. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT-OFDM Modulation\",\"description\":\"7-channel orthogonal modulation over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/ofdm\"}");
  let hero = make_hero("CRT-OFDM") in
  let eq = dom_create("div") in
  dom_text(eq, "OFDM patents. CC0 alternative.");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "letterSpacing", "1px");
  dom_style(eq, "marginBottom", "16px");
  dom_append(hero, eq);
  render_p(hero, "CRT approach to OFDM modulation. Each of 7 channels carries an independent PSK constellation: 8-PSK, 9-PSK, 25-PSK, 49-PSK, 11-PSK, 13-PSK, 17-PSK. Theoretical capacity: 27 bits per symbol over 7 subcarriers = 3.86 bits/subcarrier vs WiFi 802.11a BPSK rate-1/2 at 0.50 bits/subcarrier (ideal channel, no noise).");
  dom_append(dom_body(), hero);
  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT-OFDM Principle", "A data symbol d in Z/214,414,200 decomposes into 7 residues. Each residue modulates a subcarrier using p-ary PSK (phase angle = 2*pi*r/m for residue r and modulus m). The receiver demodulates each subcarrier independently (nearest constellation point), then CRT reconstructs the original symbol. Channel independence: noise in one subcarrier cannot corrupt another. 3 data subcarriers + 4 parity subcarriers provide built-in error detection.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 subcarriers", "CRT decomposition", "mod 8, mod 9, mod 25, mod 49, mod 11, mod 13, mod 17 = 7 independent PSK channels.", "");
  render_finding(g1, "7.71x theoretical", "Ideal channel capacity", "27 bits over 7 channels vs BPSK 0.5 bits/channel. No noise model.", "");
  render_finding(g1, "3+4 split", "Data + detection", "3 data subcarriers carry bits. 4 parity subcarriers detect errors.", "");
  render_finding(g1, "Graceful fading", "Independent channels", "If one channel fades, others continue. No catastrophic failure.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Data symbol (0-214414199):", "dofdm-input", "e.g. 42", "Modulate", "demo_ofdm_run", "dofdm-result");
  render_p(sec2, "7 subcarriers show Tx (transmitted residue) vs Rx (received with noise). Red = data channels. Green = parity channels.");
  dom_append(dom_body(), sec2);
  let sec3 = make_section("800px") in
  render_h2(sec3, "CRT-OFDM vs WiFi");
  render_contrast_row(sec3, "Bits per subcarrier", "WiFi BPSK r=1/2: 0.50", "CRT: 3.86 (27 bits / 7 channels)");
  render_contrast_row(sec3, "Ratio", "Baseline", "7.71x theoretical (ideal channel, no noise model)");
  render_contrast_row(sec3, "Error detection", "None built-in (needs CRC-32)", "CRT: invalid values flag errors for free");
  render_contrast_row(sec3, "Channel fading", "Entire signal degrades uniformly", "Independent per-channel fading. Graceful.");
  render_contrast_row(sec3, "Patent status", "WiFi/5G OFDM patents", "CC0. Public domain. Forever.");
  dom_append(dom_body(), sec3)
)

/* ================================================================
   GPU COMPUTE -- dedicated demo page /demos/gpu_compute. CC0 kill S1.
   6 CRT channels as independent compute workgroups.
   f(x) distributes over CRT: compute per-channel, reconstruct once.
   ================================================================ */
