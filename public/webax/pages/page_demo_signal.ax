  dom_on(btn3, "click", "demo_rng_compare");
  dom_append(sec4, btn3);
  let cr = dom_create("div") in
  dom_attr(cr, "id", "drng-compare-result");
  dom_append(sec4, cr);
  dom_append(dom_body(), sec4);
  let sec5 = make_section("800px") in
  render_h2(sec5, "CRT RNG vs Traditional");
  render_contrast_row(sec5, "State size", "Mersenne Twister: 2496 bytes", "CRT RNG: < 8 bytes");
  render_contrast_row(sec5, "Independence", "Single LFSR -- bit correlations", "7 algebraically independent channels");
  render_contrast_row(sec5, "Mixing", "Bit shifts + XOR", "Primitive root multiplication");
  render_contrast_row(sec5, "Period analysis", "Empirical testing", "Provable: Carmichael lambda = 1680");
  render_contrast_row(sec5, "Dependencies", "Library required", "CC0. No imports.");
  dom_append(dom_body(), sec5)
)

/* ================================================================
   CRT COMPRESSION -- /demos/compression.
   CRT channel entropy: 7 small channels < 1 big number.
   ================================================================ */

fn demo_compress_encode(val) = (
  let d = val % 8 in let k = val % 9 in let e = val % 25 in
  let b = val % 49 in let l = val % 11 in let g = val % 13 in
  /* Bits needed: ceil(log2(m)) per channel */
  /* D:3 K:4 E:5 b:6 L:4 G:4 = 26 bits total */
  /* vs raw: ceil(log2(12612600)) = 24 bits (but CRT channels compress STRUCTURE) */
  d * 1000000 + k * 100000 + e * 1000 + b * 100 + l * 10 + g
)

fn demo_compress_bits(m) = (
  if m < 2 then 1
  else if m < 4 then 2
  else if m < 8 then 3
  else if m < 16 then 4
  else if m < 32 then 5
  else if m < 64 then 6
  else 7
)

fn demo_compress_run() = (
  let val = parse_int_from("#dcomp-input") in
  let result_el = dom_query("#dcomp-result") in
  let nn = 214414200 in
  let v = val % nn in
  let c = sig_decompose(v) in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  mut bits_str = "";
  mut total_bits = 0;
  mut bi = 0;
  while bi < 7 do (
    let bv = demo_compress_bits(mods[bi]) in
    mut total_bits = total_bits + bv;
    mut bits_str = bits_str + (if bi > 0 then " " else "") + "mod" + "${mods[bi]}" + "=" + "${bv}";
    mut bi = bi + 1
  );
  mut sparse = 0;
  mut i = 0;
  while i < 1000 do (
    let tv = (v + i) % nn in
    let has_zero = if tv % 8 == 0 then 1 else (if tv % 9 == 0 then 1 else (if tv % 25 == 0 then 1 else (if tv % 49 == 0 then 1 else (if tv % 11 == 0 then 1 else (if tv % 13 == 0 then 1 else (if tv % 17 == 0 then 1 else 0)))))) in
    mut sparse = sparse + has_zero;
    mut i = i + 1
  );
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT COMPRESSION: " + "${v}" + " (Z/214,414,200)</p><p style='color:#88ddaa;margin:4px 0'>CRT = (" + "${c[0]}" + "," + "${c[1]}" + "," + "${c[2]}" + "," + "${c[3]}" + "," + "${c[4]}" + "," + "${c[5]}" + "," + "${c[6]}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>Channel bits: " + bits_str + " = <b>" + "${total_bits}" + " bits</b></p><p style='color:#ffd700;margin:12px 0 4px'>SPARSITY (1000 values from " + "${v}" + ")</p><p style='color:#88ddaa;margin:4px 0'>" + "${sparse}" + "/1000 have at least one zero channel (" + "${sparse / 10}" + "% compressible)</p></div>")
)

fn demo_compress_batch() = (
  let result_el = dom_query("#dcomp-batch-result") in
  let nn = 214414200 in
  mut z0 = 0; mut z1 = 0; mut z2 = 0; mut z3 = 0; mut z4 = 0; mut z5 = 0; mut z6 = 0;
  mut i = 0;
  while i < 10000 do (
    let v = (i * 137 + 42) % nn in
    if v % 8 == 0 then mut z0 = z0 + 1 else 0;
    if v % 9 == 0 then mut z1 = z1 + 1 else 0;
    if v % 25 == 0 then mut z2 = z2 + 1 else 0;
    if v % 49 == 0 then mut z3 = z3 + 1 else 0;
    if v % 11 == 0 then mut z4 = z4 + 1 else 0;
    if v % 13 == 0 then mut z5 = z5 + 1 else 0;
    if v % 17 == 0 then mut z6 = z6 + 1 else 0;
    mut i = i + 1
  );
  let counts = [z0, z1, z2, z3, z4, z5, z6] in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  let expected = [1250, 1111, 400, 204, 909, 769, 588] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CHANNEL ZERO FREQUENCY (10000 samples, Z/214,414,200)</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Zeros</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Expected</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Rate</th></tr>";
  mut r = 0;
  while r < 7 do (
    mut html = html + "<tr><td style='padding:3px;color:#ffd700;font-size:12px'>mod " + "${mods[r]}" + "</td><td style='padding:3px;color:#88ddaa;font-size:12px'>" + "${counts[r]}" + "</td><td style='padding:3px;color:#888;font-size:12px'>" + "${expected[r]}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>1/" + "${mods[r]}" + "</td></tr>";
    mut r = r + 1
  );
  dom_inner(result_el, html + "</table><p style='color:#b0b0c0;margin:8px 0 0;font-size:12px'>Each zero channel = 1 fewer value to transmit. CRT makes sparsity structural.</p></div>")
)

