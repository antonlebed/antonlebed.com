  let sec1 = make_section("800px") in
  render_h2(sec1, "How It Works");
  render_theorem(sec1, "CRT Mixing Principle", "7 channels = 7 independent LCGs coupled by cross-terms. Channel independence (CRT) means local correlations cannot propagate. Reconstruction folds 7 low-dimensional sequences into one high-dimensional orbit. Carmichael period = 1680.");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "7 channels", "CRT decomposition", "Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17. Each has its own primitive root.", "");
  render_finding(g1, "Cross terms", "Nonlinear coupling", "Each channel absorbs neighbors. No channel evolves alone.", "");
  render_finding(g1, "CRT fold", "High-dimensional orbit", "7 small orbits combine to one large orbit over Z/214,414,200.", "");
  render_finding(g1, "State size", "2 ring elements", "Mersenne Twister: 2496 bytes. CRT RNG: < 8 bytes.", "");
  dom_append(dom_body(), sec1);
  let sec2 = make_section("800px") in
  render_h2(sec2, "Try It");
