/* page_demo_signal.ax -- Signal processing demo pages: rng, compression,
   cdma, fountain, ofdm. 7-channel TRANS (Z/214,414,200). */

/* Modular multiply for CRT reconstruction. a small (0-48), bb up to N-1.
   Russian peasant -- avoids i32 overflow with TRANS idempotents. */
fn sig_mulmod(a, bb) = (
  let m = 214414200 in
  mut result = 0; mut aa = a; mut cur = bb % m;
  while aa > 0 do (
    if aa % 2 == 1 then (
      mut result = result + cur;
      if result >= m then mut result = result - m else 0
    ) else 0;
    mut cur = cur + cur;
    if cur >= m then mut cur = cur - m else 0;
    mut aa = aa / 2
  );
  result
)

/* Reduce sum of two values < N to [0, N). */
fn sig_red(x) = (let m = 214414200 in if x >= m then x - m else x)

/* 7-channel CRT reconstruction from residue array. */
fn sig_recon(res) = (
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  let r0 = sig_mulmod(res[0], idem[0]) in
  let r1 = sig_red(r0 + sig_mulmod(res[1], idem[1])) in
  let r2 = sig_red(r1 + sig_mulmod(res[2], idem[2])) in
  let r3 = sig_red(r2 + sig_mulmod(res[3], idem[3])) in
  let r4 = sig_red(r3 + sig_mulmod(res[4], idem[4])) in
  let r5 = sig_red(r4 + sig_mulmod(res[5], idem[5])) in
  sig_red(r5 + sig_mulmod(res[6], idem[6]))
)

/* Decompose a value into 7 CRT channels. */
fn sig_decompose(v) = [v % 8, v % 9, v % 25, v % 49, v % 11, v % 13, v % 17]

/* ================================================================
   CRT RNG -- /demos/rng. 7-channel primitive root mixing.
   ================================================================ */

fn demo_rng_step(s0, s1, i) = (
  let c = sig_decompose(s0) in
  let m0 = (c[0] * 3 + c[4]) % 8 in
  let m1 = (c[1] * 2 + c[0]) % 9 in
  let m2 = (c[2] * 2 + (c[1] * c[3]) % 25) % 25 in
  let m3 = (c[3] * 3 + c[2]) % 49 in
  let m4 = (c[4] * 2 + c[3] + c[0]) % 11 in
  let m5 = (c[5] * 2 + c[4] + c[0]) % 13 in
  let m6 = (c[6] * 3 + c[5] + c[3]) % 17 in
  sig_recon([m0, m1, m2, m3, m4, m5, m6])
)

fn demo_rng_run() = (
  let seed = parse_int_from("#drng-input") in
  let result_el = dom_query("#drng-result") in
  let nn = 214414200 in
  if seed < 1 then dom_inner(result_el, "<p style='color:#ff6666'>Enter a positive seed.</p>")
  else (
    mut s0 = (seed * 137 + 1) % nn;
    mut s1 = (seed * 42 + 7) % nn;
    mut nums = "";
    mut first_out = 0;
    mut i = 0;
    while i < 20 do (
      let out = demo_rng_step(s0, s1, i) in
      mut s1 = (s1 * 137 + out) % nn;
      mut s0 = (s0 + s1 + i * 7) % nn;
      if i == 0 then mut first_out = out else 0;
      mut nums = nums + (if i > 0 then ", " else "") + "${out}";
      mut i = i + 1
    );
    let fc = sig_decompose(first_out) in
    dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT RNG (seed = " + "${seed}" + ", Z/214,414,200)</p><p style='margin:4px 0;color:#b0b0c0;font-size:13px;word-break:break-all'>" + nums + "</p><p style='margin:8px 0 4px;color:#b0b0c0'>First output CRT: (" + "${fc[0]}" + "," + "${fc[1]}" + "," + "${fc[2]}" + "," + "${fc[3]}" + "," + "${fc[4]}" + "," + "${fc[5]}" + "," + "${fc[6]}" + ")</p></div>")
  )
)

fn demo_rng_compare() = (
  let result_el = dom_query("#drng-compare-result") in
  let nn = 214414200 in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>SEED COMPARISON: first 5 outputs from seeds 1-5</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>Seed</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>out[0]</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>out[1]</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>out[2]</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>out[3]</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:12px'>out[4]</th></tr>";
  mut seed = 1;
  while seed < 6 do (
    mut s0 = (seed * 137 + 1) % nn;
    mut s1 = (seed * 42 + 7) % nn;
    mut html = html + "<tr><td style='padding:3px;color:#ffd700;font-size:12px'>" + "${seed}" + "</td>";
    mut j = 0;
    while j < 5 do (
      let out = demo_rng_step(s0, s1, j) in
      mut s1 = (s1 * 137 + out) % nn;
      mut s0 = (s0 + s1 + j * 7) % nn;
      mut html = html + "<td style='padding:3px;color:#b0b0c0;font-size:11px'>" + "${out}" + "</td>";
      mut j = j + 1
    );
    mut html = html + "</tr>";
    mut seed = seed + 1
  );
  dom_inner(result_el, html + "</table></div>")
)

