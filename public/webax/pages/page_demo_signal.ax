  dom_head_meta("description", "CRT Fountain Codes. 7-channel erasure coding over Z/214,414,200. Lose any 1 channel, recover from 6. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"CRT Fountain Codes\",\"description\":\"7-channel erasure coding over Z/214414200. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/fountain\"}");
