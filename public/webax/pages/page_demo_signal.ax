)

/* ================================================================
   CRT FOUNTAIN CODES -- /demos/fountain.
   Each CRT channel = one drop. Lose any channel, reconstruct from rest.
   7-channel TRANS ring: lose 1, recover from 6.
   ================================================================ */

/* TRANS idempotent for channel index. */
fn ftn_idem(ch) = (
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  idem[ch]
)

/* CRT reconstruct from 6 drops, skipping channel `skip`. Uses sig_mulmod. */
fn ftn_recon6(res, skip) = (
  let idem = [187612425, 190590400, 60035976, 109395000, 116953200, 16493400, 176576400] in
  mut result = 0;
  mut ch = 0;
  while ch < 7 do (
    if ch == skip then 0
    else (
      let term = sig_mulmod(res[ch], idem[ch]) in
      mut result = sig_red(result + term)
    );
    mut ch = ch + 1
  );
  result
)

fn demo_fountain_run() = (
  let n = parse_int_from("#dftn-input") in
  let drop = parse_int_from("#dftn-drop") in
  let result_el = dom_query("#dftn-result") in
  let nn = 214414200 in
  let v = n % nn in
  let res = sig_decompose(v) in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  let skip = drop % 7 in
  /* Reconstruct from 6 drops */
  let partial = ftn_recon6(res, skip) in
  /* Try all possible values for the missing channel */
  mut found = 0 - 1;
  mut trial = 0;
  while trial < mods[skip] do (
    let candidate = sig_red(partial + sig_mulmod(trial, ftn_idem(skip))) in
    let ok_0 = if skip == 0 then 1 else if candidate % 8 == res[0] then 1 else 0 in
    let ok_1 = if skip == 1 then 1 else if candidate % 9 == res[1] then 1 else 0 in
    let ok_2 = if skip == 2 then 1 else if candidate % 25 == res[2] then 1 else 0 in
    let ok_3 = if skip == 3 then 1 else if candidate % 49 == res[3] then 1 else 0 in
    let ok_4 = if skip == 4 then 1 else if candidate % 11 == res[4] then 1 else 0 in
    let ok_5 = if skip == 5 then 1 else if candidate % 13 == res[5] then 1 else 0 in
    let ok_6 = if skip == 6 then 1 else if candidate % 17 == res[6] then 1 else 0 in
    if ok_0 + ok_1 + ok_2 + ok_3 + ok_4 + ok_5 + ok_6 == 7 then
      (if found < 0 then mut found = candidate else 0)
    else 0;
    mut trial = trial + 1
  );
  let recovered = if found < 0 then 0 else found in
  let ok = if recovered == v then 1 else 0 in
  let is_data = if skip == 0 then 1 else if skip == 2 then 1 else if skip == 3 then 1 else 0 in
  dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT FOUNTAIN CODE (Z/214,414,200)</p><p style='color:#88ddaa;margin:4px 0'>Value: " + "${v}" + "</p><p style='color:#b0b0c0;margin:4px 0'>7 drops: (" + "${res[0]}" + "," + "${res[1]}" + "," + "${res[2]}" + "," + "${res[3]}" + "," + "${res[4]}" + "," + "${res[5]}" + "," + "${res[6]}" + ")</p><p style='color:#ffd700;margin:12px 0 4px'>LOST: mod-" + "${mods[skip]}" + " channel (" + (if is_data == 1 then "data" else "parity") + " per 3+4 split)</p><p style='color:#88ddaa;margin:4px 0'>6 drops received. Missing channel reconstructed by CRT trial.</p><p style='color:" + (if ok == 1 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>Recovered: " + "${recovered}" + (if ok == 1 then " -- PERFECT RECOVERY" else " -- MISMATCH") + "</p></div>")
)

fn demo_fountain_batch() = (
  let result_el = dom_query("#dftn-batch-result") in
  let nn = 214414200 in
  let mods = [8, 9, 25, 49, 11, 13, 17] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>BATCH ERASURE TEST: 50 values x 7 channel drops</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Lost Channel</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Type</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Recovered</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Rate</th></tr>";
  mut skip = 0;
  while skip < 7 do (
    mut ok_count = 0;
    mut i = 0;
    while i < 50 do (
      let v = (i * 137 + i * i * 41 + 7) % nn in
      let res = sig_decompose(v) in
      let partial = ftn_recon6(res, skip) in
      mut found = 0 - 1;
      mut trial = 0;
      while trial < mods[skip] do (
        let candidate = sig_red(partial + sig_mulmod(trial, ftn_idem(skip))) in
        let ok_0 = if skip == 0 then 1 else if candidate % 8 == res[0] then 1 else 0 in
        let ok_1 = if skip == 1 then 1 else if candidate % 9 == res[1] then 1 else 0 in
        let ok_2 = if skip == 2 then 1 else if candidate % 25 == res[2] then 1 else 0 in
        let ok_3 = if skip == 3 then 1 else if candidate % 49 == res[3] then 1 else 0 in
        let ok_4 = if skip == 4 then 1 else if candidate % 11 == res[4] then 1 else 0 in
        let ok_5 = if skip == 5 then 1 else if candidate % 13 == res[5] then 1 else 0 in
        let ok_6 = if skip == 6 then 1 else if candidate % 17 == res[6] then 1 else 0 in
        if ok_0 + ok_1 + ok_2 + ok_3 + ok_4 + ok_5 + ok_6 == 7 then
          (if found < 0 then mut found = candidate else 0)
        else 0;
        mut trial = trial + 1
      );
      if found == v then mut ok_count = ok_count + 1 else 0;
      mut i = i + 1
    );
    let is_data = if skip == 0 then 1 else if skip == 2 then 1 else if skip == 3 then 1 else 0 in
    let color = if ok_count == 50 then "#44ff88" else "#ff8844" in
    let type_color = if is_data == 1 then "#ff6666" else "#88ddaa" in
    mut html = html + "<tr><td style='padding:4px;color:#ffd700;font-size:13px'>mod " + "${mods[skip]}" + "</td><td style='padding:4px;color:" + type_color + ";font-size:13px'>" + (if is_data == 1 then "data" else "parity") + "</td><td style='padding:4px;color:" + color + ";font-size:13px;font-weight:bold'>" + "${ok_count}" + "/50</td><td style='padding:4px;color:" + color + ";font-size:13px'>" + "${ok_count * 2}" + "%</td></tr>";
    mut skip = skip + 1
  );
  dom_inner(result_el, html + "</table><p style='color:#b0b0c0;font-size:12px;margin:8px 0'>CRT guarantees: any 6 of 7 drops fully reconstruct the original value. The ring structure IS the erasure code. No Luby transform. No graph codes. Pure algebra.</p></div>")
)

