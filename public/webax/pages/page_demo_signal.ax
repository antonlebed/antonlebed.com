/* ================================================================
   CRT SPREAD SPECTRUM / CDMA -- /demos/cdma.
   Multiple users share one channel. CRT separates them algebraically.
   ================================================================ */

/* Check if k is coprime to N=214414200 (not divisible by 2,3,5,7,11,13,17) */
fn cdma_is_coprime(k) = (
  if k % 2 == 0 then 0
  else if k % 3 == 0 then 0
  else if k % 5 == 0 then 0
  else if k % 7 == 0 then 0
  else if k % 11 == 0 then 0
  else if k % 13 == 0 then 0
  else if k % 17 == 0 then 0
  else 1
)

/* Modular inverse via extended Euclidean (simplified for small moduli) */
fn cdma_modinv(a, m) = (
  mut inv = 1;
  mut i = 1;
  while i < m do (
    if (a * i) % m == 1 then mut inv = i else 0;
    mut i = i + 1
  );
  inv
)

fn demo_cdma_run() = (
  let key = parse_int_from("#dcdma-key") in
  let data = parse_int_from("#dcdma-data") in
  let result_el = dom_query("#dcdma-result") in
  let nn = 214414200 in
  if key < 2 then dom_inner(result_el, "<p style='color:#ff6666'>Spreading key must be >= 2.</p>")
  else if cdma_is_coprime(key) == 0 then
    dom_inner(result_el, "<p style='color:#ff6666'>Key " + "${key}" + " is NOT coprime to 214,414,200. Try a prime > 17.</p>")
  else (
    let d = data % nn in
    let dc = sig_decompose(d) in
    /* Encode: per-channel residue * (key % mod) % mod -- avoids i32 overflow */
    let e0 = (dc[0] * (key % 8)) % 8 in
    let e1 = (dc[1] * (key % 9)) % 9 in
    let e2 = (dc[2] * (key % 25)) % 25 in
    let e3 = (dc[3] * (key % 49)) % 49 in
    let e4 = (dc[4] * (key % 11)) % 11 in
    let e5 = (dc[5] * (key % 13)) % 13 in
    let e6 = (dc[6] * (key % 17)) % 17 in
    /* Decode: spread * key^(-1) mod m per channel */
    let i0 = cdma_modinv(key % 8, 8) in
    let i1 = cdma_modinv(key % 9, 9) in
    let i2 = cdma_modinv(key % 25, 25) in
    let i3 = cdma_modinv(key % 49, 49) in
    let i4 = cdma_modinv(key % 11, 11) in
    let i5 = cdma_modinv(key % 13, 13) in
    let i6 = cdma_modinv(key % 17, 17) in
    let r0 = (e0 * i0) % 8 in
    let r1 = (e1 * i1) % 9 in
    let r2 = (e2 * i2) % 25 in
    let r3 = (e3 * i3) % 49 in
    let r4 = (e4 * i4) % 11 in
    let r5 = (e5 * i5) % 13 in
    let r6 = (e6 * i6) % 17 in
    let decoded = sig_recon([r0, r1, r2, r3, r4, r5, r6]) in
    let ok = if decoded == d then 1 else 0 in
    dom_inner(result_el, "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>CRT SPREAD SPECTRUM (Z/214,414,200)</p><p style='color:#b0b0c0;margin:4px 0'>Data: " + "${d}" + " = (" + "${dc[0]}" + "," + "${dc[1]}" + "," + "${dc[2]}" + "," + "${dc[3]}" + "," + "${dc[4]}" + "," + "${dc[5]}" + "," + "${dc[6]}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>Key: " + "${key}" + " (coprime to N)</p><p style='color:#ffd700;margin:8px 0 4px'>ENCODE: per-channel residue * key mod m</p><p style='color:#88ddaa;margin:4px 0'>Spread: (" + "${e0}" + "," + "${e1}" + "," + "${e2}" + "," + "${e3}" + "," + "${e4}" + "," + "${e5}" + "," + "${e6}" + ")</p><p style='color:#ffd700;margin:8px 0 4px'>DECODE: per-channel key^(-1)</p><p style='color:#b0b0c0;margin:4px 0'>Inverses: (" + "${i0}" + "," + "${i1}" + "," + "${i2}" + "," + "${i3}" + "," + "${i4}" + "," + "${i5}" + "," + "${i6}" + ")</p><p style='color:#88ddaa;margin:4px 0'>Despread: (" + "${r0}" + "," + "${r1}" + "," + "${r2}" + "," + "${r3}" + "," + "${r4}" + "," + "${r5}" + "," + "${r6}" + ")</p><p style='color:" + (if ok == 1 then "#44ff88" else "#ff4444") + ";font-size:16px;margin:8px 0'>Recovered: " + "${decoded}" + (if ok == 1 then " -- PERFECT RECOVERY" else " -- MISMATCH") + "</p></div>")
  )
)

/* Per-channel spread: data * key in each CRT channel (avoids i32 overflow). */
fn cdma_spread_ch(d, k) = (
  let dc = sig_decompose(d) in
  let e0 = (dc[0] * (k % 8)) % 8 in
  let e1 = (dc[1] * (k % 9)) % 9 in
  let e2 = (dc[2] * (k % 25)) % 25 in
  let e3 = (dc[3] * (k % 49)) % 49 in
  let e4 = (dc[4] * (k % 11)) % 11 in
  let e5 = (dc[5] * (k % 13)) % 13 in
  let e6 = (dc[6] * (k % 17)) % 17 in
  sig_recon([e0, e1, e2, e3, e4, e5, e6])
)

/* Per-channel spread + despread: returns recovered value. */
fn cdma_recover(d, k) = (
  let dc = sig_decompose(d) in
  let e0 = (dc[0] * (k % 8)) % 8 in
  let e1 = (dc[1] * (k % 9)) % 9 in
  let e2 = (dc[2] * (k % 25)) % 25 in
  let e3 = (dc[3] * (k % 49)) % 49 in
  let e4 = (dc[4] * (k % 11)) % 11 in
  let e5 = (dc[5] * (k % 13)) % 13 in
  let e6 = (dc[6] * (k % 17)) % 17 in
  let r0 = (e0 * cdma_modinv(k % 8, 8)) % 8 in
  let r1 = (e1 * cdma_modinv(k % 9, 9)) % 9 in
  let r2 = (e2 * cdma_modinv(k % 25, 25)) % 25 in
  let r3 = (e3 * cdma_modinv(k % 49, 49)) % 49 in
  let r4 = (e4 * cdma_modinv(k % 11, 11)) % 11 in
  let r5 = (e5 * cdma_modinv(k % 13, 13)) % 13 in
  let r6 = (e6 * cdma_modinv(k % 17, 17)) % 17 in
  sig_recon([r0, r1, r2, r3, r4, r5, r6])
)

fn demo_cdma_multi() = (
  let result_el = dom_query("#dcdma-multi-result") in
  let nn = 214414200 in
  /* 7 users, each with unique coprime key (all primes > 17) */
  let keys = [19, 23, 29, 31, 37, 41, 43] in
  let data = [42, 137, 490, 1576576, 420, 61, 1680] in
  mut html = "<div style='background:#0a0a18;border:1px solid #333;border-radius:8px;padding:16px;margin:8px 0'><p style='color:#ffd700;margin:0 0 8px'>MULTI-USER CRT CDMA: 7 users share one channel (Z/214,414,200)</p><table style='width:100%;border-collapse:collapse;table-layout:fixed;word-wrap:break-word'><tr style='border-bottom:1px solid #333'><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>User</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Key</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Data</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Spread</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Recovered</th><th style='text-align:left;padding:4px;color:#ffd700;font-size:11px'>Status</th></tr>";
  mut channel_sum = 0;
  mut u = 0;
  while u < 7 do (
    let spread = cdma_spread_ch(data[u] % nn, keys[u]) in
    mut channel_sum = (channel_sum + spread) % nn;
    mut u = u + 1
  );
  mut u2 = 0;
  mut all_ok = 0;
  while u2 < 7 do (
    let k = keys[u2] in
    let d = data[u2] % nn in
    let spread = cdma_spread_ch(d, k) in
    let rec = cdma_recover(d, k) in
    let ok = if rec == d then 1 else 0 in
    mut all_ok = all_ok + ok;
    let color = if ok == 1 then "#44ff88" else "#ff4444" in
    mut html = html + "<tr><td style='padding:3px;color:#ffd700;font-size:12px'>U" + "${u2}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${k}" + "</td><td style='padding:3px;color:#b0b0c0;font-size:12px'>" + "${d}" + "</td><td style='padding:3px;color:#888;font-size:11px'>" + "${spread}" + "</td><td style='padding:3px;color:" + color + ";font-size:11px'>" + "${rec}" + "</td><td style='padding:3px;color:" + color + ";font-size:12px'>" + (if ok == 1 then "OK" else "FAIL") + "</td></tr>";
    mut u2 = u2 + 1
  );
  dom_inner(result_el, html + "</table><p style='color:" + (if all_ok == 7 then "#44ff88" else "#ff4444") + ";font-size:14px;margin:8px 0'>" + "${all_ok}" + "/7 users recovered perfectly</p><p style='color:#b0b0c0;font-size:12px;margin:4px 0'>Channel superposition: " + "${channel_sum}" + ". Each user despreads with their unique key. CRT independence = algebraic orthogonality.</p><p style='color:#b0b0c0;font-size:12px;margin:4px 0'>Capacity: phi(214,414,200) = 38,707,200 simultaneous users. No Walsh codes. No code assignment authority.</p></div>")
)

