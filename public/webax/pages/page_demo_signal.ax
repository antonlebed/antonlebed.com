  render_h2(sec2, "Try It");
  make_interactive_widget(sec2, "Value (0-214414199):", "dftn-input", "e.g. 42", "Drop & Recover", "demo_fountain_run", "dftn-result");
  let extras = dom_create("div") in
  dom_style(extras, "display", "flex");
