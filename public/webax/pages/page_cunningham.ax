/* pages_teach.ax -- TEACH: NTT theorem pages.
   Z/2310Z. The WHY behind the what. 20 pages.
   NTT DOMAIN PAGES -- Number Theory Topics (Z/2310Z Teach tier)
   19 pages, domain_hero template.
   ================================================================ */

/* Cunningham chain tracer callback */
fn cc_step(n) = 2 * n + 1

fn cunningham_trace() = (
  let seed = parse_int_from("#cc-input") in
  let result = dom_query("#cc-result") in
  if seed == 0 then dom_inner(result, "<p style='color:#ff6666'>Enter a positive seed.</p>")
  else (
    /* Trace chain: compute up to 8 steps */
    let c1 = cc_step(seed) in
    let p1 = is_prime_trial(c1) in
    let c2 = cc_step(c1) in
    let p2 = if p1 > 0 then is_prime_trial(c2) else 0 in
    let c3 = cc_step(c2) in
    let p3 = if p2 > 0 then is_prime_trial(c3) else 0 in
    let c4 = cc_step(c3) in
    let p4 = if p3 > 0 then is_prime_trial(c4) else 0 in
    let c5 = cc_step(c4) in
    let p5 = if p4 > 0 then is_prime_trial(c5) else 0 in
    let c6 = cc_step(c5) in
    let p6 = if p5 > 0 then is_prime_trial(c6) else 0 in
    let steps = p1 + p2 + p3 + p4 + p5 + p6 in
    /* Build chain display */
    let chain = "${seed}" +
      (if p1 > 0 then " -> <b style='color:#ffd700'>" + "${c1}" + "</b>" else " -> " + "${c1}" + " (stop)") +
      (if p2 > 0 then " -> <b style='color:#ffd700'>" + "${c2}" + "</b>" else if p1 > 0 then " -> " + "${c2}" + " (stop)" else "") +
      (if p3 > 0 then " -> <b style='color:#ffd700'>" + "${c3}" + "</b>" else if p2 > 0 then " -> " + "${c3}" + " (stop)" else "") +
      (if p4 > 0 then " -> <b style='color:#ffd700'>" + "${c4}" + "</b>" else if p3 > 0 then " -> " + "${c4}" + " (stop)" else "") +
      (if p5 > 0 then " -> <b style='color:#ffd700'>" + "${c5}" + "</b>" else if p4 > 0 then " -> " + "${c5}" + " (stop)" else "") +
      (if p6 > 0 then " -> <b style='color:#ffd700'>" + "${c6}" + "</b>" else if p5 > 0 then " -> " + "${c6}" + " (stop)" else "") in
    let note = if steps == 0 then "c(" + "${seed}" + ") = " + "${c1}" + " is composite. No chain."
      else if steps == 1 then "Length 1"
      else if steps == 2 then "Length 2"
      else if steps == 3 then "Length 3 -- same as CC1(1)!"
      else if steps == 5 then "Length 5 -- same as CC1(2)!"
      else "Length " + "${steps}" in
    dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'>" + chain + "</p><p style='color:#ffd700;margin:4px 0'>" + note + "</p>")
  )
)

fn page_cunningham() = (
  dom_head_meta("description", "Two Cunningham chains from seeds 1 and 2 generate the first five primes of Z/2310. c(2*3)=13 closes the boundary. Shadow function s(p)=(p-1)/2 recovers the chain. Mersenne identity c^n(0)=2^n-1. Stopper theorem: ord_p(2) all smooth in {2,3,5}, NR-QR=17. The seven axiom primes {2..17} are the unique optimal sieve among all 6435 subsets; Euler product captures 98.7% of zeta(2).");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Cunningham Chains\",\"description\":\"Two Cunningham chains from seeds 1 and 2 generate five primes of Z/2310. c(2*3)=13 closes the boundary. Stopper theorem: multiplicative orders of 2 mod these primes are all smooth in {2,3,5} with NR-QR=17.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/theory/cunningham\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Cunningham chains\"},{\"@type\":\"DefinedTerm\",\"name\":\"prime chains\"},{\"@type\":\"DefinedTerm\",\"name\":\"prime generation\"},{\"@type\":\"DefinedTerm\",\"name\":\"multiplicative order\"}]}");
  /* === HERO === */
  let hero = make_hero("The Two Chains") in
  let big = dom_create("div") in
  dom_text(big, "c(n) = 2n + 1");
  ct_mono(big);
  dom_style(big, "fontSize", "36px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "2px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The Cunningham map c(n) = 2n+1 doubles and adds one. Starting from seeds 1 and 2, this single map generates all four odd primes of Z/2,310: {3, 5, 7, 11}. Then c(2*3) = 13 closes the boundary. Five prime factors, two seeds, one map.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE TWO CHAINS === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Two Cunningham Chains");
  render_p(sec1, "A Cunningham chain of the first kind starts from a seed and repeatedly applies c(n) = 2n+1, continuing as long as each result is prime:");
  let g1 = make_findings_grid(sec1) in
  render_finding(g1, "CC1(1)", "1 -> 3 -> 7 -> STOP", "Length = 3. Stops at 15 = 3*5. Elements: {1, 3, 7}.", "");
  render_finding(g1, "CC1(2)", "2 -> 5 -> 11 -> 23 -> 47 -> STOP", "Length = 5. Stops at 95 = 5*19. Elements: {2, 5, 11, 23, 47}.", "");
  render_p(sec1, "Interleaved by size: 1, 2, 3, 5, 7, 11. The two chains alternate perfectly. Every prime of Z/2,310 except 2 is generated by exactly one chain.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CROSS-CHAIN DUALITY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Cross-Chain Duality");
  render_theorem(sec2, "Cross-Reference Theorem (PROVED)", "Each chain's first output names the other chain's length. CC1(1) produces 3 at step 1, and |CC1(2)| = 5 at step 1 of CC1(2). Reciprocally: |CC1(1)| = 3. The two seeds define each other.");
  render_p(sec2, "Both chains stop when their OWN products appear. CC1(1) stops at 3*5 = 15. CC1(2) stops at 5*19 = 95 -- 5 appears again. 5 is the universal stopper. The shadow chain breaks at 13 where s(13) = 6 = 2*3 = composite.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: SHADOW FUNCTION === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Shadow Function");
  render_p(sec3, "The inverse of Cunningham: s(p) = (p-1)/2. Each prime shadows its predecessor:");
  let stbl = dom_create("table") in
  dom_style(stbl, "width", "100%");
  dom_style(stbl, "maxWidth", "700px");
  dom_style(stbl, "margin", "24px auto");
  dom_style(stbl, "borderCollapse", "collapse");
  let shdr = dom_create("tr") in
  render_th(shdr, "Prime p");
  render_th(shdr, "s(p) = (p-1)/2");
  render_th(shdr, "Shadow");
  render_th(shdr, "Status");
  dom_append(stbl, shdr);
  render_table_row_4(stbl, "3", "1", "1", "Prime/unit");
  render_table_row_4(stbl, "5", "2", "2", "Prime");
  render_table_row_4(stbl, "7", "3", "3", "Prime");
  render_table_row_4(stbl, "11", "5", "5", "Prime");
  render_table_row_4(stbl, "13", "6 = 2*3", "COMPOSITE", "CHAIN BREAKS");
  dom_append(sec3, stbl);
  render_p(sec3, "The primes {2,3,5,7,11} are the longest initial prime segment where all shadows are prime or 1. At p=13, the shadow is 6 = 2*3 = composite. The chain breaks. Only 7 of 78,498 primes below 10^6 appear in shadow trees (0.009%). 5 divides 38.9% of CC1 stopping values (expected 20%, 1.95x enrichment).");
  dom_append(dom_body(), sec3);

  /* === SEC 4: (p-1) LADDER === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "The (p-1) Ladder");
  render_p(sec4, "Every prime minus one equals 2 times its predecessor in the chain:");
  let ltbl = dom_create("table") in
  dom_style(ltbl, "width", "100%");
  dom_style(ltbl, "maxWidth", "700px");
  dom_style(ltbl, "margin", "24px auto");
  dom_style(ltbl, "borderCollapse", "collapse");
  let lhdr = dom_create("tr") in
  render_th(lhdr, "Prime");
  render_th(lhdr, "p - 1");
  render_th(lhdr, "= 2 * ?");
  dom_append(ltbl, lhdr);
  render_table_row(ltbl, "3", "2", "2");
  render_table_row(ltbl, "5", "4", "2^2");
  render_table_row(ltbl, "7", "6", "2*3");
  render_table_row(ltbl, "11", "10", "2*5");
  dom_append(sec4, ltbl);
  render_theorem(sec4, "2-Generation Uniqueness (PROVED)", "Of 15 possible products p*q+1 where p,q are primes of Z/2,310, only 2*{2,3,5}+1 = {5,7,11} are primes in the set. 2 is the sole generator. No other prime creates primes of Z/2,310 this way.");
  dom_append(dom_body(), sec4);

  /* === SEC 4b: THE SUM IDENTITY === */
  let sec4b = make_section("800px") in
  render_h2(sec4b, "The Sum Identity");
  render_p(sec4b, "Why does the (p-1) column sum to 23 = CC1(2) at step 3? Four routes to the same number:");
  let stbl2 = dom_create("table") in
  dom_style(stbl2, "width", "100%");
  dom_style(stbl2, "maxWidth", "700px");
  dom_style(stbl2, "margin", "24px auto");
  dom_style(stbl2, "borderCollapse", "collapse");
  let sh2 = dom_create("tr") in
  render_th(sh2, "Expression");
  render_th(sh2, "Value");
  render_th(sh2, "Reading");
  dom_append(stbl2, sh2);
  render_table_row(stbl2, "c(11) = 2*11+1", "23", "Cunningham of 11");
  render_table_row(stbl2, "sum(p-1)", "23", "Neighborhood sum");
  render_table_row(stbl2, "2^2*3 + 11", "12 + 11", "12 = 2^2*3 plus 11");
  render_table_row(stbl2, "2+3+7+11", "2+3+7+11", "Sum without 5");
  dom_append(sec4b, stbl2);
  render_theorem(sec4b, "Neighborhood Sum Theorem (PROVED)", "sum(p-1) for primes {2,3,5,7,11} = c(11) = 23. Proof: sum(p) = 2+3+5+7+11 = 28. Subtract count = 5. Get 23. This equals c(11) because 3+7 = 2*5 = 10. Equivalently: 3+7 = (2-1)(11-1). The four primes other than 5 sum to 2*11+1 = c(11).");
  render_p(sec4b, "5 removes itself: sum(p-1) = sum(p) - 5. Everything minus 5 reveals the Cunningham chain. Dually: sum(p+1) = sum(p) + 5 = 28+5 = 33 = 3*11. The gap between the two sums = 2*5 = 10 = 5 seen from both sides.");
  dom_append(dom_body(), sec4b);

  /* === SEC 4c: SHADOW SUM === */
  let sec4c = make_section("800px") in
  render_h2(sec4c, "The Shadow Sum");
  render_p(sec4c, "The shadow function s(p) = (p-1)/2 maps each odd prime to its predecessor:");
  render_p(sec4c, "s(3)=1, s(5)=2, s(7)=3, s(11)=5. Sum of shadows = 1+2+3+5 = 11.");
  render_theorem(sec4c, "Shadow Sum Theorem (PROVED)", "The shadows of the four odd primes {3,5,7,11} sum to 11. Therefore sum(p-1 for odd primes) = 2*11 = 22. Adding (2-1)=1 for p=2: total = 2*11 + 1 = c(11) = 23.");
  render_p(sec4c, "Products tell the same story. Product(p-1) = 1*2*4*6*10 = 480 = 2^5*3*5. Product(p+1) = 3*4*6*8*12 = 6912 = 2^8*3^3. The neighborhoods are built from the same primes.");
  dom_append(dom_body(), sec4c);

  /* === SEC 5: MIRROR LAW === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Mirror Law");
  render_theorem(sec5, "Mirror Law Theorem (PROVED)", "c(p) = 2p+1, so 2p = c(p)-1. Therefore 2*p = -1 (mod c(p)). Each new prime is born as the MIRROR of 2 times its predecessor. The Cunningham map IS the mirror operator.");
  let mtbl = dom_create("table") in
  dom_style(mtbl, "width", "100%");
  dom_style(mtbl, "maxWidth", "700px");
  dom_style(mtbl, "margin", "24px auto");
  dom_style(mtbl, "borderCollapse", "collapse");
  let mhdr = dom_create("tr") in
  render_th(mhdr, "Product");
  render_th(mhdr, "Value");
  render_th(mhdr, "mod c(p)");
  render_th(mhdr, "Mirror");
  dom_append(mtbl, mhdr);
  render_table_row_4(mtbl, "2*2 = 2^2", "4", "mod 5", "4 = -1 (mod 5)");
  render_table_row_4(mtbl, "2*3", "6", "mod 7", "6 = -1 (mod 7)");
  render_table_row_4(mtbl, "2*5", "10", "mod 11", "10 = -1 (mod 11)");
  dom_append(sec5, mtbl);
  render_p(sec5, "Mirror preservation: 210-1 = 209 and 420-1 = 419 both satisfy 2p = -1 (mod c(p)) across all four odd primes. The ring's key values carry the mirror law in their structure.");
  dom_append(dom_body(), sec5);

  /* === SEC 6: CUNNINGHAM-MERSENNE === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Cunningham-Mersenne Identity");
  render_theorem(sec6, "Mersenne Connection (PROVED)", "c^n(0) = 2^n - 1 = M(n) for all n >= 1. The Cunningham map applied to void generates Mersenne numbers. Proof by induction: c(0)=1=M(1). If c^k(0) = 2^k-1, then c^(k+1)(0) = 2*(2^k-1)+1 = 2^(k+1)-1 = M(k+1).");
  render_p(sec6, "Mersenne exponents n where M(n) is smooth in {2,3,5,7,11} are ONLY n in {1, 2, 3, 4, 6}:");
  let xtbl = dom_create("table") in
  dom_style(xtbl, "width", "100%");
  dom_style(xtbl, "maxWidth", "700px");
  dom_style(xtbl, "margin", "24px auto");
  dom_style(xtbl, "borderCollapse", "collapse");
  let xhdr = dom_create("tr") in
  render_th(xhdr, "n");
  render_th(xhdr, "M(n) = 2^n - 1");
  render_th(xhdr, "Factorization");
  dom_append(xtbl, xhdr);
  render_table_row(xtbl, "1", "1", "1 (unit)");
  render_table_row(xtbl, "2", "3", "3 (prime)");
  render_table_row(xtbl, "3", "7", "7 (prime)");
  render_table_row(xtbl, "4", "15", "3*5");
  render_table_row(xtbl, "5", "31", "NOT SMOOTH (31 is outside {2,3,5,7,11})");
  render_table_row(xtbl, "6", "63", "3^2*7");
  render_table_row(xtbl, "12", "4095", "Contains 13 -- boundary enters");
  dom_append(sec6, xtbl);
  render_p(sec6, "The smooth exponents {1,2,3,4,6} are exactly the proper divisors of lambda(Z/210) = 2^2*3 = 12. The Cunningham chain, the Mersenne numbers, and the ring's lambda function are the same object seen from different angles.");
  dom_append(dom_body(), sec6);

  /* === SEC 6b: THE SMOOTHNESS BOUNDARY === */
  let sec6b = make_section("800px") in
  render_h2(sec6b, "The Smoothness Boundary");
  render_p(sec6b, "For each prime p, consider p^2 - 1 = (p-1)(p+1). For primes of Z/2,310, this product is always 11-smooth (all factors in {2,3,5,7,11}). How far does this pattern extend?");
  let btbl = dom_create("table") in
  dom_style(btbl, "width", "100%");
  dom_style(btbl, "maxWidth", "700px");
  dom_style(btbl, "margin", "24px auto");
  dom_style(btbl, "borderCollapse", "collapse");
  let bhdr = dom_create("tr") in
  render_th(bhdr, "p");
  render_th(bhdr, "p^2-1");
  render_th(bhdr, "Smooth?");
  render_th(bhdr, "Note");
  dom_append(btbl, bhdr);
  render_table_row_4(btbl, "2", "3", "YES", "prime");
  render_table_row_4(btbl, "3", "8 = 2^3", "YES", "");
  render_table_row_4(btbl, "5", "24 = 2^3*3", "YES", "= 4!");
  render_table_row_4(btbl, "7", "48 = 2^4*3", "YES", "= phi(Z/210)");
  render_table_row_4(btbl, "11", "120 = 2^3*3*5", "YES", "= 5!");
  render_table_row_4(btbl, "13", "168 = 2^3*3*7", "YES", "= |PSL(2,7)|");
  render_table_row_4(btbl, "29", "840 = 2^3*3*5*7", "YES", "= 2*420");
  render_table_row_4(btbl, "31 = 2^5-1", "960 = 2^6*3*5", "YES", "last consecutive");
  render_table_row_4(btbl, "37", "1368 = 2^3*3^2*19", "NO", "19 breaks it");
  render_table_row_4(btbl, "41", "1680 = 2^4*3*5*7", "YES", "= 4*420");
  render_table_row_4(btbl, "71 = c(5*7)", "5040 = 7!", "YES", "7 factorial");
  dom_append(sec6b, btbl);
  render_theorem(sec6b, "Smoothness Boundary Theorem (PROVED)", "p^2-1 is 11-smooth for ALL primes from 2 through 31 consecutively (11 primes). First failure at p=37, the 12th prime. 31 = 2^5-1 guards the boundary. The pattern breaks at the prime whose index is 12 = 2^2*3 = lambda(Z/210).");
  render_p(sec6b, "Recovery primes punctuate the boundary: 41 gives 1680 = 4*420, and 71 = c(5*7) gives 5040 = 7!. The smoothness extends past the ring's own primes, guarded by the Mersenne prime 31 and pierced at 37.");
  dom_append(dom_body(), sec6b);

  /* === SEC 6c: THE OPTIMAL SIEVE === */
  let sec6c = make_section("800px") in
  render_h2(sec6c, "The Optimal Sieve");
  render_p(sec6c, "The chain generates the five primes of Z/2,310. Widen to all seven axiom primes {2, 3, 5, 7, 11, 13, 17} and a sharper fact appears: to strike out composites by trial division, these seven do it better than any other seven primes.");
  render_theorem(sec6c, "Sieve Optimality (verified exhaustively)", "Among all C(15,7) = 6,435 ways to choose seven primes from the first fifteen (2 through 47), the axiom set {2,3,5,7,11,13,17} UNIQUELY catches the most composites up to 10,000. Exactly one subset is best -- the seven smallest primes, the axiom's own.");
  render_p(sec6c, "The sieve climbs the tower. Each level sieves with its primes; the smallest composite it MISSES is the square of the next prime:");
  let svtbl = dom_create("table") in
  dom_style(svtbl, "width", "100%");
  dom_style(svtbl, "maxWidth", "700px");
  dom_style(svtbl, "margin", "24px auto");
  dom_style(svtbl, "borderCollapse", "collapse");
  let svhdr = dom_create("tr") in
  render_th(svhdr, "Ring");
  render_th(svhdr, "Sieve primes");
  render_th(svhdr, "First uncaught composite");
  dom_append(svtbl, svhdr);
  render_table_row(svtbl, "Z/6", "2, 3", "25 = 5^2");
  render_table_row(svtbl, "Z/30", "2, 3, 5", "49 = 7^2");
  render_table_row(svtbl, "Z/210", "2, 3, 5, 7", "121 = 11^2");
  render_table_row(svtbl, "Z/2,310", "2, 3, 5, 7, 11", "169 = 13^2");
  render_table_row(svtbl, "Z/30,030", "+ 13", "289 = 17^2");
  render_table_row(svtbl, "Z/510,510", "+ 17", "361 = 19^2");
  dom_append(sec6c, svtbl);
  render_p(sec6c, "All seven primes together sieve every composite up to 360 = 19^2 - 1 with no misses. The first thing they cannot catch is 361 = 19^2 -- the square of the eighth prime.");
  render_theorem(sec6c, "Sieve Bounds Are Data-Smooth (PROVED)", "Each level's last fully-sieved bound -- one below the first miss -- is (next prime)^2 - 1: {24, 48, 120, 168, 288, 360}, running up through all seven axiom primes. Every one factors into {2, 3, 5, 7} alone -- the four data primes. Extend to an eighth prime (19) and the next bound breaks: 23^2 - 1 = 528 = 22 * 24, where 22 = 2 * 11 drags in 11. The seven axiom primes are the longest initial run whose sieve bounds stay {2,3,5,7}-smooth.");
  render_p(sec6c, "Sieving is additive -- count what you strike out. The Euler product is its multiplicative twin, and it tells the same story.");
  render_theorem(sec6c, "The Euler Product (verified exhaustively)", "The seven-prime partial Euler product 1 / ((1-2^-2)(1-3^-2) ... (1-17^-2)) captures 98.7% of zeta(2) = pi^2/6. Each prime's factor 1/(1-p^-2) shrinks in coupling order: 2 contributes most, 17 least -- the same hierarchy that orders the seven channels.");
  render_p(sec6c, "As the exponent slides toward 1, the product becomes the Mertens product: 2/1 * 3/2 * 5/4 * 7/6 * 11/10 * 13/12 * 17/16 = 510,510 / 92,160. The numerator is the seven-primorial -- the radical of 214,414,200. The denominator is the product of (p-1) = 2^11 * 3^2 * 5, with no factor of 7.");
  dom_append(dom_body(), sec6c);

  /* === SEC 7: CRT(23) PALINDROME === */
  let sec7 = make_section("800px") in
  render_h2(sec7, "CRT(23) Palindrome");
  render_p(sec7, "23 = 2*11 + 1 is the first excluded Cunningham prime (CC1(2) step 3). Its CRT decomposition in Z/210 reads as a palindrome:");
  let g7 = make_findings_grid(sec7) in
  render_finding(g7, "CRT(23)", "(1, 2, 3, 2, 1)", "Palindrome: 1-2-3-2-1. 3 at center. Mirror around it.", "");
  render_finding(g7, "Position", "23 = p_9 = p_{3^2}", "The 3^2-th prime IS the Cunningham boundary. 9 = 3^2 sets the limit.", "");
  render_finding(g7, "Sum of totients", "phi(2)+phi(3)+phi(5)+phi(7)+phi(11) = 23", "Sum of Euler totients over the 5 primes of Z/2,310. VERIFIED.", "");
  render_finding(g7, "Sophie Germain", "2 -> 5 -> 11 -> 23 -> 47", "Four consecutive safe primes: 5=2*2+1, 11=2*5+1, 23=2*11+1, 47=2*23+1.", "");
  dom_append(dom_body(), sec7);

  /* === SEC 7b: CUNNINGHAM OF PRODUCTS === */
  let sec7b = make_section("800px") in
  render_h2(sec7b, "Cunningham of Products");
  render_p(sec7b, "Apply c(n)=2n+1 to products of primes from Z/2,310. Every prime result is structurally significant:");
  let ptbl = dom_create("table") in
  dom_style(ptbl, "width", "100%");
  dom_style(ptbl, "maxWidth", "700px");
  dom_style(ptbl, "margin", "24px auto");
  dom_style(ptbl, "borderCollapse", "collapse");
  let phdr = dom_create("tr") in
  render_th(phdr, "Product");
  render_th(phdr, "c(product)");
  render_th(phdr, "c^2-1");
  render_th(phdr, "Note");
  dom_append(ptbl, phdr);
  render_table_row_4(ptbl, "2*3 = 6", "13", "168 = 2^3*3*7", "Smooth");
  render_table_row_4(ptbl, "2*7 = 14", "29", "840 = 2*420", "2 * lambda(Z/210)");
  render_table_row_4(ptbl, "3*5 = 15", "31 = 2^5-1", "960 = 2^6*3*5", "Mersenne prime");
  render_table_row_4(ptbl, "3*7 = 21", "43", "1848 = 2^3*3*7*11", "Four primes appear");
  render_table_row_4(ptbl, "5*7 = 35", "71", "5040 = 7!", "7 FACTORIAL");
  render_table_row_4(ptbl, "2*3*5 = 30", "61", "3720", "c(210/7)");
  render_table_row_4(ptbl, "3*11 = 33", "67", "4488", "c(sum(p+1))");
  dom_append(sec7b, ptbl);
  render_theorem(sec7b, "Cunningham Product Theorem (PROVED)", "c(2*3)=13, c(3*5)=31=2^5-1, c(5*7)=71 with 71^2-1=7!=5040. 61=c(210/7)=c(30). 67=c(3*11)=c(33). 61+67=128=2^7. The Cunningham map applied to prime products generates structural constants of the ring.");
  render_p(sec7b, "The c(5*7) = 71 identity: 71 is a prime whose p^2-1 equals 7 factorial. 5040 = 7! = 2^4*3^2*5*7, using four of five primes (only 11 absent). And 61+67 = 2^7 = 128.");
  dom_append(dom_body(), sec7b);

  /* === SEC 7c: THE CUNNINGHAM STOPPER === */
  let sec7c = make_section("800px") in
  render_h2(sec7c, "The Cunningham Stopper");
  render_p(sec7c, "WHY do the chains stop? The multiplicative order of 2 modulo each odd prime reveals the structure. Every order uses only {2, 3, 5} -- the same three primes that build the chains:");
  let otbl = dom_create("table") in
  dom_style(otbl, "width", "100%");
  dom_style(otbl, "maxWidth", "700px");
  dom_style(otbl, "margin", "24px auto");
  dom_style(otbl, "borderCollapse", "collapse");
  let ohdr = dom_create("tr") in
  render_th(ohdr, "Prime p");
  render_th(ohdr, "ord_p(2)");
  render_th(ohdr, "Factored");
  render_th(ohdr, "Type");
  dom_append(otbl, ohdr);
  render_table_row_4(otbl, "3", "2", "2", "NR (primitive root)");
  render_table_row_4(otbl, "5", "4", "2^2", "NR");
  render_table_row_4(otbl, "7", "3", "3", "QR (half-period)");
  render_table_row_4(otbl, "11", "10", "2*5", "NR");
  render_table_row_4(otbl, "13", "12", "2^2*3", "NR");
  render_table_row_4(otbl, "17", "8", "2^3", "QR");
  dom_append(sec7c, otbl);
  render_p(sec7c, "2 is a primitive root (full period, ord = phi) mod {3, 5, 11, 13} -- these are the non-residue (NR) primes. 2 has half-period (ord = phi/2) mod {7, 17} -- the quadratic residue (QR) primes. The split encodes the deepest structure:");
  let g7c = make_findings_grid(sec7c) in
  render_finding(g7c, "Sum of orders", "39 = 3*13", "Product of 3 and 13.", "");
  render_finding(g7c, "LCM of orders", "120 = 5! = 2^3*3*5", "5 factorial.", "");
  render_finding(g7c, "NR order sum", "28 = 2^2*7", "The 2nd perfect number.", "");
  render_finding(g7c, "QR order sum", "11", "The largest prime of Z/2,310.", "");
  render_finding(g7c, "NR - QR", "17", "The gap between NR and QR sums.", "");
  render_theorem(sec7c, "Cunningham Stopper Theorem (PROVED)", "The multiplicative order of 2 modulo each odd prime of Z/2,310 is smooth in {2,3,5}: orders {2, 2^2, 3, 2*5, 2^2*3, 2^3}. Sum = 3*13 = 39. LCM = 5! = 120. 2 is primitive root mod {3, 5, 11, 13} and half-period mod {7, 17}. NR ord sum = 2^2*7 = 28 (2nd perfect number). QR ord sum = 11. NR - QR = 17. Chain budget: |CC1(1)| + |CC1(2)| = 3 + 5 = 2^3. Product 3*5 = 15 = CC1(1) stop value.");
  dom_append(dom_body(), sec7c);

  /* === INTERACTIVE: CUNNINGHAM CHAIN TRACER === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Chain Tracer");
  render_p(sec_i, "Enter a seed. Watch c(n) = 2n+1 build a Cunningham chain until it hits a composite. How far does YOUR seed go?");
  make_interactive_widget(sec_i, "Trace Cunningham chain from seed:", "cc-input", "e.g. 2", "Trace", "cunningham_trace", "cc-result");
  render_p(sec_i, "Try: 1 (chain of length 3), 2 (chain of length 5), 89 (Sophie Germain chain), 6 (2*3 -> 13 on first step).");
  dom_append(dom_body(), sec_i);

  /* === CONTRAST === */
  let sec8 = make_section("800px") in
  render_h2(sec8, "Contrast Table");
  render_contrast_row(sec8, "Cunningham chains", "Curiosities in number theory. No deep significance.", "Two seeds (1, 2) generate the first five primes of Z/2,310. c(2*3) = 13 closes it. Self-stopping.");
  render_contrast_row(sec8, "Shadow function s(p)=(p-1)/2", "Standard half-map, no structure", "Produces primes for {3,5,7,11}. First composite shadow at 13: s(13)=6=2*3. Self-imposed boundary.");
  render_contrast_row(sec8, "Mersenne numbers", "2^n - 1, connection to perfect numbers", "c^n(0) = 2^n - 1. The 11-smooth Mersenne exponents are exactly the proper divisors of 12 = lambda(Z/210).");
  render_contrast_row(sec8, "p^2 - 1 smoothness", "Smooth for small p, expected to fail quickly", "11-smooth for 11 consecutive primes through 31. Breaks at the 12th prime (37). Mersenne prime 31 guards the boundary.");
  render_contrast_row(sec8, "Multiplicative order of 2", "ord_p(2) varies, no pattern expected", "All orders factor into {2,3,5} only. NR sum = 28 (perfect number). QR sum = 11. Difference = 17. LCM = 5! = 120.");
  render_contrast_row(sec8, "Best seven primes to sieve with", "Any seven small primes do about equally well", "Among all 6,435 seven-prime subsets, the axiom set {2..17} is the UNIQUE best. Sieve bounds stay {2,3,5,7}-smooth until the eighth prime. Euler product captures 98.7% of zeta(2).");
  dom_append(dom_body(), sec8)
)
