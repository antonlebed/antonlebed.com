/* page_mesh_sensor.ax -- Mesh Sensor: 3-node CRT mesh with real hardware data. CC0.
   Real traffic from 3 ESP32 boards. CRT addressing + ECC3 + calibration.
   100% ECC pass rate. Round-trip delta=0. Data from S2122 recording. */

/* ===== HELPERS ===== */

fn ms_gcd(a, b) = (
  mut x = if a < 0 then 0 - a else a;
  mut y = if b < 0 then 0 - b else b;
  while y > 0 do (let t = y in mut y = x % y; mut x = t);
  x
)

let ms_mods = alloc(7)
fn ms_init_mods() = (
  set(ms_mods, 0, 8); set(ms_mods, 1, 9); set(ms_mods, 2, 25);
  set(ms_mods, 3, 49); set(ms_mods, 4, 11); set(ms_mods, 5, 13);
  set(ms_mods, 6, 17)
)

fn ms_ch_color(i) =
  if i == 0 then "#ff4444" else if i == 1 then "#44cc44"
  else if i == 2 then "#4488ff" else if i == 3 then "#cc44ff"
  else if i == 4 then "#44dddd" else if i == 5 then "#ffaa44"
  else "#88ff88"

/* Parse digit string to integer (handles leading minus) */
fn ms_parse_int(s:str) = (
  mut n = 0;
  mut neg = 0;
  mut i = 0;
  if len(s) > 0 then if charCode(s, 0) == 45 then (mut neg = 1; mut i = 1) else 0 else 0;
  while i < len(s) do (
    let c = charCode(s, i) in
    if c >= 48 then if c <= 57 then (mut n = n * 10 + c - 48) else 0 else 0;
    mut i = i + 1
  );
  if neg == 1 then 0 - n else n
)

/* ===== DISPLAY STATE ===== */

let ms_input_el = [0]
let ms_eps_el = [0]
let ms_output_el = [0]

/* ===== HANDLER: ROUND-TRIP PROBE ===== */

fn on_ms_probe() = (
  let x_s = dom_value(ms_input_el[0]) in
  let e_s = dom_value(ms_eps_el[0]) in
  let x = ms_parse_int(x_s) in
  let eps = ms_parse_int(e_s) in
  let N = 214414200 in
  let xn = ((x % N) + N) % N in

  /* Step 1: forward with error */
  let fwd = ((xn + eps) % N + N) % N in
  /* Step 2: mirror (N - fwd) */
  let mirror = (N - fwd + N) % N in
  /* Step 3: return with same error */
  let ret = ((mirror + eps) % N + N) % N in
  /* Step 4: unmirror */
  let recovered = (N - ret + N) % N in
  let delta = ((recovered - xn) % N + N) % N in
  let pass = if delta == 0 then "<span style='color:#44ff88;font-weight:bold'>PASS</span> (delta = 0)"
    else "<span style='color:#ff4444;font-weight:bold'>FAIL</span> (delta = ${delta})" in

  /* Build CRT trace */
  mut trace = "<table style='width:100%;border-collapse:collapse;font-family:monospace;font-size:13px;table-layout:fixed'>"
    + "<tr style='border-bottom:1px solid #333'>"
    + "<th style='text-align:left;padding:4px 8px;color:#888'>Step</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#ff4444'>mod 8</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#44cc44'>mod 9</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#4488ff'>mod 25</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#cc44ff'>mod 49</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#44dddd'>mod 11</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#ffaa44'>mod 13</th>"
    + "<th style='text-align:center;padding:4px 8px;color:#88ff88'>mod 17</th></tr>";

  let vals = alloc(5) in
  set(vals, 0, xn); set(vals, 1, fwd); set(vals, 2, mirror); set(vals, 3, ret); set(vals, 4, recovered);
  let labels = alloc(5) in
  set(labels, 0, "1. Send x"); set(labels, 1, "2. + error"); set(labels, 2, "3. Mirror"); set(labels, 3, "4. + error"); set(labels, 4, "5. Unmirror");
  mut step = 0;
  while step < 5 do (
    let v = vals[step] in
    let lbl = labels[step] in
    mut trace = trace + "<tr style='border-bottom:1px solid #222'>"
      + "<td style='padding:4px 8px;color:#ccc;white-space:nowrap'>${lbl}</td>";
    mut ch = 0;
    while ch < 7 do (
      let m = ms_mods[ch] in
      let r = v % m in
      let rv = if r < 0 then r + m else r in
      let c = ms_ch_color(ch) in
      mut trace = trace + "<td style='text-align:center;padding:4px 8px;color:${c}'>${rv}</td>";
      mut ch = ch + 1
    );
    mut trace = trace + "</tr>";
    mut step = step + 1
  );
  mut trace = trace + "</table>";

  dom_inner(ms_output_el[0],
    "<div style='margin:12px 0;padding:12px;background:#0a0a14;border:1px solid #333;border-radius:4px;overflow-x:auto'>"
    + "<div style='margin-bottom:4px'>x = ${xn}, epsilon = ${eps}</div>"
    + "<div style='margin-bottom:4px'>Forward: ${xn} + ${eps} = ${fwd}</div>"
    + "<div style='margin-bottom:4px'>Mirror: N - ${fwd} = ${mirror}</div>"
    + "<div style='margin-bottom:4px'>Return: ${mirror} + ${eps} = ${ret}</div>"
    + "<div style='margin-bottom:4px'>Unmirror: N - ${ret} = ${recovered}</div>"
    + "<div style='margin-bottom:8px'>Result: ${pass}</div>"
    + trace + "</div>")
)

/* ===== PAGE LAYOUT ===== */

fn page_mesh_sensor() = (
  ms_init_mods();
  dom_head_meta("description", "Mesh Sensor: 3-node CRT mesh network on real ESP32 hardware. 100% ECC pass rate. Round-trip calibration delta=0. Real packet statistics. CC0.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Mesh Sensor Network\",\"description\":\"3 ESP32 boards on CRT mesh. Real traffic data. 100% ECC. Round-trip calibration verified. CC0.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/demos/mesh_sensor\"}");
  domain_hero("Mesh Sensor Network", "3 boards, 0 failures", "Three ESP32 boards. CRT addressing. ECC3 triple-parity on every packet. 1,094 packets received, 0 failures. Round-trip calibration: delta = 0 on all pairs. Real data from live hardware.");

  /* === TOPOLOGY === */
  let sec1 = make_section("750px") in
  render_h2(sec1, "Network Topology");
  render_p(sec1, "Three boards on ESP-NOW broadcast mesh. Each board's ring element determines its CRT address, coupling class, and routing role.");
  let t1 = make_table(sec1) in
  let h1 = dom_create("tr") in
  render_th(h1, "Board"); render_th(h1, "Element"); render_th(h1, "CRT Address"); render_th(h1, "Coupling");
  dom_append(t1, h1);
  render_table_row_4(t1, "FAR (COM3)", "sigma = 1", "(1,1,1,1,1,1,1)", "214,414,200");
  render_table_row_4(t1, "MIDDLE (COM4)", "D = 2", "(2,2,2,2,2,2,2)", "107,207,100");
  render_table_row_4(t1, "CLOSE (COM5)", "void = 0", "(0,0,0,0,0,0,0)", "1");
  dom_append(dom_body(), sec1);

  /* === TRAFFIC STATISTICS === */
  let sec2 = make_section("750px") in
  render_h2(sec2, "Packet Statistics");
  render_p(sec2, "Real traffic from 3-second heartbeat mesh. SPIN packets (type 3), calibration probes (type 1), calibration echoes (type 2). Every received packet validated by ECC3.");
  let t2 = make_table(sec2) in
  let h2 = dom_create("tr") in
  render_th(h2, "Board"); render_th(h2, "TX"); render_th(h2, "RX"); render_th(h2, "ECC OK"); render_th(h2, "ECC Fail");
  dom_append(t2, h2);
  render_table_row_5(t2, "sigma (COM3)", "338", "345", "345", "0");
  render_table_row_5(t2, "D (COM4)", "205", "371", "371", "0");
  render_table_row_5(t2, "void (COM5)", "214", "378", "378", "0");
  render_table_row_5(t2, "TOTAL", "757", "1,094", "1,094", "0");

  let ecc_box = dom_create("div") in
  dom_style(ecc_box, "padding", "12px");
  dom_style(ecc_box, "background", "#0a140a");
  dom_style(ecc_box, "border", "1px solid #44ff88");
  dom_style(ecc_box, "borderRadius", "4px");
  dom_style(ecc_box, "marginTop", "12px");
  dom_style(ecc_box, "fontFamily", "'Courier New', monospace");
  dom_inner(ecc_box, "<span style='color:#44ff88;font-size:20px;font-weight:bold'>100% ECC PASS</span>"
    + "<br><span style='color:#888;font-size:13px'>1,094 packets received. 0 failures. ECC3 triple-parity (mod 11 + mod 13 + mod 17). Rate 4/7.</span>");
  dom_append(sec2, ecc_box);
  dom_append(dom_body(), sec2);

  /* === CALIBRATION === */
  let sec3 = make_section("750px") in
  render_h2(sec3, "Round-Trip Calibration");
  render_p(sec3, "Probe value 42 sent between all board pairs. Mirror involution (N - x) cancels systematic channel error. Round-trip recovers the original value exactly.");
  let t3 = make_table(sec3) in
  let h3 = dom_create("tr") in
  render_th(h3, "Pair"); render_th(h3, "Probe"); render_th(h3, "Recovered"); render_th(h3, "Delta"); render_th(h3, "Result");
  dom_append(t3, h3);
  render_table_row_5(t3, "sigma -> D", "42", "42", "0", "PASS");
  render_table_row_5(t3, "sigma -> void", "42", "42", "0", "PASS");
  render_table_row_5(t3, "D -> sigma", "42", "42", "0", "PASS");
  render_table_row_5(t3, "D -> void", "42", "42", "0", "PASS");
  render_table_row_5(t3, "void -> sigma", "42", "42", "0", "PASS");
  render_table_row_5(t3, "void -> D", "42", "42", "0", "PASS");
  render_theorem(sec3, "Why Delta = 0", "-1 is the unique involution where round-trip error cancellation is exact. For any involution u, the residual error is u(u+1)*epsilon. Only u = -1 gives u+1 = 0, so the residual vanishes. This is not a design choice -- it is forced by the algebra.");
  dom_append(dom_body(), sec3);

  /* === TRY IT === */
  let sec4 = make_section("750px") in
  render_h2(sec4, "Try Round-Trip");
  render_p(sec4, "Enter a value and a systematic error. Watch the 4-step round-trip cancel the error in every CRT channel.");
  let row = dom_create("div") in
  dom_style(row, "display", "flex");
  dom_style(row, "gap", "8px");
  dom_style(row, "alignItems", "center");
  dom_style(row, "marginBottom", "12px");
  dom_style(row, "flexWrap", "wrap");
  let lx = dom_create("span") in
  dom_text(lx, "x ="); dom_style(lx, "color", "#ccc");
  dom_append(row, lx);
  let ix = dom_create("input") in
  dom_attr(ix, "type", "number"); dom_attr(ix, "value", "42");
  dom_style(ix, "width", "80px"); dom_style(ix, "padding", "6px");
  dom_style(ix, "backgroundColor", "#1a1a2e"); dom_style(ix, "color", "#e0e0e0");
  dom_style(ix, "border", "1px solid #444"); dom_style(ix, "borderRadius", "4px");
  dom_style(ix, "fontFamily", "monospace");
  set(ms_input_el, 0, ix);
  dom_append(row, ix);
  let le = dom_create("span") in
  dom_text(le, "error ="); dom_style(le, "color", "#ccc");
  dom_append(row, le);
  let ie = dom_create("input") in
  dom_attr(ie, "type", "number"); dom_attr(ie, "value", "17");
  dom_style(ie, "width", "80px"); dom_style(ie, "padding", "6px");
  dom_style(ie, "backgroundColor", "#1a1a2e"); dom_style(ie, "color", "#e0e0e0");
  dom_style(ie, "border", "1px solid #444"); dom_style(ie, "borderRadius", "4px");
  dom_style(ie, "fontFamily", "monospace");
  set(ms_eps_el, 0, ie);
  dom_append(row, ie);
  let btn = dom_create("button") in
  dom_inner(btn, "Run Round-Trip");
  dom_style(btn, "padding", "6px 16px"); dom_style(btn, "cursor", "pointer");
  dom_style(btn, "background", "#1a1a2e"); dom_style(btn, "color", "#ffd700");
  dom_style(btn, "border", "1px solid #ffd700"); dom_style(btn, "borderRadius", "4px");
  dom_style(btn, "fontFamily", "monospace");
  dom_on(btn, "click", "on_ms_probe");
  dom_append(row, btn);
  dom_append(sec4, row);
  let out = dom_create("div") in
  set(ms_output_el, 0, out);
  dom_append(sec4, out);
  dom_append(dom_body(), sec4);

  /* === HOW IT WORKS === */
  let sec5 = make_section("750px") in
  render_h2(sec5, "How It Works");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "ESP-NOW", "Broadcast", "250kbps, no AP needed. 14-byte CRT payload. 3-second heartbeat. All boards hear all packets.", "");
  render_finding(g5, "CRT Address", "7 channels", "Ring element = address = route. sigma(1) = backbone. D(2) = bridge. void(0) = relay. No routing tables.", "");
  render_finding(g5, "ECC3", "Rate 4/7", "Triple-parity: mod 11 + mod 13 + mod 17. Detects any single-channel corruption. Corrects via reconstruction from remaining 6 channels.", "");
  render_finding(g5, "Calibration", "delta = 0", "Mirror involution (N-x) cancels systematic error. Unique among all involutions. O(1) cost: one subtraction.", "");
  render_finding(g5, "Hardware", "$12 total", "3 ESP32 boards at $4 each. 240MHz, 520KB RAM. .ax WASM firmware. No cloud. No infrastructure.", "");
  dom_append(dom_body(), sec5);

  /* Auto-run default probe */
  on_ms_probe()
)
