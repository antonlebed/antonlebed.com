/* ================================================================
   PAGE: CONSTANTS -- Ring Constants Lookup Tool (CONSTANTS.md)
   ================================================================
   TOWER LENS (TT40, S1422): cross-tower. Every named integer has
   a tower home. 64 = D^6 (pure D-power, past Tower_D's Pareto top
   D^3 = 8). 35 = E*b (Tower_E x Tower_b). 68 = D^2*ESCAPE (Tower_D
   x Tower_ESCAPE). 99 = K^2*L = SYNAPSE (Tower_K x Tower_L). 84 =
   D^2*K*b (Tower_D x Tower_K x Tower_b). The interactive widget
   decomposes any input into its six CRT channels Z/8 x Z/9 x Z/25
   x Z/49 x Z/11 x Z/13 = TRUE = 12612600, revealing its tower
   residence.

   LATTICE COUNTS (TT47 reframing per stdlib/lattice.ax SSOT, S1428 R5):
     108 = D^2 * K^3 = LAMBDA-420 LATTICE (Tower C fiber). ALL 108
       rings hit lambda(N) = 420 EXACTLY because b^2 = 49 is forced
       (b^3 = 343 gives lambda 294 which doesn't divide 420). LOVE*D = 108.
     84 = D^2 * K * b = TRUE-DIVISOR subset (D-range 0..3). 84 of
       the 108 lambda-420 rings divide TRUE = 12612600.
     24 = D^4 EXTENSIONS beyond TRUE (D-range = 4, max N = 25225200
       = 2*TRUE). 84 + 24 = 108. The 84/108 split is by D-RANGE, not
       by lambda.

   PUBLIC-NAME POLICY (TT51, S1433): this public page uses factorization-
     first descriptors (D^6, E*b, D^2*ESCAPE, D^2*K*b) instead of the
     personal-name aliases that live in the private docs under anton/.
     Rationale + mapping: memory/feedback_public_neutral_names.md.

   PUBLIC PAGE = widget + honest note (the "An earlier version..."
   render_p in page_constants() explains the SPECULATIVE-match strip
   and its rationale). Full catalog of named constants and their
   physical-match history lives in CONSTANTS.md.
   STRIP NOTE (TT52, S1434): 19 orphan render helpers between the
   con_name widget and page_constants() were removed (634L -> 140L).
   They had sat orphan since the SPECULATIVE-match strip that created
   the honest-note paragraph; zero call sites, zero referrers. Git
   history is the archive. Banked at TT40 S1422; executed here.
   ================================================================ */

/* constants widget */
fn con_name(n) = (
  if n == 0 then "VOID (o)"
  else if n == 1 then "SIGMA (identity)"
  else if n == 2 then "D (bridge)"
  else if n == 3 then "K (closure)"
  else if n == 4 then "D^2"
  else if n == 5 then "E (observer)"
  else if n == 6 then "D*K = HIDDEN"
  else if n == 7 then "b (depth)"
  else if n == 8 then "D^3 (spider legs)"
  else if n == 9 then "K^2 (spider web)"
  else if n == 10 then "D*E (degree)"
  else if n == 11 then "L (protector)"
  else if n == 12 then "D^2*K (trinity heart)"
  else if n == 13 then "GATE (shadow stopper)"
  else if n == 14 then "D*b"
  else if n == 16 then "D^4 = phi(ESCAPE)"
  else if n == 21 then "K*b (codon ring Z/21)"
  else if n == 22 then "D*L"
  else if n == 23 then "c(L) = Cunningham"
  else if n == 24 then "D^3*K"
  else if n == 25 then "E^2"
  else if n == 30 then "D*K*E = THIN/b*L"
  else if n == 35 then "E*b (meta-meta ring)"
  else if n == 36 then "D^2*K^2"
  else if n == 37 then "depth return"
  else if n == 40 then "MIND = D^3*E"
  else if n == 41 then "KEY = f(b) = depth quadratic"
  else if n == 42 then "ANSWER = D*K*b"
  else if n == 44 then "HOPE = FAITH = D^2*L"
  else if n == 45 then "K^2*E"
  else if n == 48 then "SEES = phi(210)"
  else if n == 49 then "b^2"
  else if n == 54 then "LOVE = D*K^3"
  else if n == 55 then "E*L"
  else if n == 61 then "GRIEF = D^6-K"
  else if n == 64 then "D^6 (vacuum)"
  else if n == 67 then "SOUL = D^6+K"
  else if n == 68 then "D^2*ESCAPE (dark energy)"
  else if n == 73 then "prime (21st) = c(D^2*K^2)"
  else if n == 77 then "b*L"
  else if n == 84 then "D^2*K*b = TRUE-divisor lambda-420 rings"
  else if n == 99 then "SYNAPSE = K^2*L"
  else if n == 105 then "HYDOR = K*E*b"
  else if n == 108 then "D^2*K^3 = lambda-420 rings (84 in TRUE + 24 D^4 ext.)"
  else if n == 137 then "ADDRESS = alpha^-1"
  else if n == 143 then "L*GATE"
  else if n == 168 then "|PSL(2,7)| = |GL(3,2)|"
  else if n == 210 then "DATA = D*K*E*b"
  else if n == 240 then "|roots(E8)| = D^4*K*E"
  else if n == 255 then "|L|^2 = D^8-1"
  else if n == 420 then "lambda = D^2*K*E*b"
  else if n == 2310 then "THIN = D*K*E*b*L"
  else if n == 2400 then "D^5*K*E^2 (Stormer)"
  else if n == 2401 then "b^4 (Stormer)"
  else if n == 4801 then "Stormer sum (prime)"
  else if n == 606376 then "DEEP OMEGA = D^420 mod 970200"
  else if n == N_DEEP then "DEEP = D^3*K^2*E^2*b^2*L"
  else if n == OMEGA_VAL then "OMEGA = D^420 mod 12612600"
  else if n == N_TRUE then "N = TRUE FORM = DEEP*GATE"
  else ""
)

fn con_lookup() = (
  let n = parse_int_from("#con-input") in
  let result = dom_query("#con-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r2 = n % 8 in
    let r3 = n % 9 in
    let r5 = n % 25 in
    let r7 = n % 49 in
    let r11 = n % 11 in
    let r13 = n % 13 in
    let name = con_name(n) in
    let nstr = if len(name) > 0 then "<p style='color:#ffd700;margin:4px 0;font-size:18px'>" + name + "</p>" else "" in
    dom_inner(result, nstr + "<p style='color:#d8d8e0;margin:4px 0'>CRT(" + "${n}" + ") = (" + "${r2}" + ", " + "${r3}" + ", " + "${r5}" + ", " + "${r7}" + ", " + "${r11}" + ", " + "${r13}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>mod (8, 9, 25, 49, 11, 13)</p>")
  )
)

fn page_constants() = (
  dom_head_meta("description", "Named constants in Z/12612600Z. Every integer has a tower home. CRT decomposition into six independent channels (Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13). Interactive lookup tool.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Ring Constants\",\"description\":\"Named constants and CRT decomposition in Z/12612600Z. Interactive lookup tool.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/structure/constants\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Ring Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT Decomposition\"}]}");
  let hero = make_hero("Ring Constants") in
  let eq = dom_create("div") in
  dom_text(eq, "Named values in Z/12612600Z");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "The ring Z/12612600Z = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 (TRUE, six CRT channels). Named values have tower homes: lambda=420=D^2*K*E*b (Tower C base), KEY=41=f(b) (Tower_b depth quadratic), ANSWER=42=D*K*b, HYDOR=105=K*E*b, 64=D^6 (vacuum), 35=E*b (meta-meta ring). The widget below decomposes any input into its six CRT channels and shows its axiom name if one is registered.");
  dom_append(dom_body(), hero);
  let note = make_section("800px") in
  render_p(note, "NOTE: An earlier version of this page presented SPECULATIVE matches between ring ratios and physical constants (Kolmogorov 5/3, Kleiber 3/4, particle masses, solar cycles). Those correspondences are numerically striking but have no known causal mechanism. They are preserved in the local documentation (CONSTANTS.md) for investigation, but removed from the public website pending evidence of a real connection. The ring's algebraic properties (below) stand independently.");
  dom_append(dom_body(), note);
  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Named Constants");
  render_p(sec_i, "Enter a number to see its axiom name (if any) and CRT decomposition in the TRUE FORM ring Z/12612600Z. Two lattice counts both live here: 108 = D^2*K^3 (LOVE * D) is the count of rings hitting lambda = 420 EXACTLY (b^2 forced); 84 = D^2*K*b is the subset of those 108 that divide TRUE.");
  make_interactive_widget(sec_i, "Look up constant:", "con-input", "e.g. 42", "Look up", "con_lookup", "con-result");
  render_p(sec_i, "Try: 0 (void), 42 (ANSWER), 77 (b*L), 84 (D^2*K*b, TRUE-divisor count), 108 (lambda-420 rings), 137 (ADDRESS), 420 (lambda), 1576576 (OMEGA), 606376 (DEEP OMEGA), 13 (GATE).");
  dom_append(dom_body(), sec_i)
)
