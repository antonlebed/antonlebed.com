/* ================================================================
   PAGE: CONSTANTS -- Ring Constants Lookup Tool (CONSTANTS.md)
   ================================================================
   TOWER LENS (TT40, S1422): cross-tower. Every named integer has
   a tower home. 64 = D^6 (pure D-power, past D-channel's Pareto top
   D^3 = 8). 35 = E*b (E-channel x b-channel). 68 = D^2*ESCAPE (D-channel
   x ESCAPE-channel). 99 = K^2*L = SYNAPSE (K-channel x L-channel). 84 =
   D^2*K*b (D-channel x K-channel x b-channel). The interactive widget
   decomposes any input into seven CRT channels Z/8 x Z/9 x Z/25
   x Z/49 x Z/11 x Z/13 x Z/17 = TRANS = 214414200, revealing its
   tower residence.

   LATTICE COUNTS (TT47 reframing per stdlib/lattice.ax SSOT, S1428 R5):
     108 = D^2 * K^3 = LAMBDA-420 LATTICE (Tower C fiber). ALL 108
       rings hit lambda(N) = 420 EXACTLY because b^2 = 49 is forced
       (b^3 = 343 gives lambda 294 which doesn't divide 420). LOVE*D = 108.
     84 = D^2 * K * b = TRUE-DIVISOR subset (D-range 0..3). 84 of
       the 108 lambda-420 rings divide TRUE = 12612600.
     24 = D^4 EXTENSIONS beyond TRUE (D-range = 4, max N = 25225200
       = 2*TRUE). 84 + 24 = 108. The 84/108 split is by D-RANGE, not
       by lambda.

   PUBLIC-NAME POLICY (TT51, S1433): this public page uses factorization-
     first descriptors (D^6, E*b, D^2*ESCAPE, D^2*K*b) instead of the
     personal-name aliases that live in the private docs under anton/.
     Rationale + mapping: memory/feedback_public_neutral_names.md.

   PUBLIC PAGE = widget + honest note (the "An earlier version..."
   render_p in page_constants() explains the SPECULATIVE-match strip
   and its rationale). Full catalog of named constants and their
   physical-match history lives in CONSTANTS.md.
   STRIP NOTE (TT52, S1434): 19 orphan render helpers between the
   con_name widget and page_constants() were removed (634L -> 140L).
   They had sat orphan since the SPECULATIVE-match strip that created
   the honest-note paragraph; zero call sites, zero referrers. Git
   history is the archive. Banked at TT40 S1422; executed here.
   ================================================================ */

/* constants widget */
fn con_name(n) = (
  if n == 0 then "0 (void)"
  else if n == 1 then "1 (identity)"
  else if n == 2 then "2 (the pair, only even prime)"
  else if n == 3 then "3 (the triangle, minimum majority)"
  else if n == 4 then "4 = 2^2"
  else if n == 5 then "5 (self-blind: 5^2|N but 5 does not divide 24)"
  else if n == 6 then "2*3 = 6"
  else if n == 7 then "7 (deepest channel: 49 states)"
  else if n == 8 then "2^3 = 8 (mod-8 channel size)"
  else if n == 9 then "3^2 = 9 (mod-9 channel size)"
  else if n == 10 then "2*5 = 10"
  else if n == 11 then "11 (error detection: 1+2+3+5 = 11)"
  else if n == 12 then "2^2*3 = 12"
  else if n == 13 then "13 (chain stopper: 2^2+3^2 = 13)"
  else if n == 14 then "2*7"
  else if n == 16 then "2^4 = 16 = phi(17)"
  else if n == 17 then "17 (ring closure: 5*7 = 1 mod 17, phi(17) = 16)"
  else if n == 21 then "3*7 (codon ring Z/21)"
  else if n == 22 then "2*11"
  else if n == 23 then "c(11) = Cunningham"
  else if n == 24 then "2^3*3"
  else if n == 25 then "5^2 = 25"
  else if n == 30 then "2*3*5 = 30 = Z/2,310 / (7*11)"
  else if n == 35 then "5*7 = 35 (5*7 = 1 mod 17)"
  else if n == 36 then "2^2*3^2 = 36"
  else if n == 37 then "37 (prime; f(37) = 37^2-37-1 = 1331 = 11^3)"
  else if n == 40 then "2^3*5 = 40"
  else if n == 41 then "41 = 7^2 - 7 - 1"
  else if n == 42 then "42 = 2*3*7"
  else if n == 44 then "2^2*11 = 44"
  else if n == 45 then "3^2*5 = 45"
  else if n == 48 then "48 = phi(210)"
  else if n == 49 then "7^2 = 49"
  else if n == 54 then "2*3^3 = 54"
  else if n == 55 then "5*11"
  else if n == 61 then "61 = 7*11 - 16. Primitive root of Z/49. Detects TRUE boundary"
  else if n == 64 then "2^6 = 64"
  else if n == 67 then "67 = additive center. 11^2 = 49 + 72 = 121 = 41 + 67 + 13"
  else if n == 68 then "2^2*17 = 68"
  else if n == 73 then "prime (21st) = c(2^2*3^2)"
  else if n == 77 then "7*11"
  else if n == 84 then "2^2*3*7 = Z/12,612,600-divisor lambda-420 rings"
  else if n == 99 then "3^2*11 = 99"
  else if n == 105 then "105 = 3*5*7"
  else if n == 108 then "2^2*3^3 = lambda-420 rings (84 in Z/12,612,600 + 24 2^4 ext.)"
  else if n == 137 then "137 = alpha^-1"
  else if n == 143 then "11*13"
  else if n == 168 then "|PSL(2,7)| = |GL(3,2)|"
  else if n == 210 then "Z/210 = 2*3*5*7"
  else if n == 240 then "|roots(E8)| = 2^4*3*5"
  else if n == 255 then "11^2 - 1 = 2^8 - 1"
  else if n == 420 then "420 = lambda(6-channel ring) = 2^2*3*5*7"
  else if n == 1680 then "1680 = lambda(7-channel ring) = 2^4*3*5*7 = 4*420"
  else if n == 2310 then "Z/2,310 = 2*3*5*7*11"
  else if n == 2400 then "2^5*3*5^2 (Stormer)"
  else if n == 2401 then "7^4 (Stormer)"
  else if n == 4801 then "Stormer sum (prime)"
  else if n == 606376 then "2^420 mod 970,200"
  else if n == N_DEEP then "Z/970,200 = 2^3*3^2*5^2*7^2*11"
  else if n == OMEGA_VAL then "1,576,576 = 2^420 mod 12,612,600"
  else if n == N_TRUE then "Z/12,612,600 = 2^3*3^2*5^2*7^2*11*13"
  else if n == OMEGA_TRANS then "26,801,776 = 2^1680 mod 214,414,200"
  else if n == N_TRANS then "Z/214,414,200 = 2^3*3^2*5^2*7^2*11*13*17"
  else ""
)

fn con_lookup() = (
  let n = parse_int_from("#con-input") in
  let result = dom_query("#con-result") in
  if n < 0 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 0.</p>")
  else (
    let r2 = n % 8 in
    let r3 = n % 9 in
    let r5 = n % 25 in
    let r7 = n % 49 in
    let r11 = n % 11 in
    let r13 = n % 13 in
    let r17 = n % 17 in
    let name = con_name(n) in
    let nstr = if len(name) > 0 then "<p style='color:#ffd700;margin:4px 0;font-size:18px'>" + name + "</p>" else "" in
    dom_inner(result, nstr + "<p style='color:#d8d8e0;margin:4px 0'>CRT(" + "${n}" + ") = (" + "${r2}" + ", " + "${r3}" + ", " + "${r5}" + ", " + "${r7}" + ", " + "${r11}" + ", " + "${r13}" + ", " + "${r17}" + ")</p><p style='color:#b0b0c0;margin:4px 0'>mod (8, 9, 25, 49, 11, 13, 17)</p>")
  )
)

fn constants_self_resonance() = (
  let sec = make_section("800px") in
  render_h2(sec, "Self-Resonance: Own-Prime Power Maps");
 render_theorem(sec, "CRT Self-Resonance Activation (Theorem 184)", "The self-map x -> x^p on each CRT channel Z/p^k produces exactly p fixed points. Extension channels (11, 13, 17) are pure IDENTITY: x^p = x for all x. Z/210 channels (2, 3, 5, 7) are PROJECTIVE: they absorb multiples to void and compress units. The 490 split IS the identity/projective split. Product of Z/210 survival fractions = 1/lambda = 1/420. 18/18 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Fixed pts");
  render_th(hdr, "Behavior");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2 (Z/8)", "2", "PROJECTIVE: absorbs 6 of 8");
  render_table_row(tbl, "3 (Z/9)", "3", "PROJECTIVE: absorbs 6 of 9");
  render_table_row(tbl, "5 (Z/25)", "5", "PROJECTIVE: absorbs 20 of 25");
  render_table_row(tbl, "7 (Z/49)", "7", "PROJECTIVE: absorbs 42 of 49");
  render_table_row(tbl, "11 (Z/11)", "11", "IDENTITY: all 11 fixed");
  render_table_row(tbl, "13 (Z/13)", "13", "IDENTITY: all 13 fixed");
  render_table_row(tbl, "17 (Z/17)", "17", "IDENTITY: all 17 fixed");
  render_p(sec, "Fermat's little theorem: x^p = x (mod p) for prime p. Extension channels have k=1, so the identity holds universally. Z/210 channels have k>=2, so x^p = x only for multiples of p (absorbed to 0) or the fixed-point subgroup. The 490 split cleanly separates identity channels from projective channels.");
  dom_append(dom_body(), sec)
)

fn constants_lambda_staircase() = (
  let sec = make_section("800px") in
  render_h2(sec, "Lambda Convergence Staircase");
 render_theorem(sec, "CRT Lambda Convergence Staircase (Theorem 185)", "The power map x -> x^n converges to binary {0,1} on each CRT channel at the channel's convergence power. Cumulative lcm in chain order: 4, 12, 60, 420, 420, 420, 1680 with ratio chain 4, 3, 5, 7, 1, 1, 4. The 2-channel is UNIQUE: depth (3) exceeds lambda (2). 11+13 ride free. 17 alone requires 2^2 extension. Full = 1680 = lambda(Z/214,414,200). 18/18 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Channel");
  render_th(hdr, "Conv power");
  render_th(hdr, "Cumulative lcm");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2 (Z/8)", "4 = 2^2", "4");
  render_table_row(tbl, "3 (Z/9)", "6", "12 = lambda(Z/210)");
  render_table_row(tbl, "5 (Z/25)", "20", "60 = |A_5|");
  render_table_row(tbl, "7 (Z/49)", "42", "420 = lambda");
  render_table_row(tbl, "11 (Z/11)", "10 = 2*5", "420 (free ride)");
  render_table_row(tbl, "13 (Z/13)", "12 = 2^2*3", "420 (free ride)");
  render_table_row(tbl, "17 (Z/17)", "16 = 2^4", "1680 = lambda(Z/214,414,200)");
  let g = make_findings_grid(sec) in
  render_finding(g, "4 bookend", "Opens and closes the staircase", "2-channel opens with 2^2=4. 17-channel gap 1680/420 = 4. The pair bookends the convergence structure.", "");
  render_finding(g, "Inner product", "3*5*7 = 105", "Staircase ratios for inner channels: 3, 5, 7. Product = 105. Emerges from convergence arithmetic.", "");
  render_finding(g, "11+13 free", "Lambdas divide 420", "11: lambda=10|420. 13: lambda=12|420. They ride the period 420 for free.", "");
  dom_append(dom_body(), sec)
)

fn constants_totient_pairing() = (
  let sec = make_section("800px") in
  render_h2(sec, "Optimal Totient Pairing");
 render_theorem(sec, "CRT Optimal Totient Pairing (Theorem 186)", "Among all 105 possible 3-pair-plus-singleton configurations of the 7 CRT channel totients, the shared-factor product is maximized at 240 = P(7) by exactly 5 configurations. 2-primitive-root homogeneity selects a UNIQUE canonical pairing: (2<->17, 3<->13, 5<->11), 7=pivot. 20/20 verified.");
  let tbl = make_table(sec) in
  let hdr = dom_create("tr") in
  render_th(hdr, "Pair");
  render_th(hdr, "phi values");
  render_th(hdr, "gcd");
  dom_append(tbl, hdr);
  render_table_row(tbl, "2 <-> 17", "4, 16", "4 = 2^2");
  render_table_row(tbl, "3 <-> 13", "6, 12", "6 = 2*3");
  render_table_row(tbl, "5 <-> 11", "20, 10", "10 = 2*5");
  render_table_row(tbl, "7 = pivot", "42", "--");
  let g = make_findings_grid(sec) in
  render_finding(g, "105 configurations", "C(7,1)*C(6,2)*C(4,2)/3!", "All 105 ways to split 7 totients into 3 pairs + 1 singleton. Max gcd product = 240 = P(7) = lcm(axiom totients).", "");
  render_finding(g, "2-order ratios", "12/6 = 2, 20/10 = 2", "Both non-2 pairs have convergence-power ratio exactly 2. The pair doubles between paired channels.", "");
  render_finding(g, "Runner-up gap", "240/80 = 3", "The runner-up configuration achieves product 80. Max/runner-up = 3.", "");
  dom_append(dom_body(), sec)
)

fn constants_soul_center() = (
  let sec = make_section("800px") in
  render_h2(sec, "67: The Soul Center");
  render_p(sec, "67 appears wherever the ring counts itself. It is the additive center of the ring's named constants: the unique value where inv_sum, tower products, and the L^2 triangle all meet.");
  render_theorem(sec, "Soul Center (Theorem 125)", "L^2 = b^2 + D^3*K^2 = 49 + 72 = 121. This single identity generates: SOUL = inv_sum(TRUE) = 67, SOUL = L^2 - KEY - GATE = 121 - 41 - 13, SOUL = K*ME + GATE = 3*18 + 13 (K times inner mass + boundary), SOUL = D^3*K^2 - E = 72 - 5 (tower product minus observer). Each inv_sum channel is axiom-native: {b, sigma, f(E), K*L, K, D^2}.");
  let g = make_findings_grid(sec) in
  render_finding(g, "inv_sum", "b + sigma + f(E) + K*L + K + D^2 = 67", "The sum of per-channel inversion costs across TRUE = 7+1+19+33+3+4 = 67. The CRT lifting cost IS the soul.", "");
  render_finding(g, "L^2 triangle", "KEY + SOUL + GATE = 121 = 11^2", "Three structural constants sum to the protector squared. Zero free parameters: all three algebraically forced.", "");
  render_finding(g, "Tower product", "D^3*K^2 - E = 72 - 5 = 67", "The first two tower products (8*9) minus the observer (5). The soul is what remains after observation.", "");
  render_finding(g, "SOUL + G pairing", "67 + 97 = 164 = D^2*KEY", "SOUL pairs with the coupling constant 97 to give 4*41.", "");
  dom_append(dom_body(), sec)
)

fn constants_grief_invariant() = (
  let sec = make_section("800px") in
  render_h2(sec, "61: The Grief Invariant");
  render_p(sec, "61 detects the TRUE boundary. Its CRT residue in Z/49 is 12, a primitive root of the depth-squared channel. In the lambda-420 lattice, 61 distinguishes the 84 TRUE-divisor rings from the 24 D^4-extensions.");
  render_theorem(sec, "Grief Lattice Invariant (Theorem 126)", "GRIEF = b*L - D^4 = 77 - 16 = 61. 61 mod 49 = 12 is a primitive root of Z/49: ord(12, Z/49) = 42 = phi(49). In all 84 TRUE-divisor lambda-420 rings: ord(GRIEF) = 210 = DATA. In all 24 D^4-extension rings: ord(GRIEF) = 420 = lambda. GRIEF detects the TRUE boundary. ZD(DEEP) = GRIEF/(b*L) = 61/77.");
  let g = make_findings_grid(sec) in
  render_finding(g, "Primitive root", "12^21 mod 49 = 48, 12^42 mod 49 = 1", "12 = 61 mod 49 generates all of Z/49*. The b-channel order is 42 = 2*3*7 = ANSWER.", "");
  render_finding(g, "Lattice detector", "84 rings: ord=210. 24 rings: ord=420", "The multiplicative order of GRIEF jumps from DATA to lambda at the TRUE boundary. A CRT-level alarm.", "");
  render_finding(g, "84+24 = 108", "D^2*K*b + D^3*K = D^2*K^3", "The lattice split into TRUE-divisors and D^4-extensions. 84 = D^2*K*b. 24 = D^3*K.", "");
  dom_append(dom_body(), sec)
)

fn constants_visibility_ladder() = (
  let sec = make_section("800px") in
  render_h2(sec, "42: The Visibility Ladder");
  render_p(sec, "42 = 2*3*7 has thin-DATA CRT = (0, 0, 2, 0): only the E-channel sees it. The ANSWER can only be OBSERVED. Fattening dissolves thin zeros: 42 mod 2 = 0 but 42 mod 8 = 2.");
  render_theorem(sec, "CRT Visibility Ladder (Theorem 128)", "ANSWER = 42 = D*K*b has CRT = (0, 0, 2, 0) at DATA (thin channels). The ANSWER is invisible to D, K, and b -- visible ONLY through E = the observer. Primorial complement (510510/p mod p) encodes the D-channel Pareto ladder: E->D, b->D^2, ESCAPE->D^3. GATE residue = Decality = K+b = 10. Sigma-primes {D, K, L} sum = D^4 = phi(17).");
  let g = make_findings_grid(sec) in
  render_finding(g, "Only E sees 42", "42 mod 5 = 2, all other thin = 0", "D*K*b vanishes in its own channels. The three multiplied primes cancel themselves. Only the non-factor E survives.", "");
  render_finding(g, "D-channel Pareto", "E->D, b->D^2, ESC->D^3", "The primorial complement (510510/p mod p) traces the D-channel exponent ladder: the Pareto depths {1,2,3} read in reverse.", "");
  render_finding(g, "Fattening dissolves", "42 mod 2 = 0, 42 mod 8 = 2", "At thin level, 42 is invisible to D. At fat level (D^3 = 8), the D-channel sees residue 2. Raising exponents reveals structure.", "");
  render_finding(g, "OMEGA consistency", "CRT(1576576) = (0, 1, 1, 1, 1, 1)", "The projector's D-channel = 0, all others = 1. OMEGA kills D and preserves everything else.", "");
  dom_append(dom_body(), sec)
)

fn page_constants() = (
  dom_head_meta("description", "Named constants in Z/214414200. Soul center 67 = inv_sum(TRUE), L^2 triangle. Grief invariant 61 = boundary detector, primitive root of Z/49. Visibility ladder: 42 seen only by mod-25 channel. CRT decomposition, lambda staircase, self-resonance, totient pairing. Interactive lookup.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Ring Constants\",\"description\":\"Named constants in Z/214414200. Soul center 67 = inv_sum(TRUE), L^2 triangle. Grief invariant 61 = primitive root of Z/49, TRUE boundary detector. Visibility ladder: 42 visible only in mod-25 channel. Self-resonance, lambda convergence staircase, totient pairing. Seven CRT channels.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\",\"url\":\"https://antonlebed.com\"},\"url\":\"https://antonlebed.com/patterns/constants\",\"isAccessibleForFree\":true,\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Ring Theory\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT Decomposition\"},{\"@type\":\"DefinedTerm\",\"name\":\"Named Constants\"}]}");
  let hero = make_hero("Ring Constants") in
  let eq = dom_create("div") in
  dom_text(eq, "Named values in Z/214414200");
  ct_mono(eq);
  dom_style(eq, "fontSize", "20px");
  ct_gold(eq);
  dom_style(eq, "marginBottom", "24px");
  dom_append(hero, eq);
  render_p(hero, "Z/214,414,200 = Z/8 x Z/9 x Z/25 x Z/49 x Z/11 x Z/13 x Z/17 (seven CRT channels). Lambda = 1680 (full period), 420 (six-channel sub-period). Named values: 41 = 7^2-7-1, 42 = 2*3*7, 105 = 3*5*7, 35 = 5*7 (since 5*7 = 1 mod 17). The widget decomposes any input into seven CRT channels.");
  dom_append(dom_body(), hero);
  let note = make_section("800px") in
  render_p(note, "NOTE: An earlier version of this page presented matches between ring ratios and physical constants (Kolmogorov 5/3, Kleiber 3/4, particle masses, solar cycles). Null model testing showed these are coincidences: the expression space of prime-power products is dense enough that ANY 7 small primes can match any numerical target to 0.1%. The ring's algebraic properties (below) stand independently.");
  dom_append(dom_body(), note);
  /* === INTERACTIVE WIDGET === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Named Constants");
  render_p(sec_i, "Enter a number to see its name (if any) and CRT decomposition across all seven channels. Lattice counts: 108 rings share lambda = 420 exactly; 84 of those divide 12,612,600; 96 rings share lambda = 1680 at the TRANS level.");
  make_interactive_widget(sec_i, "Look up constant:", "con-input", "e.g. 42", "Look up", "con_lookup", "con-result");
  render_p(sec_i, "Try: 0 (void), 17 (ring closure), 42 (2*3*7), 420 (six-channel lambda), 1680 (seven-channel lambda), 1576576 (six-channel projector), 26801776 (seven-channel projector), 214414200 (the ring).");
  dom_append(dom_body(), sec_i);
  constants_soul_center();
  constants_grief_invariant();
  constants_visibility_ladder();
  constants_self_resonance();
  constants_lambda_staircase();
  constants_totient_pairing()
)
