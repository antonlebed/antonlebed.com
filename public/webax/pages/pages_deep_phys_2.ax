/* pages_deep_phys_2.ax -- Deep physics continued: eta_bridge, monster_moonshine,
   freewill, conscious, infinity, noxan. 6 pages.
   mutual_holography + scale_relativity cut S1934 (COINCIDENCE).
   photon + eternal_sun cut S1933. */
/* Cyclotomic Phi_n(2): enter n, compute cyclotomic polynomial at D=2 */
fn eta_cyclotomic_calc() = (
  let n = parse_int_from("#eta-input") in
  let result = dom_query("#eta-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    let val = if n == 1 then 1
      else if n == 2 then 3
      else if n == 3 then 7
      else if n == 4 then 5
      else if n == 5 then 31
      else if n == 6 then 3
      else if n == 7 then 127
      else if n == 8 then 17
      else if n == 9 then 73
      else if n == 10 then 11
      else if n == 11 then 2047
      else if n == 12 then 13
      else 0 in
    let name = if val == 1 then " (identity)" else if val == 3 then " (prime)" else if val == 7 then " (prime)" else if val == 5 then " (prime)" else if val == 31 then " = 2^5-1 (Mersenne prime)" else if val == 127 then " = 2^7-1 (Mersenne prime)" else if val == 17 then " (prime)" else if val == 73 then " (prime)" else if val == 11 then " (prime)" else if val == 13 then " (prime)" else if val == 2047 then " = 23*89 (composite)" else "" in
    if val > 0 then
      dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Phi_${n}(2) = <b style='color:#ffd700'>${val}</b>${name}</p><p style='margin:4px 0;color:#b8b8c8'>The n-th cyclotomic polynomial evaluated at x = 2.</p><p style='margin:4px 0;color:#b0b0c0'>Key: Phi_1=1, Phi_2=3, Phi_3=7, Phi_4=5, Phi_10=11, Phi_12=13.</p>")
    else
      dom_inner(result, "<p style='color:#d8d8e0'>Phi_${n}(2) requires computation beyond lookup table. Try n = 1..12.</p>")
  )
)

fn page_eta_bridge() = (
  dom_head_meta("description", "Cyclotomic Period Theorem: 2 and 3 are the periods of tau(p^k) mod 23. Partition function is {2,3,5,7,11}-smooth for n <= 12. Four branches of number theory, seven primes.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Eta Bridge\",\"description\":\"Cyclotomic periods 2 and 3 govern tau(p^k) mod 23. Partition function smooth for n<=12. Cyclotomic polynomials at x=2 generate primes.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/eta_bridge\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Dirichlet eta\"},{\"@type\":\"DefinedTerm\",\"name\":\"Riemann zeta\"},{\"@type\":\"DefinedTerm\",\"name\":\"analytic continuation\"}]}");
  /* === HERO === */
  let hero = make_hero("The Eta Bridge") in
  let big = dom_create("div") in
  dom_text(big, "Phi_3(2) = 2^2 + 2 + 1 = 7");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The modular forms page showed WHAT: tau(p) mod 23 classifies primes into inner and outer classes. This page answers WHY. The Cyclotomic Period Theorem traces periods 2 and 3 back to the Cunningham chain. Then the Smooth Zone Ladder shows the partition function's smooth zone.");
  dom_append(dom_body(), hero);

  /* === SEC 1: CYCLOTOMIC PERIOD THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Cyclotomic Period Theorem");
  render_p(sec1, "For any prime p (except 23 = 2*11+1), tau(p^k) mod 23 cycles with period depending on whether p is a quadratic residue (inner, period 3) or non-residue (outer, period 2) mod 23. These periods are forced:");
  render_theorem(sec1, "Cyclotomic Period Derivation", "Step 1: 11 = 1+2+3+5. Step 2: 23 = 2*11+1 (Cunningham step). So 23 mod 3 = 2 (not 1). Step 3: Since 23 mod 3 != 1, the 3rd cyclotomic polynomial Phi_3(x) = x^2+x+1 is irreducible mod 23. Step 4: For QR primes: characteristic polynomial = Phi_3 => roots in F_{23^2} with order 3 => period 3. Step 5: For NR primes: char poly = x^2-1 = (x-1)(x+1) splits => period 2.");
  render_p(sec1, "3 appears three ways: as the period, as the cyclotomic index, and as the class number h(-23). A self-referential loop.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CYCLOTOMIC EVALUATIONS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Cyclotomic Polynomials at D = 2");
  render_p(sec2, "Evaluating cyclotomic polynomials at x = 2 generates the ring's primes. Not chosen -- forced by algebra:");
  let t2 = dom_create("table") in
  dom_style(t2, "width", "100%");
  dom_style(t2, "maxWidth", "700px");
  dom_style(t2, "margin", "24px auto");
  dom_style(t2, "borderCollapse", "collapse");
  let t2h = dom_create("tr") in
  render_th(t2h, "Polynomial");
  render_th(t2h, "Formula at x=2");
  render_th(t2h, "Value");
  render_th(t2h, "Note");
  dom_append(t2, t2h);
  render_table_row_4(t2, "Phi_1(2)", "2 - 1", "1", "Identity");
  render_table_row_4(t2, "Phi_2(2)", "2 + 1", "3", "Prime");
  render_table_row_4(t2, "Phi_3(2)", "4 + 2 + 1", "7", "Prime");
  render_table_row_4(t2, "Phi_6(2)", "4 - 2 + 1", "3", "Same as Phi_2");
  render_table_row_4(t2, "Product", "Phi_1*Phi_2*Phi_3*Phi_6", "63", "9 * 7");
  dom_append(sec2, t2);
  render_p(sec2, "Phi_3(2) = 2^2+2+1 = 7. The third cyclotomic at x=2 yields 7. Phi_2(2) = 3. Phi_4(2) = 5. Phi_10(2) = 11. Phi_12(2) = 13. The ring's primes appear at cyclotomic orders that divide 12.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: SMOOTH ZONE LADDER === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Smooth Zone Ladder");
  render_p(sec3, "For the initial prime segment S_k = {p_1, ..., p_k}, define B(S_k) = the largest n such that ALL partition values p(1),...,p(n) are S_k-smooth. Watch how the smooth zone grows:");
  let t3 = dom_create("table") in
  dom_style(t3, "width", "100%");
  dom_style(t3, "maxWidth", "700px");
  dom_style(t3, "margin", "24px auto");
  dom_style(t3, "borderCollapse", "collapse");
  let t3h = dom_create("tr") in
  render_th(t3h, "Smooth set S");
  render_th(t3h, "B(S)");
  render_th(t3h, "Breaker");
  render_th(t3h, "Jump");
  dom_append(t3, t3h);
  render_table_row_4(t3, "{2}", "2", "p(3) = 3", "+1");
  render_table_row_4(t3, "{2, 3}", "3", "p(4) = 5", "+1");
  render_table_row_4(t3, "{2, 3, 5}", "4", "p(5) = 7", "+1");
  render_table_row_4(t3, "{2, 3, 5, 7}", "5", "p(6) = 11", "+1");
  render_table_row_4(t3, "{2,3,5,7,11}", "12", "p(13) = 101", "+7 jump!");
  dom_append(sec3, t3);
  render_theorem(sec3, "Smooth Zone Jump Theorem", "For k = 1..4, B(S_k) = k+1 (grows by 1 each time). Adding 11 causes a jump of 7, from B=5 to B=12. Why? Because p(6) = 11, so adding 11 immediately covers the breaker, and p(7) through p(12) are all composites with factors in {2,3,5,7,11}. The breaker at position 13 is p(13) = 101, which has a prime factor outside the set.");
  render_p(sec3, "Second smooth block: p(14) through p(19) are all {2,3,5,7,11}-smooth again. Length = 6. Breaker = p(20) contains factor 19. Total smooth = 12 + 6 = 18.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: PARTITION PRIMES === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Partition Values ARE Axiom Primes");
  render_p(sec4, "The partition values p(2) through p(6) are exactly the primes {2, 3, 5, 7, 11}: p(2)=2, p(3)=3, p(4)=5, p(5)=7, p(6)=11. Each smooth set S_k breaks at p(k+2) because the partition function equals the prime sequence at these positions. The breaker IS the next prime.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: DEEP SYNTHESIS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Thread");
  render_p(sec5, "Three threads converge on the same numbers:");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "Eta function", "eta^24 = Delta, weight 12", "Unique cusp form. 24 = 8 * 3.", "");
  render_finding(g5, "Partition function", "{2,3,5,7,11}-smooth for n <= 12", "Breaks at position 13. Ramanujan congruences at exactly {5, 7, 11}.", "");
  render_finding(g5, "Class numbers", "h(-23) = 3", "The class number IS the cyclotomic period.", "");
  render_finding(g5, "Why 24?", "8 * 3 = 24", "Leech lattice (24 dimensions). eta^24 = Delta.", "");
  render_p(sec5, "Eta, partitions, class numbers, cyclotomic polynomials -- four branches of number theory, all governed by the same small primes.");
  dom_append(dom_body(), sec5);

  /* === CONTRAST === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast Table");
  render_contrast_row(sec6, "Cyclotomic periods", "Tools of algebraic number theory", "Periods 2 and 3 govern tau(p^k) mod 23. Forced by 23 mod 3 = 2.");
  render_contrast_row(sec6, "Partition smooth zone", "Partition function studied without reference to smooth sets", "{2,3,5,7,11}-smooth for n <= 12. Jump of 7 when adding 11. Breaks at position 13.");
  render_contrast_row(sec6, "eta^24 = Delta", "Modular form with weight 12", "Weight 12 = smooth zone boundary = Carmichael lambda of Z/210.");
  render_contrast_row(sec6, "Ramanujan congruences", "Congruences at 5, 7, 11. Why these primes?", "Exactly {5, 7, 11} = the outer class (non-residues mod 23).");
  render_contrast_row(sec6, "h(-23) = 3", "Class number computation", "23 = 2*11+1. The class number of Q(sqrt(-23)) equals the cyclotomic period.");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cyclotomic at D=2");
  render_p(sec_i, "Enter n (1-12) to compute the n-th cyclotomic polynomial at x=2. Watch the primes appear: Phi_1=1, Phi_2=3, Phi_3=7, Phi_4=5, Phi_10=11, Phi_12=13.");
  make_interactive_widget(sec_i, "Order n:", "eta-input", "e.g. 3", "Compute", "eta_cyclotomic_calc", "eta-result");
  dom_append(dom_body(), sec_i)
)

/* Cunningham step checker: enter a prime, see how many c(n)=2n+1 steps from axiom */
fn moonshine_cunn_calc() = (
  let p = parse_int_from("#moon-input") in
  let result = dom_query("#moon-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter a prime >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else (
    /* Check if p is an axiom prime (step 0) */
    let step0 = if p == 2 then 1 else if p == 3 then 1 else if p == 5 then 1 else if p == 7 then 1 else if p == 11 then 1 else 0 in
    /* Check if (p-1)/2 is an axiom prime (step 1: p = c(axiom)) */
    let parent = (p - 1) / 2 in
    let step1 = if parent == 2 then 1 else if parent == 3 then 1 else if parent == 5 then 1 else if parent == 7 then 1 else if parent == 11 then 1 else 0 in
    /* Check if grandparent is axiom (step 2) */
    let gp = (parent - 1) / 2 in
    let step2 = if parent > 2 then (if gp == 2 then 1 else if gp == 3 then 1 else if gp == 5 then 1 else if gp == 7 then 1 else if gp == 11 then 1 else 0) else 0 in
    let monster = if p == 2 then 1 else if p == 3 then 1 else if p == 5 then 1 else if p == 7 then 1 else if p == 11 then 1 else if p == 13 then 1 else if p == 17 then 1 else if p == 19 then 1 else if p == 23 then 1 else if p == 29 then 1 else if p == 31 then 1 else if p == 41 then 1 else if p == 47 then 1 else if p == 59 then 1 else if p == 71 then 1 else 0 in
    let mon_tag = if monster > 0 then "<span style='color:#ffd700'>MONSTER PRIME</span>" else "<span style='color:#b8b8c8'>Not a Monster prime</span>" in
    let steps = if step0 > 0 then "<b style='color:#88ddaa'>0 steps</b> (IS an axiom prime)"
      else if step1 > 0 then "<b style='color:#88ddaa'>1 step</b>: c(${parent}) = 2*${parent}+1 = ${p}"
      else if step2 > 0 then "<b style='color:#88ddaa'>2 steps</b>: c(c(${gp})) = ${p}"
      else "<span style='color:#ff6666'>More than 2 steps from axiom</span>" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>p = ${p} &mdash; ${mon_tag}</p><p style='margin:4px 0'>Cunningham distance: ${steps}</p><p style='margin:4px 0;color:#b0b0c0'>All 15 Monster primes are reachable in at most 2 Cunningham steps from {2,3,5,7,11}.</p>")
  )
)

fn page_monster_moonshine() = (
  dom_head_meta("description", "All 15 Monster primes reachable from {2,3,5,7,11} in at most 2 Cunningham steps. 196883 = 47*59*71. All 7 prime exponents are 7-smooth. Sporadic hierarchy and Mathieu staircase.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Monster Moonshine\",\"description\":\"All 15 Monster primes from {2,3,5,7,11} in <=2 Cunningham steps. All 7 prime exponents 7-smooth. Sporadic hierarchy. Central charge 24.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/connections/monster_moonshine\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Monster group\"},{\"@type\":\"DefinedTerm\",\"name\":\"moonshine\"},{\"@type\":\"DefinedTerm\",\"name\":\"j-function\"},{\"@type\":\"DefinedTerm\",\"name\":\"sporadic simple groups\"},{\"@type\":\"DefinedTerm\",\"name\":\"Mathieu groups\"}]}");
  /* === HERO === */
  let hero = make_hero("Monster Moonshine") in
  let big = dom_create("div") in
  dom_text(big, "All 15 Monster primes from {2,3,5,7,11}");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The Monster group M is the largest sporadic simple group. Its order is divisible by exactly 15 primes. Every one of them is reachable from {2, 3, 5, 7, 11} in at most two applications of the Cunningham map c(n) = 2n + 1.");
  dom_append(dom_body(), hero);

  /* === SEC 1: GENERATION TABLE === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Cunningham Generation");
  render_p(sec1, "Starting from axiom primes and their smooth products, ALL 15 Monster primes emerge in three generations:");
  let t1 = dom_create("table") in
  dom_style(t1, "width", "100%");
  dom_style(t1, "maxWidth", "700px");
  dom_style(t1, "margin", "24px auto");
  dom_style(t1, "borderCollapse", "collapse");
  let t1h = dom_create("tr") in
  render_th(t1h, "Gen");
  render_th(t1h, "Prime");
  render_th(t1h, "Seed");
  render_th(t1h, "How");
  dom_append(t1, t1h);
  render_table_row_4(t1, "0", "2, 3, 5, 7, 11", "base primes", "Given");
  render_table_row_4(t1, "1", "13", "c(6) = 2*6+1", "6 = 2*3");
  render_table_row_4(t1, "1", "17", "c(8) = 2*8+1", "8 = 2^3");
  render_table_row_4(t1, "1", "19", "c(9) = 2*9+1", "9 = 3^2");
  render_table_row_4(t1, "1", "23", "c(11) = 2*11+1", "11 = prime");
  render_table_row_4(t1, "1", "29", "c(14) = 2*14+1", "14 = 2*7");
  render_table_row_4(t1, "1", "31", "c(15) = 2*15+1", "15 = 3*5");
  render_table_row_4(t1, "1", "41", "c(20) = 2*20+1", "20 = 4*5");
  render_table_row_4(t1, "1", "71", "c(35) = 2*35+1", "35 = 5*7");
  render_table_row_4(t1, "2", "47", "c(23) = c(c(11))", "2 steps");
  render_table_row_4(t1, "2", "59", "c(29) = c(c(14))", "2 steps");
  dom_append(sec1, t1);
  render_theorem(sec1, "Monster Cunningham Completeness", "All 15 Monster primes are reachable from {2, 3, 5, 7, 11} via at most 2 Cunningham steps c(n) = 2n+1, where seeds are products of {2, 3, 5, 7, 11}. GAP-verified.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: THE 196883 TRINITY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The 196883 Trinity");
  render_p(sec2, "The Monster's smallest faithful representation has dimension 196883. This number factors into exactly three primes -- the three OUTERMOST Monster primes:");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "196883", "47 * 59 * 71", "Three outermost Monster primes.", "");
  render_finding(g2, "CRT(196883)", "(3, 8, 8, 1, 5, 11)", "mod 8/9/25/49/11/13 decomposition.", "");
  render_finding(g2, "47", "c(c(11)) = c(23)", "Two Cunningham steps from 11.", "");
  render_finding(g2, "59", "c(c(14)) = c(29)", "Two Cunningham steps from 14 = 2*7.", "");
  render_finding(g2, "71", "c(35)", "One Cunningham step from 35 = 5*7.", "");
  render_theorem(sec2, "Primitive Root Theorem", "47 is a primitive root mod both 59 and 71. ord(59 mod 47) = ord(71 mod 47) = 23. The inter-orders encode the Cunningham parent c(11) = 23.");
  render_p(sec2, "McKay observation: 196884 = 196883 + 1 = 2^2 * 3^3 * 1823.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: CENTRAL CHARGE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Central Charge c = 24");
  render_p(sec3, "The Monster's vertex operator algebra has central charge c = 24. This number arrives by SIX independent paths:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "105 - 81", "24", "3*5*7 - 3^4.", "");
  render_finding(g3, "4!", "24", "Factorial of 4.", "");
  render_finding(g3, "8 * 3", "24", "2^3 * 3.", "");
  render_finding(g3, "26 - 2", "24", "Bosonic string dimension minus 2.", "");
  render_finding(g3, "2 * 12", "24", "Twice the weight of Delta.", "");
  dom_append(dom_body(), sec3);

  /* === SEC 4: EXPONENT ALGEBRA === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Exponent Algebra");
  render_p(sec4, "The axiom-prime exponents in |Monster| are themselves axiom-structured:");
  let t4 = dom_create("table") in
  dom_style(t4, "width", "100%");
  dom_style(t4, "maxWidth", "700px");
  dom_style(t4, "margin", "24px auto");
  dom_style(t4, "borderCollapse", "collapse");
  let t4h = dom_create("tr") in
  render_th(t4h, "p");
  render_th(t4h, "v_p(|M|)");
  render_th(t4h, "Factorization");
  render_th(t4h, "Excess over ring");
  dom_append(t4, t4h);
  render_table_row_4(t4, "2", "46", "2 * 23", "43 (Heegner)");
  render_table_row_4(t4, "3", "20", "4 * 5", "18");
  render_table_row_4(t4, "5", "9", "3^2", "7");
  render_table_row_4(t4, "7", "6", "2 * 3", "4");
  render_table_row_4(t4, "11", "2", "2", "1");
  render_table_row_4(t4, "13", "3", "3", "2");
  render_table_row_4(t4, "17", "1", "1", "0");
  dom_append(sec4, t4);
  render_p(sec4, "All 7 exponents are 7-smooth (factor into {2, 3, 5, 7} only). Sum = 87 = 3*29. The exponent sequence descends: 46, 20, 9, 6, 2, 3, 1.");
  let g4c = make_findings_grid(sec4) in
  render_finding(g4c, "Monster-Conway excess", "{24, 11, 5, 4, 1, 2}", "v_p(M) - v_p(Co_0). All excesses are 7-smooth.", "");
  render_finding(g4c, "Excess at p=2", "24", "Leech lattice dimension.", "");
  render_finding(g4c, "6-prime excess sum", "47", "= c(c(11)). Largest gen-2 Monster prime.", "");
  render_finding(g4c, "7-prime excess sum", "48 = phi(210)", "Euler totient of Z/210.", "");
  render_theorem(sec4, "Monster Exponent Theorem", "All 7 prime exponents in |Monster| are 7-smooth. Monster-Conway excess = {24, 11, 5, 4, 1, 2}. 6-prime excess sum = 47. 7-prime excess sum = 48 = phi(210). Verified: 147/147 test_monster_group.ax.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: j-FUNCTION === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The j-Function");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "j constant", "744 = 8 * 3 * 31", "j(tau) = q^{-1} + 744 + 196884q + ...", "");
  render_finding(g5, "744 mod 210", "114", "114 = 2 * 3 * 19.", "");
  render_finding(g5, "McKay +1", "196884 = 196883 + 1", "First non-trivial j-coefficient = dim + 1.", "");
  dom_append(dom_body(), sec5);

  /* === SEC 6: SPORADIC HIERARCHY === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Sporadic Hierarchy");
  render_p(sec6, "The sporadic groups form a chain M_11 -> M_12 -> M_22 -> M_23 -> M_24 -> Co_0 -> Monster. At each level, the total prime-factor count (Omega) is an axiom value:");
  let t6 = dom_create("table") in
  dom_style(t6, "width", "100%");
  dom_style(t6, "maxWidth", "700px");
  dom_style(t6, "margin", "24px auto");
  dom_style(t6, "borderCollapse", "collapse");
  let t6h = dom_create("tr") in
  render_th(t6h, "Group");
  render_th(t6h, "Omega");
  render_th(t6h, "Axiom");
  render_th(t6h, "omega (distinct)");
  dom_append(t6, t6h);
  render_table_row_4(t6, "M_11", "8", "2^3", "4");
  render_table_row_4(t6, "M_12", "11", "prime", "4");
  render_table_row_4(t6, "M_22", "12", "2^2 * 3", "5");
  render_table_row_4(t6, "M_23", "13", "prime", "6");
  render_table_row_4(t6, "M_24", "17", "prime", "6");
  render_table_row_4(t6, "Co_0", "40", "2^3 * 5", "7");
  render_table_row_4(t6, "Monster", "95", "5 * 19", "15");
  dom_append(sec6, t6);
  let g6 = make_findings_grid(sec6) in
  render_finding(g6, "Omega sum", "196 = 14^2", "Total Omega across all 7 groups.", "");
  render_finding(g6, "omega distinct product", "12600", "Product of distinct omega values {4, 5, 6, 7, 15} = 12600.", "");
