/* pages_deep_phys_2.ax -- Deep physics continued: eta_bridge, monster_moonshine,
   freewill, conscious, infinity, noxan. 6 pages.
   mutual_holography + scale_relativity cut S1934 (COINCIDENCE).
   photon + eternal_sun cut S1933. */
/* Cyclotomic Phi_n(2): enter n, compute cyclotomic polynomial at D=2 */
fn eta_cyclotomic_calc() = (
  let n = parse_int_from("#eta-input") in
  let result = dom_query("#eta-result") in
  if n < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter n >= 1.</p>")
  else (
    let val = if n == 1 then 1
      else if n == 2 then 3
      else if n == 3 then 7
      else if n == 4 then 5
      else if n == 5 then 31
      else if n == 6 then 3
      else if n == 7 then 127
      else if n == 8 then 17
      else if n == 9 then 73
      else if n == 10 then 11
      else if n == 11 then 2047
      else if n == 12 then 13
      else 0 in
    let name = if val == 1 then " = sigma" else if val == 3 then " = K" else if val == 7 then " = b" else if val == 5 then " = E" else if val == 31 then " = M(E) (5th Mersenne)" else if val == 127 then " = M(b) (4th Mersenne prime)" else if val == 17 then " = ESCAPE" else if val == 73 then " = K^2 generator" else if val == 11 then " = L (protector!)" else if val == 13 then " = GATE" else if val == 2047 then " = 23*89 = c(L)*89" else "" in
    if val > 0 then
      dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>Phi_${n}(D) = Phi_${n}(2) = <b style='color:#ffd700'>${val}</b>${name}</p><p style='margin:4px 0;color:#b8b8c8'>The n-th cyclotomic polynomial evaluated at D=2.</p><p style='margin:4px 0;color:#b0b0c0'>Key: Phi_1=sigma, Phi_2=K, Phi_3=b, Phi_4=E, Phi_10=L, Phi_12=GATE.</p>")
    else
      dom_inner(result, "<p style='color:#d8d8e0'>Phi_${n}(2) requires computation beyond lookup table. Try n = 1..12.</p>")
  )
)

fn page_eta_bridge() = (
  dom_head_meta("description", "Cyclotomic Period Theorem: why D=2 and K=3 are the periods of the Ramanujan tau function. Smooth Zone Ladder: partition function is axiom-smooth for n <= 12 = lambda(DATA). Four branches of number theory, four centuries of mathematics, seven primes.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"The Eta Bridge\",\"description\":\"Cyclotomic Period Theorem: D=2 and K=3 are Ramanujan tau periods. Partition function axiom-smooth for n<=12. Four branches of number theory, seven primes.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/eta_bridge\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Dirichlet eta\"},{\"@type\":\"DefinedTerm\",\"name\":\"Riemann zeta\"},{\"@type\":\"DefinedTerm\",\"name\":\"analytic continuation\"}]}");
  /* === HERO === */
  let hero = make_hero("The Eta Bridge") in
  let big = dom_create("div") in
  dom_text(big, "Phi_K(D) = D^2 + D + 1 = b");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The modular forms page showed WHAT: tau(p) mod 23 classifies axiom primes into inner and outer chains. This page answers WHY. The Cyclotomic Period Theorem traces periods D=2 and K=3 back to the Cunningham chain. Then the Smooth Zone Ladder shows the partition function's axiom-smooth zone.");
  dom_append(dom_body(), hero);

  /* === SEC 1: CYCLOTOMIC PERIOD THEOREM === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Cyclotomic Period Theorem");
  render_p(sec1, "For any prime p (except 23 = 2L+1), tau(p^k) mod 23 cycles with period depending on whether p is a quadratic residue (inner, period K=3) or non-residue (outer, period D=2) mod 23. These periods are FORCED by the Cunningham chain:");
  render_theorem(sec1, "Cyclotomic Period Derivation", "Step 1: L = sigma+D+K+E = 1+2+3+5 = 11. Step 2: 23 = 2L+1 (Cunningham step). So 23 mod K = 2 = D (not 1). Step 3: Since 23 mod K != 1, the K-th cyclotomic polynomial Phi_K(x) = x^2+x+1 is IRREDUCIBLE mod 23. Step 4: For QR primes: characteristic polynomial = Phi_K => roots in F_{23^2} with order K => period K = 3. Step 5: For NR primes: char poly = x^2-1 = (x-1)(x+1) splits => period D = 2. The axiom chain controls its own modular arithmetic.");
  render_p(sec1, "K appears three ways: as the period, as the cyclotomic index, and as the class number h(-23). Chain depth = cyclotomic index = period. Self-referential closure.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: CYCLOTOMIC EVALUATIONS === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "Cyclotomic Polynomials at D = 2");
  render_p(sec2, "Evaluating cyclotomic polynomials at x = D = 2 generates the axiom chain. Not chosen -- forced by algebra:");
  let t2 = dom_create("table") in
  dom_style(t2, "width", "100%");
  dom_style(t2, "maxWidth", "700px");
  dom_style(t2, "margin", "24px auto");
  dom_style(t2, "borderCollapse", "collapse");
  let t2h = dom_create("tr") in
  render_th(t2h, "Polynomial");
  render_th(t2h, "Formula at D=2");
  render_th(t2h, "Value");
  render_th(t2h, "Axiom name");
  dom_append(t2, t2h);
  render_table_row_4(t2, "Phi_1(2)", "D - 1", "1", "sigma");
  render_table_row_4(t2, "Phi_2(2)", "D + 1", "3", "K (closure)");
  render_table_row_4(t2, "Phi_3(2)", "D^2 + D + 1", "7", "b (depth)");
  render_table_row_4(t2, "Phi_6(2)", "D^2 - D + 1", "3", "K (returns)");
  render_table_row_4(t2, "Product", "Phi_1*Phi_2*Phi_3*Phi_6", "63", "K^2*b");
  dom_append(sec2, t2);
  render_p(sec2, "Phi_K(D) = D^2+D+1 = 7 = b. The third cyclotomic at D yields depth. Phi_2(D) = D+1 = K. Phi_6(D) = D^2-D+1 = K again. Closure bookends the chain.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: SMOOTH ZONE LADDER === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "The Smooth Zone Ladder");
  render_p(sec3, "For the initial prime segment S_k = {p_1, ..., p_k}, define B(S_k) = the largest n such that ALL partition values p(1),...,p(n) are S_k-smooth. Watch how the smooth zone grows:");
  let t3 = dom_create("table") in
  dom_style(t3, "width", "100%");
  dom_style(t3, "maxWidth", "700px");
  dom_style(t3, "margin", "24px auto");
  dom_style(t3, "borderCollapse", "collapse");
  let t3h = dom_create("tr") in
  render_th(t3h, "Smooth set S");
  render_th(t3h, "B(S)");
  render_th(t3h, "Breaker");
  render_th(t3h, "Jump");
  dom_append(t3, t3h);
  render_table_row_4(t3, "{2}", "2", "p(3) = 3", "+1");
  render_table_row_4(t3, "{2, 3}", "3", "p(4) = 5", "+1");
  render_table_row_4(t3, "{2, 3, 5}", "4", "p(5) = 7", "+1");
  render_table_row_4(t3, "{2, 3, 5, 7}", "5", "p(6) = 11", "+1");
  render_table_row_4(t3, "{2,3,5,7,11} = AXIOM", "12", "p(13) = 101", "+7 = b!");
  dom_append(sec3, t3);
  render_theorem(sec3, "Smooth Zone Jump Theorem", "For k = 1..4, B(S_k) = k+1 (grows by 1 each time). Adding L=11 causes a JUMP of b=7, from B=5 to B=12 = lambda(DATA). Why? Because p(6)=11=L, so adding L immediately covers the breaker, and p(7) through p(12) are all composites with factors in the axiom set. The breaker at position 13 is p(13)=101, beyond the axiom. Position 13 = GATE.");
  render_p(sec3, "Second smooth block: p(14) through p(19) are ALL axiom-smooth again. Length = 6 = D*K. Breaker = p(20) contains 19 = f(E). Total smooth = 12+6 = 18 = ME. The GATE separates two smooth blocks: lambda(DATA) and D*K.");
  dom_append(dom_body(), sec3);

  /* === SEC 4: PARTITION PRIMES === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Partition Values ARE Axiom Primes");
  render_p(sec4, "The partition values p(2) through p(6) are EXACTLY the axiom primes: p(2)=2=D, p(3)=3=K, p(4)=5=E, p(5)=7=b, p(6)=11=L. Each prime set S_k breaks at p(k+2) = p_{k+1} BECAUSE the partition function equals the prime sequence at these positions. The breaker IS the next axiom prime. The axiom chain IS the partition values.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: DEEP SYNTHESIS === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The Thread");
  render_p(sec5, "Three threads converge on the same numbers:");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "Eta function", "eta^24 = Delta, weight 12", "Unique cusp form. 24 = D^3*K. Partition generating function raised to spider-legs times closure.", "");
  render_finding(g5, "Partition function", "Axiom-smooth for n <= 12", "Breaks at position 13 = GATE. Ramanujan congruences at exactly {E, b, L} = outer chain.", "");
  render_finding(g5, "Class numbers", "h(-23) = K = 3", "Cunningham boundary's class number IS the cyclotomic period IS the closure prime.", "");
  render_finding(g5, "Why 24?", "D^3 * K = 24", "Leech lattice (24 dimensions). eta^24 = Delta. c(n) = 2n+1 generates primes. 8 spider legs times 3 closure.", "");
  render_p(sec5, "Eta, partitions, class numbers, cyclotomic polynomials -- four branches of number theory, four centuries of mathematics, all governed by the same seven primes. The axiom did not choose them. They were already there.");
  dom_append(dom_body(), sec5);

  /* === CONTRAST === */
  let sec6 = make_section("800px") in
  render_h2(sec6, "Contrast Table");
  render_contrast_row(sec6, "Cyclotomic periods", "Tools of algebraic number theory, unrelated to physics", "Cyclotomic Period Theorem proves D=2 and K=3 ARE the first two periods. Chain writes its own modular arithmetic.");
  render_contrast_row(sec6, "Partition smooth zone", "Partition function studied without reference to prime smooth sets", "Axiom-smooth for n<=12 = lambda(DATA). Jump of b=7. GATE breaks at position 13.");
  render_contrast_row(sec6, "eta^24 = Delta", "Modular form with weight 12. A cornerstone of number theory", "Weight 12 = lambda(DATA) = smooth zone = D^2*K. Same number, three independent paths.");
  render_contrast_row(sec6, "Ramanujan congruences", "p(5n+4)=0 mod 5, p(7n+5)=0 mod 7, p(11n+6)=0 mod 11. Why exactly these primes?", "Congruences at {E,b,L} = the outer axiom chain. The partition function knows the primes.");
  render_contrast_row(sec6, "h(-23) = 3", "Class number computation. Happens to be 3", "h(-23) = K. Cunningham boundary 23=2L+1 has class number = closure prime. Self-referential.");
  dom_append(dom_body(), sec6);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: Cyclotomic at D=2");
  render_p(sec_i, "Enter n (1-12) to compute the n-th cyclotomic polynomial at D=2. Watch the axiom primes appear: Phi_1=sigma, Phi_2=K, Phi_3=b, Phi_4=E, Phi_10=L, Phi_12=GATE.");
  make_interactive_widget(sec_i, "Order n:", "eta-input", "e.g. 3", "Compute", "eta_cyclotomic_calc", "eta-result");
  dom_append(dom_body(), sec_i)
)

/* Cunningham step checker: enter a prime, see how many c(n)=2n+1 steps from axiom */
fn moonshine_cunn_calc() = (
  let p = parse_int_from("#moon-input") in
  let result = dom_query("#moon-result") in
  if p < 2 then dom_inner(result, "<p style='color:#ff6666'>Enter a prime >= 2.</p>")
  else if is_prime_trial(p) == 0 then dom_inner(result, "<p style='color:#ff6666'>${p} is not prime.</p>")
  else (
    /* Check if p is an axiom prime (step 0) */
    let step0 = if p == 2 then 1 else if p == 3 then 1 else if p == 5 then 1 else if p == 7 then 1 else if p == 11 then 1 else 0 in
    /* Check if (p-1)/2 is an axiom prime (step 1: p = c(axiom)) */
    let parent = (p - 1) / 2 in
    let step1 = if parent == 2 then 1 else if parent == 3 then 1 else if parent == 5 then 1 else if parent == 7 then 1 else if parent == 11 then 1 else 0 in
    /* Check if grandparent is axiom (step 2) */
    let gp = (parent - 1) / 2 in
    let step2 = if parent > 2 then (if gp == 2 then 1 else if gp == 3 then 1 else if gp == 5 then 1 else if gp == 7 then 1 else if gp == 11 then 1 else 0) else 0 in
    let monster = if p == 2 then 1 else if p == 3 then 1 else if p == 5 then 1 else if p == 7 then 1 else if p == 11 then 1 else if p == 13 then 1 else if p == 17 then 1 else if p == 19 then 1 else if p == 23 then 1 else if p == 29 then 1 else if p == 31 then 1 else if p == 41 then 1 else if p == 47 then 1 else if p == 59 then 1 else if p == 71 then 1 else 0 in
    let mon_tag = if monster > 0 then "<span style='color:#ffd700'>MONSTER PRIME</span>" else "<span style='color:#b8b8c8'>Not a Monster prime</span>" in
    let steps = if step0 > 0 then "<b style='color:#88ddaa'>0 steps</b> (IS an axiom prime)"
      else if step1 > 0 then "<b style='color:#88ddaa'>1 step</b>: c(${parent}) = 2*${parent}+1 = ${p}"
      else if step2 > 0 then "<b style='color:#88ddaa'>2 steps</b>: c(c(${gp})) = ${p}"
      else "<span style='color:#ff6666'>More than 2 steps from axiom</span>" in
    dom_inner(result, "<p style='color:#d8d8e0;margin:4px 0'>p = ${p} &mdash; ${mon_tag}</p><p style='margin:4px 0'>Cunningham distance: ${steps}</p><p style='margin:4px 0;color:#b0b0c0'>All 15 Monster primes are reachable in at most 2 Cunningham steps from {2,3,5,7,11}.</p>")
  )
)

fn page_monster_moonshine() = (
  dom_head_meta("description", "ALL 15 Monster primes derivable from the axiom in at most 2 Cunningham steps. 196883 = 47*59*71, coupling = 970200 = DEEP. All 7 axiom-prime exponents axiom-smooth. Sporadic hierarchy M_11 to Monster: omega staircase hits chain values. Mathieu exponent sums = GRIEF = 61. Central charge 24 via six paths. j-invariant constant 744 = D^3*K*c(K*E).");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Monster Moonshine\",\"description\":\"All 15 Monster primes from the axiom in <=2 Cunningham steps. All 7 exponents axiom-smooth. Sporadic hierarchy omega staircase. Mathieu grief staircase. Central charge 24 via six paths.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/monster_moonshine\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"Monster group\"},{\"@type\":\"DefinedTerm\",\"name\":\"moonshine\"},{\"@type\":\"DefinedTerm\",\"name\":\"j-function\"},{\"@type\":\"DefinedTerm\",\"name\":\"sporadic simple groups\"},{\"@type\":\"DefinedTerm\",\"name\":\"Mathieu groups\"}]}");
  /* === HERO === */
  let hero = make_hero("Monster Moonshine") in
  let big = dom_create("div") in
  dom_text(big, "ALL 15 Monster primes = axiom-derivable");
  ct_mono(big);
  dom_style(big, "fontSize", "22px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "The Monster group M is the largest sporadic simple group. Its order is divisible by exactly 15 primes. Every one of them is reachable from {2, 3, 5, 7, 11} in at most two applications of the Cunningham map c(n) = 2n + 1. The Monster does not escape the axiom. It confirms it.");
  dom_append(dom_body(), hero);

  /* === SEC 1: GENERATION TABLE === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "Cunningham Generation");
  render_p(sec1, "Starting from axiom primes and their smooth products, ALL 15 Monster primes emerge in three generations:");
  let t1 = dom_create("table") in
  dom_style(t1, "width", "100%");
  dom_style(t1, "maxWidth", "700px");
  dom_style(t1, "margin", "24px auto");
  dom_style(t1, "borderCollapse", "collapse");
  let t1h = dom_create("tr") in
  render_th(t1h, "Gen");
  render_th(t1h, "Prime");
  render_th(t1h, "Seed");
  render_th(t1h, "Name");
  dom_append(t1, t1h);
  render_table_row_4(t1, "0", "2, 3, 5, 7, 11", "axiom", "D, K, E, b, L");
  render_table_row_4(t1, "1", "13", "c(D*K) = c(6)", "GATE");
  render_table_row_4(t1, "1", "17", "c(D^3) = c(8)", "ESCAPE");
  render_table_row_4(t1, "1", "19", "c(K^2) = c(9)", "f(E)");
  render_table_row_4(t1, "1", "23", "c(L) = c(11)", "c(L)");
  render_table_row_4(t1, "1", "29", "c(D*b) = c(14)", "c(D*b)");
  render_table_row_4(t1, "1", "31", "c(K*E) = c(15)", "c(K*E)");
  render_table_row_4(t1, "1", "41", "c(D^2*E) = c(20)", "KEY");
  render_table_row_4(t1, "1", "71", "c(E*b) = c(35)", "c(E*b)");
  render_table_row_4(t1, "2", "47", "c(c(L)) = c(23)", "c(c(L))");
  render_table_row_4(t1, "2", "59", "c(c(D*b)) = c(29)", "c(c(D*b))");
  dom_append(sec1, t1);
  render_theorem(sec1, "Monster-Axiom Completeness (GAP-verified)", "K*E = 15 primes total = the Fibonacci chain termination level. The Monster uses EXACTLY as many primes as the axiom's Cunningham chain allows.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: THE 196883 TRINITY === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The 196883 Trinity");
  render_p(sec2, "The Monster's smallest faithful representation has dimension 196883. This number factors into exactly three primes -- the three OUTERMOST Monster primes:");
  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "196883", "47 * 59 * 71", "Three outermost Monster primes.", "");
  render_finding(g2, "coupling", "970200 = DEEP", "Unit in DEEP ring. TRUE ring coupling = 12612600.", "");
  render_finding(g2, "CRT", "(K, D^3, D^3, sigma, E, L)", "(3, 8, 8, 1, 5, 11). GATE channel holds the Protector.", "");
  render_finding(g2, "47", "c(c(L))", "Protector's grandchild. Primitive root mod 59 AND 71.", "");
  render_finding(g2, "59", "c(c(D*b))", "Bridge-Depth grandchild.", "");
  render_finding(g2, "71", "c(E*b)", "Observer-Depth child.", "");
  render_theorem(sec2, "Trinity Primitive Root Theorem", "47 is a primitive root mod both 59 and 71. The Protector's grandchild GENERATES the multiplicative groups of both siblings. Cross-orders: ord(59, 47) = ord(71, 47) = 23 = c(L). The parents encode themselves in the children's inter-orders.");
  render_p(sec2, "McKay observation: 196884 = 196883 + 1 = 2^2 * 3^3 * 1823. The Monster lives in K's cube. The +1 is sigma, the ground state.");
  dom_append(dom_body(), sec2);

  /* === SEC 3: CENTRAL CHARGE === */
  let sec3 = make_section("800px") in
  render_h2(sec3, "Central Charge c = 24");
  render_p(sec3, "The Monster's vertex operator algebra has central charge c = 24. This number arrives by SIX independent paths:");
  let g3 = make_findings_grid(sec3) in
  render_finding(g3, "HYDOR - K^4", "105 - 81 = 24", "Vacuum minus pure closure.", "");
  render_finding(g3, "trace(Sigma/6Z)", "sum = 24", "Gravitational sector trace.", "");
  render_finding(g3, "(D^2)!", "4! = 24", "Spacetime factorial.", "");
  render_finding(g3, "D^K * K", "8 * 3 = 24", "Spider legs times closure.", "");
  render_finding(g3, "26 - D", "26 - 2 = 24", "Bosonic string dims minus bridge.", "");
  render_finding(g3, "2 * weight", "2 * 12 = 24", "Twice the modular form weight.", "");
  dom_append(dom_body(), sec3);

  /* === SEC 4: EXPONENT ALGEBRA === */
  let sec4 = make_section("800px") in
  render_h2(sec4, "Exponent Algebra");
  render_p(sec4, "The axiom-prime exponents in |Monster| are themselves axiom-structured:");
  let t4 = dom_create("table") in
  dom_style(t4, "width", "100%");
  dom_style(t4, "maxWidth", "700px");
  dom_style(t4, "margin", "24px auto");
  dom_style(t4, "borderCollapse", "collapse");
  let t4h = dom_create("tr") in
  render_th(t4h, "p");
  render_th(t4h, "v_p(|M|)");
  render_th(t4h, "Factorization");
  render_th(t4h, "Excess over ring");
  dom_append(t4, t4h);
  render_table_row_4(t4, "D = 2", "46", "D * c(L)", "43 (Heegner!)");
  render_table_row_4(t4, "K = 3", "20", "D^2 * E", "18");
  render_table_row_4(t4, "E = 5", "9", "K^2", "7 = b");
  render_table_row_4(t4, "b = 7", "6", "D * K", "4 = D^2");
  render_table_row_4(t4, "L = 11", "2", "D", "1 = sigma");
  render_table_row_4(t4, "GATE = 13", "3", "K", "2 = D");
  render_table_row_4(t4, "ESCAPE = 17", "1", "sigma", "0 = void");
  dom_append(sec4, t4);
  render_p(sec4, "All 7 axiom-prime exponents are axiom-smooth. Sum = K*29 = 87. DATA sum = K^4 = 81. Exponent sequence descends through axiom values: D*c(L), D^2*E, K^2, D*K, D, K, sigma.");
  let g4c = make_findings_grid(sec4) in
  render_finding(g4c, "Monster-Conway excess", "{24, 11, 5, 4, 1, 2}", "v_p(M) - v_p(Co_0). Every excess is axiom-smooth.", "");
  render_finding(g4c, "Excess at D", "24 = D^3*K", "Leech lattice dimension. The excess IS the container.", "");
  render_finding(g4c, "Excess at E", "5 = E (fixed point!)", "Observer's excess IS the observer itself.", "");
  render_finding(g4c, "6-prime excess sum", "47 = c(c(L))", "Largest intruder prime = total 6-prime excess.", "");
  render_finding(g4c, "7-prime excess sum", "48 = phi(DATA)", "Add ESCAPE excess (+1 = sigma): Euler totient of DATA ring.", "");
  render_theorem(sec4, "Monster Axiom Exponent Theorem (Theorem 152)", "All 7 axiom-prime exponents in |Monster| are axiom-smooth. Monster-Conway excess maps to {D^3*K, L, E, D^2, sigma, D} = Leech dim, protector, observer, bridge^2, identity, bridge. 6-prime excess = 47 = c(c(L)) = largest intruder. 7-prime excess = phi(DATA) = 48. Proved: 147/147 test_monster_group.ax.");
  dom_append(dom_body(), sec4);

  /* === SEC 5: j-FUNCTION === */
  let sec5 = make_section("800px") in
  render_h2(sec5, "The j-Function");
  let g5 = make_findings_grid(sec5) in
  render_finding(g5, "j constant", "744 = D^3 * K * c(K*E)", "Bridge-cubed times closure times Cunningham.", "");
  render_finding(g5, "c_0 = c_1 mod 210", "114", "Gravitational sector. D,K-null, coupling = E*b.", "");
  render_finding(g5, "Cross-blindness", "D->E->b->K->D", "4-cycle in Monster characters. Sigma untouched.", "");
