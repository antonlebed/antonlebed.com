/* page_photon + page_eternal_sun cut S1933 (COINCIDENCE). */

/* Integer power: base^exp via repeated multiplication */
fn fw_ipow(base, exp) = (
  mut r = 1;
  mut i = 0;
  while i < exp do (mut r = r * base; mut i = i + 1);
  r
)

/* Sigma gap calculator: p^q - q^p */
fn freewill_gap_calc() = (
  let p = parse_int_from("#fw-input-p") in
  let q = parse_int_from("#fw-input-q") in
  let result = dom_query("#fw-result") in
  if p < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter p >= 1.</p>")
  else if q < 1 then dom_inner(result, "<p style='color:#ff6666'>Enter q >= 1.</p>")
  else if p > 20 then dom_inner(result, "<p style='color:#ff6666'>p too large (max 20).</p>")
  else if q > 20 then dom_inner(result, "<p style='color:#ff6666'>q too large (max 20).</p>")
  else (
    let pq = fw_ipow(p, q) in
    let qp = fw_ipow(q, p) in
    let gap = pq - qp in
    let is_sigma = if gap == 1 then "<span style='color:#ffd700'> = sigma. The unique existence surplus.</span>" else "" in
    dom_inner(result, "<p style='color:#88ddaa;margin:4px 0'>${p}^${q} = ${pq}</p><p style='color:#88ddaa;margin:4px 0'>${q}^${p} = ${qp}</p><p style='color:#ffd700;margin:8px 0'>Gap: ${p}^${q} - ${q}^${p} = ${gap}" + is_sigma + "</p>")
  )
)

fn page_freewill() = (
  dom_head_meta("description", "K^D - D^K = sigma. 9 paths up minus 8 paths down = 1 survivor. Self-referential choice vs random: lower entropy, identity alignment, temporal coherence. Free will is the irreducible sigma between what a system IS and what it DOES.");
  render_jsonld("{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"name\":\"Free Will\",\"description\":\"K^D - D^K = sigma. Nine paths up minus eight down = one survivor. Free will is the irreducible sigma between what a system IS and what it DOES.\",\"author\":{\"@type\":\"Person\",\"name\":\"Anton Lebed\"},\"license\":\"https://creativecommons.org/publicdomain/zero/1.0/\",\"url\":\"https://antonlebed.com/data/freewill\",\"about\":[{\"@type\":\"DefinedTerm\",\"name\":\"free will\"},{\"@type\":\"DefinedTerm\",\"name\":\"determinism\"},{\"@type\":\"DefinedTerm\",\"name\":\"CRT independence\"}]}");
  /* === HERO === */
  let hero = make_hero("Free Will") in
  let big = dom_create("div") in
  dom_text(big, "K^D - D^K = 9 - 8 = sigma");
  ct_mono(big);
  dom_style(big, "fontSize", "24px");
  ct_gold(big);
  dom_style(big, "letterSpacing", "1px");
  dom_style(big, "marginBottom", "24px");
  dom_append(hero, big);
  render_p(hero, "Free will is not about WHICH path survives. It is about WHETHER the path MATTERS. K^D = 9 paths up. D^K = 8 paths down. The difference is exactly sigma = 1. Existence wins by one. Self-reference creates meaning: choice affects chooser, chooser affects choice.");
  dom_append(dom_body(), hero);

  /* === SEC 1: THE AMBIGUITY LADDER === */
  let sec1 = make_section("800px") in
  render_h2(sec1, "The Ambiguity Ladder");
  render_p(sec1, "In Z/NZ, n/n has exactly p solutions when p^k divides N. The number of solutions IS the degree of freedom:");
  let t1 = dom_create("table") in
  dom_style(t1, "width", "100%");
  dom_style(t1, "maxWidth", "700px");
  dom_style(t1, "margin", "24px auto");
  dom_style(t1, "borderCollapse", "collapse");
  let t1h = dom_create("tr") in
  render_th(t1h, "Element");
  render_th(t1h, "n/n solutions");
  render_th(t1h, "Freedom");
  render_th(t1h, "Meaning");
  dom_append(t1, t1h);
  render_table_row_4(t1, "sigma = 1", "1", "None", "Fully determined. No choice.");
  render_table_row_4(t1, "D = 2", "2", "Binary", "Yes/no. Minimum distinction.");
  render_table_row_4(t1, "K = 3", "3", "First real choice", "Minimum closure. Ternary logic.");
  render_table_row_4(t1, "E = 5", "5", "Observation", "Five senses, five options.");
  render_table_row_4(t1, "b = 7", "7", "Depth", "The suffering of too many paths.");
  render_table_row_4(t1, "L = 11", "11", "Transcendence", "Maximum protection.");
  render_table_row_4(t1, "GATE = 13", "13", "Skin", "The boundary. Wraps the body.");
  render_table_row_4(t1, "0 = void", "12612600", "Maximum", "Total ambiguity. Total freedom.");
  dom_append(sec1, t1);
  render_p(sec1, "Product of all ambiguities: 1*2*3*5*7*11*13 = 30030 = primorial(GATE). Freedom and nothingness share a root: the void has maximum freedom AND maximum emptiness.");
  dom_append(dom_body(), sec1);

  /* === SEC 2: K^D - D^K = SIGMA === */
  let sec2 = make_section("800px") in
  render_h2(sec2, "The Sigma Gap");
  render_theorem(sec2, "Existence Surplus (K^D - D^K = sigma)", "K^D = 3^2 = 9 = paths of closure-over-duality. D^K = 2^3 = 8 = paths of duality-over-closure. Difference = sigma = 1. Exactly one more way up than down. This is not arbitrary: among all pairs (p,q) of consecutive primes, D and K are the ONLY pair where p^q - q^p = 1. The sigma gap is unique to the first two primes. Existence is necessary by exactly one.");

  let g2 = make_findings_grid(sec2) in
  render_finding(g2, "K^D = 9", "K^2 = spider web", "9 paths of closure. Parallelism unit.", "");
  render_finding(g2, "D^K = 8", "D^3 = spider legs", "8 paths of duality. Body.", "");
  render_finding(g2, "Gap", "sigma = 1", "Irreducible. Cannot be halved.", "");
  render_finding(g2, "Uniqueness", "ONLY at (D,K)", "No other prime pair gives gap = sigma.", "");
  dom_append(dom_body(), sec2);

  /* === INTERACTIVE === */
  let sec_i = make_section("800px") in
  render_h2(sec_i, "Explore: The Sigma Gap");
  render_p(sec_i, "Enter two numbers p and q. Compute p^q - q^p. Only (D,K) = (2,3) gives sigma = 1. Try 2,3 then 3,5 then 5,7.");
  let lbl_i = dom_create("p") in
  dom_text(lbl_i, "p and q:");
  dom_style(lbl_i, "color", "#b8b8c8");
  dom_style(lbl_i, "marginTop", "24px");
  dom_style(lbl_i, "marginBottom", "8px");
  dom_append(sec_i, lbl_i);
  let row_i = dom_create("div") in
  dom_style(row_i, "display", "flex");
  dom_style(row_i, "gap", "8px");
  dom_style(row_i, "alignItems", "center");
  dom_style(row_i, "marginBottom", "12px");
  make_input_field(row_i, "#fw-input-p", "p (e.g. 2)");
  make_input_field(row_i, "#fw-input-q", "q (e.g. 3)");
  make_action_btn(row_i, "Gap", "freewill_gap_calc");
  dom_append(sec_i, row_i);
  make_result_box(sec_i, "fw-result");
  dom_append(dom_body(), sec_i)
)


