{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antonlebed",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    { "binding": "SENSOR_DATA", "id": "3627cc0e705a43fdbad72001be615c69" }
  ]
}
