{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antonlebed",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  // run_worker_first is load-bearing, not a tuning knob. public/ is FLAT
  // (one <id>.html per page) while the site's URLs NEST, so without it the
  // assets layer answers /inside and /constants from the file before the
  // worker ever runs — every nested page reachable at a second URL, and
  // the manifest's 301s silently dead. The worker owns routing; it hands
  // anything with an extension straight back to ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
